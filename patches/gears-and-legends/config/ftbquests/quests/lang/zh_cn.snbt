	quest.49CD3DBBE3871013.title: "阿尔沃：树人实体"
	quest.49E4AA5443B6705F.quest_desc: ["Uma lâmina equilibrada, confiável e estilosa para os confrontos de mid-game."]
	quest.49E4AA5443B6705F.title: "战士之剑 (A Espada do Guerreiro)"
	quest.4A1FAC21CC354DC3.quest_desc: ["Com o Wireless Terminal, não precisa ficar parado na frente da tela. Clique Shift + Botão Direito no Crafting Terminal para vinculá-lo, e acesse seus itens de longe! (Tem limite de blocos de distância)"]
	quest.4A1FAC21CC354DC3.title: "一个名为 Nuvem (Wi-Fi) 的模组"
	quest.4A20E8906953FB86.title: "阿尔沃：骨追踪者"
	quest.4A24114941E01E97.quest_desc: [
		"Se você cavar em biomas frios, poderá encontrar os imensos Crystal Canyons (Cânions de Cristal)."
		""
		"这些峡谷充满了巨大的闪亮紫水晶结构。"
	]
	quest.4A24114941E01E97.title: "O 璀璨深渊"
	quest.4A2B92E296D11DED.title: "阿尔沃：洞穴骷髅"
	quest.4AAB72B28E8AE887.title: "阿尔沃：雕像拟态者"
	quest.4B0EE1A7E4F8BC39.title: "大型黄金战斧"
	quest.4B4FAFA007A2E7FC.quest_desc: ["黄金变种。速度快，但很脆弱。"]
	quest.4B4FAFA007A2E7FC.title: "黄金短剑"
	quest.4B78BF8EC6A9C524.title: "Alvo: Swamp Skeleton"
	quest.4B95E0DE4718479F.quest_desc: ["O Co-Processador permite que a rede use várias máquinas ao mesmo tempo para o mesmo craft. Velocidade total!"]
	quest.4B95E0DE4718479F.title: "协处理器"
	quest.4BA2505BEF233E44.title: "Alvo：沙漠骷髅"
	quest.4BC5704D3390FB18.title: "阿尔沃：猪灵邪教徒"
	quest.4BC65FCDC01527ED.title: "阿尔沃：绯红行者"
	quest.4BF1AB4DEB849FF9.quest_desc: [
		"Cansado de andar a pé ou depender de cavalos? Antes de sonhar com a Elytra, você pode dominar os céus com os Planadores."
		""
		"Sua primeira asa começa com a lona básica. Salte de lugares altos e segure para planar suavemente pelo mundo!"
	]
	quest.4BF1AB4DEB849FF9.title: "O Primeiro Voo"
	quest.4BF94B6685273CB0.quest_desc: [
		"A verdadeira dança das espadas."
		""
		"Ao usar a Chave, o Underworld Knight surge. Ele tem 150 de vida e combos terríveis. Dica de Mestre: Após ele desferir uma série de golpes, ficará atordoado (de joelhos). Essa é a sua única chance de puni-lo!"
	]
	quest.4BF94B6685273CB0.title: "来自地狱的骑士"
	quest.4BFC87585EA2C52D.quest_desc: ["Pediste a lista completa, caçador. Aqui estão as 54 ameaças isoladas da Série Luminous. Foram separadas em 4 colunas. Todas estão liberadas: caça-os na ordem que os encontrar pelo mundo!"]
	quest.4BFC87585EA2C52D.title: "完整的文件记录簿"
	quest.4C42D5FDCEE96A5F.quest_desc: [
		"O gigante letal que habita as selvas densas e persegue suas presas à noite."
		""
		"A força dele quebra até pedras e vai partir para cima de você com tudo. Derrote-o para conquistar o seu Olho e a sua Presa."
	]
	quest.4C42D5FDCEE96A5F.title: "丛林之王"
	quest.4C46B74635DC8BE1.title: "黄金大剑 (Claymore de Ouro)"
	quest.4C57C3454B019379.title: "阿尔沃：螃蟹"
	quest.4CCCC9174918C77F.quest_desc: ["你的哀嚎回荡在熔岩中。反弹火球以获得再生之泪。"]
	quest.4CCCC9174918C77F.title: "地狱的哀歌 (O Lamento do Inferno)"
	quest.4CE60EC3AA02D5EC.quest_desc: [
		"三倍于普通绳索的破坏力，却仍被一根细绳束缚。"
		""
		"O feixe de dinamites causa uma explosão muito maior. Ideal para mineração em massa rápida ou para limpar áreas grandes do mapa."
	]
	quest.4CE60EC3AA02D5EC.title: "炸药束"
	quest.4CF22B4A565BDDAD.title: "阿尔沃：暗影"
