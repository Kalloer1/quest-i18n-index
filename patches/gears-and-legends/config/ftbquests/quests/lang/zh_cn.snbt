	quest.1B96869908F56E32.quest_desc: ["Construtores do terror. Mantenha distância e acerte antes que detonem!"]
	quest.1B96869908F56E32.title: "O Silêncio Explosivo"
	quest.1BA5FD659F6BB382.title: "阿尔沃：黄金隐士之王"
