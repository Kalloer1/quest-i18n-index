	quest.4300000000000013.title: "钻石宝箱"
	quest.4300000000000014.quest_desc: ["一座静态堡垒。最大容量（120格），7个升级槽，完全免疫苦力怕和火焰爆炸！"]
	quest.4300000000000014.title: "下界合金宝箱"
	quest.4300000000000021.quest_desc: ["O Barril de Ferro traz as mesmas vantagens do baú, mas com o design frontal clássico! 2 Slots de Upgrade."]
