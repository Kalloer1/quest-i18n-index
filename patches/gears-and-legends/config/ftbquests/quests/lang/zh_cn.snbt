	quest.430000000000005D.title: "唱片机升级"
	quest.4300000000000060.quest_desc: ["该单位获得了储存液态经验河流的能力！"]
	quest.4300000000000060.title: "经验泵升级"
	quest.4305283F297B9564.quest_desc: ["Minério encontrado nas zonas congeladas (Frostfields). Armas forjadas com Froststeel aplicam o efeito de Lentidão (Slowness) em quem for golpeado. Excelente para parar as bestas velozes do abismo!"]
	quest.4305283F297B9564.title: "Froststeel (等级 2)"
	quest.431A46A31EEF7246.quest_desc: [
		"Ouro pode ser frágil para ferramentas, mas sua magia e maleabilidade criam um planador com aerodinâmica fantástica."
		""
		"Embora a durabilidade não seja o seu forte, a velocidade com que você corta o ar vai te surpreender."
	]
	quest.431A46A31EEF7246.title: "黄金的Voo Dourado"
	quest.432B04A939279930.title: "阿尔沃：洞穴僵尸"
	quest.438E78F03500BEFE.title: "骑兵长矛（钻石）"
	quest.43DA1B91EFB29D51.quest_desc: [
		"Assim como os Tempads, você pode aprimorar seu Time Twister para as versões §dPurple (TVA)§r ou §eGolden (He Who Remains)§r."
		""
		"Eles guardam um histórico de eventos muito maior (podendo voltar várias 'mortes' atrás) e a versão final custa quase nada para ser ativada."
	]
	quest.43DA1B91EFB29D51.title: "多宇宙历史档案"
	quest.43F422B1DB3074D2.quest_desc: ["Forjado com Cursium. Tem a chance de aplicar Accursed Rage, aumentando brutalmente o seu dano[cite: 18]!"]
	quest.43F422B1DB3074D2.title: "被诅咒的太刀 (Katana Amaldiçoada)"
	quest.4400000000000001.quest_desc: [
		"水晶化力量的开端。"
		""
		"Para dominar o Gemforged, você precisará reunir minérios mágicos como Bloodstone, Gravitium, Nyxite e Prismyte[cite: 17, 18, 19, 21]."
		""
		"Materiais intermediários como o Shimmer Powder (Pó Mágico) e o avançado Yasharium Ingot são a chave para fundir estes cristais e preparar as suas armas finais!"
	]
	quest.4400000000000001.title: "魔法的配料 Ingredients Mágicos"
	quest.4400000000000002.quest_desc: [
		"Forja 是你的祭坛。"
		""
		"Armas e artefatos não se fazem apenas na mesa de trabalho. Você precisará encontrar e utilizar os Moldes (Smithing Templates) específicos na Mesa de Metalurgia para canalizar o poder das gemas nos seus equipamentos!"
		"存在匕首、弓、法杖、护身符、图腾和号角的制作模板。"
	]
	quest.4400000000000002.title: "金属冶炼的艺术"
	quest.4400000000000003.quest_desc: [
		"O controlo da gravidade está nas suas mãos."
		""
		"O Gravity Horn permite-lhe manipular a levitação ao seu redor, sendo uma ferramenta mágica essencial para o controlo do campo de batalha."
	]
	quest.4400000000000003.title: "重力的角 (O Chifre da Gravidade)"
	quest.4400000000000004.quest_desc: ["Mande-me as fotos ou a lista das ferramentas para eu preencher a árvore completa e manter a nossa obra-prima de missões perfeita!"]
	quest.4400000000000004.title: "还有更多秘密等待揭晓"
	quest.4400000000000011.quest_desc: [
		"一把专为行走于阴影中的人打造的武器。"
		""
		"Forjada com Nyxite (uma gema sombria) [cite: 19], a Shadowstep Dagger permite-lhe realizar um avanço rápido (dash) ou teleporte de curto alcance, garantindo ataques furtivos mortais[cite: 5]."
	]
	quest.4400000000000011.title: "黑暗的脚步声"
	quest.4400000000000012.quest_desc: [
		"一把带有剧毒的刀刃。"
		""
		"Feita com a temível gema Venomyte [cite: 23], a Lâmina Venenosa garante que todos os inimigos que provarem do seu fio de corte sofram com o potente efeito de Veneno[cite: 10]."
	]
	quest.4400000000000012.title: "毒刃（ドクナイフ）"
	quest.4400000000000013.quest_desc: [
		"没有地方可以藏身了。"
		""
		"O Ghost Bow é um arco fantástico feito com Nyxite. Ele dispara flechas que ignoram barreiras físicas, atravessando blocos ou entidades[cite: 6]!"
		"Maximize o seu dano criando a munição de elite: Nyxite Arrows[cite: 16]."
	]
	quest.4400000000000013.title: "幽灵弓箭手 (The Ghost Archer)"
	quest.4400000000000021.quest_desc: [
		"太阳能量的力量。"
		""
		"Use Phoenixtone para forjar o Phoenixfire Staff[cite: 20]. Ele dispara projéteis de chamas devastadoras e pode aplicar o efeito de ressurreição/cura 'Phoenix' em batalha[cite: 7]."
	]
	quest.4400000000000021.title: "凤凰的火焰（Chamas da Fénix）"
	quest.4400000000000022.quest_desc: [
		"掌控这片沙漠。"
		""
		"O Sandburst Staff usa as areias do tempo para repelir agressivamente os inimigos ou causar danos em grande área ao seu redor[cite: 8]."
	]
	quest.4400000000000022.title: "Explosão de Areia"
	quest.4400000000000023.quest_desc: [
		"天空都听从您的旨意。"
		""
		"Canalizado através do cristal Prismyte [cite: 21], o Thunder Prism é um artefato puro que liberta energia elétrica formidável, saltando de inimigo em inimigo através de raios de luz[cite: 9]!"
	]
	quest.4400000000000023.title: "雷之棱镜"
	quest.4400000000000031.quest_desc: [
		"Controle o campo de batalha para vencer."
		""
		"Forjada com o denso Gravitium[cite: 18], a Gravity Horn é uma buzina mágica impressionante. Ao tocá-la, altera a gravidade para puxar inimigos na sua direção ou empurrá-los para longe[cite: 14]!"
	]
	quest.4400000000000031.title: "重力之角 (Chifre da Gravidade)"
	quest.4400000000000032.quest_desc: [
		"大自然站在你这一边。"
		""
		"Este Totem usa as energias da gema Verdantite para criar uma área de cura massiva e suporte para si e os seus aliados durante batalhas difíceis[cite: 15]."
	]
	quest.4400000000000032.title: "Totem Verdejante"
	quest.4400000000000033.quest_desc: [
		"火焰的祝福。"
		""
		"Um amuleto essencial que lhe concede proteção contra o fogo e regeneração de vida passiva sem precisar de poções[cite: 13]."
	]
	quest.4400000000000033.title: "凤凰的护身符"
	quest.4400000000000034.quest_desc: [
		"立即冻结。"
		""
		"Este amuleto imbui os seus ataques corpo a corpo com o efeito 'Glacial Fist', tornando os seus golpes capazes de congelar e lentificar os alvos[cite: 11]."
	]
	quest.4400000000000034.title: "冰川护身符"
	quest.4400000000000035.quest_desc: [
		"唤醒愤怒！"
		""
		"Perfeito para combate de curta distância, aumenta passivamente seus atributos ofensivos ou aplica o poderoso estado de 'Fúria' ao seu personagem[cite: 12]."
	]
	quest.4400000000000035.title: "Amuleto de Batalha"
	quest.4459D9D1B2790D50.title: "阿尔沃：暗影"
	quest.445B85F7A95F5D03.quest_desc: ["黄金变种。速度快，但很脆弱。"]
	quest.445B85F7A95F5D03.title: "黄金回旋镖"
	quest.445DA74B2DD9D595.quest_desc: ["Depthrock é a pedra fundamental da dimensão. Todas as ferramentas iniciais do Undergarden devem ser feitas combinando Depthrock com gravetos de madeira Smogstem/Wigglewood."]
	quest.445DA74B2DD9D595.title: "一块深邃的石头"
	quest.44CDEF3AE1CD7C10.quest_desc: ["O Inscriber normal é lento e chato. O Kinetic Inscriber (do Create Applied Kinetics) usa energia rotacional para estampar processadores em altíssima velocidade!"]
	quest.44CDEF3AE1CD7C10.title: "创造：动能压力机"
	quest.44D3A107C9BE78D6.quest_desc: ["A madeira quebra, a pedra resiste. Com isso, os monstros básicos começarão a ser um problema real."]
	quest.44FC86B844763A2A.quest_desc: ["Placa-mãe. Cada face do ME Controller fornece 32 canais. Você pode construir um cubo gigante de até 7x7x7 para redes industriais infinitas."]
	quest.44FC86B844763A2A.title: "大脑（控制器）"
	quest.4500000000000001.quest_desc: [
		"传说由此焕发生机。"
		""
		"Explorando os recantos mais profundos ou derrotando feras ancestrais, você encontrou um Ovo de Drakvyrn Vermelho (Red Drakvyrn Egg)!"
		"O que será necessário para chocar esta criatura majestosa e torná-la sua aliada?"
	]
	quest.4500000000000001.title: "德拉夫林传奇 (A Lenda dos Drakvyrns)"
	quest.4500000000000002.quest_desc: [
		"Para explorar os ninhos dessas feras, você precisará de uma iluminação especial."
		""
		"A Tocha Abissal (Abyssal Torch) emite uma luz mística que afasta as trevas e guia o seu caminho."
	]
	quest.4500000000000002.title: "深渊之光 (A Luz do Abismo)"
	quest.4500000000000003.quest_desc: [
		"O material base da forja dracónica."
		""
		"Reúna as escamas/lingotes das feras para começar a fabricar o seu equipamento supremo."
	]
	quest.4500000000000003.title: "O Sangue da Fera"
	quest.4500000000000011.quest_desc: ["Proteção absoluta para a cabeça, forjada com o poder dos Drakvyrns."]
	quest.4500000000000011.title: "Elmo Dracónico"
	quest.4500000000000012.quest_desc: ["Uma couraça que suporta o fogo e os golpes mais duros."]
	quest.4500000000000012.title: "龙之胸甲 (Peitoral Dracónico)"
	quest.4500000000000013.quest_desc: ["Agilidade e defesa fundidas num só equipamento."]
	quest.4500000000000013.title: "Perneiras Dracónicas"
	quest.4500000000000014.quest_desc: ["Passos pesados e firmes para explorar as piores cavernas."]
	quest.4500000000000014.title: "龙之靴 (Botas Dracónicas)"
	quest.4500000000000021.quest_desc: ["一把渴求战斗的刀刃，专为击败精英怪物而设计。"]
	quest.4500000000000021.title: "龙之剑 Espada Dracónica"
	quest.4500000000000022.quest_desc: ["A ferramenta suprema para rasgar minérios na velocidade da luz."]
	quest.4500000000000022.title: "龙之稿子 (Picareta Dracónica)"
	quest.4500000000000023.quest_desc: ["Corte árvores inteiras ou esmague os escudos inimigos."]
	quest.4500000000000023.title: "Machado Dracónico"
	quest.4500000000000024.quest_desc: ["最坚固的盔甲已经锻造完成。"]
	quest.4500000000000024.title: "龙之庇护所"
	quest.451D7848A6E42C0A.title: "阿尔沃：蝴蝶（Alvo: Butterfly）"
	quest.45411B85CAEE5278.title: "阿尔沃：凤凰"
	quest.4585299286092BE5.title: "阿尔沃：亡魂复仇者"
	quest.45B7E04AC1782E90.quest_desc: [
		"巴西的民间传说在《我的世界》中苏醒。"
		""
		"Prepare-se para explorar novos biomas, realizar rituais sombrios e caçar lendas para forjar equipamentos e feitiços absurdos."
	]
	quest.45EBEBC2485A930D.title: "黄金的出口 (Sai de Ouro)"
	quest.4600000000000001.quest_desc: [
		"Em florestas e planícies floridas, encontrará ninhos guardados por pequenos dragões agressivos chamados Draklets."
		""
		"Derrote-os para obter as suas presas (Teeth), chifres (Horns) e escamas (Scutes). Com eles, pode forjar a perigosa Adaga de Draklet (Draklet Dagger) que aplica veneno nos inimigos!"
	]
	quest.4600000000000001.title: "小飞龙猎人 (Caçador de Draklets)"
	quest.4600000000000002.quest_desc: [
		"Você não precisa de matar todos! Pode domesticar um Draklet selvagem utilizando Carne Crua no Osso (Raw Meat On A Bone)."
		""
		"Ele irá segui-lo para todo o lado, atacará os seus inimigos e pode ser equipado com armaduras para pet!"
	]
	quest.4600000000000002.title: "O Primeiro Companheiro"
	quest.4600000000000003.quest_desc: [
		"在山脉和森林中，寻找巨大的古代石质手形结构。"
		""
		"No topo da mão, usando pelo menos uma Picareta de Diamante, quebre o pedestal e recolha o Ovo Ancestral (Ancient Egg)."
	]
	quest.4600000000000003.title: "德拉克维恩之手 (A Mão do Drakvyrn)"
	quest.4600000000000004.quest_desc: [
		"Para chocar o ovo, você deve recriar o ambiente infernal destes dragões."
		""
		"Coloque um bloco de Netherrack no chão, coloque o Ovo por cima e acenda os 4 lados do bloco com fogo (usando um Isqueiro). Espere um pouco... e o Drakvyrn adulto irá nascer!"
	]
	quest.4600000000000004.title: "火焰仪式 (The Fire Ritual)"
	quest.4600000000000005.quest_desc: [
		"Do espólio do grande dragão caído, você recolheu a Ignition Breath Ball e ossos fortíssimos."
		""
		"Forje o Cajado da Ignição (Ignition Staff)! Esta arma brutal é híbrida: bate com força letal de perto e dispara grandes bolas de fogo aos inimigos de longe."
	]
	quest.4600000000000005.title: "魔杖：点燃之杖"
	quest.4600000000000006.quest_desc: [
		"Com os ossos dracónicos recolhidos, forje a brutal Foice (Scythe)!"
		"她的力量堪比钻石，但攻击范围要大得多！"
	]
	quest.4600000000000006.title: "骨头武器"
	quest.4600000000000007.quest_desc: ["这些无翼龙在雪地上行走速度极快。骑上它们，它们可以在水面上奔跑并将其冻结！"]
	quest.4600000000000007.title: "冰冻的奥兹龙人"
	quest.4600000000000008.quest_desc: ["A Frosted Drozen Spear dispara projéteis gelados que aplicam Lentidão III no alvo."]
	quest.4600000000000008.title: "一把冰霜长矛"
	quest.4600000000000009.quest_desc: ["Os Draekhalde espalham cegueira a quem os tenta atacar. Eles largam a Sandy Toxin e as Escamas do Deserto."]
	quest.4600000000000009.title: "奥斯拉卡尔德（Os Draekhalde）"
	quest.460000000000000A.quest_desc: ["A Cimitarra da Miragem (Scimitar of the Mirage) é incrivelmente poderosa e aplica o efeito de Cegueira aos oponentes."]
	quest.460000000000000A.title: "海市蜃楼与黄沙"
	quest.460000000000000B.quest_desc: ["水龙极其稀有，栖息于海洋的深处进行捕猎。"]
	quest.460000000000000B.title: "奥拉克塔尔深渊领主"
	quest.460000000000000C.quest_desc: [
		"A Abyssal Rapier permite dar um rápido 'Dash' para a frente debaixo de água."
		"As Tochas Abissais iluminam perfeitamente os oceanos!"
	]
	quest.460000000000000C.title: "海洋之主"
	quest.460000000000000D.quest_desc: ["O Ancient Ring permite-lhe guiar plenamente os Drakvyrns. Sente-os clicando ao mesmo tempo que se agacha (SNEAK)."]
	quest.460000000000000D.title: "O Anel de Controlo"
	quest.4600000000000100.quest_desc: [
		"Os Drakvyrns existem em dezenas de variantes por todos os biomas."
		""
		"Pinte todas as cores, colete as escamas e forje cada conjunto de armadura. Complete esta enorme galeria de arte dracônica para provar a sua supremacia!"
	]
	quest.4600000000000100.title: "宏伟的龙之锻造炉"
