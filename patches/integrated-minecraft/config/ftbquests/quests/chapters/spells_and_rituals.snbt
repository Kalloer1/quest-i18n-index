	quest_links: [ ]
	quests: [
		{
			dependencies: ["7D4CC942EA06A8BA"]
			description: [
				"&bRitual Brazier&r 是一种用于执行仪式的强力装置。 &dRituals&r 是更强大的法术版本，有半永久或一次性两种形式。要开始你的第一个仪式，你需要某种 &britual tablet&r。 &e一些常用的 &drituals&e 与这个任务相关。&r"
				""
				"Once you have obtained a &btablet&r of your choice, place the &bbrazier&r on the ground and use the tablet on it. The &dritual&r is now awaiting activation. At this time, you can &eadd augmentations to your ritual&r. Simply throw whichever augments you would like onto the &bbrazier&r. To start the &dritual,&r &einteract with the &bbrazier&e once more&r, making sure you have an empty hand. At this point, no further augments can be added. If &5source&r is needed for the &dritual&r, place &bsource jars&r within 5 blocks of the brazier."
			]
			hide_until_deps_complete: false
			hide_until_deps_visible: false
			id: "5B6BF66A1438206B"
			rewards: [{
				id: "033D6E3474E6B3BE"
				item: "ars_nouveau:ritual_overgrowth"
				type: "item"
			}]
			subtitle: "举行仪式！"
			tasks: [{
				id: "1F09C170D9BE2DE4"
				item: "ars_nouveau:ritual_brazier"
				type: "item"
			}]
			title: "仪式"
			x: 9.0d
			y: -2.5d
		}
		{
			dependencies: ["05E8DA9F79BD179B"]
			description: [
				"&b秘法砧&r是一种中后期设备，用于让你的法术和装备变得更强大。"
				""
				"&dSpells&r can be upgrades by placing the &bspell scroll&r into the anvil along with the next required tier of &bink&r. It could be the same current tier as the scroll or one higher. For example, a level one scroll might require common or uncommon ink. Each spell scroll's requirements are a bit different. &eCombining them in the anvil will raise the spell level by one.&r Continue doing this until it reaches &6Legendary&r rarity. The spell is now at its most powerful."
				""
				"&b升级盔甲和工具 --->"
				"{@pagebreak}"
				"&c盔甲&r可以在&b秘法砧&r中获取魔法力量。将想要升级的物品与&d升级球&r一同放入砧中。使用的球体类型决定了物品将获得的何种力量。默认情况下，每个物品最多可使用三个球体。"
				""
				"&c武器&r可以通过在&b秘法砧&r中组合你选择的&b武器&r和&b法术卷轴&r来附魔。卷轴的等级/稀有度很重要，所以请确保使用你需要的卷轴。"
			]
			id: "5BC9F1BCDE1F04C9"
			rewards: [{
				exclude_from_claim_all: true
				id: "56A1DB56DA631248"
				table_id: 8597076094138939287L
				type: "random"
			}]
			subtitle: "升级法术、法杖和盔甲"
			tasks: [{
				id: "2305031533D68D92"
				item: "irons_spellbooks:arcane_anvil"
				type: "item"
			}]
			x: 1.0d
			y: -1.0d
		}
		{
			dependencies: ["642E1C717C3A8BFC"]
			description: ["&b卷轴锻造台&r用于用墨水、纸张和焦点来制作卷轴。墨水决定稀有度（及等级），焦点决定法术学派。查看&e\"元素魔法\"&r任务章节了解有哪些焦点。"]
			icon: "irons_spellbooks:scroll_forge"
			id: "05E8DA9F79BD179B"
			rewards: [
				{
					count: 10
