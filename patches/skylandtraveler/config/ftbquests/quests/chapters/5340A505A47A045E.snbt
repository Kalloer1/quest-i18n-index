									}
									{
										Count: 6b
										Slot: 9b
										id: "createpropulsion:wooden_blade"
									}
									{
										Count: 1b
										Slot: 10b
										id: "minecraft:written_book"
										tag: {
											author: "xiaobaiYWX"
											filtered_title: "工蜂号天梭艇使用手册"
											pages: [
												"{\"text\":\"天梭艇是一种小型\\n飞行载具。\\n\\n用于进入大型母舰\\n无法到达的区域。\\n\\n例如：\\n\\n下界探索\\n末地探索\\n大型洞穴\\n狭窄空域\"}"
												"{\"text\":\"工蜂号简介\\n----------\\n\\n工蜂号是一艘\\n探索型天梭艇。\\n\\n特点包括：\\n\\n飞行速度较快\\n操控较灵活\\n配备基础工具\\n具备储存空间\\n\\n适合探索任务\"}"
												"{\"text\":\"建造步骤\\n--------\\n\\n建造工蜂号需要\\n蓝图与制造设备。\\n\\n第一步\\n部署蓝图结构\\n\\n将蓝图部署到\\nVS物理化方块\"}"
												"{\"text\":\"结构制造\\n--------\\n\\n蓝图部署完成后\\n\\n使用设备\\n蓝图加农炮\\n\\n启动制造程序\\n\\n等待结构生成\\n\\n完成后进入\\n装配阶段\"}"
												"{\"text\":\"推进系统安装\\n------------\\n\\n在尾部两个\\n螺旋桨轴承上\\n安装螺旋桨\\n\\n完成后需要\\n调整旋转方向\\n\\n否则飞行器\\n会产生扭矩\"}"
												"{\"text\":\"螺旋桨方向\\n----------\\n\\n两个螺旋桨必须\\n反向旋转。\\n\\n否则会产生\\n旋转扭矩。\\n\\n操作方法：\\n空手按住 Shift+右键\\n点击右舷螺旋桨\\n即可反转方向\"}"
												"{\"text\":\"主引擎启动\\n----------\\n\\n工蜂号使用\\n固体燃烧器\\n作为主引擎。\\n\\n向两个燃烧器加入燃料\\n\\n即可启动\\n主推进系统\"}"
												"{\"text\":\"引擎故障\\n--------\\n\\n偶尔可能出现\\n引擎无法转动。\\n\\n这是常见BUG。\\n\\n解决方法：\\n\\n破坏燃烧器重新放置\\n再次添加燃料\"}"
												"{\"text\":\"飞行注意\\n--------\\n\\n工蜂号使用\\n双引擎推进。\\n\\n如果某一侧\\n引擎熄火\\n\\n飞行器可能\\n出现尾旋\"}"
												"{\"text\":\"紧急处理\\n--------\\n\\n发生尾旋时\\n\\n立即关闭 主推进器\\n\\n改用低速 辅助引擎\\n\\n缓慢调整姿态\\n恢复稳定\"}"
												"{\"text\":\"转向系统\\n--------\\n\\n飞行器转向由船首两侧\\n船舶引擎负责控制\\n\\n向其添加燃料即可驱动\\n用于转向和低速移动\"}"
												"{\"text\":\"平说明\\n--------\\n\\n天梭艇体积小重心非常重要\\n\\n推进器必须与船舶质心\\n保持同一水平位置\\n\\n否则会导致\\n仰头或俯冲\"}"
												"{\"text\":\"查看质心\\n--------\\n\\n按下F3+B\\n\\n即可查看船舶质心\\n黄色框架代表重心\"}"
											]
											resolved: 1b
											title: "工蜂号天梭艇使用手册"
										}
									}
								]
								id: "minecraft:shulker_box"
							}
							RepairCost: 0
							display: {
								Name: "{\"text\":\"卫蜂号天梭艇材料盒2\"}"
							}
						}
					}
					type: "item"
				}
