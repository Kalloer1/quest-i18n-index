# AI 初翻，未人工校对
{
	default_hide_dependency_lines: false
	default_quest_shape: ""
	filename: "452B8238F630ACFE"
	group: "23F28E264DDC49EB"
	icon: {
		Count: 1
		id: "minecraft:written_book"
		tag: {
			author: "xiaobaiYWX"
			filtered_title: "[飞艇操作手册]"
			pages: [
				"{\"text\":\"【飞艇操作手册】\\n\\n这本手册会告诉你如何驾驶这艘飞艇。\\n它不能让你成为一名优秀的飞行员，\\n但至少能让你安全起飞，并且安全落地。\\n\\n如果你从未接触过这类飞行结构，\\n请按顺序阅读。\"}"
				"{\"text\":\"【初次见到飞艇】\\n\\n在出生点附近，你会看到一艘已经准备好的飞艇。\\n\\n由于结构生成发生在地形之后，\\n它可能削平了一小块山体，\\n或在地面留下一个坑洞。\\n\\n这都是正常现象。\"}"
				"{\"text\":\"【登艇前检查】\\n\\n在登上飞艇之前，请简单检查一件事：\\n\\n确认飞艇没有与树木、岩石或其他方块连接。\\n\\n通常情况下不会出现这种问题，\\n因为生成时已自动清理周围方块。\"}"
				"{\"text\":\"如果需要登艇，\\n请搭建临时方块上去，\\n并在登艇后清除这些连接。\\n\\n又或者你有什么独门绝技可以让你上去。\"}"
				"{\"text\":\"【登艇后的建议】\\n\\n登上飞艇后，\\n建议先在船内四处走一走。\\n\\n飞艇内部设有指示牌，\\n用于标注主要区域与功能。\\n\\n在熟悉结构之后，\\n再前往驾驶室。\"}"
				"{\"text\":\"【动力系统概览】\\n\\n飞艇配备了两套动力系统：\\n\\n辅助引擎\\n只需放入燃料即可运转，\\n用于日常操作与基础飞行。\\n\\n巡航引擎\\n需要手动启动蒸汽锅炉，\\n并在驾驶室启用操纵杆。\\n它可以提供更高的巡航速度。\"}"
				"{\"text\":\"正常情况下，仅使用辅助引擎即可飞行。\\n\\n如果你有一定经验可以尝试更改结构，\\n\\n以次来达到完全自定义的飞行操作及探索体验。\"}"
				"{\"text\":\"【关于巡航引擎】\\n\\n巡航引擎只在无人掌舵时生效。\\n\\n当有人正在操控船舵时，\\n巡航引擎不会提供额外推力。\\n\\n因此，它更适合用于\\n稳定方向后的长距离飞行。\"}"
				"{\"text\":\"【基础操控方式】\\n\\n在掌舵状态下：\\n\\nW / A / S / D：调整方向\\n\\n空格：上升\\n\\nV：下降\\n\\nC：启用定速巡航\\n\\n具体按键可在设置中自行修改。\"}"
				"{\"text\":\"【无人掌舵飞行】\\n\\n当无人掌舵，\\n且巡航引擎处于开启状态时\\n\\n飞艇会沿当前方向持续加速，\\n直到关闭引擎、重新掌舵，\\n或撞上某个东西。\\n\\n请谨慎使用。\"}"
				"{\"text\":\"【气囊与结构】\\n\\n飞艇的升力来自顶部的气囊。\\n\\n气囊采用分区设计，\\n以避免单点破损引发连锁反应而坠毁。\\n\\n初始气囊数量留有较大余量。\\n如果后期载重增加，\\n需自行添加更多气囊。\"}"
				"{\"text\":\"【实体化与安全】\\n\\n飞艇在生成后需要进行实体化，\\n才能正常飞行。\\n\\n在实体化前，请确保：\\n\\n船内没有自然方块\\n\\n没有流体或活动机械\\n\\n对着船舵使用右键并选择【组装】即可。\"}"
				"{\"text\":\"实体化完成后，\\n不建议频繁拆解。\\n\\n如需拆解，请保证没有正在运行的机器，\\n\\n且所有机器均处于方块状态在进行拆解。\"}"
				"{\"text\":\"【重要提醒】\\n\\n这艘飞艇仅能在当前整合包中正常运作。\\n\\n登艇后，\\n请尽快在床上设置重生点。\\n\\n从空中坠落，\\n通常不是一个好的结局。\\n\\n可能会导致飞艇丢失。\"}"
				"{\"text\":\"【结语】\\n如果你已经把这本手册翻完\\n那么你大概已经比它的上一位驾驶者更认真了。\\n\\n至少现在，\\n你知道这艘飞艇不会自己飞走。\\n\\n希望如此。\\n\\n天空很大，\\n飞行并不急于这一刻。\"}"
			]
			resolved: 1b
			title: "[飞艇操作手册]"
		}
	}
