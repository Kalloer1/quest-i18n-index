		}
		{
			dependencies: [
				"4AE1951118152B17"
				"48F371B1FAB5A936"
			]
			description: [
				"当能源系统崩溃后，"
				"最先适应高温与辐射的，是他们。"
				""
				"它们并不是入侵者，"
				"他们是继承者。"
				""
				"猪灵占据了废弃的冶炼区和储能仓库，"
				"将工业残骸改造成部落据点。"
				""
				"他们了解黄金的导热性，"
				"却无法理解旧时代的公式。"
				""
				"在废热与灰烬之间，"
				"他们建立了新的规则。"
			]
			icon: "minecraft:gold_ingot"
			id: "66135504113541DE"
			shape: "circle"
			size: 2.0d
			subtitle: "在废热之中重建秩序"
