# AI 初翻，未人工校对
{
	chapter.18EA0CFDF0B44DFB.title: "&a&lOritech"
	file.0000000000000001.title: "&l&a改进的奥里泰克科技"
	quest.029E70967F58BA11.quest_desc: [
		"&7✔ &f&e工业支撑梁&f是用于高级工业合成的结构组件。\n\n&7✔ &f主要用于合成&e精炼室模块&f。\n\n&7✔ &f该梁为精炼系统提供必要的结构支撑。"
		"{image:kubejs:textures/images/industrialsupportbeam.png width:120 height:70 align:center}"
	]
	quest.029E70967F58BA11.quest_subtitle: "&7Industrial structural component"
	quest.029E70967F58BA11.title: "&5&l任务：&r&e工业支撑梁"
	quest.039350F50D87D871.quest_desc: [
		"&7✔ &fThe &eFuel Generator&f is a very powerful energy generator that uses liquid fuels to operate.\n\n&7✔ &fIt can run with fluids such as &6Petroleum&f, &6Turbo Fuel&f, &6Diesel&f and other refined fuels to generate large amounts of energy.\n\n&7✔ &fTo use it efficiently, supply it with fuel using &bFluid Pipes&f and distribute the produced energy to your machines."
		"{image:kubejs:textures/images/fuelgenerator.png width:120 height:70 align:center}"
	]
	quest.039350F50D87D871.quest_subtitle: "&7精炼燃料提供的能量"
	quest.039350F50D87D871.title: "&5&l任务：&r&e燃料发电机"
	quest.05B4C5F373AD89B5.quest_desc: [
		"&7✔ &f&6Sheol Fire &fis obtained in the &eRefinery &fby processing &6Lava&f.\n\n&7✔ &fThis volatile fluid can be used as a fuel source for the &eLava Generator &fto produce &bEnergy&f.\n\n&7✔ &fIt is also used in the &eRefinery &fto extract &6Lava &fagain while producing &eTerrones &fas a byproduct."
		"{image:kubejs:textures/images/sheolfire.png width:120 height:70 align:center}"
	]
	quest.05B4C5F373AD89B5.quest_subtitle: "&7一种易挥发的熔融资源"
	quest.05B4C5F373AD89B5.title: "&5&l任务：&r&eSheol Fire"
	quest.061E01605C3EB47F.quest_desc: [
		"&7✔ &f&fRaw Silicon&f 是一种用于许多电子和科技组件的重要材料。"
		""
		"&7✔ &f你可以用 &f2 石英粉&f 和 &e2 任意类型的沙子&f 来合成。"
		""
		"&7✔ &f这种材料通常用作生产更高级硅基组件的第一步。"
		"{image:kubejs:textures/images/rawsilicon.png width:120 height:70 align:center}"
	]
	quest.061E01605C3EB47F.quest_subtitle: "&7电子元件的关键材料"
	quest.061E01605C3EB47F.title: "&5&l任务：&r&e原始硅晶圆"
	quest.06504C57B2015ADC.quest_desc: [
		"&7✔ &fThe &dFlux Gate&f is a key component crafted in the &aAssembler&f using &dFluxite&f as its primary material.\n\n&7✔ &fThis device is extremely important for technological progression, as it is required in the crafting of several advanced machines.\n\n&7✔ &fMastering the production of &dFlux Gates&f will unlock access to more powerful industrial systems."
		"{image:kubejs:textures/images/fluxgate.png width:120 height:70 align:center}"
	]
	quest.06504C57B2015ADC.quest_subtitle: "&7通往先进技术的门户"
	quest.06504C57B2015ADC.title: "&5&l任务：&r&eFlux Gate"
	quest.06858AD9307D01C7.quest_desc: [
		"&7✔ &fThe &aFoundry&f is a machine used to melt and process certain materials into refined metal ingots.\n\n&7✔ &fBy smelting specific resources inside this machine, you can obtain valuable metals that cannot be produced in a regular furnace.\n\n&7✔ &fSome of these materials will become very important later in your technological progression."
		"{image:kubejs:textures/images/foundry.png width:120 height:70 align:center}"
	]
	quest.06858AD9307D01C7.quest_subtitle: "&7工业金属加工"
	quest.06858AD9307D01C7.title: "&5&l任务：&r&e铸造厂"
	quest.0986931120FF78DD.quest_desc: [
		"&7✔ &f&8Carbon Reinforced Plating&f provides a darker industrial style perfect for machinery rooms and technological environments.\n\n&7✔ &fIt can also serve as a crafting ingredient in advanced Oritech structures.\n\n&7✔ &fCraft it using &74 Stone&f, &74 Steel Ingots&f and &81 Reinforced Carbon Plate&f.\n\n&7✔ &fLike other reinforced platings, it can be crafted into &fStairs&f, &fSlabs&f and &fPressure Plates&f for decorative builds."
		"{image:kubejs:textures/images/revestimientocarbon.png width:120 height:70 align:center}"
	]
	quest.0986931120FF78DD.quest_subtitle: "&7工业强度的深色面板"
	quest.0986931120FF78DD.title: "&5&l任务：&r&e碳纤维加固装甲板"
	quest.0A51B586AA278A80.quest_desc: [
		"&7✔ &f&eLight Naphtha &fis produced in the &eRefinery &fprocessing &eBiofuel&f, &eOil &for &eHeavy Oil&f.\n\n&7✔ &fIn the &eCentrifuge &fit can be used to generate &bSilicon Wash &fand &ePolymer Resin&f.\n\n&7✔ &fIt can also be used as fuel for the &eFuel Generator &fand is required in the &eRefinery &fto produce the &eReinforced Carbon Sheet&f."
		"{image:kubejs:textures/images/lightnaphtha.png width:120 height:70 align:center}"
	]
	quest.0A51B586AA278A80.quest_subtitle: "&7一种精炼的化学液体"
	quest.0A51B586AA278A80.title: "&5&l任务：&r&e轻质石油醚"
	quest.0B64FC76C936A184.quest_desc: [
		"&7✔ &fThe &eElite Machine Core&f is a powerful upgrade for advanced machines.\n\n&7✔ &fIt allows machines to install up to &b+5 Addon Slots&f.\n\n&7✔ &fCrafting it requires &eAdamant &fand a &eComputing Engine&f."
		"{image:kubejs:textures/images/core5.png width:120 height:70 align:center}"
	]
	quest.0B64FC76C936A184.quest_subtitle: "&7Highly advanced machine core"
	quest.0B64FC76C936A184.title: "&5&l任务：&r&e精英机器核心"
	quest.0C10E257A0E6F607.quest_desc: [
		"&7✔ &fThe &eBoosted Elytra&f combines the mobility of &bElytra &fwith the power of a &eJetpack&f.\n\n&7✔ &fThis allows you to glide like normal Elytra while also using the Jetpack to gain altitude without relying on rockets.\n\n&7✔ &fUsing the jet boost will consume &bEnergy &fand also grant a small &bSpeed Boost&f while flying."
		"{image:kubejs:textures/images/boostedelytra.png width:120 height:70 align:center}"
	]
	quest.0C10E257A0E6F607.quest_subtitle: "&7喷气辅助滑翔机"
	quest.0C10E257A0E6F607.title: "&5&l任务：&r&e动力滑翔翼"
	quest.0D36B88912DABB82.quest_desc: [
		"&7✔ &fThe &6Lava Generator&f produces energy by consuming &6Lava&f as its primary fuel source.\n\n&7✔ &fThis machine can power nearby machines directly or distribute energy through &bEnergy Pipes&f to reach systems located farther away.\n\n&7✔ &fDuring its crafting recipe you can use any variant of &7Reinforced Plating&f as part of the components."
		"{image:kubejs:textures/images/lavagenerator.png width:120 height:70 align:center}"
	]
	quest.0D36B88912DABB82.quest_subtitle: "&7利用熔岩中的能量发电"
	quest.0D36B88912DABB82.title: "&5&l任务：&r&e岩浆发电机"
	quest.0D6A2645C5924BD8.quest_desc: [
		"&7✔ &fThe &eDuratium Ingot&f is an advanced alloy obtained in the &eFoundry&f.\n\n&7✔ &fIt is created by melting a &6Netherite Ingot &fwith a &bPlatinum Ingot&f.\n\n&7✔ &fThis material is mainly used to craft several advanced machines, addons and important components later in the progression."
		"{image:kubejs:textures/images/duratium.png width:120 height:70 align:center}"
	]
	quest.0D6A2645C5924BD8.quest_subtitle: "&7一种非常耐用的合金"
	quest.0D6A2645C5924BD8.title: "&5&l任务：&r&e杜拉提乌姆锭"
	quest.0FD45C1FFD122223.quest_desc: [
		"&7✔ &f&aNickel Reinforced Plating&f is a decorative industrial block that adds a technological machinery style to factories and mechanical structures.\n\n&7✔ &fIt can also be used as an ingredient for several Oritech machines.\n\n&7✔ &fCraft it using &74 Stone&f, &74 Steel Ingots&f and &a1 Nickel Ingot&f.\n\n&7✔ &fFrom this block you can also craft &fStairs&f, &fSlabs&f and &fPressure Plates&f to expand your building designs."
		"{image:kubejs:textures/images/revestimientoniquel.png width:120 height:70 align:center}"
	]
	quest.0FD45C1FFD122223.quest_subtitle: "&7机械风格的金属板甲"
	quest.0FD45C1FFD122223.title: "&5&l任务：&r&e镍强化装甲板"
	quest.1289A1F92E7263FB.quest_desc: [
		"&7✔ &fThe &eSuperconductor&f is a special component used to transfer &bEnergy &fat extremely high speeds.\n\n&7✔ &fIt is also required to craft several advanced machines and cores.\n\n&7✔ &fUnlike normal energy pipes, &eSuperconductors &fcannot be combined or connected with regular pipes, so they must be used in their own network."
		"{image:kubejs:textures/images/superconductor.png width:120 height:70 align:center}"
	]
	quest.1289A1F92E7263FB.quest_subtitle: "&7高速能量传输"
	quest.1289A1F92E7263FB.title: "&5&l任务：&r&e超导体"
	quest.12BE6E5DB1C10684.quest_desc: [
		"&7✔ &fThe &eExo Chestplate&f is a powerful artifact that stores &bEnergy&f.\n\n&7✔ &fIt automatically supplies energy to other equipped artifacts.\n\n&7✔ &fTo craft it you will mainly need an &eAdvanced Battery&f."
		"{image:kubejs:textures/images/exochestplate.png width:120 height:70 align:center}"
	]
	quest.12BE6E5DB1C10684.quest_subtitle: "&7便携式能源供应器"
	quest.12BE6E5DB1C10684.title: "&5&l任务：&r&e外骨骼胸甲"
	quest.14BC0923C0B95706.quest_desc: [
		"&7✔ &f&f石英粉&f是通过加工含石英物品获得的精炼材料。\\n\\n&7✔ &f你可以使用&a粉碎机&f，通过粉碎&f石英&f或几乎所有含石英的物品来生产它。\\n\\n&7✔ &f这种细粉被用于Oritech的多种科技配方和高级合成工艺中。"
		"{image:kubejs:textures/images/quartzdust.png width:120 height:70 align:center}"
	]
	quest.14BC0923C0B95706.quest_subtitle: "&7精细加工的石英块"
	quest.14BC0923C0B95706.title: "&5&l任务：&r&e石英粉"
	quest.15898EF7DE6494BD.quest_desc: [
		"&7✔ &fThe &eExo Boots&f are foot artifacts designed for mobility and protection.\n\n&7✔ &fTheir main ability is preventing &cFall Damage&f.\n\n&7✔ &fThey require &eSilicon &fas one of their crafting components."
		"{image:kubejs:textures/images/exoboots.png width:120 height:70 align:center}"
	]
	quest.15898EF7DE6494BD.quest_subtitle: "&7安全着陆"
	quest.15898EF7DE6494BD.title: "&5&l任务：&r&e外骨骼靴子"
	quest.179A369F347A1714.quest_desc: [
		"&7✔ &fThe &dEnergite Ingot&f is produced in the &aFoundry&f by combining &aNickel&f with &dFluxite&f.\n\n&7✔ &fThis special alloy contains concentrated energy properties that make it useful for advanced technology.\n\n&7✔ &f&dEnergite&f is required for crafting several machines, addons and other important technological components."
		"{image:kubejs:textures/images/energiteingot.png width:120 height:70 align:center}"
	]
	quest.179A369F347A1714.quest_subtitle: "&7注入了能量的金属"
	quest.179A369F347A1714.title: "&5&l任务：&r&e能量锭"
	quest.1910976C2A0F0CCB.quest_desc: [
		"&7✔ &fThe &eCybernetic Research Station&f is one of the required components for the &eCybernetic Augmentation Center&f.\n\n&7✔ &fThis station focuses on the study and development of &bcybernetic technologies &fused with the player.\n\n&7✔ &fIt must be assembled together with the other research stations for the augmentation system to function properly."
		"{image:kubejs:textures/images/cyberneticstation.png width:120 height:70 align:center}"
	]
	quest.1910976C2A0F0CCB.quest_subtitle: "&7正在研究赛博科技"
	quest.1910976C2A0F0CCB.title: "&5&l任务：&r&e赛博研究站"
	quest.1C07A4E4EF60D5AE.quest_desc: [
		"&7✔ &f&a马达&f是用于为许多 Oritech 机器和自动化系统提供动力的关键机械部件。"
		""
		"&7✔ &f电机为各种机器的运行提供所需的机械力，是工业技术的重要组成部分。"
		""
		"{image:kubejs:textures/images/motor.png width:120 height:70 align:center}"
	]
	quest.1C07A4E4EF60D5AE.quest_subtitle: "&7机器背后的驱动力"
	quest.1C07A4E4EF60D5AE.title: "&5&l任务：&r&e马达"
	quest.1D7E847C94B1A3B9.quest_desc: [
		"&7✔ &fThe &ePipe Wrench&f is a useful tool for configuring how pipes connect to machines, inventories and other pipes.\n\n&7✔ &fPipes usually connect automatically to everything around them, which can sometimes cause unwanted connections.\n\n&7✔ &fUsing the wrench you can modify the direction a pipe connects to, giving you precise control over your item, fluid and energy networks."
		"{image:kubejs:textures/images/pipewrench.png width:120 height:70 align:center}"
	]
	quest.1D7E847C94B1A3B9.quest_subtitle: "&7控制你的管道连接方式"
	quest.1D7E847C94B1A3B9.title: "&5&l任务：&r&e管道扳手"
	quest.1D96B5EC516E4269.quest_desc: [
		"&7✔ &fThe &ePrometheum Ingot&f is a powerful material obtained in the &eAtomic Forge&f using an &eOvercharged Crystal &fand a &eHeisenberg Compensator&f.\n\n&7✔ &fThis rare alloy is used to craft powerful artifacts such as the &ePrometheum Pickaxe &fand the &ePrometheum Battle Axe&f.\n\n&7✔ &fDue to the complexity of its ingredients, it represents one of the most advanced materials in your progression."
		"{image:kubejs:textures/images/prometheum.png width:120 height:70 align:center}"
	]
	quest.1D96B5EC516E4269.quest_subtitle: "&7一种传奇合金"
	quest.1D96B5EC516E4269.title: "&5&l任务：&r&e普罗米修斯锭"
	quest.1DD2094BE3939110.quest_desc: ["&7✔ &fWhile exploring uranium deposits, you may notice strange glowing crystals growing on top of &2Uranium Ore&f.\n\n&7✔ &fThese are &aUranium Crystals&f, a special resource used in several Oritech technologies.\n\n&7✔ &fBe careful when harvesting them: you will need a tool enchanted with &bSilk Touch&f to collect the crystal intact."]
	quest.1DD2094BE3939110.quest_subtitle: "&7一种脆弱的放射性生长物"
	quest.1DD2094BE3939110.title: "&5&l任务：&r&e铀晶块"
	quest.1DD79CF371D772C3.quest_desc: [
		"&7✔ &fThe &eSuper AI Chip&f is crafted in the &eAtomic Forge&f using &dDuratium &fand an &eAdvanced Computing Engine&f.\n\n&7✔ &fThis highly advanced component represents a major technological step in your factory progression.\n\n&7✔ &fIt is used to craft several &eadvanced machines &fand powerful &eaddons&f."
		"{image:kubejs:textures/images/superaichip.png width:120 height:70 align:center}"
	]
	quest.1DD79CF371D772C3.quest_subtitle: "&7一个先进的智能核心"
	quest.1DD79CF371D772C3.title: "&5&l任务：&r&e超级AI芯片"
	quest.206A634A4E77FA8D.quest_desc: [
		"&7✔ &f&e高级机器核心&f使机器最多可支持 &b+4 个附加插槽&f。\n\n&7✔ &f制作此核心需要一个 &e末地岩组件&f。\n\n&7✔ &f此核心是中后期机器的一项重大升级。"
		"{image:kubejs:textures/images/core4.png width:120 height:70 align:center}"
	]
	quest.206A634A4E77FA8D.quest_subtitle: "&7高级机器核心"
	quest.206A634A4E77FA8D.title: "&5&l任务：&r&e高级机器核心"
	quest.228F5F3A4FBEB08D.quest_desc: [
		"&7✔ &f&e速度插件&f是一种能提升机器运行速度的机器升级。\n\n&7✔ &f安装此插件后，机器处理物品的速度会比平时更快。\n\n&7✔ &f然而，这以牺牲效率为代价，导致机器运行时消耗更多的&b能量&f。"
		"{image:kubejs:textures/images/speedaddon.png width:120 height:70 align:center}"
	]
	quest.228F5F3A4FBEB08D.quest_subtitle: "&7更快的机器"
	quest.228F5F3A4FBEB08D.title: "&5&l任务：&r&e速度加成模组"
	quest.237752D9C8724A5A.quest_desc: [
		"&7✔ &fThe &eRefinery Chamber Module&f is used to craft the &eRefinery&f machine.\n\n&7✔ &fIt represents one of the main structural parts of the refinery system.\n\n&7✔ &fAdditional modules can also expand the machine's capabilities."
		"{image:kubejs:textures/images/refinerychambermodule.png width:120 height:70 align:center}"
	]
	quest.237752D9C8724A5A.quest_subtitle: "&7精炼厂扩建组件"
	quest.237752D9C8724A5A.title: "&5&l任务：&r&e精炼室模块"
	quest.23E79C329E4E0E07.quest_desc: [
		"&7✔ &fThe &bAdvanced Battery&f is a powerful energy component crafted using &dEnergite&f.\n\n&7✔ &fIt is used in the crafting of several important machines and technological tools.\n\n&7✔ &fSome examples include the &eSolar Panel&f and the &5Enderic Railgun&f, making this battery an important step toward more advanced energy systems."
		"{image:kubejs:textures/images/advancebatery.png width:120 height:70 align:center}"
	]
	quest.23E79C329E4E0E07.quest_subtitle: "&7大容量储能装置"
	quest.23E79C329E4E0E07.title: "&5&l任务：&r&e高级电池"
	quest.249909092289B309.quest_desc: [
		"&7✔ &fThe &ePrometheum Pickaxe&f is a powerful mining tool with two selectable modes.\n\n&7✔ &fOne mode works with &bSilk Touch&f, while the other allows mining in a &b3x3 Area&f.\n\n&7✔ &fIt requires &ePrometheum Ingots &fand the &eDestroyer Block &fmachine to craft."
		"{image:kubejs:textures/images/prometheumpickaxe.png width:120 height:70 align:center}"
	]
	quest.249909092289B309.quest_subtitle: "&7高级采矿工具"
	quest.249909092289B309.title: "&5&l任务：&r&e普罗米修斯镐"
	quest.24E4C32667E358C6.quest_desc: [
		"&7✔ &f&e机器扩展插件&f是一种用于增加机器可用端口的组件。\n\n&7✔ &f当机器默认端口不足时，此插件非常实用。可安装的扩展总数取决于机器所用&b核心&f所支持的最大数量。\n\n&7✔ &f制作它需要&e加固外壳&f、&e基础核心&f和&d杜拉提乌姆锭&f。"
		"{image:kubejs:textures/images/extender.png width:120 height:70 align:center}"
	]
	quest.24E4C32667E358C6.quest_subtitle: "&7扩展机器能力</c1>"
	quest.24E4C32667E358C6.title: "&5&l任务：&r&e机器扩展插件"
	quest.2535BA7CC26E83D0.quest_desc: [
		"&7✔ &f&6Copper Reinforced Plating&f is a decorative block that brings an engineering and machinery aesthetic to your industrial builds.\n\n&7✔ &fIt can also be used as an ingredient for various Oritech machines and structures.\n\n&7✔ &fCraft it using &74 Stone&f, &74 Steel Ingots&f and &61 Copper Ingot&f.\n\n&7✔ &fFrom this block you can also craft &fStairs&f, &fSlabs&f and &fPressure Plates&f for additional building options."
		"{image:kubejs:textures/images/revestimientocobre.png width:120 height:70 align:center}"
	]
	quest.2535BA7CC26E83D0.quest_subtitle: "&7Industrial decoration with copper accents"
	quest.2535BA7CC26E83D0.title: "&5&l任务：&r&e铜质加固板甲"
	quest.259F7DB51ECD6C05.quest_desc: [
		"&7✔ &f在&aOritech&f中，矿物是技术进步的基础。无论是像&7煤炭&f、&f铁&f、&6金&f、&b钻石&f、&6铜&f、&9青金石&f和&c红石&f等经典的Minecraft矿石，还是模组新增的矿石，对于制造机器和高级组件都至关重要。\\n\\n&7✔ &f探索洞穴时，你会发现诸如&6镍&f、&b铂&f和&2铀&f等新资源。此外，一些矿物簇甚至可以在地表找到，奖励那些仔细探索世界的玩家。"
		"{image:kubejs:textures/images/minerals.png width:180 height:100 align:center}"
	]
	quest.259F7DB51ECD6C05.quest_subtitle: "&7工业发展的资源来源"
	quest.259F7DB51ECD6C05.title: "&5&l任务：&r&eOritech矿物"
	quest.260F6526642F5F66.quest_desc: [
		"&7✔ &fThe &aBio Generator&f produces energy by consuming organic materials and natural resources.\n\n&7✔ &fIt can use fuels such as &2Raw Biopolymer&f, &aSaplings&f, &2Biomass&f and other biological materials.\n\n&7✔ &fThis generator is a useful renewable power source for running your machines using materials gathered from nature."
		"{image:kubejs:textures/images/biogenerator.png width:120 height:70 align:center}"
	]
	quest.260F6526642F5F66.quest_subtitle: "&7来自有机资源的能量"
	quest.260F6526642F5F66.title: "&5&l任务：&r&e生物发电机"
	quest.27B079F38718AF54.quest_desc: ["&7✔ &f&bPlatinum&f is a rarer metal used for more advanced machinery and refined components.\n\n&7✔ &fIt generates deeper underground, so exploring large cave systems or mining at lower levels will help you locate it.\n\n&7✔ &fProcessing platinum later in the tech chain may also yield rare byproducts useful for advanced technology."]
	quest.27B079F38718AF54.quest_subtitle: "&7一种稀有而珍贵的金属"
	quest.27B079F38718AF54.title: "&5&l任务：&r&e寻找铂金"
	quest.27FCB5CE5E160584.quest_desc: [
		"&7✔ &fThe &5Enderic Lens&f is a special component crafted using the &aAssembler&f.\n\n&7✔ &fThis lens is used in the crafting of several machines and advanced technological components.\n\n&7✔ &fHarnessing the energy of the End, it becomes an important material for progressing into more complex Oritech technology."
		"{image:kubejs:textures/images/endericlens.png width:120 height:70 align:center}"
	]
	quest.27FCB5CE5E160584.quest_subtitle: "&7汇聚末地的力量，使其集中一点"
	quest.27FCB5CE5E160584.title: "&5&l任务：&r&e末地透镜"
	quest.2850B03E48E155F5.quest_desc: [
		"&7✔ &f&bSteam &fcan be obtained in the &eRefinery &fby processing &6Lava&f.\n\n&7✔ &fIt can also be produced through a transformation system using the &eSteam Boiler Addon &fto convert &bWater &finto steam.\n\n&7✔ &fSteam is used to generate &bEnergy &fwith the &eSteam Engine &fand to create &fSnow Blocks &fin the &eIndustrial Chiller&f."
		"{image:kubejs:textures/images/steam.png width:120 height:70 align:center}"
	]
	quest.2850B03E48E155F5.quest_subtitle: "&7高压能源装置"
	quest.2850B03E48E155F5.title: "&5&l任务：&r&e蒸汽"
	quest.290E0E2D35B9C93B.quest_desc: [
		"&7✔ &fThe &bTransparent Item Pipe&f is used to transport items from one place to another within your automation systems.\n\n&7✔ &fIt can connect to &eChests&f, &aMachines&f and other inventories to automatically move items between them.\n\n&7✔ &fThanks to its transparent design, you can visually see the items traveling through the pipes as they move across your factory."
		"{image:kubejs:textures/images/itempipe.png width:120 height:70 align:center}"
	]
	quest.290E0E2D35B9C93B.quest_subtitle: "&7将物品通过你的工厂运输"
	quest.290E0E2D35B9C93B.title: "&5&l任务：&r&e透明物品管道"
	quest.29D1A40EC5ACE245.quest_desc: [
		"&7✔ &fThe &7Steel Ingot&f is a stronger metal alloy widely used in industrial machinery and reinforced components.\n\n&7✔ &fYou can craft it by combining &f2 Iron Ingots&f with &8 2 Coal&f, representing the carbon needed to strengthen the metal.\n\n&7✔ &fSteel is commonly required for durable machine parts and more advanced technological structures."
		"{image:kubejs:textures/images/steel.png width:120 height:70 align:center}"
	]
	quest.29D1A40EC5ACE245.quest_subtitle: "&7一种更坚固的工业合金"
	quest.29D1A40EC5ACE245.title: "&5&l任务：&r&e钢锭"
	quest.29DFF176225F3578.quest_desc: ["&7✔ &f部分 Oritech 机器需要 &5机器核心&f 才能完全建造并开始运行。\n\n&7✔ &f机器核心有不同的等级，其制作材料也因品质而异。\n\n&7✔ &f更高等级的核心能提高机器品质，从而连接更多的 &d扩展组件&f 和附加模块。\n\n&7✔ &f选择更好的核心能让你的机器支持更多升级和更高级的配置。"]
	quest.29DFF176225F3578.quest_subtitle: "&7高级机器的核心组件"
	quest.29DFF176225F3578.title: "&5&l任务：&r&e机器核心"
	quest.2ACB5AE19385BC2D.quest_desc: ["&7✔ &f许多&e神器&f都可以通过&b能量&f来激发其全部潜力。\\n\\n&7✔ &f保持其充能状态，能让其能力正常、高效地运作。\\n\\n&7✔ &f神器可通过&e装备充电器&f进行充能。"]
	quest.2ACB5AE19385BC2D.quest_subtitle: "&7为您的装备提供动力"
	quest.2ACB5AE19385BC2D.title: "&5&l任务：&r&e可充能物品"
	quest.2CA48A6493BAD6BD.quest_desc: ["&7✔ &fMachine &eCores &fare essential components used to assemble most machines.\n\n&7✔ &fThey define the base capabilities of the machine and determine how many &bAddons &fcan be installed to improve its performance.\n\n&7✔ &fThis mission is intended as a requirement before progressing into quests related to building and upgrading machines."]
	quest.2CA48A6493BAD6BD.quest_subtitle: "&7每台机器的核心所在"
	quest.2CA48A6493BAD6BD.title: "&5&l任务：&r&e机器核心"
	quest.2E27E967B4D04172.quest_desc: [
		"&7✔ &fThe &eExo Jetpack&f allows the player to &bFly &fjust like the normal &eJetpack&f.\n\n&7✔ &fHowever it also includes the functionality of the &eExo Chestplate&f, allowing it to store a large amount of &bEnergy&f.\n\n&7✔ &fIt is crafted by combining the &eJetpack &fwith the &eExo Chestplate&f."
		"{image:kubejs:textures/images/exojetpack.png width:120 height:70 align:center}"
	]
	quest.2E27E967B4D04172.quest_subtitle: "&7高级空中机动性"
	quest.2E27E967B4D04172.title: "&5&l任务：&r&e外骨骼喷气背包"
	quest.2E66B157E5A1F2A4.quest_desc: [
		"&7✔ &fThe &eUltimate Machine Core&f is the strongest core available for machines.\n\n&7✔ &fIt allows a machine to install up to &b+7 Addon Slots&f.\n\n&7✔ &fCrafting it requires the legendary &ePrometheum Ingot &fand a &bSuperconductor&f."
		"{image:kubejs:textures/images/core7.png width:120 height:70 align:center}"
	]
	quest.2E66B157E5A1F2A4.quest_subtitle: "&7最强大的机器核心"
	quest.2E66B157E5A1F2A4.title: "&5&l任务：&r&e终极机器核心"
	quest.2EBBDC8BCAFAC7D9.quest_desc: [
		"&7✔ &fThe &aFragment Forge&f is a specialized machine that fragments certain resources to obtain new materials from them.\n\n&7✔ &fThrough this process you can produce items that would normally take much longer to obtain manually.\n\n&7✔ &fBecause of this, the &aFragment Forge&f becomes a very important machine for improving efficiency and progressing further into advanced Oritech technology."
		"{image:kubejs:textures/images/fragmentforge.png width:120 height:70 align:center}"
	]
	quest.2EBBDC8BCAFAC7D9.quest_subtitle: "&7将资源分解为新材料"
	quest.2EBBDC8BCAFAC7D9.title: "&5&l任务：&r&e碎片锻造炉"
	quest.31F8C5D39AB07AE9.quest_desc: [
		"&7✔ &fThe &eElectric Mace&f is a weapon capable of unleashing a small &bLightning Storm &fwhen attacking enemies.\n\n&7✔ &fWhile lightning strikes are falling, the weapon can deal additional damage.\n\n&7✔ &fDespite this ability, it behaves similarly to a normal mace during combat."
		"{image:kubejs:textures/images/electricmace.png width:120 height:70 align:center}"
	]
	quest.31F8C5D39AB07AE9.quest_subtitle: "&7风暴动力武器"
	quest.31F8C5D39AB07AE9.title: "&5&l任务：&r&e电击战锤"
	quest.3349505B673E11CE.quest_desc: [
		"&7✔ &f&aBioSteel Ingot&f 是一种替代金属合金，在 &aFoundry&f 中使用 &2Raw Biopolymer&f 和 &fIron&f 生产。"
		""
		"&7✔ &f在许多合成配方中，这种材料是&7钢&f的廉价替代品。"
		""
		"&7✔ &f得益于更简单的生产流程，&aBioSteel&f能帮助你更高效地推进Oritech科技。"
		"{image:kubejs:textures/images/biosteelingot.png width:120 height:70 align:center}"
	]
	quest.3349505B673E11CE.quest_subtitle: "&7一种更便宜的替代合金"
	quest.3349505B673E11CE.title: "&5&l任务：&r&e生物钢锭"
	quest.340C69C98C436590.quest_desc: [
		"&7✔ &fThe &eIon Thruster&f is crafted in the &eAssembler&f.\n\n&7✔ &fThis advanced propulsion component is used to craft several artifacts and technological components.\n\n&7✔ &fIt represents an important step in building advanced mobility equipment."
		"{image:kubejs:textures/images/ionthruster.png width:120 height:70 align:center}"
	]
	quest.340C69C98C436590.quest_subtitle: "&7高能推进组件"
	quest.340C69C98C436590.title: "&5&l任务：&r&e离子推进器"
	quest.34202C91BECED7E8.quest_desc: [
		"&7✔ &fThe &eBasic Battery&f is a simple energy component used in several crafting recipes.\n\n&7✔ &fIts main purpose is to craft the &ePortable Energy Storage&f, which allows you to store and transport energy.\n\n&7✔ &fThis makes it an important early component for building portable power systems."
		"{image:kubejs:textures/images/basicbattery.png width:120 height:70 align:center}"
	]
	quest.34202C91BECED7E8.quest_subtitle: "&7小型能量组件"
	quest.34202C91BECED7E8.title: "&5&l任务：&r&e基础电池"
	quest.3451B9B228F5732E.quest_desc: [
		"&7✔ &fThe &ePowered Furnace&f is an electric furnace that requires &bEnergy&f to operate.\n\n&7✔ &fIt can smelt items just like a normal furnace, but it runs using power instead of fuel.\n\n&7✔ &fYou can improve its performance by installing machine addons such as the &eSpeed Addon &fand the &eEfficiency Addon&f."
		"{image:kubejs:textures/images/poweredfurnace.png width:120 height:70 align:center}"
	]
	quest.3451B9B228F5732E.quest_subtitle: "&7一种用电熔炼的方法"
	quest.3451B9B228F5732E.title: "&5&l任务：&r&e动力熔炉"
	quest.34545A548CE5373D.quest_desc: [
		"&7✔ &f&bFluid Pipes&f are used to transport liquids between machines that handle fluids.\n\n&7✔ &fThey allow systems such as fuel processing, chemical production and other fluid-based machines to connect and operate together.\n\n&7✔ &fCraft them using &fSilicon&f and &6Copper&f to begin building your fluid transport networks."
		"{image:kubejs:textures/images/fluidpipe.png width:120 height:70 align:center}"
	]
	quest.34545A548CE5373D.quest_subtitle: "&7在机器之间运输液体"
	quest.34545A548CE5373D.title: "&5&l任务：&r&e流体管道"
	quest.35E7127767498DC3.quest_desc: [
		"&7✔ &fThe &eAcceptor Addon&f is an upgrade designed for &eEnergy Storage&f blocks.\n\n&7✔ &fWhen installed, it increases both the &benergy capacity &fand the &benergy transfer speed&f.\n\n&7✔ &fThis allows your storage systems to hold more power and move energy faster between machines and generators."
		"{image:kubejs:textures/images/acceptor.png width:120 height:70 align:center}"
	]
	quest.35E7127767498DC3.quest_subtitle: "&7升级你的储能装置"
	quest.35E7127767498DC3.title: "&5&l任务：&r&eAcceptor 附加组件"
	quest.3B1C4F836F521D66.quest_desc: [
		"&7✔ &fThe &eQuantum Research Station&f is another component required for the &eCybernetic Augmentation Center&f.\n\n&7✔ &fThis station studies &dquantum technologies &fand advanced energy interactions.\n\n&7✔ &fIt must be combined with the other research stations to fully activate the augmentation system."
		"{image:kubejs:textures/images/quantumstation.png width:120 height:70 align:center}"
	]
	quest.3B1C4F836F521D66.quest_subtitle: "&7探索量子可能性"
	quest.3B1C4F836F521D66.title: "&5&l任务：&r&e量子研究站"
	quest.3D446713803B10EE.quest_desc: [
		"&7✔ &fThe &eCybernetic Augmentation Center&f is a very useful machine that grants passive or active upgrades to help in survival situations.\n\n&7✔ &fThese augmentations can provide abilities such as &bNight Vision &for even allow you to create &dPortals&f.\n\n&7✔ &fTo function properly, the machine must be assembled with three additional components: the &eCybernetic Research Station&f, the &eQuantum Research Station&f and the &eArcane Research Station&f."
		"{image:kubejs:textures/images/cyberneticaugmentation.png width:120 height:70 align:center}"
	]
	quest.3D446713803B10EE.quest_subtitle: "&7增强你的能力，提升自我！"
	quest.3D446713803B10EE.title: "&5&l任务：&r&e赛博增强中心"
	quest.3E15C6F0B5293379.quest_desc: [
		"&7✔ &fThe &eSpawner Cage&f is a structural component used to build mob spawning systems.\n\n&7✔ &fIt is mainly required to craft the &eSpawner Controller&f.\n\n&7✔ &fThese cages form the containment structure used by the machine."
		"{image:kubejs:textures/images/spawnercage.png width:120 height:70 align:center}"
	]
	quest.3E15C6F0B5293379.quest_subtitle: "&7收容这些生物"
	quest.3E15C6F0B5293379.title: "&5&l任务：&r&e刷怪笼囚笼"
	quest.3EAEAEB1BA080DCF.quest_desc: ["&7✔ &f&fSilicon&f is a refined material widely used in electronic components and technological crafting.\n\n&7✔ &fTo obtain it, simply smelt &fRaw Silicon&f in a regular &6Furnace&f.\n\n&7✔ &fOnce refined, &fSilicon&f becomes an essential ingredient for producing more advanced technological parts."]
	quest.3EAEAEB1BA080DCF.quest_subtitle: "&7用于电子元件的精细材料"
	quest.3EAEAEB1BA080DCF.title: "&5&l任务：&r&e硅晶圆"
	quest.3EC21428B321089B.quest_desc: ["&7✔ &fAfter mining &bPlatinum Ore&f, you will obtain &aRaw Platinum&f.\n\n&7✔ &fSmelt the &aRaw Platinum&f in a regular &6Furnace&f to refine it into a &bPlatinum Ingot&f, a valuable material used in more advanced Oritech machinery and components."]
	quest.3EC21428B321089B.quest_subtitle: "&7从原始金属到纯净锭块"
	quest.3EC21428B321089B.title: "&5&l任务：&r&e精炼铂金"
	quest.402628F72458D55B.quest_desc: [
		"&7✔ &fThe &eJetpack&f is an artifact that allows the player to &bFly&f.\n\n&7✔ &fIt requires &bEnergy &fto function.\n\n&7✔ &fKeeping it charged will allow you to freely move through the air."
		"{image:kubejs:textures/images/jetpack.png width:120 height:70 align:center}"
	]
	quest.402628F72458D55B.quest_subtitle: "&7翱翔天际，一展宏图"
	quest.402628F72458D55B.title: "&5&l任务：&r&e喷气背包"
	quest.408979488967571B.quest_desc: [
		"&7✔ &fThe &5Enderic Compound&f is obtained by processing an &5Ender Pearl&f in the &aPulverizer&f.\n\n&7✔ &fThis mysterious material is used to craft several important technological components.\n\n&7✔ &fIt can also be processed in the &aRefinery&f to produce different useful fluids required for advanced industrial processes."
		"{image:kubejs:textures/images/endericcompound.png width:120 height:70 align:center}"
	]
	quest.408979488967571B.quest_subtitle: "&7末地精华"
	quest.408979488967571B.title: "&5&l任务：&r&e末地化合物"
	quest.408AF631DD1ECDFB.quest_desc: [
		"&7✔ &fThe &eSteam Engine&f is a generator that produces energy using &bSteam&f.\n\n&7✔ &fSteam can be supplied using the &eSteam Boiler Addon&f connected to another machine or generator before reaching the &eSteam Engine&f.\n\n&7✔ &fOver time the engine can accumulate &bWater&f inside, which reduces its operating speed, so it is recommended to extract the water using &bFluid Pipes&f and store it in a &ePortable Tank&f."
		"{image:kubejs:textures/images/steamengine.png width:120 height:70 align:center}"
	]
	quest.408AF631DD1ECDFB.quest_subtitle: "&7蒸汽驱动的能量来源"
	quest.408AF631DD1ECDFB.title: "&5&l任务：&r&e蒸汽引擎"
	quest.41627C829F1C0684.quest_desc: [
		"&7✔ &fThe &eItem Filter&f is a block used to control which items are allowed to pass through &bItem Pipes&f.\n\n&7✔ &fIt supports multiple filtering methods, including a &aWhitelist&f, filtering by &dNBT data&f and filtering by &bComponents&f.\n\n&7✔ &fUsing filters allows you to build more precise automation systems by ensuring only the correct items move through your transport network."
		"{image:kubejs:textures/images/itemfilter.png width:120 height:70 align:center}"
	]
	quest.41627C829F1C0684.quest_subtitle: "&7控制哪些物品可以通过"
	quest.41627C829F1C0684.title: "&5&l任务：&r&e物品过滤器"
	quest.419A019D18509219.quest_desc: [
		"&7✔ &f&8碳粉&f是通过研磨碳基燃料获得的加工材料。"
		""
		"&7✔ &f使用&aPulverizer&f，将&8Coal&f或&8Charcoal&f粉碎即可生成。"
		""
		"&7✔ &f这种优质的碳粉可用于各种工业配方和高级材料加工。"
		"{image:kubejs:textures/images/coaldust.png width:120 height:70 align:center}"
	]
	quest.419A019D18509219.quest_subtitle: "&7精细研磨的碳粉"
	quest.419A019D18509219.title: "&5&l任务：&r&e碳粉粉尘"
	quest.4253F7A727F745CF.quest_desc: [
		"&7✔ &fThe &eBoosted Exo Elytra&f is an advanced version of the Boosted Elytra.\n\n&7✔ &fIt combines the power of the &eJetpack&f, &eElytra &fand the &eExo Chestplate&f.\n\n&7✔ &fThis allows it to store a massive amount of &bEnergy &fand supply power to other equipped artifacts. It is crafted using the &eBoosted Elytra&f, the &eExo Chestplate &fand an &eIon Thruster&f."
		"{image:kubejs:textures/images/boostedexoelytra.png width:120 height:70 align:center}"
	]
	quest.4253F7A727F745CF.quest_subtitle: "&7终极空中机动性"
	quest.4253F7A727F745CF.title: "&5&l任务：&r&e加速外骨骼鞘翅"
	quest.42FEB5F8EBBC4E49.quest_desc: [
		"&7✔ &f&a离心机&f是一种通过高速旋转来分离和加工材料的机器。\\n\\n&7✔ &f用这台机器可以获得重要的资源，例如&5末地化合物&f、&2铀粉&f和&8碳纤维线&f。"
		"{image:kubejs:textures/images/centrifuge1.png width:120 height:70 align:center}"
		"{image:kubejs:textures/images/centrifuge2.png width:120 height:70 align:center}"
	]
	quest.42FEB5F8EBBC4E49.quest_subtitle: "&7通过旋转来分离材料"
	quest.42FEB5F8EBBC4E49.title: "&5&l任务：&r&e离心机"
	quest.4500A62E62987DA7.quest_desc: [
		"&7✔ &f&aPulverizer&f 是一种将各种材料粉碎成粉末和加工资源的机器。 &f用这台机器，你可以生产诸如 &8Carbon Dust&f、&eSand&f、&2Biomass&f 和 &5Enderic Compound&f 等以及其他实用材料。\\n\\n&7✔ &f这些加工后的资源通常是更高级合成配方和工业生产链所必需的。"
		"{image:kubejs:textures/images/pulverizer1.png width:120 height:70 align:center}"
		"{image:kubejs:textures/images/pulverizer2.png width:120 height:70 align:center}"
	]
	quest.4500A62E62987DA7.quest_subtitle: "&7将材料粉碎成有用的粉尘"
	quest.4500A62E62987DA7.title: "&5&l任务：&r&e粉碎机"
	quest.45F49EF090384735.quest_desc: [
		"&7✔ &f&fIron Reinforced Plating&f 是一种坚固的装饰性方块，可为您的工厂和机器增添真正的工业外观。\n\n&7✔ &f它也可以作为多种 Oritech 机器的组件使用。\n\n&7✔ &f使用 &74 Stone&f、&74 Steel Ingots&f 和 &f1 Iron Ingot&f 制作。\n\n&7✔ &f该方块还可制作成 &fStairs&f、&fSlabs&f 和 &fPressure Plates&f，以扩展建筑可能性。"
		"{image:kubejs:textures/images/revestimientohierro.png width:120 height:70 align:center}"
	]
	quest.45F49EF090384735.quest_subtitle: "&7坚固的工业风格面板"
	quest.45F49EF090384735.title: "&5&l任务：&r&e铁质加固板"
	quest.47A5F1BB6A2759BA.quest_desc: [
		"&7✔ &f&6Petroleum &fcan be found naturally in the &bSurface &fworld as liquid deposits.\n\n&7✔ &fThese sources can be collected manually using &eBuckets &for extracted automatically using a &ePump&f.\n\n&7✔ &fThis fluid is very valuable because it can be refined into different fuels used to generate &bEnergy&f."
		"{image:kubejs:textures/images/oil.png width:120 height:70 align:center}"
	]
	quest.47A5F1BB6A2759BA.quest_subtitle: "&7一种宝贵的天然燃料"
	quest.47A5F1BB6A2759BA.title: "&5&l任务：&r&e石油"
	quest.49327AC610596199.quest_desc: [
		"&7✔ &fThe &eReinforced Carbon Sheet&f is obtained by refining &bCarbon Fiber Threads &fwith &eLight Naphtha&f.\n\n&7✔ &fThis advanced material is used to craft the &eReinforced Carbon Casing&f.\n\n&7✔ &fIt is also required to assemble the &eIon Thruster &fand to obtain the &eDuration Ingot &fin the &eAtomic Forge&f."
		"{image:kubejs:textures/images/reinforcedcarbonsheet.png width:120 height:70 align:center}"
	]
	quest.49327AC610596199.quest_subtitle: "&7精炼碳材料"
	quest.49327AC610596199.title: "&5&l任务：&r&e加固碳板"
	quest.49AD5DABD2280DF9.quest_desc: [
		"&7✔ &f&e设备充电器&f是一种用&b能量&f为&b物品&f充能的机器。\\n\\n&7✔ &f它必须先从一个任意&e能量发电机&f获取电力。\\n\\n&7✔ &f只需将想要充能的物品放入机器槽位，它就会自动为其充能。"
		"{image:kubejs:textures/images/equipmentcharger.png width:120 height:70 align:center}"
		"{image:kubejs:textures/images/equipmentcharger2.png width:120 height:70 align:center}"
	]
	quest.49AD5DABD2280DF9.quest_subtitle: "&7为你的遗物充能吧"
	quest.49AD5DABD2280DF9.title: "&5&l任务：&r&e装备充电器"
	quest.49C97847B6CD25BC.quest_desc: [
		"&7✔ &fThe &bMagnetic Coil&f is an essential component used in many Oritech machines and electrical systems.\n\n&7✔ &fIt can be crafted using &a6 Nickel Ingots&f and &73 Steel Ingots&f, producing &e4 Magnetic Coils&f per craft.\n\n&7✔ &fThese coils are commonly required in technological recipes where energy, magnetism and industrial machinery come together."
		"{image:kubejs:textures/images/bobinamagnetica.png width:120 height:70 align:center}"
	]
	quest.49C97847B6CD25BC.quest_subtitle: "&7机械的核心组件"
	quest.49C97847B6CD25BC.title: "&5&l任务：&r&e磁线圈"
	quest.4A7D7CFE21D0F020.quest_desc: [
		"&7✔ &fThe &ePower Bank Addon Extender&f combines the functionality of the &eExtender &fand the &eCapacitor Addon&f.\n\n&7✔ &fIt can store energy and also allows additional addons to be placed around it, expanding the machine capabilities.\n\n&7✔ &fAlthough its energy transfer rate is lower, it is still very useful for increasing energy storage and flexibility in your machines."
		"{image:kubejs:textures/images/capacitorextender.png width:120 height:70 align:center}"
	]
	quest.4A7D7CFE21D0F020.quest_subtitle: "&7能量存储与扩展"
	quest.4A7D7CFE21D0F020.title: "&5&l任务：&r&ePower Bank 扩展附加包"
	quest.4CBCE86AF8D3D400.quest_desc: [
		"&7✔ &f&eArcane Catalyst&f 是一种用于附魔&b工具、武器和盔甲&f的机器。\n\n&7✔ &f要使其工作，需要一本&eMax Level Enchanted Book &f和对应插槽的物品。机器会消耗附近被击杀的怪物所储存的&dSouls &f。\n\n&7✔ &f当所需的灵魂数量达到时，机器会自动提升物品的附魔等级，甚至会超过附魔书的等级。 &eEnderic Laser &f可以增加灵魂容量，但超过限制可能会导致机器不稳定。"
		"{image:kubejs:textures/images/arcanecatalyst.png width:120 height:70 align:center}"
	]
	quest.4CBCE86AF8D3D400.quest_subtitle: "&7Empowering enchantments with souls"
	quest.4CBCE86AF8D3D400.title: "&5&l任务：&r&e神秘催化剂"
	quest.4D8397A1234B0C6B.quest_desc: [
		"&7✔ &fThe &eSteam Boiler Addon&f is a component that converts &bWater&f into &bSteam&f.\n\n&7✔ &fAs mentioned before, this steam can be used to power machines such as the &eSteam Engine&f.\n\n&7✔ &fThis addon is placed in between &bFluid Pipes&f, allowing the water flowing through the pipes to be transformed into steam before reaching the connected machine or generator."
		"{image:kubejs:textures/images/steamboiler.png width:120 height:70 align:center}"
	]
	quest.4D8397A1234B0C6B.quest_subtitle: "&7将水转化为蒸汽"
	quest.4D8397A1234B0C6B.title: "&5&l任务：&r&e蒸汽锅炉扩展包"
	quest.505164CD74BC6E3A.quest_desc: [
		"&7✔ &fThe &eEnderic Railgun&f is a powerful portable laser weapon that must be charged with &bEnergy&f.\n\n&7✔ &fIt has two modes: one that fires explosive blasts causing massive damage, and another that destroys blocks and sends them directly to your inventory.\n\n&7✔ &fTo craft it you will need an &eEnderic Laser &fand a &eParticle Accelerator Linear Motor&f."
		"{image:kubejs:textures/images/endericrailgun.png width:120 height:70 align:center}"
	]
	quest.505164CD74BC6E3A.quest_subtitle: "&7便携式激光武器"
	quest.505164CD74BC6E3A.title: "&5&l任务：&r&e末地人轨道炮"
	quest.509042B4BAA1E2AC.quest_desc: [
		"&7✔ &fThe &eSolar Panel&f is a renewable energy generator that produces power using sunlight.\n\n&7✔ &fDuring the day it generates and stores energy, which can then be distributed to nearby machines.\n\n&7✔ &fThis makes it a very useful passive power source for keeping your factory running without consuming fuel."
		"{image:kubejs:textures/images/solarpanel.png width:120 height:70 align:center}"
	]
	quest.509042B4BAA1E2AC.quest_subtitle: "&7 harness the power of the sun"
	quest.509042B4BAA1E2AC.title: "&5&l任务：&r&e太阳能电池板"
	quest.516DFB2A23498B08.quest_desc: [
		"&7✔ &fThe &aYield Addon&f is a powerful upgrade designed to improve the efficiency of certain machines.\n\n&7✔ &fWhen installed in the &aFragment Forge&f, it increases the amount of resources extracted during the fragmentation process.\n\n&7✔ &fThis addon effectively &edoubles the output&f of the machine, making it extremely valuable for large scale resource production."
		"{image:kubejs:textures/images/yieldaddon.png width:120 height:70 align:center}"
	]
	quest.516DFB2A23498B08.quest_subtitle: "&7产量翻倍"
	quest.516DFB2A23498B08.title: "&5&l任务：&r&e增产附加组件"
	quest.51B328233482AFF8.quest_desc: [
		"&7✔ &fThe &eExo Helmet&f is a head artifact that provides &bNight Vision&f.\n\n&7✔ &fThis allows you to see clearly in dark environments without using torches or potions.\n\n&7✔ &fIt requires an &eEnderic Lens &fas a key component for its crafting."
		"{image:kubejs:textures/images/exohelmet.png width:120 height:70 align:center}"
	]
	quest.51B328233482AFF8.quest_subtitle: "&7增强视力"
	quest.51B328233482AFF8.title: "&5&l任务：&r&e外骨骼头盔"
	quest.5274C8965AE32C69.quest_desc: [
		"&7✔ &fThe &dProcessing Unit&f is an important technological component used in the crafting of many machines, addons and advanced items.\n\n&7✔ &fAs your factory grows, this component will become essential for building more complex industrial systems.\n\n&7✔ &fProducing &dProcessing Units&f is a key step in progressing further into Oritech technology."
		"{image:kubejs:textures/images/processingunit.png width:120 height:70 align:center}"
	]
	quest.5274C8965AE32C69.quest_subtitle: "&7高级技术的核心组件"
	quest.5274C8965AE32C69.title: "&5&l任务：&r&e处理单元"
	quest.52F6CC1B60E21A5C.quest_desc: [
		"&7✔ &f&bEnergy Pipes&f allow you to transfer energy from generators or power storage blocks to machines that require electricity.\n\n&7✔ &fThey are especially useful when your power source is located far from the machines you want to operate.\n\n&7✔ &fUsing these pipes you can build organized energy networks to distribute power throughout your industrial systems."
		"{image:kubejs:textures/images/energypipe.png width:120 height:70 align:center}"
	]
	quest.52F6CC1B60E21A5C.quest_subtitle: "&7在机器之间传输电力"
	quest.52F6CC1B60E21A5C.title: "&5&l任务：&r&e能量管道"
	quest.53E28FC5BFC76740.quest_desc: [
		"&7✔&f&a镍&f是奥里泰克机械和组件中最常用的金属之一。"
		""
		"&7✔ &f你可以在主世界的洞穴和岩层中挖掘地下时找到&a镍矿石&f。"
		""
		"&7✔&f这种金属广泛用于机器零件、合金和其他技术组件中，是首批应收集的资源之一。"
	]
	quest.53E28FC5BFC76740.quest_subtitle: "&7一种常见的工业金属"
	quest.53E28FC5BFC76740.title: "&5&l任务：&r&e寻找镍矿"
	quest.551500A56E449D24.quest_desc: [
		"&7✔ &fThe &bAdamant Ingot&f is a powerful alloy used in some of the most durable and advanced Oritech components.\n\n&7✔ &fIt can be crafted by combining &a2 Nickel Ingots&f with &b2 Diamonds&f, creating a metal reinforced with one of the hardest materials known.\n\n&7✔ &fAdamant is often required for high-tier machines and structures that must withstand extreme industrial processes."
		"{image:kubejs:textures/images/adamant.png width:120 height:70 align:center}"
	]
	quest.551500A56E449D24.quest_subtitle: "&7一种极其耐用的合金"
	quest.551500A56E449D24.title: "&5&l任务：&r&eAdamant Ingot"
	quest.5554D6E5DF235451.quest_desc: [
		"&7✔ &f&6Heavy Oil &fis obtained in the &eRefinery &fby processing &eOil&f.\n\n&7✔ &fThis dense fluid can be used as fuel in the &eFuel Generator &fto produce &bEnergy&f.\n\n&7✔ &fIt is also an important resource in the &eRefinery &fas it can be processed to generate &6Diesel&f, &eLight Naphtha &fand &aSulfuric Acid&f."
		"{image:kubejs:textures/images/heavyoil.png width:120 height:70 align:center}"
	]
	quest.5554D6E5DF235451.quest_subtitle: "&7一种密度高的精炼燃料"
	quest.5554D6E5DF235451.title: "&5&l任务：&r&e重油"
	quest.55D6CC0D00C53590.quest_desc: [
		"&7✔ &f&e链锯&f是一种主要用于伐木的强大神器。\n\n&7✔ &f它伤害高，潜行状态下破坏原木时可以砍倒整棵树。\n\n&7✔ &f要制作它，你需要一个&e末地岩组件&f和&e艾德曼&f。"
		"{image:kubejs:textures/images/chainsaw.png width:120 height:70 align:center}"
	]
	quest.55D6CC0D00C53590.quest_subtitle: "&7穿过这片森林吧"
	quest.55D6CC0D00C53590.title: "&5&l任务：&r&e链锯"
	quest.5643BBBB2653C28F.quest_desc: ["&7✔ &fAfter mining &aNickel Ore&f you will obtain &aRaw Nickel&f.\n\n&7✔ &fSmelt the &aRaw Nickel&f in a regular &6Furnace&f to produce a &aNickel Ingot&f, an important metal used in many Oritech recipes.\n\n&7✔ &fNickel is commonly used for alloys, machine components and various technological structures."]
	quest.5643BBBB2653C28F.quest_subtitle: "&7用途广泛的工业金属"
	quest.5643BBBB2653C28F.title: "&5&l任务：&r&e镍锭"
	quest.56C48B2680F7C628.quest_desc: ["&7✔ &f&2Uranium&f is a dangerous but extremely valuable resource used for advanced energy systems.\n\n&7✔ &fIt can be found deep underground in the Overworld while mining.\n\n&7✔ &fUranium becomes especially important in the late stages of Oritech when dealing with high-energy machines and nuclear technology."]
	quest.56C48B2680F7C628.quest_subtitle: "&7强大技术的燃料来源"
	quest.56C48B2680F7C628.title: "&5&l任务：&r&e寻找铀矿"
	quest.571E45C79CC58155.quest_desc: [
		"&7✔ &fThe &eRefinery&f is a machine used to refine &bLiquids &fwith additional materials.\n\n&7✔ &fThis process allows you to extract different fluids or materials which may serve as &bFuel &for as ingredients for other crafting recipes.\n\n&7✔ &fYou can install up to &e2 Refinery Chamber Modules &fto allow the machine to extract up to &63 different liquids&f."
		"{image:kubejs:textures/images/refinery.png width:120 height:70 align:center}"
	]
	quest.571E45C79CC58155.quest_subtitle: "&7正在处理复杂流体"
	quest.571E45C79CC58155.title: "&5&l任务：&r&e精炼厂"
	quest.5B97BC669E78846C.quest_desc: [
		"&7✔ &fThe &eParticle Accelerator Linear Motor&f is an advanced technological component.\n\n&7✔ &fIt is required to craft the powerful &eEnderic Railgun&f.\n\n&7✔ &fIt is also used as a key part for constructing the &eParticle Accelerator&f machine."
		"{image:kubejs:textures/images/particleacceleratorlinearmotor.png width:120 height:70 align:center}"
	]
	quest.5B97BC669E78846C.quest_subtitle: "&7高级推进组件"
	quest.5B97BC669E78846C.title: "&5&l任务：&r&e粒子加速器线性马达"
	quest.5C0D0B0565F3228D.quest_desc: [
		"&7✔ &f&6Turbo Fuel &fcan be found naturally at the bottom of certain surface mineral clusters, located just above the &8Bedrock&f.\n\n&7✔ &fIt can also be produced in the &eCentrifuge &fby processing &eDiesel &fwith &dFluxite&f.\n\n&7✔ &fThis fluid is one of the most powerful fuels and is the main resource used by the &eFuel Generator &fto produce large amounts of &bEnergy&f."
		"{image:kubejs:textures/images/turbofuel2.png width:120 height:70 align:center}"
	]
	quest.5C0D0B0565F3228D.quest_subtitle: "&7一种强大的精炼燃料"
	quest.5C0D0B0565F3228D.title: "&5&l任务：&r&e涡轮燃料"
	quest.5D33AB2140F6033F.quest_desc: [
		"&7✔ &fThe &eSpawner Controller&f is built using &eSpawner Cages&f.\n\n&7✔ &fThis machine allows you to capture a specific &bMob &fand store it inside the system.\n\n&7✔ &fAfter capturing it, you can spawn that mob as many times as you want by offering &dSouls &fas fuel."
		"{image:kubejs:textures/images/spawnercontroller.png width:120 height:70 align:center}"
	]
	quest.5D33AB2140F6033F.quest_subtitle: "&7控制生物生成位置"
	quest.5D33AB2140F6033F.title: "&5&l任务：&r&e生成器控制器"
	quest.5D43A4E7007FE808.quest_desc: [
		"&7✔ &fThe &ePrimitive Machine Core&f is the most basic core used to assemble machines.\n\n&7✔ &fIt is very cheap to craft and allows a machine to install up to &b+1 Addon Slot&f.\n\n&7✔ &fAlthough simple, it is a good starting point for early machine setups."
		"{image:kubejs:textures/images/core1.png width:120 height:70 align:center}"
	]
	quest.5D43A4E7007FE808.quest_subtitle: "&7The simplest machine core"
	quest.5D43A4E7007FE808.title: "&5&l任务：&r&e原始机器核心"
	quest.5D4B2FFFCEB1B87F.quest_desc: [
		"&7✔ &fThe &ePortable Energy Storage&f is used to store and transfer energy between machines and generators.\n\n&7✔ &fIt has two sides for energy flow: the &aGreen side &freceives energy, while the &cRed side &foutputs energy.\n\n&7✔ &fThis makes it very useful for transporting power to different parts of your factory or powering machines that are far from your generators."
		"{image:kubejs:textures/images/energystorage.png width:120 height:70 align:center}"
	]
	quest.5D4B2FFFCEB1B87F.quest_subtitle: "&7储存并转移你的能量"
	quest.5D4B2FFFCEB1B87F.title: "&5&l任务：&r&e便携式储能装置"
	quest.5E62090E69E8E623.quest_desc: [
		"&7✔ &f&6Diesel &fcan be produced in the &eRefinery &fusing &eBiofuel&f, &eHeavy Oil &for &eOil&f.\n\n&7✔ &fThis fuel can be processed in the &eCentrifuge &fwith &dFluxite &fto create &6Turbo Fuel&f.\n\n&7✔ &fIt can also be used directly as a fuel source for the &eFuel Generator &fto produce &bEnergy&f."
		"{image:kubejs:textures/images/diesel.png width:120 height:70 align:center}"
	]
	quest.5E62090E69E8E623.quest_subtitle: "&7用途广泛的工业燃料"
	quest.5E62090E69E8E623.title: "&5&l任务：&r&e柴油发动机"
	quest.5F72ED9EB189EB0D.quest_desc: [
		"&7✔ &f&aSulfuric Acid &fis obtained in the &eRefinery &fby processing &6Lava&f, &eOil &for &eHeavy Oil&f.\n\n&7✔ &fIn the &eCentrifuge &fit can be used to produce &7Mineral Slurry &fand various &bGems&f.\n\n&7✔ &fIt is also used as a resource to craft both &eBasic Batteries &fand &eAdvanced Batteries&f."
		"{image:kubejs:textures/images/sulfuricacid.png width:120 height:70 align:center}"
	]
	quest.5F72ED9EB189EB0D.quest_subtitle: "&7一种具有腐蚀性的工业化学品"
	quest.5F72ED9EB189EB0D.title: "&5&l任务：&r&e硫酸"
	quest.5FFF2C3AA365F7A2.quest_desc: [
		"&7✔ &fThe &eExo Leggings&f are leg artifacts that improve mobility.\n\n&7✔ &fWhen worn they provide a &bsmall speed boost &fwhile moving.\n\n&7✔ &fThey require a &eMotor &fas a component for crafting."
		"{image:kubejs:textures/images/exoleggings.png width:120 height:70 align:center}"
	]
	quest.5FFF2C3AA365F7A2.quest_subtitle: "&7移动速度加快"
	quest.5FFF2C3AA365F7A2.title: "&5&l任务：&r&e外骨骼护腿"
	quest.61856906EB8DC0D6.quest_desc: [
		"&7✔ &fThe &eHeisenberg Compensator&f is an advanced component used together with the &eOvercharged Crystal &fto obtain &dPrometheum &fin the &eAtomic Forge&f.\n\n&7✔ &fThis device plays an important role in stabilizing high energy crafting processes.\n\n&7✔ &fIt is also required to craft the powerful &eBedrock Extractor&f."
		"{image:kubejs:textures/images/compensator.png width:120 height:70 align:center}"
	]
	quest.61856906EB8DC0D6.quest_subtitle: "&7复杂的稳定化组件"
	quest.61856906EB8DC0D6.title: "&5&l任务：&r&e海森堡补偿器"
	quest.61DA6B51A5825ED0.quest_desc: [
		"&7✔ &fThe &eBasic Machine Core&f is an upgrade over the primitive version.\n\n&7✔ &fMachines assembled with this core can support up to &b+2 Addon Slots&f.\n\n&7✔ &fThis allows slightly better customization and performance improvements."
		"{image:kubejs:textures/images/core2.png width:120 height:70 align:center}"
	]
	quest.61DA6B51A5825ED0.quest_subtitle: "&7改进的机器核心"
	quest.61DA6B51A5825ED0.title: "&5&l任务：&r&e基础机器核心"
	quest.6291FB8154D41B77.quest_desc: [
		"&7✔ &fThe &eDubious Container&f is used in the &eAssembler&f to obtain the &dSuperconductor&f.\n\n&7✔ &fIf you interact with an &bAllay&f while holding the container, you will obtain &bClean Intelligence&f.\n\n&7✔ &fThis resource is used to craft several advanced machines and important components later in progression."
		"{image:kubejs:textures/images/dubiouscontainer.png width:120 height:70 align:center}"
	]
	quest.6291FB8154D41B77.quest_subtitle: "&7一个奇特但实用的容器"
	quest.6291FB8154D41B77.title: "&5&l任务：&r&e可疑的容器"
	quest.62B1203FFF7FF3B0.quest_desc: [
		"&7✔ &f&a基础发电机&f是用于为您的 Oritech 技术生产能量的首批机器之一。"
		""
		"&7✔ &f它通过消耗燃料来发电，例如&8煤炭&f、&6木材&f、&e烈焰棒&f和其他可燃材料。"
		""
		"&7✔ &f发电机会自动向紧邻其旁的机器传输能量，使其能够运行。"
		""
		"{image:kubejs:textures/images/basicgenerator.png width:120 height:70 align:center}"
	]
	quest.62B1203FFF7FF3B0.quest_subtitle: "&7你的第一份能量来源"
	quest.62B1203FFF7FF3B0.title: "&5&l任务：&r&e基础发电机"
	quest.630486987C4C3EFD.quest_desc: [
		"&7✔ &fThe &eArcane Research Station&f is the final component required for the &eCybernetic Augmentation Center&f.\n\n&7✔ &fThis station focuses on the study of &5arcane energy &fand mystical phenomena.\n\n&7✔ &fTogether with the other research stations, it enables the full functionality of the augmentation system."
		"{image:kubejs:textures/images/arcanestation.png width:120 height:70 align:center}"
	]
	quest.630486987C4C3EFD.quest_subtitle: "&7将魔法与科技融为一体"
	quest.630486987C4C3EFD.title: "&5&l任务：&r&e神秘研究站"
	quest.63CB20776213E94D.quest_desc: [
		"&7✔ &fThe &eImproved Machine Core&f offers better machine capabilities.\n\n&7✔ &fMachines using this core can support up to &b+3 Addon Slots&f.\n\n&7✔ &fAt this stage crafting the cores becomes slightly more expensive, but greatly improves machine flexibility."
		"{image:kubejs:textures/images/core3.png width:120 height:140 align:center}"
	]
	quest.63CB20776213E94D.quest_subtitle: "&7中阶机器核心"
	quest.63CB20776213E94D.title: "&5&l任务：&r&e改进型机器核心"
	quest.64853C8DA675CCE5.quest_desc: [
		"&7✔ &fThe &bPortable Tank&f is used to store fluids for later use in machines and processing systems.\n\n&7✔ &fIt can be filled manually using &eBuckets&f or automatically through &bFluid Pipes&f connected to machines that produce or transfer liquids.\n\n&7✔ &fPortable Tanks are useful for managing and transporting fluids within your industrial setups."
		"{image:kubejs:textures/images/portabletank.png width:120 height:70 align:center}"
	]
	quest.64853C8DA675CCE5.quest_subtitle: "&7储存和移动你的液体物品"
	quest.64853C8DA675CCE5.title: "&5&l任务：&r&e便携式储罐"
	quest.650FB8E1A0634EAA.quest_desc: [
		"&7✔ &f&6Packed Wheat&f is a compressed form of wheat used as an ingredient in several organic and fuel-related crafting recipes.\n\n&7✔ &fIt can be crafted by combining &eWheat&f to create a more compact material for industrial processing."
		"{image:kubejs:textures/images/packedwheat.png width:120 height:70 align:center}"
	]
	quest.650FB8E1A0634EAA.quest_subtitle: "&7压缩有机物材料"
	quest.650FB8E1A0634EAA.title: "&5&l任务：&r&e包装小麦"
	quest.651A9A16B97C40B1.quest_desc: [
		"&7✔ &f&e原子熔炉&f是一种需要&b激光能量&f才能运行的特殊机器。"
		""
		"&7✔ &f必须使用激光能量系统供电，而非普通的电力连接。"
		""
		"&7✔ &f这台机器用于制作其他机器和强大物品所需的多种高级组件。"
		"{image:kubejs:textures/images/atomicforge.png width:120 height:70 align:center}"
	]
	quest.651A9A16B97C40B1.quest_subtitle: "&7用激光能量锻造而成"
	quest.651A9A16B97C40B1.title: "&5&l任务：&r&e原子熔炉"
	quest.65D46AFA3E41B004.quest_desc: [
		"&7✔ &f&eOvercharged Crystal&f 是一种强大的材料，用于制作多种高级机器和扩展包。"
		""
		"&7✔ &f它也是获取重要组件的关键材料，例如在&e原子熔炉&f中获取的&dPrometheum &f。"
		""
		"&7✔ &f由于其高能量特性，它在制作后期科技时必不可少。"
		"{image:kubejs:textures/images/overchargedcrystal.png width:120 height:70 align:center}"
	]
	quest.65D46AFA3E41B004.quest_subtitle: "&7一个充满能量的晶体"
	quest.65D46AFA3E41B004.title: "&5&l任务：&r&e过载水晶"
	quest.689348479FD09E48.quest_desc: [
		"&7✔ &fThe &eDestroyer Block&f is a machine used to destroy blocks within a configured area.\n\n&7✔ &fAll removed blocks are automatically collected and stored, making it ideal for clearing large spaces.\n\n&7✔ &fIt is also required for crafting several powerful artifacts and its recipe requires an &eEnderic Laser &fand a &ePulverizer&f."
		"{image:kubejs:textures/images/destroyerblock.png width:120 height:70 align:center}"
	]
	quest.689348479FD09E48.quest_subtitle: "&7自动化方块移除器"
	quest.689348479FD09E48.title: "&5&l任务：&r&e破坏者方块"
	quest.692FED1D41708B71.quest_desc: [
		"&7✔ &fThe &eAdvanced Computing Engine&f is crafted in the &eAtomic Forge&f using a &eSilicon Wafer &fand a &bProcessing Unit&f.\n\n&7✔ &fThis advanced component is required to craft the &eSuper AI Chip &fin the &eAtomic Forge&f.\n\n&7✔ &fIt is also used to craft the &eLevel 5 Core &fand the &eDrone Port&f."
		"{image:kubejs:textures/images/advancedcomputingengine.png width:120 height:70 align:center}"
	]
	quest.692FED1D41708B71.quest_subtitle: "&7一个强大的计算组件"
	quest.692FED1D41708B71.title: "&5&l任务：&r&e高级计算引擎"
	quest.6A45403A5632C1C8.quest_desc: [
		"&7✔ &fThe &eSilicon Wafer&f is a component crafted in the &eAtomic Forge&f using &bCarbon Fiber Thread &fand &eSilicon&f.\n\n&7✔ &fThis refined material is an important step in the creation of advanced technological components.\n\n&7✔ &fIt is mainly used to craft the &eAdvanced Computing Engine &fin the same machine."
		"{image:kubejs:textures/images/siliconwafer.png width:120 height:70 align:center}"
	]
	quest.6A45403A5632C1C8.quest_subtitle: "&7A precision crafted component"
	quest.6A45403A5632C1C8.title: "&5&l任务：&r&e硅晶圆"
	quest.6AD10B23D564F7BB.quest_desc: [
		"&7✔ &fThe &bPump&f is used to extract liquids found in the world, both on the surface and deep underground.\n\n&7✔ &fWith it you can collect fluids such as &9Water&f, &8Crude Oil&f and &6Turbo Fuel&f from natural sources.\n\n&7✔ &fThe pump requires &eEnergy&f to operate and can transfer the extracted liquid through &bFluid Pipes&f to tanks or machines that process fluids."
		"{image:kubejs:textures/images/pump.png width:120 height:70 align:center}"
	]
	quest.6AD10B23D564F7BB.quest_subtitle: "&7从世界中提取流体"
	quest.6AD10B23D564F7BB.title: "&5&l任务：&r&e抽水机"
	quest.6B0588DB5D4E201D.quest_desc: [
		"&7✔ &fThe &eHand Drill&f is a mining tool powered by &bEnergy&f.\n\n&7✔ &fIt can break most stone blocks with the speed of a &bDiamond Pickaxe&f.\n\n&7✔ &fLike other artifacts it is &bUnbreakable&f, so enchanting it with &eEfficiency &fand &eFortune &fis highly recommended."
		"{image:kubejs:textures/images/handdrill.png width:120 height:70 align:center}"
	]
	quest.6B0588DB5D4E201D.quest_subtitle: "&7一把无法被破坏的采矿工具"
	quest.6B0588DB5D4E201D.title: "&5&l任务：&r&e手持式电钻"
	quest.6B8855EC191224F6.quest_desc: [
		"&7✔ &fThe &eUltra Machine Core&f is designed for very advanced machines.\n\n&7✔ &fMachines built with this core can support up to &b+6 Addon Slots&f.\n\n&7✔ &fIt is crafted using &dDuratium &fand a &eDubious Container&f."
		"{image:kubejs:textures/images/core6.png width:120 height:70 align:center}"
	]
	quest.6B8855EC191224F6.quest_subtitle: "&7极其强大的机器核心"
	quest.6B8855EC191224F6.title: "&5&l任务：&r&e超巨型机器核心"
	quest.6D3F5A82BB6B7CDD.quest_desc: [
		"&7✔ &f&eBiofuel &fis produced in the &eCentrifuge &fusing &bWater &fwith &aBiomass&f.\n\n&7✔ &fThis renewable fuel can be processed in the &eCentrifuge &fto obtain &ePolymer Resin&f.\n\n&7✔ &fIt can also be refined in the &eRefinery &fto produce &6Diesel &fand &eLight Naphtha&f."
		"{image:kubejs:textures/images/biofuel.png width:120 height:70 align:center}"
	]
	quest.6D3F5A82BB6B7CDD.quest_subtitle: "&7有机物中的能量"
	quest.6D3F5A82BB6B7CDD.title: "&5&l任务：&r&e生物燃料"
	quest.6DAA84E02026713E.quest_desc: [
		"&7✔ &fThe &eEfficiency Addon&f is a machine upgrade that increases the efficiency of a machine by &620%&f.\n\n&7✔ &fWith this addon installed, the machine will consume less &bEnergy &fwhile operating.\n\n&7✔ &fIf combined with the &eSpeed Addon&f, the machine will keep the same energy consumption as default while operating at a higher speed."
		"{image:kubejs:textures/images/efficiencyaddon.png width:120 height:70 align:center}"
	]
	quest.6DAA84E02026713E.quest_subtitle: "&7提高机器效率"
	quest.6DAA84E02026713E.title: "&5&l任务：&r&e效率增强包"
	quest.6DE10ECC03F221E4.quest_desc: [
		"&7✔ &fThe &eBedrock Extractor&f is a specialized machine used to extract minerals embedded within &8Bedrock&f.\n\n&7✔ &fTo operate, it requires &bLaser Energy &ffrom the &eEnderic Laser&f.\n\n&7✔ &fYou will also need &bItem Pipes &fand a &eChest &fto transport and store the extracted resources."
		"{image:kubejs:textures/images/bedrockextractor.png width:100 height:70 align:center}"
	]
	quest.6DE10ECC03F221E4.quest_subtitle: "&7开采不可破坏层矿石"
	quest.6DE10ECC03F221E4.title: "&5&l任务：&r&e基岩提取器"
	quest.6F22CB39D40B5784.quest_desc: [
		"&7✔ &fThe &fPlastic Sheet&f is a refined polymer material used in various technological and industrial crafting recipes.\n\n&7✔ &fYou can obtain it using the &aCentrifuge&f by processing &2Raw Biopolymer&f together with &9Water&f.\n\n&7✔ &fPlastic components are commonly required in machines, pipes and other advanced technological systems."
		"{image:kubejs:textures/images/plastic.png width:120 height:70 align:center}"
	]
	quest.6F22CB39D40B5784.quest_subtitle: "&7精炼工业聚合物"
	quest.6F22CB39D40B5784.title: "&5&l任务：&r&e塑料片"
	quest.6F322416E45958E3.quest_desc: [
		"&7✔ &fThe &eElectrum Ingot&f is a special alloy used in various Oritech machines and electrical components.\n\n&7✔ &fIt can be crafted by combining &62 Gold Ingots&f with &c2 Redstone&f, creating a material capable of handling energy and advanced circuitry.\n\n&7✔ &fElectrum is often used in technological recipes that require both precious metals and electrical properties."
		"{image:kubejs:textures/images/electrum.png width:120 height:70 align:center}"
	]
	quest.6F322416E45958E3.quest_subtitle: "&7导电的黄金合金"
	quest.6F322416E45958E3.title: "&5&l任务：&r&eElectrum Ingot"
	quest.6F334F362D3F5560.quest_desc: [
		"&7✔ &f&7Mineral Slurry &fis produced in the &eCentrifuge &fusing &aSulfuric Acid&f.\n\n&7✔ &fThis mixture is mainly used in the &eCentrifuge &fwith &ePolymers &fto create &fPlastic&f.\n\n&7✔ &fIt can also be processed in the &eRefinery &fto produce &fQuartz&f."
		"{image:kubejs:textures/images/mineralslurry.png width:120 height:70 align:center}"
	]
	quest.6F334F362D3F5560.quest_subtitle: "&7一种富含矿物质的溶液"
	quest.6F334F362D3F5560.title: "&5&l任务：&r&e矿物泥浆"
	quest.71943223802118E2.quest_desc: [
		"&7✔ &f&aAssembler&f 是一种重要的机器，用于更高效地制作许多科技组件。"
		""
		"&7✔ &fWith this machine you can produce cheaper versions of items such as the &bMagnetic Coil&f, the &aMotor&f and the &2Solid Biofuel&f, which will become important later in your progression."
		""
		"&7✔ &f还可以制作专属组件，如&e基础电池&f和&d处理器单元&f，以及其他许多高级材料。"
		"{image:kubejs:textures/images/ensamblador.png width:120 height:70 align:center}"
		"{image:kubejs:textures/images/ensamblador2.png width:120 height:70 align:center}"
	]
	quest.71943223802118E2.quest_subtitle: "&7自动化与高级组件"
	quest.71943223802118E2.title: "&5&l任务：&r&e装配器"
	quest.72F3DC5B2E3EBFB5.quest_desc: [
		"&7✔ &fThe &dMachine Inventory Proxy Addon&f is an upgrade that allows you to control exactly where items enter a machine.\n\n&7✔ &fWith this addon you can specify the exact &einventory slot&f where an item will be placed when it enters the machine.\n\n&7✔ &fThis makes it extremely useful for &aautomation&f, allowing complex processing systems to run smoothly without items going to the wrong slot."
		"{image:kubejs:textures/images/inventoryproxyaddon.png width:120 height:70 align:center}"
	]
	quest.72F3DC5B2E3EBFB5.quest_subtitle: "&7控制机器物品输入项"
	quest.72F3DC5B2E3EBFB5.title: "&5&l任务：&r&e物品栏代理插件"
	quest.75589F25B795EED5.quest_desc: [
		"&7✔ &fThe &eStabilized Enchanter&f is an advanced enchanting machine that requires &eArcane Catalysts &fnearby to function.\n\n&7✔ &fUnlike the catalyst, this machine does not require enchanted books, you only need to select the enchantment from the list.\n\n&7✔ &fThe higher the enchantment level, the more &eArcane Catalysts &fare required around the machine."
		"{image:kubejs:textures/images/stabilizedenchanter.png width:120 height:70 align:center}"
	]
	quest.75589F25B795EED5.quest_subtitle: "&7直接且稳定的附魔效果"
	quest.75589F25B795EED5.title: "&5&l任务：&r&e稳定的附魔者"
	quest.7566E062F9C24858.quest_desc: [
		"&7✔ &fThe &eLarge Energy Storage&f is an upgraded version of the &ePortable Energy Storage&f.\n\n&7✔ &fIt can store &610 times &fthe amount of energy and also has a much higher energy transfer rate.\n\n&7✔ &fThis makes it ideal for larger power systems and for supplying energy to multiple machines at once."
		"{image:kubejs:textures/images/largestorage.png width:120 height:70 align:center}"
	]
	quest.7566E062F9C24858.quest_subtitle: "&7更大的电力容量"
	quest.7566E062F9C24858.title: "&5&l任务：&r&e大型储能装置"
	quest.75B610768D6727FD.quest_desc: [
		"&7✔ &f&bSilicon Wash &fis produced in the &eCentrifuge &fusing &eLight Naphtha&f.\n\n&7✔ &fIt can be used in the &eCentrifuge &fwith &eCarbon Fiber Threads &fto create &eSilicon Wafer&f.\n\n&7✔ &fIt can also be processed in the &eRefinery &fwith &eSand &fto produce &eSilicon&f."
		"{image:kubejs:textures/images/siliconwash.png width:120 height:70 align:center}"
	]
	quest.75B610768D6727FD.quest_subtitle: "&7提纯硅溶液"
	quest.75B610768D6727FD.title: "&5&l任务：&r&e硅晶圆清洗"
	quest.76076B9C506D054E.quest_desc: [
		"&7✔ &f&5Strange Matter &fis obtained in the &eRefinery &fby processing &6Lava &fwith an &eEnderic Component&f.\n\n&7✔ &fThis mysterious material possesses unusual and unstable properties.\n\n&7✔ &fIt can be used in the &eCentrifuge &ftogether with a &eDubious Container &fto generate &dUnholy Intelligence&f."
		"{image:kubejs:textures/images/strangematter.png width:120 height:70 align:center}"
	]
	quest.76076B9C506D054E.quest_subtitle: "&7一种不稳定的奇异物质"
	quest.76076B9C506D054E.title: "&5&l任务：&r&e奇怪的物质"
	quest.76115E0CF5B858AF.quest_desc: [
		"&7✔ &fThe &aPipe Booster&f is a small machine designed to increase the speed of items or fluids moving through pipes.\n\n&7✔ &fWhen connected to your pipe networks, it boosts the extraction and transfer rate of resources passing through it.\n\n&7✔ &fThis makes it very useful for larger automation systems where faster transport is required to keep machines running efficiently."
		"{image:kubejs:textures/images/pipebooster.png width:120 height:70 align:center}"
	]
	quest.76115E0CF5B858AF.quest_subtitle: "&7加速你的运输系统"
	quest.76115E0CF5B858AF.title: "&5&l任务：&r&e管道助推器"
	quest.7644428EDDD68873.quest_desc: [
		"&7✔ &fThe &eCapacitor Addon&f is a machine upgrade designed to improve energy management.\n\n&7✔ &fWhen installed in a machine, it increases the &bstored energy capacity &fand also boosts the &benergy transfer rate&f.\n\n&7✔ &fThis allows machines to operate more efficiently by holding more power and receiving energy faster from connected generators or storage."
		"{image:kubejs:textures/images/capacitor.png width:120 height:70 align:center}"
	]
	quest.7644428EDDD68873.quest_subtitle: "&7提升你的机器能量"
	quest.7644428EDDD68873.title: "&5&l任务：&r&e电容器附加组件"
	quest.77239E13385A018A.quest_desc: [
		"&7✔ &f&dFluxite&f is a powerful resource mainly obtained by using the &5Enderic Laser&f on &dAmethyst Clusters&f, accelerating their growth and converting them into this valuable material.\n\n&7✔ &fFluxite is an essential component used to craft various machines, materials and specialized fluids within Oritech.\n\n&7✔ &fAlthough there are other ways to obtain &dFluxite&f, they usually require longer processing chains and can be more time-consuming compared to harvesting it with the laser."
		"{image:kubejs:textures/images/fluxite.png width:120 height:70 align:center}"
	]
	quest.77239E13385A018A.quest_subtitle: "&7一块神秘的能量水晶"
	quest.77239E13385A018A.title: "&5&l任务：&r&eFluxite"
	quest.77F299017730F17F.quest_desc: [
		"&7✔ &f&2Raw Biopolymer&f is an organic material used in several industrial and fuel-related crafting processes.\n\n&7✔ &fYou can obtain it using the &aCentrifuge&f by filling it with &9Water&f and processing &6Packed Wheat&f.\n\n&7✔ &fThis material is an important step in the production of more advanced bio-based resources."
		"{image:kubejs:textures/images/rawbiopolymer.png width:120 height:70 align:center}"
	]
	quest.77F299017730F17F.quest_subtitle: "&7用于工业的有机材料"
	quest.77F299017730F17F.title: "&5&l任务：&r&e原始生物聚合物"
	quest.77F63B1BAD4ED46F.quest_desc: [
		"&7✔ &fThe &ePrometheum Battleaxe&f is a powerful weapon with extremely high &bDamage&f, &bSpeed &fand increased &bReach&f.\n\n&7✔ &fIt can also cut down entire trees when sneaking.\n\n&7✔ &fTo craft it you will need &ePrometheum Ingots &fand the &eDestroyer Block&f machine."
		"{image:kubejs:textures/images/prometheumbattleaxe.png width:120 height:70 align:center}"
	]
	quest.77F63B1BAD4ED46F.quest_subtitle: "&7一种毁灭性的武器"
	quest.77F63B1BAD4ED46F.title: "&5&l任务：&r&e普罗米修斯战斧"
	quest.7A2A86542FB96A57.quest_desc: [
		"&7✔ &fThe &eTarget Designator&f is a tool used to control the &eEnderic Laser&f and set its target direction.\n\n&7✔ &fIt can also be used to designate which &eDrone Port &fwill receive the resources being transported.\n\n&7✔ &fThis makes it an important tool for configuring laser operations and long distance transport systems."
		"{image:kubejs:textures/images/targetdesignator.png width:120 height:70 align:center}"
	]
	quest.7A2A86542FB96A57.quest_subtitle: "&7控制和指定目标对象"
	quest.7A2A86542FB96A57.title: "&5&l任务：&r&e目标指定器"
	quest.7AE801646DE8AD7B.quest_desc: [
		"&7✔ &f&8Carbon Fiber Thread&f is a lightweight but durable material used in advanced industrial crafting.\n\n&7✔ &fIt can be produced using the &aCentrifuge&f by processing &8Carbon Dust&f.\n\n&7✔ &fThis process does not require any liquid, making it a simple but important step in producing carbon-based materials."
		"{image:kubejs:textures/images/fibrecarbon.png width:120 height:70 align:center}"
	]
	quest.7AE801646DE8AD7B.quest_subtitle: "&7轻质工业纤维"
	quest.7AE801646DE8AD7B.title: "&5&l任务：&r&e碳纤维线"
	quest.7B5A5516583CD2E5.quest_desc: [
		"&7✔ &fThe &5Enderic Laser&f is a powerful machine capable of transmitting &eEnergy&f to certain machines from a distance.\n\n&7✔ &fIt can also be used to mine blocks in a straight line toward a target direction, reaching up to &e128 blocks&f or as far as loaded chunks allow.\n\n&7✔ &fWhen aimed at &dAmethyst Clusters&f, the laser can accelerate their growth and harvest them, converting them into &aFluxite&f.\n\n&7✔ &fAny blocks mined or resources collected by the laser will be stored directly in the machine's inventory."
		"{image:kubejs:textures/images/endericlaser.png width:120 height:70 align:center}"
	]
	quest.7B5A5516583CD2E5.quest_subtitle: "&7精准采矿与能量投影"
	quest.7B5A5516583CD2E5.title: "&5&l任务：&r&e末地激光"
	quest.7E6CA91CCF4D4AFE.quest_desc: [
		"&7✔ &fThe &eDrone Port&f is a machine used to transport &bItems &for &bFluids &fbetween ports.\n\n&7✔ &fIt requires at least &650 blocks &fof distance between ports to work, so a minimum of &e2 Drone Ports &fis required to create a route.\n\n&7✔ &fTo transport fluids, the machine requires the &eFluid Handling Addon&f installed."
		"{image:kubejs:textures/images/droneport.png width:120 height:70 align:center}"
	]
	quest.7E6CA91CCF4D4AFE.quest_subtitle: "&7长途运输工具"
	quest.7E6CA91CCF4D4AFE.title: "&5&l任务：&r&e无人机港口"
	quest.7F3EA5B3DD048C6F.quest_desc: [
		"&7✔ &f&e流体插件&f是一种机器升级，能让机器处理&b流体&f。\\n\\n&7✔ &f安装后，机器将能接收和处理液态资源。\\n\\n&7✔ &f此插件对像&e离心机&f这类需要流体输入的机器尤其有用。"
		"{image:kubejs:textures/images/fluidaddon.png width:120 height:70 align:center}"
	]
	quest.7F3EA5B3DD048C6F.quest_subtitle: "&7处理液体资源"
	quest.7F3EA5B3DD048C6F.title: "&5&l任务：&r&e流体附加包"
}
