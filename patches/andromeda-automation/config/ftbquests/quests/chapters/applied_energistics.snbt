	quests: [
		{
			x: 0.0d
			y: 2.5d
			description: ["这是一个非常复杂的工具，能让你改变世界里的东西！比如把草变成沙子，或者把鹅卵石熔成石头！你可以切换大小来改变作用范围。此外，它还能改变生物，默认按 'R' 键发射一个能将生物变成类似生物（如被动变被动，或敌对变敌对！）的投射物！但注意，它会消耗燃料，比如煤炭或红石！"]
			dependencies: ["06C59ACF3FE5EDA7"]
			hide: true
			id: "0FB7E95067B8425F"
			tasks: [{
				id: "66CC6F9FFF13329C"
