	quests: [
		{
			dependencies: ["2B262DE8BCC8434C"]
			description: [
				"模组的最开端。"
				""
				"允许你将法术卷轴绑定到法术书上，这样在法力耗尽前可以无限使用它们。"
				""
				"法术也可以从法术书中取出来。"
				""
				"将咒语书放入奇物栏后，可按 &4R 打开咒语轮盘&f，按 &bV 施放所选咒语&f，或按住 &6左 Alt 并滚动鼠标滚轮 &f来更换所选咒语。"
			]
			icon: "irons_spellbooks:inscription_table"
			id: "43AD929EBB8A1128"
			tasks: [
				{
					id: "06B72471384E9638"
					item: "irons_spellbooks:inscription_table"
					type: "item"
				}
				{
					id: "2BE63BA7C6F91568"
					title: "确认你已阅读此内容并予以认可"
					type: "checkmark"
				}
			]
			x: 9.0d
			y: 0.5d
		}
		{
			dependencies: [
				"2B262DE8BCC8434C"
				"43AD929EBB8A1128"
			]
			description: [
				"用于制作各种等级的法术。"
				"稀有度受所用墨水瓶等级的影响。"
				""
				"此后的任务需要最高等级的法术变体 &4&l&oNEED THE MAX LEVEL VARIANT &r。"
			]
			icon: "irons_spellbooks:scroll_forge"
			id: "58789041B208B9DE"
			tasks: [
				{
