			y: 0.5d
		}
		{
			dependencies: ["2B262DE8BCC8434C"]
			description: [
				"用于熔炼不需要的卷轴。"
				"用水填满它，然后加入卷轴。"
				"当水变色时，用空瓶子使用它，你就能得到可用于卷轴制作的额外墨水。"
				""
				"也可用于将低阶墨水合成更高质量的墨水。"
			]
