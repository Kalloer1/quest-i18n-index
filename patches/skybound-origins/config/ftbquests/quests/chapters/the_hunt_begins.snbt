	order_index: 0
	quest_links: [ ]
	quests: [
		{
			description: [
				"很久以前洗脑了村民的虚假教派的领袖。"
				""
				"注意，他非常强大！"
				""
				"他的祭坛在丛林群系附近！"
			]
			icon: "netherexp:soul_skeleton_skull_candle"
			id: "433E273CF8810926"
			size: 1.0d
			subtitle: "Latom"
			tasks: [
				{
					entity: "companions:sacred_pontiff"
					icon: "terramity:sacred_speed_bracelets"
					id: "109FB2479D23DE15"
					title: "击败神圣教皇 The Sacred Pontiff"
					type: "kill"
					value: 1L
				}
				{
					id: "4FFB48E1DF6375AD"
					structure: "companions:companions_monkey_temple"
					type: "structure"
				}
			]
			x: -13.5d
			y: 12.0d
		}
		{
			description: [
				"即使在同类中也被畏惧的&l弗里克格&r，是掠夺者血统中扭曲的分支，一个以残酷为乐的家伙。因未经授权的暴行被逐出掠夺者行列，他带着来自《下界束缚折磨法典》的禁忌知识归来。"
				""
				"弗雷基格现在劫持村庄袭击，将其变为混乱的血腥屠杀。他通过&0&0&l黑暗火焰&r&r&r大笑，指挥发狂的野兽，并使用旨在带来痛苦而非死亡的灵魂锻造武器。"
				""
				"{@pagebreak}"
				"偶尔在突袭中生成。"
			]
			id: "06FBD7BBCB92161F"
			rewards: [{
				id: "01CC9739772D58A5"
				type: "xp_levels"
				xp_levels: 10
			}]
			size: 1.0d
			subtitle: "恐怖之主"
			tasks: [{
				entity: "illageandspillage:freakager"
				icon: {
					Count: 1
					id: "fantasy_armor:golden_execution_helmet"
					tag: {
						Damage: 0
					}
				}
				id: "24CD5979DFAF5E81"
				type: "kill"
				value: 1L
			}]
			title: "击败怪物 Freak"
			x: -8.0d
			y: 10.0d
		}
		{
			description: [
				"当Freakeger带来折磨，传教士便带来教义。他是Ignis福音之声，一位坚信火焰非毁灭，而是通过燃烧带来救赎的舌灿莲花者。"
				""
				"传教士会在最后一波&4袭击&r中出现，尤其是在梅萨、沙漠或稀树草原村庄，总是伴有刻着熔岩符文的狂热掠夺者。他的存在会扭曲土地：作物枯萎，钟声无故敲响，村民陷入恍惚。"
				""
				"{@pagebreak}"
				"偶尔在突袭中生成。"
			]
			id: "2F5D233CDB959511"
			rewards: [
				{
					id: "02B650E93265C2CC"
					type: "xp_levels"
					xp_levels: 3
				}
				{
					id: "3856F6E5C205C4AE"
					item: {
						Count: 1
						id: "simplyswords:toxic_longsword"
						tag: {
							Damage: 0
						}
					}
					type: "item"
				}
			]
			size: 1.0d
			subtitle: "一个奇怪的男人"
			tasks: [{
				entity: "born_in_chaos_v1:missioner"
				icon: {
					Count: 1
					id: "born_in_chaos_v1:missionary_hat_helmet"
					tag: {
						Damage: 0
					}
				}
				id: "06C80C8FB5704FCE"
				type: "kill"
				value: 1L
			}]
			title: "击败传教士 Missionary"
			x: -11.5d
			y: 10.0d
		}
		{
			description: [
				"在火焰与灾难之前，他仅被称为阿尔维，一位备受尊崇的长者、学者，以及村庄深处神圣火焰祭坛的守护者。他寻求元素魔法与凡人生命之间的和谐。"
				""
				"但当伊格尼斯的低语传到主世界时，最先倾听的却是阿尔维。被永恒的力量与重生的承诺所吸引，他自愿开启了第一扇余烬之门……并随之湮灭。"
				""
				"如今重生为&e&l召唤者&r&r，他成为火焰与疯狂的媒介，投下重塑大地的熔岩符文，并召唤出被他背叛的村民的火焰回响。"
				""
				"{@pagebreak}"
