	quest.371400B53BDAF461.quest_subtitle: "Applin -> Appletun"
	quest.37185708AFCB4964.title: "神奥地区的岩石类型"
	quest.3724A409E62C8AC0.quest_desc: ["这副炫酷的眼镜会&5提升宝可梦的特攻，&r但只能使用&6一个招式。&r这在战斗中释放高伤害的特攻招式时会很有用。"]
	quest.372955E458EB53EA.quest_desc: [
		"&eAuspicious Armor&r 是一种进化道具，用于将 &dCharcadet&r 进化为 &dArmarouge&r。手持 Auspicious Armor 右键点击 Charcadet 即可消耗该盔甲，使其进化为 Armarouge。它是 &6Malicious Armor&r 的对应道具。"
		""
		"5% 来自 armarouge 的掉落物"
		""
		"&d堡垒遗迹&r的宝箱可能含有 Auspicious Armor。"
	]
	quest.372955E458EB53EA.quest_subtitle: "Charcadet -> Armarouge"
	quest.3736A76E201484E0.title: "Unova 毒系宝可梦"
	quest.373946C079C2C161.quest_desc: ["蓝图可在蓝图炮或部署器中使用。使用前，需右键单击选择蓝图坐标，并通过屏幕上的控件调整位置。按住 Shift 键右键单击可打开输入精确坐标的界面。"]
	quest.373946C079C2C161.quest_subtitle: "用于存储设计图"
	quest.3743811366CC7850.quest_desc: ["这把曾经完美的勺子能提升持有者的&d超能力系招式威力。&r"]
	quest.374D5C6ED00BDBCF.quest_desc: ["地牢宝箱位于后墙内，装有最顶级的Aether宝藏，如吸血鬼之刃、凤凰铠甲、生命碎片、猪杀手、铁质泡泡、传说之书第三卷、引力铠甲、云朵法杖和太阳祭坛。"]
	quest.374D5C6ED00BDBCF.quest_subtitle: "用于解锁战利品！"
	quest.37785651B5163FAE.quest_subtitle: "用于合成“5”"
	quest.37903AB013169316.title: "帕迪亚钢系宝可梦"
	quest.37B514480E3C4F42.quest_desc: [
		"&6Immersive Aircraft&r 添加了大量质朴的飞行器，供你旅行、运输和探索！"
		""
		"这些飞行器高度还原原版，细节和功能丰富，但不过于复杂。"
	]
	quest.37B514480E3C4F42.quest_subtitle: "升级和调整你的飞行器，让它符合你的喜好！"
	quest.37B514480E3C4F42.title: "振翅高飞"
	quest.37B85552391A5268.title: "x64 杏核"
	quest.37BB08E352A51BCA.quest_subtitle: "熔炼宝石或独特武器以获得物品"
	quest.37BE571B6CD98AF5.quest_desc: [
		"&d对宝可梦的效果：&r若持有者中毒，则被治愈。"
		""
		"&d诱饵效果：&r使水域和水虫群宝可梦的遭遇率提高10倍"
	]
	quest.37C60E878FDBA507.quest_desc: ["定期地使附近的动物繁殖（如果可能）。此仪式需要源才能运作，如果附近有二十只或更多动物，则无效。"]
	quest.37DE01BA4E2F0BC6.quest_subtitle: "可以在平原中找到"
	quest.3808B72C1784E21C.title: "城都幽灵系宝可梦"
	quest.38136FFBDD1D6C1A.quest_subtitle: "可以在森林里找到它"
	quest.383B8E2F83EEA085.quest_desc: [
		"&d对宝可梦的效果：&r降低宝可梦的特攻努力值10点，同时提升亲密度。"
		""
		"&d诱饵效果：&r吸引特防努力值高的宝可梦"
	]
	quest.384607D98369DAD1.quest_desc: [
		"&6炉灶是一个实用方块，功能类似带6个格子的篝火。&r"
		""
		"&e炉子不需要燃料！&r"
		""
		"你可以用打火石和钢来点燃炉子，或者用水桶或铲子来熄灭它。"
		""
		"继续阅读关于炉灶烹饪的内容 \& 它与普通熔炉的优缺点！"
		""
		"{@pagebreak}"
		""
		"食物烹饪需要30秒（600ticks），而熔炉是10秒，烟熏炉是5秒。假设同时使用全部六个烹饪槽，炉灶的效率高于熔炉（每四个物品快10秒且无需燃料），但烹饪完成后需要手动取出食物并重新填充。它比烟熏炉慢约十秒，但不消耗燃料这一点或许值得权衡。"
		""
		""
		"烹饪完成后，物品会从炉灶上弹出。烹饪过程中炉灶熄灭，烹饪将重置为未开始。食物可以放在未点燃的炉灶上。"
	]
	quest.384607D98369DAD1.quest_subtitle: "一次最多烹饪6种食物！"
	quest.384A99EC058C63ED.title: "阿罗拉地区的龙属性宝可梦"
	quest.385DCF0C7BEB5366.title: "精灵球制作配方"
	quest.386F34C40A1CA50B.quest_subtitle: "可用于制作全套工具和盔甲！"
	quest.3874039A61B0F00B.quest_desc: [
		"&d对宝可梦的效果：&r持有者当HP低于或等于最大值的1/4时，会在其优先级内优先行动。"
		""
		"&d诱饵效果：&r缩短25%的咬合时间，提高钓获物品的几率"
	]
	quest.388A5009A6D29F47.quest_subtitle: "获得所有类型的毒药。"
	quest.388DFF1E8BBC8E10.quest_subtitle: "捕捉与你已出战的宝可梦性别相反的宝可梦时更有效。"
	quest.388DFF1E8BBC8E10.title: "爱心球"
	quest.38935DE214417E79.quest_desc: [
		"这种钥匙可以打开一个通往虚空世界的特殊传送门，那里有一个8x8区块（128格方块）的岛屿，你可以自由建造任何喜欢的东西。这个维度与地牢维度是分开的，所以方块保护规则不适用。此外，虚空是安全的。试着跳进去玩玩吧！但不要将物品或其他实体扔下悬崖。那些东西不会被归还。"
		""
		"默认情况下，你的传送门只允许你进入。其他试图跟随你进入个人维度的玩家会收到一条被阻止的消息。不过，你可以为特定玩家配置白名单或黑名单，以允许或禁止他们进入。"
		""
		"{@pagebreak}"
		"在个人维度内，右键点击出口传送门并放置特定物品，即可配置安全系统。"
		""
		"&e纸&r - 用铁砧将玩家的名字写在纸上，再将其用于传送门，即可将该玩家添加到你的访客列表中。"
		"&e白色染料&r - 将访客列表切换为朋友列表，这样只有那些玩家名字才能被允许进入。（这是默认模式。）"
		"&e黑色染料&r - 将你的访客列表转换为黑名单，服务器中除名单上的玩家外，所有人都可以进入。"
		"&e磨石&r - 将你的安全系统重置为默认设置。（即空白的好友列表，只有你能进入。）"
		"&e书籍&r - 显示您当前安全系统的配置信息。"
		""
		"&c打开宝箱和破坏方块没有单独的权限。所以要小心你让谁进来！&r"
	]
	quest.38935DE214417E79.quest_subtitle: "去你自己的虚空维度吧！"
	quest.38D4520EAE00F888.title: "神奥地区的冰系宝可梦"
	quest.38FC2E34077895F5.quest_desc: ["Ignitium 锭可用于制作 The Incinerator 和 Bulwark of Flame（均由 Ignis 使用），以及 Cataclysmic Gate Pearl。它们也可以在锻造台与下界合金盔甲结合，制成 Ignitium 盔甲。"]
	quest.3905B02D985617B9.title: "地牢维度专家"
	quest.39125D68A4AA32A5.quest_desc: ["这块石头将&4sun moves的持续时间从5回合延长到8回合&r！如果你更喜欢&4fiesty Fire Types&r，这非常有用！"]
	quest.3913AD31BACFC2C1.quest_subtitle: "可以在稀树草原中找到"
	quest.392958B671649821.quest_subtitle: "交易次数：1"
	quest.392958B671649821.title: "书架"
	quest.3947C1EBE3AE9117.quest_subtitle: "通过合成或在Aether中作为战利品获得"
	quest.3958490D2728609E.quest_desc: [
		"&d女武神女王是白银地牢的Boss。&r它有500点生命值，并且会飞行。"
		""
		"被杀死后，它会掉落一把&e银色钥匙&r、4点经验值和1把金剑"
	]
	quest.3958490D2728609E.quest_subtitle: "获得10枚胜利奖章后的挑战"
	quest.395A0E0FDB9D07A8.quest_desc: [
		"基格尔德是一种传说宝可梦，据说会等待英雄用真理或理想填满它的身体。使用DNA重组器时，基格尔德可以通过名为“融合”的过程吸收雷希拉姆或捷克罗姆，从而融合成&n白基格尔德&r或&n黑基格尔德&r。"
		""
		"&n如何融合&r"
		"要创造黑或白酋雷姆，必须使用捷克罗姆或雷希拉姆作为融合基础，并使用 &6DNA Splicers&r。首先，右键点击相应的宝可梦，用所需物品吸收并为其充能。然后，右键点击酋雷姆，使用已充能的物品以触发变身。"
		""
		"融合后的宝可梦将继承基格尔德的个体值、努力值、闪光属性和等级。"
	]
	quest.395A0E0FDB9D07A8.title: "基格尔德 究极融合形态"
	quest.398441CD29E3A14B.quest_desc: ["&6考古学工作台&r可用于使用任意类型的刷子分析&e未鉴定遗物&r。它可以用4个木板、1个刷子和遗物碎片制作。它会产出3种已鉴定遗物中的一种，每种都有各自特殊的能力。"]
	quest.398441CD29E3A14B.quest_subtitle: "鉴定远古残骸"
	quest.3985EC71D961473A.quest_desc: ["此仪式可瞬间改变天气。默认情况下，仪式会使天气转为晴朗。加入火药会下雨，加入青金石块则会引发暴风雨。"]
	quest.3989E5F2051ED738.quest_desc: [
		"货币箱是一种专门用于存放钱币的特殊箱子。它本身没有特殊功能，和大多数箱子一样，可以通过漏斗和其他模组化的物品运输方式向其添加或移除物品。"
		""
		"它可以被升级！"
	]
	quest.39961974BA39BCD2.quest_subtitle: "在丛林中生成"
	quest.39961974BA39BCD2.title: "咖啡樱桃"
	quest.39A38E965BB55614.quest_desc: ["这些笨重的护垫&6能保护佩戴者免受接触类招式的影响。&r"]
	quest.39FD94DD136797F4.title: "龙之牙 (Dragon Fang)"
	quest.39FE63B9E30BE9AE.title: "Unova 岩石类型"
	quest.3A0CE0FB76BC44F9.quest_desc: ["击败它们会奖励虚空核心，可用于召唤能造成伤害的虚空符文，帮助对抗末地守卫。"]
	quest.3A0CE0FB76BC44F9.quest_subtitle: "这些生物有150点生命值和12点护甲。"
	quest.3A25B3BC77AB54AE.quest_desc: [
		"要制作外壳，先&e放置去皮的原木&r，然后&o用你选中的外壳右键单击&r！"
		""
		"外壳是《创造》中许多合成配方、装饰和美化用途所使用的方块。"
		""
		"&6外壳有四种类型：&r"
		""
		"- &d安山岩外壳&r主要用于基础装置中，"
		"- &d黄铜弹壳&r用于更先进的机器中，"
		"- &d铜制外壳&r严格用于流体，"
		"- &dTrain Casings&r 用于机车运输。"
		""
		"{@pagebreak}"
		"外壳只能通过将&6有效合金或锭&r物理地应用到任何&6去皮的原木或木材&r上来制作。原木会转化为&d外壳&r，玩家可以用喜欢的工具挖掘，或使用扳手将其放入背包中。"
	]
	quest.3A25B3BC77AB54AE.quest_subtitle: "用于各种机器中"
	quest.3A25B3BC77AB54AE.title: "外壳组件"
	quest.3A4882B06BBDF337.quest_desc: ["These very fashionable boots&5 prevent your Pokemon from being hurt by an opponents trap moves&r that are active on the field. These make a&5 great defense against opponents&r who prefer &6setting up switch-trap style moves&r."]
	quest.3A67E5AF7FB66154.quest_subtitle: "使用强化回响碎片制作而成"
	quest.3A772F451611C6F5.title: "下界地牢大师"
	quest.3A89F945D889E1C3.quest_desc: [
		"&d太阳之灵是黄金地牢的Boss。&r它有50点生命值，能发射火立方和冰立方。每次受到伤害时，都会生成一个迷你太阳之灵。移动时会留下火焰。"
		""
		"被杀死后，它会掉落一把&e金钥匙&r、4点经验值和1个太阳祭坛"
	]
	quest.3AA0A99F5F9B05CF.quest_subtitle: "多个等级可供选择"
	quest.3AA0A99F5F9B05CF.title: "网络商人"
	quest.3AA6B39F2D9AD982.quest_desc: [
		"用于查看下一个要挑战的对手信息，以及各道馆馆长的生物群系和等级上限等关键信息。"
		""
		"在此阅读更多内容："
		""
		"{ \"text\": \"Champions League\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"7676E887F513A1BE\" } }"
	]
	quest.3AAFCC93CF3F84DF.quest_desc: ["贸易升级会提高指定交易者的贸易提议数量。此功能不适用于本身具有灵活贸易提议数量的交易者（如 Paygate 和 LC Techs 能源交易者），或严格限制为单次交易的交易者（如老虎机）。"]
	quest.3AB02A2C287089CD.quest_desc: ["用史莱姆球和线合成！"]
	quest.3AB02A2C287089CD.quest_subtitle: "用于制作各种处理器（Processor）的原材料"
	quest.3AB6A50D62B3843B.quest_subtitle: "可以在稀树草原中找到"
	quest.3AC234AB2A9B559E.quest_desc: ["泥炭覆盖物能让浆果树无限期地像在森林群系中一样生长。"]
	quest.3AF4D1F86398EC1B.quest_desc: ["速度升级会减少交易界面交互的延迟。升级的下界合金版本会完全消除延迟，使交易界面与交易者每刻都进行交互。"]
	quest.3B0828246D60F84F.quest_desc: [
		"原始固拉多（Primal Groudon）是传说宝可梦固拉多的原始形态。只有当固拉多携带红色宝珠（Red Orb）时才能获得，这能提升其属性和能力，类似于超级进化。"
		""
		"对它使用&6红色球体&r"
		"使用相同物品可逆转换"
		"{image:mega_showdown:item/redorb width:25 height:25 align:center}"
	]
	quest.3B0828246D60F84F.quest_subtitle: "点击以查看要求"
	quest.3B0828246D60F84F.title: "原始固拉多"
	quest.3B11DBF0C5BFA75C.quest_desc: [
		"Necrozma 可以通过使用特定的融合道具与 Solgaleo 或 Lunala 融合来实现不同形态。"
		""
		"&n如何融合&r"
		"要创造融合形态的 Necrozma，你必须使用 Solgaleo 或 Lunala 作为融合基底，并搭配特定道具。首先，用所需道具右键点击相应的宝可梦以吸收并充能该道具。然后，用充能后的道具右键点击 Necrozma 以触发变身。"
		""
		"融合后的宝可梦将继承 Necrozma 的个体值、努力值、闪光属性和等级。"
		""
		"&n变形&r"
		"&eDusk Mane&r - 要获得 Dusk Mane Necrozma，请使用 Solgaleo 和 &6N-Solarizer&r。"
	]
	quest.3B11DBF0C5BFA75C.title: "Necrozma 的形态 - Solgaleo"
	quest.3B141DCF8A478551.quest_subtitle: "当由吉拉蒂娜持有时会变为起源形态。"
	quest.3B141DCF8A478551.title: "起源形态 - 吉拉蒂娜"
	quest.3B1D7B4C9C49108E.quest_desc: [
		"静止状态下，可将某些物品应用到方块过滤器上。若有过滤器，则只会影响该装置实体。若在组装前后及组装期间用红石信号供电，装置实体将处于禁用状态。注意，装置上组装的红石和杠杆无效。"
		""
		"在已组装的装置上，右键点击装置控制器可以启用或禁用特定的装置执行器。"
		""
		"- 部署器"
		"便携式存储接口 (Portable Storage Interface)"
		"- 红石接触器"
		"- 漏斗"
		"- 铃铛"
		"- 门"
		"- 篝火"
		"- 物品发射器"
		"- 投掷器"
		"- 便携式流体接口 (Portable Fluid Interface)"
		"- 机械钻头、锯子、收割机、犁、压路机"
	]
	quest.3B1D7B4C9C49108E.quest_subtitle: "用于控制机械装置演员的旧方法。"
