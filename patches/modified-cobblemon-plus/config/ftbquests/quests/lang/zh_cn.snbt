	quest.760F161360950653.quest_subtitle: "可以在稀树草原中找到"
	quest.7621FF18FE62B7CE.title: "玫瑰色球体"
	quest.76262AD9AE375A9C.quest_desc: ["这块岩石会将&e沙尘暴的回合数从5增加到8&r！非常有用，可以在你的&e地面系宝可梦不受伤害的同时，削减对手的HP&r！"]
	quest.763C22D897322C56.title: "深暗探索者"
