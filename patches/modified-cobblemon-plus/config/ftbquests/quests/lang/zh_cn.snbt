	quest.7699B5B5D2E0E9AD.quest_subtitle: "+ 特防 / - 特攻"
	quest.76C64ED6EEA5BACC.quest_subtitle: "右键点击烈焰人即可捕捉它！"
	quest.76CBBB30A7203C68.title: "1x &6PokeDollar"
	quest.76D7F0FEBB08B9E2.title: "阿罗拉地区的火属性宝可梦"
	quest.76F08779650BBD85.quest_desc: ["手持剑而非盾牌的燃烬亡者变种。在击败 Ignis 后于下界堡垒中生成。死亡时会掉落 &eDying Embers&r。"]
	quest.7708F779790BEE9A.quest_desc: [
		"Encased Chain Drive 是一种可以传递旋转的方块，与 Mechanical Belt 类似。"
		""
		"封闭式链传动可以垂直或水平并列放置，形成一条在所有方块间传递旋转动力的链条。 &e方块必须侧边相触&r（而非轴向与侧边），并且&e处于同一条直线上才能形成链条&r。"
		""
		"封闭式链传动装置的轴可以全部平行，也可以通过旋转方块使轴垂直。封闭式链传动装置还可以通过旋转轴传递动力，但这并非同一链条的延续。"
		""
		"封闭式链传动也可以&6连接到可调式链齿轮箱，&r可以根据红石信号强度改变速度。"
	]
	quest.7708F779790BEE9A.quest_subtitle: "多种外壳选项可供选择！"
	quest.770B0DD8F5DC0F18.quest_desc: [
		"&d对宝可梦的效果：&r将一次效果拔群的草系技能的伤害减半。"
		""
		"&d诱饵效果：&r使草系宝可梦的遭遇率提高10倍"
	]
	quest.7719EEC5689BE506.quest_desc: [
		"驼鸟是一种常见的被动生物，也是羽毛的来源。它们孵化自蛋，装备上鞍子后就可以骑乘。"
		""
		"在生成世界时，光亮度高于8的虚空草方块上方会生成1-3只毛象。"
		""
		"毛象有 57.14% 的几率是蓝色，28.57% 的几率是白色，以及 14.29% 的几率是黑色。"
		""
		"成年恐鸟每五到十分钟会产一枚各自颜色的蛋"
	]
	quest.7719EEC5689BE506.quest_subtitle: "获得一个Moa蛋"
	quest.7721559EB2D03B52.quest_subtitle: "我们需要万圣节前夕的糖果！"
	quest.7722D8A6E773A794.quest_desc: ["铜与钢铸就的巨兽，专为征服天空而生！四座、可移动炮塔、6个武器挂载点，体型远超Minecraft物理引擎的想象。"]
	quest.7722D8A6E773A794.quest_subtitle: "四个座位，可移动的炮塔，"
	quest.773DD3685CEC3C45.quest_desc: [
		"&n&o双重战斗！&r"
