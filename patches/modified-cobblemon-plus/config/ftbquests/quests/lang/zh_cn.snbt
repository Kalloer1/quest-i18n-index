	]
	quest.50A27C2F51A711E2.quest_subtitle: "上限未提升，但徽章已击败！"
	quest.50AF2CF07570EC22.quest_subtitle: "生成时有同等概率出现镀金宝箱或吉米古尔宝箱"
	quest.50B86BAE30501DC2.quest_subtitle: "武术大师，格斗系对普通、冰、岩石、恶和钢系效果显著。它们体现了力量和不屈不挠的精神。"
	quest.50B86BAE30501DC2.title: "战斗类型"
	quest.50BE4174F8985E2E.quest_subtitle: "可以在森林里找到它"
	quest.50D424BF12587F27.quest_desc: [
		"手持弩的更强型德拉格，掉落物与普通德拉格相同。"
		""
		"所有这些生物都掉落相同的物品：骨头、腐肉、黑钢锭和黑钢块。黑钢是一种新材料，用于制作黑钢靶盾、诅咒锻造模板、部分黑钢工具、诅咒弓、灵魂渲染器和湮灭者。"
	]
	quest.50E0CC87812998D0.quest_subtitle: "获得所有已种植的 Croptopia 作物"
	quest.50FB742C7C4F5818.quest_desc: [
		"将物品口放置在物品仓库或滑道等存储方块的一侧。右键点击物品口，用物品或物品堆叠将其存入存储方块中。"
		""
		"空手右键物品口，会将除工具栏、护甲栏和副手外的所有物品存入存储方块。若存储方块容量不足，则存入找到的第一个物品的最大数量。"
	]
	quest.50FB742C7C4F5818.quest_subtitle: "用于将玩家的物品栏存入存储设施。"
	quest.510F834E9E0236DB.quest_desc: ["在村庄内使用时会召唤掠夺者袭击。可以使用绿宝石将袭击难度提升至最高，从而在较低难度下也能获得“不死图腾”。在困难模式下，增强无效。"]
	quest.511C1070B209F039.quest_desc: ["生长覆盖物可使所覆盖的浆果树的生长速率在3次收获内提高。"]
	quest.511FC41AF504D3DC.quest_desc: [
