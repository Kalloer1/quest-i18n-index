	quest.730A8EE0157D8E2F.quest_subtitle: "可以被压制成纸板（Cardboard）"
	quest.730E73CB41894271.quest_desc: ["&e糖果&r可用于将&d牛奶怪&r进化成&d各种奶油怪形态&r，具体取决于使用的糖果和一天中的时间。"]
	quest.730E73CB41894271.quest_subtitle: "Milcery -> 各种Alcremie形态"
