	quest.3643576B685EFD82.quest_desc: [
		"&dDynamax&r 是宝可梦中的一个战斗机制。"
		""
		"首先，你的Curio/Trinket栏位中需要一个&eDynamax Band&r。同时，你必须在20格范围内靠近一个&ePower Spot&r。"
		""
		"进入战斗后，在招式选择界面中，你会在返回按钮旁边找到一个用于Dynamax的按钮。"
		""
		"&n不能在战斗外使用Dynamax。也不能在非单打模式的战斗中使用Dynamax。&r"
	]
	quest.3648308AA4CED9A3.quest_subtitle: "对究极异兽最有效，对其他所有精灵球捕获率为0.1×。"
	quest.3648308AA4CED9A3.title: "野兽球"
	quest.3648D0790D050B8D.title: "大师球"
	quest.364ECD5481A3E914.quest_desc: ["击败末地守卫的奖励。这是一个覆盖整条手臂的巨大护手。穿戴后可获得防御力和防御强度，右键可使用念力将生物拉向你。"]
	quest.365506707AE2948D.title: "Oricorio 形态物品"
	quest.3657C0D13E6E4687.quest_desc: ["&6在能够对抗利维坦之前&r，需要先制作一个&d深渊祭品&r。这需要鹦鹉螺壳、阿撒莫特之剑、珊瑚块、海洋之心，\& 以及数块资源方块。"]
	quest.3657C0D13E6E4687.quest_subtitle: "用于召唤利维坦的远古生物"
	quest.3688C9F9A1113481.quest_desc: [
		"点击带有工厂仪表的库存链接，将其与该网络关联。最多可在一个方块中放置4个工厂仪表。"
		""
		"将物品放入过滤器槽位或在UI中设置后，即可将工厂计量器设为监控该物品。设置完成后，主UI将变为可用状态。"
		""
		"可以在UI中设置请求包裹的发送地址。这样包裹就能被分拣到正确的位置。可以为承诺设置一个过期时间。"
		""
		"UI会显示价值设置界面中设定的存储水平和已开启的承诺数量。价值设置界面：右键以打开价值设置界面，调整要保持在存储中的物品数量。可设置为任意数量(*)，或最多100个物品或堆叠。"
	]
	quest.3688C9F9A1113481.quest_subtitle: "用于通过物流网络发送请求的旧方法"
	quest.3693E0613199AF16.quest_subtitle: "适用于容易逃跑或以速度著称的宝可梦。"
	quest.3693E0613199AF16.title: "快速球体"
	quest.36CDE637FCDBBC8B.quest_desc: ["携带此乐谱并在战斗中参战的宝可梦会获得额外的&b速度EV&r，"]
	quest.36CDE637FCDBBC8B.quest_subtitle: "+ 速度努力值"
