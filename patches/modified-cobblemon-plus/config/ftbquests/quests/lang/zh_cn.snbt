	quest.7DCAEAD584233B43.title: "诱饵球"
	quest.7DD4428179D9C2E9.quest_subtitle: "在干旱气候中可找到"
	quest.7DD68E59A46591E0.quest_desc: ["若玩家处于燃烧状态或站在火焰中，施放法术时将扑灭火焰并获得“燃烧”药水效果。火焰法术的伤害和持续时间将随“燃烧”等级提升而增加。"]
	quest.7DE53E4CA92D1EE0.quest_desc: [
		"放在水槽下面加热！(某些重要配方所必需)。"
		""
