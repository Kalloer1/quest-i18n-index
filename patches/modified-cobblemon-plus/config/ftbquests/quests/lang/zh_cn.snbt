	quest.3B54337A8D3B90FA.title: "神奥格斗系宝可梦"
	quest.3B5CBA23C2E816B2.quest_subtitle: "可以在沼泽中找到它"
	quest.3B6104230CEAE2CD.title: "重型球体"
	quest.3B7CE5C7E5ED283F.quest_desc: [
		"&d对宝可梦的效果：&r若持有者受到物理攻击，攻击者将损失其最大HP的1/8。"
		""
		"&d诱饵效果：&r 提高宝可梦的基础友好度100点"
