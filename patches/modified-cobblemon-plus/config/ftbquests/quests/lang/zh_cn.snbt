	quest.67ED8996E37C1AE2.quest_desc: [
		"Pondering 是一款游戏内指南系统，能让玩家快速获取关于 Create 方块的信息。"
		""
		"沉思界面会显示一个示例装置，用以说明该方块的功能。"
		""
		"{@pagebreak}"
		""
		"将物品悬停在物品栏中并按住前进键（默认&6\"W\"&r）直到物品下方的进度条填满，即可显示关于该物品的动画信息图。"
		""
		"{@pagebreak}"
		""
		"沉思时，可以点击左侧图标或激活识别模式并按住 W 键来查看相似或相关的机器。"
		""
		"离开最初考虑的物品后，可以在左下角找到“回顾”选项。"
		""
		"点击底部灰色条的不同部分，可以跳转到动画的特定部分。"
	]
	quest.67ED8996E37C1AE2.quest_subtitle: "悬空时按住 <w> 键。"
