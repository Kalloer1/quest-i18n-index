	quest.7C7CDD3AE6AC67A0.quest_subtitle: "由Aether材料合成而成"
	quest.7C8D39FB10648AFE.quest_subtitle: "较小的武器，如 Sai、Cutlass、\& Chakram"
	quest.7C8D39FB10648AFE.title: "简易刀剑 - 轻型武器"
	quest.7CA3F40B8CAD15E3.quest_subtitle: "根据存储网络中指定资源的数量发出红石信号。"
	quest.7CA3F40B8CAD15E3.title: "探测器"
	quest.7CC3A02455575890.quest_subtitle: "熔炼你的装备，锻造新物品！"
	quest.7CECEE1F7FC25FC1.quest_subtitle: "捕获率提升1.5倍的二级精灵球。"
	quest.7CECEE1F7FC25FC1.title: "伟大的球体"
	quest.7CF62CFAC7F707D0.quest_desc: [
		"库存管理员能看到网络中的所有物品。UI会显示已连接的库存链接数量。如果库存管理员处于解锁状态，玩家可以搜索网络、请求物品，并为请求指定一个发送地址。"
		""
		"如果库存管理员被锁定，其他玩家将无法访问其UI。库存管理员仍然可以接受购物清单。"
	]
	quest.7CF62CFAC7F707D0.quest_subtitle: "用于向物流网络请求物品。"
	quest.7CF862CF07F156C7.quest_desc: ["飞行猪（phyg）是一种常见的被动生物，能提供猪肉排和羽毛。装备鞍子后，可以骑乘它们。"]
	quest.7CF862CF07F156C7.quest_subtitle: "猪也会飞！"
	quest.7CFC01AADC70A486.title: "能力护盾"
	quest.7D0205312365515C.quest_subtitle: "由Aether材料合成而成"
	quest.7D09F106BE93FA47.quest_desc: [
		"&d气球&r是一种手持物品，能让持有者脱离地面，即无法受到地面系招式和其他与地面相关的效果影响。"
		""
		"若持有者受到伤害性攻击，气球会破裂，效果消失。但物品本身不会被破坏，战斗结束后会恢复正常。"
	]
	quest.7D27CCA2E79A3BE5.quest_subtitle: "莫托姆，是双属性宝可梦，属性为&e电&r/&2草&r"
	quest.7D3A2295DEE1F98F.quest_desc: ["废弃城镇中心遗迹是主世界中任何含有沙子（不包括红沙或沙滩）的生物群系中都会出现的结构。该结构有9种不同变体，每种都包含0-3个箱子，有50%的几率是吉米古尔宝箱或镀金宝箱。这些结构周围还会生成各种随机结构，其中含有可疑沙子。"]
	quest.7D3A2295DEE1F98F.quest_subtitle: "任何含有沙子的生物群系"
