	quest.701C05E611FF1DA1.quest_subtitle: "用于传输物品的方块。"
	quest.7023359C4AA7C3A0.quest_desc: ["速度升级会减少交易界面交互的延迟。升级的下界合金版本会完全消除延迟，使交易界面与交易者每刻都进行交互。"]
	quest.7030F19DE8B1A6D3.quest_desc: [
		""
		"当用红石信号供电时，包装器会尽可能多地填充包裹。纸板包裹有9个物品栏。在包装器上放置附魔台标签，可为生成的纸板包裹贴上要送达的地址标签。"
	]
	quest.7030F19DE8B1A6D3.quest_subtitle: "用于制作纸板包裹的旧物品。"
	quest.703DF3EB9543851F.quest_desc: [
		"需要再次召唤这个训练师吗？"
		"-> 在训练师生成器中使用一个 &6专家腰带&r"
