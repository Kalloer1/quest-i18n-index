	]
	quest.703DF3EB9543851F.quest_subtitle: "击败它可将你的等级上限提升至68！"
	quest.704527E8483BD6F8.quest_desc: ["持有者每回合损失最大HP的1/8。接触时会转移到其他宝可梦身上。"]
	quest.7054D246E55DE0BA.quest_desc: ["当Zacian手持&6Rusted Sword&r时，它会转变为Crowned Sword形态，成为一只&eFairy/Steel-type&r宝可梦。"]
	quest.7054D246E55DE0BA.title: "头戴王冠的萨卡恩"
	quest.7078375FD7EF4160.quest_desc: [
		"通电后，会在指定延迟后发出一个短的红石脉冲。延迟可通过按住右键进入的值设置屏幕进行设置，范围从2刻到60分钟。延迟也可以通过剪贴板复制并粘贴到其他中继器或脉冲扩展器上。"
		""
		"脉冲值设置"
		"右键脉冲中继器可以将其反转。这样它默认开启，在接收到红石信号后会短暂关闭。"
	]
	quest.7078375FD7EF4160.quest_subtitle: "在指定延迟时间后发送一个脉冲信号。"
	quest.70A0FDCEC5AC6EDB.title: "探索与冒险"
	quest.70E7D208D1221DC0.quest_desc: ["&dArctovish&r、&dArctozolt&r、&dDracovish&r和&dDracozolt&r都需要&62个&r化石才能被复活，"]
	quest.70E7D208D1221DC0.quest_subtitle: "1 个怪物化石换 2 个化石！"
	quest.70FA15C06D8F971B.quest_subtitle: "投掷的距离没有变远那么多"
	quest.711DA7E6AC6EA142.title: "红宝石矿石"
	quest.713486FD573BF222.title: "石板球"
	quest.714F0E2FA701CB55.quest_subtitle: "重置那些进化史莱姆！"
