	quest.7E5311B28FDF0E00.quest_desc: ["If your Pokemon &6has full HP&r, this item gurantees the&6 holder will survive a One-Hit KO&r, leaving it &6with 1 HP&r."]
	quest.7E60CB924E5AC942.quest_desc: ["在工具/附魔的基础上，进一步增加攻击伤害，甚至让你的拳头也变得致命！"]
	quest.7E60CB924E5AC942.quest_subtitle: "提高你的秒伤！"
	quest.7E60CB924E5AC942.title: "手套"
	quest.7E62CDBFD8306B71.quest_desc: ["贸易升级会提高指定交易者的贸易提议数量。此功能不适用于本身具有灵活贸易提议数量的交易者（如 Paygate 和 LC Techs 能源交易者），或严格限制为单次交易的交易者（如老虎机）。"]
	quest.7E6773F915C9D2A8.quest_subtitle: "可用于修剪的有效物品"
	quest.7E6773F915C9D2A8.title: "修剪材料"
	quest.7E75C4A9C561006C.quest_desc: [
		"&d对宝可梦的影响：&r降低宝可梦的特防努力值10点，同时提升亲密度。"
		""
		"&d诱饵效果：&r吸引防御努力值提升的宝可梦"
	]
	quest.7E881C56D7629A64.title: "存储磁盘"
	quest.7EBAF1D56B1151D8.quest_desc: [
		"需要再次召唤这个训练师吗？"
		"-> 在训练师生成器中使用一件 &6Choice Scarf&r"
