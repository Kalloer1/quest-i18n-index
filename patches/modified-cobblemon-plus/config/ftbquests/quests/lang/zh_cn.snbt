	quest.1243E94AC2277A91.quest_subtitle: "可以在森林里找到它"
	quest.1245283850A4D130.quest_desc: ["银行升级功能允许钱箱自动向指定的银行账户存取款。此升级在钱箱中添加了两个新标签页，一个专门用于选择银行账户，另一个用于更高级的设置。"]
	quest.1247921287E2E252.quest_desc: [
		"背包有许多升级选项，&o升级底座是所有升级的基础&r。"
		""
		"查看本任务周围所有背包的各种升级选项！"
	]
	quest.126E4B156E3E4E3C.quest_subtitle: "&6使用以在形态变化之间循环切换"
	quest.1278EEF642B2C82E.quest_desc: ["完成此任务书的章节和所有特定模组的进度，都将获得收集者奖杯。"]
	quest.1278EEF642B2C82E.quest_subtitle: "请稍后查看更新，本章的 Quests 仍在制作中！"
	quest.1284BB6015A99DE0.quest_desc: [
		"&d对宝可梦的效果：&r在HP低于或等于1/4时恢复最大HP的1/3，并使攻击降低特性的宝可梦陷入混乱。"
		""
		"&d诱饵效果：&r 50% 概率吸引性格为攻击提升的宝可梦"
	]
	quest.1289DBC3B069002E.quest_desc: [
		"以下次要属性可用于帮助你微调附魔台："
		""
		"附魔线索会改变你在将鼠标悬停在附魔台槽位时所显示的附魔数量。通常，线索越多越好。"
		""
		"量子稳定性确保了量子只会带来益处，而不会有机会造成负面效果。"
		"允许宝藏会使宝藏附魔（如修补）出现在附魔台里。不过要小心，诅咒也是宝藏附魔！"
		""
		"附魔过滤器可以让你在附魔台里拉黑某些附魔。提供此属性的方块可用于从附魔池中移除不想要的附魔。"
	]
