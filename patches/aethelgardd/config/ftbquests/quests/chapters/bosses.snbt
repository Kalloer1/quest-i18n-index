	order_index: 0
	quest_links: [ ]
	quests: [
		{
			dependencies: ["35C2FFDFB7549EA7"]
			description: [
				"&cImmortal Executioner&r no es un simple guerrero, sino una entidad antigua cuya única existencia está ligada al cumplimiento de sentencias eternas."
				""
				"A diferencia de otros jefes, no parece tener un reino propio, sino que aparece como un &bejecutor implacable&r que busca castigar a aquellos que han acumulado demasiado poder o han desafiado las leyes naturales del mundo."
				""
				"&8Suele aparecer en &0ruinas antiguas&r &8o estructuras de tipo&r &0\"templo maldito\"&r &8que el mod genera aleatoriamente en el mundo.&r"
				""
				"{image:kubejs:textures/quests/phase/divider.png width:200 height:10 align:center}"
				""
				"威胁等级：&c☠☠☠&r"
			]
			hide_details_until_startable: true
			icon: "mythsandlegends:frozen_heart"
