				}
			]
			shape: "none"
			subtitle: "&c击杀虚空之花 (Void Blossom)</c1>"
			tasks: [{
				entity: "bosses_of_mass_destruction:void_blossom"
				icon: "bosses_of_mass_destruction:crystal_fruit"
