				}
				{
					auto: "enabled"
					id: "6F809FBD9A9C893E"
					item: {
						Count: 1
						id: "minecraft:written_book"
						tag: {
							author: "PrincipeAlex_"
							pages: [
								"{\"text\":\"Hola, muchas gracias por elegir este servidor, este proyecto es el mas grande que he hecho y cada temporada va evolucionando, agradezco a las personas que me animaron a que volviera abrir un servidor de nuevo :,D\"}"
								"{\"text\":\"Y gracias a vosotros por estar aqui, por siempre elegir este servidor, habiendo mejores que el mio :,)\\nRecuerda que si veis algun bug importante puedes abrir un ticket y reportarlo asi poder solucionarlo lo mas pronto posible.\\n\"}"
							]
							title: "非常感谢你，我的朋友。你真是太棒了！我欠你一个人情。下次需要帮助时，尽管来找我。祝一切顺利！"
						}
					}
					type: "item"
				}
				{
					command: "/say \"¡No, no, no! ¡Maldita sea! Quedan puras chispas... el portal me dejó aquí botado. ¿Qué carajos es este sitio? No veo a nadie, pero siento que mil ojos me están cayendo encima. Si no encuentro una salida pronto, este lugar me va a tragar vivo.\""
					icon: "traveloptics:shattered_hydrocharge_bracelet"
					id: "2D21AC534DBB89D1"
					type: "command"
				}
				{
					count: 5
					id: "28F3DD9E605E67A9"
					item: "minecraft:bread"
					type: "item"
				}
			]
