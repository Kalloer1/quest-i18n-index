	order_index: 1
	quest_links: [ ]
	quests: [
		{
			description: [
				"&7传送门在电光微语中关闭，将你留在了无限回响维度——Aethelgard 的广袤之中。"
				""
				"&7Es un mundo maravilloso que exhala un aroma inconfundible a aventuras inolvidables y promesas de gloria, con horizontes repletos de lugares majestuosos que claman por ser explorados. Pero no te dejes engañar por su belleza; en Aethelgard los desafíos ya aguardan por ti y lo desconocido oculta una cara implacable."
				""
				"&7Debes avanzar con cuidado, pues bajo sus cielos extraños acechan rincones peligrosos y enemigos nunca antes vistos que no conocen la piedad. Estás en el corazón de una realidad legendaria donde cada paso es una línea delgada entre el descubrimiento de un tesoro o la lucha feroz por tu propia supervivencia."
			]
			id: "218C0DAC49224ED0"
			require_sequential_tasks: false
			rewards: [{
				auto: "enabled"
				command: "/say «...Pero qué carajos...»"
				elevate_perms: true
				icon: "alexscaves:tesla_bulb"
				id: "38BF1B00EE1556AE"
				type: "command"
			}]
			shape: "woodtier"
			size: 1.2d
			subtitle: "&c埃塞尔加德，无限回响的维度。&r"
			tasks: [{
				dimension: "minecraft:overworld"
				id: "1AB6EBC38BE94BB5"
				title: "进入世界"
				type: "dimension"
			}]
			title: "&5一个神奇而又陌生的世界&r"
			x: -6.6d
			y: 20.4d
		}
		{
			dependencies: ["218C0DAC49224ED0"]
			description: ["\"¡No, no, no! ¡Maldita sea! Solo quedan chispas... el portal me dejó aquí tirado. ¿Qué demonios es este sitio? No veo a nadie, pero siento que mil ojos me están mirando. Si no encuentro una salida pronto, este lugar me va a tragar vivo.\""]
			hide_until_deps_complete: true
			hide_until_deps_visible: true
			icon: {
				Count: 1
				id: "irons_spellbooks:lightning_upgrade_orb"
