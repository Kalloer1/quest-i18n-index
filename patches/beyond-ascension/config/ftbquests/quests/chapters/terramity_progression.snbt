	quest_links: [ ]
	quests: [
		{
			dependencies: ["2932C7DEBC10B9D3"]
			description: [
				"如果你在进度系统中达到了这一点，那么你已经势不可挡了，但做好准备，事情只会变得更加困难。"
				""
				"要制作这些盔甲，你需要试炼守卫和超嗅者掉落的饰边&o(&9强烈建议从&6试炼守卫&9处获取，因为它比&7超嗅者&f容易得多)&r，它们分别是该模组&6第三&f和&6最终&r的进阶首领，还需要黑物质。"
				"{@pagebreak}"
				"在末地顶部的基岩层中发现。"
				""
				"必须用试炼守卫给的腐化之杖使其腐化，然后用之前提到的任意镐挖掘。"
				""
				"黑质也可以通过光谱之魂进行复制。"
			]
			icon: "terramity:black_matter"
			id: "2C6FC2D93C93E3DC"
			subtitle: "完成 Terramity_ii 的最后一个任务以解锁"
			tasks: [
				{
					id: "24B395F87DFFF9B8"
					item: "terramity:black_matter"
					type: "item"
				}
				{
					id: "007DC78ED3C06BED"
					title: "阅读检查点"
					type: "checkmark"
				}
			]
			title: "Tier 2"
			x: 21.5d
			y: 8.0d
		}
		{
			dependencies: [
				"3699BCBBF3B6FD50"
				"6BE05A6F132665B8"
			]
			description: [
				"一旦玩家获得了强大的武器、护甲和奇物配置，就准备好去挑战超嗅嗅怪了。"
				""
				"Ultra Sniffer 会掉落模组中每个 boss 的重要材料以及各种强力的奇物。"
				""
				"请记住，由于这是一个超级首领，请带上你&6最强大的装备&f来挑战它。"
				"{@pagebreak}"
				"当他在第2阶段且生命值低于&610%&f时，用闪电击中超级嗅探器即可召唤他"
			]
			icon: "terramity:kamehameha"
			id: "05D0AF91008E3155"
			rewards: [{
				id: "53BF6D1C91D1C48A"
				item: "soulsweapons:chungus_emerald_block"
				type: "item"
			}]
			subtitle: "超神形态 替代版悟空"
			tasks: [{
				entity: "terramity:ultra_sniffer"
				icon: "terramity:kamehameha"
				id: "73EC49CF0D0ADE5A"
				type: "kill"
				value: 1L
			}]
			title: "击败超嗅探者 (Ultra Sniffer)"
			x: 21.5d
			y: -13.0d
		}
		{
			dependencies: [
				"2C6FC2D93C93E3DC"
				"1A7701358F28775C"
			]
			description: [
				"收集到足够的材料后，你需要获取更难获得的材料来制作合适的锭："
				""
				"4 &d铱锭&f、1 块暗物质和以下物品各 4 个："
				""
				"4 在 Nether 中找到的 &4Cthonic Crystals&f，用于制作 Hellspec Ingots。"
				""
				"4 &eCircuit Boards&f crafted using vanilla and Terramity Items to get a Conductite Ingot."
				""
				"4 &7空灵精华 &f通过将黑质投入斯蒂克斯血中获得虚空合金锭。"
			]
			id: "770BF6E8DA6010C0"
			tasks: [
				{
					count: 4L
					id: "01E9B61997A5B0D9"
					item: "terramity:hellspec_alloy"
					type: "item"
