	file.0000000000000001.title: "The Convergence"
	quest.0046779192734A8F.quest_desc: ["将染色化合物投入信标光束中。"]
	quest.0077EBCEFF0C75E7.quest_desc: ["&l检查沉思&r"]
	quest.00D47787B02F7B42.quest_desc: ["&l能量传输器&r - 一种幻影旋转式功率传输器。为一个传输器提供旋转功率，将第二个传输器的频率设为与第一个相同，施加在第一个上的功率就会传输到第二个上。"]
	quest.00ED8BDD4D0FD04A.quest_desc: ["加速到所需速度（速度表上为1单位），使Dormant变为Charged。"]
	quest.0120EE4223F65D95.quest_desc: [
		"&l安山岩漏斗&r可以覆盖传送带。"
		""
		"此外，若放置在传送带交叉口，所有进入的物品中，将有且仅有1个被送往侧面，其余则继续向前移动。"
	]
	quest.0168E7E355DCA092.quest_desc: ["岩浆发电机是现阶段最高效的发电机。它每刻产生40FE，需要岩浆来生成能量"]
	quest.01A571C2E662E5A5.quest_desc: [
		"&l恭喜你。你已将所有模组融合为一件物品，其力量能让你进入&5创造模式&r。&r"
		""
		"手持物品时右键可切换到创造模式。再次右键可返回生存模式。"
		""
		"更快切换：将此物品放入“真正的创造力”奇物槽，然后按下绑定的键（默认：数字键盘“End”）来切换创造和生存模式。"
		"{@pagebreak}"
		"&l感谢游玩这个整合包！"
		"希望您玩得开心。&r"
		"&o你的&3PI7&r.&r"
		"{@pagebreak}"
		"&o或者…这还不是终点吗？…&r"
		"{@pagebreak}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"We will see it soon...\",\"font\":\"runelic:runelic\"}]}"
	]
	quest.01D7920708F0AD7C.quest_desc: ["&l滑槽&r的工作原理与漏斗相同，但没有物品栏，一次最多可运输16个物品。"]
	quest.01E3249F44EFEC7A.title: "粘土"
	quest.022523F42E60B671.quest_desc: ["允许你繁殖和杂交蜜蜂。"]
	quest.0275882D0DC74E81.quest_desc: ["允许更快地放置方块"]
	quest.02AD377FAB6E0719.title: "计数器"
	quest.03267BEC9859AC99.quest_desc: ["此戒指可保护玩家免受 Levitation 效果影响，每次移除该效果时，玩家将获得 1 个完整等级"]
	quest.0331277B6562AB01.quest_desc: ["如果有村民、金苹果和虚弱药水，就会把村民变成僵尸，然后再变回村民，给他们打折。"]
	quest.04632CABF3B98A42.quest_desc: ["使用&lLaser Drills&r和&lOre Laser Base&r（来自&lIndustrial Foregoing&r），并以Infinity Catalyst为基础，即可生成Eternal Singularities。"]
	quest.04632CABF3B98A42.title: "生成永恒奇点中"
	quest.0467895E65BCB2C3.quest_subtitle: "所有科技的交汇点"
	quest.058000A54ECA8A9A.quest_desc: [
		"&lMob Masher&r - 接收到红石信号时，它会开始旋转并对所有接触到的生物造成伤害。"
		"&l吸收漏斗&r - 吸引物品和经验球。可配置为向6个方向之一（如箱子等容器）输出物品或经验。"
		"&l染色玻璃&r - 阻挡光线穿透。"
	]
	quest.058000A54ECA8A9A.title: "高级生物刷怪系统"
	quest.059E34799868C7E7.quest_desc: ["如果拥有所需材料，将自动建造一个凋零。"]
	quest.06662DA6FC44E1A9.quest_desc: ["&lTransporter&r可将物品从一个容器移动到另一个容器，但不能从另一个Transporter中提取物品。"]
	quest.0746A35E9E7DDA7F.quest_desc: [
		"&l&7安山岩外壳&r&r可用于覆盖竖井、齿轮和传送带。它们也可用于装饰目的。"
		""
		"要制作它们，手持安山合金，右键点击去皮的原木或木头方块。"
	]
	quest.077BB60FEC99FFD0.quest_desc: [
		"要建造 &lClibano&r，请建造以下结构："
		"{image:atm:textures/questpics/convergence/clibano.png width:200 height:100 align:center}"
		"手持 Mundabitur 粉尘，右键点击 Clibano 核心。"
	]
	quest.077BB60FEC99FFD0.title: "Clibano"
	quest.07CED37BC7692F2B.quest_desc: ["将预测转化为来自怪物的战利品。"]
	quest.0907EDC40F6F7C90.quest_desc: ["&l检查沉思&r"]
	quest.0958B28B61711DDE.quest_desc: [
		"Apothic Enchanting 有 3 种属性：Eterna、Quanta 和 Arcana。"
		""
		"- &aEterna&r 决定了附魔等级本身。例如，如果 Eterna = 30，附魔等级就是 30。"
		"- &cQuanta&r 会影响随机性。例如，附魔的随机结果可能比 Eterna 等级好得多，但也可能差得多。"
		"- &5Arcana&r会影响附魔的数量和稀有度。例如，Arcana较高时，强大的附魔会更频繁地出现，一个物品可以同时拥有更多附魔。"
		"{@pagebreak}"
		"还有&l灌注&r的概念。当物品可以通过附魔升级时，就需要特定等级的永恒、量子和奥术来进行灌注。"
	]
	quest.09C94B18E85640F4.quest_desc: ["击杀生物，用血液填满提取器。确保自动补给模式已开启。"]
	quest.09E7AE7305C03B18.quest_desc: ["使用经验、青金石和特殊物品为书籍附魔。"]
	quest.09FD168D4DB013A9.quest_desc: [
		"用&lCrook&r破坏树叶可能会掉落&lsilkworms&r。"
		""
		"&lSilkworms&r 可以被放置在其他树叶上以&l感染&r它们。"
		"感染后，可以用&lCrook&r来敲断树叶以获得&lstrings&r。"
	]
	quest.0A47CA5D6C1AC076.quest_desc: ["吸引物品"]
	quest.0AAE36CB15B466C3.quest_desc: [
		"&lStock Link&r放置后会创建一个新的库存网络。放置前也可以将其链接到另一个库存网络。"
		""
		"更多详情，请查看&lPonder&r。"
	]
	quest.0AB1188D5D8B5693.quest_desc: ["降低机器产生的噪音"]
	quest.0B332E427D7C73B0.title: "&6发起人：&r 暗物质"
	quest.0B71F8E167D881D2.quest_desc: ["增加交互范围"]
	quest.0C02E462A121AF6C.quest_desc: ["右键点击损坏的物品，并使用此物品进行修复。"]
	quest.0C2E777E0262BF0C.quest_desc: [
		"&lMechanical Crafter&r 既可用于普通配方，也可用于无法在普通工作台完成的配方。"
		""
		"使用&l扳手&r，你可以控制物品从一个槽位移动到另一个槽位的方式。要完成配方，所有必需的物品都必须按正确顺序到达单个输出端。你也可以在输出端放置一个存储容器，这样合成的物品会自动存入其中。"
		""
		"要了解更多信息，请查看&lPonder&r。"
	]
	quest.0C67CFEA7D3E75CE.quest_desc: ["若应用于物品，该物品在死亡后不会消失。"]
	quest.0D131526BDC279FF.quest_desc: ["提高使用化学物品的机器的效率"]
	quest.0D21A326651C9909.quest_desc: [
		"&l逻辑线缆&r将物流组件连接成网络。"
		""
		"&l扳手&r可以破坏组件和线缆，也可以旋转方块"
	]
	quest.0DB8909F39A59B4D.quest_desc: ["{image:atm:textures/questpics/convergence/empowerer.png width:200 height:150 align:center}"]
	quest.0DE0CD7EFC30268D.quest_desc: ["{image:powah:textures/gui/book/images/player_transmitter.png width:200 height:120 align:center}"]
	quest.0DECACD0D1420ACF.title: "MekaSuit"
	quest.0E52392E83EB860D.quest_desc: ["授予所有者飞行能力 &o&7（如同创造模式）&r&r"]
	quest.0E5DCE48DBF4ADDE.quest_desc: ["获取经验（或手持物品时右键）将经验放入胶囊中。"]
	quest.0E62A00F02BDBFC6.quest_desc: [
