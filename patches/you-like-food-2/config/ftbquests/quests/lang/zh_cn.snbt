	file.0000000000000001.title: "你喜欢食物吗？"
	quest.00368B9D8D0AA41C.quest_desc: [
		"目标是制作出本模组中所有寿司的完美版本！"
		"頑張ろう！"
		""
		"&l特别感谢Lucius the Dragon制作了此章节的Quest内容&r"
	]
	quest.00368B9D8D0AA41C.title: "任务链信息！"
	quest.006F104FBAD475C1.quest_desc: [
		"这是灌注水晶，是所有神秘农业配方所需的初始水晶。"
		""
		"在你能制作出大师融合水晶之前，这都会是你所有神秘农业冒险的好伙伴。"
		""
		"这用于将劣化精华升级成更好的精华，以便制作更高级别的作物。"
	]
	quest.00725DD56665EBBB.title: "铁质小刀"
	quest.00A2C18028AC2FEF.quest_desc: [
		"这是来自 Dungeon's Delight 模组的特殊方块：&8Dungeon Stove&r 和 &aMonster Pot&r。"
		""
		"&a怪物锅&r能让你制作出Dungeon's Delight模组里的各种食物。"
		""
		"但是&a怪物锅&r需要使用特殊类型的热源，即&8地牢炉&r。怪物生成器或试炼生成器也能加热，但地牢炉最简单。"
		""
		"没有其他炉子或热源能让你使用怪物锅。"
	]
	quest.00C72FEB874BB3BE.quest_desc: ["我发誓这会是你的&5梦想厨房&r，真的会是这样。"]
	quest.00C72FEB874BB3BE.quest_subtitle: "厨房的力量，启动！！！！"
	quest.00C72FEB874BB3BE.title: "你的梦想厨房"
	quest.01BF46C7CA80B799.quest_desc: ["手持烈焰加热器，右键烈焰或烈焰生成器即可填充。"]
	quest.01CC339DD832A044.quest_desc: ["电缆是将所有东西连接成一个巨型存储系统的组件。最基础的材质，石英富铜，可用于与其他材料一起制作这些电缆。"]
	quest.01CC339DD832A044.title: "电缆！"
	quest.02E38530F841100D.quest_desc: [
		"Prudentium Essence，又称Tier 2精华。用于制作Tier 2种子。"
		""
		"此任务之上的所有任务均为需要 Prudentium Essence 的 Tier 2 种子。"
	]
	quest.02E7312A32825D55.quest_desc: ["准备好基本材料后，你就可以用这个来做寿司了！"]
	quest.032479E20F617615.quest_desc: ["要使用无线电网，首先需要为其充电。充电后，在控制器上按住 Shift 并右键点击它，这样它就和你的系统连接了。"]
	quest.0331D78D12670FF8.quest_desc: [
		"制作更高级合成台所需的必备物品。"
		""
		"要制作催化剂，你需要相同类型的组件才能成功制作。"
	]
	quest.04134A85CA8E5D96.quest_desc: ["没有这颗眼睛，Evoker 就毫无力量"]
	quest.04139F75A6457D93.quest_desc: [
		"Arcane Essence 是你在 Iron's Spells and Spellbooks 中制作许多物品所需的最基本材料。"
		""
		"此材料用于制作秘银锭和秘银布。"
		""
		"秘法织物是制作法师盔甲所必需的材料。"
		""
		"Arcane Essence 也用于指南针或炼金术士坩埚等其他物品。"
		""
		"某些金属也需要使用此材料才能进行合成。]"
		""
		"Arcane Essence 可以通过击杀 Iron's Spells 中的怪物或在结构中获取。"
	]
	quest.04601608E12D7E8D.quest_desc: [
		"这些是打包机方块。使用红石脉冲，打包机可将物品打包到纸箱中。"
		""
		"然后你可以把纸箱送到另一个包装工那里，他会把里面的物品拆包到相连的背包里。"
		""
		"重包装器可以让你将多个纸板箱合并成一个，这样就不会有多个箱子同时前往同一个地方了。"
	]
	quest.04601608E12D7E8D.title: "包装工"
	quest.04A7FA52110CFC84.quest_desc: [
		"魔法豆可以在巨魔洞穴中找到，这些洞穴里有宝库，在较小版本的宝库中，可以找到魔法豆。"
		""
		"它们也可能从最终城堡周围的荆棘叶中掉落。"
		""
		"要到达天空岛，需要用到魔法豆。只需将魔法豆种在岛屿下方的地面上，然后向上攀爬即可。"
	]
	quest.04E6ECAD48C4F707.quest_desc: ["这个得用烟熏炉才行！"]
	quest.059698CD94247185.quest_desc: ["用大豆和水在发酵桶中酿造而成。"]
	quest.05AF88DA30591959.quest_desc: ["这是整个 Refined Storage 系统的 &l大脑&r。没有它，你的系统将无法运行。"]
	quest.0609B91E45E78A54.quest_desc: [
		"使用Flux Crafting制作，是制造增强红石锭的关键材料。"
		""
		"制作此物品需要 4 个红石锭和 1 个下界之星。"
	]
	quest.06B0F1B32C2F48EE.quest_desc: [
