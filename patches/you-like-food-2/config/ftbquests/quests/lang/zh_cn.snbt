	quest.0C3EF92CF10F80B6.title: "末地哥布林盔甲"
	quest.0C545146FDCC83C7.quest_desc: ["杀死末影幼虫会奖励你末影幼虫肉，这是一种“好”的食物来源。"]
	quest.0C6AF39695F5795B.quest_desc: [
