		{
			dependencies: ["665922B1E3FAA7C7"]
			description: ["欢迎来到首个电压等级，0.5 ULV！（又称蒸汽）此等级独特，因为它使用蒸汽机器而非电力。它还有一些其他机制，但我们会在遇到时再了解它们。"]
			id: "4CA574760EF63553"
			subtitle: "你大约在一小时内完成了人类一千年来的科技发展"
			tasks: [{
				id: "71BE5591C28A30B4"
				title: "蒸汽时代，即刻开启！"
				type: "checkmark"
			}]
			x: -21.0d
			y: 3.5d
		}
		{
			dependencies: [
				"4CA574760EF63553"
				"09DCF85E9679FFE3"
			]
			description: ["蒸汽是通过锅炉产生的。它们能让你……把水烧开。有三种类型的锅炉：&l&0固体锅炉&r，燃烧木炭和煤炭等固体燃料；&l&1液体锅炉&r，燃烧焦油油和熔岩等液体；以及&l太阳能锅炉&r，利用&l&o&e太阳的力量&r来烧开水。"]
			id: "694D21DD359391F9"
			min_required_tasks: 1
			rewards: [{
				id: "65D7AAD7DDF29DC2"
				item: "kubejs:ulv_loot_bag"
				type: "item"
			}]
