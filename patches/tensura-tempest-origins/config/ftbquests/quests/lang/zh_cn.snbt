# AI 初翻，未人工校对
{
	file.0000000000000001.title: "Tempest Origins"
	chapter_group.09DB374D2FA95CDE.title: "野外指南"
	chapter.0404E15126E50C27.title: "学习你的技能"
	quest.445BDEE4CCDD8CAF.title: "开启你的技能"
	quest.445BDEE4CCDD8CAF.quest_desc: [
		"每段旅程都始于你已知的一切。打开TenSura状态菜单，查看你当前的能力。"
		"[\"您当前的状态栏按键：\", { \"keybind\": \"tensura.keybinding.main_gui\", \"color\": \"aqua\" }, \".\"]"
		"如果该键未绑定或与其他操作冲突，请在 Controls > TenSura:Reincarnated 下更改 Status Menu。找到该界面后，标记此项为已完成。"
	]
	quest.4CE46ADBD5181896.title: "阅读一个技能"
	quest.4CE46ADBD5181896.quest_desc: [
		"选择一个技能，阅读其内置描述或维基条目。注意它的功能以及是否有特殊输入。"
		"维基详细介绍了各项能力。本指南将帮助你运用它们。"
	]
	quest.0D060572701EE21E.title: "装备一个技能"
	quest.0D060572701EE21E.quest_desc: [
		"收藏中的技能不一定能立即施放。请将你拥有的技能放入一个主动能力槽中。"
		"如果难以找到装备动作，请检查技能界面和TenSura控制。当某个槽位的能力就绪时，标记此项为完成。"
	]
	quest.0D2D9C511D47E110.title: "仅可铸造一次"
	quest.0D2D9C511D47E110.quest_desc: [
		"在安全的地方试试你装备的能力。注意它的 Magicule 消耗、冷却时间，以及是否需要目标或其他输入。"
		"[\"能力槽：\", {\"keybind\":\"tensura.keybinding.ability.slot_1\",\"color\":\"aqua\"}, \" / \", {\"keybind\":\"tensura.keybinding.ability.slot_2\",\"color\":\"aqua\"}, \" / \", {\"keybind\":\"tensura.keybinding.ability.slot_3\",\"color\":\"aqua\"}, \".\"]"
		"如果什么都没发生，请查阅其维基条目。成功施放即可完成任务；无需战斗。"
	]
	quest.74E86E6E0E335BCB.title: "使用预设配置"
	quest.74E86E6E0E335BCB.quest_desc: [
		"合适的装备能在危机来临时节省时间。探索预设控制，保存一套配置，然后在技能足够后切换使用。"
		"如果你的技能列表还很少，等第二个配置有用了再回来。"
	]
	quest.0871FCC05F33A981.title: "更改模式"
	quest.0871FCC05F33A981.quest_desc: [
		"部分能力有多种模式。若你拥有其中一种，请阅读说明、切换模式并观察差异。"
		"[\"模式控制：下一个 \", {\"keybind\":\"tensura.keybinding.next_mode\",\"color\":\"aqua\"}, \"; 上一个 \", {\"keybind\":\"tensura.keybinding.previous_mode\",\"color\":\"aqua\"}, \".\"]"
		"如果你的能力还没有模式，可以等一等再做这个。"
	]
	quest.24C5283D53368424.title: "开启和关闭的切换开关"
	quest.24C5283D53368424.quest_desc: [
		"如果你有可切换的能力，请开启它，观察其效果，然后关闭。某些主动技能会持续消耗资源。"
		"进入战斗前请注意持续的资源消耗。"
	]
	quest.600A0B858ACBA29F.title: "按住并释放"
	quest.600A0B858ACBA29F.quest_desc: [
		"部分能力需要时间来蓄力或施放。如果你拥有其中一个，请遵循其说明：按住输入键，然后在恰当的时机松开。"
		"在战斗中依赖它之前，先找个安全的地方练习。"
	]
	quest.2017D68B8E06A8E9.title: "分析性评估"
	quest.2017D68B8E06A8E9.quest_desc: [
		"无需大贤者技能也能进行基础鉴定。请在安全的对象上练习。"
		"[\"切换评估模式：\", {\"keybind\":\"key.greatsage.assess\",\"color\":\"aqua\"}, \"。瞄准安全目标并按住扫描：\", {\"keybind\":\"key.greatsage.scan\",\"color\":\"aqua\"}, \"直到分析完成。\"]"
		"如果其中一个绑定未绑定或与另一个动作冲突，请在 Controls > Great Sage 下选择一个空闲按键。阅读结果以完成课程。"
		"[\"其他大贤者控制：菜单 \", {\"keybind\":\"key.greatsage.menu\",\"color\":\"aqua\"}, \"; 说话 \", {\"keybind\":\"key.greatsage.voice\",\"color\":\"aqua\"}, \"; 停止（恐慌） \", {\"keybind\":\"key.greatsage.panic\",\"color\":\"aqua\"}, \".\"]"
		"战斗模式和直接对话需要大圣技能。"
	]
	chapter.3E490E6C3B769D1E.title: "陌生世界的第一天"
	quest.24EFCAA9E17E21B1.title: "环顾四周，观察环境"
	quest.24EFCAA9E17E21B1.quest_desc: [
		"在选择方向之前，先为你周围的世界命名。瞄准一个方块或生物，然后阅读 Jade 的标签。"
		"查看小地图寻找安全路线。确定目的地后，标记此课程为已完成。"
	]
	quest.7C20A679472A1312.title: "查找配方 Look Up a Recipe"
	quest.7C20A679472A1312.quest_desc: [
		"一次好的探险始于计划。在物品栏的合成配方中查找你想要的工具，然后追溯其材料，看看今天能制作出什么。"
		"JEI 和 EMI 均可使用。任选其一，然后标记该课程为已完成。"
	]
	quest.42E5E36DC092DE52.title: "制作一个工作台"
	quest.42E5E36DC092DE52.quest_desc: [
		"制作一个工作台并将其保留在物品栏中即可完成此目标。你之前制作的也可以。"
		"现在你可以用这个配方搜索功能了。"
	]
	quest.0339AEEC2A662AA0.title: "确保营地安全 (Secure a Camp)"
	quest.0339AEEC2A662AA0.quest_desc: [
		"有处可退，第一晚会更容易。建造一个小庇护所，或在现有的定居点中寻找安全之处。"
		"如果你的形态允许，设置一个出生点，并记下营地位置。找到安全返回的地方后，标记此项完成。"
	]
	quest.345F697FB5316CEB.title: "喂养你的形态"
	quest.345F697FB5316CEB.quest_desc: [
		"准备适合你形态的食物或其他恢复来源。适合一种TenSura种族的饮食可能对另一种毫无作用。"
		"农夫乐事和水产养殖会提供更多选择。现在，先找一个可靠的选项，然后标记本教程为已完成。"
	]
	quest.3374744E6666CFC7.title: "标记返回路线"
	quest.3374744E6666CFC7.quest_desc: [
		"在Xaero的地图上标记一个路点，指向你的避难所或其他有用的地标。写下坐标也行。"
		"走一小段路，确保能找到回去的路。有了回家的路线，你就可以接公会任务了。"
	]
	quest.5E974EB9AD0129CB.title: "携带重要的东西 Carry What Matters"
	quest.5E974EB9AD0129CB.quest_desc: [
		"工具、食物和战利品都争抢着同一个口袋。查一查 Sophisticated Backpack 的配方，看看它是否适合你的下一次旅行。"
		"你现在可以制作一个，也可以稍后再来。此路线为可选。"
	]
	quest.020C83C1B32BA1EC.title: "一个用于后期的传送石"
	quest.020C83C1B32BA1EC.quest_desc: [
		"路标石能将遥远的哨所变成常规站点。若发现一个，请记住其位置，并考虑它如何融入你的路线。"
		"第一天不必急着寻找。继续探索，路线自然会显现出来。"
	]
	quest.6FB288F9AF2F338E.title: "准备好迎接挫折吧"
	quest.6FB288F9AF2F338E.quest_desc: [
		"了解 Corpse 模组如何处理你死亡后的物品，并在冒险前规划好回家的路。"
		"无需现场演示。知道如何取回装备后，即视为完成此任务。"
	]
	chapter.774C4D7055E4F6B2.title: "冒险者公会"
	quest.19376423F5EB6D7A.title: "打开公会大厅"
	quest.19376423F5EB6D7A.quest_desc: [
		"[\"直接打开公会，使用 \", {\"keybind\":\"key.tensura_all_the_adventure.open_guild\",\"color\":\"aqua\"}, \"; 或使用 \", {\"keybind\":\"tensura.keybinding.main_gui\",\"color\":\"aqua\"}, \" 打开TenSura的状态菜单，然后选择交叉剑图标。\"]"
		"两条路线都会导向同一个公会界面。访问公告板和个人资料标签页，然后标记此课程为已完成。在控制设置中更改任何未绑定或冲突的按键。"
	]
	quest.0A0A9E8524FAE3D0.title: "阅读你的个人资料"
	quest.0A0A9E8524FAE3D0.quest_desc: [
		"公会会记录你自己的工作成果。打开个人资料，查看你的冒险者等级、冒险经验值和下一次晋升要求。"
		"冒险经验与TenSura经验分开。公会条满后开启五波次的等级试炼，通过试炼即可晋升。"
	]
	quest.6140B2F34BF6C9B1.title: "阅读契约"
	quest.6140B2F34BF6C9B1.quest_desc: [
		"接受公会任务前请仔细阅读条款：目标、服务器、奖励、时限和惩罚都至关重要。"
		"选择一个你的装备和环境能应付的任务。补给、采集、勘探和普通狩猎合同都是不错的初次任务。"
	]
	quest.442A0B4DD8ECC829.title: "领取一个任务"
	quest.442A0B4DD8ECC829.quest_desc: [
		"在公告板上接受你的选择并追踪。公会HUD会显示待办事项。"
		"补给任务需通过活跃指派运送物品。勘测需要指定的生物群系和维度；采集则需要指定维度中匹配的方块。"
	]
	quest.0E9F09EC16C496AA.title: "你的首个委托任务"
	quest.0E9F09EC16C496AA.quest_desc: [
		"完成一份冒险者公会的合约。公会会记录已完成的工作，此目标会据此更新。"
		"在开启此章节前完成的任务也算在内。如需查看个人总数，请检查你的个人资料。"
	]
	quest.613DF46ED7781F09.title: "前往公会市场逛逛吧"
	quest.613DF46ED7781F09.quest_desc: [
		"你获得了公会币。去市场看看你的当前等级能买到什么。"
		"货物会轮换，所以把金币留着，用于支持你的下一次探险。检查完商品后，标记此任务为已完成。"
	]
	quest.3CD68F9EFB4C1AC7.title: "获得F级排名"
	quest.3CD68F9EFB4C1AC7.quest_desc: [
		"当冒险经验条充满时，个人资料会提供一个等级试炼。准备好迎接五波攻势，在安全的地方开始战斗；保持在竞技场64格以内。"
		"不用着急。完成此可选目标的条件是达到F级。"
	]
	quest.6661904CA2077A53.title: "村庄悬赏公告板"
	quest.6661904CA2077A53.quest_desc: [
		"有些村庄会在公告板上发布本地工作。找到公告板后，阅读请求并与公会合同进行比较。"
		"村庄悬赏与公会委托是分开的。此可选路线会等待你遇到告示牌。"
	]
	quest.653831622719ECFB.title: "以团队形式旅行"
	quest.653831622719ECFB.quest_desc: [
		"和朋友一起旅行？打开 FTB 团队，决定队伍如何共享任务书进度。单人冒险者只需检查团队设置即可。"
		"公会仍然会单独记录每个玩家的等级和契约。此分支为可选。"
	]
	chapter.2E10592676FA7AE3.title: "Boss Fieldbook"
	quest.60D9E3D169CCD91F.title: "选择你的猎物"
	quest.60D9E3D169CCD91F.quest_desc: [
		"Boss狩猎始于地点、归途和撤退方法。使用下方的档案，在TenSura和本整合包的其他维度中侦察巢穴。"
		"进入结构后，每个地点记录即告完成。战斗是可选的，你可以在挑战首领很久之前就得知其位置。"
	]
	quest.17FE12B342B79CC5.title: "卡律布狄斯洞穴"
	quest.17FE12B342B79CC5.quest_desc: [
		"TenSura's Charybdis Cave 可能出现在温带、干旱或寒冷地区。寻找洞穴入口及其休眠核心；巨兽并非只是在门口等待。"
		"进入任意查里布迪斯洞穴即可完成此侦察记录。将核心视为挑战首领的选择，使用前做好准备。"
	]
	quest.3F963D9371210348.title: "四处游荡的TenSura之敌"
	quest.3F963D9371210348.quest_desc: [
		"并非所有TenSura首领都守在地下城中。兽人偏爱沙漠和荒地，而异世界人则可能出现在平原、稀树草原、沙漠、荒地和山区。"
		"兽人灾难和稀有的Ifrit/Shizue遭遇属于那些漫游故事。留意迹象和公会线索；无需击杀，在此标记目击即可。"
	]
	quest.462B21B8206B3A64.title: "迷宫之树 (The Labyrinth Tree)"
	quest.462B21B8206B3A64.quest_desc: [
		"在远古森林中寻找TenSura的迷宫树。那是TenSura自己迷宫的入口，而非暮色森林沼泽下的迷宫。"
		"进入树状结构即视为发现。穿过其传送门前，先找到回家的路。"
	]
	quest.3A4CFB037733F11D.title: "进入迷宫 (Into the Labyrinth)"
	quest.3A4CFB037733F11D.quest_desc: [
		"穿过远古森林中的树木进入迷宫。该维度有其自身的危险和出口，需要规划路线。"
		"TenSura's labyrinth advancement 会记录这次访问，即使你是在打开 Fieldbook 之前发现的。"
	]
	quest.0B918D9D8AF99616.title: "元素巨像"
	quest.0B918D9D8AF99616.quest_desc: [
		"元素巨像在TenSura的迷宫中等待，可从远古森林进入。这是一场首领狩猎，并非进入该维度的必要条件。"
		"准备好再击败它。击杀任务会自动记录战斗；小奖励会独立于正常掉落。"
	]
	quest.22DC6AFA97F1CC65.title: "兽人灾难"
	quest.22DC6AFA97F1CC65.quest_desc: [
		"兽人灾难属于TenSura的流动威胁，而非固定地牢。跟随标志和公会线索穿越沙漠和荒地。"
		"此可选狩猎仅在击败首领后完成。单独寻找一个就足以完成田野笔记。"
	]
	quest.47C5EA4FB868FA1C.title: "风暴巨兽"
	quest.47C5EA4FB868FA1C.quest_desc: [
		"洞穴里有通往查里布迪斯的路，但找到它和唤醒并活过那头野兽是两码事。"
		"击败 Charybdis 即可完成此可选击杀任务。在投入战斗前，请先做好撤退的准备。"
	]
	quest.67A43B2D03E78578.title: "阿格拉的挑战"
	quest.67A43B2D03E78578.quest_desc: [
		"TR: 噩梦可以将恶魔生成替换为Agera。这是一种罕见的遭遇，并非地图上带名字的遗迹。"
		"该任务记录了战胜Agera的胜利；普通恶魔不计入在内。"
	]
	quest.12541C9549CBD87D.title: "飞行中的弗雷（Frey in Flight）"
	quest.12541C9549CBD87D.quest_desc: [
		"TR: 噩梦可以用弗雷替换幻影。注意天空，不要以为例行的夜间遭遇会一直如此。"
		"击败弗雷以完成此可选记录。奖励是旅行补给，而非另一种TenSura力量来源。"
	]
	quest.413240617369CA45.title: "米利姆的愤怒"
	quest.413240617369CA45.quest_desc: [
		"TR: Nightmare's Milim Wrath 可以替代 Otherworlder 的生成。她与你在定居点附近可能遇到的 Princess Milim 友谊或对战遭遇不同。"
		"此可选任务要求击败Wrath boss。切勿将早期与Princess Milim的会面误认为战斗指令。"
	]
	quest.6C93E3D2FC9E1A91.title: "Rimuru：食人魔时代试炼"
	quest.6C93E3D2FC9E1A91.quest_desc: [
		"Not Enough Bosses 添加了早期 Rimuru 遭遇，专为作者任务或服务器活动设计。当前整合包将其自然替换概率设为零。"
		"此可选任务在服务器或整合包事件使该首领可用前保持休眠状态，并不意味着存在天然巢穴。"
	]
	quest.5F29CF4C28510640.title: "腐肉：野兽之王试炼"
	quest.5F29CF4C28510640.quest_desc: [
		"Not Enough Bosses 包含 Carrion，但目前整合包中他不会自然生成。请将其视为未来公会或服务器活动的遭遇战。"
		"如果事件已启用，击败 Carrion 将自动记录胜利。Fieldbook 不会为他分配虚假的位置。"
	]
	quest.6A2FF75BB1624A47.title: "Luminous: 最终试炼"
	quest.6A2FF75BB1624A47.quest_desc: [
		"Not Enough Bosses 将 Luminous Valentine 设定为极具难度的战斗。在当前整合包中，其自然替换概率为零。"
		"只有特定事件或后续配置才会开启此可选试炼。无法触发的遭遇不会获得额外奖励。"
	]
	quest.1C66120D94355A64.title: "龙之巢穴"
	quest.1C66120D94355A64.quest_desc: [
		"冰龙和火龙会在地表筑巢。火龙巢偏好温暖地区，冰龙巢偏好寒冷地区，而雷龙巢则偏好沼泽、丛林、恶地或稀树草原。"
		"靠近前请先扫描地平线。进入任意巢穴以记录地点；与巢中巨龙交战则是另一项决定。"
	]
	quest.115DC96AB2EBD292.title: "龙之洞穴"
	quest.115DC96AB2EBD292.quest_desc: [
		"在相同气候区域的地下，冰与火会生成地下龙洞。地表巢穴和深层洞穴各有不同。"
		"洞穴本身即完成了此记录。在扰动内部任何东西之前，请先确保有一条安全的逃生路线。"
	]
	quest.5985E0E640FFA06D.title: "沼泽九头蛇"
	quest.5985E0E640FFA06D.quest_desc: [
		"在沼泽和沼泽地中寻找冰火九头蛇洞穴。尽管名字如此，但它是一个地表地标。"
		"进入洞穴标记其位置。带着一场多头之战的计划回来。"
	]
	quest.26442969CA51C155.title: "戈尔贡神庙"
	quest.26442969CA51C155.quest_desc: [
		"冰与火模组会在海滩生物群系中生成戈尔贡神庙。宁静的海岸下可能隐藏着危险的内部。"
		"神庙完成了侦察任务。在挑战戈尔贡之前，准备好被石化吧。"
	]
	quest.487A4CE0181C37DE.title: "Naga 庭院"
	quest.487A4CE0181C37DE.quest_desc: [
		"在暮色森林中，娜迦正等待在普通森林群系和空地中的一座围墙庭院里。"
		"先找到并进入庭院。Naga 是暮色系列中常见的开场战斗。"
	]
	quest.00EFA220311EB581.title: "不死者之塔"
	quest.00EFA220311EB581.quest_desc: [
		"暮色巫妖塔矗立在森林和空地之上。学会娜迦路线后，寻找那座高塔。"
		"巫妖在顶部附近等待。进入塔楼会记录发现，无论你是否准备好攀登。"
	]
	quest.386D1918285B4DA6.title: "沼泽迷宫"
	quest.386D1918285B4DA6.quest_desc: [
		"Minoshroom的迷宫位于暮色森林的沼泽之下。请在湿地而非天际线中搜寻。"
		"进入结构以记录它。迷宫及其居民都是探险的一部分，不仅仅是 boss 房间。"
	]
	quest.222796AFD92E882F.title: "九头蛇的火焰沼泽"
	quest.222796AFD92E882F.quest_desc: [
		"暮光九头蛇的巢穴位于火沼泽。在进入这个更热的区域前，请先遵循沼泽的演变过程。"
		"侦察巢穴就足以完成档案了。把战斗留给有准备的返程吧。"
	]
	quest.5C3672EB7B822295.title: "骑士堡垒"
	quest.5C3672EB7B822295.quest_desc: [
		"骑士幻影守卫着暮色森林黑暗森林下方的一个堡垒。入口比上方的树冠更难发现。"
		"进入要塞以记录其位置。在探索其内部之前，先规划好退路。"
	]
	quest.479422248F66D1C8.title: "黑暗之塔"
	quest.479422248F66D1C8.quest_desc: [
		"远古恶魂在暮色暗林中心的黑暗高塔中等待着你。"
		"攀爬前请在地图上标记塔楼。进入该结构后，档案即视为完成。"
	]
	quest.1A3462CBC24E80C7.title: "雪怪的洞穴"
	quest.1A3462CBC24E80C7.quest_desc: [
		"在暮色雪林里搜寻雪怪洞穴及其首领雪怪。"
		"进入洞穴会记录位置。不要把雪林和下一个宫殿所在的冰川搞混。"
	]
	quest.26E8A883A03C6BB7.title: "极光宫殿"
	quest.26E8A883A03C6BB7.quest_desc: [
		"雪女王统治着暮光冰川地区的极光宫殿。在冰层上方寻找宫殿吧。"
		"进入宫殿完成这份侦察记录；上层楼层可以等你准备好后再去。"
	]
	quest.444743229140D6B4.title: "青铜地牢：滑块谜题"
	quest.444743229140D6B4.quest_desc: [
		"在以太群岛上，青铜地牢里藏着滑行者。去以太本身寻找吧，这些地牢不会在主世界生成。"
		"进入青铜地牢以记录路线。在开始首领战斗前，探索其中的房间。"
	]
	quest.1BC08383263ECD38.title: "银色地牢：女武神女王"
	quest.1BC08383263ECD38.quest_desc: [
		"以太中的银色地牢通往瓦尔基里女王。它们是青铜地牢之外的独立地标。"
		"输入一个即可完成任务地点。准备好接受女王的挑战时再与她交谈。"
	]
	quest.4C1D79EF1F683223.title: "黄金地牢：太阳之灵"
	quest.4C1D79EF1F683223.quest_desc: [
		"以太中的黄金地牢里关押着太阳之灵。在岛屿景观中寻找这个位于以太深处的地标。"
		"先记下入口。首领战可以等下一次探险再打。"
	]
	quest.1882DC3A9AAC349A.title: "灵魂锻造匠"
	quest.1882DC3A9AAC349A.quest_desc: [
		"Cataclysm的Netherite Monstrosity与下界的Soul Blacksmith有关。其Eye of Monstrous可以帮助定位该结构。"
		"搜寻下界废土、灵魂沙谷、扭曲森林或绯红森林。进入锻造炉以记录它。"
	]
	quest.05362EC005DD859E.title: "燃烧的竞技场"
	quest.05362EC005DD859E.quest_desc: [
		"Ignis 会在下界废土的 Cataclysm's Burning Arena 被召唤。The Eye of Flame 会指向该竞技场。"
		"进入结构以标记其位置。保留召唤步骤，为战斗做好准备。"
	]
	quest.0B0C35AD74ED3454.title: "被诅咒的金字塔"
	quest.0B0C35AD74ED3454.quest_desc: [
		"Cataclysm's Cursed Pyramid 在沙漠中崛起；Eye of Desert 可以指引你前往。其 Ancient Remnant 可通过内部的可疑沙子唤醒。"
		"进入时记录金字塔。此处的考古工作远不止简单的挖掘。"
	]
	quest.44A08E22F3615D72.title: "远古工厂"
	quest.44A08E22F3615D72.quest_desc: [
		"先兆者位于灾变的远古工厂，一个地下结构。机械之眼可以指引搜寻。"
		"找个安全的路下去，进入工厂。小心别意外启动了那里的机器。"
	]
	quest.60FB89434A82E57A.title: "沉没之城"
	quest.60FB89434A82E57A.quest_desc: [
		"利维坦与灾变中的沉没之城在深海生物群系中相连。深渊之眼可以定位它。"
		"带上水下旅行和撤退的计划。进入城市即完成侦察任务。"
	]
	quest.3EA5CC1FF4A4E7C7.title: "冰冻监狱"
	quest.3EA5CC1FF4A4E7C7.quest_desc: [
		"Maledictus 在 Cataclysm's Frosted Prison 中等候，该监狱生成于雪地。Eye of Curse 是其定位物。"
		"在进入监狱前，先标记好位置。进入该结构即完成档案。"
	]
	quest.77B3B3468D58C724.title: "被毁的堡垒"
	quest.77B3B3468D58C724.quest_desc: [
		"末地守卫与末地高地和丘陵中的灾变遗迹堡垒有关联。虚空之眼可以帮助找到它。"
		"进入堡垒以记录地点。保持一条安全的返回路线穿过末地。"
	]
	quest.552AE236FE9C0758.title: "Acropolis"
	quest.552AE236FE9C0758.quest_desc: [
		"Scylla's Acropolis 生成于 Cataclysm 的暖洋之上。The Eye of Storm 可以指引你前往。"
		"规划海上航行和攀登。进入卫城以完成这份最后的侦察记录。"
	]
	chapter.114A722404E8BF79.title: "TenSura 成长系统"
	quest.125C03FFA676CF63.title: "衡量自己实力的一个标准"
	quest.125C03FFA676CF63.quest_desc: [
		"打开TenSura的状态菜单，比较你的种族、EP、魔法储备和当前技能。这些数值描述了你的角色的不同方面。"
		"找到每个物品后，请标记此课程。当出现新能力或进化时，状态屏幕是你的首要参考。"
	]
	quest.23E64C6FA1650EA3.title: "阅读你的种族信息"
	quest.23E64C6FA1650EA3.quest_desc: [
		"找到你的种族条目，阅读其优势、限制和可能的下一阶段。并非所有物种都适合相同的训练路线。"
		"写下你现在可以努力达成的一个条件。人类和怪物角色的选择可能大不相同。"
	]
	quest.173D6788781CCE48.title: "先练习，再使用强力道具"
	quest.173D6788781CCE48.quest_desc: [
		"选择一个你已拥有的技能。装备它，测试其主动模式或切换功能，并在危险中使用前注意其消耗。"
		"技能描述会解释具体能力。本课将学习操作方式，并了解技能的实际消耗。"
	]
	quest.2952AEE69722481A.title: "保持你的储备量"
	quest.2952AEE69722481A.quest_desc: [
		"魔法粒子不是免费的第二生命条。安全施法时注意储备量，并在下次测试前让它恢复。"
		"如果你的形态储备为空或受到魔法粒子中毒，请先停止训练并恢复。在你自己看到代价后，再标记此项。"
	]
	quest.3F7FFE139EB53B8E.title: "规划下一个形态"
	quest.3F7FFE139EB53B8E.quest_desc: [
		"将你的种族进化选项与当前可满足的EP、命名等条件进行比较。使用TenSura内置的维基查看具体形式。"
		"选择方向，而非截止日期。当你明确下一步及所需成本时，请标记此课程。"
	]
	quest.64FDFC5C5305D311.title: "记录你的成长历程"
	quest.64FDFC5C5305D311.quest_desc: [
		"在发生有意义的变化后返回状态菜单：新技能、更高的储备、命名事件或进化。"
		"本书会记录你的决定；TenSura 仍对你种族和属性的决定权。在对比完旧计划与新选项后，请在此处标记。"
	]
	quest.2B1863A91B05A52F.title: "一千经验值"
	quest.2B1863A91B05A52F.quest_desc: [
		"更高的最大EP池能带来更多可能性，但这并不能取代学习当前能力的重要性。"
		"此可选里程碑在TenSura的EP值达到1,000时完成。其他章节不要求完成此里程碑。"
	]
	quest.298CD6DB5A1FC15A.title: "一场属于你自己的进化之旅"
	quest.298CD6DB5A1FC15A.quest_desc: [
		"遵循你物种的有效进化路线，包括 Origins 或 Cross Evolution 提供的路线，如果你选择了那条路。"
		"TenSura报告新形态后，将其特性与旧形态比较并标记此记录。无需特定种族。"
	]
	quest.2332CCAEE3FABB91.title: "一把会成长的武器"
	quest.2332CCAEE3FABB91.quest_desc: [
		"Gear Evolution 赋予装备独特的成长故事。在投入一件喜爱的武器前，先检查一件符合条件的装备，了解其进阶方式。"
		"在游戏内确认进度后勾选此项。角色的种族进化和装备进化是两个独立的系统。"
	]
	quest.12713FDBD6BAFFC1.title: "其他开端 (Other Beginnings)"
	quest.12713FDBD6BAFFC1.quest_desc: [
		"Origins 和已安装的种族扩展包增加了可玩起始形态。浏览可用条目，并记下其中一个不熟悉的优势或限制。"
		"这是关于你下一个角色或同伴构筑的参考教程，不是要求重开这个世界。"
	]
	quest.50AAAB9288225C11.title: "不止一位老师 (More Than One Teacher)"
	quest.50AAAB9288225C11.quest_desc: [
		"More Skills、Magic Growth 和其他 TenSura 扩展包会添加初始技能包之外的能力路线。查找你想要的技能和解锁条件。"
		"有明确目标时标记此项。不要认为某个技能出现在列表中就能获得。"
	]
	quest.30C24E7573EA0D76.title: "名字的重量"
	quest.30C24E7573EA0D76.quest_desc: [
		"命名会改变另一个生物的道路，并消耗大量你的力量。在确认名称前，请阅读目标和成本。"
		"仅在储备和情况安全时尝试。理解选择后即可完成课程；无需下属。"
	]
	chapter.58DB0F7C0EC65E43.title: "觉醒与责任"
	quest.50C136A0E8B20FA8.title: "在门槛之前"
	quest.50C136A0E8B20FA8.quest_desc: [
		"觉醒是后期的目标，而非第一晚的任务。在追求恶魔领主、英雄或其他路线前，请先研究相关的状态和维基条目。"
		"查看所需成就及其对你自身形态的影响。本章所有路线均为可选。"
	]
	quest.0353CCDC49C5440A.title: "选择地面"
	quest.0353CCDC49C5440A.quest_desc: [
		"如果觉醒或试炼会引来敌人，请先侦察四周。注意定居点、盟友和返回路线。"
		"选定安全地点和撤离路线后，请在此标记。即使推迟活动，准备工作也很重要。"
	]
	quest.4ABABF9E679108BD.title: "选择你的传奇遗产"
	quest.4ABABF9E679108BD.quest_desc: [
		"比较一下你的角色可以实际走的路径。恶魔领主路线、英雄路线和种族专属最终形态都不是可以互换的成就。"
		"写下符合该角色的一个路线。下方的可选里程碑会记录结果，不会强制完成其他。"
	]
	quest.4D794715440B1FB4.title: "力量有邻居了"
	quest.4D794715440B1FB4.quest_desc: [
		"更强大的角色会改变殖民地或队伍的风险。考虑在重大转变后，你会如何调整装备、技能预设和公会工作。"
		"有实际计划了就标记一下，即使觉醒还很遥远。默认情况下，更强的首领不应该作为你的首个考验。"
	]
	quest.12AC3210C4C2F58B.title: "恶魔领主种子"
	quest.12AC3210C4C2F58B.quest_desc: [
		"此路线会记录TenSura的Demon Lord Seed状态，当你的角色到达该路线时。"
		"该任务会检查模组的觉醒状态。它不会授予觉醒，也不要求其他玩家走相同路线。"
	]
	quest.6D76BF9A5D2E6784.title: "真正的恶魔领主"
	quest.6D76BF9A5D2E6784.quest_desc: [
		"按照TenSura的要求完成恶魔领主路线。在触发任何大型事件前，准备好场地和队伍。"
		"此可选任务会记录最终状态，但任务书不会创建仪式或其奖励。"
	]
	quest.26198F3F39604457.title: "英雄の始まり"
	quest.26198F3F39604457.quest_desc: [
		"英雄候选人的故事与恶魔领主种子不同。请在状态和维基条目中阅读具体条件。"
		"TenSura 识别到英雄蛋时会记录其状态。书中的其他路线仍然开放。"
	]
	quest.6CA87C2902024CCF.title: "英雄誓言"
	quest.6CA87C2902024CCF.quest_desc: [
		"遵循TenSura的英雄要求直至完成，并注意你的能力和义务是如何变化的。"
		"可选任务会检查英雄状态本身。这里没有虚构任何击败首领来代替觉醒。"
	]
	chapter.53AEF4B4EFB4BCC5.title: "魔法学院"
	quest.4515F7D0654689A8.title: "新手指南手册"
	quest.4515F7D0654689A8.quest_desc: [
		"从初级魔法书开始，阅读随附的 Ars Nouveau 指南。书籍是工具，指南则说明如何使用工坊。"
		"将魔咒书留在物品栏中即可完成此课程。此战役中的物品任务不会消耗你带来的物品。"
	]
	quest.794D1DA95DDC5D69.title: "寻找源头"
	quest.794D1DA95DDC5D69.quest_desc: [
		"源石是学院的燃料。查找源石宝石，并追踪你在世界中可以获取它的位置。"
		"获得一颗宝石以记录你的第一种材料。学会法术后可返回更大的源生产地。"
	]
	quest.3C195AFFBB447764.title: "附魔室 (Imbuement Chamber)"
	quest.3C195AFFBB447764.quest_desc: [
		"灌注室可将早期材料转化为魔法组件。在设置永久工作台前，请先阅读其布局。"
		"带上一个密室来完成目标，然后把它放在可以建造周围的地方。"
	]
	quest.6D06DCCD67593ED9.title: "编写一个有效的法术配方"
	quest.6D06DCCD67593ED9.quest_desc: [
		"构建一个带有形态和效果的法术，以便安全测试。先在一个无害的目标上试用，然后检查其法力消耗和施放距离。"
		"只有自己施放法术后才能勾选此项。法术书的配方与使用法术书并非同一回事。"
	]
	quest.03378A958B29C3FE.title: "附魔装置 Enchanting Apparatus"
	quest.03378A958B29C3FE.quest_desc: [
		"附魔装置是下一个工坊步骤。在投入昂贵材料前，先阅读基座和源如何驱动配方。"
		"获取一台设备以完成此站点里程碑。其完整配置可随你的定居点一同发展。"
	]
	quest.7D5FE8F0943F22B2.title: "一个源供应品"
	quest.7D5FE8F0943F22B2.quest_desc: [
		"农业源链接能将附近的植物生长转化为源。它更适合用于农业前哨，而非一次性实验。"
		"带一个来记录这条可选的补给路线，然后将它的产出与你的工坊需求进行比较。"
	]
	quest.74463D48BD275010.title: "元素专注"
	quest.74463D48BD275010.quest_desc: [
		"Ars Elemental 在基础魔典之外增加了专注学派。选择一个符合你需求的专注：机动、防御、伤害或辅助。"
		"测试一个元素符文或焦点，然后标记课程。火是示例，不是必需元素。"
	]
	quest.47E6D134686CE891.title: "魔法工坊中的魔法"
	quest.47E6D134686CE891.quest_desc: [
		"Ars Creo 将咒语与创造机器联系起来。Ars Technica 增加了另一套技术符文和工具。"
		"选择一个桥梁进行勘察，并为你的基地寻找一个实用用途。本教程不需要完整的工厂。"
	]
	quest.38224E92B9E3DE01.title: "不寻常的书架 (The Unusual Shelves)"
	quest.38224E92B9E3DE01.quest_desc: [
		"Ars Ocultas 为 Ars Nouveau 添加了更奇特的应用。阅读其中一个条目，并在测试前检查任何特殊消耗。"
		"找到真正想用的能力后，请标记此研究笔记。学校是可选的。"
	]
	chapter.00CFF75B9F04F9E9.title: "咒刃研习课程"
	quest.474E3D71CA11CDA6.title: "一本用于战斗的书"
	quest.474E3D71CA11CDA6.quest_desc: [
		"Iron's Spells 使用自己的魔咒书、卷轴、法力值和学派。建议从普通书籍入手，而非围绕稀有掉落物规划。"
		"带上铜质魔法书即可开始。TenSura技能和Iron的魔法使用独立的控制和成长系统。"
	]
	quest.6E082ACDDF1DF696.title: "写在纸上的咒语"
	quest.6E082ACDDF1DF696.quest_desc: [
		"找到或制作卷轴，在使用前阅读其学派和等级。卷轴本身是一个法术，而非永久法术书的栏位。"
		"在物品栏中保留一张卷轴以记录发现。具体咒语可能因探险而异。"
	]
	quest.35E8B279AE0D693F.title: "受控的投掷（A Controlled Cast）"
	quest.35E8B279AE0D693F.quest_desc: [
		"在安全的目标或开阔地带施放一次铁魔法。注意法力消耗、冷却时间和任何残留效果。"
		"真实投掷后标记课程。在村民之外练习是学习范围的一部分。"
	]
	quest.2C9881C500F01FFD.title: "神秘锻造台 (The Arcane Anvil)"
	quest.2C9881C500F01FFD.quest_desc: [
		"秘法铁砧是咒刃法师用来升级书籍和法术的地方。在消耗稀有卷轴前，请先阅读所需材料。"
		"带上一个神秘铁砧来完成车站目标。只升级你打算继续使用的法术。"
	]
	quest.66FBE9A2D4A15110.title: "选择一个学校"
	quest.66FBE9A2D4A15110.quest_desc: [
		"不同的学派解决不同的问题。将一种攻击法术与适合你种族的移动、治疗或辅助法术进行比较。"
		"构建一套能施放两次的装备。当你能解释这些法术为何共用一本书时，标记该课程。"
	]
	quest.7CE847EB2543243E.title: "一项专注的升级"
	quest.7CE847EB2543243E.quest_desc: [
		"升级球可以提升法术书的能力。在将其应用到最好的书上之前，请先确认球的效果。"
		"此可选目标会记录一个法力升级球；是否使用取决于你。"
	]
	quest.602DDD643D757C24.title: "森林之外的魔法"
	quest.602DDD643D757C24.quest_desc: [
		"Twilight Spellbooks 扩展了 Iron 的咒语选择，加入了与暮色森林相关的魔法。将其中一个咒语与你的当前学派进行比较。"
		"阅读并测试新选项后请在此标记。进入暮色森林的内容在《边境与其他领域》中。"
	]
	quest.2D2EB97A3396BFAF.title: "两种类型的魔法"
	quest.2D2EB97A3396BFAF.quest_desc: [
		"TenSura 和 Iron 的兼容模组链接了一些能力，但并非所有法术都成为 TenSura 技能。"
		"在已安装的指南或游戏中检查一个交互，然后记录它所消耗的资源。在配置中保持系统独立。"
	]
	chapter.1F6BA8CC503A8745.title: "灵魂与生态学"
	quest.1D8AC7A3D84CB645.title: "环保主义者的书籍"
	quest.1D8AC7A3D84CB645.quest_desc: [
		"自然光环将土地视为机器的一部分。放置从该区域汲取能量的装置前，请先阅读其书籍。"
		"带上这本书来完成第一课。书页上记载着你需要建造的精确结构。"
	]
	quest.2F5E59FCEA1B35E1.title: "阅读这片土地的故事，了解其中的秘密。"
	quest.2F5E59FCEA1B35E1.quest_desc: [
		"穿过未受干扰和受干扰的区域。了解自然气息如何在消耗或恢复前显示局部平衡。"
		"当你确定所选的工坊地点需要照料时，请在此标记。坚固的基地不应留下死寂的景观。"
	]
	quest.28A65559044BCD93.title: "一瓶充满活力的药水"
	quest.28A65559044BCD93.quest_desc: [
		"光环瓶能将无形的资源具象化。查阅其合成配方，并为初次实验准备一个。"
		"手持瓶子以完成目标。不要为了填满箱子而清空一片区域。"
	]
	quest.687ECF8A7B71F746.title: "建造一个祭坛"
	quest.687ECF8A7B71F746.quest_desc: [
		"自然祭坛能将野外劳作转化为实用材料。请检查其布局、附近气场及所需材料。"
		"带上祭坛，记录你的第一个自然气息工作站。将其放置在土地可以承载的位置。"
	]
	quest.262184992BC1D48C.title: "给予回报"
	quest.262184992BC1D48C.quest_desc: [
		"在基地附近选择一个受损或过度使用的区块，并规划恢复其氛围或生物多样性的方法。"
		"做出实质性改进并再次检查区域后，再标记此项。目标是打造一个能用的工坊，而非装饰性的树。"
	]
	quest.29FA17F8B5A13043.title: "一年有四季，四季更迭，周而复始。"
	quest.29FA17F8B5A13043.quest_desc: [
		"Serene Seasons 改变了作物和旅行的节奏。注意当前季节，并完成一个现在比之后更容易的任务。"
		"为下一季保持适度的储备。完成一次实际调整后再标记此项。"
	]
	quest.2CAA79F28A6FBDB4.title: "林冠中的黄金"
	quest.2CAA79F28A6FBDB4.quest_desc: [
		"金叶是自然气息的独特材料之一。使用这本书来寻找正确的工艺，而不是靠名字猜测。"
		"获得一片叶子以记录技巧。物品任务不会消耗它。"
	]
	quest.7FD7565A74E46F29.title: "另一种类型的灵魂 (Another Kind of Spirit)"
	quest.7FD7565A74E46F29.quest_desc: [
		"Malum通过灵魂木、灵魂石和自身仪式研究灵魂。盲目采集前，请先阅读《神秘学百科全书》。"
		"保留百科全书以完成此可选介绍。其精神系统与自然气息分离。"
	]
	quest.305072FC20395353.title: "灵魂祭坛"
	quest.305072FC20395353.quest_desc: [
		"灵魂祭坛是 Malum 的站点，并非自然祭坛的升级。阅读其仪式书页，选择一个安全的地方进行工作。"
		"带一个祭坛来记录分支。两个系统都合理后，TenSura Nature's Aura 桥梁就可以探索了。"
	]
	quest.43F7F8ABCE1F26BF.title: "一个活着的符文印记"
	quest.43F7F8ABCE1F26BF.quest_desc: [
		"该整合包的编年史路线连接了MCA援助、Ars材料、Create黄铜和一个Nature's Aura祭坛。其Living Spirit Sigil开启了一个可选的TenSura火灵试炼。"
		"带上活灵印记以记录准备过程。在开始下界战斗仪式前，请阅读其游戏内说明；此任务不提供灵体。"
	]
	chapter.4DFD31CE272D0F70.title: "神秘学研究 Occult Research"
	quest.4C17553A39C7A2FD.title: "灵体词典 (The Dictionary of Spirits)"
	quest.4C17553A39C7A2FD.quest_desc: [
		"Occultism 始于其《灵界词典》。在凭记忆复制仪式圈之前，先阅读首个仪式的条目。"
		"带上词典以完成目标。将其保持在仪式地点附近。"
	]
	quest.33B9CEB939B5F6E2.title: "一个有意义的圆圈"
	quest.33B9CEB939B5F6E2.quest_desc: [
		"粉笔可以画出仪式图案，但图案和灵体的条件与颜色同样重要。"
		"获取白色粉笔，然后阅读一个完整的仪式条目。不要召唤到拥挤的村庄里来测试理论。"
	]
	quest.43622670690C4D4E.title: "寻找隐藏之物"
	quest.43622670690C4D4E.quest_desc: [
		"占卜杖能让无形的资源搜寻变得有迹可循。读懂它的探测结果，找到目标所在。"
		"带上鱼竿来完成课程。搜索失败是地点或条件的线索，而非随意挖掘的理由。"
	]
	quest.27C7B1D25508ECEB.title: "受控的仪式 (A Controlled Ritual)"
	quest.27C7B1D25508ECEB.quest_desc: [
		"准备好完整的仪式图案、所需物品和明确的出口。在尝试更强大的召唤前，先观察这个过程。"
		"仪式成功后才标记此项。注意结果及其维护成本。"
	]
	quest.0C1756517B0B7F48.title: "收容也是研究的一部分"
	quest.0C1756517B0B7F48.quest_desc: [
		"神秘学和神秘主义都可能带来强大的遭遇。在开始之前，先决定危险的实验该在哪里进行。"
		"划定边界和逃生路线后标记此处。本课要求谨慎，而非强行走暗道。"
	]
	quest.7AD9060B0B4DD8EA.title: "更庞大的物品目录"
	quest.7AD9060B0B4DD8EA.quest_desc: [
		"Occultism Extra Spirits 和 Occultism Jars 扩展了可用的仪式和存储选项。阅读一条新条目，并将其成本与基础仪式进行比较。"
		"记录一个你真正会追求的使用方式；附加组件目录是可选的。"
	]
	quest.51E517AC380824AB.title: "一份实用的契约"
	quest.51E517AC380824AB.quest_desc: [
		"Occult Engineering 将召唤的劳动力与工坊需求相连。寻找一个灵魂能比大型机器更出色完成的工作。"
		"在确定输入、输出和该工作的安全位置后，标记该笔记。"
	]
	quest.79BA33AE47496DB9.title: "神秘学档案袋"
	quest.79BA33AE47496DB9.quest_desc: [
		"Mysticism 为 TenSura 世界增添了奇特的形态与遭遇。在循着传闻进入某生物或种族的领地前，先阅读它们的条目介绍。"
		"标记此内容，用于侦察地点后决定是否返回。无需进行特定转换。"
	]
	chapter.681A5884B2E35923.title: "国家中的生活"
	quest.63DD26FD355C850E.title: "一个有名字的地方"
	quest.63DD26FD355C850E.quest_desc: [
		"找到一个村庄、殖民地或城镇，并了解它的名字。一个国家始于人民，而非地图上的一条线。"
		"在Xaero的地图上标记定居点，并记录一条安全的返回路线，然后再勾选此课程。"
	]
	quest.523CCDA636F6C895.title: "认识一下邻居们"
	quest.523CCDA636F6C895.quest_desc: [
		"MCA村民有各自的关系、日常和历史。与居民交谈，了解他们从访客那里需要什么。"
		"对话后标记。友谊需要时间来培养，无需选择特定关系。"
	]
	quest.348E821CAE769DF7.title: "有用的工作"
	quest.348E821CAE769DF7.quest_desc: [
		"寻找实际的本地需求：丰饶请求、食物配送、安全道路或殖民地补给订单。"
		"完成一个可在游戏中验证的小任务，然后标记此课程。公会契约将作为单独记录保留。"
	]
	quest.141FBCA87E14FA29.title: "信任需要时间"
	quest.141FBCA87E14FA29.quest_desc: [
		"阅读定居点对你行动的回应。MCA声望、MCA犯罪和公会等级是本版本的不同系统。"
		"查看相关屏幕后勾选此项。公会晋升不能证明村庄信任你。"
	]
	quest.78081681E2718262.title: "一座城镇的记忆"
	quest.78081681E2718262.quest_desc: [
		"四处打听或查阅当地记录。当一处地方有历史时，首都、后裔、对话和任务都会更有意义。"
		"写下值得回顾的一个人、一件事或未解决的问题，然后标记教训。"
	]
	quest.2A39F53EE9F58F94.title: "你将归属于何处？"
	quest.2A39F53EE9F58F94.quest_desc: [
		"选择该角色是帮助现有村庄、建立 MineColonies 定居点，还是在社区间旅行。"
		"标记一个适合该选择的初始项目。其他路线仍可作为支线任务保留。"
	]
	quest.23C344863D558BDC.title: "发现了一个殖民地"
	quest.23C344863D558BDC.quest_desc: [
		"MineColonies 始于物资和太空计划。放置补给营地前，先检查附近的地形和领地。"
		"将营地部署器带来以记录此可选的创建路线。放置它是另一个决定。"
	]
	quest.2EB94B6129FA95DB.title: "建筑师的第一个工地"
	quest.2EB94B6129FA95DB.quest_desc: [
		"建造者小屋能将营地变为工地。阅读材料需求，并为道路和未来的房屋留出空间。"
		"带上小屋方块来完成这个可选的站点目标。你可以支持另一个玩家的殖民地，而不是建立自己的。"
	]
	quest.788C0F267859163E.title: "一张更广阔的地图"
	quest.788C0F267859163E.quest_desc: [
		"Townstead、SmallColonies 和 Towntalk 添加了比单个村庄界面更多的城镇元素。去访问一个你尚未使用过的定居点功能吧。"
		"记录受益者并标记笔记。无需占领整个区域即可探索系统。"
	]
	quest.308F9B449ED28858.title: "朋友之间的边界"
	quest.308F9B449ED28858.quest_desc: [
		"此整合包包含 Open Parties and Claims 和 FTB Chunks。在保护共享建筑前，请先查看派对和领地界面。"
		"确定好团队将使用的系统，然后标记该课程。在保护机制测试前，避免重叠主张。"
	]
	quest.62D707B87C865345.title: "法律与后果"
	quest.62D707B87C865345.quest_desc: [
		"MCA 犯罪系统可能会根据你的行为采取独立的法律措施。在你想保留的定居点测试前，请先了解当地规则。"
		"阅读后果后在此标记。犯罪是一个故事分支，非必要进度。"
	]
	quest.39F659FEE3F81890.title: "旅行者的编年史"
	quest.39F659FEE3F81890.quest_desc: [
		"该整合包的《旅行日志》记载了一个本地MCA村庄的故事及其当前的物资请求。用一本书和指南针合成，然后在有人的家附近使用。"
		"带上编年史来解锁这条可选路线。在决定是否运送补给前，先阅读其中的信息。"
	]
	quest.054A10203C7C95C4.title: "一封感谢信"
	quest.054A10203C7C95C4.quest_desc: [
		"在主背包中，潜行使用所需的物资和编年史。村庄会记录一次成功的交付，并给你一个感谢信。"
		"带上这封信完成此可选任务。它也是该整合包灵符配方的一部分，所以如果想走那条路线就留着吧。"
	]
	chapter.2EC73F2EE33B5761.title: "Tempest Workshops"
	quest.25B2A1389EA0CFB1.title: "一个会动的部件"
	quest.25B2A1389EA0CFB1.quest_desc: [
		"工坊在建造之前，需要先确定用途。从一个齿轮和一个你想自动化的简单任务开始吧。"
		"带上一个齿轮，记录你的第一个创造组件。保持设计紧凑，直到它正常工作。"
	]
	quest.30BF571635EA61F1.title: "让运动发挥作用"
	quest.30BF571635EA61F1.quest_desc: [
		"水车能将稳定的水流转化为旋转动力。检查水流方向和可供你第一台机器使用的应力。"
		"带上轮子完成任务，然后在方便维护和水流的地方建造。"
	]
	quest.384A3AAFC59A6223.title: "磨坊石 (The Millstone)"
	quest.384A3AAFC59A6223.quest_desc: [
		"磨石能将简单原料变为实用材料。查看配方，开启你的烹饪或建筑新计划。"
		"获取一块磨石来记录车站。机器带可以等这个磨石有任务了再运行。"
	]
	quest.666AF5134AE18A59.title: "机械压榨机"
	quest.666AF5134AE18A59.quest_desc: [
		"机械压机无需咒语即可塑形。连接前，先追踪其输入、输出及所需速度。"
		"带上一个压机来完成目标。用便宜的配方测试一下，再投入稀有金属。"
	]
	quest.5CBCEF02A2B59E04.title: "搬运货物"
	quest.5CBCEF02A2B59E04.quest_desc: [
		"传送带能让工坊清晰易懂：原料由此进入，成品由此流出。规划路线前，先绘制好路径。"
		"带上一个带孔连接器，建造一条清晰的物品传输路径。一条小型可靠的线路就已经很有用了。"
	]
	quest.6C5E936E2547C14B.title: "一次成功的轮班工作"
	quest.6C5E936E2547C14B.quest_desc: [
		"将线路从输入端连接到输出端，然后检查在物资耗尽或机器卡住时，线路会停在哪里。"
		"制作出实用物品并解决一个瓶颈后，再标记此项。这才是一个真正工坊的开始。"
	]
	quest.4112787E3A11E91A.title: "社区厨房 (The Communal Kitchen)"
	quest.4112787E3A11E91A.quest_desc: [
		"中央厨房可将烹饪与机械传送相结合。为村庄或探险商店规划一条生产线。"
		"在厨房追踪完材料后标记。喂养村民比单纯追求产量更适合作为首个工厂目标。"
	]
	quest.3781C1047BFE983D.title: "谨慎附魔 (Careful Enchantment)"
	quest.3781C1047BFE983D.quest_desc: [
		"创造附魔工业为活动部件提供了另一种用途。阅读其流程，并选择一个值得改进的物品。"
		"安全测试后再标记。不要将贵重物品都通过未经测试的线路运输。"
	]
	quest.15DC2ACDBD124A41.title: "咒语与竖井"
	quest.15DC2ACDBD124A41.quest_desc: [
		"Ars Creo 能将魔法与机械结合。选择一个步骤，用咒语省力，同时不隐藏机器的工作原理。"
		"实践测试或明确建造计划后标记。魔法与运动可以共享一个工坊。"
	]
	quest.596AD42C08904A35.title: "围攻选项"
	quest.596AD42C08904A35.quest_desc: [
		"Create Big Cannons 改变了冲突的规模和性质。在建造靶场前，请先研究其安全、弹药和目标规则。"
		"此路线为可选。若你的 Tempest 版本包含攻城工程，才勾选此项。"
	]
	chapter.0C43DA24261F0D3B.title: "食物与补给品"
	quest.47D6171F76CEF5ED.title: "厨师的烹饪工具包"
	quest.47D6171F76CEF5ED.quest_desc: [
		"漫长的旅程始于厨房。一把刀可以解锁 Farmer's Delight 的食谱，更好地利用收集到的食材。"
		"带上铁刀，然后找一道能用你所在地区的食材烹饪的菜肴。"
	]
	quest.3F1606E75EEDEC31.title: "建造一个壁炉 (Hearth)"
	quest.3F1606E75EEDEC31.quest_desc: [
		"烹饪锅能将散装食材变成派对餐点。留出空间用于燃料、储存和用餐。"
		"将锅带到记录站。将其设置在厨师能同时拿到食材和旅行者的地方。"
	]
	quest.50C322CC55D6B9B9.title: "派对时间，开吃吧"
	quest.50C322CC55D6B9B9.quest_desc: [
		"用本地作物或动物准备一份可重复的餐食。注意单次应急口粮和可靠食物供应的区别。"
		"吃掉或分享这顿美餐，然后标记这节课。定居点可能像它的粮仓一样脆弱。"
	]
	quest.06EF41D19657016F.title: "从水到桌子"
	quest.06EF41D19657016F.quest_desc: [
		"Aquaculture 让钓鱼不再只是偶尔的零食。试试合适的鱼竿或鱼饵，了解哪些水域能钓到有用的鱼。"
		"带上一块生鱼排。在长途探险前，规划好如何烹饪或保存捕获的鱼。"
	]
	quest.2C72131D3BC062BD.title: "旅途背包整合包"
	quest.2C72131D3BC062BD.quest_desc: [
		"离开定居点道路前，请备好食物、备用工具和回家路线。Sophisticated Backpacks 可以携带物资，但不能帮你挑选。"
		"为真正的旅行打包，然后标记这节课。离开后的第一个晚上再检查一次你的背包。"
	]
	quest.2FB7F5E0A97A788F.title: "普通商店"
	quest.2FB7F5E0A97A788F.quest_desc: [
		"为社区商店提供用于存放食物、材料和应急装备的整洁货架。只有当人们能轻松找到所需物品时，共享箱子才有用。"
		"设置或协助维护一个带标签的商店，并标记笔记。将稀有任务物品存放在公共溢出区之外。"
	]
	quest.7E41E7693A9FE9BB.title: "一片永不枯萎的田野"
	quest.7E41E7693A9FE9BB.quest_desc: [
		"种植适合当地季节和饮食计划的作物。当田地繁荣时，宁静的季节会发生变化。"
		"收割并重新种植一次，然后标记课程。农场是一个循环，而非单次收获。"
	]
	quest.3B6A81473DBCBAD0.title: "奇怪的种子"
	quest.3B6A81473DBCBAD0.quest_desc: [
		"神秘农业提供了从农田到特殊材料的一条较慢路线。在规划稀有精华生产前，先使用 Inferium 吧。"
		"携带一个 Inferium Essence 以记录此可选农业路线。"
	]
	quest.57DB451615E97ED3.title: "垂钓者工具包"
	quest.57DB451615E97ED3.quest_desc: [
		"更好的鱼竿能让补给之旅更可控。投入资源前，先比较水产养殖装备和常用渔具。"
		"带上铁质鱼竿来完成这个可选的装备课程。"
	]
	chapter.0AF350979D5231A0.title: "神秘装备 (Arcane Gear)"
	quest.478F58F2DC207638.title: "用意图进行附魔"
	quest.478F58F2DC207638.quest_desc: [
		"当更强的敌人存活更久时，装备就很重要了。从普通的附魔台和一件普通的装备开始吧。"
		"先准备好附魔台，再查看可用的附魔，不要浪费等级或稀有材料。"
	]
	quest.2B892EC797B9569F.title: "一个能用的图书馆"
	quest.2B892EC797B9569F.quest_desc: [
		"Apothic Enchanting 改变了书架对附魔台的贡献。放置一个基础书架，再检查附魔界面。"
		"放置一个书架以完成任务。在扩建前，请先了解已安装设备显示的实际范围。"
	]
	quest.3EC505AB08DE0E6E.title: "更大的桌子 (The Greater Table)"
	quest.3EC505AB08DE0E6E.quest_desc: [
		"阿波提奇附魔台开启了更高级的装备制作。只有在有足够等级和升级理由时才建造它。"
		"把桌子拿过来，和普通的工作台比较一下。"
	]
	quest.02F5F221B3B1F7AF.title: "阅读附魔效果"
	quest.02F5F221B3B1F7AF.quest_desc: [
		"Apothic Enchanting 揭示了 Eterna、Quanta 和 Arcana。检查你的书架如何影响供应，不要总以为越多越好。"
		"选择一个你理解的变化，进行安全测试，并标记此课程。屏幕上的数值即为权限。"
	]
	quest.62F29A6FBF60395F.title: "适合这项工作的人选"
	quest.62F29A6FBF60395F.quest_desc: [
		"为特定威胁准备工具、武器或盔甲。将附魔与你实际使用的技能相匹配。"
		"带上做好的装备去一次遭遇战或探险，然后记下哪些有效，哪些仍需改进。"
	]
	quest.19DDA90DDF380C88.title: "一个可镶嵌的机遇"
	quest.19DDA90DDF380C88.quest_desc: [
		"Apotheosis 宝石提供了另一条获取特殊装备的途径。在使用贵重物品前，请先查看宝石的附加属性和镶嵌规则。"
		"带上一个宝石来记录这条路线。合适的搭配比填满所有格子更重要。"
	]
	quest.7D81F16022C42BEA.title: "小心重铸 (Reforge with Care)"
	quest.7D81F16022C42BEA.quest_desc: [
		"简易重铸台可以改变装备的特性。请先了解材料和稀有度成本。"
		"带上工作台来完成这个可选的工坊课程。实验时留个可靠的备用工作台。"
	]
	quest.7D080E2BD469A0FE.title: "一件文物的故事"
	quest.7D080E2BD469A0FE.quest_desc: [
		"Ancient Artifacts and Curios 添加了普通盔甲槽位之外的装备选择。查看一件遗物的描述及其所需的插槽。"
		"与你的当前装备对比后标记。寻找物品是另一场冒险。"
	]
	quest.42802FC4D803E99E.title: "狩猎开始前"
	quest.42802FC4D803E99E.quest_desc: [
		"在跟随Boss Fieldbook的线索前，请检查路线、抗性、逃生物资和失败的成本。"
		"在准备与命名生物遭遇后标记。做好准备比过早击杀更重要。"
	]
	chapter.0323F35742DDAB7F.title: "边境与其他王国 (Borders and Other Realms)"
	quest.0BDB2BDCCF7AEFEB.title: "标记路线"
	quest.0BDB2BDCCF7AEFEB.quest_desc: [
		"地图上的每个边界都各不相同。标记你的家、一个安全的返回点，以及你打算探索的第一个远方地点。"
		"旅行前请记录路线。在死亡或长时间离开后，路标仍然有效时最为有用。"
	]
	quest.5EE428F5EEB9C1AB.title: "穿越下界 (Across the Nether)"
	quest.5EE428F5EEB9C1AB.quest_desc: [
		"下界是危险的捷径，也是稀有材料的来源。带上方块、食物和辨别返回传送门的方法。"
		"进入下界即可完成此任务。确保有退路后再决定要推进多远。"
	]
	quest.1BFB435A71955168.title: "携带报告返回基地 (Return with a Report)"
	quest.1BFB435A71955168.quest_desc: [
		"从边境之外带回有用的东西：资源、路线或警告。告诉下一个旅行者发生了什么变化。"
		"安全返回并记录一项具体发现后标记。探索应为所有人改善地图。"
	]
	quest.49E7D51810B7C698.title: "以太维度"
	quest.49E7D51810B7C698.quest_desc: [
		"以太需要不同的移动和生存方式。学习进入路线，并携带坠落恢复的方法。"
		"进入以太即完成此可选调查。那里的生物和地牢可以等装备更好的时候再去。"
	]
	quest.40C378499CCD5B3F.title: "暮色森林（The Twilight Forest）"
	quest.40C378499CCD5B3F.quest_desc: [
		"暮色森林有其独特的地标和首领进阶路线。在前往巢穴前，先探索第一个安全区域。"
		"进入森林即完成此可选调查。利用当地的线索寻找下一个目的地。"
	]
	quest.1A0C9B181EC116F5.title: "The Otherside"
	quest.1A0C9B181EC116F5.quest_desc: [
		"异次元不适合初次探索。了解其传送门要求并保持清晰的撤退计划。"
		"进入该维度即完成此可选调查。在追逐稀有奖品前，请先收集信息。"
	]
	quest.33724D4C4AA70A08.title: "一个独立的地下城"
	quest.33724D4C4AA70A08.quest_desc: [
		"Dimensional Dungeons 将挑战与常规世界隔离。打包好物品，约定好汇合点，开始封闭探险。"
		"进入其维度即完成此可选调查。探险队在返回家园时才算完成。"
	]
	quest.40C7D8CBB91347E8.title: "更强大的搜索功能"
	quest.40C7D8CBB91347E8.quest_desc: [
		"当整合包启用兼容版本时，自然指南针和探险指南针可以帮助定位生物群系和结构。"
		"如有可用工具，请使用，否则标记手动搜索路线。完成战役无需任何指南针。"
	]
	quest.67D0F8E866E2329B.title: "活体地图 The Living Map"
	quest.67D0F8E866E2329B.quest_desc: [
		"Xaero's maps 可以在不同行程间保存探索成果。区分公共路线和私人标记，并查看团队共享的路点。"
		"旅行结束后更新一个路点，并标记此笔记。像“危险”这样的名称，附上原因会更有用。"
	]
	quest.7E0FFBF2ECB4E307.title: "一个值得命名的地标性建筑"
	quest.7E0FFBF2ECB4E307.quest_desc: [
		"使用Boss Fieldbook或结构罗盘，定位与未来冒险相关的地标。记录其接近路线和最近的的安全停靠点。"
		"在地图上标记该地点。你无需进入或击败其中的居民。"
	]
	chapter.601B56C344EAF75A.title: "公会田野工作"
	quest.23A10A45DCF99178.title: "接受一个委托任务"
	quest.23A10A45DCF99178.quest_desc: [
		"战役可以指引你走向工作，但公会的名声是靠人们的实际行动赢得的。选择一个定居点或旅行团中尚未满足的需求。"
		"写一个具体目标、一个地点，以及完成标志。保持足够小，可以完成。"
	]
	quest.2EB4FB7E36227D42.title: "准备队伍"
	quest.2EB4FB7E36227D42.quest_desc: [
		"商定物资、路线和返程负责人。使用适合你世界的队伍和认领工具。"
		"团队有计划后标记此项。独行旅者也可为自己做相同准备。"
	]
	quest.77A55458F0F707C8.title: "完成工作"
	quest.77A55458F0F707C8.quest_desc: [
		"完成你选择的委托：运送材料、清理路线、修复工坊、绘制危险区域地图，或带回探险发现。"
		"完成后再勾选此项。任务由你自行报告，可以想出比固定清单更好的委托。"
	]
	quest.4701F35DAD8E7037.title: "报告归来"
	quest.4701F35DAD8E7037.quest_desc: [
		"返回需要这项工作的个人或地点。说明你已完成的内容、剩余事项以及发现的新风险。"
		"报告后标记。一个完成的任务应该让世界比之前更清晰易懂。"
	]
	quest.23E13CDF93C7F47F.title: "下一份契约"
	quest.23E13CDF93C7F47F.quest_desc: [
		"再次打开冒险者公会公告板。将上面的委托与你旅途中发现的所需进行比较。"
		"选择你的下一个项目并标记课程。书本在此结束，但公会和世界不会。"
	]
	quest.1533F463672EB056.title: "一张田野照片"
	quest.1533F463672EB056.quest_desc: [
		"曝光可以将建筑、定居点或奇遇变成值得分享的记录。当场景本身重要时，带上相机。"
		"此任务会检查相机。拍照属于你自己的可选实地考察。"
	]
	quest.415CE02C608AF439.title: "清晰沟通"
	quest.415CE02C608AF439.quest_desc: [
		"简易语音聊天可以帮助团队协调，但这需要全队的同意和可用的麦克风设置。"
		"如果大家都想用，可以试试简短通话。语音不可用时，文本和路径点仍然有效。"
	]
	quest.110DD29C3D545D7F.title: "声音与技能"
	quest.110DD29C3D545D7F.quest_desc: [
		"可选的 TenSura 语音包扩展能识别技能名称。请在战斗中使用前检查其监听状态、别名和麦克风权限。"
		"如果已启用附加包，请尝试一条无害命令，然后标记该课程。进度提升从不要求语音输入。"
	]
	quest.41AFD4CA244CE2B4.title: "一份公共记录"
	quest.41AFD4CA244CE2B4.quest_desc: [
		"收集一份地图、照片、书面警告或物资清单，帮助其他玩家了解你的路线。"
		"将唱片放置或分享到团队存放报告的地方，然后标记该笔记。"
	]

    quest.5DB71814C8B7E942.title: "公会情报档案袋"
    quest.5DB71814C8B7E942.quest_desc: [
        "用一本书、一个指南针和一张纸制作公会情报档案。右键点击它以查看你的发现和已记录的Boss胜利。"
        "报告记录了你在远古森林和迷宫中的探索，以及对元素巨像、兽人灾难和卡律布狄斯的胜利。"
        "成为真英雄或真恶魔领主后，查阅档案以提出定居请求。"
    ]
    quest.3F4D168F4F2D3B97.title: "编年史中的一个位置"
    quest.3F4D168F4F2D3B97.quest_desc: [
        "觉醒将通过它所影响的人们成为世界历史的一部分。成为真英雄或真恶魔领主后，将32个面包和12个铁锭带到有人居住的MCA村庄。"
        "在主背包中备齐物资，潜行状态下用公会情报档案右键空气。村庄会记录你的援助，并奖励四颗绿宝石和一封感谢信。"
        "在那里阅读村庄编年史以查看条目。每个角色只能回应一次此后续请求。"
        "此任务会根据已完成的交付记录自动更新。FTB团队成员共享任务完成进度，但每个角色保留自己的交付和觉醒记录。"
    ]
    task.4E9D44B91DC4BF29.title: "完成一次觉醒救援物资的运送"
}
