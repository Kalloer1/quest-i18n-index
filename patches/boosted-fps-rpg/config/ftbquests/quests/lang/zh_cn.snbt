	quest.5EEE998CEAB83E76.title: "机械时代"
	quest.5FAA199278D1196B.quest_desc: [
		"Transmog 可以让你在不改变物品行为的情况下，改变它们的外观！"
		"适用于盔甲、武器、工具以及你能想到的任何东西！"
	]
	quest.5FCCD3FBAB7A1966.quest_desc: ["模组服务器有时会遇到掉落物品5分钟后不消失的问题。这会导致实体过多，造成服务器不必要的卡顿。本简易模组旨在每10分钟清理一次掉落物品，以解决此问题。在大量玩家掉落未消失的物品、导致实体卡顿的重度模组环境中，此功能尤为实用。清理地面物品前10分钟和1分钟会显示警告信息。"]
	quest.6001AADC6A5656DE.quest_desc: ["……嗯，让我想想"]
	quest.60B4411303D13FBC.quest_desc: [
		"合金锻造能让你从矿石中获得更多材料。"
		""
		"锻造炉有3个等级，是一个多方块熔炉。制作方法见下一页"
		""
		"{@pagebreak}"
		"底部向上，X = 方块，0 = 空气，1 = 锻造台"
		""
		"xxx   0x0   0x0"
		"xxx   x0x   x0x"
		"xxx   010   0x0"
		""
		"只要中间是空的，空气间隙也可以是方块"
	]
	quest.60B4411303D13FBC.title: "合金锻造"
