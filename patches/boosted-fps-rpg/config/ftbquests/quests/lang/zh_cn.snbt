	quest.7F528EB8884937D0.quest_subtitle: "苦力怕？天哪，真倒霉"
	quest.7F5C539D7294EF6B.quest_desc: [
		"飞不起来的翅膀对我们毫无用处，要是把它们做成真正的翅膀会怎样"
		""
		"你感觉飞行会很快消耗饥饿值，而且穿重甲时毫无用处"
		"最好多储备些食物，并用羽毛之轻附魔你的重型盔甲"
	]
	quest.7F5C539D7294EF6B.title: "假翅膀"
	quest.7F9126A078D5F7A8.quest_desc: ["与吸血鬼代表交谈，并达到吸血鬼领主5级"]
	quest.7F9126A078D5F7A8.title: "达到最终的吸血鬼领主等级"
