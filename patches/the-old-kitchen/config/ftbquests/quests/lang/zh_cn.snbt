	quest.40BFB617AA82DF9E.quest_desc: [
		"Mythic Metals 需要独特的矿石处理方法——一种特殊的组合式熔炉。使用新增的矿石，玩家可以打造出属性增强且带有独特效果的武器和盔甲。"
		""
		"图中是一个可工作的合金熔炉——它由一个“控制器”和16个与控制器类型匹配的方块构成。"
		""
		"注意，中心部分（3x3底座上方）是中空的。"
		""
		"燃料可从控制器左侧自动输入，可冶炼物从右侧，输出在底部（是的，连接到砖块，不是控制器）"
		""
		"{image:kubejs:textures/quests/alloy1.png width:100 height:100 align:center}"
	]
	quest.40BFB617AA82DF9E.quest_subtitle: "你需要矿石图表。"
	quest.41EBC67E5D5540B0.quest_desc: [
		"Assembler Matrix 是一种威力惊人的多方块结构。一旦建成，它将取代你拥有的所有分子合成器和模式提供器，但连接在其他机器上的除外。"
		""
		"要建造Assembler Matrix，先放置68个Assembler Matrix Frame，形成一个空心框架（结构为7x7x7）。然后用150个Assembler Matrix Glass &e（或你喜欢的墙壁）&r覆盖所有六个侧面。最后，将Assembler Matrix Pattern和Craft Core放入立方体内部。据我所知（我毕竟是人类），只要框架搭建正确，立方体内部物品的放置方式没有“正确”或“错误”之分。"
		""
		"此任务仅为&n建议。&r你可以替换部分组件——添加更多模式核心、更多工艺核心，或者干脆缩小规模——但这建议的装配矩阵尺寸最大。"
	]
	quest.422E6704C1B52FA0.title: "防御地堡"
	quest.42EEC34EC9F17719.quest_desc: [
		"“Artifacts” 模组的奇物，如果有重复或不想要的，可以重新生成！"
		""
		"将任意两个遗物在合成台或背包的合成台中相邻放置，然后重掷！"
	]
