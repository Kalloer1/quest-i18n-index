	quest.537C1B018BD38ADF.quest_desc: [
		"1. 使用挤出机制作正岩"
		"2. 将正岩块粉碎或研磨成粉"
	]
	quest.5526976D71488B3B.quest_desc: ["其中一些人会出售非常强大的盔甲和工具！留意这些传奇的交易吧！"]
	quest.5738FA41517D6A26.quest_desc: [
		"1. 使用挤出机制作鹅卵石"
		"2. 将鹅卵石粉碎成砾石"
		"3. 将砾石磨成燧石"
		"4. 导管渠道燧石（查看导管笼！）"
		"5. 将棱镜岩碎片合成或堆叠成棱镜岩方块"
		"6. 粉碎棱镜岩方块"
	]
	quest.5783AD286FC214EE.quest_desc: ["这些背包可以装备在胸甲栏位或“背部”奇物栏位，采用基于等级的升级系统，每次升级都会提供更多空间和更多增强槽位。"]
	quest.5783AD286FC214EE.quest_subtitle: "所有探险家都必备的道具！"
	quest.5840F4D7D45678D2.title: "农场 III"
	quest.587E2C87C7957E4C.quest_desc: ["用Tropicraft制作任意沙滩椅，再用本任务的材料制作一杯Piña Colada，在日落时分坐在椅子上品尝吧！"]
	quest.594AF1337BF681C3.quest_desc: ["Deep Seas 整合了 Aeronautics 的物理系统，为深海潜水添加了压力和氧气等要素！"]
	quest.594AF1337BF681C3.quest_subtitle: "潜艇！Submarines!"
	quest.5989303C3B3E38A0.quest_subtitle: "Not a deal!"
	quest.5989303C3B3E38A0.title: "Applied Energistics 增强包"
	quest.5A75218F1ED2E1E7.quest_desc: ["基于Sculk的升级，由Create提供动力！"]
	quest.5A75218F1ED2E1E7.quest_subtitle: "不要和 Deeper and Darker 搞混了！"
	quest.5B5421767D42606D.quest_desc: ["在世界上添加了超多有趣的生物！"]
	quest.5B84B0A35486E520.quest_desc: [
		"这些模组添加了与 Create 互补的机器。"
		""
		"Applied Energistics 是最好的存储模组，自动化合成也总是很有用。"
		""
		"PneumaticCraft 为某些物品的制作增添了有趣的选项。"
		""
		"EnderIO 添加了急需的物品导管，并为许多机器提供了基于能量的替代方案。"
	]
	quest.5B84B0A35486E520.title: "和创造模式无关！"
	quest.5BDAB8172B4A17AC.quest_desc: ["使用巨型火把阻止生物在较大范围内生成，并使用野性火焰灯笼在同样较大的范围内放置魔法光源。"]
	quest.5BDAB8172B4A17AC.quest_subtitle: "停止生物生成！"
	quest.5BEB12F4CD6C9D66.quest_desc: [
		"如果你没听说过，Applied Energistics 最基本的功能就是让你在计算机里存储、取用和制作物品。"
		""
		"本整合包已配置，上述机器仅需单个大型水车（带增压以应对全负荷）和一台发电机（约15RF/t！）即可运行。"
	]
	quest.5BEB12F4CD6C9D66.quest_subtitle: "所有这些存储空间都掌握在我的手中"
	quest.5C1612A298872EE6.quest_desc: ["压力产生电力？电力产生压力？太棒了！"]
	quest.5C1612A298872EE6.quest_subtitle: "简单的力量！"
	quest.5EA9C5CC95A1123B.title: "酒馆"
	quest.60009BEDAC0F41FE.quest_desc: [
		"给你的宠物装备上箱子，随时随地存储更多物品！"
		""
		"宠物死亡后，只要它能重生，背包里的物品会保留下来。"
	]
	quest.600354FE6825A94E.quest_subtitle: "好多新食物！"
	quest.606A8766A7689576.quest_desc: ["世界各地有许多有趣的生物等你发现，还能和老朋友一起做些新事情！"]
	quest.606A8766A7689576.quest_subtitle: "看来老狗还是可以学会新花样的嘛。"
	quest.62DA3FB81E90FCFA.quest_desc: [
		"金钱可以通过开箱、完成&l&4悬赏&r和&l&a赌博！&r每小时还会获得少量津贴。"
		""
		"要开始，请访问任务书的购物和悬赏部分。"
	]
	quest.68B8292CD351B242.quest_desc: ["过山车？！2026年简直疯了。"]
	quest.68B8292CD351B242.quest_subtitle: "谁还需要铁路工艺模组呢？"
	quest.68CBD674EFADF233.quest_subtitle: "...不是你召唤出来的这个东西吗？"
	quest.68CBD674EFADF233.title: "保卫村庄免受掠夺者袭击"
	quest.68D28BA30F1D60CA.quest_desc: ["新的农场方式！"]
	quest.68D28BA30F1D60CA.quest_subtitle: "再也没有游荡的动物了！"
	quest.68EB4D10ECA66D18.quest_desc: ["或者10个普通守卫！"]
	quest.6994DC75869106EA.title: "击杀你的第一只凋零 (Wither)"
	quest.69B6CAC27E2B3E65.quest_desc: [
		"和村民们进行交易吧！"
		""
		"我们想过要为此添加一个流程，但是……当替代方案如此简单时，谁会去费心呢？"
	]
	quest.69B6CAC27E2B3E65.title: "Emerald"
	quest.6AA699028EA00ECF.title: "机械塔 Machinery Tower"
	quest.6AE6358547E1A03D.title: "击杀终结者（The Obliterator）"
	quest.6D56ACE9D9940F46.quest_desc: [
		"1. 使用挤出机制作花岗岩"
		"2. 将花岗岩粉碎或研磨成粉"
	]
	quest.6D56ACE9D9940F46.title: "铀矿"
	quest.6E727116C84C1745.quest_desc: ["结交机器人朋友，让它们来帮助你吧！"]
	quest.6E727116C84C1745.quest_subtitle: "为什么蜘蛛会有一辆坦克呢？"
	quest.6E727116C84C1745.title: "创造：生物机械学 (Bionics)"
	quest.709C28AC010A07A0.quest_desc: ["这个模组有我最喜欢的物品：Stock Export Bus。它还有其他好东西（比如量子计算机多方块！），但只要有那个，我就心满意足了。"]
	quest.709C28AC010A07A0.quest_subtitle: "没有它我可活不下去！"
	quest.714C3223DE897523.quest_desc: ["使用带有特殊焦点的法杖和权杖来施放法术和召唤亡灵！"]
	quest.714C3223DE897523.quest_subtitle: "亡灵魔法！"
	quest.728BA41E87DED7C3.title: "现代 III"
	quest.738D738D668C697F.quest_desc: ["我完全不知道这个模组有什么用。祝你好运！"]
	quest.738D738D668C697F.quest_subtitle: "好的威尔，我已经加进去了。"
	quest.742B5B00BE0155D2.quest_desc: [
		"量子计算机是一个难以置信的强大多方块结构。一旦建成，它将毫无疑问地取代你拥有的所有合成CPU。如果你不明白原因，建议你阅读一下该多方块各组件（列于此任务的要求中）的作用。"
		""
		"要建造量子计算机，先放置218块量子计算机结构玻璃作为框架（结构为7x7x7）。然后将其他所有东西都放在里面。据我所知（我毕竟是人类），只要玻璃在最外层，立方体内部物品的放置方式没有“正确”或“错误”之分。"
		""
		"此任务仅为&n建议。&r你可以更换部分组件，增加加速器、增加存储，或者干脆缩小规模——但这才是我对最大尺寸计算机的建议。"
	]
	quest.748F8ABF5F2BBC19.quest_desc: ["用这个方便的新工具来查看你马的统计数据吧！"]
	quest.74D8BF2B9B944808.quest_desc: ["Ender IO 现已全面回归，并带来了功能强大的机器套件，用于处理材料并提升生活质量。"]
	quest.74D8BF2B9B944808.quest_subtitle: "我想念你了。"
	quest.75591CEFD267F573.quest_desc: [
		"购买预制件，预览内容，然后在合成台放置以退款！"
		""
		"所有预制建筑购买均可重复，所以别担心误卖了想保留的东西！"
		""
		"另外，Applied Energistics 入门套件是一项超值的（一次性）优惠！"
		""
		"需要更多钱吗？查看&l&4Bounties&r任务书中的信息！"
	]
	quest.75591CEFD267F573.quest_subtitle: "经济适用房？在这种经济状况下？"
	quest.75C46BD3D5CB2844.quest_subtitle: "一个隐藏的任务？"
	quest.776E28E9909926A8.quest_desc: ["重制你的附魔，并从找到的装备上偷走附魔！"]
	quest.776E28E9909926A8.quest_subtitle: "名字里有一个连字符的模组"
	quest.776E28E9909926A8.title: "附魔分解台"
	quest.77F35B70673488BB.quest_desc: [
		"0. 自动化一些获取木炭的方法。除了树木，本整合包还添加了海带和竹子作为选项！"
		""
		"1. 将木炭压碎或磨成粉"
		"2. 使用 Spout 将水应用到 Create Nuclear 的 \"Coal Dust\" 上"
		"3. 将水煤尘放入机械压机中进行压制"
		"4. 重复步骤2和3，直到完成"
	]
	quest.77F35B70673488BB.quest_subtitle: "你有一个树木农场，对吧？"
	quest.77F35B70673488BB.title: "煤炭"
	quest.7952EB2B5F4F3E29.quest_desc: [
		"Starcatcher 是一个围绕钓鱼展开的大型模组。"
		""
		"原版钓鱼被替换成了小游戏（不，这可不是《星露谷物语》的钓鱼），所有鱼和钓鱼奖励也都被重做了。快来试试吧！"
	]
	quest.7952EB2B5F4F3E29.quest_subtitle: "钓鱼大改版！"
	quest.799849979691DCAC.quest_desc: ["谁会不喜欢一片葡萄园呢？"]
	quest.799849979691DCAC.quest_subtitle: "足球妈妈们超爱这个！"
	quest.79EB033DADF2CC7F.quest_desc: ["使用挤出机！"]
	quest.79EB033DADF2CC7F.title: "黑曜石"
	quest.7A8B9AEEA358E7CD.title: "击杀一个湮灭追踪者"
	quest.7C07BA85C2F3164F.quest_desc: [
		"Better Archaeology 添加了新的可探索结构、挖掘文物的刷子，以及新的待发现文物！"
		""
		"请确保已启用可疑沙子的资源包！"
	]
	quest.7D354B9CC5FAFDAF.quest_desc: [
		"轻松自动化并循环村民交易！"
		""
		"如果村民交易循环按钮没有出现，请进入键位设置，为其分配一个方便的按键。无论按钮是否显示，它都会重新刷新！"
	]
	quest.7D354B9CC5FAFDAF.quest_subtitle: "盒子里的小家伙！"
	quest.7FAE8F8336EF42EE.quest_desc: ["除了这里列出的“实用”模组外，该整合包还包含大量添加家具的其他模组！"]
