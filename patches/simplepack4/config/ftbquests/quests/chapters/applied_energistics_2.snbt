					id: "04731B877AA067A3"
					type: "xp"
					xp: 10
				}
			]
			shape: "hexagon"
			size: 1.5d
			subtitle: "虚拟存储系统"
			tasks: [
				{
					id: "43FD619EF9A41E76"
