	quest_links: [ ]
	quests: [
		{
			description: [
				"其实这一章节和下一章节的部分内容并不必须和村民交易。"
				"你可以像正常空岛生存一样，找群系搬草方块刷动物，建刷鱼场，或者靠刷怪塔刷土豆胡萝卜，这些都可以。"
				"就是没有村民交易那么方便……"
			]
			id: "1A2D61B12E7C1414"
			tasks: [{
				id: "0A929C61173CACEE"
				title: "开启第一章"
				type: "checkmark"
			}]
			x: -8.0d
			y: -0.5d
		}
		{
			dependencies: ["1A2D61B12E7C1414"]
			description: [
				"进入新章节后，为了继续提升声望，必须在菜单中推出新品。"
				"具体来说，菜单中至少需要包含&e三种&r该章节的食材，才能在该章节继续提升声望。"
			]
			id: "261FE9E59C62CC17"
			rewards: [{
				count: 8
				id: "0BF81373822B1B2D"
				item: "minecraft:copper_ingot"
