	quest.1B60612EED075A0B.quest_desc: [
		"/kickme - 将自己从服务器踢出（以防床虫再次出现）"
		""
		"/trashcan - 打开一个物品栏，将物品放入并关闭后，物品将被删除"
		""
		"/back - 传送至之前的位置。可多次使用"
		""
		"/spawn - 将你传送至出生点"
		""
		"/rtp - 将你传送至世界中的随机位置，并尝试寻找一个非海洋的安全着陆点"
		""
		" "
		""
		"/home [名称] - 传送至一个家园"
		""
		"/sethome <名称> - 设置家园"
		""
		"/delhome <名称> - 删除一个家园"
		""
		"/listhomes [玩家] - 列出所有玩家的家园"
		""
		" "
		""
		"/warp <name> - 传送至一个传送点"
		""
		"/setwarp <name> - 设置传送点"
		""
		"/delwarp <name> - 删除一个传送点"
		""
		"/listwarps - 列出所有传送点"
		""
		" "
		""
		"/tpa <player> - 请求传送至玩家处"
		""
		"/tpahere <player> - 请求玩家传送至你处"
		""
		"/tpaccept <id> - 接受请求（屏幕上会出现一个按钮）"
		""
		"/tpadeny <id> - 拒绝请求（屏幕上会出现一个按钮）"
	]
	quest.1B60612EED075A0B.quest_subtitle: "/ 命令"
	quest.1B8681DDE6F76349.quest_subtitle: "&f你之后会需要另一个"
	quest.1C3AB3F8D73076FD.quest_desc: [
		"&f&l位置：位于寒冷/苔原生物群系中的高大黑暗塔楼内。"
		""
		"任务描述：一个骸骨恐怖生物正在冰冻荒原上收集灵魂。找到苔原中那座腐朽的塔楼，并使用灵魂之星召唤这名巫妖。务必小心，它不会轻易交出它的力量。"
	]
	quest.1C3AB3F8D73076FD.quest_subtitle: "&0&l灵魂收割暴君"
	quest.1C3AB3F8D73076FD.title: "&4&l暗夜巫妖"
	quest.1D097FFFEA42CAD4.quest_desc: [
		"&5&l精通会被动获得"
		""
		"&0&l被动"
		"[被动 - 切换] 死亡馈赠 - 击杀敌人后，获得其 4% 的 EP。其中 2% 为魔力粒子，2% 为气场。此效果可与普通玩家击杀怪物时获得的 3% 基础值叠加，总计获得 7%。"
		""
		"[被动 - 槽位] 装备破坏 - 用户的攻击会被动地对护甲耐久造成双倍伤害。针对用户的攻击会消耗其武器两倍的耐久。"
		""
		"&0&l主动"
		"[主动 - 按压] 钻石身躯 - 激活后，会暂时赋予使用者一层护甲以及**物理伤害（手、剑、矛、斧）增益。该增益根据使用者当前的最大 EP 进行缩放，激活时不消耗任何 EP："
		""
		"攻击伤害（精通时 x2）：基础 5，之后每 40k EP 额外增加 1（最高不超过 2M EP）"
		""
		"护甲：每 20k EP 增加 1（最高不超过 2M EP）"
		""
		"速度：每 25k EP 增加 0.01（最高不超过 1M EP）"
	]
	quest.1D097FFFEA42CAD4.quest_subtitle: "&f用法"
	quest.1D097FFFEA42CAD4.title: "&f&l狂战士"
	quest.1D1B43355D795DB5.quest_desc: ["一次高速的爆发式冲刺。极高的移动速度和突然的位移对于躲避大范围的技能至关重要。"]
	quest.1D1B43355D795DB5.title: "&f&l燃烧冲刺"
	quest.1D5D9315C13C65DC.quest_desc: ["这些首领结构会生成首领。击杀后，它们将在一小时后重生。"]
	quest.1D5D9315C13C65DC.quest_subtitle: "&f&l重要"
	quest.1D5D9315C13C65DC.title: "&f&0首领结构"
	quest.1E0102F2A5597E31.quest_desc: [
		"&0&l被动"
		"[被动 - 切换] 本能闪避：20% 的几率自动闪避近战攻击。100% 的几率自动闪避投掷物（箭、手里剑等）。"
		""
		"[被动 - 此模式下处于槽位中] 危险感知：与危险感应类似。"
		""
		"&0&l主动"
		"[主动] 存在感感知：长按时，将使用者的存在感等级提升 1，存在感距离提升 20 个方块。若在潜行状态下激活，则循环切换可用的存在感感知模式："
		"--全部：与任何“存在感”能力一样——以蓝色高亮显示感知范围内的所有生物，包括隐形生物或处于隐匿效果下的生物。"
		""
		"--怪物：以特定颜色高亮显示感知范围内的所有怪物：[中立：黄色，敌对：红色]"
		""
		"--陷阱：以红色高亮显示感知范围减半区域内的所有陷阱方块。[陷阱方块：熔岩、尖刺滴水石、绊线、潜声传感器、潜声尖叫者、蜘蛛网、粉雪、陷阱箱、TNT、TNT矿车、末影水晶]。"
		""
		"--宝藏：需掌握该能力后可使用，以金色高亮显示感知范围减半区域内的所有宝藏方块。[宝藏方块：箱子、木桶、金库、龙蛋、远古残骸和魔法矿石、卡律布狄斯核心]。"
	]
	quest.1E0102F2A5597E31.quest_subtitle: "&f用法"
	quest.1E0102F2A5597E31.title: "&f&l观察者"
	quest.1E29A3B193EEEE67.quest_desc: [
		"在两名玩家之间安全、稳妥地交换物品。只需右键点击对方（请确保双方都空手），界面便会打开。"
		""
		"点击中间的“准备就绪”按钮（交叉箭头符号），表示你已确定自己的交易内容。当两名玩家都这样做后，交易即可完成。"
		""
		"也可以使用 /playertrade <playername> 命令，实现无限距离交易。"
	]
	quest.1E29A3B193EEEE67.quest_subtitle: "安全交易"
	quest.1E29A3B193EEEE67.title: "&f&l玩家交易"
	quest.1E71DE4AF71E187A.title: "收集"
	quest.1EA65BE4E103D8C9.quest_desc: [
		"&6&l1% 掉落几率"
		"击杀一只蛇发女妖"
		""
		"&6&l25% 掉落几率"
		"击杀一只龙蜥"
		""
		"&6&l50% 掉落几率"
		"击杀末影龙 / 4 级及以上等级的龙"
		""
		"&6&l100% 掉落 1 - 3 个"
		"击杀卡律布狄斯"
	]
	quest.1EA65BE4E103D8C9.quest_subtitle: "&f获取方式"
	quest.1EA65BE4E103D8C9.title: "&f&l龙之精华"
	quest.1ED791412D92D1E1.title: "&f&l获取一个中等火焰之灵"
	quest.1EFB5EDF824B92FB.title: "&f&l最终飞升：世界级"
	quest.1F60B26938D69AC5.quest_subtitle: "如果你没有实体，或想要一个更耐用的容器，那么这个东西（及其变体）会非常有用"
	quest.1F60B26938D69AC5.title: "没有身体也不怕"
	quest.1F9B68AA0A4F7789.quest_desc: [
		"&0&l被动"
		"[被动，真实] 九条命："
		"如果世界设置为硬核模式，玩家最多可以重生九次。使用 /tensura get ability check mysticism:schrodinger 查看当前剩余生命数。"
		""
		"[被动，真实] 生死抉择："
		"当使用者死亡时，有 50% 的几率不会损失能量（以及灵魂）。"
		""
		"[被动，可切换] 猫科本能："
		"玩家的安全坠落距离增加了 32 个方块。这意味着你需要坠落 32 个方块后，才会开始受到半颗心的坠落伤害，以此类推。"
		""
		"[被动，置于物品栏] 毒触："
		"攻击敌人时，为目标施加中毒 II。达到精通后，此效果将变为致命中毒 II。"
	]
	quest.1F9B68AA0A4F7789.title: "&f&l薛定谔"
	quest.2067DCE7C01C8F9E.quest_desc: [
		"与研究员相同，但可以存储雕文[1]，并能从附魔或雕纹装备上获取附魔。此外，物品在空间存储中可堆叠至 256 个。所存储附魔的最高等级可比附魔上限高出 2 级。"
		""
		"即锋利度 7，而原版为锋利度 5（需要拥有相应附魔的书籍或物品才能在该等级进行存储）。"
	]
	quest.2067DCE7C01C8F9E.quest_subtitle: "&f用法"
	quest.2067DCE7C01C8F9E.title: "&f&l神级工匠"
	quest.2090E1EA65B198ED.quest_desc: ["达到 F 级将解锁商店。"]
	quest.2090E1EA65B198ED.quest_subtitle: "我能证明自己吗？"
	quest.2090E1EA65B198ED.title: "&f&l成为 F 级"
	quest.20D8EC32F0219F3C.quest_desc: [
		"&0&l被动"
		"[被动，切换] 涡轮烈焰 - 将所有火焰类攻击的伤害提高 2 倍。可与火焰操控和火焰支配叠加。"
		""
		""
		"&0&l主动"
		"[主动，按下] 蓝色耀斑 - 激活后，用户会将自己注视的区域笼罩在蓝色火焰中，只要目标留在其中就会持续造成 60 点伤害。命中时会生成一个 20x20 的区域。冷却时间为 10 秒，掌握后可缩短至 5 秒。使用消耗 400 点法力值。"
		"[主动，按下] 融合耀斑 - 使用消耗 400 点法力值。用户向注视处挥出一道巨大火焰，灼烧所有被困其中的目标，并将它们拉向火焰中心，每秒造成 40 点火焰攻击伤害，持续 5 秒。"
		"如果用户在该槽位拥有独特技能 [Zekrom]，则额外召唤闪电劈向用户的目标，造成 40 点电属性伤害；若发生此效果，消耗将增加至 700 点法力值。20 秒冷却时间"
		""
		"[主动，按下] 龙之流星 - 使用消耗 400 魔力。用户借助龙之力形成一颗流星并将其从天上引下，砸向目标区域，造成 70 点魔法伤害，摧毁周围的方块并将所有物体击退。20 秒冷却时间。"
		"[主动，按住] 火焰喷射 - 激活期间每秒消耗 70 魔力。效果与火焰吐息类似，但每秒造成 30 点火焰伤害。"
	]
	quest.20D8EC32F0219F3C.title: "&f&lReshiram"
	quest.213FDE17BA15A628.quest_desc: [
		"&f&l位置：生成于世界底部的稀有地下结构（靠近基岩的深层洞穴）中。"
		""
		"任务描述：在世界深处的根系之中，一株寄生植物以虚空能量为食，变得愈发肥硕。跟随虚空百合前往最深层的洞穴，找到它的巢穴，并在它的尖刺吞噬基岩之前将其斩断。"
	]
	quest.213FDE17BA15A628.quest_subtitle: "&0&l深渊疯长体"
	quest.213FDE17BA15A628.title: "&4&l虚空之花"
	quest.215BC919390499B9.quest_desc: ["可将岩浆转化为能量"]
	quest.215BC919390499B9.title: "&f&l岩浆造物"
	quest.216201AA556DEA29.quest_subtitle: "S 级及以上才可购买此物品"
	quest.217C319D08955D46.quest_desc: ["抓住一个实体，并将其物理性地投掷到战场的另一侧。这项技能在将滑溜的远程头目拖到近战距离方面有着极高的实用性。"]
	quest.217C319D08955D46.title: "&f&l心灵控制"
	quest.21974AF9F407DB1D.quest_desc: [
		"将一块金块、3块纯魔钢块和一个向日葵组合成一个能量球。"
		""
		"&0&l需要 700 万 FE"
	]
	quest.21974AF9F407DB1D.title: "&6&l太阳钟爱的巨斧"
	quest.222D586CAC3DEF9F.quest_desc: [
		"&f&l位置：位于外末岛群中，被毁堡垒的最底层。"
		""
		"任务描述：末地的最后哨兵。当你靠近中央祭坛时，它会震碎地板，将你拖入一个巨大的头目竞技场。它会使用虚空能量来吸引猎物并保护其核心，直到其头盔被击碎。"
	]
	quest.222D586CAC3DEF9F.quest_subtitle: "&0&l堡垒的最后一战"
	quest.222D586CAC3DEF9F.title: "&4&l末影守卫"
	quest.2276AF873A04BD88.quest_subtitle: "只有 E 级及以上才能购买此物品"
	quest.228DE96B33B5E8D2.quest_desc: [
		"&0&l主动"
		"[主动，按下] 技能优化：打开一个菜单，列出用户拥有且能够修改的技能。选择一个技能将替换或添加其某项能力。"
		""
		"[主动，按下] 属性优化：为3个基础属性提供1.5倍的加成。未精通时，仅对最大生命值、护甲和攻击速度生效。精通后，若在切换形态时使用，则改为对SHP、魔力值和光环生效。它不会将这些属性恢复至该水平。"
	]
	quest.228DE96B33B5E8D2.title: "&f&l操控者"
	quest.2297F1EF2C140E7B.quest_desc: [
		"&6&l中等元素怪和元素巨人有 10% 掉落几率"
		"元素巨人"
		"野兽地精"
		"火元素怪"
		"水蛙"
		"羽蛇"
		"有翼猫"
		""
		"&6&l高等元素怪有 100% 掉落几率"
		"阿卡西"
		"伊夫利特"
		"西尔菲德"
		"温蒂妮"
		"战争地精"
		""
		"&4&l无法通过任何使用召唤技能召唤出的灵体获得"
	]
	quest.2297F1EF2C140E7B.quest_subtitle: "&f获取方式"
	quest.2297F1EF2C140E7B.title: "&f&l元素精华"
	quest.22AFE7031CFB2DC0.quest_desc: [
		"&0&l被动"
		"[子技能] 冷陶土 - 当获得“可塑性”时，用户将学会火焰攻击抗性。"
		""
		"[被动，切换] 记忆材料 - 所有抗性的学习速度加快 5 倍，土系魔法/能力也是如此。其掌握速度同样加快 5 倍。"
		""
		"&0&l主动"
		"[主动，按下] 炼金术 - 在 13 种不同模式间循环切换；物理、火焰、冰霜、闪电、穿刺、土系、水系、光、暗、神圣、中毒、腐蚀和风。与“魔法气场”类似，可将玩家造成的任何伤害更改为此伤害类型。掌握后变为切换技能。冷却时间 10 秒。"
		""
		"[主动，持有] 硬化 - 持有此技能期间，禁用飞行、移动、攻击能力和空间位移，并为自己赋予再生 5、抗性 2 以及 10 点护甲。释放后，该技能进入 120 秒冷却（精通后为 60 秒），并赋予虚弱 2 和缓慢 2，持续 30 秒。"
		""
		"[主动，按下] 容器 - 召唤一个黏土傀儡，拥有 40 点最大生命值，且没有 AI，任何有能力的人都可以将其附身。如果其他玩家附身，该玩家将成为临时下属，直到其离开身体或死亡为止。最多只能存在 2 个容器。精通后，容器的最大生命值提升至 200。"
	]
	quest.22AFE7031CFB2DC0.quest_subtitle: "&f用途"
	quest.22AFE7031CFB2DC0.title: "&f&l可塑"
	quest.22ED543BE73B1014.quest_desc: [
		"&f&l位置：位于沉没之城地下城的深海深处。"
		""
		"任务描述：海洋深处的废弃城市中，潜藏着一头庞大而腐化的生物。它是一头多阶段巨兽，能轻易无视标准的毕业级武器。准备好在令人窒息的黑暗中迎接一场高压战斗吧。"
	]
	quest.22ED543BE73B1014.quest_subtitle: "&0&l深渊恐怖"
	quest.22ED543BE73B1014.title: "&4&l利维坦"
	quest.2327B5B60C276554.quest_desc: ["&f&l空"]
	quest.2327B5B60C276554.title: "&f&l推荐"
	quest.2375C5A9CFB02D13.quest_subtitle: "哇，现在你很强了"
	quest.2375C5A9CFB02D13.title: "第 2 章完成者"
	quest.2382ECA675D00945.quest_subtitle: "当前的创造之旅到此结束，更多内容敬请期待！！！"
	quest.2382ECA675D00945.title: "&f&l你创造了魔法矿石！！！！！！！！！！"
	quest.238886D2C2F4B356.title: "&e&l原版天使种族"
	quest.239014E4F1A3937C.quest_desc: [
		"&0&l被动"
		"[被动 - 切换] - 并行处理：学习/使用技能、魔法、战斗意志和艺术时，获得的学识点数与精通点数增加 9（总计 10）。"
		""
		"[被动 - 切换] - 吟唱无效：对于已精通的魔法，可立即完全填满魔法阵的 MP 计量条。"
		""
		"[被动 - 切换] - 思维加速"
		""
		"&0&l主动"
		"[主动 - 按下] - 分析鉴定：分析等级 2，距离 20 格（精通后为 30 格）。若目标的 EP 高于玩家的 5 倍（精通后为 10 倍），则仅显示其基础属性（名称、HP、SHP、护甲）。"
		""
		"[主动] - 分析：在注视生物时使用，可复制目标的一项魔法和技能（独特技能和抗性除外）。可在距离目标 20 格内、且与实体或魔法阵保持视线畅通时进行复制，对任何与灵魂相关的魔法无效。对终极技能使用者无效。成功率 25%，精通后可提升至 50% - 冷却时间 10 秒（失败则为 5 秒）。"
		""
		"[主动] - 精炼：打开一个可用于合成物品、酿造药水和处理魔法矿石的 GUI。"
		""
		"---制作标签页：功能与普通制作台相同。将物品放入左侧的复制槽中，即可像使用锻造台一样制作该物品，无需设计图，用户只需在制作网格中备齐材料即可复制该物品。右侧有一个按钮，可每 5 秒自动制作所需物品。"
		""
		"---精炼标签页：可像使用酿造台一样酿造任何药水，但可在 5 秒内一次性完成。若将“希波库特草”放入任意装有瓶子的槽中，会“酿造”成高级药水。若将“希波库特花”放入任意装有瓶子的槽中，会酿造成完全药水。若将“魔法矿石”放入槽中，会“酿造”成 2 块纯魔钢锭。"
	]
	quest.239014E4F1A3937C.quest_subtitle: "&f用法"
	quest.239014E4F1A3937C.title: "&f&l大圣"
	quest.23ABAA8DF41BBFF2.quest_desc: [
		"&0&l激活状态"
		"[激活中，已入槽] 城堡守卫："
		"当此模式处于槽中时，用户免疫所有形式的技能、魔法和战斗意志。此模式激活期间，用户无法使用技能、魔法或战斗意志。用户会受到同样的惩罚，即无法使用任何技能、魔法或战斗意志；不过，他们仍可攻击和使用霸气。此模式最多只能持续 1 分钟。用户至少需要 3 名下属才能使城堡守卫生效。"
		"(城堡守卫可被“新星破”绕过)"
		""
		"[主动，持续] 天使骑士："
		"用户按住此能力30秒（精通时为10秒）以召唤一名天使骑士（精通时为3名）。该天使骑士是一名可协助用户的部下。"
		"（天使骑士拥有50点生命值（精通时为200点）。）他们可以使用神圣攻击抗性、睡眠迷雾和太阳雨。）"
		""
		"[主动，持续] 王权："
		"用户按住此能力60秒（精通时为30秒）以使一个目标成为临时部下。如果目标的命名功能已开启，这允许用户在不消耗MP的情况下命名该部下。不过，用户需要支付目标的EP才能将其收为部下。"
		"（王权需要30%或更多的EP才能生效）"
	]
	quest.23ABAA8DF41BBFF2.title: "&f&l支配者"
	quest.24C1285929D927B7.quest_desc: [
		"&0&l被动"
		"[被动 - 切换] - 预知：有25%（精通时为50%）的几率自动闪避物理/投射物攻击。命中的攻击将造成70%的伤害（精通时为50%）。攻击时获得33%（精通时为50%）的暴击几率。"
		""
		"&0&l主动"
		"[激活 - 按下] - 未来视野：激活后，可在 10 秒内（精通时为 20 秒）赋予玩家完美闪避、完美闪避抵消和完美暴击几率。持续时间结束后，该效果将在 10 秒内无法再次使用。[再次激活以关闭效果]。"
	]
	quest.24C1285929D927B7.quest_subtitle: "&f用法"
	quest.24C1285929D927B7.title: "&f&l先知"
	quest.25B553FAC3D306F6.quest_desc: ["通过蹲下并右键点击村民，可以将其作为物品拾起。此外还有另一个模组添加了循环按钮，这样您就不必更换工作站了。"]
	quest.25B553FAC3D306F6.quest_subtitle: "轻松运输"
	quest.25B553FAC3D306F6.title: "&f&l简易村民"
	quest.25FF5A516816E541.title: "&6&l重置祈祷冷却时间"
	quest.264B0B4E6135DB74.quest_desc: ["不必将盔甲扔进熔炉，直接将其粉碎！这样做会返还更多材料（适用于 Tensura 金属盔甲）。"]
	quest.264B0B4E6135DB74.quest_subtitle: "&f一些新增内容"
	quest.26642229418175EF.title: "危险的尾巴，你不觉得吗？"
	quest.26649D8A2AC41BEC.title: "&f&l获得一个次级土之灵"
	quest.266B57A4679BB342.title: "&f&l获得一个上级空间之灵"
	quest.269F39CBF204B3D5.quest_desc: ["这是一项极为出色的技能，因为其伤害会根据玩家手持的武器及其附魔而提升。如果玩家手持一把能造成数百点伤害的后期 Tensura 利刃，那么暗影斩将如一辆疾驰的货运列车般猛烈。"]
	quest.269F39CBF204B3D5.title: "&f&l暗影斩"
	quest.26AF6D1FE1A86DD7.quest_subtitle: "&f重要物品"
	quest.26AF6D1FE1A86DD7.title: "&0&l进化精华"
	quest.26DF140330289A6A.quest_desc: ["将敌人完全钉在地面上，使其无法追击或重新定位。"]
	quest.26DF140330289A6A.title: "&f&l扎根"
	quest.2777DE4F9791C7BD.quest_subtitle: "在继续前进前，请先达到 C 级。"
	quest.2777DE4F9791C7BD.title: "&f&l晋升至 C 级"
	quest.27BB56180FAD1DCD.quest_subtitle: "5 分钟冷却时间"
	quest.27FD5E9119FDFE6C.quest_desc: [
		"&0&l激活"
		"[激活、切换] 力场：除非“物体”已关闭，否则无法开启。用户不受（分解、缓慢、缓慢坠落、挖掘疲劳、负重）影响，并能击碎多层屏障。实体对用户发动物理攻击时会受到伤害。此效果不会阻止用户受到伤害。"
		""
		"[激活、切换] 物体：除非“力场”已关闭，否则无法开启。用户受到的伤害大幅降低（50%）。物理攻击抗性效果等同于无效化。若用户受到会降低物理抗性或无效化的攻击，则可能被迫退出此状态。此效果不会提升攻击伤害。"
	]
	quest.27FD5E9119FDFE6C.title: "&f&l条纹"
	quest.28622D10FCB2A252.quest_desc: [
		"&6&l一旦掌握，用户将自动获得“神之工匠”"
		""
		"&0&l[激活]"
		""
		"打开一个可访问空间存储的图形用户界面。此处的可堆叠物品堆叠上限为 128。"
		""
		"拥有一个可瞬间熔炼整组物品的插槽。"
		""
		"内置了合成台和自定义附魔台，允许玩家从已分析的附魔列表中自由添加任何想要的附魔。"
		""
		"附魔书的效果会被存储起来，以便在附魔菜单中进行选择。"
		""
		"最高奖励等级为 1。"
		""
		"---通过附魔或学习附魔来掌握（掌握需要 800 个附魔/附魔物品，不含提升掌握度的技能）"
	]
	quest.28622D10FCB2A252.quest_subtitle: "&f用途"
	quest.28622D10FCB2A252.title: "&f&l研究员"
	quest.28FC7690F586F009.quest_desc: [
		"&0&l被动"
		"[被动 - 切换] 使玩家能够看穿幻象和隐形目标"
		""
		"&0&l主动"
		"[主动 - 按下] 气息隐匿：激活后，使生物在 120 秒内无法侦测到玩家。消耗 200 点法力值。"
		""
		"[主动 - 按下] 幻象：激活后，打开一个 GUI，允许玩家为每个护甲和手持槽位选择任意虚假物品穿戴。"
		""
		"[主动 - 按住] 假死：按住时，速度降低 40%（掌握后可降低 20%）。在此模式保持期间（最长按住时间为 30 秒），若用户受到任何类型的伤害，则会生成一个新的身体，并用相同类型的伤害将其立即击杀，同时向所有在线玩家发送一条假死消息。与此同时，用户受到的伤害减半，并进入气息隐匿状态，在松开或达到最大按住时间前一直保持隐匿——冷却时间 10 秒（掌握后可缩短至 5 秒）。"
	]
	quest.28FC7690F586F009.quest_subtitle: "&f用途"
	quest.28FC7690F586F009.title: "&f&l伪造者"
	quest.28FEA148AC4A8391.quest_desc: [
		"&0&l被动"
		"[被动 - 切换] - 追踪投射物：用户投掷的物品会追踪用户注视的方向，或锁定目标并追击（最大范围 50 格）。"
		""
		"[被动 - 真实] - 用户使用苦无、长矛和三叉戟时造成的伤害远高于其默认伤害。"
		"&0&l主动"
		"[主动 - 按下] - 投掷：激活后，会消耗当前手持的物品，并以其纹理为模型生成一个投射物。"
		"--该投射物造成 50 点伤害（若掌握则造成 100 点，若开启重力支配/操控则伤害提升 x3/x2 倍），"
		"i"
		"--如果该物品是武器，则还会造成其正常的伤害。"
		""
		"--如果投掷的物品是破块工具，则会根据被破坏的方块和工具等级来破坏方块（最多可连续破坏 10 个方块，可配置）。"
		""
		"--带有元素核心的物品还会造成元素伤害（不受操控或支配效果加成）。"
		""
		"--如果空手使用，则会生成一个空气投射物，造成 30 点伤害（若掌握则造成 50 点）。"
		""
		"--如果在距离玩家 2 格内的敌人注视时激活，则会将其击飞 15 格（若开启重力操控/支配则击飞得更远）。"
		""
		"--投掷物品的动量会因玩家的动量而增强。每次使用消耗 40 点法力值。"
		""
		"&0&l精通"
		"投掷物品（不包括箭、三叉戟、手里剑等）具有“忠诚”效果"
		"---如果玩家拥有“引力操控/支配”，则返回速度会更快"
	]
	quest.28FEA148AC4A8391.quest_subtitle: "&f使用"
	quest.28FEA148AC4A8391.title: "&f&l投掷者"
	quest.294636E265ABEEC1.quest_subtitle: "提交硬币，它就成了你的"
	quest.294636E265ABEEC1.title: "&f&l需要 INF 存储吗？"
	quest.298C109288C19E7D.quest_desc: [
		"&0&l被动"
		"[被动，可放入槽位] 突击模式：当此技能被精通后，用户首次面临死亡时，死亡将被阻止，并进入突击模式。此技能有 1200 秒的冷却时间，突击模式持续 400 秒（两者均可配置）"
		""
		"[被动，真实] 地狱烈焰：被精通后，获得“黑焰”。"
		""
		"&0&l主动"
		"[主动，需持有] 完全反击：此模式的功能与“反射器”类似，但仅适用于投射物。任何被反射的投射物都会自动追踪并返回给原始施法者。此技能反射的伤害为原伤害的 2 倍（精通后为 4 倍）。两者均可配置"
		""
		"[主动，可放入槽位] 黑暗辉光：当此技能放入槽位时，攻击命中目标会造成额外的黑暗伤害。（10%，精通后为 20%）"
		""
		"[激活，持有] 神之杀手：处于持有状态时，开始为能量量表充能，最高可达 10；释放时，你注视的目标会受到玩家发动的多次攻击，攻击次数为 10 + 1（精通后为 X + 5），伤害倍率取决于攻击伤害。"
	]
	quest.298C109288C19E7D.title: "&f&l黑暗之棺"
	quest.29FD24E73CFCE2E7.quest_subtitle: "5 分钟冷却时间"
	quest.2A8A47A1CC11D777.quest_desc: [
		"&0&l激活"
		"[激活] - 汲取：未注视生物时使用，会为玩家攻击附加一个效果，汲取 200（精通后为 200 + 0.1%）点法力值和行动力（各 200），并将其暂时转移给玩家（非最大值），持续 10 秒。注视生物时使用，会汲取 200（精通后为 200 + 0.5%）点法力值和行动力（各 200），并将其转移给玩家。消耗 100 点法力值。"
		""
		"[激活] - 振奋：未注视生物或潜行时使用，可完全治愈玩家并移除所有状态效果。潜行时注视生物，则完全治愈该生物并移除其所有状态效果 [每点生命值消耗 80 点法力值（精通后为 40），每层效果消耗 100 点法力值]。若对一只满生命值且可繁殖的生物使用，将使其进入“爱心模式”。"
		""
		"[主动] - 汲取（需学习）：要求玩家正对着一只生物且距离不超过2个方块。会将玩家和该生物定在原地，并每秒消耗200点（拥有精通时为0.5%）法力值和行动力。持续共5秒。即使有抗性/无效效果，仍会造成疼痛效果。消耗500点法力值。"
		""
		"[主动 - 持续施放] 死亡祝福（需精通+学习）：持续施放时，一双神圣之手会从天空伸向用户注视的位置/目标（10个方块范围内）。在施放期间，目标位置周围6x6方块范围内的所有实体都会被减速60%。施放满5秒后，若所有受影响实体的EP低于玩家EP的50%，则会被立即击杀，同时根据目标生物的EP恢复玩家已消耗的法力值和行动力（75/25）。若目标EP在50%至75%之间，则消耗其25%的EP并造成其一半生命值伤害。若目标EP高于75%，则消耗其5%的EP并造成其一半生命值伤害。消耗7500点法力值 - 冷却时间5秒。"
	]
	quest.2A8A47A1CC11D777.quest_subtitle: "&f用法"
	quest.2A8A47A1CC11D777.title: "&f&l欲望"
	quest.2AAEDBE3F25857E3.quest_desc: [
		"&5&l！！！除非世界处于硬核模式（一条命），否则你无法从玩家身上获得技能！！！"
		""
		"&0&l被动"
		"[被动 - 真]: 技能收集：当一名友军在距离使用者 20 格范围内死亡时，使用者可以收集其抗性/固有/普通/额外/独特技能。"
		""
		"[被动 - 槽位]: 友军造成 10 点额外伤害，并获得 +0.02 速度、+1 游泳速度、+5 护甲（与专精效果叠加时，增益翻倍）。"
		""
		"&0&l主动"
		"[主动 - 按下] 思想支配：允许玩家指挥其下属，包括“肉盾”选项。"
	]
	quest.2AAEDBE3F25857E3.quest_subtitle: "&f用法"
	quest.2AAEDBE3F25857E3.title: "&f&l尖矛"
	quest.2ACD3528F979232B.quest_desc: [
		"&f&l位置：位于下界岩浆湖中漂浮的稀有结构内。"
		""
		"任务描述：一只巨大的飞行石手守护着下界熔岩深处的宝藏。找到岩浆中的竞技场，并挖掘中央石柱上的眼睛方块来唤醒它。只攻击它的眼睛，因为它的石质皮肤坚不可摧！"
	]
	quest.2ACD3528F979232B.quest_subtitle: "&0&l熔岩哨兵"
	quest.2ACD3528F979232B.title: "&4&l下界考验"
	quest.2AD081F72E165E80.title: "&f&l储存力量"
	quest.2AED82EC16C68990.quest_desc: [
		"&0&l被动"
		"[被动，切换] 重复动作："
		"你造成的任何物理伤害都会再重复一次。"
		""
		"&0&l主动"
		"[主动，按下] 递归深度："
		"激活后，来自其他现实的数百万乃至数十亿个使用者将在 5 秒内齐聚一堂。"
		""
		"每次连续命中都会使下一次命中的伤害降低 10%，但目标会在接下来的 5 秒内累积伤害。计时结束后，你造成的所有伤害将被加总并乘以 1.5 倍。"
		""
		"示例：激活 > 50 > 45 > 40.5 > 36.45 > 32.805 > 技能模式结束。(50 + 45 + 40.5 + 36.45 + 32.805) x 1.5 = 204.755 x 1.5 = 307.1325。总伤害：514.8875"
		""
		"[主动，按下] 烈焰冰霜储藏箱："
		"一段痛苦灼烧的记忆精华已被解锁。一个空的储藏箱出现在你面前，等待着一把奇特的双刃刀为其充能。一段刺骨拥抱的记忆精华已被解锁。一个空的储藏箱出现在你面前，等待着一把奇特的长刀为其充能。"
		""
		"按下可将手持的记忆之刃立即移至你的主手和副手，优先遵循公理。蹲下并按下可手动操作储藏箱。"
	]
	quest.2AED82EC16C68990.title: "&f&l连发器"
	quest.2AFE8B09B6304B88.title: "&4&l神之力"
	quest.2B7A70CC6B3705D4.quest_subtitle: "&f要开始真正的加热，请右键点击一个燃料源将其放置在上面"
	quest.2B7A70CC6B3705D4.title: "&f&l不错，你抓住一个了"
	quest.2BAF83C5627AA208.quest_desc: [
		"有一种防软锁定机制，例如，如果你拥有："
		""
		"热量中和与寒冷抗性"
		""
		"或者反过来（寒冷中和与热量抗性）"
		""
		"或者两者都是中和效果"
		""
		"同时拥有热量与寒冷抗性"
	]
	quest.2BAF83C5627AA208.quest_subtitle: "&f&l提示"
	quest.2BAF83C5627AA208.title: "&#A1BCFF&l热波动抗性"
	quest.2BE65B8785749CAE.quest_subtitle: "&f&l在侧边中央放置王族之血，在角落放置纯魔钢块，最后在中央放置一颗龙心以及一罐满满的源质（10k 源质），你就可以转化出一个傀儡之心。"
	quest.2C44447928F000F8.quest_desc: [
		"&6&l1% 几率"
		"烈焰人"
		""
		"&6&l100% 几率掉落 1 个"
		"伊夫利特"
	]
	quest.2C44447928F000F8.quest_subtitle: "&f获取方式"
	quest.2C44447928F000F8.title: "&f&l火焰精华"
	quest.2C55C9A4519BC3FE.quest_subtitle: "仅 E 级及以上可购买此物品"
	quest.2C7B8E620ED0D3F0.quest_desc: [
		"前往灵树，找个人用太阳波攻击你"
		""
		"开启后，当受到的光属性伤害低于你最大生命值的 50% 时，可免疫该伤害。如果伤害不低于你最大生命值的 50%，则伤害值将减半。"
	]
	quest.2C7B8E620ED0D3F0.quest_subtitle: "&f&l提示"
	quest.2C7B8E620ED0D3F0.title: "&#FFDD5A&l光属性攻击抗性"
	quest.2CE4D0BD13FC2E0C.title: "&f&l获取一个微风之灵"
	quest.2D52C3696BEC5830.quest_desc: [
		"&0&l被动技能"
		"[被动 - 切换] 吞噬：开启后，玩家体型增大 1.5 倍，并获得多种被动增益（0.4 击退抗性、击退 1、10 点额外伤害、2 倍速度、10 点护甲）。玩家的饥饿度将永久保持满格。"
		""
		"&0&l主动技能"
		"[主动 - 按压] 增幅：激活后（需开启“吞噬”），以 300 点法力为代价，使“吞噬”的所有增益效果翻倍，持续 2 分钟。若在增益生效期间再次激活，使用者将朝其面向方向向前冲刺，并以 150 点法力为代价，对其在冲刺过程中接触到的所有生物造成当前武器伤害 + 50（拥有专精时为 100）点伤害。[潜行状态会使冲刺距离减半] - 关闭“吞噬”将终止此模式。"
	]
	quest.2D52C3696BEC5830.quest_subtitle: "&f用法"
	quest.2D52C3696BEC5830.title: "&f&l吞噬者"
	quest.2D7284044127FCCC.quest_desc: [
		"&f&l位置：位于外末岛那些罕见的、覆盖着黑曜石的结构中。"
		""
		"任务描述：一根有意识的黑曜石柱镇守着虚空。穿越末地的外岛，找到这座奇特的巨石吧。据说它能掌控引力本身，征服它，便能夺取其黑曜石之心。"
	]
	quest.2D7284044127FCCC.quest_subtitle: "&0&l末地巨石"
	quest.2D7284044127FCCC.title: "&4&l黑曜石巨柱"
	quest.2DBADE511FA5E9FD.quest_desc: [
		"&5&l获得“武学大师”后即可获得“天眼”。若使用“创造者”创建“武学大师”，则无法获得“天眼”。"
		""
		"&0&l被动"
		"[被动 - 真实] - 使“战斗意志”每次提供 5 点学习与专精点数，而非 1 点。"
		""
		"[被动 - 插槽内] 秘密：使所有“战斗意志”与近战攻击造成 1.5 倍伤害。"
		""
		"[被动 - 切换] - 思维加速"
		""
		"[被动 - 切换] 远见：使玩家能够 100% 准确地躲避投射物，能够 25% 准确地躲避近战攻击。"
		""
		"&0&l主动"
		"[主动 - 按下] - 超加速：以高速将玩家移动到其注视的位置，效果等同于传送，半径 15 格，对路径上（玩家攻击范围内的）任何目标造成暴击伤害（精通后可额外造成 +75 伤害）。消耗 100 AP。"
	]
	quest.2DBADE511FA5E9FD.quest_subtitle: "&f使用"
	quest.2DBADE511FA5E9FD.title: "&f&l武学大师"
	quest.2DE2EADD51DE74BC.quest_subtitle: "B 级及以上才可购买"
	quest.2DE5C184B22C0CFC.quest_subtitle: "&f需要那些东西"
	quest.2E10F4D8D8B8BD10.title: "&f&l成长至 C 级实力"
	quest.2E419F65FFCEA9A0.quest_subtitle: "F 级及以上才可购买"
	quest.2E69FB9A4BC2DECE.quest_desc: [
		"&0&l被动"
		"[被动 - 槽位内] - 玩家的攻击有 50% 的几率夺取敌人 1% 的 MP，用于恢复玩家已消耗的 MP。"
		""
		"&0&l主动"
		"[主动 - 按下] - 掠夺：仅对 EP 高于使用者的对手生效。窃取其 1 项技能（仅限普通技能和额外技能）或方面魔法。成功几率为 25%，精通后可提升至 50%。每次尝试消耗 1,000 MP - 冷却时间 10 秒。"
		""
		"[主动 - 按下] - 复制：复制目标 1 项技能（仅限普通、额外和固有技能）或方面魔法。成功几率为 25%，精通后可提升至 50%。每次尝试消耗 1,000 MP - 冷却时间 10 秒。"
		""
		"[主动 - 按下] - 强制夺取（需要精通）：效果与“Rob”类似，但仅对弱于使用者的目标生效，且成功率高达100%。当对拥有者EP值低于使用者75%的召唤物使用时，可夺取该召唤物。消耗5,000点法力值 - 冷却时间10秒。"
	]
	quest.2E69FB9A4BC2DECE.quest_subtitle: "&f用法"
	quest.2E69FB9A4BC2DECE.title: "&f&l篡夺者"
	quest.2E7758D1ABA6AC32.quest_desc: ["Ultimine是一款实用的前期模组，可让你挖掘特定图案（隧道、直线等）或相同材质。默认情况下，它对应鼠标的4号键，但也可以在设置中配置。如需切换模式，请按住潜行键 + Ultimine键并滚动滚轮。"]
	quest.2E7758D1ABA6AC32.quest_subtitle: "&f更快挖掘"
	quest.2E7758D1ABA6AC32.title: "&f&lUltimine"
	quest.2E7C2E2B9DDA73D4.quest_desc: [
		"重置计数器除其他要求外，还受转世精魂的限制，后者可视为一种门槛资源。一旦你的精魂达到所需数量且满足其他要求，即可触发重置计数器以启动转世流程。该流程会清空你当前的精魂，并提高下一周期的要求。"
		""
		"技能进阶系统："
		"重置计数器是拓展能力的主要机制："
		""
		"独特技能获取：每成功触发一次重置计数器，你便有机会获得+1个独特技能。"
		""
		"配置设置："
		""
		"如果设为 1：每次成功执行重置反击时，只要达到所需的转生精华阈值，你都会获得一项额外的独特技能。"
		""
		"如果设为 3：系统需要更高的熟练度；你必须成功执行 3 次重置反击，才能获得额外独特技能的奖励。"
		"{@pagebreak}"
		""
		"灵魂等级要求：技能受限于你灵魂的力量。要解锁更多技能槽或更高等级的技能，你必须提升灵魂等级（通常与你的经验值或成功执行重置反击的总次数挂钩）。"
		""
		"锁定机制：如果你获得的技能超出了当前的“灵魂容量”，该技能会出现在你的菜单中，但会保持锁定/未激活状态，直到你达到必要的阈值。"
	]
	quest.2E7C2E2B9DDA73D4.quest_subtitle: "&f重置反击/技能锁定"
	quest.2E7C2E2B9DDA73D4.title: "&f&l游戏结束"
	quest.2E8A514D5DCAE4F8.title: "&4&l始祖恶魔种族"
	quest.2ED9A80EBB1B3CB4.quest_subtitle: "讨厌这些红家伙"
	quest.2ED9A80EBB1B3CB4.title: "大红色软蛋"
	quest.2F0228DF7103C672.quest_desc: [
		"去和兽人领主战斗并让他打你，如果这不管用，就试试兽人灾难"
		""
		"&f启用后，可抵消枯萎效果，并在腐蚀伤害低于你最大生命值 50% 时防止其造成伤害。如果攻击伤害不低于你最大生命值的 50%，则伤害减半。"
	]
	quest.2F0228DF7103C672.quest_subtitle: "&f&l提示"
	quest.2F0228DF7103C672.title: "&#0E640B&l腐蚀抗性"
	quest.2F91B286A31DF535.quest_desc: [
		"将三种龙心、2块秘银块和一颗龙精华组合成一个能量球。"
		""
		"&0&l需要 500 万 FE"
	]
	quest.2F91B286A31DF535.title: "&4&l被囚禁的武器"
	quest.2FBA3F82A8B9B154.title: "&1&l制作中"
	quest.3101481374875331.quest_desc: ["赋予暂时的鞘翅飞行能力。"]
	quest.3101481374875331.title: "&f&l天使之翼"
	quest.3160822FF982C435.quest_desc: [
		"&0&l被动"
		"[真实被动] 人造"
		"该技能初始拥有不完整的自我，并通过 MP 以 1k 兑换 1 点自我的速度发展自我。此技能无法提升亲和力或造成阻碍。"
		""
		"&0&l主动"
		"[主动 - 按下] 分解：数据"
		"打开一个包含用户全部技能列表的菜单。若选中某项技能，则将该技能获取成本的 1/2 加到用户的最大 MP 上，另 1/2 加到该技能上。若选中 Robotnic（且技能喂养游戏规则已启用），则将该技能转换为操作符。30 秒冷却时间。"
		""
		"[主动 - 按下] 分解：物品"
		"删除用户主手持有的物品。若该物品有 EP 值，则将其一半加到用户的最大 AP 和技能已储存的 MP 中。30 秒冷却时间。"
	]
	quest.3160822FF982C435.title: "&f&lRobotnic"
	quest.3184CF890D61B760.quest_desc: [
		"&0&l主动"
		"[主动 - 在技能槽中] - 灵魂吞噬：对玩家的攻击施加一种减益效果，使被影响的生物/玩家每 10 个游戏刻流失 10 点精神生命值（此流失效果持续 5 秒）。用户每次攻击消耗 100 MP [必须位于主动技能槽中]"
		""
		"[激活 - 保持] - 灵魂窃取：立即击杀半径 30x30 范围内所有生命值低于 10%、能量值低于使用者最大值的 10%，或至少带有 5 级恐惧负面效果的怪物。消耗 100 点法力值"
	]
	quest.3184CF890D61B760.quest_subtitle: "&f用法"
	quest.3184CF890D61B760.title: "&f&l无情"
	quest.319586DD25374C12.title: "&f&lB 级威胁"
	quest.33952A41417FD2AC.quest_subtitle: "&5&l龙族完成者"
	quest.33952A41417FD2AC.title: "&f&l把它们全都抓起来！"
	quest.340963CCD1962258.quest_desc: [
		"受到造成 20+ 伤害的物理攻击（例如：工具/武器伤害、怪物攻击、坠落伤害……）（1-4 点）"
		""
		"开启后，若物理攻击造成的伤害低于你最大生命值的 50%，则免疫该伤害。"
		""
		"若攻击造成的伤害不低于你最大生命值的 50%，则伤害减半。"
	]
	quest.340963CCD1962258.quest_subtitle: "&f&l提示"
	quest.340963CCD1962258.title: "&#AB949B&l物理攻击抗性"
	quest.346E52B025D0AB09.quest_desc: ["《主世界冒险任务》章节中有关于如何找到他的宝贵信息。"]
	quest.346E52B025D0AB09.quest_subtitle: "&3小心，我听说他非常可怕，掌握着大地魔法的力量。"
	quest.346E52B025D0AB09.title: "&4&l击败德瓦贡之王"
	quest.347F199A305DAE36.quest_subtitle: "只有 F 级及以上才能购买此物品"
	quest.34A74B45EE9AE008.quest_desc: ["&f&l将魔法石放置在侧面中央，将纯魔钢锭放置在角落，最后在中心放置一个史莱姆块，即可消耗 2000 点源质转化出一个史莱姆核心"]
	quest.34A74B45EE9AE008.title: "&f&l史莱姆核心"
	quest.35E1ACE29973558E.title: "&f&l真司"
	quest.35E4ECDD85253673.quest_desc: [
		"前往精神之树，让另一名玩家用“压迫者”或带有 3 个大地元素核心的武器攻击你"
		""
		"如果你独自战斗，就去对抗战争侏儒。它有一种能生成紫色球体的攻击，该攻击会造成重力伤害。"
		""
		"切换后，当生命值低于最大生命值的50%时，可防止重力伤害。如果受到的攻击未使生命值低于最大生命值的50%，则伤害减半。此外还免疫漂浮效果。"
	]
	quest.35E4ECDD85253673.quest_subtitle: "&f&l提示"
	quest.35E4ECDD85253673.title: "&#9E03B9&l重力攻击抗性"
	quest.361990ACA1F38B2B.quest_desc: [
		"&0&l被动"
		"[被动 - 切换] - 思维加速"
		""
		"[被动 - 槽位内] 秒杀：使玩家的攻击造成500（精通时为1000）点精神伤害，代价是消耗3000点法力值，冷却时间10秒（精通时为5秒）。"
		""
		"&0&l主动"
		""
		"[主动 - 按下] - 超加速：高速移动到玩家注视的位置，效果等同于传送，影响半径10格，对路径上的所有目标造成暴击伤害（精通时+70）。消耗100点行动力。"
		""
		"[主动 - 长按] 谍报：赋予1点（精通时为2点）隐匿效果，使玩家隐形，且免疫“魔法感知”、“热源感知”和“声波感知”的侦测。精通后可切换为可开关状态。"
	]
	quest.361990ACA1F38B2B.quest_subtitle: "&f用法"
	quest.361990ACA1F38B2B.title: "&f&l暗影打击者"
	quest.3711320DDCDA7404.title: "&f&l成为S级灾难"
	quest.371C69D21766CB37.quest_desc: [
		"&0&l被动"
		"[切换] 适应 - 受到任何攻击都会为对应的抗性获得少量学习点。"
		""
		"如果对该类伤害没有抗性，则建立对该类伤害的减伤效果，最高可达 20%(35%)"
		""
		"[切换] 斩断适应 - 被斩断攻击命中 12 次后，获得斩断免疫效果，并抵消所有未来的斩断伤害"
		""
		"&0&l激活"
		"[按下] 召唤歼灭之刃 - 按下此键会将歼灭之刃召唤至用户所在的物品栏槽位。如果物品栏中已有刀刃或该槽位已被占据，则无法召唤"
	]
	quest.371C69D21766CB37.title: "&f&l适应性"
	quest.37808315459CE306.quest_desc: [
		"球体是放置你想要充能物品的位置。"
		""
		"这些杆状物如同导体一般，可将能量传输至球体。可以将杆状物放置在电缆上，以便同时使用多个杆状物。"
	]
	quest.37808315459CE306.title: "&f&l施加能量"
	quest.37BCE0F559CBFA79.quest_desc: ["背包是帮助保持物品栏整洁有序的好工具。还有一个额外的模组，加入了以特斯纳金属为基础的背包，其效果比下界合金背包更好。你还可以为它们添加许多酷炫的升级，使其性能更上一层楼。"]
	quest.37BCE0F559CBFA79.quest_subtitle: "&f非常有用的可携带储物工具"
	quest.37BCE0F559CBFA79.title: "&f&l背包！"
	quest.37C29C71801E8A42.title: "&f&l获取一个次级黑暗之灵"
	quest.37C89EFDE98F6615.title: "嘿，快看那些小人儿"
	quest.38553C005B86C950.quest_desc: ["&6&l2% 掉落 &f&l来自 Shizu"]
	quest.3906329D35931935.quest_desc: [
		"前往灵魂树，找个人用带有“魔法武器”铭文的武器攻击你，或者让怪物掉落该武器，然后由它捡起并攻击你。"
		""
		"开启后，当魔法伤害低于你最大生命值的50%时，可免疫该伤害。若攻击伤害不低于你最大生命值的50%，则伤害减半。"
	]
	quest.3906329D35931935.quest_subtitle: "&f&l提示"
	quest.3906329D35931935.title: "&#850419&l魔法抗性"
	quest.39EA15B736EFF5F6.quest_desc: ["你的背包中现在内置了一个垃圾桶。你可以在左上角的其他图标中找到它。"]
	quest.39EA15B736EFF5F6.quest_subtitle: "&f不再乱扔垃圾"
	quest.39EA15B736EFF5F6.title: "&f&l垃圾桶"
	quest.3A3C30151BD823E6.quest_desc: ["将药水装入药水瓶中，再将其放置在此源链接旁边，即可生成源。"]
	quest.3AF620FBF39958AA.quest_desc: [
		"&0&l被动"
		"[需要精通、被动、可切换] 达到精通后，可防止“烹饪”和“断肢”效果施加在玩家身上。"
		""
		""
		"&0&l主动"
		"[主动、长按] 恒定：生命值 - 按住技能键可保留你当前的生命值和灵魂生命值，无论受到多少伤害。此模式每按住1秒会消耗1000魔力。松开后，将有10秒的冷却时间。"
		"按住此技能15秒后，此模式会自动关闭，并进入更长的15秒冷却时间。"
		""
		"[激活，按下] 持续效果：物理 - 按下技能键后，开始一个 5 秒的计时器。该计时器会记录你在此期间造成的最高物理伤害。计时器结束后，[持续效果：毁灭] 即可使用。按下技能键后，该技能进入 10 秒的冷却时间。"
		""
		"[激活，持续，锁定] 持续效果：毁灭 - 在“持续效果：物理”完成后，即可使用“持续效果：毁灭”。持续按住此技能模式时，你的伤害将停滞不前，并始终造成你在“持续效果：物理”中保存的最高伤害值。此模式每持续按住 1 秒就会消耗 3000 魔力。松开后，你将进入 10 秒的冷却时间。"
		"持续按住此能力 15 秒后，此模式将自动关闭，并进入更长的 15 秒冷却时间。"
		""
		"[需要掌握，主动，按下] 恒定效果：能量 - 按下此模式后的 10 秒内，您的魔力与气场不会消耗。但会开始一个隐藏的倒计时。10 秒结束后，您使用的所有技能的费用将被加总并乘以二，然后相应地从您的各项属性中扣除。如果此模式造成的消耗会超过 0%，则改为将您的魔力设为 25%，并在 3 分钟内阻止魔力再生。"
	]
	quest.3AF620FBF39958AA.title: "&f&l恒定效果"
	quest.3B8B2253F0A077A7.quest_desc: [
		"&0&l主动效果"
		"[主动 - 按下] 在未注视目标时使用，可移除使用者身上的所有负面状态效果，并将其生命值完全恢复，包括“断裂”伤害。在注视怪物时使用，可移除其身上的所有负面状态效果，并将其生命值完全恢复。每次恢复 1 点生命值需消耗 60 点法力值（掌握后可减少至 40 点），每移除 1 个效果等级需消耗 100 点法力值。"
	]
	quest.3B8B2253F0A077A7.quest_subtitle: "&f用法"
	quest.3B8B2253F0A077A7.title: "&f&l厨师"
	quest.3C06849D565EFF80.quest_desc: [
		"&f"
		"提升您在矮人中的声望以解锁更优惠的交易。您的行为会决定您的 DR 值，而这会直接影响您的购买力。"
		""
		"&2&l提升声望："
		""
		"+1.0 DR：通过击败攻击矮人的怪物来拯救一名矮人。"
		""
		"+0.1 DR：提升矮人商人的交易等级。"
		""
		"+0.05 DR：每完成一笔购买交易。"
		""
		"+0.01 DR：每笔销售交易。"
		""
		"&4&l声誉受损："
		""
		"-0.1 DR：在另一名矮人（目击者）附近攻击一名矮人。"
		""
		"-1.0 DR：在另一名矮人（目击者）附近杀死一名矮人。"
		""
		"影响："
		""
		"正面 DR：每一点可享受 0.5% 的折扣。"
		""
		"负面 DR：每一点需承受 2% 的加价惩罚。"
	]
	quest.3C06849D565EFF80.quest_subtitle: "&5神奇村民"
	quest.3C06849D565EFF80.title: "&f&l 寻找小人"
	quest.3C23D96F0D0CC052.quest_desc: ["&f&l将 8 块低品质魔法水晶放置在基座上，然后将一块低品质魔钢锭置于中央，即可转化出一块中品质魔法水晶，消耗 500 源质。"]
	quest.3C47884B35EA4509.quest_subtitle: "呕……感觉像精液。"
	quest.3C47884B35EA4509.title: "低等生命体"
	quest.3C6DC2A1106CABBB.title: "&f&l 获取一枚中品质光之灵"
	quest.3CBCE51C60F2174B.quest_subtitle: "5 分钟冷却时间"
	quest.3CC48F5B2658D2EA.quest_desc: [
		"&0&l被动技能"
		"被动（真实）- 暗影军团"
		""
		"由至高君主亲自击败的敌人，有几率留下一缕残影。"
		""
		"被击败的生物须满足以下条件："
		""
		"它不是玩家。"
		"它尚未成为至高君主之影。"
		"它曾对至高君主怀有敌意或正主动攻击至高君主。"
		"至高君主拥有的 EP 至少是该目标初始 EP 的两倍。"
		""
		"产生残影的几率为："
		""
		"普通：1/20"
		"精通：1/15"
		""
		"残影将持续 20 秒，必须在消失前使用“复苏”将其提取。"
		""
		"被动（真实）- 暗影等级"
		""
		"每个影子的等级是根据其被提取时的原始EP与主权者EP的对比来确定的。"
		""
		"士兵 - 最高为主权者EP的10% - 1个存储槽 - 30秒恢复时间"
		""
		"骑士 - 高于10%，最高为20% - 3个存储槽 - 1分钟恢复时间"
		""
		"指挥官 - 高于20%，最高为35% - 6个存储槽 - 2分钟恢复时间"
		""
		"将军 - 高于35%，最高为50% - 12个存储槽 - 5分钟恢复时间"
		""
		"额外等级规则："
		""
		"原始EP至少为200,000的影子，等级始终为指挥官或更高。"
		"原始EP至少为500,000的影子，等级始终为将军。"
		"被击败的影子绝不会永久消失。在完成其等级对应的恢复时间后，它会返回影子存储。"
		""
		"被动（真实）- 首次降服"
		""
		"首次成功提取每种独特的实体类型，都会授予用户等于该目标原始EP 50%的EP。"
		""
		"此奖励每种实体类型只能获得一次。永久释放影子不会重置该奖励。"
		"被动（真实）- 主权者成长"
		""
		"随着主权者当前EP相对于影子原始EP的增长，影子的实力也会增强。"
		""
		"当达到影子EP的2倍时"
		"普通：70%强度"
		"精通：80%强度"
		""
		"当达到影子EP的3倍时"
		"普通：85%强度"
		"精通：95%强度"
		""
		"暗影 EP 的 5 倍"
		"普通：100% 威力"
		"精通：110% 威力"
		""
		"8 倍或以上"
		"普通：110% 威力"
		"精通：125% 威力"
		""
		"成长会提升暗影的物理与精神战斗属性。一旦提取，暗影绝不会低于第一级成长，即使君主之后损失了 EP。"
		""
		"被动（真实）- 暗影附魔攻击"
		""
		"每次成功的暗影攻击都会造成额外的精神伤害。"
		""
		"普通：25%"
		"精通：35%"
		""
		"被动（真实）- 君主主权"
		""
		"由暗影造成的击杀会为其君主提供正常的 Tensura EP 奖励。"
		""
		"被动（真实）- 暗影维持"
		""
		"储存和恢复中的暗影不消耗魔素。已部署的影持续消耗魔素，其消耗量取决于其初始 EP 和君主当前的 EP。"
		""
		"每秒 MP = 暗影初始 EP x [0.0005 + 0.003 x (暗影 EP / 君主 EP)]"
		""
		"更强的暗影维持成本更高，而同一个暗影会随着玩家的成长而变得更便宜。"
		""
		"交换锚点仅消耗其正常维持成本的 10%。君主领域将所有已部署的暗影和交换锚点的维持成本降低 50%。"
		""
		"如果君主无法支付下一次的维持费用，整个活跃军团将撤退，且自动召唤功能会被禁用。"
		""
		"被动（切换，需精通）- 君王威压"
		""
		"切换该技能会激活君主威压。"
		""
		"若目标生物的EP低于君主当前EP的5%，则12格范围内的生物会受到此效果影响。"
		""
		"受影响的生物将在6秒内获得："
		""
		"真实恐惧"
		"虚弱 II"
		"缓慢 II"
		"脱离仇恨"
		""
		"效果结束后，该生物将在15秒内免疫君主威压。"
		""
		"&0&l激活技能"
		"激活（按下）- 唤出"
		""
		"尝试提取最近的滞留暗影。"
		""
		"唤出技能有2秒的冷却时间。每个滞留暗影允许进行三次失败的提取尝试。第三次失败后，该灵魂将被摧毁。"
		""
		"目标生物EP为君主EP的10%或更低"
		"正常成功率：50%"
		"精通成功率：65%"
		""
		"目标生物EP高于10%、但不超过25%"
		"正常成功率：15%"
		"精通成功率：25%"
		""
		"目标生物EP高于25%、但不超过50%"
		"正常成功率：1%"
		"精通成功率：3%"
		""
		"激活（按下）- 暗影存储"
		""
		"打开暗影存储界面。该界面会显示每个暗影的名称、实体类型、等级、初始EP、成长百分比、存储槽位成本、维护消耗以及当前状态。"
		""
		"可用控制："
		""
		"召唤或召回单个暗影。"
		"永久释放一个暗影。"
		"启用或禁用自动召唤。"
		"所有影骸撤退。"
		""
		"自动召唤会部署所有可用的影骸，并在恢复完毕的影骸准备好时重新部署。所有影骸撤退会强制禁用自动召唤。"
		""
		"影骸存储容量："
		"低于 25,000 EP：10 个槽位"
		"25,000 EP：14 个槽位"
		"75,000 EP：18 个槽位"
		"150,000 EP：22 个槽位"
		"300,000 EP：27 个槽位"
		"600,000 EP：32 个槽位"
		"1,200,000 EP：37 个槽位"
		"2,500,000 EP：42 个槽位"
		"5,000,000 EP：46 个槽位"
		"10,000,000 EP：50 个槽位"
		""
		"精通可额外获得 20 个存储槽位。"
		""
		"主动（按下与 Shift 键按下）- 影骸交换"
		""
		"Shift 键按下会将存储中最弱且可用的影骸放置为交换锚点。"
		""
		"要求："
		"需要在战斗外 10 秒"
		"消耗 20% 的最大魔力值"
		"允许 3 个锚点（精通后为 5 个）"
		"自动选择 EP 最低的影骸"
		"锚点不会移动，也不会攻击"
		"锚点可以被击杀"
		"锚点死亡后进入正常的影骸恢复状态"
		"锚点可以跨维度放置和访问"
		""
		"普通按下会打开影骸交换界面，并开始 10 秒的准备时间。如果在准备期间受到伤害，界面将被取消，需要重新打开。"
		""
		"主动（按下，需要精通）- 主权领域"
		""
		"在 90 秒内释放影骸君主的完全权威。"
		""
		"激活期间："
		"玩家造成的伤害为 2 倍"
		"暗影伤害为 1.5 倍"
		"暗影与交换锚点的维护消耗减少 50%。"
		"6 分钟的冷却时间将在 90 秒的持续时间结束后开始计算。"
	]
	quest.3CC48F5B2658D2EA.title: "&f&l主宰"
	quest.3CD72E5BBA7CAF84.quest_desc: [
		"&0&l被动"
		"[被动] 既定结局：当**切换开启**时，玩家的所有攻击都会自动成为暴击。当**处于插槽中**时，玩家的攻击会击碎所有护盾值，除非目标拥有法则操控或终极技能，且其 EP 高于玩家的 2 倍。"
		""
		"[被动 - 切换] 最优行动：玩家的攻击会无视所有形式的闪避。学习和掌握能力时，可获得 5 点而非 1 点。无效化被视为抗性，且抗性会被无视。"
		""
		"&0&l主动"
		"[主动 - 切换] 混沌命运（需要学习）：激活后，玩家下一次攻击所造成的伤害值会等量减少目标的最高生命值。蹲下并使用混沌命运会解除用户对混沌命运造成的所有永久伤害；注视一个生物则会对该生物造成同样效果。若以掌握状态激活，则会变为一个主动 - 按键技能。"
	]
	quest.3CD72E5BBA7CAF84.quest_subtitle: "&f用法"
	quest.3CD72E5BBA7CAF84.title: "&f&l烹饪"
	quest.3D929CA2F60BD455.quest_desc: ["一种会留下冰冻霜痕的传送法术。它将顶级机动性与即时风筝能力完美结合。"]
	quest.3DC88DA099EBD926.quest_desc: ["你最终可以制作出它的不可破坏版本！"]
	quest.3DC88DA099EBD926.quest_subtitle: "建筑玩家的实用工具！"
	quest.3E0A601D325FFEE8.quest_desc: [
		"&0&l激活"
		"[激活 - 按下] 合成：打开一个合成界面，其中也包含将物品分解为其基础组件的选项。第二个选项卡是铁砧（无法重命名）和砂轮的结合体（可以选择要移除附魔）。使用铁砧功能组合附魔时，可以突破原版附魔可获取等级的上限，最高可达原版上限的 +2 级。"
		""
		"[激活 - 按下] 合成：使用时，如果用户正注视着一个卡律布迪斯核心，则会根据核心的状态获得技能和经验值。如果玩家正注视着一个被标记为“灵性”且生命值低于或等于 25% 的魔物，该魔物将会死亡，玩家则获得该魔物的所有技能和经验值。此效果每种魔物类型只能触发一次。（不能是被召唤出的灵体，必须在野外找到）"
		""
		"[激活 - 按下] 分离：对 EP 低于玩家 75% 的魔物使用时，窃取一个普通/额外类型的技能。对氧化铜使用时，将其剥离。对矿石方块使用时，将矿石给予玩家，并在其位置留下一个石头/深板岩方块。对可疑的沙/砾石使用时，立即分离出物品。在未注视任何物体时使用，从使用者身上移除状态效果（除非是有益的技能效果）。在潜行并注视下属/盟友时使用，则从他们身上移除状态效果，包括“断离”效果 [每移除一个效果等级消耗 100 点法力值]。"
	]
	quest.3E0A601D325FFEE8.quest_subtitle: "&f用法"
	quest.3E0A601D325FFEE8.title: "&f&l退化"
	quest.3E2C61959A603AD2.quest_desc: [
		"&5&l掌握该技能后获得“法则操控”。"
		""
		"&0&l被动"
		"切换后，获得的“学习点”和“精通点”数量增加 2"
		""
		"思维加速（与常规效果相同）"
		"吟唱无效（与常规效果相同）"
		""
		"&0&l激活"
		"[ 激活 - 按下] - 分析鉴定：分析等级 18（精通后为 28），距离 40 格（精通后为 50）"
		""
		"[ 激活 - 按下] - 分析：当长按 5 秒（精通时为 3 秒）（受吟唱速度影响）且注视 30 格半径内的魔法阵或魔法实体（屏障、领域、投射物等）时，可复制其魔法。无法复制任何灵魂魔法或元素召唤魔法。"
	]
	quest.3E2C61959A603AD2.quest_subtitle: "&f用法"
	quest.3E2C61959A603AD2.title: "&f&l分析者"
	quest.3E708127FFBEDAF6.quest_desc: ["恭喜你完成了冒险的第一部分。下一部分将更加精彩！"]
	quest.3E708127FFBEDAF6.quest_subtitle: "第一章完成！"
	quest.3E747DA6C8915BAD.quest_subtitle: "只有 B 级及以上才能购买此物品"
	quest.3E8BA9B08E5BBDAC.title: "&f&l你已赢得此奖励"
	quest.3F11F501F2539FCB.quest_desc: [
		"&5&l所有激活都会伴随一声刺耳的音效 - 对灵魂生命体或处于狂暴状态下的目标无效。"
		""
		"&0&l激活"
		"[激活 - 按下] 目标：将注视的生物变为盟友，持续 10 分钟。消耗 50 点法力值，可被灵魂攻击无效化抵消。受抗性影响时持续时间缩短至 5 分钟。"
		""
		"[激活 - 按下] 范围：将 20x20（精通时为 30x30）半径内的所有生物变为盟友，持续 5 分钟。每个生物消耗 80 点法力值。可被灵魂攻击无效化抵消。受抗性影响时持续时间缩短至 2.5 分钟。"
		""
		"[激活 - 按下] 魅力：为玩家施加“村庄英雄 V”效果，持续 2 分钟。消耗 200 点法力值。"
		""
		"[主动 - 按下] 击杀：击杀 20x20（拥有专精时为 30x30）范围内的所有（处于精神控制下的）生物。每击杀一个生物消耗 100 点法力值。可被“精神攻击无效化”抵消。对具备抗性的目标造成一半生命值的伤害。 - 冷却时间：5 秒（拥有专精时为 3 秒）"
	]
	quest.3F11F501F2539FCB.quest_subtitle: "&f用法"
	quest.3F11F501F2539FCB.title: "&f&l迷惑"
	quest.3F6B0025F0DED584.quest_desc: [
		"前往精神之树，让别人用“电击”攻击你"
		""
		"如果你是单人游玩，可以通过被“西尔菲德”（高级风元素）击中，或使用“冰与火”模组被“雷电巨龙”的吐息击中来获得此效果。不过你需要有办法获得“脆弱效果”，因为它们通常造成的伤害不足。你可以制作“脆弱药水”或使用“缩小术”。"
		""
		"切换开启后，若闪电伤害低于你最大生命值的 50%，则免疫该伤害。若攻击伤害不低于你最大生命值的 50%，则伤害减半。"
	]
	quest.3F6B0025F0DED584.quest_subtitle: "&f&l提示"
	quest.3F6B0025F0DED584.title: "&#3A33AB&l雷电抗性"
	quest.3F7F02DFB2A164ED.quest_desc: ["击杀此“源链接”附近的生物会产生“源”"]
	quest.3F8373BF8354C6B7.quest_desc: [
		"&0&l被动"
		"[被动，可切换] 思维加速"
		""
		"&0&l主动"
		"[主动，按下] 追随教诲（需要专精）"
		"使用后，用户可以打开“技能创建菜单”，将自己已知的法术和战斗意志传授给他人。"
		""
		"[主动，槽内] 追寻真理"
		"&l-当处于槽内时，用户将获得以下好处。"
		"--用户的精通度和学习速度提升+10"
		"--用户的近战闪避几率为50%，远程闪避几率为25%，暴击几率为30%，同时拥有40%的闪避减免。"
		"&l-按下Shift键时，将在追击模式之间切换。"
		"--惊喜追击：高亮显示附近的陷阱。熔岩、尖刺滴水石、绊线、潜声传感器、潜声尖叫器、蜘蛛网、粉雪、陷阱箱、TNT、TNT矿车、末影水晶 [ 添加配置以加入其他方块 ]"
		"--宝藏追击：箱子、木桶、金库、龙蛋、远古残骸和魔法矿石、卡律布迪斯核心。[ 添加配置以加入其他方块 ]"
		"--战斗追击：以不同颜色高亮显示附近的生物，黄色为中立，红色为敌对"
		""
		"[激活，切换] 分析评估："
		"评估等级为5，精通度为15。"
	]
	quest.3F8373BF8354C6B7.title: "&f&l调查员"
	quest.3F8561B5BDFB440E.quest_subtitle: "仅E级及以上可购买此技能"
	quest.3F96EFDDB89B18A0.quest_desc: [
		"&0&l被动"
		"[被动 - 切换] - 幻象打击（需要学习）：激活后，为玩家攻击附加一种效果，造成10点（+1%目标最大SHP，受精通度影响）精神伤害。"
		""
		"&0&l激活"
		"[主动 - 持续] - 深度催眠：注视一个生物时，每 10 秒增加一层困倦（有精神抗性时为 15 秒，有无效化时为 20 秒），持续时间增加 5 秒（有精通时为 10 秒）。每层睡眠会使移动速度降低 25%，并附加与虚弱和易碎相同的效果。在 5 级时，会立即击杀目标。对魔法阵使用时，将摧毁该魔法阵，并使其进入 3 秒冷却（有精通时为 5 秒）。"
		""
		"[主动 - 持续] - 堕落催眠：深度催眠的增强版，但作用范围为 10x10 的 AoE 区域（有精通时为 20x20），施法时间翻倍 - 20 秒（有精神抗性时为 25 秒，有无效化时为 30 秒）。"
		""
		"[主动 - 持续] - 剥夺：注视一个 5 格（有精通时为 15 格）内的生物时，每秒吸取 1000 点法力值（有精通时额外吸取目标最大法力值的 0.3%），并造成 10 点精神伤害（有精通时额外造成目标最大神圣生命值的 1%）。若对精神生命值低于 50% 的生物使用，该生物将被驯服/成为玩家的从属。"
		""
		"[主动 - 持续] - 休息：持续按住时，玩家无法移动、攻击或激活其他能力。每秒恢复 10 点生命值与精神生命值（+1% 的目标最大生命值，需掌握技能），并将玩家的法力值与行动力恢复速度提升 10 倍。若法力值已满，则按相同速率填充临时法力值储备。若临时储备中有足够的法力值（1000 x Y = X [Y = 盟友数量。X = 消耗]），右键点击即可为 30x30 范围内的所有盟友恢复 1000 点法力值、1000 点行动力、50 点生命值和 10 点精神生命值。"
		""
		"[主动 - 按下] - 坠落打击（需要幻象风格。需要掌握技能。）：消耗 5,000 点法力值，对注视的目标造成 500 点精神伤害。无视精神攻击抗性与无效化。[冷却时间 10 秒]"
	]
	quest.3F96EFDDB89B18A0.quest_subtitle: "&f用途"
	quest.3F96EFDDB89B18A0.title: "&f&l怠惰"
	quest.3FD33658DD08FF7A.quest_desc: [
		"&f&l位置：位于下界废弃堡垒内的火焰祭坛中。"
		""
		"任务描述：一位纯日火骑士守护着下界的核心。将燃烧灰烬放置在祭坛上即可召唤他。他会释放巨大的火焰冲击波，进入第二阶段后，他的火焰会转为致命的“冰冷”。"
	]
	quest.3FD33658DD08FF7A.quest_subtitle: "&0&l永恒余烬"
	quest.3FD33658DD08FF7A.title: "&4&l伊格尼斯"
	quest.4014018705D764A3.quest_desc: [
		"&0&l主动"
		"[主动 - 按住] 捕食：使用时，会在玩家前方生成一个半径为 10 个方块的黑色雾气（吐息）（切换方块或使用能力会改变消耗的方块类型，仅方块、仅液体或两者皆可，可通过滚动鼠标调整滑动范围。精通后可提升至最大 15）。若雾气接触到生物，将造成 50 点伤害，施加 5 秒的腐蚀效果，并消耗 1000 点法力值，同时有 30% 的几率从目标身上获得 1-3 个随机的固有能力、普通技能、额外技能或抗性技能。若敌人被“捕食”击杀，玩家将获得其所有的固有能力、普通技能、额外技能和抗性技能。若已掌握精通，当吞噬魔法投射物时，玩家将获得该魔法。首次击杀某种生物时，被击杀的目标会将其 80% 的经验值（而非通常的 3%）添加到玩家的经验值上限中。在“捕食”模式下，可通过“Shift + 能力键”切换为消耗方块的模式，消耗的方块会自动添加到“胃”中。"
		""
		"[主动 - 按下] 胃：激活后，可获得一个大小等同于箱子、共 9 行的空间储物格。物品堆叠上限为 666 个，而非 64 个。"
		""
		"[主动 - 保持] 腐蚀：消耗 200 点法力值，每 10 次判定对 10x10 范围内的所有敌人造成 10 点腐蚀伤害。被此技能击杀的敌人所拥有的抗性、固有技能、普通技能和额外技能都会被玩家夺取。"
		""
		"[主动 - 按下] 接收：玩家下属所拥有的固有技能、普通技能和额外技能都会转移给玩家。"
		""
		"[主动 - 按下] 隔离：消耗手持物品，恢复的法力值与“吸收”和“溶解”类似，但恢复量翻倍。如果未手持物品且玩家正注视着一个目标，则移除该目标身上的所有负面状态效果。如果空手使用且未注视任何生物，则移除玩家身上的所有负面状态效果 [每移除一个效果等级消耗 100 点法力值]。"
	]
	quest.4014018705D764A3.quest_subtitle: "&f用法"
	quest.4014018705D764A3.title: "&f&l暴食"
	quest.408E4F2F9BA8FDD1.quest_subtitle: "趁现在在的时候，记得给自己弄一个灵魂。"
	quest.408E4F2F9BA8FDD1.title: "天哪，好大的一棵树！"
	quest.40C3E37399E1B3E2.quest_desc: ["对于需要源质的配方，请将这个罐子放在你的炼金区域旁边（就是你摆放祭坛等装置的地方）。一个装满的罐子包含 10000 点源质。"]
	quest.40C3E37399E1B3E2.title: "&0&l重要信息"
	quest.40C7F8E43865182A.quest_subtitle: "能看到看不见的东西，还挺有用的。"
	quest.40E537414168D837.quest_desc: ["是时候把那个罐子装满源质了。接下来的物品会帮你汇聚那股能量。"]
	quest.40E537414168D837.title: "&f&l把它装满"
	quest.4110800A2F766C8C.quest_desc: [
		"&0&l被动"
		"[被动 - 切换] 两次打击间的静默 - 所有玩家的声音都会被静音。"
		""
		"[被动 - 切换] 隐藏权威 - 进入隐身状态，对周围玩家隐藏你的存在。在服务器中，你还会从玩家列表中隐藏，并伪装一条离开消息。取消切换时会播放一条虚假的加入消息。"
		""
		"[被动 - 真] 统治者的威严 - 所有附近的下属都会获得鼓舞 1。在精通后，此效果会变为鼓舞 2。"
		""
		"&0&l主动"
		"[主动 - 按下] 复制 - 获取目标的能力列表。从目标已学会的能力中随机复制一项随机能力（固有、普通或额外）。复制的能力是临时的，死亡后会消失。只要用户持有该能力或死亡，复制的能力就会一直存在。你最多只能复制五项临时能力，达到上限后便无法再复制。按住 Shift 并点击能力键可显示当前所有已复制的能力。成功率 25%。失败率 75%。精通后变为 50-50。"
		""
		"[主动 - 按下] 粘贴 - 将你复制的五项技能中的一项随机粘贴到目标身上。目标不必是你的下属。目标将永久保留该技能直至死亡。再次按下 Shift + 技能键可显示列表中当前所有已复制的技能。成功率 25%。失败率 75%。随着专精度提升，概率变为 50-50。若失败，复制的技能将会丢失。"
		""
		"[主动 - 按下] 招募 - 若目标比你弱 5 倍，则将其招募为临时下属（魅惑）。消耗 1000 法力值。若目标为头目则招募失败。"
	]
	quest.4110800A2F766C8C.title: "&f&l隐藏统治者"
	quest.411F0C94067E550F.quest_desc: [
		"人类种族是最具适应性的种族之一，绝对是经典之选！"
		""
		"描述：一个弱小但人口众多的种族，他们更依赖科技和数量，而非蛮力。由于魔素含量低，技能和魔法使用者在他们当中十分罕见，他们更倾向于使用战斗意志。"
		""
		"属性："
		""
		"生命值：20"
	]
	quest.411F0C94067E550F.quest_subtitle: "你是一名真正的异界来客"
	quest.411F0C94067E550F.title: "人类"
	quest.41D3685F650A24CE.quest_desc: [
		"&0&l被动"
		"[被动 - 槽位] 思维加速 - 施法速度倍率提升 2，移动速度提升 0.01（专精后为 0.02），攻击速度提升 0.2（专精后为 0.4）"
		""
		"[被动 - 槽位中] 不稳定的发射器 - 生命值降至 10% 以下时，你会获得相当于自身最大生命值 75% 的吸收值。此外，当生命值因受到伤害而低于 10% 时，附近的所有敌人都会被传送离开。此技能进入 120 秒的冷却时间。"
		""
		"[被动，槽位中] 虚空灌注 - 将虚空之力注入你的双拳，造成额外的护甲伤害，并被动地根据目标生命值的一定百分比将其肢解。"
		""
		""
		"&0&l主动"
		"[主动 - 按下] 毁灭者霸气 - 散发毁灭者的气场，宣告末日的到来，对附近的敌人施加每秒 25 点（精通后为 50 点）的无法躲避、无法抵抗的虚空伤害。此外，用敌人罪孽的重量碾碎他们的灵魂，根据你相对于对手的优势强度降低其移动速度。使用此技能每秒消耗 500 点法力值。"
		"--附加信息：毁灭者霸气不受冷却时间影响。在敌人生成区域或限制技能使用的区域使用时请小心。"
		""
		"[激活 - 保持] 维度跳跃者 - 切换维度，允许您滚动选择维度（主世界、下界、末地、地狱、灵魂维度）并在它们之间跳跃。松开后，您的维度将会改变。如果您松开时仍处于同一维度，则不会发生任何变化。冷却时间 600 秒。精通后为 300 秒。"
	]
	quest.41D3685F650A24CE.title: "&f&l撞击者"
	quest.42222A220089F73B.quest_desc: [
		"&0&l被动"
		"[被动，位于槽位中] 现状：用户的最大生命值无法被“断肢”或“烹煮”之类的效果减少。"
		""
		"[被动，可切换] 渲染静止：用户可以像走在固体上一样走过液体方块。"
		""
		"&0&l激活"
		"[激活，位于槽位中] 固定状态：用户在固定状态期间不会消耗魔力粒和气场。"
		""
		"[激活，长按] 空气墙：用户在面前生成一个 5x5 的固体空气墙。任何与其接触的项目都会被摧毁，且无法穿墙而过。"
	]
	quest.42222A220089F73B.title: "&f&l静止"
	quest.42DD405227F8366A.quest_desc: [
		"&0&l被动"
		"[被动 - 真] - 命运改变：若玩家即将死亡，则改为将其生命值恢复至满值，移除负面状态效果，并将其法力值和行动力恢复至各自最大值的 50%（拥有专精时为 75%）。此效果对每种伤害类型每 Minecraft 一天（20 分钟）仅生效一次。此能力触发后，该技能将进入 20 分钟的冷却时间。在冷却期间仍可使用该技能；当 20 分钟冷却结束后，使用者便可再次从过去 20 分钟内已承受过的死亡类型中复活。"
		""
		"[被动 - 槽位内] - 意外结果：（拥有专精后可切换）若玩家生命值低于 25%，则获得力量 10 增益、+0.2 攻击速度、+0.04 移动速度、+1 游泳速度以及 15% 的物理攻击自动闪避几率。（拥有专精时所有增益翻倍）"
	]
	quest.42DD405227F8366A.quest_subtitle: "&f用法"
	quest.42DD405227F8366A.title: "&f&l调谐器"
	quest.431E9D44021FF5B6.title: "必须曾很强"
	quest.436A9AE5675D3DB6.title: "&f&l获取更强的火之精魂"
	quest.436D34A755CEBB77.quest_desc: [
		"&f&l位置：位于主世界的远古工厂地下城中。"
		""
		"任务描述：一台形似机械凋灵的远古战争机器已被重新激活。它需要一颗下界之星才能被唤醒。当心它连绵不绝的导弹与激光攻击，这台机器曾被制造出来以终结文明。"
	]
	quest.436D34A755CEBB77.quest_subtitle: "&0&l远古自动机"
	quest.436D34A755CEBB77.title: "&4&l先驱者"
	quest.439426A295458187.quest_desc: [
		"&6&l100% 几率"
		"末影龙"
		""
		"&6&l50% 几率"
		"末影螨"
		""
		"&6&l5% 几率"
		"有翼猫"
		""
		"&6&l1% 几率"
		"末影人"
		"潜影贝"
	]
	quest.439426A295458187.quest_subtitle: "&f获取方式"
	quest.439426A295458187.title: "&f&l末影精华"
	quest.43B0274755B20F2F.quest_desc: ["&f&l（完成“创造”任务线后，即可免费获得创造控制器）"]
	quest.43B0274755B20F2F.quest_subtitle: "&f精炼存储，面面俱到"
	quest.43B0274755B20F2F.title: "&1&l物品太多？"
	quest.44057E3C3FFE1036.quest_subtitle: "不知道能用这个做出什么呢"
	quest.44057E3C3FFE1036.title: "纳尼？！结晶魔法？？"
	quest.442C9FE0E04D8220.quest_subtitle: "这是一条被禁用的龙吗？"
	quest.442C9FE0E04D8220.title: "真烦人！"
	quest.4446B2635520549C.quest_desc: ["终极聚拢工具。它能将所有附近的实体吸到一个紧密的中心点。"]
	quest.4446B2635520549C.title: "&f&l黑洞"
	quest.4462787728F30ECD.quest_desc: [""]
	quest.4462787728F30ECD.quest_subtitle: "是时候去寻找那种远古金属了"
	quest.4462787728F30ECD.title: "&f&l前往下界"
	quest.446F2E7F4A6A4D40.quest_subtitle: "完成此任务后，你就能自己制作魔法矿石了"
	quest.446F2E7F4A6A4D40.title: "&6&l开始创造吧！！！"
	quest.447DF570F7FD0237.quest_desc: [
		"被动（真实）- 压力"
		""
		"灾祸可储存 0–100 点压力。"
		""
		"压力可通过以下方式获得："
		""
		"受到的攻击"
		"负面效果"
		"生命值降至 75%、50% 或 25% 以下时"
		"12 格范围内有三个或更多敌对生物将目标锁定为用户时"
		"在战斗中持续 10 秒：每秒 +0.25。"
		""
		"在 10 秒内未对战斗作出贡献后，压力以每秒 1 的速度衰减。死亡后压力重置。"
		""
		"压力容器阶段"
		""
		"0–24 - 休眠：无加成。"
		""
		"25–49 - 躁动：伤害、移动速度和攻击速度 +5%。"
		""
		"50–74 - 扭曲：伤害 +15%，移动速度和攻击速度 +10%，击退抗性 +0.25。"
		""
		"75–99 - 过载：伤害 +30%，移动速度和攻击速度 +15%，击退抗性 +0.50，攻击距离 +1，伤害减免 +15%。"
		""
		"100 - 临界质量：伤害 +40%，移动速度和攻击速度 +20%，击退抗性 +0.75，攻击距离 +1.5，伤害减免 +20%。"
		""
		"临界质量还会将当前生命值上限固定为 80%，并将 SHP、魔法粒子和光环的再生速度降低 50%。"
		""
		"阶段加成适用于用户的直接攻击和自身拥有的投射物。"
		""
		"被动（真实）- 临界压力"
		""
		"将压力维持在恰好 100 时，每 20 秒获得一层临界压力。"
		""
		"每层提供 +5% 造成的伤害，最多叠加 10 层，200 秒后达到 +50%。压力降至 100 以下时，所有层数重置。"
		""
		"只要有任何一层处于激活状态，每次命中都会造成反冲，其数值等于增强后伤害的 5%，上限为最大生命值的 5%。反冲不会将用户生命值降至 1 以下。"
		""
		"在掌握“灾变”前，“临界质量”会禁用“超高速再生”、“无限再生”和“深度恢复”。"
		""
		"压制效果将持续到“压力”降至 95 以下，此后在可能的情况下，先前生效的再生技能将恢复。掌握该技能仅解除此压制效果。"
		""
		"被动（真实）- 灾变牺牲"
		""
		"每生命只有一次，在“压力”为 100 时，原本会造成死亡的伤害将被抵消，除非该伤害无视无敌状态。"
		""
		"使用者："
		""
		"以 60% 最大生命值复活。"
		"失去所有“压力”和“临界应力”。"
		"获得两秒无敌状态。"
		""
		"“灾变”被封印 30 秒。"
		""
		"被动（真实）- 预兆"
		""
		"当使用者生命值低于 30% 最大生命值时，对其造成伤害的敌人会获得独立的“预兆”层数。"
		""
		"第一层立即获得。此后每层需要 3 秒。"
		""
		"若该敌人在 30 秒内未对使用者造成伤害、未施加有害效果，或未受到使用者伤害，则“预兆”效果失效。即使使用者生命值回升至 30% 以上，现有的层数仍可刷新。"
		""
		"预兆 I"
		""
		"从该敌人处生成的“压力”+5%。"
		"敌人受到来自使用者的伤害+4%。"
		""
		"预兆 II"
		""
		"生成的“压力”+10%。"
		"敌人受到来自使用者的伤害+8%。"
		""
		"预兆 III - 宣判"
		""
		"生成的“压力”+20%。"
		"敌人受到来自使用者的伤害+12%。"
