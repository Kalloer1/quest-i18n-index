	quest.71385BE6412AA3BE.quest_subtitle: "&5以下是有效的选项"
	quest.71385BE6412AA3BE.title: "&f&l击杀 5 名低阶异世界人"
	quest.715A33875EBEFE15.title: "&f&lFolgen"
	quest.7211C870071EAA12.quest_subtitle: "&1&l要抛光粉晶，先将普通粉晶丢在地上，然后右键按住并使用砂纸"
	quest.7211C870071EAA12.title: "&f&l是时候让它们闪亮登场了"
	quest.7255C6E8D7A1129B.quest_desc: ["&6&l3% 掉落率 &f&l来自卡律布迪斯"]
	quest.72DA1BB025CAF00E.quest_desc: ["打开转生菜单，导航到 TR 侧边栏，然后找到“可重复任务”，即可查看任务要求。"]
	quest.72DA1BB025CAF00E.quest_subtitle: "是的，它们确实掉落！"
	quest.72DA1BB025CAF00E.title: "&f&l哪些首领会掉落技能"
	quest.7347C968B7B5EB87.quest_desc: [
		"&f&l位置：位于尤拉扎尼亚兽人王国"
		""
		"任务描述：一座宏伟而粗犷的堡垒，雕刻在一座巨大山脉的侧面，彰显出其主人狂野的力量。卡里恩矗立于顶峰，甚至比利姆鲁本人还要凶猛。"
	]
	quest.7347C968B7B5EB87.quest_subtitle: "&0&l兽人主宰"
	quest.7347C968B7B5EB87.title: "&4&l卡里恩"
	quest.7352692195262DE4.quest_desc: [
		"前往灵魂之树，让另一名玩家用带有“神圣武器”铭文的武器攻击你，或者他们也可以使用“魔法气场”技能并将伤害类型改为神圣。或者，将一把能造成神圣伤害的武器丢弃在怪物附近，让怪物捡起并用它攻击你。"
		""
		"去对抗那个可怕又凶狠的女人（Hinata），然后被她用“熔岩斩”击中。"
		""
		"启用后，当神圣伤害低于你最大生命值的50%时，可免疫该伤害。如果攻击造成的伤害不低于你最大生命值的50%，则伤害值会减半。"
	]
	quest.7352692195262DE4.quest_subtitle: "&f&l提示"
	quest.7352692195262DE4.title: "&#C97F15&l神圣攻击抗性"
	quest.735EE2F54CBE16DA.quest_subtitle: "更强大的附魔在等着你"
	quest.738B6B0A37ADBB15.quest_desc: [
		"&6&l90%几率"
		"斥候"
		""
		"&6&l80%几率"
		"幻术师"
		"唤魔者"
		""
