	chapter.7E73627B261D8742.title: "章节：奥里泰克科技 (Oritech Technologies)"
	chapter_group.44C8A9130BFD9883.title: "重要的事情说三遍，重要的事情说三遍，重要的事情说三遍"
	quest.0000000000001001.quest_desc: [
		"制作或获取**The Oracle Index**。"
		""
		"本指南书介绍了 Oritech 的动画化多方块组装规则及机器模组移植。"
	]
	quest.0000000000001001.quest_subtitle: "游戏内文档说明"
	quest.0000000000001001.title: "1. 神谕索引"
	quest.0000000000001002.quest_desc: [
		"Oritech 使用**镍**(Y=40 至 -65)作为核心结构金属，并使用**铂**(末地/深层板岩 Y=-20 至 -60)制造高级超导体。"
		""
		"收集原始镍和纹石晶体以开始。"
	]
	quest.0000000000001002.quest_subtitle: "基础材料"
	quest.0000000000001002.title: "2. 开采镍和铂矿石"
	quest.0000000000001003.quest_desc: [
		"将镍锭和铁/钢结合，锻造**磁线圈**和**电机**。"
		""
		"这些是几乎所有 Tier 1 机器配方中必备的微型组件。"
	]
	quest.0000000000001003.quest_subtitle: "基本组件"
	quest.0000000000001003.title: "3. 磁线圈与电机 (Magnetic Coils & Motors)"
	quest.0000000000001004.quest_desc: [
		"Oritech 的机器由一个 **机器基座方块** 和一个 **机器核心** 组成。"
		""
		"最终机器的处理速度和属性会根据所连接核心的数学平均等级进行缩放。"
	]
	quest.0000000000001004.quest_subtitle: "装配建筑学"
	quest.0000000000001004.title: "4. 机器外壳与核心等级"
	quest.0000000000001005.quest_desc: [
		"建造一个**基础发电机方块**。"
		""
		"燃烧煤炭或木炭等固体燃料，为您的主网络生成红石流（RF/FE）。"
	]
	quest.0000000000001005.quest_subtitle: "早期RF能源"
	quest.0000000000001005.title: "5. 能量生成：基础燃烧"
	quest.0000000000001006.quest_desc: [
		"制作标准的**能量管道**来分配电力。"
		""
		"标准能量管道支持高达 10,000 RF/t 的吞吐量，并能自动连接相邻的 Oritech 机器。"
	]
	quest.0000000000001006.quest_subtitle: "10,000 RF/t 容量"
	quest.0000000000001006.title: "6. 能量电缆网络"
	quest.0000000000001007.quest_desc: ["建造一个**能量存储/接收器方块**来缓存多余的电网电力，防止在高负荷运行周期中出现停电。"]
	quest.0000000000001007.quest_subtitle: "网格缓冲 (Grid Buffering)"
	quest.0000000000001007.title: "7. 能量存储缓冲器"
	quest.0000000000001008.quest_desc: [
		"建造**Pulverizer**（基础消耗32 RF/秒）。"
		""
		"将原矿研磨成粉以获得双倍产量，将煤炭粉碎成煤炭粉，并将石英加工成石英粉以获取硅。"
	]
	quest.0000000000001008.quest_subtitle: "矿石与材料研磨机 Ore & Material Grinding"
	quest.0000000000001008.title: "8. Pulverizer: 粉尘处理"
	quest.0000000000001009.quest_desc: [
		"建造**电动熔炉**。"
		""
		"用它将粉末和锭混合成高级 Oritech 金属合金和碳结合结构。"
	]
	quest.0000000000001009.quest_subtitle: "高温热合成 (High Thermal Synthesis)"
	quest.0000000000001009.title: "9. 电动熔炉：合金冶炼"
	quest.0000000000001010.quest_desc: [
		"建造**离心分离机方块**。"
		""
		"它能分离复杂的化学混合物，将生物质转化为污泥，并分离出重放射性同位素。"
	]
	quest.0000000000001010.quest_subtitle: "流体提取器"
	quest.0000000000001010.title: "10. 离心机：液体/固体分离"
	quest.0000000000001011.quest_desc: [
		"合成**物品管道**。"
		""
		"管道默认为输入模式。右键点击与容器接触的接口，将其切换为**输出模式**。"
	]
	quest.0000000000001011.quest_subtitle: "物流基础教程"
	quest.0000000000001011.title: "11. 物品管道与提取逻辑 (Item Pipes & Extraction Logic)"
	quest.0000000000001012.quest_desc: [
		"将**物品过滤器**连接到任意管道接口上。"
		""
		"提供12个分类槽位，带黑白名单切换，可精准控制物品流向。"
	]
	quest.0000000000001012.quest_subtitle: "白名单与黑名单机制"
	quest.0000000000001012.title: "12. 物品过滤器"
	quest.0000000000001013.quest_desc: [
		"制作**流体管道**和**流体储罐**。"
		""
		"流体管道以零实体实现液体顺畅传输，确保服务器端性能。"
	]
	quest.0000000000001013.quest_subtitle: "水陆两用运输机"
	quest.0000000000001013.title: "13. 流体管道与储罐 (Fluid Pipes & Storage Tanks)"
	quest.0000000000001014.quest_desc: [
		"合成 **速度增强包**。"
		""
		"将它们连接到机器扩展端口，以更高的RF消耗为代价，大幅加快运行速度。"
	]
	quest.0000000000001014.quest_subtitle: "超频机器计时器"
	quest.0000000000001014.title: "14. 速度增强模组"
	quest.0000000000001015.quest_desc: ["制作**效率插件**，降低每刻的能耗，平衡高速超频。"]
	quest.0000000000001015.quest_subtitle: "能源优化"
	quest.0000000000001015.title: "15. 效率附加组件"
	quest.0000000000001016.quest_desc: ["将**Machine Addon Extender**连接到机器侧面，以扩展可安装的附加模块的最大数量。"]
	quest.0000000000001016.quest_subtitle: "扩展附魔物品栏位"
	quest.0000000000001016.title: "16. 机器扩展附加组件"
	quest.0000000000001017.quest_desc: ["将下界石英研磨成石英粉，然后将其熔炼以生产纯**硅**。"]
	quest.0000000000001017.quest_subtitle: "微电子设置 (Micro-electronics Setup)"
	quest.0000000000001017.title: "17. 硅和石英粉尘"
	quest.0000000000001018.quest_desc: [
		"制造**处理器单元**并建造**装配器**。"
		""
		"Assembler 是 Oritech 的主要自动化工作站，能以较低的材料成本解锁高级组件配方。"
	]
	quest.0000000000001018.quest_subtitle: "自动化电力合成系统"
	quest.0000000000001018.title: "18. 处理单元与装配器 (Processing Units & The Assembler)"
	quest.0000000000001019.quest_desc: [
		"将你的机器核心升级为**高级机器核心**(Tier 2)。"
		""
		"将这些核心连接到现有机器上，可永久提高基础处理速度并解锁 Tier 2 配方。"
	]
	quest.0000000000001019.quest_subtitle: "中后期框架升级"
	quest.0000000000001019.title: "19. 第2阶段：高级机器核心"
	quest.0000000000001020.quest_desc: [
		"找到地表上的**原油泉**（每120-350个区块自然生成）。"
		""
		"将原油泵入流体容器中以便化学提炼。"
	]
	quest.0000000000001020.quest_subtitle: "化石燃料开采"
	quest.0000000000001020.title: "20. 石油勘探与原油泉"
	quest.0000000000001021.quest_desc: [
		"将原油加工成燃料和**塑料片**。"
		""
		"塑料对于高级布线、大容量储能和盔甲制造至关重要。"
	]
	quest.0000000000001021.quest_subtitle: "石化工业链"
	quest.0000000000001021.title: "21. 石油精炼厂与塑料"
	quest.0000000000001022.quest_desc: [
		"建造**燃料发电机方块**。"
		""
		"燃烧精炼油或作物加工的生物燃料。经速度插件完全升级，单个燃料发电机可产生巨大的基础RF。"
	]
	quest.0000000000001022.quest_subtitle: "高效射频（High-Efficiency RF）"
	quest.0000000000001022.title: "22. 燃料发电机与生物燃料路线"
	quest.0000000000001023.quest_desc: [
		"制作一个**无人机港口（起飞）**和一个**无人机港口（降落）**。"
		""
		"无人机可在已绑定的港口之间无限距离地运输物品。"
	]
	quest.0000000000001023.quest_subtitle: "长途物流运输系统"
	quest.0000000000001023.title: "23. 无人机起降港口"
	quest.0000000000001024.quest_desc: [
		"合成**目标指示器**。"
		""
		"右键单击目标着陆端口，再右键单击起飞端口进行配对。飞行时间约为30秒。"
	]
	quest.0000000000001024.quest_subtitle: "无人机飞行路径绑定"
	quest.0000000000001024.title: "24. 目标指定器绑定"
	quest.0000000000001025.quest_desc: [
		"建造**Enderic激光臂**和**激光靶块**。"
		""
		"激光臂向目标方块发射聚焦能量束，以采集资源、挖掘方块或为特殊接收器供电。"
	]
	quest.0000000000001025.quest_subtitle: "靶向方块交互器"
	quest.0000000000001025.title: "25. 末地激光臂 (Enderic Laser Arm)"
	quest.0000000000001026.quest_desc: ["制作专用激光头：**Destroyer Block**（采矿）、**Tree Cutter**（伐木）、**Fertilizer Block** 和 **Placer Block**。"]
	quest.0000000000001026.quest_subtitle: "种植、砍伐与收获"
	quest.0000000000001026.title: "26. 激光子模块"
	quest.0000000000001027.quest_desc: [
		"建造**Deepslate Laser Drill**多方块结构。"
		""
		"将其置于深板岩层上方，并用激光臂射击，即可在不破坏地形的情况下无限生成矿石。"
	]
	quest.0000000000001027.quest_subtitle: "自动化矿石提取系统"
	quest.0000000000001027.title: "27. 深层板岩激光钻"
	quest.0000000000001028.quest_desc: ["在世界上寻找自然生成的基岩矿石节点，并在其上方放置一个**Bedrock Extractor**，以获得永久可再生的矿石脉。"]
	quest.0000000000001028.quest_subtitle: "终末游戏矿石提取"
	quest.0000000000001028.title: "28. 基岩提取器与资源节点"
	quest.0000000000001029.quest_desc: ["建造**粒子加速器环**，并组装一个圆形的多区块加速器环。"]
	quest.0000000000001029.quest_subtitle: "亚原子物理学"
	quest.0000000000001029.title: "29. 粒子加速器环"
	quest.0000000000001030.quest_desc: ["安装**加速器马达**以注入粒子，安装**加速器传感器**以检测高速碰撞。"]
	quest.0000000000001030.quest_subtitle: "碰撞控制(Collision Control)"
	quest.0000000000001030.title: "30. 加速马达与传感器"
	quest.0000000000001031.quest_desc: ["放置**粒子收集器**以收集碰撞产生的亚原子碎片，从而获得奇异材料。"]
	quest.0000000000001031.quest_subtitle: "奇异粒子收集器"
	quest.0000000000001031.title: "31. 粒子收集器与纹石合成"
	quest.0000000000001032.quest_desc: ["将奇异碰撞粒子与高级电路结合，制成**高级机器核心**(Tier 3)。"]
	quest.0000000000001032.quest_subtitle: "Peak Machine Framework"
	quest.0000000000001032.title: "32. 第三级：高级机械核心"
	quest.0000000000001033.quest_desc: ["在离心机中纯化原始铀，以分离用于核能的**铀燃料棒**。"]
	quest.0000000000001033.quest_subtitle: "放射性物质准备"
	quest.0000000000001033.title: "33. 铀加工链"
	quest.0000000000001034.quest_desc: ["建造**核反应堆控制器**、**反应堆墙壁**和**反应堆燃料端口**，以形成反应堆外壳。"]
	quest.0000000000001034.quest_subtitle: "原子裂变核心"
	quest.0000000000001034.title: "34. 核反应堆控制器"
	quest.0000000000001035.quest_desc: ["组装**Reactor Fuel Rods**、**Double Rods**和**Quad Rods**以获得最高的中子通量密度。"]
	quest.0000000000001035.quest_subtitle: "核心燃料网格"
	quest.0000000000001035.title: "35. 燃料棒与双/四联组件"
	quest.0000000000001036.quest_desc: ["在反应堆矩阵内安装**中子反射器**、**反应堆吸热器**、**散热口**和**热管**，以防止灾难性的熔毁。"]
	quest.0000000000001036.quest_subtitle: "热能与辐射平衡"
	quest.0000000000001036.title: "36. 中子反射器与吸热器"
	quest.0000000000001037.quest_desc: ["制作**曼哈顿模块**和**低当量核装置**，进行高能破坏性测试。"]
	quest.0000000000001037.quest_subtitle: "原子核爆発技術"
	quest.0000000000001037.title: "37. 低当量核爆炸装置与曼哈顿模块"
	quest.0000000000001038.quest_desc: [
		"将铂金加工成**超导体**。"
		""
		"超导体的传输速度高达 4,194,304 RF/t。注意：超导体不能直接连接到标准能量管道；整条线路必须全部由超导体构成。"
	]
	quest.0000000000001038.quest_subtitle: "4,194,304 RF/t 电网电缆"
	quest.0000000000001038.title: "38. 铂精炼与超导体"
	quest.0000000000001039.quest_desc: [
		"建造**原子共振器方块**的多方块结构。"
		""
		"它在超强导体能量的巨大牵引下，对基础金属进行量子转换。"
	]
	quest.0000000000001039.quest_subtitle: "尖峰能量处理中心"
	quest.0000000000001039.title: "39. 原子共振器多区块结构"
	quest.0000000000001040.quest_desc: [
		"制作完整的**外骨骼套装**(头盔、胸甲、护腿、靴子)。"
		""
		"使用内部RF能量运行，提供坠落伤害减免、夜视、速度提升和环境防护。"
	]
