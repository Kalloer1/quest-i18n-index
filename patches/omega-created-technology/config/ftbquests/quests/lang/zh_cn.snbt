	quest.0000000000001050.title: "50. 全自动基岩版网格"
	quest.0000000000001051.quest_desc: ["你已经掌握了奥里泰克的每一个系统：核能、亚原子物理、激光钻探、赛博格增强和物流！"]
	quest.0000000000001051.quest_subtitle: "完成模组精通任务"
	quest.0000000000001051.title: "51. 奥里泰克大师"
