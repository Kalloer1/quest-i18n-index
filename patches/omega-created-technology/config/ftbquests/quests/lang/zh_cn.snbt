	quest.0000000000001040.title: "40. 外骨骼盔甲套装"
	quest.0000000000001041.quest_desc: ["安装赛博增强模块，通过穿戴的外骨骼电池获得永久被动增益。"]
	quest.0000000000001041.quest_subtitle: "直接身体升级模组"
