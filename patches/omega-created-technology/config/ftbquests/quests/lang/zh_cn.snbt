	quest.022706A8599C4F27.title: "2. 动能传动装置 (Kinetic Transmission)"
	quest.0E8F724709A977A7.quest_subtitle: "收集用于制作 Powah 的原材料"
	quest.0E8F724709A977A7.title: "Powah：合成材料"
	quest.1000000000001001.quest_desc: ["欢迎来到 Omega Created Technology。收集任意树种的原木 16 个即可开始。"]
