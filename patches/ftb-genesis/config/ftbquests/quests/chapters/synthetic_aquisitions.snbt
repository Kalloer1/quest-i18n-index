		{
			dependencies: ["0D4BA302A3BCAA07"]
			description: ["阿马德龙平板电脑将直接向您交付多种必需品。您可以在游戏早期用它来获取石油、润滑油、绿宝石和其他必需品。提供足够的能量，我们就能为您生成一台平板电脑。要进行交易，您必须右键将平板电脑绑定到箱子或储罐上，以便进行交付和取货。"]
			icon: {
				Count: 1b
				id: "pneumaticcraft:amadron_tablet"
				tag: {
					"pneumaticcraft:air": 30000
