					size: [I;
						7
						5
						7
					]
					title: "前往模拟矩阵 (Simulation Matrix)"
					type: "location"
				}
			]
			title: "模拟蜂巢生态系统（Simulating The Hive）"
			x: 0.0d
			y: -1.0d
		}
		{
			dependencies: ["737A19C13281CFC4"]
			description: [
				"我们为基因改造蜜蜂准备了新环境，现在责任交给你了。繁殖蜜蜂，让它们适应新环境。繁殖新物种时，要繁殖多余的用于再加工。将蜜蜂放入蜂笼，带到装瓶器处。在蜂笼里放上瓶子，活塞放在装瓶器上方一格。把蜜蜂放进去，然后用活塞压扁。注意别让它们飞走，用活板门会很有用。"
				" "
			]
			id: "1A63FDA8AF7907AD"
			rewards: [
				{
					id: "4D656D848E0C69B1"
					item: "minecraft:piston"
					type: "item"
				}
				{
					id: "10E3DF8A426EFD9E"
					item: "minecraft:lever"
					type: "item"
				}
				{
					id: "13C2BADCAD420FB1"
					item: "productivebees:sturdy_bee_cage"
					type: "item"
				}
			]
			tasks: [{
				id: "270C4BA7E0CA81A1"
				item: "productivebees:bottler"
				type: "item"
			}]
			x: 0.0d
			y: 0.5d
		}
		{
			dependencies: ["5FF3DED97F378FAA"]
			description: ["获得纯基因样本后，你就可以用 UU-Matter 这种可编程物质来复制基因了。将任何纯基因样本与 UU-Matter 结合即可复制。重要基因的母本一定要保存好。"]
			id: "56705C602D70B062"
			rewards: [{
