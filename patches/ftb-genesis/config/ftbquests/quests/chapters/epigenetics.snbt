		}
		{
			dependencies: ["56705C602D70B062"]
			description: ["提取基因后，你可以手动组合以提高纯度。要保证蜜蜂继承所需基因，需要将纯度提升至100%。基因索引器可在接收到红石信号时自动将基因组合至100%，从而加快这一过程。你可以直接将其接入管道以实现自动化。"]
			id: "03EBF933004ECBAD"
			tasks: [{
				id: "5A912856EB064FE6"
				item: "productivebees:gene_indexer"
				type: "item"
			}]
			x: 2.0d
			y: 2.5d
		}
