	filename: "epigenetics"
	group: "57632A2841EDB38D"
	icon: "productivebees:adv_breed_all_bees"
	id: "661D087DD2472F2D"
	order_index: 1
	quest_links: [ ]
	quests: [
		{
			dependencies: ["406CDD321A31814B"]
			description: [
				"我们的科学家认为，他们利用你研究的元素精华，以及从阿尔弗雷姆维度朋友处换来的蜂蜜精华，成功稳定了一种蜜蜂品种，以帮助埃利里亚的重建。"
				""
				"将熔炉中熔化的蜂蜜瓶中的蜂蜜和相应的能量提交到任务界面，我们就会在模拟中加载它。初始化新模拟前，请确保模拟是空的，加载完成后将新模拟保存到这个全新的空间IO盘中。"
			]
			icon: "minecraft:honeycomb"
			id: "737A19C13281CFC4"
			rewards: [
				{
					id: "292D5C5012E60E1F"
					item: "ae2:spatial_storage_cell_128"
					team_reward: true
					type: "item"
				}
				{
					exclude_from_claim_all: true
					icon: "ae2:spatial_cell_component_2"
					id: "388D5C0ADC34976B"
					tags: ["prefab_bee"]
					team_reward: true
					title: "激活模拟程序"
					type: "custom"
				}
			]
			shape: "hexagon"
			size: 1.25d
			tasks: [
				{
					id: "468FEE3A00611B8E"
					max_input: 10000L
					title: "为蜂巢模拟提供动力"
					type: "forge_energy"
					value: 1000000L
				}
				{
					amount: 4000L
					fluid: "cyclic:honey"
					id: "3C41E3060AD8636D"
					title: "蜂巢里的蜂蜜"
					type: "fluid"
				}
				{
					dimension: "minecraft:overworld"
					icon: "ae2:spatial_pylon"
					id: "6ACA307654B6C7C2"
					ignore_dimension: true
					position: [I;
						-15
						44
						56
