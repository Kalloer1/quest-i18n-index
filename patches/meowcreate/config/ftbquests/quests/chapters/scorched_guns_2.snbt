			subtitle: "放置在地热喷口可生成硝石，放置在硫磺喷口可生成硫磺"
			tasks: [{
				id: "1CFF127A1A71334A"
				item: "scguns:vent_collector"
				type: "item"
			}]
			x: 6.0d
			y: -4.0d
