					type: "item"
				}
			]
			subtitle: "炉灶是一个实用方块，功能与带6个格子的篝火相同。"
			tasks: [{
				id: "2463976F61D2A36A"
				item: "farmersdelight:stove"
				type: "item"
			}]
			x: -4.0d
			y: -1.0d
		}
