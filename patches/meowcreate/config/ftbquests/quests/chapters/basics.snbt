					item: "minecraft:iron_ingot"
					type: "item"
				}
				{
					id: "342ED148047E5FDF"
					item: "minecraft:paper"
					type: "item"
				}
			]
			subtitle: "Schematicannon 是一种特殊机器，用于使用蓝图建造结构。它是一种实用的装置，主要用于生存模式，以逐块部署结构，因为蓝图直接放置的功能仅限于创造模式。"
			tasks: [
