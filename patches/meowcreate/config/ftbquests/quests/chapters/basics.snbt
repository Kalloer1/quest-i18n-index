					item: "minecraft:stone_slab"
					type: "item"
				}
				{
					id: "7D7445A8F71B8FF9"
					item: "minecraft:iron_nugget"
					type: "item"
				}
			]
			size: 2.0d
			subtitle: "铁轨是一种用于支撑火车的特殊方块。"
