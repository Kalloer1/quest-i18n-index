# AI 初翻，未人工校对
{
	default_hide_dependency_lines: false
	default_quest_shape: ""
	filename: "animals_2"
	group: "4C3BDF99CEE93A23"
	id: "67B9BBA067FDDEC2"
	order_index: 0
	quest_links: [ ]
	quests: [
		{
			description: [
				"模组中的所有动物都有独特的基因，可以遗传给后代，让玩家能选择性繁殖出特定颜色、体型、外形和掉落物。"
				""
				"动物还有其他拟真改动，如觅食、进食、饥饿机制、睡眠、治愈机制、性别、怀孕和/或产卵率。如果使用创造模式或命令，可以使用 Genetic Animals 的刷蛋来召唤模组动物。"
			]
			id: "48AAA57396A924E7"
			subtitle: "Genetic Animals 是一款拟真模组，它将牛、猪、鸡、羊、羊驼、兔子、蘑菇马、海龟和蝾螈替换为更具动态性的基因驱动实体。"
			tasks: [{
				id: "293DA965A6BE799F"
				title: "基因动物模组 (Genetic Animals)"
				type: "checkmark"
			}]
			x: 0.0d
			y: 1.0d
		}
		{
			dependencies: ["48AAA57396A924E7"]
			description: [
				"如果是哺乳动物，它们会怀孕而不是立即产下幼崽。如果是鸡，它们会下受精蛋，可以投掷来孵化。"
				""
				"海龟和蝾螈在合适的条件下会产下卵，这些卵会随着时间的推移自行孵化。"
				""
				"动物出生后，它会随着时间的推移缓慢长大，而不是立即长大。可以通过启用配置选项来加速这一过程，该选项允许通过喂食来使动物成长。"
			]
			id: "36E19A1A8B70706A"
			subtitle: "要开始繁殖，你需要找到同物种的成年雄性和雌性动物，并使用它们的繁殖食物进行繁殖。"
			tasks: [{
				id: "53B1EC3BF03BC061"
				title: "繁殖（Breeding）"
				type: "checkmark"
			}]
			x: 0.0d
			y: 2.0d
		}
		{
			dependencies: ["48AAA57396A924E7"]
			description: [
				"村庄中会有一些纯种生物，探索世界可以找到更多品种。野外发现的动物通常具有适应环境或该生物群系特有的特性。"
				""
				"在未来的更新中，野生生物更有可能对玩家感到恐惧或具有攻击性，而村庄生物将保持温顺。"
				""
				"流浪商人也将开始出售更多温顺且独特的动物。"
				""
				"在村庄和野外找到你喜欢的动物，并保留最好的用于繁殖下一代。如果用你最喜欢的动物繁殖，它们会生出具有相同特征的幼崽，偶尔还会诞生具有多个祖先中你最喜欢特征的新动物。"
			]
			id: "31C56DAD905C080A"
			subtitle: "你可以在每个动物的GUI中查看性别、怀孕进度、饥饿度、年龄等信息。通过蹲下+右键动物即可打开GUI。"
			tasks: [{
				id: "693C8E83DEF388FE"
				title: "信息 & 村庄"
				type: "checkmark"
			}]
			title: "通用信息和村庄信息"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["48AAA57396A924E7"]
			description: [
				"如果在两次进食之间留出足够的时间，这些植物会重新生长。"
				""
				"一旦有动物开始吃植物，它就会自动转化为生长后的形态。"
			]
			id: "567AF130B85771F9"
			subtitle: "能让动物持续进食的草地和花朵的变种。"
			tasks: [{
				id: "2E7E584EE81089E7"
				title: "种植植物"
				type: "checkmark"
			}]
			x: -1.0d
			y: 1.0d
		}
		{
			description: [
				"一旦生成，它们会吸引饥饿的动物，这些动物会从每个方块上最多吃掉9次小麦。"
				""
				"未绑定的干草块受重力影响。它们不仅会下落，被消耗掉的干草块也会被上方的干草块填补。"
				""
				"干草不会造成窒息或伤害，但会减缓困在其中的任何实体。"
				""
				"干草必须避雨防潮，否则会腐烂。破坏干草块会掉落草垛中剩余的麦粒。"
			]
			id: "2489DA471E7DDE50"
			rewards: [{
				id: "56A8B2AB0AC2C51F"
				item: "eanimod:unboundhay_block"
				type: "item"
			}]
			subtitle: "使用斧、剑或剪刀等锋利工具，作用于放置在世界中的干草垛，即可生成无束缚干草块。"
			tasks: [{
				id: "0BE7E9120345C4B5"
				item: "eanimod:unboundhay_block"
				type: "item"
			}]
			x: 2.0d
			y: 1.0d
		}
		{
			description: [
				"鸡蛋无法在物品栏中堆叠，但蛋盒在打破/拾取时会保留其物品栏内容。"
				""
				"活塞可以像破坏潜影盒一样破坏鸡蛋盒。"
			]
			id: "47DEBBAA697848C5"
			rewards: [{
				id: "3733A55396194F1F"
