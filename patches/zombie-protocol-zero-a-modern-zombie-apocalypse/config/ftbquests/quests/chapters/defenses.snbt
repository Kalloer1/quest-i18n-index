		}
		{
			dependencies: ["330390CBCFE8145F"]
			description: ["岩浆护城河几乎坚不可摧。在基地周围挖一个大坑，确保内部完全照亮，然后用岩浆填满，形成一道难以逾越的屏障，抵御那些想吃你脸的感染者。找一个较大的岩浆池，或者搭建一个岩浆泵，也可以用我们提供的储罐的桶模式收集岩浆。"]
			id: "04A430DA4689A519"
			rewards: [{
				id: "407B94391182C73A"
				item: "mekanism:advanced_fluid_tank"
				type: "item"
