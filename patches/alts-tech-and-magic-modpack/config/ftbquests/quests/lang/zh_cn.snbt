	quest.774440D8B78C40C6.quest_subtitle: "生长在岩浆块上"
	quest.77702AC030515DCA.quest_desc: ["要解锁&6精通&r，你必须完成所有前一个里程碑。"]
	quest.77702AC030515DCA.quest_subtitle: "献祭物品以获得永久增益！"
