	quest.7E216332436A9297.title: "胜利之环：FE"
	quest.7E476CE36CBF8187.quest_desc: ["&bCogwheel&r和&bLarge Cogwheel&r可以斜向连接，&bLarge Cogwheel&r旋转1次，会使&bCogwheel&r旋转2次。"]
	quest.7E476CE36CBF8187.quest_subtitle: "速度越快，应力越大，转速翻倍，应力也翻倍。"
