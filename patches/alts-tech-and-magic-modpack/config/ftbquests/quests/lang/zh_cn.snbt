	quest.781390CC2B2CA30D.quest_subtitle: "&4+30% 燃料需求&r，&a+40% 引擎功率"
	quest.78204BFF99A38018.quest_desc: ["自动合成需要一台分子组装器、一个带有模式的模式提供器和一个合成CPU。"]
	quest.7827E3F5DB53FDF7.title: "&3鱼类收集 III"
