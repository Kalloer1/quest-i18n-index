	quest.4877025DE1D89644.quest_desc: ["等的时间足够长，它们甚至会为你弹奏一曲！"]
	quest.4877025DE1D89644.quest_subtitle: "下雨的时候更可爱了！"
	quest.4877025DE1D89644.title: "找到一个Ribbit（青蛙）"
