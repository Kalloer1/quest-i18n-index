	quest.4B77EE0A74D55BEC.quest_subtitle: "由凋灵掉落。"
	quest.4BA827EDA2F6DA23.quest_desc: ["这与 Inventory Cable Connector 的工作原理完全相同，但增加了过滤功能。你可以指定要放入物品栏的具体物品，并设置诸如“保留最后一个物品”等选项。与多态过滤器结合使用时尤其有用。此外，你还可以设置优先级，来决定它是第一个插入/提取物品的物品栏，还是最后一个。"]
	quest.4BA827EDA2F6DA23.quest_subtitle: "点击了解更多详情！"
	quest.4BC010AD214A76D9.title: "获得 1024x 绯红茎干"
