	quest.18436022EF845F9C.quest_desc: ["如果需要打开大量部署器，也兼容部署器。"]
	quest.18436022EF845F9C.quest_subtitle: "右键单击以打开"
	quest.18E7804AD35799CD.title: "跑步鞋"
