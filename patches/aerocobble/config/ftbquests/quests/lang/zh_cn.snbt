	quest.7159CFA999673677.quest_subtitle: "用金锭和铜锭与烈焰燃烧器混合制成"
	quest.72198C23A0D07A3B.quest_subtitle: "当网络过载时，延迟一段时间后自动断开耦合。可用扳手重置"
