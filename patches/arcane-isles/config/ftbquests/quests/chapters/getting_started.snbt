		}
		{
			dependencies: ["03E94A057BADFC91"]
			description: ["一旦将石板放入熔炉并启动，便无法再将其移除。请谨慎选择位置！\\n\\n法力再生仪式将使你能够在限定范围内施放法术。"]
			id: "3593A3B5C8427EB2"
			tasks: [{
				id: "10818F7E4BF36F8A"
				title: "我不会打破我的仪式流程的"
