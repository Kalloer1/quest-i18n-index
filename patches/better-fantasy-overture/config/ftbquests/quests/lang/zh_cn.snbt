	quest.3ECF69B1A44C8462.title: "&9又一个锻造模板？&r"
	quest.3ED8A2DC86906211.quest_desc: [
		"&6化学溶解室&r是 x5 矿石处理装置中的第一台机器。"
		""
		"它使用&6硫酸&r将原矿转化为矿浆。"
		""
		"每溶解一种矿石，该机器会消耗 100 mB 的硫酸，并产出 1000 mb 的矿浆。"
		""
		"这种矿浆需要在&6化学洗涤机&r中进行洗涤。它也用于生产&6裂变燃料&r。"
	]
	quest.3ED8A2DC86906211.title: "&b化学溶解室&r"
	quest.3ED99C3B85068B50.quest_desc: ["                     1200HP"]
	quest.3ED99C3B85068B50.quest_subtitle: "沉没之城……"
	quest.3ED99C3B85068B50.title: "&9守卫之眼"
	quest.3EFEADBFA54E9421.quest_desc: ["&6远古遗骸是最强大的首领之一。&r它体现了曾统治沙漠沙海的远古力量。这个骸骨巨兽外形酷似一只巨大的棘龙，静静地沉睡在金字塔内殿的核心地带，直到手持沙漠项链的勇敢冒险家将其唤醒。"]
	quest.3EFEADBFA54E9421.quest_subtitle: "我一定会击败你！"
	quest.3EFEADBFA54E9421.title: "&6我一直在等你！&r"
	quest.3F157A94AFBE3D8E.quest_desc: ["主要用于制作 &b高级种子&r、&d不可摧毁的工具&r以及 &d强力的护甲&r。它是 &6终局内容&r所必需的，能够制作出 &b至尊级&r物品，包括 &6觉醒至尊锭&r。"]
	quest.3F157A94AFBE3D8E.quest_subtitle: "&4至尊精华&r是一种 &65 级&r、&5顶级的魔法资源&r"
	quest.3F157A94AFBE3D8E.title: "&4至尊精华&r"
	quest.3F22C186AC8E44F5.quest_subtitle: "5 级"
	quest.3F23C0A3FFA7700E.quest_desc: [
		"这台机器 &6能将固体材料研磨成粉尘&r。但它不会使矿石数量翻倍。"
		""
		"它主要用于两项任务：生产 &6生物燃料&r，以及作为 2、3 和 4 级矿石处理系统的重要组成部分。"
	]
	quest.3F23C0A3FFA7700E.title: "&b破碎机&r"
	quest.3F3426222B4D3864.title: "&b更多化学储罐&r"
	quest.3F38E3A1A0D2D194.quest_desc: [
		"&b无线终端&r是普通 &b有线终端&r的 &6便携版本&r。它们的用户界面与有线版本完全相同，只是 &6视图单元&r插槽被换成了 &6升级卡插槽&r。"
		""
		"要将它们与网络配对，&6请将终端插入已连接到该 &6网络&r的 &bME 无线接入点&r的右上角插槽中&r。"
		""
		"它们必须在 &bME 无线接入点&r的有效范围内才能正常工作。"
		""
		"它们的能量可以在 &b充电器&r中进行 &6充能&r。"
	]
