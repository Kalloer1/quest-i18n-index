	quest.39C6FA825F067A83.title: "&d末影龙工具"
	quest.39EF5206407A6F6F.quest_subtitle: "用于定位远古工厂。"
	quest.39EF5206407A6F6F.title: "&6机械之眼&r"
	quest.3A1A3C67BBD2A0B6.title: "&9共振护甲套装&r"
