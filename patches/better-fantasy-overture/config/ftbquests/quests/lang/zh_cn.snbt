	quest.36527B5DC7BDA86A.quest_desc: [
		"&6可以在任何将氢气输出到插槽的位置为喷气背包充能&r。"
		""
		"以下是一些示例："
		""
		"将其放入 &6电解分离器&r 的左侧输出槽（氢气输出的位置）即可（需先向机器的输入槽中加水，机器才会生成氢气）。"
		""
		"将其放入已放置在地面的 &6气体罐&r 的输出槽中。"
	]
	quest.36527B5DC7BDA86A.quest_subtitle: "一款奇幻整合包中的飞行背包……"
	quest.36527B5DC7BDA86A.title: "&b什么？飞行背包？！&r"
