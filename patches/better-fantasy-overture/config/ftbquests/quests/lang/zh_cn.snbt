	quest.639AF60F2291A1B3.title: "&b我们需要更多能量！"
	quest.63A05A4818CC82AD.quest_desc: [
		"&6太阳能发电机&r利用阳光来发电。该发电机&6特别适合为地面机器提供被动能量&r，而不会消耗 &6你的主要能源储备&r。"
		""
		"在运行期间，它会通过面板底部的接口输出 1200 J/秒（60 J/刻）。它有一个 96 kJ 的小型内部能量缓冲器。这款 &6太阳能发电机&r 的输出功率较低，实用性有限，但它的“大表哥”——&6高级太阳能发电机&r——则不同。"
	]
	quest.63A05A4818CC82AD.title: "&b太阳能发电机&r"
	quest.63CB0B1E52B019CB.quest_desc: [
		"&6化学注入室&r用于矿石处理系统。 "
		""
		"它需要大约 200 mB 的气体才能将一件物品或方块转化为另一种。这台机器用于三级矿石处理。它能用 1 块矿石生产 4 个碎片。"
	]
	quest.63CB0B1E52B019CB.title: "&b化学注入室&r"
	quest.63E103A36FAC1AFD.quest_desc: ["&6集齐八个永恒水晶，你就可以回家了。&r"]
