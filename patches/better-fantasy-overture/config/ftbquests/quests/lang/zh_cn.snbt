	quest.196E61F8A7A93B3B.title: "&6使用前请先进食。&r"
	quest.1A0A01DBF4B7EB1B.quest_desc: [
		"&d反物质颗粒&r是一种由 1,000 mB 反物质通过 &6化学结晶器&r 合成的材料。"
