	quest.637BE632196A594B.title: "&d仪式的配方！"
	quest.6389D281813635A7.quest_desc: ["&6能量跳板用于为内部及相邻库存中的可充能物品充能&r，例如箱子或任何拥有可访问库存且不含锻造能量的方块。"]
