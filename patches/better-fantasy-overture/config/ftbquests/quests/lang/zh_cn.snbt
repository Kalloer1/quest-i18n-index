	quest.3C63F320A47DF9D0.title: "&6烈焰棒&r"
	quest.3CA9957CB9157317.quest_desc: ["                          1800点生命值"]
	quest.3CA9957CB9157317.quest_subtitle: "我们该找点乐子了，不是吗？"
	quest.3CA9957CB9157317.title: "&f空间站 - &d悬浮于虚空之中"
	quest.3D44203529AA9AD1.quest_desc: [
		"这台机器&6用于将流体分离成其组成元素&r。"
		""
		"它用于将重水分离为 &6氘&r 和 &6氧&r，将 &6盐水&r 分离为钠和 &6氯&r，以及将水分离为氢和氧。这些产物会被 Mekanism 矿石处理系统使用。"
		""
		"&6可以通过水桶&r或管道系统对材料进行&r插入和提取&6。"
		""
		"两侧面用于提取产物。"
		""
		"例如，在分离水时，&6氢气&r和 &6氧气&r会分别从左侧和右侧被提取出来。"
		""
		"如果内部至少一个产物存储缓冲区已满且没有产物被取出，机器就会停止工作。如果只需要一种产物，请使用“倾倒”选项。"
	]
	quest.3D44203529AA9AD1.title: "&b电解分离器&r"
	quest.3D7F3DBDFE2199A4.quest_desc: [
		"&6守卫废弃堡垒的第一个小头目是末影傀儡。至少可以找到两个，一个在主楼层，一个在结构下方。&r它们拥有 150 点生命值和 12 点护甲。"
		""
		"&6击败它们后会奖励虚空核心，可用于召唤造成伤害的虚空符文，帮助对抗末影守卫。&r要到达末影守卫处，您必须比主废弃堡垒结构再深入两层。"
		""
		"具体来说，&6末影守卫位于末影傀儡的正下方。&r"
	]
	quest.3D7F3DBDFE2199A4.quest_subtitle: "小心……"
	quest.3D7F3DBDFE2199A4.title: "&5又一座要塞？&r"
	quest.3D8F9E74DC306D14.quest_desc: [
		"&b网络工具&r是一把&6经过改装的扳手&r，它还能显示网络诊断信息，并且&6可以存储升级卡&r。它保留了扳手快速拆解物品以及从&6线缆&r上取下子部件的能力，但无法旋转物品。"
		""
		"它有&69个插槽&r，可用于&6存储升级卡&r。只要该工具在您的物品栏中，这些升级卡就会在任何&bAE2设备界面&r中可用。"
		""
		"&6右键单击&r网络的任何部位都会显示一个诊断信息窗口，效果与&6右键单击ME控制器&r类似。"
	]
	quest.3D8F9E74DC306D14.quest_subtitle: "这会是终极扳手吗？"
	quest.3D8F9E74DC306D14.title: "&b网络工具&r"
	quest.3D9BB3778B25B971.title: "&a地灵师护甲套装"
	quest.3DA4E698C9CA696E.quest_subtitle: "第4阶"
	quest.3E0D88110186FD40.quest_desc: ["                     1680HP"]
	quest.3E0D88110186FD40.quest_subtitle: "你离我的家太远了"
	quest.3E0D88110186FD40.title: "&f一座冰封的&b城堡"
	quest.3E0FDA1E17674A67.title: "&b更多流体储罐&r"
	quest.3E621699F1FF4D7F.quest_desc: [
		"&6Mekanism&r是一款以&6阶梯式技术进阶系统&r为核心的模组。"
		""
		"它的机器和合成组件共有四个等级：基础、高级、精英和终极。"
		""
		"所有这些等级都用于各种核心功能，例如工厂（基础机器的更高容量版本）和用于储存能量的能量方块。"
	]
	quest.3E621699F1FF4D7F.quest_subtitle: "我是个 Mekanism 迷，希望你能理解……"
	quest.3E621699F1FF4D7F.title: "&fMekanism的&r&d核心&r"
	quest.3E632A9E5D930395.quest_desc: ["小声明：本章尚未完成，但很快就会完成。我保证。"]
	quest.3E632A9E5D930395.quest_subtitle: "右键单击即可打开。"
	quest.3E632A9E5D930395.title: "&d这里是以太亚！&r"
