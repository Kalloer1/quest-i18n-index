# AI 初翻，未人工校对
{
	chapter.0000000000010011.title: "1. 天空觉醒"
	chapter.000000000001050C.title: "2. 无中生有的资源"
	chapter.0000000000010A7E.title: "力量与能量"
	chapter.0000000000010F35.title: "创建"
	chapter.0000000000011474.title: "Mekanism"
	chapter.0000000000011991.title: "储物空间"
	chapter.0000000000011E8C.title: "魔法：新艺术风格（Magic: Ars Nouveau）"
	chapter.00000000000123DC.title: "魔法：神秘学（Occultism）"
	chapter.000000000001292C.title: "农业与食物"
	chapter.0000000000012E9E.title: "Immersive Engineering"
	chapter.00000000000133DD.title: "跨模组自动化系统"
	chapter.000000000001394F.title: "终局阶段"
	chapter_group.7200000000000001.title: "从这里开始"
	chapter_group.7200000000000002.title: "工坊与自动化系统 Workshops and Automation"
	chapter_group.7200000000000003.title: "魔法、农业与专业技能"
	chapter_group.7200000000000004.title: "长期游戏"
	quest.000000000000FA01.quest_desc: [
		"服务器岛屿：/sky create 可创建你自己的岛屿。要共享，所有者使用 /sky invite <player>，受邀玩家使用 /sky accept <team>。单人世界会自动创建岛屿。加入同一个 FTB Team 还可共享任务和领地。/sky home 可返回家；/sky spawn 可返回大厅。"
		"此可选分支在此结束。返回章节路线，继续方形任务或向其六边形检查点努力。"
	]
	quest.000000000000FA01.quest_subtitle: "服务器与多人游戏设置"
	quest.000000000000FA01.title: "与朋友一起玩耍"
	quest.0000000000010055.quest_desc: [
		"章节路线：木材和合成台可解锁岛屿基础。用受感染的树叶制作线，然后打开 Ex Deorum 获取网格、砾石和矿石块。带铁回来以完成水桶、可再生水源、食物和“开启物资就绪”。方形任务是主线，圆形是可选，六边形是检查点。"
		"收集任意标记类型的四根原木、树皮块或茎。原版木材、去皮变种、下界茎和模组原木均可。使用最后一根原木前，保留替换树苗并重新种植。"
		"后续路线：首先是工作台；然后是丝绸之虫和线。这些是直接使用该步骤的任务，其他前置条件也可能适用。"
	]
	quest.0000000000010055.title: "虚空中的一棵树"
	quest.0000000000010088.quest_desc: [
		"所有合成的基石。将4个木板放入2x2的方格中。"
		"后续路线：木制工具；箱子存储；树苗取水；你的拐杖；堆肥桶。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010088.title: "第一张工作台 Crafting Table"
	quest.00000000000100BB.quest_desc: [
		"制作木制镐来开采石头。"
		"后续路线：熔炉；可再生鹅卵石。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000100BB.title: "木制工具"
	quest.00000000000100EE.quest_desc: [
		"熔炼矿石、烹饪食物、制作木炭。一个必备的天空方块工具。"
		"后续路线：Fuel Before Machines; A Quick Snack。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000100EE.title: "熔炉"
	quest.0000000000010132.quest_desc: [
		"收集四块煤炭或木炭。将可再生原木炼成木炭是最简单的可持续开局；普通煤炭也算。为火把、取暖和第一个发电机留足燃料。"
		"后续路线：Let There Be Light。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010132.title: "机器之前的燃料"
	quest.0000000000010176.quest_desc: [
		"用箱子里的冰和岩浆建造一个受保护的鹅卵石生成器。打破冰块释放水，保持源头正确分离，收集16个鹅卵石。糟糕的布局会把岩浆变成黑曜石，采矿前检查流动情况。"
		"后续路线：石器时代；石砖；沙滩海岸；更多生长空间；锤子时间。这些是直接使用该步骤的任务，也可能有其他前置条件。"
	]
	quest.0000000000010176.title: "可再生鹅卵石"
	quest.00000000000101A9.quest_desc: [
		"升级你的工具。石制镐挖掘更快，也更耐用。"
		"后续路线：石剑。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000101A9.title: "石器时代"
	quest.00000000000101ED.quest_desc: [
		"用木棍和木炭制作火把。生物会在黑暗中生成。"
		"此可选分支在此结束。返回章节路线，继续方形任务或向其六边形检查点努力。"
	]
	quest.00000000000101ED.title: "要有光，就有了光"
	quest.0000000000010231.quest_desc: [
		"为你的物资制作一个箱子储物柜。任何带有兼容箱子标签的箱子都算数，所以你可以使用岛上现有的木材。"
		"后续路线：可选：Ready for Trouble; First Storage Drawer。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010231.title: "Chest Storage"
	quest.0000000000010264.quest_desc: [
		"在夜晚出现的怪物中保护自己。"
		"此可选分支在此结束。返回章节路线，继续方形任务或向其六边形检查点努力。"
	]
	quest.0000000000010264.title: "石制剑"
	quest.00000000000102A8.quest_desc: [
		"从 Ex Deorum 获取四个铁锭。筛取砾石获取铁矿石块，将四个块合成铁矿石方块，然后冶炼。资源章节会详细说明每一步。"
		"后续路线：铁镐；铁剑；建筑用桶；铁盔甲；开启物资就绪；铁粒；安山合金；魔法书；工程师之锤。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
		"来自其他章节：将区块熔炼成矿石（Ex Nihilo）。"
	]
	quest.00000000000102A8.title: "第一批铁锭 Iron Ingots"
	quest.00000000000102DB.quest_desc: [
		"一次重大的升级。铁镐可以挖掘钻石了。"
		"后续路线：可选：准备好迎接麻烦。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000102DB.title: "铁质镐"
	quest.000000000001030E.quest_desc: [
		"锋利可靠。对付怪物要好用得多。"
		"此可选分支在此结束。返回章节路线，继续方形任务或向其六边形检查点努力。"
	]
	quest.000000000001030E.title: "铁质剑"
	quest.0000000000010352.quest_desc: [
		"制作两个铁桶。它们能让你移动水源，并用初始冰块创建一个可再生水池。在瓷质坩埚可用前，保留一个岩浆源。"
		"后续路线：建造可再生水池；大型机器前需先有食物。这些是直接使用该步骤的任务；其他前置条件也可能适用。"
	]
	quest.0000000000010352.title: "用于建造的桶（Buckets for Building）"
	quest.0000000000010396.quest_desc: [
		"将原石熔炼成石头，然后用四个石头制作成石砖。平滑石是单独的方块，此配方不需要。"
		"此可选分支在此结束。返回章节路线，继续方形任务或向其六边形检查点努力。"
	]
	quest.0000000000010396.title: "石砖"
	quest.00000000000103DA.quest_desc: [
		"使用 Ex Deorum 锤子可以将砾石锤成沙子。"
		"沙子是制作玻璃、混凝土等物品的必需品。"
		"后续路线：清晰视野。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000103DA.title: "沙质海岸"
	quest.000000000001041E.quest_desc: [
		"将沙子熔炼成玻璃。你需要它来制作信标、储罐和装饰品。"
		"此可选分支在此结束。返回章节路线，继续方形任务或向其六边形检查点努力。"
	]
	quest.000000000001041E.title: "清晰视野"
	quest.0000000000010462.quest_desc: [
		"使用 Ex Deorum 木桶和多余的树苗或其他可堆肥材料来制作泥土。保留原有的草方块，以便草能蔓延到新泥土上。任何受支持的耕作土壤变体都算作收集任务的一部分。"
		"后续路线：食物优先于大型机器。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010462.title: "更多种植空间"
	quest.0000000000010495.quest_desc: [
		"保护自己。铁质盔甲能显著减少来自怪物的伤害。"
		"后续路线：可选：准备好迎接麻烦。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010495.title: "铁质盔甲"
	quest.00000000000104FB.quest_desc: [
		"收集所列的铁质装备和箱子。这是一个可选的装备检查点，不完成也可以继续主线开启。"
		"此可选分支在此结束。返回章节路线，继续方形任务或向其六边形检查点努力。"
	]
	quest.00000000000104FB.title: "可选：准备好迎接麻烦了吗"
	quest.0000000000010550.quest_desc: [
		"准备好一把 Ex Deorum 钩子。新手包里有一把，如果丢了，用 JEI 制作另一把。钩子可以换树苗和蚕。"
		"此可选分支在此结束。返回章节路线，继续方形任务或向其六边形检查点努力。"
		"来自其他章节：首个合成台（空岛基础）。"
	]
	quest.0000000000010550.title: "你的曲柄手杖"
	quest.0000000000010594.quest_desc: [
		"制作任意普通 Ex Deorum 手持筛子并安装筛网。所有木材变种均可。用筛子筛取矿石块、泥土、作物/种子、骨粉和红石粉。机械筛和压缩筛是不同类型的机器，请在 JEI 中查看各自的配方。"
		"后续路线：燧石网格；砾石制燧石；砾石制矿石块；尘土制骨粉。这些是直接使用该步骤的任务，其他前置条件也可能适用。"
	]
	quest.0000000000010594.title: "先筛选，再升级"
	quest.00000000000105D8.quest_desc: [
		"使用 JEI 用燧石升级你的线网。更好的网会改变可掉落物品及其概率；更高等级并不一定对每种产出都更好。"
		"后续路线：铁网；泥土获取源浆果；苔藓获取拱木。这些是直接使用该步骤的任务，其他前置条件也可能适用。"
	]
	quest.00000000000105D8.title: "燧石网格"
	quest.000000000001061C.quest_desc: [
		"从砾石中获得16个燧石。锤击和筛分是途径；使用JEI查看可用配方。升级现有弦网时预留四个燧石。"
		"此可选分支在此结束。返回章节路线，继续方形任务或向其六边形检查点努力。"
	]
	quest.000000000001061C.title: "从砾石中获取燧石"
	quest.0000000000010660.quest_desc: [
		"升级到铁丝网，提高筛分矿石的产量。"
		"后续路线：黄金狂热；你的第一个机械筛；锇：中流砥柱；铀或镭。这些是直接使用该步骤的任务；其他前置条件也可能适用。"
	]
	quest.0000000000010660.title: "铁质网格"
	quest.00000000000106A4.quest_desc: [
		"锤子能将方块粉碎成更小的形态：原矿 → 砾石 → 沙子 → 粉尘。"
		"后续路线：铁锤；粉碎。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
		"来自其他章节：可再生鹅卵石（空岛基础）。"
	]
	quest.00000000000106A4.title: "是时候用锤子了"
	quest.00000000000106E8.quest_desc: [
		"比石锤更耐用、速度更快。"
		"此可选分支在此结束。返回章节路线，继续方形任务或向其六边形检查点努力。"
	]
	quest.00000000000106E8.title: "铁锤 (Iron Hammer)"
	quest.000000000001072C.quest_desc: [
		"将沙子锤成粉末。粉末筛能比其他材料带来更高的矿石产量。"
		"后续路线：骨粉来自尘土；尘土与水制成黏土。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.000000000001072C.title: "轻松搞定，毫无压力！"
	quest.0000000000010770.quest_desc: [
		"收集16个铁粒，例如通过分解铁锭。Ex Deorum的砾石筛方法产出的是铁矿石块，而非这些铁粒。新的矿石块任务会教授正确的方法。"
		"此可选分支在此结束。返回章节路线，继续方形任务或向其六边形检查点努力。"
		"来自其他章节：首个铁锭（空岛基础）。"
	]
	quest.0000000000010770.title: "铁粒（Iron Nuggets）"
	quest.00000000000107B4.quest_desc: [
		"用铁丝网筛筛沙砾或碎石，寻找金块。"
		"后续路线：金网。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000107B4.title: "黄金狂热"
	quest.00000000000107F8.quest_desc: [
		"制作金网，筛分时有更大概率获得稀有掉落物。"
		"后续路线：钻石原矿；绿色代表通行。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000107F8.title: "黄金网格"
	quest.000000000001083C.quest_desc: [
		"钻石可以用金筛从沙砾或粉尘中筛出。耐心的筛分终有回报。"
		"后续路线：黑石到下界合金；大师筛选器；建造末地传送门。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.000000000001083C.title: "未经雕琢的钻石"
	quest.0000000000010880.quest_desc: [
		"制作任意 Ex Deorum 木制桶。所有木材变种均可。将多余的树苗投入堆肥箱；桶还能收集雨水并将尘土与水混合制成黏土。更换任务前请清空桶。"
		"后续路线：用备用树苗制作泥土；用尘土和水制作黏土。这些是直接使用该步骤的任务，其他前置条件也可能适用。"
		"来自其他章节：首个合成台（空岛基础）。"
	]
	quest.0000000000010880.title: "堆肥桶 (The Compost Barrel)"
	quest.00000000000108C4.quest_desc: [
		"用橡木桶里的泥土堆肥八棵备用树苗。为你的农场和树地制作八块泥土。永远不要堆肥你最后要替换的那棵树苗。"
		"此可选分支在此结束。返回章节路线，继续方形任务或向其六边形检查点努力。"
	]
	quest.00000000000108C4.title: "备用树苗中的泥土"
	quest.0000000000010908.quest_desc: [
		"熔炼一个未烧制的瓷质坩埚。将烧制好的坩埚置于有效热源（如火把）上方，然后加入鹅卵石以生成熔岩。橡木坩埚是独立的水源方块。"
		"后续路线：可再生岩浆。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010908.title: "点燃瓷质坩埚"
	quest.000000000001094C.quest_desc: [
		"从加热好的瓷坩埚中收集一个岩浆桶。开始时在下方放置火把；更快的热源是后期的升级。在将岩浆用于动力材料之前，保持鹅卵石供应可持续。"
		"后续路线：小型动力工坊；通往下界的路线。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.000000000001094C.title: "可再生岩浆"
	quest.0000000000010990.quest_desc: [
		"资源路线：筛网和手筛，砾石和矿石块，可熔矿石，然后是铁。粉尘加水得黏土；骨粉加黏土得瓷器，用于制作熔岩坩埚。可再生熔岩和初始物资可接入动力工坊。任务锁定时，请查阅跨章节前提条件。"
		"用完全被感染的树叶制作一个由九个线组成的线网。线网是第一个网格，在燧石和铁之前。筛子需要安装一个网格才能生产资源。"
		"后续路线：筛子，然后升级。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
		"来自其他章节：Silkworms and String (Skyblock Basics)。"
	]
	quest.0000000000010990.title: "编织一个线网结构 Weave a String Mesh"
	quest.00000000000109D4.quest_desc: [
		"用金筛可以从砾石中筛出绿宝石。对 Apotheosis 和交易很有用。"
		"此可选分支在此结束。返回章节路线，继续方形任务或向其六边形检查点努力。"
	]
	quest.00000000000109D4.title: "绿色代表前进"
	quest.0000000000010A18.quest_desc: [
		"Sieve Ex Deorum 将黑石粉碎以获取远古残骸。请在 JEI 中查看有效筛网和概率；已安装的钻石筛网配方每次操作有 6% 的概率。灵魂沙并非该配方的输入。"
		"后续路线：Master Sifter。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010A18.title: "从黑石到下界合金"
	quest.0000000000010A6D.quest_desc: [
		"你已解锁完整的筛分链。钻石筛网能带来最精细的产出。"
		"此可选分支在此结束。返回章节路线，继续方形任务或向其六边形检查点努力。"
	]
	quest.0000000000010A6D.title: "大师级筛选器"
	quest.0000000000010AC2.quest_desc: [
		"熔炉燃烧固体燃料以产生RF能量。"
		"在旁边放一个煤炭箱子，然后连接你的第一台机器。"
		"后续路线：Power Lines; Upgraded Generator。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
		"来自其他章节：一个小型动力工坊（Ex Nihilo）。"
	]
	quest.0000000000010AC2.title: "第一台发电机"
	quest.0000000000010B06.quest_desc: [
		"Powah 电线用于在发电机、电池和机器之间传输能量。"
		"后续路线：储能。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010B06.title: "电力线路"
	quest.0000000000010B4A.quest_desc: [
		"将RF能量存储在能量单元中。机器闲置时不再浪费电力。"
		"后续路线：Flux Networks; Bigger Battery。这些是直接使用该步骤的任务；其他前置条件也可能适用。"
	]
	quest.0000000000010B4A.title: "能量存储装置"
	quest.0000000000010B8E.quest_desc: [
		"Flux Networks 让你可以无线传输电力。"
		"将Flux Plug放置在你的发电机上，将Flux Point放置在你的机器上。"
		"后续路线：电力分配。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010B8E.title: "Flux Networks"
	quest.0000000000010BD2.quest_desc: [
		"Flux Points 从你的 Flux 网络接收能量并将其输送给机器。"
		"后续路线：网络控制器。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010BD2.title: "电力分配系统"
	quest.0000000000010C05.quest_desc: [
		"硬化熔炉器用相同的燃料能产生更多的RF/t。尽早升级。"
		"后续路线：Thermo Generator; Energizing Rod。这些是直接使用该步骤的任务；其他前置条件也可能适用。"
	]
	quest.0000000000010C05.title: "升级发电机"
	quest.0000000000010C38.quest_desc: [
		"升级你的能量电池以存储更多RF。Mekanism上线后你会需要它。"
		"后续路线：Power Broker。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010C38.title: "更大的电池"
	quest.0000000000010C7C.quest_desc: [
		"在熔岩源和水之间放置一个热发电机。"
		"它能无限产生被动RF——无需燃料。"
		"后续路线：Power Broker。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010C7C.title: "热能发电机"
	quest.0000000000010CAF.quest_desc: [
		"Flux Controller 管理着你的整个电力网络。监控输入、输出和存储。"
		"后续路线：Flux Storage; Player Power; Flux Configurator。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010CAF.title: "网络控制器"
	quest.0000000000010CE2.quest_desc: [
		"集中式 RF 存储，满足游戏后期海量需求。"
		"后续路线：Power Broker。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010CE2.title: "Flux 存储系统"
	quest.0000000000010D15.quest_desc: [
		"Powah 合成系统的核心。将其放入 Energizing Orb 中，即可合成高级 Powah 组件。"
		"后续路线：Energizing Orb。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010D15.title: "能量化棒"
	quest.0000000000010D48.quest_desc: [
		"在球体结构中放置2根棒子，开始充能合成。"
		"后续路线：Blazing Furnator。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010D48.title: "能量球 (Energizing Orb)"
	quest.0000000000010D8C.quest_desc: [
		"高级 Powah 物品的核心合成材料。在 Energizing Orb 中合成。"
		"后续路线：小型动力工坊；动力经纪人。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
		"来自其他章节：尘土与水合成黏土（Ex Nihilo）。"
	]
	quest.0000000000010D8C.title: "介电外壳"
	quest.0000000000010DBF.quest_desc: [
		"RF/t 发电量大幅提升。可满足大部分中后期电力需求。"
		"后续路线：反应堆组件；烈焰存储。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010DBF.title: "烈焰熔炉匠人"
	quest.0000000000010DF2.quest_desc: [
		"Powah Reactors 是多方块发电机，能产生巨大的 RF/t。"
		"后续路线：Reactor Online。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010DF2.title: "反应堆组件"
	quest.0000000000010E36.quest_desc: [
		"建造一个 Powah Reactor 多方块结构。"
		"控制器 + 电池 + 棒 = 巨大的发电量。"
		"后续路线：Power Broker。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010E36.title: "反应堆在线"
	quest.0000000000010E69.quest_desc: [
		"玩家发射器可为你的奇物无线充电。任务途中再也不会没电。"
		"后续路线：Power Broker。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010E69.title: "玩家的力量"
	quest.0000000000010E9C.quest_desc: [
		"制作普通的Flux Configurator来配置你的网络。管理员配置器并非生存模式的进阶目标。"
		"后续路线：Power Broker。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010E9C.title: "Flux Configurator"
	quest.0000000000010ECF.quest_desc: [
		"巨大的RF缓冲器。即使在反应堆停机期间也能让你的机器保持运行。"
		"后续路线：Power Broker。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010ECF.title: "烈焰存储系统"
	quest.0000000000010F24.quest_desc: [
		"你的电力基础设施已就绪。一个反应堆和一个通量网络——你将再也不会缺RF了。"
		"本章的终点。一条入口路线会开启检查点；其中列出的任务仍需完成。继续前往《终局：工作室成就》。"
		"工作室检查点：完成所列前置任务中的任意一个，然后完成本任务的自身任务。你不需要完成所有分支。"
		"后续路线：A Workshop Achievement。这些是直接使用该步骤的 quest；其他前提条件也可能适用。"
	]
	quest.0000000000010F24.title: "电力掮客"
	quest.0000000000010F79.quest_desc: [
		"所有早期创造机械的基础材料。用安山岩和铁粒合成。"
		"后续路线：第一齿轮。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
		"来自其他章节：首个铁锭（空岛基础）。"
	]
	quest.0000000000010F79.title: "安山岩合金"
	quest.0000000000010FBD.quest_desc: [
		"齿轮可传递旋转力。将其相邻放置，可在传动轴之间传递旋转。"
		"后续路线：Shaft Power。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000010FBD.title: "第一齿轮箱"
	quest.0000000000011001.quest_desc: [
		"传动轴将旋转力沿直线传递。建造你的第一个动力网络。"
		"后续路线：水车。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011001.title: "Shaft Power"
	quest.0000000000011045.quest_desc: [
		"将水轮放置在流动水中以生成应力单位。"
		"前期获取旋转能量的绝佳来源。"
		"后续路线：机械压机。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011045.title: "水车"
	quest.0000000000011089.quest_desc: [
		"机械压机可以粉碎和压制物品。制作板材和其他组件所必需。"
		"后续路线：盆地。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011089.title: "机械压榨机"
	quest.00000000000110CD.quest_desc: [
		"搅拌机利用旋转力混合材料。制作黄铜和许多配方所必需。"
		"后续路线：Heated Brass。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000110CD.title: "机械搅拌机"
	quest.0000000000011111.quest_desc: [
		"用加热后的创造搅拌机在盆中混合铜和锌。黄铜配方明确要求加热：用燃烧器捕捉烈焰并提供燃料。此测试版中可用的普通下界；使用沙岛上的黑曜石制作传送门。"
		"后续路线：黄铜外壳；锻造连接。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
		"来自其他章节：通往下界的路线（Ex Nihilo）。"
	]
	quest.0000000000011111.title: "加热黄铜"
	quest.0000000000011155.quest_desc: [
		"制作黄铜外壳，用于放置先进的创造机器。"
		"后续路线：Deployer; Chain Drive。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011155.title: "黄铜外壳"
	quest.0000000000011199.quest_desc: [
		"部署器使用机械臂自动与方块和实体进行交互。"
		"后续路线：自动农场；机械合成台。这些是直接使用该步骤的任务；其他前置条件也可能适用。"
	]
	quest.0000000000011199.title: "部署器"
	quest.00000000000111CC.quest_desc: [
		"将机械收割机连接到移动装置上，实现作物收割自动化。"
		"后续路线：全自动。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000111CC.title: "自动农场"
	quest.0000000000011210.quest_desc: [
		"盆用于收集压榨机和搅拌机的产物。许多合成配方都需要它。"
		"后续路线：机械搅拌机；流体管道。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011210.title: "盆地"
	quest.0000000000011254.quest_desc: [
		"使用流体管道将流体源连接到水槽、储罐和出水口。"
		"后续路线：机械泵。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011254.title: "流体管道"
	quest.0000000000011298.quest_desc: [
		"泵通过管道输送流体。需要旋转动力才能运行。"
		"后续路线：蒸汽引擎。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011298.title: "机械水泵"
	quest.00000000000112DC.quest_desc: [
		"蒸汽机产生的压力单位远多于水车。"
		"用岩浆或固体燃料加热锅炉，以获得高输出的旋转动力。"
		"后续路线：全自动。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000112DC.title: "蒸汽引擎"
	quest.000000000001130F.quest_desc: [
		"用机械合成阵列自动化无定形和定形合成配方。"
		"后续路线：机械臂；全自动。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.000000000001130F.title: "机械合成台"
	quest.0000000000011353.quest_desc: [
		"用链传动将旋转动力传输到远距离。"
		"后续路线：速度控制。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011353.title: "链式传动装置"
	quest.0000000000011386.quest_desc: [
		"精确控制旋转网络的转速，实现精准机械操作。"
		"后续路线：全自动。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011386.title: "速度控制"
	quest.00000000000113CA.quest_desc: [
		"机械臂可自动在物品栏和机器之间移动物品。"
		"后续路线：便携式接口；全自动。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000113CA.title: "机械臂"
	quest.00000000000113FD.quest_desc: [
		"通过固定方块访问移动装置的物品栏。"
		"后续路线：全自动。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000113FD.title: "便携式接口"
	quest.0000000000011463.quest_desc: [
		"你的创造工厂正在嗡嗡作响。"
		"蒸汽动力、自动化合成和移动装置——这座空岛真正活了起来。"
		"本章的终点。一条入口路线会开启检查点；其中列出的任务仍需完成。继续前往《终局：工作室成就》。"
		"工作室检查点：完成所列前置任务中的任意一个，然后完成本任务的自身任务。你不需要完成所有分支。"
		"后续路线：A Workshop Achievement。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011463.title: "全自动自动化系统"
	quest.00000000000114B8.quest_desc: [
		"能量立方体储存RF，并将Mekanism与其他电力系统连接。"
		"后续路线：富集室。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000114B8.title: "Mekanism 能源"
	quest.00000000000114FC.quest_desc: [
		"锇是Mekanism的主要金属。"
		"筛分砾石或粉尘以寻找锇矿石块。"
		"后续路线：冶金注入器。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
		"来自其他章节：铁网 (Ex Nihilo)。"
	]
	quest.00000000000114FC.title: "锇：中流砥柱"
	quest.0000000000011540.quest_desc: [
		"将矿石加工量翻倍。放入原矿可获得2倍数量的锭。"
		"后续路线：破碎机。这些是直接使用该步骤的任务；可能还有其他前提条件。"
	]
	quest.0000000000011540.title: "富集室"
	quest.0000000000011584.quest_desc: [
		"破碎机将材料研磨成团块和粉末，以供进一步处理。"
		"后续路线：电解分离器。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011584.title: "破碎机"
	quest.00000000000115C8.quest_desc: [
		"净化室+破碎机+富集室组合能产出3倍矿石。"
		"需要电解分离器产生的氧气气体。"
		"后续路线：Mekanism Mastery。这些是直接使用该步骤的 quest；其他前提条件也可能适用。"
	]
	quest.00000000000115C8.title: "3x 矿石加工"
	quest.000000000001160C.quest_desc: [
		"将水分解为氢气和氧气。氧气提供3倍处理功率；氢气为燃气燃烧器供能。"
		"后续路线：3x 矿石加工；4x 加工；电动泵。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.000000000001160C.title: "电解分离机"
	quest.0000000000011650.quest_desc: [
		"添加化学注射室（使用氯化氢）以提高4倍矿石产量。"
		"后续路线：5x 处理。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011650.title: "4x 处理中"
	quest.0000000000011694.quest_desc: [
		"包含化学结晶器的完整5步处理链可产出5倍矿石。效率最大化。"
		"后续路线：Mekanism Mastery。这些是直接使用该步骤的 quest；其他前提条件也可能适用。"
	]
	quest.0000000000011694.title: "5x 处理中"
	quest.00000000000116D8.quest_desc: [
		"自动化电解分离器和流体需求的无限供水。"
		"后续路线：Mekanism Mastery。这些是直接使用该步骤的 quest；其他前提条件也可能适用。"
	]
	quest.00000000000116D8.title: "电动水泵"
	quest.000000000001171C.quest_desc: [
		"将金属与碳、红石、钻石等融合，创造合金。"
		"后续路线：Infused Alloy。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
		"来自其他章节：锻造连接（跨模组自动化）。"
	]
	quest.000000000001171C.title: "冶金学注入器"
	quest.0000000000011760.quest_desc: [
		"高级Mekanism机器的基础合成材料。在融合器中用锇和红石合成。"
		"后续路线：Mekanism 能源；强化合金；太阳能；Manaforged 合金。这些是直接使用该步骤的任务，其他前置条件也可能适用。"
	]
	quest.0000000000011760.title: "Infused Alloy"
	quest.00000000000117A4.quest_desc: [
		"用钻石注入强化合金。三级机器所需。"
		"后续路线：数字矿工；量子纠缠传送器；锻造天空核心。这些是直接使用该步骤的任务；其他前置条件也可能适用。"
	]
	quest.00000000000117A4.title: "强化合金 Reinforced Alloy"
	quest.00000000000117D7.quest_desc: [
		"一种强大的采矿机，使用过滤器从世界中提取特定矿石。"
		"后续路线：Mekanism Mastery。这些是直接使用该步骤的 quest；其他前提条件也可能适用。"
	]
	quest.00000000000117D7.title: "数字矿工"
	quest.000000000001180A.quest_desc: [
		"在世界中的任意两点之间无线传输物品、流体和能量。"
		"后续路线：配方组装器。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.000000000001180A.title: "量子纠缠传送器"
	quest.000000000001184E.quest_desc: [
		"Mekanism太阳能发电机在白天会被动地产生RF。"
		"后续路线：风力发电机。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.000000000001184E.title: "太阳能发电"
	quest.0000000000011892.quest_desc: [
		"风力发电机根据高度产生RF。建得越高，发电量越大。"
		"后续路线：裂变反应堆外壳。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011892.title: "风力发电机"
	quest.00000000000118C5.quest_desc: [
		"制作裂变反应堆外壳。这是一个组件里程碑，并非已组装、加燃料或安全的反应堆的证明。请遵循已安装的 Mekanism 指南，在运行前提供冷却剂和废料处理方案。"
		"后续路线：感应矩阵外壳。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000118C5.title: "裂变反应堆外壳"
	quest.00000000000118F8.quest_desc: [
		"使用编码配方自动化合成。与AE2或RS完美搭配。"
		"后续路线：Mekanism Mastery。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000118F8.title: "配方合成器 (Formulaic Assemblicator)"
	quest.000000000001192B.quest_desc: [
		"制作感应外壳。要储存能量，你还需要有效的结构、端口、电池和电源。任务检测的是外壳，而非一个能正常工作的能量缓冲器。"
		"后续路线：Mekanism Mastery。这些是直接使用该步骤的 quest；其他前提条件也可能适用。"
	]
	quest.000000000001192B.title: "感应矩阵外壳"
	quest.0000000000011980.quest_desc: [
		"5x 矿石处理器和一个感应矩阵。工厂车间已全面投入运行。"
		"本章的终点。一条入口路线会开启检查点；其中列出的任务仍需完成。继续前往《终局：工作室成就》。"
		"工作室检查点：完成所列前置任务中的任意一个，然后完成本任务的自身任务。你不需要完成所有分支。"
		"后续路线：A Workshop Achievement。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011980.title: "Mekanism 精通"
	quest.00000000000119D5.quest_desc: [
		"储物抽屉可存放大量单一物品。非常适合存放大宗材料。"
		"后续路线：抽屉控制器；精致存储。这些是直接使用该步骤的任务；可能还有其他前提条件。"
		"来自其他章节：Chest Storage (Skyblock Basics)。"
	]
	quest.00000000000119D5.title: "第一个储物抽屉"
	quest.0000000000011A08.quest_desc: [
		"抽屉控制器就像一个中心枢纽。将物品放入管道，它们会自动分类到正确的抽屉中。"
		"后续路线：Refined Storage Controller; AE2 Controller; LaserIO。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011A08.title: "抽屉控制器"
	quest.0000000000011A4C.quest_desc: [
		"复杂的箱子能装更多物品，并且可以用升级槽进行升级。"
		"后续路线：铁质箱子升级；背包。这些是直接使用该步骤的任务；其他前置条件也可能适用。"
	]
	quest.0000000000011A4C.title: "Sophisticated Storage"
	quest.0000000000011A7F.quest_desc: [
		"升级到铁质复杂箱子以获得更大的物品容量。"
		"后续路线：Colossal Chest Interface。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011A7F.title: "铁质箱子升级"
	quest.0000000000011AC3.quest_desc: [
		"Sophisticated Backpacks 添加了便携储物功能，让你随时随地都能存取物品。"
		"后续路线：Dank Storage；Iron Backpack。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011AC3.title: "背包"
	quest.0000000000011B07.quest_desc: [
		"RS 控制器是你 Refined Storage 网络的控制中心。"
		"用线缆将驱动器和终端连接到它上。"
		"后续路线：Disk Drive。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011B07.title: "Refined Storage 控制器"
	quest.0000000000011B4B.quest_desc: [
		"将存储磁盘插入磁盘驱动器，为您的 RS 网络提供存储容量。"
		"后续路线：1K 存储磁盘。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011B4B.title: "磁盘驱动器"
	quest.0000000000011B8F.quest_desc: [
		"制作一个 Refined Storage 1K 存储磁盘，并将其放入已供电的磁盘驱动器中。使用 JEI 中显示的已安装的 2.x 配方。"
		"后续路线：合成网格；64K存储磁盘。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011B8F.title: "1K 存储磁盘"
	quest.0000000000011BC2.quest_desc: [
		"RS 合成网格让你可以直接使用网络中的材料来合成物品。"
		"后续路线：模式网格。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011BC2.title: "合成网格"
	quest.0000000000011BF5.quest_desc: [
		"将合成配方编码，教会你的 RS 网络如何自动合成物品。"
		"后续路线：自动合成器。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011BF5.title: "模式方块表"
	quest.0000000000011C39.quest_desc: [
		"制作一个 Refined Storage 自动合成器，提供配方并将其连接到已供电的网络。此功能检测的是方块，而非已完成的制作任务。"
		"后续路线：自动化合成路线已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011C39.title: "自动合成台"
	quest.0000000000011C7D.quest_desc: [
		"为您的 RS 网络提供巨大的存储容量。"
		"后续路线：自动化合成路线已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011C7D.title: "64K 存储磁盘"
	quest.0000000000011CC1.quest_desc: [
		"Applied Energistics 2 是目前最强大的存储系统。"
		"先建造控制器，然后连接你的第一个驱动器。"
		"后续路线：ME Drive。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011CC1.title: "AE2 控制器"
	quest.0000000000011D05.quest_desc: [
		"ME Drive 用于存储单元。组合多个驱动器以获得超大容量。"
		"后续路线：AE2 自动合成。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011D05.title: "ME 驱动器"
	quest.0000000000011D38.quest_desc: [
		"连接合成单元和合成监视器，构建强大的自动合成系统。"
		"后续路线：自动化合成路线已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011D38.title: "AE2 自动合成"
	quest.0000000000011D7C.quest_desc: [
		"便携式批量存储。Dank 可以在你的物品栏中存放数百万个单一物品。"
		"后续路线：自动化合成路线已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011D7C.title: "Dank Storage"
	quest.0000000000011DAF.quest_desc: [
		"制作木制巨型箱子接口。使用模组的核心和墙壁方块组装一个有效的箱子；仅接口本身不是一个能正常工作的多方块结构。"
		"后续路线：自动化合成路线已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011DAF.title: "巨型箱子接口 (Colossal Chest Interface)"
	quest.0000000000011DE2.quest_desc: [
		"升级后的背包，拥有更多格子和升级能力。"
		"后续路线：自动化合成路线已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011DE2.title: "铁质背包"
	quest.0000000000011E26.quest_desc: [
		"LaserIO 使用激光无线传输物品、流体和能量，无需铺设管道。"
		"后续路线：自动化合成路线已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011E26.title: "LaserIO"
	quest.0000000000011E7B.quest_desc: [
		"选择AE2或Refined Storage。完成该分支后，拥有一个AE2 Crafting Unit或Refined Storage Autocrafter。无需建造另一个网络。这是一个装备检查点；添加配方、能量和存储以创建一个可用的服务。"
		"本章的终点。一条入口路线会开启检查点；其中列出的任务仍需完成。继续前往《终局：工作室成就》。"
		"工作室检查点：完成所列前置任务中的任意一个，然后完成本任务的自身任务。你不需要完成所有分支。"
		"后续路线：A Workshop Achievement。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011E7B.title: "自动化合成路线已建立"
	quest.0000000000011ED0.quest_desc: [
		"Ars Nouveau 让你能用符文构建自定义法术。"
		"从初级魔法书和第一个符文开始。"
		"后续路线：法术羊皮纸。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
		"来自其他章节：首个铁锭（空岛基础）。"
	]
	quest.0000000000011ED0.title: "魔法书 The Spell Book"
	quest.0000000000011F14.quest_desc: [
		"源是 Ars Nouveau 的魔力。将源罐放置在源中继器或源宝石附近即可填充。"
		"后续路线：源中继器；农业源链接。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011F14.title: "源文件存档"
	quest.0000000000011F58.quest_desc: [
		"用燧石筛网筛土，获得源浆果灌木。在岛上种植它们，并与源连接器一同使用。源罐不产生浆果，此获取步骤在先。"
		"后续路线：Agronomic Sourcelink。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
		"来自其他章节：燧石网格（Ex Nihilo）。"
	]
	quest.0000000000011F58.title: "泥土中的源浆果 Sourceberries from Dirt"
	quest.0000000000011F9C.quest_desc: [
		"制作咒语羊皮纸以书写咒语。将其放入咒语书中即可创建可用的咒语。"
		"后续路线：第一枚符文。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011F9C.title: "法术羊皮纸"
	quest.0000000000011FE0.quest_desc: [
		"符文是法术的基本单位。增幅能提高法术的威力。"
		"后续路线：大法师。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000011FE0.title: "第一符文"
	quest.0000000000012024.quest_desc: [
		"中继器可以在罐子之间传输源。建造一个网络来保持你的源充足。"
		"后续路线：大法师。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012024.title: "源中继器"
	quest.0000000000012068.quest_desc: [
		"通过苔藓筛选法生长拱木。用拱木板和金制作浸染室，再放入青金石以获取源宝石。无需中继器即可开始此过程；源宝石能解锁更多 Ars 装备和魔钢合金。"
		"后续路线：Manaforged Alloy; Source Relay; Arcane Core; Jar of Light。这些是直接使用该步骤的任务；其他前置条件也可能适用。"
	]
	quest.0000000000012068.title: "源宝石优先"
	quest.00000000000120AC.quest_desc: [
		"秘法核心是制作高级新艺术组件的制造台。"
		"后续路线：学徒魔法书。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000120AC.title: "神秘核心"
	quest.00000000000120F0.quest_desc: [
		"升级你的魔法书，解锁更复杂的法术和更高阶的符文。"
		"后续路线：飞行准备；威克西；魔法镜；大法师咒语书。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000120F0.title: "学徒魔法书"
	quest.0000000000012123.quest_desc: [
		"发射符文是迈向梦寐以求的阿特·努沃飞行法术的一步。"
		"后续路线：大法师。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012123.title: "飞行准备"
	quest.0000000000012167.quest_desc: [
		"永恒的光源。制作并放置在任何地方即可获得永久照明。"
		"后续路线：大法师。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012167.title: "Jar of Light"
	quest.000000000001219A.quest_desc: [
		"Wixies 是能够自动酿造药水的魔法伙伴。"
		"后续路线：Drygmy Charm。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.000000000001219A.title: "Wixie"
	quest.00000000000121DE.quest_desc: [
		"传送到指定位置。对于快速返回基地来说非常宝贵。"
		"后续路线：大法师。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000121DE.title: "魔法的镜子"
	quest.0000000000012222.quest_desc: [
		"最高阶的魔法书。解锁 Ars Nouveau 中最强大的符文。"
		"后续路线：飞行仪式。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012222.title: "大魔导师的魔法书"
	quest.0000000000012266.quest_desc: [
		"合成飞行石板，并在 Ars 指南中阅读其仪式条目。使用文档中记载的仪式设置和源材料要求来激活它；这并非飞行符文。"
		"后续路线：大法师。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012266.title: "飞行仪式"
	quest.00000000000122AA.quest_desc: [
		"从附近的植物生长中生成源。放置在农场旁边以实现被动源生成。"
		"后续路线：Volcanic Sourcelink。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000122AA.title: "农业学源链接 Agronomic Sourcelink"
	quest.00000000000122EE.quest_desc: [
		"利用热量产生源。放置在岩浆附近可获得快速稳定的源供应。"
		"后续路线：大法师。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000122EE.title: "火山源链接 Volcanic Sourcelink"
	quest.0000000000012332.quest_desc: [
		"Drygmies 是一种宠物，靠近生物时能被动地收集生物掉落物。"
		"后续路线：Whirlisprig。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012332.title: "干地格米护身符"
	quest.0000000000012376.quest_desc: [
		"Whirlisprig 使魔能加速植物生长。放置在农场附近可被动收获作物。"
		"后续路线：大法师。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012376.title: "Whirlisprig"
	quest.00000000000123CB.quest_desc: [
		"拥有《大法师咒语书》和《飞行石板》。这些是装备里程碑；仪式仍需正确设置才能运行。"
		"本章的终点。一条入口路线会开启检查点；其中列出的任务仍需完成。继续前往《终局：工作室成就》。"
		"工作室检查点：完成所列前置任务中的任意一个，然后完成本任务的自身任务。你不需要完成所有分支。"
		"后续路线：A Workshop Achievement。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000123CB.title: "大法师 (The Archmage)"
	quest.0000000000012420.quest_desc: [
		"动物脂肪可以炼成动物油，是 Occultism 合成的基础材料。"
		"杀死猪或牛收集生脂肪，然后将其冶炼。"
		"后续路线：Otherstone; Dictionary of Spirits。这些是直接使用该步骤的任务；可能还有其他前提条件。"
	]
	quest.0000000000012420.title: "第一桶牛脂"
	quest.0000000000012464.quest_desc: [
		"用动物脂肪和石头合成Otherstone。这是Occultism建筑的建筑材料。"
		"后续路线：Spirit-Attuned Gem; Otherstone Frame。这些是直接使用该步骤的任务；其他前置条件也可能适用。"
	]
	quest.0000000000012464.title: "其他石头"
	quest.00000000000124A8.quest_desc: [
		"与灵体共鸣的宝石能引导精神能量。是召唤仪式的必需品。"
		"后续路线：五芒星。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000124A8.title: "与精神共鸣的宝石"
	quest.00000000000124EC.quest_desc: [
		"在地上画一个五芒星，创建一个仪式圈。所有召唤的基础。"
		"后续路线：Golden Chalk; Spirit Storage; Foliot Miner。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000124EC.title: "五芒星"
	quest.0000000000012530.quest_desc: [
		"制作一个祭品碗，并使用《灵界词典》来建造正确的五芒星。仪式使用碗及其记载的配方，而非生存模式中的仪式道具。"
		"后续路线：五芒星；灵魂宝石。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012530.title: "献祭碗 (The Sacrificial Bowl)"
	quest.0000000000012574.quest_desc: [
		"《Occultism》指南。仔细阅读——里面包含了所有你需要的仪式和召唤。"
		"后续路线：The Sacrificial Bowl。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012574.title: "灵体词典"
	quest.00000000000125B8.quest_desc: [
		"使用金粉在地板上画出仪式五芒星。"
		"后续路线：Otherworldly Rituals。这些是直接使用该步骤的任务；可能还有其他前提条件。"
	]
	quest.00000000000125B8.title: "黄金粉笔"
	quest.00000000000125FC.quest_desc: [
		"制作其他石头框架，用于你的存储和召唤基础设施。"
		"后续路线：Master of Spirits。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000125FC.title: "Otherstone 框架"
	quest.0000000000012640.quest_desc: [
		"Occultism 的维度存储使用召唤出的灵魂将物品储存在其他维度中。"
		"建造存储控制器以开始游戏。"
		"后续路线：稳定虫洞。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012640.title: "灵魂存储装置"
	quest.0000000000012684.quest_desc: [
		"将你的 Occultism 存储网络与稳定的虫洞连接以实现远程访问。"
		"后续路线：Storage Remote。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012684.title: "稳定的虫洞"
	quest.00000000000126C8.quest_desc: [
		"召唤一个Foliot矿工灵魂，为你从灵魂维度开采矿石。"
		"后续路线：Djinni Miner。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000126C8.title: "Foliot Miner"
	quest.000000000001270C.quest_desc: [
		"升级到Djinni矿工，从灵界获得更多矿石回报。"
		"后续路线：Afrit Miner。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.000000000001270C.title: "Djinni Miner"
	quest.0000000000012750.quest_desc: [
		"阿夫里特矿工深入维度寻找稀有材料。"
		"后续路线：Marid Miner。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012750.title: "阿夫里特矿工"
	quest.0000000000012794.quest_desc: [
		"马里德是最强大的矿工之灵。它能带回最稀有的矿石，而且数量众多。"
		"后续路线：Master of Spirits。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012794.title: "马里德矿工"
	quest.00000000000127D8.quest_desc: [
		"在灵魂宝石中捕捉生物的灵魂，创造永久的灵魂仆从和伙伴。"
		"后续路线：Familiar Ring。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000127D8.title: "灵魂宝石"
	quest.000000000001281C.quest_desc: [
		"将一只宠物绑定到戒指上，并将其作为奇物装备以获得被动加成。"
		"后续路线：Spirit Worker。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.000000000001281C.title: "熟悉的戒指 (Familiar Ring)"
	quest.000000000001284F.quest_desc: [
		"执行高级召唤仪式，将强大的实体召唤来助你一臂之力。"
		"后续路线：Master of Spirits。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.000000000001284F.title: "异界仪式 (Otherworldly Rituals)"
	quest.0000000000012893.quest_desc: [
		"使用存储遥控器，随时随地访问你的 Occultism 维度存储空间。"
		"后续路线：Master of Spirits。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012893.title: "远程存储设备"
	quest.00000000000128C6.quest_desc: [
		"制作一个矿石破碎机灵，自动被动地处理矿石。"
		"后续路线：Master of Spirits。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000128C6.title: "灵魂工匠"
	quest.000000000001291B.quest_desc: [
		"灵魂为你采矿，为你储藏，为你而战。神秘术属于你。"
		"本章的终点。一条入口路线会开启检查点；其中列出的任务仍需完成。继续前往《终局：工作室成就》。"
		"工作室检查点：完成所列前置任务中的任意一个，然后完成本任务的自身任务。你不需要完成所有分支。"
		"后续路线：A Workshop Achievement。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.000000000001291B.title: "灵魂大师"
	quest.0000000000012970.quest_desc: [
		"收集所需数量的农作物：小麦、胡萝卜、马铃薯、甜菜根，或 Farmer's Delight 支持的作物。作物种类可合并计算。在使用最后一些种子或作物前，请先重新种植。"
		"后续路线：农夫的砧板；稻草；勤劳的蜜蜂；虚空中的繁荣。这些是直接使用该步骤的任务，也可能有其他前置条件。"
	]
	quest.0000000000012970.title: "首次丰收"
	quest.00000000000129B4.quest_desc: [
		"Farmer’s Delight 添加了逼真的烹饪机制。"
		"砧板可以让你准备食材。"
		"后续路线：烹饪锅。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000129B4.title: "农夫的砧板"
	quest.00000000000129F8.quest_desc: [
		"在烹饪锅中制作复杂的菜肴。更美味的食物能提供更强的饱腹感。"
		"后续路线：水产养殖；农场市场；一顿像样的饭。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000129F8.title: "烹饪锅"
	quest.0000000000012A3C.quest_desc: [
		"用小麦制作稻草。可用于农夫之乐配方和生物巢穴。"
		"后续路线：可再生能源生产已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012A3C.title: "干草块"
	quest.0000000000012A80.quest_desc: [
		"Mystical Agriculture 让你可以把矿石和材料当作物来种植。"
		"Inferium 种子是你的起点——种植它们以获得精华。"
		"后续路线：Inferium Essence; BotanyPots。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012A80.title: "Inferium 种子"
	quest.0000000000012AC4.quest_desc: [
		"收割inferium作物以获得精华。更高级的精华由inferium合成。"
		"后续路线：Prudentium Essence; Watering Can。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012AC4.title: "Inferium 精华"
	quest.0000000000012B08.quest_desc: [
		"使用灌注水晶结合 Inferium Essence 以获得 Prudentium Essence。这是一种材料等级，而非通用的 prudentium 种子。"
		"后续路线：铁种子。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012B08.title: "审慎精华 (Prudentium Essence)"
	quest.0000000000012B4C.quest_desc: [
		"种植铁种子可产出铁精，可锻造为铁锭。无限铁！"
		"后续路线：钻石种子。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012B4C.title: "铁质种子"
	quest.0000000000012B90.quest_desc: [
		"将钻石作为作物种植。需要更高等级的精华才能解锁。"
		"后续路线：Supremium Essence。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012B90.title: "钻石种子"
	quest.0000000000012BD4.quest_desc: [
		"BotanyPots 占用空间小，可种植作物。填入合适的土壤，即可种植任何种子。"
		"后续路线：Hopper BotanyPot。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012BD4.title: "BotanyPots"
	quest.0000000000012C18.quest_desc: [
		"使用漏斗植物学花盆自动化作物收割，作物将自动收集到下方的箱子中。"
		"后续路线：可再生能源生产已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012C18.title: "漏斗植物学花盆 BotanyPot"
	quest.0000000000012C5C.quest_desc: [
		"Productive Bees 添加了可被动生产资源的自定义蜜蜂。"
		"捕捉并繁殖蜜蜂以生产铁、金、钻石等物品。"
		"后续路线：高级蜂巢。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012C5C.title: "勤劳的蜜蜂模组 (Productive Bees)"
	quest.0000000000012CA0.quest_desc: [
		"高级蜂巢会自动将蜂巢处理成资源。"
		"后续路线：可再生能源生产已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012CA0.title: "高级蜂巢"
	quest.0000000000012CE4.quest_desc: [
		"Aquaculture 增加了新的鱼类和渔具，让钓鱼更有趣。一种放松的食物来源。"
		"后续路线：可再生能源生产已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012CE4.title: "Aquaculture"
	quest.0000000000012D28.quest_desc: [
		"使用合适的晶体来提升精华等级。Supremium 是一种用于制作高级资源作物的精华等级，并非普通的 supremium 种子。"
		"后续路线：下界合金种子。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012D28.title: "Supremium Essence"
	quest.0000000000012D6C.quest_desc: [
		"将下界合金废料作为作物种植。资源自动化的巅峰之作。"
		"后续路线：可再生能源生产已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012D6C.title: "下界合金种子"
	quest.0000000000012DB0.quest_desc: [
		"用洒水壶加速作物生长。更高等级可作用于更大区域。"
		"后续路线：可再生能源生产已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012DB0.title: "浇水壶"
	quest.0000000000012DE3.quest_desc: [
		"Farming for Blockheads 市场可以让你购买种子和其他农业材料。"
		"后续路线：可再生能源生产已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012DE3.title: "农业市场"
	quest.0000000000012E27.quest_desc: [
		"使用农夫的喜悦烹饪锅烹饪炒饭。使用JEI查看所需的大米、鸡蛋、蔬菜和容器的具体配方。在开始烹饪前，请先种植或获取这些材料。"
		"后续路线：可再生能源生产已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012E27.title: "一顿像样的饭菜"
	quest.0000000000012E8D.quest_desc: [
		"选择作物、漏斗盆或蜜蜂路线。铁/下界合金种子、任意漏斗植物盆或任意高级蜂箱都算。提供所需的作物/蜜蜂并验证产出。其他分支为可选扩展。"
		"本章的终点。一条入口路线会开启检查点；其中列出的任务仍需完成。继续前往《终局：工作室成就》。"
		"工作室检查点：完成所列前置任务中的任意一个，然后完成本任务的自身任务。你不需要完成所有分支。"
		"后续路线：A Workshop Achievement。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012E8D.title: "可持续生产已建立"
	quest.0000000000012EE2.quest_desc: [
		"IE 锤子可以组成多区块和面板。没有它就无法建造 IE 机器。"
		"后续路线：铜线；传送带；化学投掷器；电路前的钢铁。这些是直接使用该步骤的任务；其他前置条件也可能适用。"
		"来自其他章节：首个铁锭（空岛基础）。"
	]
	quest.0000000000012EE2.title: "工程师的锤子"
	quest.0000000000012F26.quest_desc: [
		"IE 使用电线和连接器来传输电力。铜线是你的第一层级。"
		"后续路线：LV Capacitor。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012F26.title: "铜线"
	quest.0000000000012F6A.quest_desc: [
		"LV电容器可储存IE能量(IF)。开始建设你的电力基础设施。"
		"后续路线：水磨坊；热电发电机。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000012F6A.title: "LV电容器"
	quest.0000000000012FAE.quest_desc: [
		"IE 水磨坊可通过流动的水被动地生成 IF。"
		"后续路线：IE Crusher; Garden Cloche; Windmill。这些是直接使用该步骤的任务；其他前置条件也可能适用。"
	]
	quest.0000000000012FAE.title: "水车磨坊"
	quest.0000000000012FF2.quest_desc: [
		"IE 破碎机将矿石研磨成2倍粉尘产量。"
		"这是一个多方块结构——用锤子来建造它。"
		"后续路线：电弧炉电极；金属压制齿轮模具。这些是直接使用该步骤的任务；其他前置条件也可能适用。"
	]
	quest.0000000000012FF2.title: "工业破碎机 (Industrial Crusher)"
	quest.0000000000013036.quest_desc: [
		"为IE电弧炉制作石墨电极。此任务检测电极，而非组装好的熔炉。使用工程师手册查看多方块结构，并提供适当的能量和输入。"
		"后续路线：MV Wiring。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013036.title: "电弧熔炉电极"
	quest.000000000001307A.quest_desc: [
		"制作金属压模齿轮模具。此任务会检测模具；使用工程师手册组装压机，并配置传送带、动力和输入。"
		"后续路线：Assembler。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.000000000001307A.title: "金属压制齿轮模具"
	quest.00000000000130BE.quest_desc: [
		"利用温差发电。置于熔岩和冰/水之间可被动发电。"
		"后续路线：工业革命。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000130BE.title: "热电发电机"
	quest.0000000000013102.quest_desc: [
		"升级到MV电线以实现更高吞吐量的电力传输。"
		"后续路线：挖掘机；炼油厂；轨道炮。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013102.title: "MV 布线系统"
	quest.0000000000013146.quest_desc: [
		"巨大的挖掘机多区块结构会被动挖掘巨大的矿脉。"
		"后续路线：工业革命。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013146.title: "挖掘机"
	quest.000000000001318A.quest_desc: [
		"IE合成器会根据存储的配方，通过管道输入自动合成物品。"
		"后续路线：自动工作台；工业革命。这些是直接使用该步骤的任务；其他前置条件也可能适用。"
	]
	quest.000000000001318A.title: "装配器"
	quest.00000000000131CE.quest_desc: [
		"用工业工程传送带在工厂里搬运物品。"
		"后续路线：工业革命。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000131CE.title: "传送带系统 (Conveyor Belts)"
	quest.0000000000013212.quest_desc: [
		"花园罩子利用水和肥料，在一个方块内自动化作物生长。"
		"后续路线：工业革命。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013212.title: "花园玻璃罩"
	quest.0000000000013245.quest_desc: [
		"使用存储的配方自动合成物品。比合成器更便宜的替代方案。"
		"后续路线：工业革命。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013245.title: "自动工作台"
	quest.0000000000013289.quest_desc: [
		"建造一个大型风车多方块结构，以获得稳定的被动IF来源。"
		"后续路线：工业革命。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013289.title: "风车"
	quest.00000000000132BC.quest_desc: [
		"柴油发电机燃烧生物柴油以获得极高的IF输出。"
		"后续路线：工业革命。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000132BC.title: "柴油发电机"
	quest.00000000000132EF.quest_desc: [
		"精炼厂用植物油和乙醇生产生物柴油。为你的柴油发电机加油。"
		"后续路线：柴油发电机。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000132EF.title: "精炼厂"
	quest.0000000000013333.quest_desc: [
		"一种火焰喷射器风格的武器。向敌人喷洒液体，造成毁灭性效果。"
		"后续路线：工业革命。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013333.title: "化学投掷器"
	quest.0000000000013377.quest_desc: [
		"一种以惊人速度发射金属尖刺的高科技武器。"
		"后续路线：工业革命。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013377.title: "轨道炮"
	quest.00000000000133CC.quest_desc: [
		"工厂可以自动运行。挖掘机采矿，装配器制造，传送带运输一切。"
		"本章的终点。一条入口路线会开启检查点；其中列出的任务仍需完成。继续前往《终局：工作室成就》。"
		"工作室检查点：完成所列前置任务中的任意一个，然后完成本任务的自身任务。你不需要完成所有分支。"
		"后续路线：A Workshop Achievement。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000133CC.title: "工业革命"
	quest.0000000000013421.quest_desc: [
		"LaserIO 节点可在任意两个方块之间无线传输物品、流体和能量。"
		"没有管道，没有电缆——只有激光。"
		"后续路线：流体激光；管道。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013421.title: "LaserIO 基础篇"
	quest.0000000000013465.quest_desc: [
		"激光流体节点可无线传输液体。非常适合Mekanism和Create的流体系统。"
		"后续路线：能量激光。这些是直接使用该步骤的 quest；其他前提条件也可能适用。"
	]
	quest.0000000000013465.title: "流体激光器"
	quest.00000000000134A9.quest_desc: [
		"使用能量激光节点在发电机和机器之间无线传输RF。"
		"后续路线：XNet 控制器。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000134A9.title: "能量激光枪"
	quest.00000000000134ED.quest_desc: [
		"Pipez 提供简单、廉价的物品/流体/能量/气体管道，方便快速连接。"
		"后续路线：A Compact Workshop; RFTools Shards; Ex Compressum。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000134ED.title: "管道匠模组"
	quest.0000000000013531.quest_desc: [
		"XNet 是一个强大的基于线缆的物品/流体/能量路由系统。"
		"在控制器上编写程序，创建复杂的自动化逻辑。"
		"后续路线：无线合成终端；自动化路线已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013531.title: "XNet 控制器"
	quest.0000000000013564.quest_desc: [
		"使用Create材料和IE钢锻造一个锻造核心。这是冶金注入器所需的通用工业组件。"
		"后续路线：冶金注入器；自动化路线已建立；锻造天空核心。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
		"来自其他章节：Heated Brass (Create)；Steel Before Circuits (Immersive Engineering)。"
	]
	quest.0000000000013564.title: "锻造连接"
	quest.00000000000135A8.quest_desc: [
		"使用无线合成终端，随时随地访问你的AE2网络并合成物品。"
		"后续路线：自动化路线已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000135A8.title: "无线合成终端"
	quest.00000000000135EC.quest_desc: [
		"使用可用的房间模板配方制作一台新紧凑型机器。这是用于创建房间的合成物品；放置后会出现绑定机器方块。在将工厂搬入前，请在JEI中检查其模板和个人缩小装置。"
		"后续路线：自动化路线已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000135EC.title: "紧凑型工作台"
	quest.0000000000013630.quest_desc: [
		"维度碎片是 RFTools 的核心合成材料。收集它们以实现高级自动化。"
		"后续路线：RFTools Storage Scanner。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013630.title: "RFTools 碎片"
	quest.0000000000013674.quest_desc: [
		"存储扫描仪会索引你的存储系统，以实现高级物品查询和路由。"
		"后续路线：RFTools Builder; RFTools Crafter。这些是直接使用该步骤的任务；其他前置条件也可能适用。"
	]
	quest.0000000000013674.title: "RFTools 存储扫描仪"
	quest.00000000000136B8.quest_desc: [
		"RFTools 建造者可以构建形状、挖掘区域和传送装置。"
		"非常适合用来扩建你的天空岛屿。"
		"后续路线：自动化路线已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000136B8.title: "RFTools Builder"
	quest.00000000000136FC.quest_desc: [
		"RFTools 合成台可同时自动化多达 8 个合成配方。"
		"后续路线：RFTools Control Processor。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000136FC.title: "RFTools Crafter"
	quest.0000000000013740.quest_desc: [
		"使用 RFTools Control 处理器编写复杂的自动化逻辑。"
		"后续路线：自动化路线已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013740.title: "RFTools 控制处理器"
	quest.0000000000013784.quest_desc: [
		"Ex Compressum 自动压缩机可自动批量压缩物品。"
		"后续路线：自动筛分机。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013784.title: "Ex Compressum"
	quest.00000000000137C8.quest_desc: [
		"使用 Ex Compressum 自动筛网，自动化你的 Ex Deorum 筛选工作。"
		"后续路线：Stoneworks Factory；自动化路线已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000137C8.title: "自动筛分机"
	quest.000000000001380C.quest_desc: [
		"Industrial Foregoing 的石材工厂可自动生产石头、鹅卵石、砾石、沙子和粉尘。"
		"单个机器提供无限筛分输入。"
		"后续路线：植物采集者。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.000000000001380C.title: "Stoneworks 工厂"
	quest.0000000000013850.quest_desc: [
		"在可配置区域内自动收割作物。"
		"后续路线：Mob Crusher。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013850.title: "植物采集者"
	quest.0000000000013894.quest_desc: [
		"在自动化刷怪塔中，通过粉碎怪物来获取掉落物和经验。"
		"后续路线：激光钻头。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013894.title: "生物破碎机"
	quest.00000000000138D8.quest_desc: [
		"IF激光钻使用RF被动地从基岩层开采矿石。"
		"后续路线：自动化路线已建立。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000138D8.title: "激光钻头"
	quest.000000000001393E.quest_desc: [
		"选择 XNet、RFTools Crafter 或 Industrial Foregoing Laser Drill 作为你的专精路线。拥有所选设备并按照其设置说明操作。此检查点不需要全部三个模组。"
		"本章的终点。一条入口路线会开启检查点；其中列出的任务仍需完成。继续前往《终局：工作室成就》。"
		"工作室检查点：完成所列前置任务中的任意一个，然后完成本任务的自身任务。你不需要完成所有分支。"
		"后续路线：A Workshop Achievement。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.000000000001393E.title: "自动化路线已建立"
	quest.0000000000013993.quest_desc: [
		"收集四块铀系锭。Extreme Reactors的Yellorium和Mekanism的Uranium共享铀锭标签，两者都算数。使用JEI查看所选反应堆的燃料和合金配方；材料里程碑不代表反应堆已组装完成。"
		"后续路线：Reactor Casing; Netherite Age。这些是直接使用该步骤的任务；其他前置条件也可能适用。"
		"来自其他章节：铁网 (Ex Nihilo)。"
	]
	quest.0000000000013993.title: "铀（Uranium）或镭（Yellorium）"
	quest.00000000000139D7.quest_desc: [
		"使用反应堆外壳方块建造你的极端反应堆的外壳。"
		"后续路线：Reactor Online。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.00000000000139D7.title: "反应堆外壳"
	quest.0000000000013A1B.quest_desc: [
		"建造一个完整的 Extreme Reactor 多方块结构。"
		"一个3x3x3的内部空间，包含燃料棒、控制器和访问端口。"
		"后续路线：更多电力；岛屿扩建。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013A1B.title: "反应堆在线"
	quest.0000000000013A5F.quest_desc: [
		"添加燃料棒以提高反应堆的能源输出。"
		"后续路线：蒸汽涡轮机。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013A5F.title: "更多电力"
	quest.0000000000013A92.quest_desc: [
		"用极端反应堆涡轮机将反应堆的蒸汽输出转化为更多的RF。"
		"后续路线：无限力量。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013A92.title: "蒸汽涡轮机"
	quest.0000000000013AD6.quest_desc: [
		"使用 RFTools Builder 用开采的材料扩建你的空岛。"
		"后续路线：RFTools 能量电池。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013AD6.title: "岛屿扩建任务书"
	quest.0000000000013B1A.quest_desc: [
		"高级 RFTools 能量电池可为你的终局系统储存大量 RF。"
		"此可选分支在此结束。返回章节路线，继续方形任务或向其六边形检查点努力。"
	]
	quest.0000000000013B1A.title: "RFTools 能量电池"
	quest.0000000000013B5E.quest_desc: [
		"用下界合金废料和黄金锻造下界合金锭。原版进阶的巅峰。"
		"后续路线：下界合金工具；下界合金盔甲；一颗下界之星。这些是直接使用该步骤的任务；其他前置条件也可能适用。"
	]
	quest.0000000000013B5E.title: "下界合金时代"
	quest.0000000000013BA2.quest_desc: [
		"下界合金工具是游戏中最好的——耐用、快速，还防火。"
		"后续路线：Apotheosis Enchanting。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013BA2.title: "下界合金工具"
	quest.0000000000013BE6.quest_desc: [
		"全套下界合金盔甲防火，并提供最高的基础防护值。"
		"此可选分支在此结束。返回章节路线，继续方形任务或向其六边形检查点努力。"
	]
	quest.0000000000013BE6.title: "下界合金盔甲"
	quest.0000000000013C19.quest_desc: [
		"Apotheosis 重做了附魔系统。"
		"使用重铸台和宝石镶嵌，将你的装备发挥到极致。"
		"后续路线：附魔图书馆。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013C19.title: "Apotheosis 附魔台"
	quest.0000000000013C4C.quest_desc: [
		"制作Apothic Enchanting Library，并查阅指南以存储和使用附魔书。此方块并非附魔祭坛。"
		"后续路线：传奇装备。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013C4C.title: "附魔图书馆"
	quest.0000000000013C90.quest_desc: [
		"用下界之星和玻璃建造信标。将其放置在金字塔上可获得强大的永久增益。"
		"后续路线：飞升。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013C90.title: "信标"
	quest.0000000000013CD4.quest_desc: [
		"获得一颗下界之星。常规生存路线是从下界收集四块灵魂沙和三个凋零骷髅头，然后在安全的竞技场中召唤并击败凋零。此任务在信标任务之前，因为信标会消耗一颗下界之星。"
		"后续路线：信标。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013CD4.title: "一颗下界之星"
	quest.0000000000013D18.quest_desc: [
		"击败末影龙以完成原版“解放末地”成就。无需末影龙蛋，因此其他团队拿走第一枚蛋也不会阻止你。如果末影龙已死亡，请在出口传送门周围放置四个末地水晶以使其重生。"
		"后续路线：自由之翼；飞升。这些是直接使用该步骤的任务；其他前置条件也可能适用。"
	]
	quest.0000000000013D18.title: "击败末影龙"
	quest.0000000000013D5C.quest_desc: [
		"鞘翅能赋予你真正的飞行能力。与火箭结合，即可在虚空中获得无限速度。"
		"后续路线：飞升。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013D5C.title: "自由之翼 Wings of Freedom"
	quest.0000000000013D8F.quest_desc: [
		"将传奇宝石镶嵌到你的装备上，以获得绝对最佳的属性。"
		"后续路线：全自动。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013D8F.title: "传奇装备"
	quest.0000000000013DD3.quest_desc: [
		"你的反应堆和涡轮机产生的RF，比你基地里所有东西的消耗总和还要多。"
		"后续路线：全自动；飞升。这些是直接使用该步骤的 quest；其他前提条件也可能适用。"
	]
	quest.0000000000013DD3.title: "无限力量"
	quest.0000000000013E28.quest_desc: [
		"你的AE2网络自动合成一切，感应矩阵存储一切，灵魂则负责挖掘其余。"
		"后续路线：飞升。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.0000000000013E28.title: "全自动自动化系统"
	quest.0000000000013EB0.quest_desc: [
		"你从一个孤零零的树和一把泥土开始，漂浮在无尽的天空。\n\n你建造了重塑物质的机器，将魔法融入钢铁，驾驭了星辰的力量，并锻造出了前所未有的事物。\n\n这正是你此行的目的。\n\n天空从来都不是极限——它只是开端。"
		"这是整合包的最终里程碑。你的岛屿仍可用于进一步建造和自动化。"
	]
	quest.0000000000013EB0.quest_subtitle: "天空从来都不是极限所在。"
	quest.0000000000013EB0.title: "飞升（Ascension）"
	quest.710000000000001B.quest_desc: [
		"制作任意 Ex Deorum 木制水坩埚。橡木、云杉木、桦木及其他注册木类均可。用多余的树苗换取水：十个树苗可换一桶水；如果能收集到树叶，树叶也行。瓷制坩埚会产出岩浆，无法满足此任务。"
		"后续路线：建造可再生水池。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.710000000000001B.title: "树苗中的水 (Water from Saplings)"
	quest.710000000000001D.quest_desc: [
		"用钩爪钩普通树叶，直到掉出蚕。将蚕用于树叶上，等待虫害完全蔓延，然后用钩爪钩取受感染的树叶以获取线。保留普通树木和受感染的树木。"
		"后续路线：快速加餐；编织线网。这些是直接使用该步骤的任务；其他前置条件也可能适用。"
	]
	quest.710000000000001D.title: "Silkworms and String"
	quest.710000000000001F.quest_desc: [
		"在小麦生长期间，将多余的蚕烤成烤蚕。留一只蚕用于感染另一棵树。这是一个可选的早期食物来源，不能替代可持续农场。"
		"此可选分支在此结束。返回章节路线，继续方形任务或向其六边形检查点努力。"
	]
	quest.710000000000001F.title: "快速小吃一份"
	quest.7100000000000021.quest_desc: [
		"建造一个2x2的带实心地板的池子。在相对角放置水源。从角落取水桶，检查水是否复原。第二个水源可从附近的沙岛冰或你的橡木坩埚获取。仅在测试完池子后勾选此项；这是一个手动建造检查。"
		"后续路线：Opening Supplies Ready; Dust and Water Make Clay。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.7100000000000021.title: "建造一个可再生水池"
	quest.7100000000000023.quest_desc: [
		"收集四种主食。面包、烤土豆、胡萝卜、苹果、熟肉/鱼、熟蚕和所列的米饭都算。建立可持续供应；保留种子或繁殖材料，而不是吃掉最后的初始资源。"
		"后续路线：开启物资准备。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.7100000000000023.title: "在建造大型机器前，先填饱肚子"
	quest.7100000000000027.quest_desc: [
		"建立水池和农田后，准备好所列物资。物品任务会检查物资，而之前的手动检查则针对水池。待基础稳固后，再推进自动化资源生产。"
		"后续路线：小型动力工坊。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.7100000000000027.title: "开启物资准备就绪"
	quest.7100000000000041.quest_desc: [
		"用线或燧石筛网筛砾石，直到获得四块 Ex Deorum 铁矿石。使用线时概率为 10%，燧石为 12%。此掉落为随机，请保持砾石供应可持续。"
		"后续路线：将区块熔炼成矿石。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.7100000000000041.title: "来自砾石的矿石块 Ore Chunks from Gravel"
	quest.7100000000000043.quest_desc: [
		"用2x2的模式合成四个铁矿石块以获得一个铁矿石方块，然后将其熔炼成锭。重复此操作，直到能买得起桶、剪刀和漏斗。"
		"后续路线：首先是铁锭。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.7100000000000043.title: "将区块熔炼成可冶炼矿石"
	quest.7100000000000045.quest_desc: [
		"用线或燧石筛网筛骨粉。在全部用于作物前，预留七份骨粉用于瓷土路线。骨粉还能帮你恢复草和额外的种子。"
		"后续路线：Porcelain Clay。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.7100000000000045.title: "用骨粉制作骨头粉（Dust）"
	quest.7100000000000047.quest_desc: [
		"将空橡木桶装满水，然后加入 Ex Deorum 粉尘制作陶土块。将陶土块分解成陶土球。有桶了就用可再生水池，或者收集雨水。"
		"后续路线：Porcelain Clay; Dielectric Casing。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
		"来自其他章节：建造可再生水池（空岛基础）。"
	]
	quest.7100000000000047.title: "尘土与水可制成黏土"
	quest.7100000000000049.quest_desc: [
		"将黏土球和骨粉各一个组合成一个瓷土球。七个瓷土球可以制作一个未烧制的坩埚。"
		"后续路线：塑造熔炉。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.7100000000000049.title: "Porcelain Clay"
	quest.710000000000004B.quest_desc: [
		"在 JEI 显示的桶形坩埚图案中使用七个瓷土球。这还不是一个可用的坩埚：下一步是将其冶炼。"
		"后续路线：点燃 Porcelain Crucible。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.710000000000004B.title: "铸造熔炉的形状"
	quest.710000000000004D.quest_desc: [
		"制作一个初级熔炉。其介电浆使用木炭/煤炭、粘土球和岩浆；先建立可再生岩浆。向发电机投入木炭。这个初级阶段足以开始制作下面的小型机器。"
		"后续路线：你的第一个机械筛；第一个发电机。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
		"来自其他章节：介电外壳（电力能源）；开启物资就绪（天空岛基础）。"
	]
	quest.710000000000004D.title: "一个小型动力工坊"
	quest.710000000000004F.quest_desc: [
		"制作一个 Ex Deorum 机械筛。此更新仅将两种铁块材料替换为铁锭，以缩短初期肝度。在机器中放入合适的筛网，提供 FE 能量，并投入砾石。"
		"后续路线：喂养生产线；观察一批运行。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.710000000000004F.title: "你的第一台机械筛分机"
	quest.7100000000000051.quest_desc: [
		"制作一把 Ex Deorum 机械锤。将其放置在动力源旁，并用漏斗输送和收集正确的材料。其两种铁块原料也会被还原成铁锭。在分配输出前，请在 JEI 中查看锤子的配方链。"
		"此可选分支在此结束。返回章节路线，继续方形任务或向其六边形检查点努力。"
	]
	quest.7100000000000051.title: "喂养生产线"
	quest.7100000000000053.quest_desc: [
		"手动操作检查：为 Starter Furnator 加油，启动机械筛（需紧邻或连接 Powah 电缆），放入筛网，投入一叠砾石，并将产物导向箱子。确认其能持续处理而无需手动筛分。若停止，请检查燃料/FE、筛网、输入输出方向。观察一轮运行后勾选。"
		"此可选分支在此结束。返回章节路线，继续方形任务或向其六边形检查点努力。"
	]
	quest.7100000000000053.title: "观看一批次的运行过程"
	quest.7100000000000057.quest_desc: [
		"用锻造核心、源宝石和浸染合金合成曼纳锻造合金。先制作浸染器并建立源宝石路线。富集室需要四个该合金；此更新保留了原有的配方成本。"
		"后续路线：富集室；锻造天空核心。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
		"来自其他章节：源宝石优先（Ars Nouveau）。"
	]
	quest.7100000000000057.title: "Manaforged 合金"
	quest.7100000000000059.quest_desc: [
		"使用工程师手册建造并运行IE焦炉和冲天炉。获取锻造核心的钢材。JEI会显示砖块和组件；仅凭锤子无法证明钢材已生产。"
		"后续路线：IE Crusher; Forge the Connection。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
	]
	quest.7100000000000059.title: "电路之前的钢铁"
	task.000000000000FA02.title: "我已经组建好我的团队了！"
	quest.7300000000000001.title: "通往下界的道路"
	quest.7300000000000001.quest_desc: [
		"北75格的沙岛上含有十个黑曜石。建造并点燃一个普通的下界传送门，保持安全的回家路线。下界使用普通地形，包括堡垒。带上食物、方块和备用点火工具。测试通行后勾选此项。"
		"后续路线：Heated Brass; Prosperity in the Void; Build an End Portal。这些是直接使用该步骤的任务；其他前置条件也可能适用。"
	]
	quest.7300000000000003.title: "苔藓中的远古木材 Archwood from Moss"
	quest.7300000000000003.quest_desc: [
		"筛取泥土以获取 Ex Deorum 草籽，然后将四颗草籽合成苔藓块。筛取苔藓以获得 Ars 拱木树苗；已安装的 Ex Deorum 配方支持四种拱木颜色。种植它以获取拱木板和半砖。"
		"后续路线：源罐；源宝石优先。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
		"来自其他章节：燧石网格（Ex Nihilo）。"
	]
	quest.7300000000000005.title: "虚空中的繁荣"
	quest.7300000000000005.quest_desc: [
		"此更新添加了确定性繁荣碎片配方：4个紫晶碎片、4个下界石英和1个金锭可制作4个繁荣碎片。在下界正常获取石英；使用JEI获取紫晶。在制作种子前，怪物就可能掉落Inferium。"
		"后续路线：Inferium Seeds。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
		"来自其他章节：通往下界的道路（Ex Nihilo）。"
	]
	quest.7300000000000007.title: "建造一个末地传送门"
	quest.7300000000000007.quest_desc: [
		"虚空主世界没有要塞路线。使用新增配方制作十二个末地传送门框架：每批四个黑曜石、四个末影之眼和一个钻石可制作三个框架。再留十二个末影之眼用于激活。站在5x5区域的中心，将十二个框架围绕一个3x3的开口向内放置，角落留空。添加末影之眼前请检查方向。"
		"后续路线：击败末影龙。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
		"来自其他章节：通往下界之路 (Ex Nihilo)；璞玉 (Ex Nihilo)。"
	]
	quest.0000000000010F24.quest_subtitle: "分支检查点 - 遵循你选择的路线"
	quest.0000000000011463.quest_subtitle: "分支检查点 - 遵循你选择的路线"
	quest.0000000000011980.quest_subtitle: "分支检查点 - 遵循你选择的路线"
	quest.0000000000011E7B.quest_subtitle: "分支检查点 - 遵循你选择的路线"
	quest.00000000000123CB.quest_subtitle: "分支检查点 - 遵循你选择的路线"
	quest.000000000001291B.quest_subtitle: "分支检查点 - 遵循你选择的路线"
	quest.0000000000012E8D.quest_subtitle: "分支检查点 - 遵循你选择的路线"
	quest.00000000000133CC.quest_subtitle: "分支检查点 - 遵循你选择的路线"
	quest.000000000001393E.quest_subtitle: "分支检查点 - 遵循你选择的路线"
	quest.7300000000000009.title: "一个工坊成就"
	quest.7300000000000009.quest_desc: [
		"完成一个专家章节的里程碑：电力、创造、机械动力、存储、神秘学、奥术、可再生能源生产、工业进化或自动化。你选择的分支将导向飞升；其他专精则为可选。完成一个里程碑后勾选此项。"
		"工作室检查点：完成所列前置任务中的任意一个，然后完成本任务的自身任务。你不需要完成所有分支。"
		"后续路线：飞升。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
		"来自其他章节：能源大亨 (Power Energy)；全自动 (Create)；机械动力精通 (Mekanism)；自动化合成路线已建立 (Storage)；大法师 (Ars Nouveau)；灵魂大师 (Occultism)；可持续生产已建立 (Farming Food)；工业革命 (Immersive Engineering)；自动化路线已建立 (Cross Mod Automation)。"
	]
	quest.730000000000000B.title: "锻造天空核心 (Forge the Sky Core)"
	quest.730000000000000B.quest_desc: [
		"合成包的天空核心。JEI 显示其魔力锻造合金、精密机械、电子元件和强化合金。这将 Create、钢、Ars 和 Mekanism 加入战役；工坊检查点让你选择额外的专精方向。"
		"后续路线：飞升。这些是直接使用该步骤的任务；其他前提条件也可能适用。"
		"来自其他章节：Manaforged Alloy (Mekanism); Reinforced Alloy (Mekanism); Forge the Connection (Cross Mod Automation)."
	]
