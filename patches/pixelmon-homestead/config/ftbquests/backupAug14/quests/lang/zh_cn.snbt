	quest.749EE37B4B9C127D.quest_desc: ["使用斧头能更快地砍倒树木，并获得更多的木材！"]
	quest.749EE37B4B9C127D.quest_subtitle: "Minecraft 开始！"
	quest.749EE37B4B9C127D.title: "入门指南"
	quest.757303C48AE490E6.quest_desc: ["喜欢华丽的附魔？书架商人就是你的最佳选择！"]
	quest.757303C48AE490E6.title: "书架商人"
	quest.76624B9DDE9420E8.quest_desc: ["这是一个简单的任务，算是说声，感谢游玩！如果你喜欢它，或者甚至讨厌它，都告诉我。我期待所有反馈！"]
	quest.76624B9DDE9420E8.title: "皮卡丘，出发吧！"
	quest.78007C306C4235E3.title: "胜利之路"
