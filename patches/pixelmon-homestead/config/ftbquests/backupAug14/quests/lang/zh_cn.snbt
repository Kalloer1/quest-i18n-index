		""
		"https://discord.gg/eZYdb8tMr4"
	]
	quest.6136B8458A108BEA.quest_subtitle: "建议和反馈 (Suggestions and Issues)"
	quest.618AFCC7A301475C.quest_subtitle: "大铲子 3x1"
	quest.61E8AEF236A8ACC5.quest_desc: ["大型太阳能电池板能产生32 RF/t至224 RF/t的能量，具体取决于所用机器核心。它会随太阳自动转向，仅在白天工作。"]
	quest.61E990D25B1A14B3.title: "40% JohtoDex"
	quest.6201B4A26913C7D4.quest_desc: ["目前正在制作自定义道馆，但现在你可以通过挑战岩石道馆来获得徽章。你可以用探险家罗盘来寻找道馆。"]
	quest.6201B4A26913C7D4.quest_subtitle: "布洛克 - 岩石道馆"
	quest.6201B4A26913C7D4.title: "Pewter City 健身房"
	quest.629D3A42B03498F9.quest_desc: ["你必须找到法球，为其注入灵魂，然后带到相应的祭坛。祭坛每天只能使用一次。"]
	quest.63B8232985179FE7.title: "90% JohtoDex"
	quest.64205C5E0B0BEE35.quest_desc: [
		"布洛克通常很好说话，前提是你选了杰尼龟或妙蛙种子。"
		""
		"通常来说，他的血量足以击倒你的初始宠物。"
	]
	quest.64205C5E0B0BEE35.title: "准备好迎接 Pewter 道馆的挑战"
	quest.654B27ED75BFA296.quest_desc: ["他曾是Red的童年好友，但随着长大变得刻薄。他认为Red是自己的对手，因为他们同龄同高。"]
	quest.654B27ED75BFA296.quest_subtitle: "回头见！到时候再聊！"
	quest.654B27ED75BFA296.title: "蓝色对手向你发起挑战"
	quest.65851CF8B826693F.quest_desc: ["按下 &lK&r 键查看你的技能树"]
	quest.67BDC485D33DC68C.quest_subtitle: "更好的矿石，更好的精灵球"
	quest.67BDC485D33DC68C.title: "铁器时代"
	quest.67CC6E7A13F0ACAA.quest_subtitle: "大型物品栏模组 (Big Inventories)"
	quest.67CC6E7A13F0ACAA.title: "小型船只"
	quest.67DD29362BBA4131.quest_desc: ["任何交易机器的核心部件。"]
	quest.67DD29362BBA4131.title: "Lightman's Currency"
	quest.68279A6528FF4396.title: "2. Founja丛林（白天）"
	quest.682D9B890BD02BE5.quest_desc: ["https://moddedmc.wiki/en/project/oritech/docs"]
	quest.682D9B890BD02BE5.quest_subtitle: "这个模组对我来说是新的，所以需要更多信息"
	quest.686107F453D4E288.quest_desc: [
		""
		"“如果你找不到一片星系，那么找到一颗恒星也并非坏事。”"
	]
	quest.686107F453D4E288.title: "无畏的勇士"
	quest.68B275B2B50823AF.quest_desc: [
		"你需要找到一个球体，并将其与你想要的宝可梦的进化石结合。然后，你必须击败对应属性的150只像素宝可梦。最后，将完成的球体带到它们的祭坛。"
		""
		"{@pagebreak}"
		"&l示例：&r"
		"我想要一只Moltres。"
		"1. 我在突袭巢穴的奖励中找到了一个球体。"
		"2. 然后将 Orb 与 Fire Stone 结合"
		"3. 击败150只怪物。"
		"4. 找到 Moltres 神殿"
		"5. 与 Moltres 战斗，并希望能捕获它。"
	]
	quest.68B275B2B50823AF.quest_subtitle: "轨道球体"
	quest.68B275B2B50823AF.title: "传奇鸟类"
	quest.6964A92B45E38C84.quest_desc: [
		"你可以在合成台里制作钢、电金和艾德曼金属，但那样会浪费资源。"
		""
		"一旦可以，你就应该建造一台粉碎机和熔炉，这样能更高效地制作合金。"
	]
	quest.69F48A17CE61E35C.quest_desc: [
		"玩家可以从附魔物品或附魔书中恢复附魔。"
		""
		"例如，如果你的附魔剑快要损坏，想回收附魔，用这个超棒的合成台把附魔从剑上分离出来，再装进书里，就很简单了。"
	]
	quest.69F48A17CE61E35C.quest_subtitle: "每次提取20个层级"
	quest.6A8F84E5A8F403B7.quest_desc: ["离心机可分离和转化物品。可用于从碎片锻造炉获得的矿石块中提取矿石粉尘，将煤炭粉尘纺成碳纤维丝，或使用流体附加组件将石油或小麦加工成塑料片。"]
