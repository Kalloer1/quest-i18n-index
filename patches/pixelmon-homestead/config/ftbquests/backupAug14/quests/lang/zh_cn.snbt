	quest.56529E7AD3684619.quest_desc: [
		"盖欧卡 深海冷洋 MC 夜晚 水域 雨天，最大Y坐标 45"
		"暴风雨天气中的生成率提高2倍 2.0"
		"Deep Frozen Ocean MC"
		"深层微温海洋 MC"
		"深海MC整合包任务书"
		""
		"固拉多干旱 — 白天陆地晴朗天气和最大Y值 90 1.0"
		""
		"烈空坐山脉 — 下午/黄昏空中 — 0.5"
		"通常在高处生成，飞行速度很快"
	]
	quest.56529E7AD3684619.title: "天气三人组"
	quest.57143E17E68DE092.quest_desc: [
		"采矿维度是一个超平坦的永远白天的世界，专为激进采石和采矿作业而设计。"
		""
		"这里没有宝可梦生成。"
	]
	quest.57143E17E68DE092.quest_subtitle: "这样你就不用把采矿场带到主世界去了"
	quest.574EADBF49DC38A0.title: "50% JohtoDex"
	quest.5763C63BA3A02B88.quest_desc: [
		"Timedoor Projector：设置传送点，使用Timedoor轻松在两点之间旅行。"
		""
		"这是唯一能定位超空间的设备，足够强大。"
	]
	quest.5763C63BA3A02B88.quest_subtitle: "维度与传送点跳跃"
	quest.57E137C9DC13E135.quest_desc: ["需要一颗钻石，但对于一个像样的家园来说，这几乎是必需的。"]
	quest.57E137C9DC13E135.quest_subtitle: "宝可梦治疗师"
	quest.57E137C9DC13E135.title: "壁炉"
	quest.57E8B939A11CA3E5.quest_desc: ["绝佳的采矿来源，这样你就不用完全摧毁主世界了！"]
	quest.584D1CA4EC6BB2CB.quest_desc: ["你可以将附魔移到钻石镐上。附魔后的机器工作效率更高。"]
	quest.584D1CA4EC6BB2CB.quest_subtitle: "QuarryPlus 附加组件"
	quest.58A3F99F531F40C3.title: "小径之路"
	quest.58FDB84F0B389FDA.title: "20% 宝可梦图鉴"
	quest.5A182C0062D3B624.quest_subtitle: "你为什么要这么做呢？"
	quest.5A182C0062D3B624.title: "火箭队之路 Team Rocket Path"
	quest.5A5BF9D32D747AFC.quest_desc: [
		"位于关都北部的海滨城市。北临海湾，南接枯叶市，西靠月亮山。"
		""
		"这里是&bMisty，&r蔚蓝市道馆馆主的家。"
	]
	quest.5A5BF9D32D747AFC.quest_subtitle: "Misty"
	quest.5A5BF9D32D747AFC.title: "天蓝色城市健身房"
	quest.5A9472025AE2260D.title: "完成乔伊托图鉴 JohtoDex"
	quest.5B55487C47058080.quest_desc: ["伊布可以进化成八种不同的形态。伊布还会逐渐长得像它的主人。据说伊布的基因里藏着解开宝可梦进化之谜的钥匙。正如《宝可梦睡眠》中提到的，伊布会梦见自己会进化成哪种形态。"]
	quest.5B55487C47058080.quest_subtitle: "它能进化成多种形态，从而能完美地适应任何环境。"
	quest.5B55487C47058080.title: "Let's Go Eevee"
	quest.5BC551C1A2FAFE01.quest_desc: ["箱子漏斗"]
	quest.5BC8499E616F5995.quest_subtitle: "快乐的加斯特叫声（Happy Ghast Noises）"
	quest.5CAAE8E37A7D269E.quest_desc: [
		"拉帝亚斯海洋MC晨间空气 — 2.0"
		"温暖海洋 MC"
		"拉帝奥斯海洋MC午后空气 — 2.0"
		"温暖海洋 MC"
	]
	quest.5CAAE8E37A7D269E.quest_subtitle: "飞行生物类型"
	quest.5D9F056FABF5CC8C.quest_desc: ["你为ZA选的是哪一个？超级大舌舔！"]
	quest.5D9F056FABF5CC8C.title: "ZA 合作伙伴"
	quest.5DD7C011887561BA.quest_desc: ["简易早期能源。提供多个等级，支持升级和不同选项。"]
	quest.5DD7C011887561BA.quest_subtitle: "发电机大合集"
	quest.5ED860FECDD4D024.quest_desc: [
		"碎片锻造炉可以提高矿石的产量。矿石在碎片锻造炉中加工时，会被分解成矿石块和小型矿石块。"
		""
		"九个小型团块可以合成一个大型团块。这些团块可以在离心机中加工成粉尘和小型粉尘，然后在熔炉中冶炼。"
		""
		"你可以将原矿放入碎片锻造炉，但对于某些矿石，用带有丝绸之触的镐挖掘，然后将矿石方块放入锻造炉，效果会更好。"
		""
		"碎片锻造炉和离心机都可以产出次级矿石。例如，处理镍会产出镍，也可能附带一些铂。"
	]
	quest.5F6E32D413B29A9F.title: "季节（Seasons）"
	quest.5FAA812ADA274124.quest_desc: ["粉碎机是一个缓慢而简单的方块，用于粉碎矿石和生物质。它在碎片锻造炉出现前就能使用，但即使建了碎片锻造炉，你可能仍想用粉碎机来研磨生物质或煤炭粉。"]
	quest.5FDBEDB72CAF9318.quest_desc: [
		"丛林中的丛林金字塔"
		"必须在白天，稀有度为0.1"
	]
	quest.60209B059EDD477B.title: "花之森林（夜间）"
	quest.60249D76A8FFDFE9.quest_desc: ["有时候，建造大型建筑可能有点乏味，而且需要付出很多努力。毕竟不是每个人都是伟大的建筑师！Dire's Building Gadgets 旨在让建造变得更容易一点。"]
	quest.607C1146C2EA9109.title: "30% JohtoDex"
	quest.60AF8EC021B3F348.title: "50% KantoDex"
	quest.6136B8458A108BEA.quest_desc: [
