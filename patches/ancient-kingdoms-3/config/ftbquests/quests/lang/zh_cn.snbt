# AI 初翻，未人工校对
{
	chapter_group.3CB0832AAD20D6D8.title: "&6你的王国"
	chapter_group.2EAAE7CFEA1F0754.title: "&c英雄之路"
	chapter_group.1903F3C70B0F9E81.title: "&5魔法之路 (Paths of Magic)"
	chapter_group.045D1965A5997F27.title: "&b奇观与奇迹"
	task.6C0EA7BBA9AC5269.title: "欢迎来到古代王国 (Ancient Kingdoms)"
	quest.6CBF14462DF3EBD3.title: "古代王国 (Ancient Kingdoms)"
	quest.6CBF14462DF3EBD3.quest_subtitle: "一条门，三条路"
	quest.6CBF14462DF3EBD3.quest_desc: [
		"这是一个中世纪世界，有&6王国&r要发展，&d魔法书架&r要学习，"
		"还有&c巨龙、地牢和首领&r，适合那些喜欢战斗而非建造的玩家。"
		""
		"你作为十个&6起源&r之一出生。蜘蛛、鸟类、烈焰、人鱼和"
		"每种起源都有其独特的能力和缺陷，起源界面中的"
		"你的物品栏列出了你的物品能做什么。"
		""
		"把这本书当作地图，而不是规则手册。左边的四组内容"
		"可以按任意顺序阅读，且一个任务不会因另一个任务而锁定。"
		""
		"&7之后更改起源需要起源之球，只有管理员可以发放。&r"
	]
	quest.24031C0AFBB324AD.title: "一次性阅读所有书籍"
	quest.24031C0AFBB324AD.quest_subtitle: "阿卡夏之书"
	quest.24031C0AFBB324AD.quest_desc: [
		"本整合包的大多数模组都附带一本指南，每个占一个槽位。潜行右键"
		"将指南书放入&6阿卡夏典籍&r中，典籍会将其吞噬；打开典籍，然后"
		"挑选一本你想读的书来阅读吧。"
		""
		"&7Botania, Ars Nouveau, Blood Magic, Occultism and Primal Magick all have one.&r"
	]
	task.4CE4C27AE82AB38B.title: "阅读这三个控制器的说明"
	quest.05449A6B0E4C87DA.title: "操作说明"
	quest.05449A6B0E4C87DA.quest_subtitle: "本整合包添加了三种钥匙"
	quest.05449A6B0E4C87DA.quest_desc: [
		"本整合包有三个原版没有的功能，第一天就值得了解。"
		""
		"&6领地：&r按&6M&r打开地图，右键单击区块并选择“Claim”。无人"
		"否则可以在里面建造、破坏或打开箱子。每个玩家都有一定配额。"
		""
		"&6Ultimine：&r按住&6`&r，并破坏一个矿脉方块或一棵树的树干，然后"
		"其余的会随之而来，消耗与徒手挖掘相同的饥饿值。"
		""
		"&6继续：&r空手潜行右键点击箱子、熔炉或机器以"
		"用物品栏里的东西把它捡起来。大多数动物都可以用同样的方法携带。"
	]
	quest.02F6BDAF6C8F26C2.title: "能跟上节奏的口袋 Pockets That Keep Up"
	quest.02F6BDAF6C8F26C2.quest_subtitle: "Sophisticated Backpacks"
	quest.02F6BDAF6C8F26C2.quest_desc: [
		"使用按键绑定打开一个 &6Backpack&r，不要将其脱下，并稍后为其配备"
		"磁铁、自动拾取、过滤器和一个喂食槽。"
		""
		"&7拥有超过一个后再染色，这样就能拿到正确的包裹了。&r"
	]
	quest.3685603DBF27ABDD.title: "归途之路"
	quest.3685603DBF27ABDD.quest_subtitle: "一块可以返回的石头"
	quest.3685603DBF27ABDD.quest_desc: [
		"在家中放置一个 &6Waystone&r 并右键绑定。此后每次"
		"你触碰的其他传送石将成为一个可以跳跃到的地方，并获得少量经验。"
		""
		"&7无论你在哪里挖掘，多一块石头就能让漫漫长路变成一键直达。&r"
	]
	quest.3C425F8AADB4789E.title: "一条怪物无法通过的线"
	quest.3C425F8AADB4789E.quest_subtitle: "巨型火把"
	quest.3C425F8AADB4789E.quest_desc: [
		"在&6Mega Torch&r周围大范围区域内，敌对生物无法通过墙壁生成"
		"还包括地板。一个位于建造中心附近的地板可覆盖整个区域。"
		""
		"&7同一模组中的恐怖灯对被动生物也有效，比如鱿鱼和"
		"蝙蝠们一直在填满你的建筑。&r"
	]
	quest.06B6897B21AE4E56.title: "属于自己的屋顶 (A Roof of Your Own)"
	quest.06B6897B21AE4E56.quest_subtitle: "第一个基地"
	quest.06B6897B21AE4E56.quest_desc: [
		"在已认领的地块上，四壁之内，地面放着一张床和一个工作台，旁边还有"
		"路标石已绑定至门口。本书中其余内容均从此处开始。"
		""
		"&7选择附近有平坦开阔土地的地点。殖民地需要广阔的地基，而且"
		"在房子旁边建一个，以后搬家就省事了。&r"
	]
	chapter.1E6BD8812AD85DD9.title: "入门指南"
	chapter.1E6BD8812AD85DD9.chapter_subtitle: ["占据一片土地，选择你是谁，然后找到回家的路。"]
	quest.19C511641C03CE6F.title: "建国的物资补给"
	quest.19C511641C03CE6F.quest_subtitle: "成为殖民地的营地"
	quest.19C511641C03CE6F.quest_desc: [
		"每个殖民地都始于一个 &6补给营地&r。放置在平坦的地块上，大约"
		"&617 by 17&r，没有草、花或洞，展开后会得到一些初始物品"
		"建筑物和一个装有工具的箱子。"
		""
		"如果你更愿意从水上开始，也有补给船版本可供选择。"
		""
		"&7你出生时背包里有一个。&r"
	]
	quest.5BA4581C15097FB2.title: "建造工具"
	quest.5BA4581C15097FB2.quest_subtitle: "每个小屋都是使用这个放置的"
	quest.5BA4581C15097FB2.quest_desc: [
		"MineColonies 或 Structurize 放置的任何东西都可以通过 &6建造工具&r拆除："
		"选择建筑，旋转和移动预览，然后确认。"
		""
		"&7把它放在快捷栏里。每个小屋和升级都要用它。&r"
	]
	quest.3685B8075652334D.title: "种植市政厅建筑方块"
	quest.3685B8075652334D.quest_subtitle: "殖民地开始的地方"
	quest.3685B8075652334D.quest_desc: [
		"放置&6市政厅&r，其周围的土地将成为你的殖民地。市民们，"
		"工人、守卫和研究都依赖于这单个方块。"
		""
		"&7放置后无法移动，请选择平坦开阔的地面。&r"
	]
	quest.7110EB9A2013C59A.title: "完成订单"
	quest.7110EB9A2013C59A.quest_subtitle: "请求以及如何回应它们的方法"
	quest.7110EB9A2013C59A.quest_desc: [
		"工人会通过&6请求系统&r索要材料。请回应其中一个"
		"市政厅界面，或者你口袋里的剪贴板中获取。"
		""
		"&7静止不动的建筑者，几乎总是有请求未得到回应。&r"
	]
	quest.45F423C46B926D5D.title: "总得有人来建造它 (Somebody Has to Build It)"
	quest.45F423C46B926D5D.quest_subtitle: "雇佣你的第一位建造者"
	quest.45F423C46B926D5D.quest_desc: [
		"放置一个&6Builder's Hut&r并分配一个村民。从这时起，你可以请求"
		"而不是一个一个地放置方块，建造者从...开始工作"
		"在他们的小屋里的箱子里面。"
		""
		"&7此处有三条道路：上方的住房和食物，人口里程碑"
		"直走，下面是殖民地自己的升级内容。&r"
	]
	quest.6B91B54C09AAF864.title: "一个更好的大厅"
	quest.6B91B54C09AAF864.quest_subtitle: "市政厅，五级"
	quest.6B91B54C09AAF864.quest_desc: [
		"升级&6市政厅&r会提升其他所有事物的上限：最多可容纳多少"
		"citizens you may hold and how far the colony's border reaches. Each level asks for"
		"明显比上一次的材料要好得多。"
	]
	quest.398804833DD4CE54.title: "为新来者准备的床铺"
	quest.398804833DD4CE54.quest_subtitle: "住宅造就公民"
	quest.398804833DD4CE54.quest_desc: [
		"人口上限由床决定。建造一个&6住宅&r，新居民就会到来"
		"填满它，所以要在需求产生前就建造好，而不是在需求产生后再建造。"
	]
	quest.083005AA6DBFA653.title: "两把锤子"
	quest.083005AA6DBFA653.quest_subtitle: "第二个建造者已经加入队伍。"
	quest.083005AA6DBFA653.quest_desc: [
		"两座建筑同时建造，新增第二座&6建造小屋&r。每位建造者只工作"
		"来自自己小屋的箱子，所以两个都需要补充。"
	]
	quest.47FD193B9683EB39.title: "城墙上的守卫"
	quest.47FD193B9683EB39.quest_subtitle: "一座瞭望塔"
	quest.47FD193B9683EB39.quest_desc: [
		"用&6瞭望塔&r派一名武装公民巡逻。掠夺者会来袭击每个殖民地"
		"最终，一个没有守卫的村庄会失去建筑。"
		""
		"&7《王国军队》中的军营是此内容的严肃版。&r"
	]
	quest.0CA56743BBFA0B95.title: "五个公民"
	quest.0CA56743BBFA0B95.quest_subtitle: "一个村庄"
	quest.0CA56743BBFA0B95.quest_desc: [
		"五个人：足够让建筑师、护林员和厨师忙碌，等你回来"
		"并找到一些有趣的东西。"
		""
		"&7只要有空床，居民就会自己搬进来。&r"
	]
	quest.4ABF9788A60C3E74.title: "酒馆"
	quest.4ABF9788A60C3E74.quest_subtitle: "访客，以及如何留住他们的方法"
	quest.4ABF9788A60C3E74.quest_desc: [
		"访客会来到&6酒馆&r，并且可以用物品作为报酬来招募访客，"
		"通常是食物、铁或工具，从你的物品栏中支付。"
		""
		"酒馆招募能让殖民地比等待抵达者发展得更快。"
	]
	quest.35CEAD490C2E7FD4.title: "教给他们一些新东西"
	quest.35CEAD490C2E7FD4.quest_subtitle: "小屋里的自定义配方"
	quest.35CEAD490C2E7FD4.quest_desc: [
		"工人只会制造他们被教导过的东西。打开小屋的&6配方&r标签页，然后"
		"加一；火把是传统的入门第一课。"
		""
		"&7已传授的配方可能包含模组物品，这样殖民地就能为你制作背包部件了。&r"
	]
	quest.6FAE5143F37117C9.title: "十位公民"
	quest.6FAE5143F37117C9.quest_subtitle: "一个村庄"
	quest.6FAE5143F37117C9.quest_desc: [
		"十点钟，殖民地开始自给自足，市政厅里的&6研究树&r"
		"开始提供值得拥有的升级选项了。"
		""
		"&7进行这项研究的大学位于殖民地生产区。&r"
	]
	quest.4AE033D5EACA43E5.title: "好好喂养它们"
	quest.4AE033D5EACA43E5.quest_subtitle: "烹饪好的食物和一位厨师"
	quest.4AE033D5EACA43E5.quest_desc: [
		"居民会食用殖民地储备的食物，他们的幸福感取决于食物的质量。"
		"储备熟食，等殖民地有厨师和食堂后（Colony"
		"生产涵盖了那些小屋) 他们会坐下来享用正餐。"
		""
		"&7没有厨师的殖民地，每餐都会因生食而失去幸福感。&r"
	]
	quest.1F33B5AA351FDD75.title: "神秘遗迹 The Mystical Site"
	quest.1F33B5AA351FDD75.quest_subtitle: "用材料换来的幸福感"
	quest.1F33B5AA351FDD75.quest_desc: [
		"幸福感是殖民地的一项指标，而&6神秘遗迹&r能提升它：一个自豪的殖民地才能高效运作"
		"更困难，抱怨更少。一级便宜，五级不便宜。"
		""
		"&7Unlocked by research at the University, in Colony Production.&r"
	]
	quest.612860931D03476A.title: "二十五位公民"
	quest.612860931D03476A.quest_subtitle: "一个城镇"
	quest.612860931D03476A.quest_desc: [
		"二十五个人，都由你提供食物、住所和生计。在这个规模下，"
		"殖民地需要农场和厨师来维持食物供应。"
	]
	quest.1268211E4BF7E2CC.title: "五星级评价"
	quest.1268211E4BF7E2CC.quest_subtitle: "神秘遗迹，已升至最高级"
	quest.1268211E4BF7E2CC.quest_desc: [
		"将&6Mystical Site&r升至五级，获得游戏中最大的幸福度加成，"
		"这样你的掘墓人就有更大的几率能复活死者。这是一个漫长"
		"建造，所以先加入队列，然后去做别的事情。"
	]
	quest.7CB84DF165E7BA1A.title: "五十位公民"
	quest.7CB84DF165E7BA1A.quest_subtitle: "一个真正的城镇"
	quest.7CB84DF165E7BA1A.quest_desc: [
		"五十人。殖民地现在有自己的运行计划，你的工作主要是"
		"确保仓库不会空无一物。"
		""
		"&7随着发展添加信使，否则小屋会闲置等待送货。&r"
	]
	quest.11A0F6A2419AA2BC.title: "七十五位公民"
	quest.11A0F6A2419AA2BC.quest_subtitle: "一座城市"
	quest.11A0F6A2419AA2BC.quest_desc: [
		"七十五人左右，差不多就是一个殖民地能达到的最大规模了。"
		""
		"&7这么大的殖民地会消耗服务器的性能。在官方服务器上，"
		"超过这一点后请谨慎行事。&r"
	]
	quest.228BE2C356E18983.title: "逝者安息"
	quest.228BE2C356E18983.quest_subtitle: "墓地和守墓人"
	quest.228BE2C356E18983.quest_desc: [
		"居民们去世了。一个&6Graveyard&r为他们提供了去处，一位&6Undertaker&r将他们安葬"
		"有了合适的图腾，掘墓人就能将其中一人复活。"
		""
		"&7尸体未处理时士气会下降。&r"
	]
	quest.3EBB7085CD020802.title: "王国屹立不倒"
	quest.3EBB7085CD020802.quest_subtitle: "一个可以自行运转的小镇"
	quest.3EBB7085CD020802.quest_desc: [
		"有住所、有食物、有守卫、有人员。从这里开始，殖民地与其说是项目，不如说是"
		"一个你碰巧拥有的地方。"
		""
		"Colony Production 让它投入工作。Armies of the Realm 让它屹立不倒。"
	]
	chapter.29850C3411283A15.title: "殖民地"
	chapter.29850C3411283A15.chapter_subtitle: ["一个补给营地，一个市政厅，还有一个愿意抡锤子的人。"]
	quest.41B84724B5BC7731.title: "木材加工坊"
	quest.41B84724B5BC7731.quest_subtitle: "护林员 (The Forester)"
	quest.41B84724B5BC7731.quest_desc: [
		"你的&6Forester&r会永久地清理并重新种植一片森林。给他们一个"
		"斧头和树苗，否则无法开始。"
	]
	quest.74BD9AB71E82F10F.title: "邮箱 The Post Box"
	quest.74BD9AB71E82F10F.quest_subtitle: "没有行走指令的订单无法完成"
	quest.74BD9AB71E82F10F.quest_desc: [
		"&6邮箱&r让你无需走到仓库就能订购材料，"
		"而&6Stash&r则为信使提供野外的一个投掷点。两者都很便宜，所以"
		"把它们放在你真正工作的地方。"
		""
		"&7采集小屋沿本页上臂分布，制作小屋则沿下臂分布，"
		"较低的仓库及其快递员位于制造臂的末端。&r"
	]
	quest.5CB733600F604483.title: "大学"
	quest.5CB733600F604483.quest_subtitle: "研究发生的地方"
	quest.5CB733600F604483.quest_desc: [
		"研究在&6大学&r进行。那里的研究人员会研究这棵树"
		"并解锁市政厅所列出的升级内容。"
		""
		"&7装满纸和书；大多数早期研究都需要两者。&r"
	]
	quest.6B4F9920B64EF8E3.title: "一摞木板 (Planks by the Stack)"
	quest.6B4F9920B64EF8E3.quest_subtitle: "锯木厂"
	quest.6B4F9920B64EF8E3.quest_desc: [
		"林业日志可以制成木板、木棍、木门和所有木制部件的"
		"建造者一直在索要 &6锯木场&r。教它小屋里的配方"
		"随着请求的到来，不断添加新的标签页。"
	]
	quest.46528C3DBB1FA6D8.title: "一路向下"
	quest.46528C3DBB1FA6D8.quest_subtitle: "一条直达基岩的矿井"
	quest.46528C3DBB1FA6D8.quest_desc: [
		"继续向下挖掘，直到矿工碰到基岩，穿过深板岩层，直到"
		"钻石和更好的矿石实际上都存在于这个世界中。"
		""
		"&7深度解锁需要矿工小屋，请先升级小屋。&r"
	]
	quest.78A90E2D7A6F40A7.title: "沿着竖井向下"
	quest.78A90E2D7A6F40A7.quest_subtitle: "矿工"
	quest.78A90E2D7A6F40A7.quest_desc: [
		"给&6矿工&r一把镐、一把铲子、火把和梯子，他们就能挖一条像样的"
		"下到矿井，把底下的东西带回来。"
	]
	quest.3BD2CD01635D24DB.title: "切割石"
	quest.3BD2CD01635D24DB.quest_subtitle: "石匠 (The Stonemason)"
	quest.3BD2CD01635D24DB.quest_desc: [
		"砖块、石板、楼梯和柱子都出自矿工小屋里的&6石匠&r那里"
		"运输，这是大型建筑所需的大部分材料。"
		""
		"&7Domum Ornamentum blocks come from here too, once taught.&r"
	]
	quest.0EFA8136FBFD3E94.title: "田野与沟壑"
	quest.0EFA8136FBFD3E94.quest_subtitle: "农夫"
	quest.0EFA8136FBFD3E94.quest_desc: [
		"在地上放置一个稻草人，在小屋注册田地，然后&6农夫&r"
		"从那时起它就正常工作了。"
		""
		"&7Research lets one farmer hold several fields.&r"
	]
	quest.2907373BA70E6484.title: "将矿石冶炼成锭"
	quest.2907373BA70E6484.quest_subtitle: "熔炼炉 (The Smeltery)"
	quest.2907373BA70E6484.quest_desc: [
		"矿石放入&6熔炉&r，废料和损坏的工具也是如此，殖民地"
		"生成；金属会从两边都重新出现。"
		""
		"&7矿石翻倍只有在较高的小屋等级才会出现，所以快升级吧！&r"
	]
	quest.4E7553E2BA2BB183.title: "图书馆"
	quest.4E7553E2BA2BB183.quest_subtitle: "学会技能的居民们会变得更加强大，他们能更好地适应环境，并帮助其他居民。"
	quest.4E7553E2BA2BB183.quest_desc: [
		"居民在&6图书馆&r学习，提升工作效率：工作更快，失误更少"
		"减少失误，提高产量。"
	]
	quest.21C72F087C170D75.title: "离开码头"
	quest.21C72F087C170D75.quest_subtitle: "渔夫"
	quest.21C72F087C170D75.quest_desc: [
		"将&6Fisher&r放在开阔水域，即可获得源源不断的免费食物，无需占用农田"
		"并且不能有动物。小屋必须建在水边，投掷范围内即可。"
	]
	quest.6B8D7B003A7F6B46.title: "古代卷轴 (Ancient Tomes)"
	quest.6B8D7B003A7F6B46.quest_subtitle: "附魔师"
	quest.6B8D7B003A7F6B46.quest_desc: [
		"从其他村民吸取的经验会转化为卷轴和附魔书，在"
		"&6附魔师&r。"
		""
		"&7地牢战利品中的古代卷轴使书籍数量超过了正常上限。&r"
	]
	quest.1A54D88D2514625B.title: "铁砧戒指系列任务书"
	quest.1A54D88D2514625B.quest_subtitle: "铁匠铺的匠人"
	quest.1A54D88D2514625B.quest_desc: [
		"殖民地其他人的工具和盔甲都来自&6铁匠&r，所以"
		"守卫们不再向你索要剑了。铁匠和机械师之间"
		"也涵盖了大多数模组组件的内容。"
	]
	quest.545D35D40E2840B5.title: "各种各样的动物群（Every Kind of Herd）"
	quest.545D35D40E2840B5.quest_subtitle: "牛、绵羊、鸡、猪、兔子"
	quest.545D35D40E2840B5.quest_desc: [
		"建造全套&6牧民小屋&r。殖民地将在小屋间自行生产肉类，"
		"羊毛和皮革，无需接触任何动物即可获得。"
		""
		"&7每个牧民都需要一个围栏和两只动物来开始。&r"
	]
	quest.330E9A2FBECCF0B1.title: "清晨的面包"
	quest.330E9A2FBECCF0B1.quest_subtitle: "面包师"
	quest.330E9A2FBECCF0B1.quest_desc: [
		"小麦在&6面包师&r那里会变成面包，用几个简单的配方还能做出糕点和派"
		"还有蛋糕。幸福取决于餐食质量，而不仅仅是卡路里。"
	]
	quest.41592F4B2D9023C4.title: "将其腐烂分解"
	quest.41592F4B2D9023C4.quest_subtitle: "堆肥桶 (The Composter)"
	quest.41592F4B2D9023C4.quest_desc: [
		"多余的作物放入&6堆肥桶&r，会变成花匠可用的堆肥"
		"种植后，农民会将其散布到田地里。它还能吸收多余的a"
		"工作殖民地抛掷出去。"
	]
	quest.4DA8454B3709381B.title: "餐厅大厅"
	quest.4DA8454B3709381B.quest_subtitle: "殖民地进食的地方在哪里"
	quest.4DA8454B3709381B.quest_desc: [
		"每隔一间小屋的熟食都会送到&6餐厅&r，由服务员端上"
		"整个殖民地。"
		""
		"隔壁的&7The Chef's Kitchen才是烹饪的实际发生地，而这个整合包"
		"为其提供了第二个配方：八个木板围着一个农夫的欣喜橱柜。&r"
	]
	quest.13D6A092E34C6065.title: "用于染料和花瓣的花朵"
	quest.13D6A092E34C6065.quest_subtitle: "花店老板"
	quest.13D6A092E34C6065.quest_desc: [
		"花朵生长在&6花店&r的蘑菇照明温室里：染料的供应线，"
		"旗帜，以及所有消耗花瓣的 Botania 配方。"
		""
		"&7它们种在堆肥里，所以堆肥机要先放好。&r"
	]
	quest.46B393AB9F0AEE14.title: "把它磨个粉碎"
	quest.46B393AB9F0AEE14.quest_subtitle: "破碎机 The Crusher"
	quest.46B393AB9F0AEE14.quest_desc: [
		"殖民地中过多的方块会进入&6Crusher&r，并以方块的形式产出"
		"需要：鹅卵石磨成砾石，再磨成沙子，骨头磨成粉。在小屋里设置要研磨的物品"
		"接口或者它处于空闲状态。"
	]
	quest.5DC55D8D1F9B20FF.title: "仓库"
	quest.5DC55D8D1F9B20FF.quest_subtitle: "所有东西最终都会汇集于此"
	quest.5DC55D8D1F9B20FF.quest_desc: [
		"每个小屋都从&6仓库&r中取物并向其存入物品；这是殖民地共用的"
		"inventory. 满仓会堵塞整个殖民地，所以满了就加架子。"
	]
	quest.473798112B5A0663.title: "需要有人去取回它（Somebody to Fetch It）"
	quest.473798112B5A0663.quest_subtitle: "信使 (The Courier)"
	quest.473798112B5A0663.quest_desc: [
		"With a &6Courier&r running between the warehouse and every hut that needs something,"
		"殖民地终于可以在没有你的情况下运行了。"
		""
		"&7One courier for every four or five working huts is about right.&r"
	]
	chapter.2859E415477AC1B0.title: "殖民地生产"
	chapter.2859E415477AC1B0.chapter_subtitle: ["伐木工、矿工和铁匠——让殖民地自给自足的棚屋。"]
	quest.4C16AD2F2E1FE699.title: "军营 (The Barracks)"
	quest.4C16AD2F2E1FE699.quest_subtitle: "守卫们真正居住的地方"
	quest.4C16AD2F2E1FE699.quest_desc: [
		"A &6Barracks&r houses a full garrison in one building instead of scattering single"
		"十几个塔楼里的守卫。这很昂贵，所以要在第一次之前开始"
		"而不是在严重袭击之后才进行。"
		""
		"&7Barracks, Archery Range and Combat Academy all need research at the University"
		"第一。驻军沿这里的上排移动，攻城器械沿下排移动。&r"
	]
	quest.782EF1363AC2F708.title: "攻城工作台"
	quest.782EF1363AC2F708.quest_subtitle: "伟大的事物诞生的地方"
	quest.782EF1363AC2F708.quest_desc: [
		"所有中世纪攻城器械都在&6攻城工作台&r组装：横梁、车轮、"
		"配重块和它们组成的引擎。多做一些横梁和炮塔底座；"
		"下面的每个引擎都消耗一堆这两种东西。"
	]
	quest.444F1AB550B8435A.title: "破城槌（The Battering Ram）"
	quest.444F1AB550B8435A.quest_subtitle: "对于那些无法打开的门来说"
	quest.444F1AB550B8435A.quest_desc: [
		"被船员推到墙边，一头&6攻城槌&r将其撞开。它速度很慢，而且"
		"声音很大，而且需要朋友来帮忙推动。"
	]
	quest.176D00509B95D888.title: "向上和越过障碍物的方法"
	quest.176D00509B95D888.quest_subtitle: "攻城梯和炮塔"
	quest.176D00509B95D888.quest_desc: [
		"你的人民用&6攻城梯&r登上城墙，并安装一个&6炮台底座&r"
		"某个地方有一个永久性的引擎。"
		""
		"&7城门上方的塔楼上架着投石机，覆盖了整个通道。&r"
	]
	quest.5792DB98315FF48D.title: "射箭场 (The Archery Range)"
	quest.5792DB98315FF48D.quest_subtitle: "训练它们射击"
	quest.5792DB98315FF48D.quest_desc: [
		"被分配为弓箭手的守卫在&6射箭场&r训练，升级速度比"
		"他们会挑事，在墙上。远程守卫能很好地守住城墙。"
	]
	quest.2A3826A90F875B60.title: "投石机（The Ballista）"
	quest.2A3826A90F875B60.quest_subtitle: "一支非常大的箭"
	quest.2A3826A90F875B60.quest_desc: [
		"&6弩&r能又快又平射出一支&6巨型箭&r，是你唯一能用的引擎"
		"可以瞄准移动的目标。箭矢从同一个工作台射出，每次一发。"
	]
	quest.6D068E4C339CE04C.title: "战斗学院"
	quest.6D068E4C339CE04C.quest_subtitle: "训练它们学会挥舞武器"
	quest.6D068E4C339CE04C.quest_desc: [
		"骑士们在&6Combat Academy&r训练，这是同一理念的近战部分。一名守卫的"
		"等级决定了它们的伤害和生命值。"
	]
	quest.491B4BE1E5C78256.title: "投石机 (The Catapult)"
	quest.491B4BE1E5C78256.quest_subtitle: "翻越墙壁，而不是穿过墙壁"
	quest.491B4BE1E5C78256.quest_desc: [
		"用&6投石机&r抛物线投掷的石头，会击中墙后的目标而不是"
		"炮台本身，与弩炮和加农炮不同，它不需要在工作台制作炮弹。"
	]
	quest.7175BB3028174620.title: "城墙上的塔楼"
	quest.7175BB3028174620.quest_subtitle: "一座兵营塔楼"
	quest.7175BB3028174620.quest_desc: [
		"每个&6兵营塔&r都会为驻军增加一名守卫和一个哨岗"
		"让他们持有。塔楼的升级与兵营本身分开进行。"
	]
	quest.5E90E029E0A6FA85.title: "八位手臂下的勇士"
	quest.5E90E029E0A6FA85.quest_subtitle: "一支驻军部队"
	quest.5E90E029E0A6FA85.quest_desc: [
		"八名守卫在列：足以让你无需站立就能熬过早期的袭击"
		"在传送门里找到你自己。"
		""
		"&7喂饱它们并装备好，否则它们会像拿着木棍的市民一样战斗。&r"
	]
	quest.67C0A5B99F4A24A4.title: "每个塔楼都有人驻守"
	quest.67C0A5B99F4A24A4.quest_subtitle: "完整的兵营建筑包"
	quest.67C0A5B99F4A24A4.quest_desc: [
		"建造所有兵营支持的&6兵营塔&r，并为所有塔配备人员。过去"
		"到了这一步，袭击就不再是你的问题了。"
	]
	quest.75630A3906922D6F.title: "投石机（Trebuchet）"
	quest.75630A3906922D6F.quest_subtitle: "带有平衡配重的那个装置"
	quest.75630A3906922D6F.quest_desc: [
		"最大的引擎，&6Trebuchet&r 会从很远的地方投下一块石头，并且会"
		"不关心你和目标之间有什么障碍。"
		""
		"&7需要配重，而且体积巨大，所以要留出足够的空间。&r"
	]
	quest.3E565B67607D0254.title: "三十勇士"
	quest.3E565B67607D0254.quest_subtitle: "一支常备军"
	quest.3E565B67607D0254.quest_desc: [
		"三十名守卫是一支真正的军队，也会消耗大量食物。检查下"
		"在招募这个困难模式之前先建好仓库。"
		""
		"&7你自己的铁匠可以为守卫制作装备。&r"
	]
	quest.74CE35CDDDF4EA78.title: "库弗林（The Culverin）"
	quest.74CE35CDDDF4EA78.quest_subtitle: "粉末和铁块"
	quest.74CE35CDDDF4EA78.quest_desc: [
		"火药随 &6Culverin&r 一同到来，这是一种能投掷 &6Cannonball&r 的平射炮"
		"而且很难。重新装填需要一段时间，所以瞄准下坡方向。"
	]
	quest.4C576F06BF547AC2.title: "八十面旗帜"
	quest.4C576F06BF547AC2.quest_subtitle: "一支军队，名副其实地"
	quest.4C576F06BF547AC2.quest_desc: [
		"八十名守卫驻守在一个市政厅下，外面停着攻城器械。"
		""
		"&7殖民地警告你不要将公民数量扩大到七十五以上。如此规模的军队是"
		"例外情况，由服务器来承担代价。&r"
	]
	quest.41BD3FD92CAE40D6.title: "砂浆搅拌机 (The Mortar)"
	quest.41BD3FD92CAE40D6.quest_subtitle: "笔直向前，笔直向下"
	quest.41BD3FD92CAE40D6.quest_desc: [
		"一个短而粗的桶，投掷角度近乎垂直，能将弹丸投掷到庭院中"
		"投石机容易投得过远，而扭力投石机无法精确瞄准。"
	]
	quest.0A147DC9EBE22E4A.title: "The Realm Holds"
	quest.0A147DC9EBE22E4A.quest_subtitle: "没有任何东西可以进入"
	quest.0A147DC9EBE22E4A.quest_desc: [
		"驻军已训练，塔楼已驻守，引擎已停放并指向外部。"
		""
		"剩下的战斗在《英雄之路》中，而且它不会来找你。"
	]
	chapter.3815F597DE40AF07.title: "王国的军团 (Armies of the Realm)"
	chapter.3815F597DE40AF07.chapter_subtitle: ["城墙上的守卫，塔楼上的弓箭手，还有能撞开大门的庞然大物。"]
	quest.25E0CA985705D766.title: "厨房里的刀（A Knife in the Kitchen）"
	quest.25E0CA985705D766.quest_subtitle: "农夫的欢乐由此开始"
	quest.25E0CA985705D766.quest_desc: [
		"&6刀&r能把肉切成更多肉，剥树皮，是农夫的第一件工具"
		"Delight 希望你有。先用燧石就好；有余力了再用铁。"
		""
		"&7包里的所有农业模组都共享此页面：先有厨房，再有田地"
		"在中间，地下室在最里面。&r"
	]
	quest.1EBD6312582AAA53.title: "窗台上的花盆"
	quest.1EBD6312582AAA53.quest_subtitle: "植物学花盆"
	quest.1EBD6312582AAA53.quest_desc: [
		"作物或树苗在室内，于其自身土壤的 &6Botany Pot&r 中自行生长，空间为 one"
		"方块宽，下方漏斗会自动为你收集。"
		""
		"&7Botany Trees 添加了树苗，这样花盆不仅可以种小麦，还可以种原木。&r"
	]
	quest.6AC3F09E94A64ABA.title: "炉灶与篮子"
	quest.6AC3F09E94A64ABA.quest_subtitle: "没有篝火也能烹饪食物"
	quest.6AC3F09E94A64ABA.quest_desc: [
		"在&6炉灶&r上烹饪的食物不会烧焦，炉灶还能用作热源"
		"烹饪锅。一个&6篮子&r可以容纳收成，并将其推入下方的任何容器中。"
	]
	quest.510D197E124FA0F0.title: "砧板 (The Cutting Board)"
	quest.510D197E124FA0F0.quest_subtitle: "Where the knife gets used"
	quest.510D197E124FA0F0.quest_desc: [
		"将食物放在&6砧板&r上，用刀敲击，能获得更多食物，比直接食用更划算"
		"合成网格给出的。它对原木、南瓜和许多模组材料都有效。"
	]
	quest.3740D17FE3FA82E9.title: "锅与煎锅 (Pot and Skillet)"
	quest.3740D17FE3FA82E9.quest_subtitle: "烹饪锅和煎锅 (Cooking Pot and Skillet)"
	quest.3740D17FE3FA82E9.quest_desc: [
		"炖菜来自&6烹饪锅&r，而&6煎锅&r能快速油炸食物。两者都放在"
		"在热源上，并且两者都需要一个容器物品在附近。"
		""
		"&7你可以拿着煎锅直接烹饪，这样携带起来很方便。&r"
	]
	quest.6160B771DECA018A.title: "市场摊位"
	quest.6160B771DECA018A.quest_subtitle: "方块脑袋的农场生活"
	quest.6160B771DECA018A.quest_desc: [
		"种子、树苗和动物可以在&6市场&r用绿宝石购买，这是最快的方式"
		"无需跋涉千里，即可填补作物列表中的空缺。"
		""
		"&7同一模组的肥料可跳过整个地块的一个生长阶段。&r"
	]
	quest.13883DD2AAECFB2B.title: "喂养牛群"
	quest.13883DD2AAECFB2B.quest_subtitle: "食槽和巢穴"
	quest.13883DD2AAECFB2B.quest_desc: [
		"被驯服的动物可以通过&6喂食槽&r繁殖，无需你站在那里点击，而且"
		"一个&6鸡窝&r会收集鸡蛋。两者都满了，鸡就不会自己跑掉。"
	]
	quest.3799A922F8705AD2.title: "更富饶的土地"
	quest.3799A922F8705AD2.quest_subtitle: "堆肥和肥沃的土壤"
	quest.3799A922F8705AD2.quest_desc: [
		"&6有机堆肥&r能将泥土变成&6肥沃土壤&r，作物生长更快且永不"
		"需要浇水。腐肉、骨粉、稻草和泥土都可以放进去，这些都是你"
		"有太多这种东西了，用不完。"
	]
	quest.47A6DF612D4E9346.title: "Croptopia"
	quest.47A6DF612D4E9346.quest_subtitle: "六十种你从未种植过的作物"
	quest.47A6DF612D4E9346.quest_desc: [
		"&6Croptopia&r 将番茄、玉米、水稻、咖啡等新品种作物散布到各个生物群系中，"
		"橄榄和长长的清单。大多数先长在野外，种子则来自"
		"作物本身，所以找到一个就等于拥有一个。"
	]
	quest.7A8F342C24CB1F18.title: "Growthcraft"
	quest.7A8F342C24CB1F18.quest_subtitle: "稻米、啤酒花、谷物和蜜蜂"
	quest.7A8F342C24CB1F18.quest_desc: [
		"&6Growthcraft&r 带来了水稻、啤酒花藤、谷物和专属的蜂箱，以及一个"
		"用&6酿造锅&r把它们变成可以喝的东西。"
		""
		"&7水稻需要静水。啤酒花需要绳子来攀爬。&r"
	]
	quest.27737FCF5F964BBF.title: "一盒蜜蜂"
	quest.27737FCF5F964BBF.quest_subtitle: "Growthcraft Apiary"
	quest.27737FCF5F964BBF.quest_desc: [
		"蜂巢、蜂蜡和蜡烛来自放置在开花树下的一套&6蜂巢箱&r。"
		""
		"&7保持蜡烛的库存。仪式章节经常需要用到它们。&r"
	]
	quest.59C9066EA459C1EB.title: "茶与咖啡"
	quest.59C9066EA459C1EB.quest_subtitle: "来做草本饮品吧 HerbalBrews"
	quest.59C9066EA459C1EB.quest_desc: [
		"&6HerbalBrews&r种植茶叶、咖啡、薰衣草和木槿，并用水壶冲泡它们"
		"适合小幅度、长时间的增益。绿茶适合挖矿之旅；咖啡适合战斗。"
	]
	quest.093E532D5DCAF6DC.title: "盐、油和奶酪"
	quest.093E532D5DCAF6DC.quest_subtitle: "每个配方都想要的三样东西"
	quest.093E532D5DCAF6DC.quest_desc: [
		"&6盐&r来自熔炼Croptopia水瓶，&6橄榄油&r来自压榨橄榄，还有"
		"用牛奶制作&6奶酪&r。Croptopia的配方列表基于这三种，所以全部获取"
		"在尝试任何高难度操作之前，先完成它们中的几个。"
	]
	quest.5B9FE217747A1D3D.title: "藤上的葡萄"
	quest.5B9FE217747A1D3D.quest_subtitle: "Let's Do Vinery"
	quest.5B9FE217747A1D3D.quest_desc: [
		"在腐殖土上种植&6葡萄藤&r，等待结果，然后手工采摘葡萄。 &6酿酒厂&r"
		"整个小产业都围绕着那一种植物运转。"
		""
		"&7Loam 由黏土和沙子制成。没有它，葡萄就无法生长。&r"
	]
	quest.7431F7F84CBDB9E4.title: "按下苹果按钮"
	quest.7431F7F84CBDB9E4.quest_subtitle: "苹果酒和果汁"
	quest.7431F7F84CBDB9E4.quest_desc: [
		"用&6苹果压榨机&r榨出的苹果汁会发酵成苹果酒。这是"
		"Vinery 的温和一端，完全不需要任何葡萄。"
		""
		"&7Growthcraft 苹果树可以批量供应苹果。&r"
	]
	quest.5FDD10669B46A361.title: "长长的桌子"
	quest.5FDD10669B46A361.quest_subtitle: "妥善喂养殖民地中的所有生物"
	quest.5FDD10669B46A361.quest_desc: [
		"教你的殖民地&6厨师&r这些模组的食谱，整个定居点就有饭吃了"
		"能提升幸福感的菜肴。打开厨师厨房，前往食谱标签页并添加"
		"厨师会从那以后负责处理它们的所有事情。"
	]
	quest.37BD4082FF3A42B7.title: "进入木桶中"
	quest.37BD4082FF3A42B7.quest_subtitle: "发酵过程"
	quest.37BD4082FF3A42B7.quest_desc: [
		"葡萄和瓶子一起放入&6发酵桶&r，就能酿成葡萄酒。"
		"不同的葡萄酿成不同的葡萄酒，饮用后会产生不同的效果。"
		""
		"&7Wine keeps improving in a Wine Box, so age the good bottles.&r"
	]
	quest.6DCA4B84FEFBC4F7.title: "啤酒与葡萄酒的结合"
	quest.6DCA4B84FEFBC4F7.quest_subtitle: "一个完整的地下室"
	quest.6DCA4B84FEFBC4F7.quest_desc: [
		"在已经陈酿的葡萄酒桶旁放置一个用于酿啤酒的&6Brewingstation&r，以及两个"
		"该整合包的四个饮品模组正在并行运行。"
		""
		"&7每种饮品都有独特的效果，在首领战前最好先确认一下。&r"
	]
	chapter.36FDE7C02708683F.title: "炉火与丰收"
	chapter.36FDE7C02708683F.chapter_subtitle: ["刀具、容器和压榨机。整合包里的所有农业模组及其用途。"]
	quest.7A49A346BA0AD8C7.title: "给它盖上一个屋顶"
	quest.7A49A346BA0AD8C7.quest_subtitle: "Macaw's Roofs"
	quest.7A49A346BA0AD8C7.quest_desc: [
		"&6Macaw's Roofs&r 为游戏中所有木材和石材添加了斜屋顶，此外"
		"排水槽、雨篷以及让它们完美衔接的转角部件。在六百"
		"blocks 它是本整合包中最大的单个装饰模组。"
	]
	quest.10AA5693F3D01C41.title: "建筑师切割机 (The Architect's Cutter)"
	quest.10AA5693F3D01C41.quest_subtitle: "Domum Ornamentum"
	quest.10AA5693F3D01C41.quest_desc: [
		"&6Domum Ornamentum&r 是 MineColonies 建造的方块集合：砖块、瓦片、"
		"木结构框架，全部在 &6建筑师切割机&r 上切割。"
		""
		"&7木结构需要两种材料，所以一个配方就能实现上百种外观。&r"
	]
	quest.58723811DACA4C46.title: "建筑魔杖 (The Construction Wand)"
	quest.58723811DACA4C46.quest_subtitle: "一次性放置一整面墙"
	quest.58723811DACA4C46.quest_desc: [
		"用&6建筑魔杖&r沿着一个表面看过去，它就会朝那个方向延伸，就像"
		"魔杖等级和背包空间允许的情况下。石头、铁、钻石和"
		"无限法杖的射程一个比一个远。"
	]
	quest.4C02F5C9979816D3.title: "门和活板门"
	quest.4C02F5C9979816D3.quest_subtitle: "Macaw's Doors"
	quest.4C02F5C9979816D3.quest_desc: [
		"配套的西式门、谷仓门、玻璃门、马厩门和活板门，全部"
		"来自同一个模组家族的作品。"
		""
		"&7门高两格，和原版一样，可以嵌入现有的门框中。&r"
	]
	quest.4D1FC89306FC4396.title: "复制粘贴"
	quest.4D1FC89306FC4396.quest_subtitle: "Structurize"
	quest.4D1FC89306FC4396.quest_desc: [
		"&6Structurize&r scans a building into a file with the &6Scan Tool&r and places it"
		"使用建造工具在任意地方再次建造。"
		""
		"&7这也是为你的殖民地创建自定义 MineColonies 风格的方法。&r"
	]
	quest.5CA3BA3CF60C0412.title: "让一些光透进来"
	quest.5CA3BA3CF60C0412.quest_subtitle: "Macaw's Windows"
	quest.5CA3BA3CF60C0412.quest_desc: [
		"&6Macaw's Windows&r 包括百叶窗、遮光帘、箭孔和框架内的彩色玻璃"
		"与屋顶对齐。可伸缩的窗户会拉伸以填满任何空隙"
		"你离开了。"
	]
	quest.6D4E773A6BE28EA9.title: "五种颜色的砖块"
	quest.6D4E773A6BE28EA9.quest_subtitle: "彩色石头和砖块"
	quest.6D4E773A6BE28EA9.quest_desc: [
		"同一种切割机可以制作出原版从未有过的颜色的砖块和石砖：沙子、"
		"奶油色、米色、骟马色和棕色。将这些教给石匠，殖民地就会彩色建造"
		"而不是用鹅卵石来建造。"
	]
	quest.325999F2E3F4B616.title: "围栏与十字路口"
	quest.325999F2E3F4B616.quest_subtitle: "Macaw's Fences and Bridges"
	quest.325999F2E3F4B616.quest_desc: [
		"高栅栏、尖桩篱笆、绳桥和石拱门：最后两个模组在"
		"鹦鹉套装随此整合包一同发布。"
		""
		"&7绳桥只需几块木板和线，就能干净地横跨峡谷。&r"
	]
	quest.4F2C23D4CB46286C.title: "中世纪服饰搭配"
	quest.4F2C23D4CB46286C.quest_subtitle: "中世纪装饰模组 Medieval Deco"
	quest.4F2C23D4CB46286C.quest_desc: [
		"桶、木箱、船首像、市场道具。 &6Medieval Deco&r 让街道充满"
		"让它看起来有人住过的杂乱景象。"
	]
	quest.4EE966263366B39C.title: "填充和替换"
	quest.4EE966263366B39C.quest_subtitle: "替换方块"
	quest.4EE966263366B39C.quest_desc: [
		"&6Solid&r 和 &6Fluid Substitution&r 方块标明了扫描的建筑应使用的位置"
		"固定方块之外，已有方块也会被替换。装满它们的扫描仪适用于任何"
		"山坡上，你把它扔下去的地方。"
	]
	quest.24E98B3041865E65.title: "Quark的奇特方块模组"
	quest.24E98B3041865E65.quest_subtitle: "瓦片、茅草、垂直木板"
	quest.24E98B3041865E65.quest_desc: [
		"&6Quark&r 悄悄添加了数百种建筑材料，包括茅草、瓦片、"
		"垂直岩板、绿松石和页岩。"
		""
		"&7它的铲子每次挥舞都会放置随机一个你快捷栏里的方块，所以用"
		"三个相似的方块看起来就不再像铺贴的了。&r"
	]
	quest.2F1B19DF3CC2899F.title: "椅子和沙发"
	quest.2F1B19DF3CC2899F.quest_subtitle: "手工制作的物品需要特定的配方和材料才能合成。"
	quest.2F1B19DF3CC2899F.quest_desc: [
		"&6手工打造&r，涵盖各种木材制成的椅子、沙发、桌子、橱柜和架子，还有"
		"这是 MineColonies 建筑师自己使用的家具。"
		""
		"&7MineColonies' own builders place its cupboards and shelves throughout a colony.&r"
	]
	quest.779F3964E67DE547.title: "悬挂一幅画作"
	quest.779F3964E67DE547.quest_subtitle: "沉浸式绘画模组 (Immersive Paintings)"
	quest.779F3964E67DE547.quest_desc: [
		"&6Immersive Paintings&r 让你可以调整画作的尺寸，选择想要哪一幅，并且"
		"用一张截图做一个。再也不用重复放置九幅相同的画来祈祷了"
		"以获得正确的掷骰结果。"
	]
	quest.11A75255C7BB2AA9.title: "书桌和抽屉"
	quest.11A75255C7BB2AA9.quest_subtitle: "Valhelsia 家具"
	quest.11A75255C7BB2AA9.quest_desc: [
		"&6Valhelsia Furniture&r 涵盖了另外两个模组跳过的物品：带抽屉的桌子，"
		"凳子，还有能发出光线的灯。桌子上放着物品。"
	]
	quest.4BBC80BFA9F6C7B5.title: "餐桌上的美食"
	quest.4BBC80BFA9F6C7B5.quest_subtitle: "可放置的食物和物品"
	quest.4BBC80BFA9F6C7B5.quest_desc: [
		"两个小模组将食物和普通物品放置为方块：面包放在桌子上，"
		"锭子堆在架子上，鸡蛋放在篮子里。大部分都可以通过右键放置"
		"将物品放置到表面上，而不是通过合成获得。"
		""
		"&7放置的物品会保留堆叠，需要时再拾取即可。&r"
	]
	quest.3FD291E1E0D95BED.title: "王座大厅的家具配置"
	quest.3FD291E1E0D95BED.quest_subtitle: "奇幻家具工坊"
	quest.3FD291E1E0D95BED.quest_desc: [
		"&6Fantasy's Furniture&r 包含多个主题套装：皇家、邓莫尔、诺德、亡灵领主、温希尔和"
		"骨头。每件物品都在&6家具站&r制作，一个工作站即可满足所有需求。"
		""
		"&7皇家套装正是本整合包中王座厅应有的模样。&r"
	]
	chapter.7AFF50617333F76C.title: "大厅与家园"
	chapter.7AFF50617333F76C.chapter_subtitle: ["屋顶、家具和装饰——将带门的盒子变成大厅的模组。"]
	task.75E3E2BF815EB881.title: "杀死 25 只僵尸"
	quest.41FB99370D73710A.title: "付费参战"
	quest.41FB99370D73710A.quest_subtitle: "钱是从这里来的地方"
	quest.41FB99370D73710A.quest_desc: [
		"你杀死的每个敌对生物都会给你&6一枚硬币&r，而杀戮是你大部分"
		"钱从哪里来呢？没有矿石可卖，也没有作物可磨。二十五"
		"僵尸就足以作为我们的首个目标了。"
		""
		"用 &6/shop&r 来花掉它们，可以买到食物、殖民地部件、工具、宠物和 Alex's"
		"洞穴地图，并在“出售”标签页上购买盈余。旁边的&6市场&r列出了你的"
		"以你设定的价格向其他玩家出售自己的物品。其余的由&6简易村民&r完成"
		"本页面涵盖的内容，会提供完全属于你并可自动化的交易，与"
		"没有其他人在线。"
		""
		"&7击杀数按玩家计算，所以队伍里的每个人在同一场战斗中都会获得报酬。&r"
	]
	quest.530BD5A11479DB1C.title: "古老的方式"
	quest.530BD5A11479DB1C.quest_subtitle: "与村民进行交易"
	quest.530BD5A11479DB1C.quest_desc: [
		"村民们仍然像往常一样工作，而拥有合适书籍的图书管理员"
		"交易价格比商店里的大多数物品都高。"
		""
		"&7打破并替换他们的工作台，直到出现你想要的交易为止。&r"
	]
	quest.3EA0527B70408550.title: "箱子里的村民"
	quest.3EA0527B70408550.quest_subtitle: "简易村民模组"
	quest.3EA0527B70408550.quest_desc: [
		"用空手抱起一个村民，然后放入&6Trader&r方块中。他们的"
		"交易变成你点击的屏幕，永久有效，在室内，不会四处走动。"
	]
	quest.0F5BA4DB0906E780.title: "更多来自那里的东西 (More Where That Came From)"
	quest.0F5BA4DB0906E780.quest_subtitle: "繁殖器和孵化器"
	quest.0F5BA4DB0906E780.quest_desc: [
		"两个村民和食物进入&6Breeder&r，幼崽就出来了；&6Incubator&r可以生长"
		"随叫随到地繁殖幼崽。胡萝卜或面包可使其无限繁殖。"
	]
	quest.39DB3BA6C16C6232.title: "没有你的交易"
	quest.39DB3BA6C16C6232.quest_subtitle: "自动交易者"
	quest.39DB3BA6C16C6232.quest_desc: [
		"在村民的交易中设置一个&6自动交易机&r，它就会自己运行，从一个地方获取物品"
		"一边输入，另一边输出。找一个能赚钱的交易，然后完成"
		"在你去别的地方的时候收集绿宝石。"
	]
	quest.0C7CD293CADC48B8.title: "富有"
	quest.0C7CD293CADC48B8.quest_subtitle: "九组绿色的物品堆叠"
	quest.0C7CD293CADC48B8.quest_desc: [
		"一面由绿宝石方块组成的墙，靠努力而非运气获得。"
		""
		"&7村民农民身上的自动交易者是最快的路线。&r"
	]
	quest.098832F90DA4B6DB.title: "治愈被诅咒的生物"
	quest.098832F90DA4B6DB.quest_subtitle: "转换器"
	quest.098832F90DA4B6DB.quest_desc: [
		"僵尸村民在&6转换器&r中被治愈，你无需站在那里手持物品"
		"溅射药水，还有希望。"
		""
		"&7被治愈的村民会永久折扣交易，以回报金苹果。&r"
	]
	quest.1F15DB0F0385D181.title: "随取随用的铁锭"
	quest.1F15DB0F0385D181.quest_subtitle: "铁质农场方块"
	quest.1F15DB0F0385D181.quest_desc: [
		"三个村民在一个&6铁农场&r方块中生产哥布林，哥布林会生产铁，在"
		"一个区块的空间，而不是一个方块的空间。"
	]
	chapter.0766EA595AC3EF1D.title: "货币与商业"
	chapter.0766EA595AC3EF1D.chapter_subtitle: ["击杀掉落金币，商店可以花金币，村民从不睡觉。"]
	quest.7AD9D56A86E12487.title: "选择一个形状"
	quest.7AD9D56A86E12487.quest_subtitle: "简易刀剑模组"
	quest.7AD9D56A86E12487.quest_desc: [
		"&6Simply Swords&r 为每种原版材质添加了十五种武器形状：太刀、"
		"手斧、细剑、镰刀、战斧、回旋镖。每种形状都有不同的挥舞方式，"
		"所以在决定之前多试几种吧。"
		""
		"这一行中的所有配方都是普通配方，没有新金属。该列"
		"右边就是新金属开始的地方了。"
	]
	quest.5DEA44FAE1C48652.title: "正确地为其附魔"
	quest.5DEA44FAE1C48652.quest_subtitle: "附魔注入器 (Enchanting Infuser)"
	quest.5DEA44FAE1C48652.quest_desc: [
		"在&6附魔催化器&r中选择附魔，而不是用青金石赌博"
		"为此特权。高级版能达到与普通书架相同的高度"
		"戒指会这样做。"
	]
	quest.2AF2CB42A91F7779.title: "攻击距离和范围"
	quest.2AF2CB42A91F7779.quest_subtitle: "斯巴达武器模组"
	quest.2AF2CB42A91F7779.quest_desc: [
		"&6Spartan Weaponry&r 是同一理念的另一半：长矛、战斧，"
		"回旋镖、标枪、长弓和重型十字弓。"
		""
		"&7副手格挡匕首，与细剑搭配使用效果更佳。&r"
	]
	quest.552BD2DA4EE9AA80.title: "带脸的盔甲"
	quest.552BD2DA4EE9AA80.quest_subtitle: "沉浸式盔甲模组 (Immersive Armors)"
	quest.552BD2DA4EE9AA80.quest_desc: [
		"&6Immersive Armors&r 在皮革和下界合金之间添加了十套完整盔甲：战士、"
		"heavy, robe, prismarine, bone, wither. 每套装备除了基础效果外，还会附加独特的效果"
		"数字，并且工具提示中会显示出来。"
		""
		"&7卷轴，一次性施放，与...一同出现在地牢宝箱中"
		"盔甲，无需使用魔法书即可使用。&r"
	]
	task.4C306B3EB8E1950F.title: "找到任意一件遗迹物品"
	quest.06F28B4971B8A2E2.title: "小饰品"
	quest.06F28B4971B8A2E2.quest_subtitle: "远古遗物"
	quest.06F28B4971B8A2E2.quest_desc: [
		"&6Artifacts&r 无法合成。它们会出现在拟态箱和露营地中"
		"散落在地下：能二段跳的靴子、能在黑暗中视物的帽子、腰带"
		"能让你免于溺水。它们放在 Curios 栏位，不占用护甲槽。"
	]
	quest.2EFB9A340D3F62DF.title: "骨头和史莱姆"
	quest.2EFB9A340D3F62DF.quest_subtitle: "奇怪的套装系列"
	quest.2EFB9A340D3F62DF.quest_desc: [
		"&6骨头&r盔甲便宜又能吓退亡灵；&6史莱姆&r盔甲会弹跳。两者都"
		"都提前了，而且两者都做了plate做不到的事情。"
		""
		"&7骨头装备也是该整合包召唤仪式的组成部分之一。&r"
	]
	quest.593B6CE2022E0060.title: "Demonite"
	quest.593B6CE2022E0060.quest_subtitle: "魂系武器模组开始加载"
	quest.593B6CE2022E0060.quest_desc: [
		"&6马里乌姆的魂系武器&r使用自己的金属。 &6恶魔矿石块&r可熔炼"
		"成为&6绯红锭&r，而月光石则产自深板岩。其首领会掉落"
		"休息，还有野兽和首领，这些内容都涵盖在内。"
	]
	quest.7D90A0092BC0E816.title: "一个完整的架子"
	quest.7D90A0092BC0E816.quest_subtitle: "每种各一个"
	quest.7D90A0092BC0E816.quest_desc: [
		"Simply Swords 的刀刃，Spartan 的长柄武器，Fantasy 的命名武器"
		"武器，和一套配套的盔甲悬挂在它们旁边。"
		""
		"&7Halls and Homes 的盔甲架和画作，使其成为一个武器库。&r"
	]
	quest.20A540F5DAFAF953.title: "灵魂灌注铁"
	quest.20A540F5DAFAF953.quest_subtitle: "迷失的灵魂，投入工作吧"
	quest.20A540F5DAFAF953.quest_desc: [
		"将&6迷失的灵魂&r与铁锭结合，可获得&6灵魂灌注锭&r，通往"
		"该模组的中等装备。"
		""
		"&7迷失的灵魂直接从灵魂沙中冶炼，并由模组中的黑暗巫师掉落。&r"
	]
	quest.6E60237498774BF2.title: "下界合金，终于来了"
	quest.6E60237498774BF2.quest_subtitle: "其余部分都位于大门的后面"
	quest.6E60237498774BF2.quest_desc: [
		"本章中的三个模组会升级&lfrom&r一件下界合金武器。直到你拿起"
		"一、它们在 JEI 里的页面是一份愿望清单。"
		""
		"&7来自下界的远古残骸：每锭四个废料和四个黄金。&r"
	]
	quest.7ADE178DDA9EA016.title: "烈焰石"
	quest.7ADE178DDA9EA016.quest_subtitle: "奇幻武器"
	quest.7ADE178DDA9EA016.quest_desc: [
		"&6Blazing Stone&r，由烈焰粉、萤石和石头制成，能将下界合金转化为"
		"在锻造台将武器变为幻想武器系列中六十把命名剑之一：刺剑、"
		"跳舞的刀刃，屠龙者的战斧。"
	]
	quest.0891ABE2D473A970.title: "一把带有名字的刀刃"
	quest.0891ABE2D473A970.quest_subtitle: "货架上的一件物品"
	quest.0891ABE2D473A970.quest_desc: [
		"拿一个下界合金武器、一个烈焰石和一个锻造台，然后选一个。有"
		"有六十种，而且它们的战斗方式并不完全相同。"
		""
		"&7奇幻盔甲的运作方式相同，但需要的是月亮水晶。&r"
	]
	quest.6C8D549446412719.title: "骑士的胸甲"
	quest.6C8D549446412719.quest_subtitle: "奇幻盔甲"
	quest.6C8D549446412719.quest_desc: [
		"与武器同风格的三十套盔甲：熔炉骑士、棋盘"
		"骑士、屠龙者、黑暗领主。每个都有各自的属性和效果，快去看看吧"
		"在你放置水晶之前，先完成这些步骤。"
	]
	quest.6B97C4E2397924CC.title: "符文铭文"
	quest.6B97C4E2397924CC.quest_subtitle: "Simply Swords 的顶部"
	quest.6B97C4E2397924CC.quest_desc: [
		"将地牢宝箱中的&6符文石板&r、下界合金简易之剑和钻石组合以获得"
		"&6符文武器，&r可附魔、可升级的模组终章。"
		""
		"&7符文融合宝石更进一步，加入了哭泣的黑曜石。&r"
	]
	chapter.16C1E15AD2D57E08.title: "武器库 (The Armory)"
	chapter.16C1E15AD2D57E08.chapter_subtitle: ["手斧、太刀、长矛和巨剑——以及它们来自哪个模组。"]
	task.059569D9D14EAE46.title: "击杀远古残骸（Ancient Remnant）"
	quest.7AAA12290AA7CC74.title: "远古遗迹 (The Ancient Remnant)"
	quest.7AAA12290AA7CC74.quest_subtitle: "沙漠遗址"
	quest.7AAA12290AA7CC74.quest_desc: [
		"埋在沙漠下的石质守护者，八位中最温和的一位。打破它的"
		"在它们再次关闭之前收集石质台阶。"
		""
		"&7如果你不想主动寻找，整合包的仪式祭坛可以召唤它。&r"
	]
	task.3A6E8401AA8DFACF.title: "击杀利维坦（Leviathan）"
	quest.4DA81F6F8373D921.title: "利维坦（The Leviathan）"
	quest.4DA81F6F8373D921.quest_subtitle: "沉没的城市"
	quest.4DA81F6F8373D921.quest_desc: [
		"深海遗迹中沉没的巨像。战斗发生在水下，而且"
		"那才是难办的部分。"
		""
		"&7带上一个导管，或者至少带上呼吸和一把门。&r"
	]
	task.07BD76E56F28C3AC.title: "击杀下界合金巨兽"
	quest.45FBB802B69F9C29.title: "下界合金的怪物形态"
	quest.45FBB802B69F9C29.quest_subtitle: "燃烧的竞技场"
	quest.45FBB802B69F9C29.quest_desc: [
		"一种在末地中投掷熔岩炸弹和冲击波的巨大装甲生物。它"
		"速度很慢，而且防火几乎是强制性的。"
		""
		"&7它会掉落 Infernal Forge，即两种终局融合武器都用来制作的镐子。&r"
	]
	task.1702F605327F8426.title: "杀死斯库拉（Scylla）"
	task.17C0B9655D154D42.title: "击杀珊瑚巨兽（Coralssus）"
	quest.7ABEFAA8454CA5B3.title: "斯库拉和科拉索斯"
	quest.7ABEFAA8454CA5B3.quest_subtitle: "海洋的另外两种生物"
	quest.7ABEFAA8454CA5B3.quest_desc: [
		"&6斯奇拉&r守卫着冰冻的监狱；&6珊瑚索斯&r坐在珊瑚中。两者都并非如"
		"它们和利维坦一样巨大，而且比看起来更强力，所以要逐个击破。"
	]
	task.4F770723B35307B5.title: "击杀 Ignis"
	quest.1EF8B1539FE3CCA8.title: "Ignis"
	quest.1EF8B1539FE3CCA8.quest_subtitle: "远古工厂"
	quest.1EF8B1539FE3CCA8.quest_desc: [
		"火焰骑士，早期最难的战斗之一：火球、火焰打击，"
		"以及一个会改变规则的第二个阶段。"
		""
		"&7Ignis会掉落&6Ignitium&r，这是它防火盔甲和焚化炉背后的金属锭。&r"
	]
	task.0FB466B33EE30812.title: "击杀 Maledictus"
	quest.62A4EEE977063CEF.title: "Maledictus"
	quest.62A4EEE977063CEF.quest_subtitle: "被诅咒的金字塔"
	quest.62A4EEE977063CEF.quest_desc: [
		"被诅咒的法老，在一个满是曾经活人遗骸的金字塔里。他速度很快"
		"而且挥砍时它不会停留在原地。"
		""
		"&7先清理金字塔。仆从们还活着，战斗方式就不同了。&r"
	]
	task.22AF78E0E8EBA2EB.title: "杀死先兆者（Harbinger）"
	quest.43AC61AD3F70791A.title: "先遣者 (The Harbinger)"
	quest.43AC61AD3F70791A.quest_subtitle: "废弃的村庄"
	quest.43AC61AD3F70791A.quest_desc: [
		"一个收割大范围圆形区域并靠击杀目标来恢复生命值的瘦长怪物。请远离"
		"自己召唤生物组成的庞大队伍。"
		""
		"&7在召唤祭坛上放置三个凋零骷髅和一个猪也能获得它。&r"
	]
	task.6E3F48ACF8B08F09.title: "击杀末地守卫（Ender Guardian）"
	quest.5DD36909EE171D3E.title: "末地守护者"
	quest.5DD36909EE171D3E.quest_subtitle: "被毁的堡垒"
	quest.5DD36909EE171D3E.quest_desc: [
		"在末地等待，在巨龙从未触及的堡垒中。它会传送，它会召唤"
		"石像鬼，而且它不会感到疲倦。"
		""
		"&7为哥布林准备远程武器，留出躲避虚空符文的空间，并为持久战备好食物。&r"
	]
	quest.7B9885A9F788AB87.title: "Witherite"
	quest.7B9885A9F788AB87.quest_subtitle: "那些首领有什么用呢"
	quest.7B9885A9F788AB87.quest_desc: [
		"&6Witherite&r 由 Harbinger 掉落，可锻造 Wither Assault Shoulder Weapon，"
		"肉绞机、激光加特林和焊接机械的机械融合砧"
		"将 boss 武器相互融合在一起。"
	]
	quest.356283A77462DD43.title: "寸草不生，片瓦不留"
	quest.356283A77462DD43.quest_subtitle: "王国的怪物们，已经回应了"
	quest.356283A77462DD43.quest_desc: [
		"八个竞技场被清空，一个王国的骑士被击败，还有一排武器"
		"它们的存在仅仅是因为你完成了这件事。"
		""
		"Here Be Dragons 是另一端的终点，是一场不同类型的战斗。"
	]
	quest.7D5CA69EF6F80739.title: "The Decaying Kingdom"
	quest.7D5CA69EF6F80739.quest_subtitle: "Soulslike Weaponry 的 boss 们"
	quest.7D5CA69EF6F80739.quest_desc: [
		"一座大教堂、一组冠军的坟墓、一个腐化的祭坛，以及在下界深处的一个"
		"ruined kingdom, each with its own boss: the Returning Knight, the Old Champion, the"
		"混沌之王与腐朽的君主。"
		""
		"&7每位骑士都会掉落领主之魂，模组中最强的武器就是用它们锻造的。&r"
	]
	quest.584CB69543A6C66E.title: "Alex's Mobs"
	quest.584CB69543A6C66E.quest_subtitle: "九十个以前没有的动物加入了进来"
	quest.584CB69543A6C66E.quest_desc: [
		"&6Alex's Mobs&r 为这个世界增添了真实的野生动物：灰熊、大猩猩、虎鲸，"
		"科莫多巨蜥、绯红蚊子、骨蛇。《&6动物词典&r》记载"
		"你知道每个生物会掉落什么，以及如何驯服它们。"
	]
	quest.409B83FC23CC13F4.title: "远古洞穴 (The Primordial Caves)"
	quest.409B83FC23CC13F4.quest_subtitle: "长着牙齿的生物"
	quest.409B83FC23CC13F4.quest_desc: [
		"世界之下的史前地层，还配有相应的史前动物。琥珀"
		"下面这里放着值得提取的东西。"
		""
		"&7恐龙碗是一个带牙齿的竞技场，所以请带上武器再进去。&r"
	]
	quest.00B33015BBD55299.title: "领主之魂（Lord Soul）"
	quest.00B33015BBD55299.quest_subtitle: "树的顶端"
	quest.00B33015BBD55299.quest_desc: [
		"击败一名骑士，夺取其&6领主之魂&r，并将其锻造到一件下界合金物品上"
		"武器。大多数列表中的武器，任何骑士之魂都适用；熔炉之剑是一把"
		"强有力的首选。"
	]
	quest.65203AC9E8F8636F.title: "被遗忘的幽谷 (The Forlorn Hollows)"
	quest.65203AC9E8F8636F.quest_subtitle: "黑暗中的一员"
	quest.65203AC9E8F8636F.quest_desc: [
		"吸血蝙蝠、一个女巫塔，还有一座横跨峡谷的大桥，不知是谁建造的"
		"目的。"
		""
		"&7在荒原中，光不会传播，所以火把是用来放置的，而不是用来"
		"通过视觉来辨别。&r"
	]
	quest.1492BEBE30924B0E.title: "深渊裂谷"
	quest.1492BEBE30924B0E.quest_subtitle: "在海底之下"
	quest.1492BEBE30924B0E.quest_desc: [
		"比深暗更深处，也更潮湿得多：深海生物、遗迹和压力"
		"完全不在意你头盔的怪物。"
		""
		"&7最后一个留到最后。需要水肺和压力保护。&r"
	]
	task.5F47C648D3EE6F80.title: "清除门户的每一波怪物"
	quest.6EB92FBA413A2209.title: "无尽浪潮 (Waves Without End)"
	quest.6EB92FBA413A2209.quest_subtitle: "一个传送门，运行正常"
	quest.6EB92FBA413A2209.quest_desc: [
		"在你控制的某个地方打开一个&6Gateway&r，并清除它投掷的每波怪物。越高的"
		"各等级都从本章的所有内容中抽取。"
		""
		"&7把殖民地守卫带过来。这就是他们的用处。&r"
	]
	chapter.5B4D6BA827BB3E32.title: "野兽与首领"
	chapter.5B4D6BA827BB3E32.chapter_subtitle: ["八个灾变首领，一个衰败王国里的骑士，还有洞穴。"]
	quest.4D47915AE7BB9F13.title: "一张被撕毁的页面"
	quest.4D47915AE7BB9F13.quest_subtitle: "手稿"
	quest.4D47915AE7BB9F13.quest_desc: [
		"&6手稿&r会出现在普通的地牢和矿井的战利品中，并由蚁人掉落"
		"以及模组自身的坟场中。其中三个可以堆叠成一个&6Bestiary&r。"
	]
	quest.72853B1AB6BDC38D.title: "鬼魂与墓地"
	quest.72853B1AB6BDC38D.quest_subtitle: "bestiary's quieter pages"
	quest.72853B1AB6BDC38D.quest_desc: [
		"&6鬼魂&r会出没于模组的墓地和穿过墙壁，它们的剑也能做到"
		"盔甲也是如此。"
		""
		"&7鬼魂宝箱会将物品存放在无人能及的地方。&r"
	]
	quest.278F8F6EFC836B67.title: "山上的一个鸟巢"
	quest.278F8F6EFC836B67.quest_subtitle: "找到一条龙"
	quest.278F8F6EFC836B67.quest_desc: [
		"&6火、冰&r和&6闪电&r龙各有洞穴和地表巢穴，而且每种"
		"鸟巢是一个坐在成年生物身上的巢穴。"
		""
		"&7年龄比什么都重要，所以决定前请先确认大小。&r"
	]
	quest.6CD8EDC8178D8C67.title: "生物图鉴 (The Bestiary)"
	quest.6CD8EDC8178D8C67.quest_subtitle: "模组会告诉你的所有事情"
	quest.6CD8EDC8178D8C67.quest_desc: [
		"冰与火的指南是&6生物图鉴&r，遇到新生物时会自动补充。阅读"
		"去寻找一条龙之前，先阅读这些龙的篇章吧。"
		""
		"&7潜行点击，把它放入你的阿卡夏魔典，这样它就不会再消失了。&r"
	]
	quest.02488CDBA149A0F6.title: "斯芬克斯之鸟"
	quest.02488CDBA149A0F6.quest_subtitle: "一群羊比一个 boss 还难对付"
	quest.02488CDBA149A0F6.quest_desc: [
		"它们成群结队，会向你投掷自己的羽毛，而且羽毛还会粘在身上。"
		"那些羽毛能做成箭，这样战斗就不会白费了。"
	]
	quest.15439AFA6835C5D9.title: "杀死一条龙"
	quest.15439AFA6835C5D9.quest_subtitle: "该模组名称所指的战斗"
	quest.15439AFA6835C5D9.quest_desc: [
		"骨头、鳞片、血液和头骨。一只成年龙会携带所有这些，并使用每一"
		"保留一小部分天空来保存它。"
		""
		"&7在地面上和它战斗。空中的龙完全是另一回事了。&r"
	]
	quest.7B24E0C56DA06EC5.title: "白银和蓝宝石"
	quest.7B24E0C56DA06EC5.quest_subtitle: "模组本身的矿石种类"
	quest.7B24E0C56DA06EC5.quest_desc: [
		"&6银&r的生成方式与铁类似，而&6蓝宝石&r则与钻石类似。银构成了大部分"
		"该模组的中等装备，以及龙藏蓝宝石，所以有两种方法可以获得它们。"
	]
	quest.3BB8A5709F46E345.title: "恐怖之地 (The Dread Lands)"
	quest.3BB8A5709F46E345.quest_subtitle: "冰与火模组专属维度"
	quest.3BB8A5709F46E345.quest_desc: [
		"一座由恐怖之石和守护它们的亡灵构成的灰色世界，可通过一座陵墓抵达"
		"在主世界。恐惧装备不错，但得计划好怎么再次出来。"
	]
	quest.297163A3EC4866AD.title: "骨头和鳞片"
	quest.297163A3EC4866AD.quest_subtitle: "从它上面能掉落出什么东西来"
	quest.297163A3EC4866AD.quest_desc: [
		"&6Dragonbone&r 制作武器；&6Dragonscales&r 制作盔甲，每种颜色一套"
		"dragon。两者都可在普通工作台上进行合成。"
		""
		"&7颜色仅为外观效果，属性相同。&r"
	]
	quest.2CCF7FB8C27BC6E9.title: "一枚属于你自己的蛋"
	quest.2CCF7FB8C27BC6E9.quest_subtitle: "不如直接提升一个等级好了"
	quest.2CCF7FB8C27BC6E9.quest_desc: [
		"从宝藏中取一个&6龙蛋&r，把它放在巢里并点燃，它就会孵化成一只"
		"与你一同成长的巨龙。一个&6龙之角&r可以携带它，一个&6龙之笛&r可以召唤它归来。"
		""
		"&7要一直喂食。饥饿的龙无法成长。&r"
	]
	quest.0BA87C9827345057.title: "独眼巨人洞穴"
	quest.0BA87C9827345057.quest_subtitle: "从小处着手"
	quest.0BA87C9827345057.quest_desc: [
		"绵羊和一个值得打开的箱子坐落在一个由&6独眼巨人&r守卫的洞穴里。它行动缓慢，"
		"巨大无比，而且会把你接上去。"
		""
		"&7瞄准它的眼睛。被致盲的独眼巨人无法锁定你。&r"
	]
	quest.21BBE8117452D7EA.title: "山脚下的巨魔 (Trolls Under the Mountain)"
	quest.21BBE8117452D7EA.quest_subtitle: "三种类型，三种皮革"
	quest.21BBE8117452D7EA.quest_desc: [
		"森林、霜冻和山脉的&6巨魔&r生活在洞穴里，白天会变成石头。"
		"它们的皮能做成三套盔甲，武器也会掉落，伤害更高"
		"比它们的外表所暗示的要强大得多。"
	]
	quest.7098112BFBB5D2BD.title: "建造锻造炉"
	quest.7098112BFBB5D2BD.quest_subtitle: "砖块、一个核心、一个输入接口"
	quest.7098112BFBB5D2BD.quest_desc: [
		"在带有输入的核周围放置火焰砖，即可建造小型的多方块结构&6龙之锻造炉&r"
		"只有在活着的龙吹气时才会发光。砖块是铺好的石砖"
		"在龙鳞方块周围，每种元素都需要自己的锻造炉。"
	]
	quest.6AE9B05EA453AD7D.title: "海妖与海蛇"
	quest.6AE9B05EA453AD7D.quest_subtitle: "不要在没有耳塞的情况下航行"
	quest.6AE9B05EA453AD7D.quest_desc: [
		"&6塞壬&r会把水手从船上唱下去。 &6耳塞&r可以阻止，而且是在之前制作的"
		"你遇到的一个，而不是之后的一个。"
		""
		"&7海蛇鳞片能制作潮汐盔甲，本整合包最强的水上装备。&r"
	]
	quest.28C680AE6CC07D43.title: "死亡蠕虫"
	quest.28C680AE6CC07D43.quest_subtitle: "在沙子下面"
	quest.28C680AE6CC07D43.quest_desc: [
		"在沙漠地下生活着&6死亡蠕虫&r。它的甲壳可以制成盔甲和护手"
		"能打到非常远的地方的拳击手。"
		""
		"&7死亡蠕虫的卵会在你携带一个时孵化。被驯服的会钻地并"
		"会与你并肩作战。&r"
	]
	quest.216A67DACD8B8AB3.title: "Dragonsteel"
	quest.216A67DACD8B8AB3.quest_subtitle: "本整合包中最好的金属"
	quest.216A67DACD8B8AB3.quest_desc: [
		"将点燃的锻造炉喂以铁锭和龙血，它会返还&6龙钢&r。火，冰"
		"闪电各有自己的专属装备和专属物品。"
		""
		"&7驯服的对应元素龙，命令其攻击熔炉，可使其保持点燃状态。&r"
	]
	quest.6E4983ECC2EC5053.title: "九头蛇（The Hydra）"
	quest.6E4983ECC2EC5053.quest_subtitle: "砍掉一个，两个就会重新长出来"
	quest.6E4983ECC2EC5053.quest_desc: [
		"除非烧掉树桩，否则你砍下的每个&6九头蛇&r的头都会再生。它会活下来"
		"在入口外由死地和骨头标记的洞穴巢穴里，以及所有的一切"
		"这场战斗是关于火焰的。"
	]
	quest.0691F065A8768951.title: "被驯服且有翅膀的生物"
	quest.0691F065A8768951.quest_subtitle: "狮鹫、双足飞龙、小精灵"
	quest.0691F065A8768951.quest_desc: [
		"冰与火中的生物并非都要被杀死。 &6狮鹫&r、&6双足飞龙&r、"
		"&6海马&r、&6鸡蛇&r和&6小精灵&r都可以被驯服，而狮鹫鹰是"
		"包里最早的飞行坐骑。"
	]
	quest.6E6B7C795B58F30E.title: "Dragonsteel Plate"
	quest.6E6B7C795B58F30E.quest_subtitle: "盔甲树的终点站到了尽头"
	quest.6E6B7C795B58F30E.quest_desc: [
		"一件&6龙钢&r胸甲，以及配套的三件装备，都优于下界合金。龙甲用于"
		"你自己的龙也来自同一块锭子。"
	]
	quest.59395B19B3B0F1ED.title: "龙之骑士"
	quest.59395B19B3B0F1ED.quest_subtitle: "这一切的意义所在就在于此"
	quest.59395B19B3B0F1ED.quest_desc: [
		"背上驮着你的、身穿龙钢盔甲的成年巨龙。"
		""
		"&7坐下，然后看向你想去的地方。降落才是难点所在。&r"
	]
	chapter.5C5DD5494EECDDD2.title: "前方有龙"
	chapter.5C5DD5494EECDDD2.chapter_subtitle: ["手稿、巢穴，以及能将死去的巨龙锻造成盔甲的熔炉。"]
	quest.09FB936DC751A637.title: "一个更广阔的世界"
	quest.09FB936DC751A637.quest_subtitle: "自然指南针，以及五十个新生物群系"
	quest.09FB936DC751A637.quest_desc: [
		"&6Oh The Biomes We've Gone&r 将主世界的绝大部分生物群系列表替换为"
		"五十多个独特的生物群系：沼泽、黑森林、奇卡森林、草原，每个都有其独特的"
		"每棵树都有自己的木材类型，大多数树木也是如此。"
		""
		"一个&6自然指南针&r可以通过名称找到它们。右键点击，搜索"
		"biome，它会指向最近的生物群系，并告诉你距离有多远。"
	]
	quest.653FB3B22C88C565.title: "酒馆与庄园"
	quest.653FB3B22C88C565.quest_subtitle: "地牢与酒馆"
	quest.653FB3B22C88C565.quest_desc: [
		"&6Dungeons and Taverns&r 在各大地标之间填充了酒馆、掠夺者"
		"庄园、瞭望塔、村庄和地窖，总共五十八处。"
		""
		"&7掠夺者巢穴是早期可靠的盔甲来源。&r"
	]
	quest.1BAE507202BFC237.title: "不是你记忆中的那个村庄了"
	quest.1BAE507202BFC237.quest_subtitle: "城镇与高塔"
	quest.1BAE507202BFC237.quest_desc: [
		"&6Towns and Towers&r 重建村庄和掠夺者前哨基地，涵盖十数个区域"
		"样式，并添加了一些原版游戏从未拥有的内容。"
		""
		"&7前哨基地比原版难对付，所以带上盾牌是值得的。&r"
	]
	quest.7C0F3963C67CA977.title: "山上的城堡"
	quest.7C0F3963C67CA977.quest_subtitle: "Valhelsia Structures"
	quest.7C0F3963C67CA977.quest_desc: [
		"&6Valhelsia&r 建造城堡，一个带有主堡、刷怪室和宝库的真正城堡"
		"值得一战。同一个模组还放置了锻造炉、女巫小屋和那些巨大的树木。"
	]
	quest.3E143AA8DE5DD9AB.title: "这里曾有人居住"
	quest.3E143AA8DE5DD9AB.quest_subtitle: "Structory"
	quest.3E143AA8DE5DD9AB.quest_desc: [
		"&6Structory&r 是安静的那一个：小巧、谨慎的遗迹，没有华丽的战利品。一个"
		"废弃的教堂、瞭望塔、一座破败的庄园。里面的箱子很普通，"
		"布局才是重点所在。"
	]
	quest.2DC03B577796C9AD.title: "更好的地下城模组 (Better Dungeons)"
	quest.2DC03B577796C9AD.quest_subtitle: "YUNG's 重建了基础部分"
	quest.2DC03B577796C9AD.quest_desc: [
		"&6YUNG's Better Dungeons&r 将普通的石砖箱替换为有主题的地牢、僵尸、"
		"骷髅和蜘蛛，各自有独特的布局和战利品。"
	]
	quest.7769B7E2560CF8D6.title: "Dungeons Arise"
	quest.7769B7E2560CF8D6.quest_subtitle: "那些大的家伙们"
	quest.7769B7E2560CF8D6.quest_desc: [
		"&6When Dungeons Arise&r 会建造地标：圆形剧场、城堡、海盗船，以及"
		"三艘悬挂在空中的天界战舰。"
		""
		"&7Keep Kayra and the Coliseum are the largest of the set, with several spawner rooms"
		"每个都更容易在白天通关，而且两者都如此。&r"
	]
	quest.1898C6E20DD3A7EB.title: "房间之下的房间"
	quest.1898C6E20DD3A7EB.quest_subtitle: "Ember's Underground Rooms"
	quest.1898C6E20DD3A7EB.quest_desc: [
		"&6地下房间&r在地表下隐藏着二十个带家具的密室：一个图书馆，"
		"监狱、酒窖、王座室。它们相互连通，所以找到一个通常意味着"
		"正在寻找第四个物品。"
	]
	quest.48F2640208383A1B.title: "六个本不该存在的洞穴"
	quest.48F2640208383A1B.quest_subtitle: "Alex's Caves"
	quest.48F2640208383A1B.quest_desc: [
		"&6Alex's Caves&r 在地下挖掘了六个巨大的生物群系：磁性洞穴、原始"
		"洞穴、有毒洞穴、荒凉洼地、深渊裂谷，以及一个完全由"
		"糖果的配方。"
		""
		"&7商店里的洞穴群系地图能节省大量挖掘工作。&r"
	]
	quest.65982A3B0EA742A9.title: "在地下深处"
	quest.65982A3B0EA742A9.quest_subtitle: "烈焰棒、石英和猪灵贸易"
	quest.65982A3B0EA742A9.quest_desc: [
		"烈焰棒、石英、恶魂之泪，以及魔法章节所需的一半试剂"
		"可以要求的东西。"
		""
		"&7用金锭和猪灵交换珍珠、线和黑曜石。&r"
	]
	quest.178B9B9D5C775312.title: "走进糖果空洞 (Into the Candy Cavity)"
	quest.178B9B9D5C775312.quest_subtitle: "六个之中最奇怪的一个"
	quest.178B9B9D5C775312.quest_desc: [
		"牛轧糖墙、甘草、姜饼小镇和一个攻击力超强的女巫。大多数"
		"这里的方块可以吃，而且大多数生物都具有攻击性。"
	]
	quest.548B844E48D3D36E.title: "旅途的终点"
	quest.548B844E48D3D36E.quest_subtitle: "城市、船只和一座堡垒"
	quest.548B844E48D3D36E.quest_desc: [
		"巨龙、城市、船只。末地也是Cataclysm的&6Ender"
		"守护者&r在废弃堡垒中等待。有了鞘翅，这里的一切都会更容易。"
	]
	quest.04960AD98343CA90.title: "深邃黑暗"
	quest.04960AD98343CA90.quest_subtitle: "一座远古城市"
	quest.04960AD98343CA90.quest_desc: [
		"仍然是主世界中最安静、最危险的地方。潜行，压低你的"
		"用羊毛铺好台阶，进去前规划好路线。"
		""
		"&7它的战利品是本整合包中少数附魔的唯一来源。&r"
	]
	quest.3B1050478D02E0CE.title: "虚空中的城市"
	quest.3B1050478D02E0CE.quest_subtitle: "末地城市"
	quest.3B1050478D02E0CE.quest_desc: [
		"潜贝壳、一对鞘翅，以及在该世界任何地方生成的最棒的附魔装备"
		"这个世界。"
		""
		"&7尽可能多地收集潜贝壳，并带上用于连接塔楼的方块。&r"
	]
	quest.1880BA7D01167C3B.title: "走过的每一条路都留下了足迹"
	quest.1880BA7D01167C3B.quest_subtitle: "这片疆域，已被踏足"
	quest.1880BA7D01167C3B.quest_desc: [
		"地表、地下、下界、末地，以及它们背后的一面镜子。"
		""
		"剩下的要寻找的东西是被守护着的。这个群体的其余部分就是关于这个的。"
	]
	quest.39A14BF35291D573.title: "镜子"
	quest.39A14BF35291D573.quest_subtitle: "主世界镜像"
	quest.39A14BF35291D573.quest_desc: [
		"&6Overworld Mirror&r 会开启第二个主世界：相同的规则，未受破坏的土地，以及一个"
		"本章中所有结构的干净版本套装。"
		""
		"&7用它进行大规模采矿，这样大家共享的主世界就能保持原样。&r"
	]
	chapter.52471AA566652BD0.title: "绘制王国的地图"
	chapter.52471AA566652BD0.chapter_subtitle: ["五十个新生物群系和八个模组价值的遗迹等你探索。"]
	quest.69DA85CC92FB5070.title: "博塔尼亚百科全书机器人"
	quest.69DA85CC92FB5070.quest_subtitle: "一棵树苗和一本书"
	quest.69DA85CC92FB5070.quest_desc: [
		"一棵树苗和一本书可以合成&6Lexica Botania&r，即该模组的内置手册。新增"
		"随着你的建造，页面会逐渐解锁。"
		""
		"本页的脊骨从左至右，从花瓣延伸至泰拉钢。一切"
		"下方悬挂的分支是制造或携带法力的一种方式；上方的分支则是"
		"消耗它的齿轮装置。"
		""
		"&7潜行点击将书放入你的阿卡夏魔典中，不再需要单独携带。&r"
	]
	quest.7ED5E23B8E0CB124.title: "花瓣（Petals）"
	quest.7ED5E23B8E0CB124.quest_subtitle: "十六种颜色的花朵"
	quest.7ED5E23B8E0CB124.quest_desc: [
		"&6神秘花朵&r以各种颜色野生生长。将它们打碎可获得&6花瓣&r，"
		"后面所有内容的通用货币单位。"
		""
		"&7花袋一个格子能装十六种颜色，值得尽早制作。&r"
	]
	quest.2748D3FF4B09778A.title: "花瓣药剂师"
	quest.2748D3FF4B09778A.quest_subtitle: "鹅卵石和花瓣"
	quest.2748D3FF4B09778A.quest_desc: [
		"建造&6Petal Apothecary&r，用一桶水装满，然后投入花瓣和"
		"种子输入。所有神秘花朵之后的花朵都以此方式制成，而且完全不会枯萎。"
	]
	quest.29130AE61C03F80A.title: "爆炸与熔岩"
	quest.29130AE61C03F80A.quest_subtitle: "那些吵闹的发电机"
	quest.29130AE61C03F80A.quest_desc: [
		"点燃的TNT在&6Entropinnyum&r旁爆炸会掉落奖励；&6Thermalily&r正在喝岩浆"
		"直接从源方块获取。两者的产量都远超 endoflame，而且"
		"两者都需要为其建造一条补给线。"
	]
	quest.2D739EB98AA6412C.title: "纯净的雏菊"
	quest.2D739EB98AA6412C.quest_subtitle: "木材和石头，被赋予了生命"
	quest.2D739EB98AA6412C.quest_desc: [
		"&6Pure Daisy&r周围的日志和石头会变成&6Livingwood&r和&6Livingrock&r。它"
		"将自身层级环上的八个方块转换，所以把它们铺在那里然后走过去"
		"远离这里。"
	]
	quest.37CC2AA97A7C7BA0.title: "给它喂点晚餐"
	quest.37CC2AA97A7C7BA0.quest_subtitle: "美味浆果（Gourmaryllis）"
	quest.37CC2AA97A7C7BA0.quest_desc: [
		"烹饪食物在&6Gourmaryllis&r附近掉落会转化为法力，转化率与饱腹度成正比"
		"是的，而且多样性比重复性更有优势。这是一个很好的理由来保持"
		"Hearth and Harvest 厨房正在运行。"
	]
	quest.7010C8BAA5A9C1EB.title: "水和史莱姆"
	quest.7010C8BAA5A9C1EB.quest_subtitle: "被动的花朵们"
	quest.7010C8BAA5A9C1EB.quest_desc: [
		"&6Hydroangeas&r 会喝水；&6Narslimmus&r 会吃掉附近生成的史莱姆。两者都不会"
		"需要手动喂食，但 Hydroangeas 大约三天后会枯萎，所以要做好计划"
		"重新种植。"
	]
	quest.41B8AB99473019E6.title: "池和撒播机"
	quest.41B8AB99473019E6.quest_subtitle: "法力所在之处，亦是其流动之所"
	quest.41B8AB99473019E6.quest_desc: [
		"法力存储在由活岩构成的&6法力池&r中，并由一个装置沿直线发射"
		"活木的&6法力扩散器&r，可指向任意方向扩散法力。"
		""
		"&7Aim the Spreader at the Pool. Its range is limited and any solid block breaks the beam.&r"
	]
	quest.285C8FCB4BF48B27.title: "点燃某物"
	quest.285C8FCB4BF48B27.quest_subtitle: "The Endoflame"
	quest.285C8FCB4BF48B27.quest_desc: [
		"在 &6Endoflame&r 附近投掷煤炭或木炭可以产生法力。这种方法缓慢且廉价，"
		"几乎每个人都从一堆它们开始。漏斗和箱子为其提供物品。"
	]
	quest.5D6EDAE61726AC52.title: "Manasteel 套件"
	quest.5D6EDAE61726AC52.quest_subtitle: "能够自我修复的工具"
	quest.5D6EDAE61726AC52.quest_desc: [
		"&6Manasteel&r 工具和盔甲会利用你携带的任何法力来自我修复，因此它们"
		"几乎不会磨损。如果背包里没有法力石板，它们就是铁制的"
		"耐久度和附魔性都更出色。"
	]
	quest.3512AE7B553E3322.title: "Manasteel"
	quest.3512AE7B553E3322.quest_subtitle: "浸泡在法力中的铁块"
	quest.3512AE7B553E3322.quest_desc: [
		"将铁锭投入充能的&6法力池&r中，就会得到&6魔钢&r。"
		"钻石和珍珠也同样适用这个规则。"
	]
	quest.2A28AF533236E628.title: "口袋里的法力 (Mana in Your Pocket)"
	quest.2A28AF533236E628.quest_subtitle: "乐队与镜子"
	quest.2A28AF533236E628.quest_desc: [
		"在 Curios 栏位中携带一个 &6法力带&r。一旦你拥有一个 &6法力镜&r"
		"terrasteel，绑定到一个水池，无论你在哪里都能从中汲取。"
	]
	quest.024E33A1475E1E54.title: "珍珠与钻石"
	quest.024E33A1475E1E54.quest_subtitle: "这两种昂贵的附魔材料"
	quest.024E33A1475E1E54.quest_desc: [
		"下一个池子会生成的是&6法力珍珠&r和&6法力钻石&r，还有"
		"两者都是门而不是工具。符文祭坛需要珍珠，所以先做那个。"
	]
	quest.2A7E22788F6A99DA.title: "符文祭坛 (The Runic Altar)"
	quest.2A7E22788F6A99DA.quest_subtitle: "活岩和一颗法力珍珠"
	quest.2A7E22788F6A99DA.quest_desc: [
		"将材料投掷到&6符文祭坛&r上，加入法力，即可返还一个&6符文&r。这样"
		"有十六个，而且之后几乎所有东西都需要一个。"
		""
		"&7Runes used in the altar's own recipes are returned, not consumed.&r"
	]
	quest.4143F1258BB76BDE.title: "四大元素"
	quest.4143F1258BB76BDE.quest_subtitle: "土、水、火、空气"
	quest.4143F1258BB76BDE.quest_desc: [
		"前四个符文由普通物品制成，石头、鱼竿、下界疣"
		"和一根羽毛，它们会追踪身后的十二人。每种配方返还两个；配方"
		"持续地拉取它们。"
	]
	quest.6A592BA658BA8AB8.title: "Terra Blade"
	quest.6A592BA658BA8AB8.quest_subtitle: "花朵的终结"
	quest.6A592BA658BA8AB8.quest_desc: [
		"活木棒周围的泰拉钢。有时会远程投掷它的横扫，会喝"
		"用你的法力修复自身，同种金属制成的镐和斧头也同样好用。"
	]
	quest.5954FCCE1A59FE20.title: "盖亚守护者"
	quest.5954FCCE1A59FE20.quest_subtitle: "三根天线和一个信标"
	quest.5954FCCE1A59FE20.quest_desc: [
		"在信标周围放置三个&6Gaia Pylons&r，加入一个 terrasteel 锭，然后迎战"
		"会出现。它会掉落&6Gaia Spirit&r。"
		""
		"&7竞技场规则适用：场地大小固定，离开后会恢复生命。&r"
	]
	quest.40EDF0B27DEA9437.title: "泰拉之盘 (The Terra Plate)"
	quest.40EDF0B27DEA9437.quest_subtitle: "泰拉钢"
	quest.40EDF0B27DEA9437.quest_desc: [
		"&6Terrestrial Agglomeration Plate&r需要manasteel、一个mana pearl和一个mana diamond"
		"和巨量的法力，并返还 &6Terrasteel&r。"
		""
		"&7盘子本身需要四个元素符文和一个法力符文，所以建造一个"
		"先祭坛。一次用多个水池喂食，不然要耗一下午。&r"
	]
	quest.60B046B183350261.title: "精灵之门 (The Elven Gateway)"
	quest.60B046B183350261.quest_subtitle: "阿尔弗雷姆，某种程度上来说"
	quest.60B046B183350261.quest_desc: [
		"一个带有&6Gateway Core&r的活木框架，可通过投掷一个泰拉钢锭来开启"
		"用它来交换 &6Elementium&r、&6Dragonstone&r 和 &6Pixie Dust&r。"
		""
		"&7传送门是商店柜台，不是门。你不能穿过它。&r"
	]
	quest.4CA56727D90C5CAC.title: "火花（Sparks）"
	quest.4CA56727D90C5CAC.quest_subtitle: "无需视线即可使用法力值"
	quest.4CA56727D90C5CAC.quest_desc: [
		"将&6火花&r放在水池上，另一个放在使用法力值的方块上，法力值就会在两者间流动"
		"用没有扩散光束的来对齐。增幅器会改变火花的作用：主导型，"
		"隐性，易分散的。"
	]
	quest.1D61E38F399710B3.title: "精灵传播器 (Elven Spreaders)"
	quest.1D61E38F399710B3.quest_subtitle: "更快，更远"
	quest.1D61E38F399710B3.quest_desc: [
		"Elementium 和 dreamwood 制成的投掷器比 livingwood 的投掷得更远"
		"一，当 terra plate 运行时，这一点很重要。Gaia spreaders 的速度更快。"
	]
	quest.25060B61FE4F4322.title: "Manaweave"
	quest.25060B61FE4F4322.quest_subtitle: "来自魔力的布匹"
	quest.25060B61FE4F4322.quest_desc: [
		"&6Manaweave Cloth&r 由法力线纺成，用于制作模组中最轻的盔甲"
		"还有几件更奇特的遗物。它是一件组件，而非胸甲。"
	]
	chapter.2FEAB12570711519.title: "Botania"
	chapter.2FEAB12570711519.chapter_subtitle: ["花瓣、法力值和一架非常长的花梯。"]
	quest.6EC93DC95E6D19C4.title: "一把刀和一个理由"
	quest.6EC93DC95E6D19C4.quest_subtitle: "祭品匕首 (The Sacrificial Knife)"
	quest.6EC93DC95E6D19C4.quest_desc: [
		"血液魔法运行于&6生命精华&r，而最初的生命精华来源就是你。A"
		"在祭坛附近对自己使用&6Sacrificial Knife&r可以填满祭坛。"
		""
		"该模组分为两部分，本页将它们分开：祭坛及其球体，以及"
		"上轨，恶魔意志与下轨的熔炉。仪式由此而来"
		"祭坛轨道。"
		""
		"&7后期怪物是更好的来源。一把祭品匕首就能解决它们。&r"
	]
	quest.459EB8B1547AF4A4.title: "空白石板"
	quest.459EB8B1547AF4A4.quest_subtitle: "祭坛的首要任务"
	quest.459EB8B1547AF4A4.quest_desc: [
		"将石头放在祭坛上，它会变成一块&6空白石板&r。每个更高的等级，"
		"reinforced, imbued, demonic, ethereal, 作用方式相同，还有一组备用的"
		"石板可以省去之后返回祭坛的麻烦。"
	]
	quest.42D857D744B777E0.title: "血祭坛"
	quest.42D857D744B777E0.quest_subtitle: "石头、一个熔炉和金矿石"
	quest.42D857D744B777E0.quest_desc: [
		"&6血祭坛&r蕴含着生命精华，能将放置其上的任何物品转化。几乎"
		"本章中的一切东西都会在某一点经过这里。"
		""
		"&7周围的符文可以提升它的等级，所以现在要留出空间来放置它们。&r"
	]
	quest.63C85E779AF88F86.title: "捕捉一个灵魂"
	quest.63C85E779AF88F86.quest_subtitle: "灵魂捕网"
	quest.63C85E779AF88F86.quest_desc: [
		"向生物投掷的&6Soul Snares&r会在其死亡时使其掉落&6Demon Will&r。Will 是"
		"mod's second resource and has nothing to do with the altar."
		""
		"&7陷阱是在血祭坛上制作的：唯一一个跨越本质的配方"
		"将模组的一半放入遗嘱的一半中。&r"
	]
	quest.3AE01BF45B164368.title: "虚弱血液球 (The Weak Blood Orb)"
	quest.3AE01BF45B164368.quest_subtitle: "一颗钻石，被放弃的钻石"
	quest.3AE01BF45B164368.quest_desc: [
		"在充能祭坛上的钻石会变成&6弱血球&r：一个个人储备库"
		"生命精华，以及之后所有配方的关键。"
		""
		"&7按住右键即可绑定。未绑定的球体不属于任何人。&r"
	]
	quest.629E589A65310CC2.title: "地狱熔炉锻造术"
	quest.629E589A65310CC2.quest_subtitle: "意志消耗的地方在哪里"
	quest.629E589A65310CC2.quest_desc: [
		"恶魔将在&6地狱熔炉&r中烧灼&6塔塔里宝石&r来制造物品"
		"祭坛无法触碰。小宝石所蕴含的很少，而锻造炉最先索要的正是它。"
	]
	quest.768E5B7997090AD3.title: "地板上的符文"
	quest.768E5B7997090AD3.quest_subtitle: "二阶及以上阶段"
	quest.768E5B7997090AD3.quest_desc: [
		"&6空白符文&r围绕祭坛放置可提升其等级；特殊符文会改变其"
		"是的，容量、速度，牺牲效率。"
		""
		"&7整个结构都会检查等级。缺少一个符文就会导致一切停滞。&r"
	]
	quest.1B441653F0CFDA55.title: "更完整的宝石（A Fuller Gem）"
	quest.1B441653F0CFDA55.quest_subtitle: "较小的塔塔里安宝石"
	quest.1B441653F0CFDA55.quest_desc: [
		"每个&6酒石酸宝石&r等级都蕴含更多意志。填满一个只需杀死一只"
		"用陷阱或灵魂武器，以及背包里的宝石，就能做到很多事情"
		"会自行吸收意志能量。"
	]
	quest.16DE2D40F12CD547.title: "炼金术台 The Alchemy Table"
	quest.16DE2D40F12CD547.quest_subtitle: "祭坛无法完成的配方"
	quest.16DE2D40F12CD547.quest_desc: [
		"将一颗球体、一些石板和一把试剂放入&6炼金术台&r中，然后"
		"mod的消耗品和组件会产出。配方需要消耗生命精华，来自"
		"orb，所以保持祭坛是满的。"
	]
	quest.67C528A63E939124.title: "灵魂工具包"
	quest.67C528A63E939124.quest_subtitle: "随意志而成长的武器"
	quest.67C528A63E939124.quest_desc: [
		"灵魂工具，即&6镐&r、&6斧&r、&6铲&r和&6镰&r，意志越强就越强大"
		"在你携带的宝石中，它们通过杀戮来收集意志。"
	]
	quest.67EFB8CA35BB6051.title: "Sigils"
	quest.67EFB8CA35BB6051.quest_subtitle: "消耗的是球体，而非血液"
	quest.67EFB8CA35BB6051.quest_desc: [
		"用&6占卜符文&r读取祭坛内容，并携带五个额外的符文"
		"带有&6Sigil of Holding&r的插槽。它们消耗的是你绑定的球体，而不是你的生命值。"
		"先制作占卜符文吧，盲目操作祭坛只会是猜测。"
	]
	quest.527437A596B71518.title: "将其结晶化"
	quest.527437A596B71518.quest_subtitle: "恶魔结晶器 (The Demon Crystallizer)"
	quest.527437A596B71518.quest_desc: [
		"空气中的原始意志在&6恶魔结晶器&r中成长为晶簇，一个你"
		"可以收获：取代手动捕捉生物的农场。"
		""
		"&7恶魔意志气场计显示区块中有多少意志。&r"
	]
	quest.6F8806BE51C76924.title: "学徒与魔法师"
	quest.6F8806BE51C76924.quest_subtitle: "沿着轨道楼梯向上走"
	quest.6F8806BE51C76924.quest_desc: [
		"每个球体等级都包含更多内容，并解锁其上方的配方。 &6学徒&r 和"
		"&6Magician&r 魔球涵盖了本章所需的大部分内容；Master 和 Archmage 魔球"
		"存在于它们之上，需要四阶和五阶祭坛。"
	]
	quest.665FCD873E79A46C.title: "反应室 (The Reaction Chamber)"
	quest.665FCD873E79A46C.quest_subtitle: "ARC"
	quest.665FCD873E79A46C.quest_desc: [
		"&6炼金反应室&r将矿石、流体和意志转化为该模组的"
		"后续组件，包括 &6Blood Shards&r。输入栏中的工具决定了"
		"具体作用。配方需要一个魔法师血球，所以先爬球梯吧。"
	]
	quest.08CCAD22C3F45393.title: "大师仪式石"
	quest.08CCAD22C3F45393.quest_subtitle: "两个半部分交汇的地方"
	quest.08CCAD22C3F45393.quest_desc: [
		"一块被普通&6仪式石&r环绕的&6大师仪式石&r，呈特定图案排列。"
		"图案决定了仪式的作用，而仪式会消耗你的生命精华"
		"绑定球体以开始并保持运行。"
		""
		"&7石头需要魔法师级别的球体，所以祭坛轨道必须先建造。&r"
	]
	quest.6E1D0A9B61750B89.title: "弱激活水晶 (The Weak Activation Crystal)"
	quest.6E1D0A9B61750B89.quest_subtitle: "什么能点燃一场仪式"
	quest.6E1D0A9B61750B89.quest_desc: [
		"用&6熔岩水晶&r在祭坛上制作。用它右键主石"
		"仪式便由此开始。"
		""
		"&7血球不启动仪式。水晶会启动。&r"
	]
	quest.40DEBD6FBA51FCDE.title: "仪式占卜者"
	quest.40DEBD6FBA51FCDE.quest_subtitle: "停止手动放置石头了，用机器吧"
	quest.40DEBD6FBA51FCDE.quest_desc: [
		"背包里的石头会一次性沿着整个图案向下放置，使用&6Ritual Diviner&r，"
		"同时也告诉你你正在查看的是哪个仪式。黄昏版本处理的是"
		"仪式，那平凡者无法看见的仪式。"
	]
	quest.1FB18FBA9625308A.title: "仪式，正在运行中"
	quest.1FB18FBA9625308A.quest_subtitle: "选一个并点燃它"
	quest.1FB18FBA9625308A.quest_desc: [
		"有数十种：痛苦之井、破碎机、绿荫、磁力、再生。"
		"点燃一个并保持其充能。从结晶器中收获的&6恶魔意志水晶&r"
		"证明了模组意志的一半也在运行：恶魔结晶器"
		"在下方的轨道上种植它们。"
		""
		"&7痛苦之井建在刷怪笼上，是大多数祭坛最终被填满的方式。&r"
	]
	quest.781D7D53B07F0570.title: "地牢（The Dungeon）"
	quest.781D7D53B07F0570.quest_subtitle: "血魔法专属的维度"
	quest.781D7D53B07F0570.quest_desc: [
		"模组会在一个&6强化共振器&r后面保留一个生成的地牢，完全"
		"其后期所需组件的一部分。"
		""
		"&7魔法师水晶后面的所有东西都有效存在于下方世界。&r"
	]
	quest.6B9C45BD19CE26A4.title: "熏香（Incense）"
	quest.6B9C45BD19CE26A4.quest_subtitle: "更好的献祭物品（Better sacrifices）"
	quest.6B9C45BD19CE26A4.quest_desc: [
		"围绕&6香炉&r铺设的道路能提高自我牺牲所获得的精华量，"
		"这在较高等级中非常重要。每个路径等级都需要前一个等级，"
		"这样路径就会向外延伸建造了。"
	]
	quest.62A4328A4F74876A.title: "工匠（The Tinkerer）"
	quest.62A4328A4F74876A.quest_subtitle: "重塑一个仪式"
	quest.62A4328A4F74876A.quest_desc: [
		"使用&6Ritual Tinkerer&r来移动仪式的效果范围并改变其指向，这样"
		"仪式可以适配房间，而不是反过来。"
	]
	chapter.20B7CCA38BFD223C.title: "血液魔法 (Blood Magic)"
	chapter.20B7CCA38BFD223C.chapter_subtitle: ["以生命为动力的祭坛，以意志为动力的熔炉，以及需要两者的仪式。"]
	quest.68D0013EC5A8ECD9.title: "磨损的笔记本"
	quest.68D0013EC5A8ECD9.quest_subtitle: "请先阅读这一本"
	quest.68D0013EC5A8ECD9.quest_desc: [
		"&6Worn Notebook&r 是 Ars Nouveau 的手册，解锁后会新增条目"
		"glyphs. 在书写第一个法术时，将其放在身边可以节省大量"
		"猜测中。"
		""
		"页面在第一本书后分栏：顶部是符文和施法，底部是来源和"
		"如何在下方收集。齿轮和首领会从符文轨道上脱落。"
	]
	quest.06277CD5310A7DE1.title: "远古木"
	quest.06277CD5310A7DE1.quest_subtitle: "蓝色、绿色、红色、紫色"
	quest.06277CD5310A7DE1.quest_desc: [
		"&6Archwood&r 树木生长在魔法生物群系中，本章的每个方块都由它们制成"
		"用它们的木板和半砖即可。四种中的任意一种都可以，颜色只是装饰性的。"
	]
	quest.2F66D1C3CA48F357.title: "新手入门手册"
	quest.2F66D1C3CA48F357.quest_subtitle: "一本书和四件铁制工具"
	quest.2F66D1C3CA48F357.quest_desc: [
		"&6新手法术书&r里包含你编写的法术和施放它们的来源，并且"
		"自带一些已知的符文。它只能施放 Tier 1 的符文；法师的"
		"书籍解锁了第2等级。"
	]
	quest.4AC6218F212C572F.title: "源文件存档"
	quest.4AC6218F212C572F.quest_subtitle: "源文件被保留的位置在哪里"
	quest.4AC6218F212C572F.quest_desc: [
		"源存储在 &6源存档&r 中，会将其交给附近需要它的任何物品。"
		"本页所有内容都依赖这些，一个罐子几乎立刻就成了瓶颈。"
	]
	quest.0072C15362B7CA13.title: "源宝石"
	quest.0072C15362B7CA13.quest_subtitle: "灌注室 (The Imbuement Chamber)"
	quest.0072C15362B7CA13.quest_desc: [
		"Lapis 在 &6Imbuement Chamber&r 中，使用 source 缓慢地转化为 &6Source Gems&r"
		"从周围的空气中吸收。附近的源瓶会加速它。"
	]
	quest.766602BB999D027A.title: "文员的桌子"
	quest.766602BB999D027A.quest_subtitle: "符文被制造出来的地方"
	quest.766602BB999D027A.quest_desc: [
		"经验和试剂会在&6抄写台&r上变成&6符文&r：动词和"
		"用来构筑法术的那些形容词。"
		""
		"&7触摸、投射物和破坏指令本身就能完成大部分工作。&r"
	]
	quest.67BF042167D0C981.title: "来源链接"
	quest.67BF042167D0C981.quest_subtitle: "用别的东西制作源材料"
	quest.67BF042167D0C981.quest_desc: [
		"&6Sourcelink&r将活动转化为源。 &6Volcanic&r燃烧燃料， &6Agronomic&r"
		"观察作物生长，&6Vitalic&r汲取治愈之力，&6Alchemical&r汲取药水之力，&6Mycelial&r"
		"在生物被击杀时触发。"
		""
		"&7殖民地农场旁的农业链接能以最小的努力获得最多的资源。&r"
	]
	quest.6971D5E0C5C8C082.title: "写一个物品"
	quest.6971D5E0C5C8C082.quest_subtitle: "形式，效果，修饰符"
	quest.6971D5E0C5C8C082.quest_desc: [
		"每个法术都始于一个&6形态&r，即施放方式，然后是效果，接着是"
		"modifiers. Projectile, Break, Amplify 是一种采矿激光。"
		""
		"&7法术卷轴可以复制法术，以便交给其他人。&r"
	]
	quest.24BEA9F4CDCB2E5D.title: "中继器和电容器"
	quest.24BEA9F4CDCB2E5D.quest_subtitle: "移动源方块的位置"
	quest.24BEA9F4CDCB2E5D.quest_desc: [
		"用&6Dominion Wand&r链接一个&6Source Relay&r，它就能在罐子间传输源了"
		"没有管道。魔杖连接了本模组几乎所有东西，所以尽早制作。"
	]
	quest.3F1529B68849F053.title: "附魔装置 (The Enchanting Apparatus)"
	quest.3F1529B68849F053.quest_subtitle: "呈环形排列的基座"
	quest.3F1529B68849F053.quest_desc: [
		"一个周围均匀分布着八个&6神秘基座&r的&6附魔装置&r是"
		"大多数模组物品的制作地点。它从附近的存档文件中读取数据。"
	]
	quest.4298CD8A0C3C5B67.title: "Magebloom"
	quest.4298CD8A0C3C5B67.quest_subtitle: "制作精良装备所需的布料"
	quest.4298CD8A0C3C5B67.quest_desc: [
		"&6Magebloom&r 由装置制作的种子生长而成，其纤维用于制作"
		"mod's armour and several of its focuses. A Botany Pot farms it happily."
	]
	quest.5EA1DD1BBD8BA4B6.title: "一本法师之书"
	quest.5EA1DD1BBD8BA4B6.quest_subtitle: "将新手升级到更高级别的学徒"
	quest.5EA1DD1BBD8BA4B6.quest_desc: [
		"黑曜石、三颗钻石、两个石英块和两个烈焰棒可升级初级书籍"
		"放入&6法师的魔咒书&r中，即可解锁Tier 2的符文并储存更多源。"
		"升级会保留你已经写好的法术。"
	]
	quest.55ED822746ABC119.title: "仪式祭坛 (The Ritual Brazier)"
	quest.55ED822746ABC119.quest_subtitle: "持续生效的增益效果"
	quest.55ED822746ABC119.quest_desc: [
		"用石板点燃一个&6Ritual Brazier&r，它就能在区域内运行该效果：唤醒"
		"种一棵树，种植作物，修复一片区域，打开一个传送门。"
		""
		"&7先运行觉醒。该模组的后续配方需要它的产物。&r"
	]
	quest.750A666784781561.title: "附魔师的装备"
	quest.750A666784781561.quest_subtitle: "带有附魔效果的武器"
	quest.750A666784781561.quest_desc: [
		"该装置会制作一把&6附魔之剑&r、一把&6弓&r和一面&6盾牌&r，每种物品各一个"
		"携带着一个使用时会施放的法术。源流此时必须流动，所以下方"
		"这里的轨道很重要，尽管电线是从上面下来的。"
		""
		"&7盾牌在格挡攻击时施放法术，所以给它一个自我治愈的效果吧"
		"造成的伤害要少得多。&r"
	]
	quest.2128BAFDC7730D1E.title: "召唤一个附魔生物（Familiar）"
	quest.2128BAFDC7730D1E.quest_subtitle: "召唤的焦点"
	quest.2128BAFDC7730D1E.quest_desc: [
		"在奇物栏佩戴&6召唤焦点&r，召唤法术将产生永久效果"
		"一个会跟随你的伙伴。你一次只能拥有一个，所以根据你的战斗方式来选择吧。"
		""
		"&7焦点本身需要上方一行奇美拉献上的野人祭品。&r"
	]
	quest.447E949DA72C9E77.title: "法术炮台"
	quest.447E949DA72C9E77.quest_subtitle: "某种程度上的自动化，姑且算是"
	quest.447E949DA72C9E77.quest_desc: [
		"在红石脉冲下，&6法术炮台&r会施放其储存的法术。将其中一个指向农场，一个"
		"生物生成器或一扇门；你能写的一切，炮塔都能无限重复。"
	]
	quest.1A0F79465EA37740.title: "Drygmies 和 Wixies"
	quest.1A0F79465EA37740.quest_subtitle: "有工作的小生物们"
	quest.1A0F79465EA37740.quest_desc: [
		"Drygmies 收集生物掉落物而不杀死它们；一个 &6Wixie&r 用炼药锅制作而成；"
		"一个 &6Whirlisprig&r 农场。"
		""
		"&7在几个生物周围放一个干格米笔，就能实现无需杀戮和红石的下落农场。&r"
	]
	quest.4EC6B27F0AA4478E.title: "野性奇美拉 (The Wilden Chimera)"
	quest.4EC6B27F0AA4478E.quest_subtitle: "Ars Nouveau 的 boss"
	quest.4EC6B27F0AA4478E.quest_desc: [
		"Wilden Stalkers、Hunters 和 Guardians 会掉落用于召唤的翅膀、角和尖刺"
		"&6Wilden Chimera&r，而奇美拉会掉落&6Wilden Tribute&r。"
		""
		"&7在开阔的地方和它战斗。当它的血量变低时，行为会发生变化。&r"
	]
	quest.54B7B4A150366978.title: "Jar of Light"
	quest.54B7B4A150366978.quest_subtitle: "还有其余的一些小东西要处理"
	quest.54B7B4A150366978.quest_desc: [
		"该装置由日常物品组成一条长尾：&6光之瓶&r、虚空卷轴、"
		"药水瓶、护身符。其中几个在源流流动时会节省真实时间。"
	]
	quest.521A0F23CEDBE551.title: "大魔导师之书"
	quest.521A0F23CEDBE551.quest_subtitle: "一颗下界之星和一份贡品"
	quest.521A0F23CEDBE551.quest_desc: [
		"一颗下界之星、一个&6Wilden Tribute&r、两颗绿宝石、三颗珍珠和一个图腾可以兑换成"
		"将 Mage's Book 放入 &6Archmage Spell Book&r 中，这是三本中的最后一本。"
	]
	quest.4B38603BE11DB129.title: "一个能正常工作的塔楼"
	quest.4B38603BE11DB129.quest_subtitle: "所有东西，都在一个房间里"
	quest.4B38603BE11DB129.quest_desc: [
		"源链接喂养罐子，罐子喂养装置，一个熔炉在运行，还有一个"
		"一只熟悉的生物坐在楼梯上。"
		""
		"从这里开始，模组更像是一个工坊，而不是一系列配方。"
	]
	chapter.585C78CEF680A292.title: "Ars Nouveau"
	chapter.585C78CEF680A292.chapter_subtitle: ["符文、魔法书以及支付所需的源网络。"]
	quest.7544B127A3949536.title: "野外的一座祭坛"
	quest.7544B127A3949536.quest_subtitle: "每种来源各一个，共五个"
	quest.7544B127A3949536.quest_desc: [
		"&6Earth, Sea, Sky, Sun&r and &6Moon&r each have a small marble shrine somewhere in"
		"世界，中心有一个&6远古文字&r。找到一个，取走那里的尘埃"
		"在它下面，然后睡觉。醒来后你就知道如何制作&6Mundane Wand&r了。"
	]
	quest.1635323E0B2CEC80.title: "一把平平无奇的魔杖"
	quest.1635323E0B2CEC80.quest_subtitle: "一根木棍和一点尘土"
	quest.1635323E0B2CEC80.quest_desc: [
		"木棍和一些&6精粹粉尘&r可以制作&6凡俗魔杖&r，它能吸取法力"
		"从字体中取出并再次花费。手持魔杖右键字体；消耗十点法力"
		"是第一个目标。"
	]
	quest.647BF74858FFE027.title: "魔法书（The Grimoire）"
	quest.647BF74858FFE027.quest_subtitle: "一根魔杖，一个书架，一本书"
	quest.647BF74858FFE027.quest_desc: [
		"&6Grimoire&r 是集研究树、指南和进度追踪器于一体的模组。"
		"当你向书架挥舞&6Mundane Wand&r时，一切原始的东西都会随之而来"
		"魔法的在里面被解锁了。"
	]
	quest.24E949ECA1BEF1D2.title: "大理石"
	quest.24E949ECA1BEF1D2.quest_subtitle: "该模组用石头建造建筑"
	quest.24E949ECA1BEF1D2.quest_desc: [
		"&6Marble&r 几乎能制作所有 Primal Magick 方块，并以块状生成"
		"像矿石一样埋藏在地下。附魔和神圣的大理石则稍晚出现，并且不"
		"可以相互替换的。"
	]
	quest.7D30B00ED1E9FF0F.title: "神秘工作台 (The Arcane Workbench)"
	quest.7D30B00ED1E9FF0F.quest_subtitle: "消耗法力值的合成配方"
	quest.7D30B00ED1E9FF0F.quest_desc: [
		"&6秘法工作台&r无法通过合成获得。挥舞魔杖对准普通合成台"
		"在桌子上，你就能获得它。"
		"它会使用插槽中的魔杖消耗法力，并且几乎所有配方都来自"
		"这里有一个神秘的东西要给你。"
	]
	quest.01736BEECD660A0F.title: "更好的魔杖模组 (Better Wands)"
	quest.01736BEECD660A0F.quest_subtitle: "核心、电容和宝石"
	quest.01736BEECD660A0F.quest_desc: [
		"真正的魔杖由一个&6核心&r、两个&6帽盖&r和一个&6宝石&r组成，每个部分"
		"改变了其储存的魔力量以及消耗魔力的效率。"
		""
		"&7心木核心、铁质帽和学徒宝石能制作出不错的初级魔杖。&r"
	]
	quest.2545793303F2CD80.title: "法力充电器"
	quest.2545793303F2CD80.quest_subtitle: "没有祭坛的情况下进行补充"
	quest.2545793303F2CD80.quest_desc: [
		"通过&6Mana Charger&r充入魔杖的精华，每次都会将行走路径保存到字体中"
		"工作台会枯竭。它会消耗你所短缺的任何来源的精华。"
	]
	quest.1DDC9F1CB904BB7C.title: "一个人工字体包"
	quest.1DDC9F1CB904BB7C.quest_subtitle: "你自己的法力值储备"
	quest.1DDC9F1CB904BB7C.quest_desc: [
		"单一来源的法力会在你的基地中通过&6人工喷泉&r再生。有"
		"每个来源一个，所以现在规划一个五格房间，以后再扩建四个。"
	]
	quest.0F44CC77C072BEA7.title: "仔细观察一下"
	quest.0F44CC77C072BEA7.quest_subtitle: "放大镜和分析工具的使用指南"
	quest.0F44CC77C072BEA7.quest_desc: [
		"用&6放大镜&r分析物品，魔典就能知道它的构成。"
		"一个&6分析台&r可以批量处理。每种物品各一个就足够了，第二个"
		"石头教人毫无用处。"
	]
	quest.46CB7D5A5274CA60.title: "Spellcraft"
	quest.46CB7D5A5274CA60.quest_subtitle: "编写你自己的法术"
	quest.46CB7D5A5274CA60.quest_desc: [
		"法术是在 &6Spellcrafting Altar&r 上，用 &6Blank Spell Scroll&r 和以下材料合成的"
		"载具、有效载荷和修饰器，然后绑定到魔杖上。"
		""
		"&7成本随威力急剧上升。廉价法术的施放频率会高得多。&r"
	]
	quest.61110A685486DD96.title: "精粹"
	quest.61110A685486DD96.quest_subtitle: "尘埃、碎片、晶体、簇矿"
	quest.61110A685486DD96.quest_desc: [
		"每种来源都有四级的&6精粹&r，将同级的四种精粹组合起来会生成"
		"下一个任务中的一个。"
		""
		"&7煅烧炉能将普通方块烧成精粹，值得尽早建造。&r"
	]
	quest.514A3EDD75B04C1B.title: "血液、地狱、虚空"
	quest.514A3EDD75B04C1B.quest_subtitle: "三种被禁止的来源"
	quest.514A3EDD75B04C1B.quest_desc: [
		"五个原始源之后还有三个，通过研究《魔导书》可以解锁"
		"标记为禁止的。"
		""
		"&7整合包的召唤祭坛靠血精运行，所以这个分支很重要"
		"超出本模组的能力范围了。&r"
	]
	quest.2E74FD6EF0B10A48.title: "符文工艺（Runework）"
	quest.2E74FD6EF0B10A48.quest_subtitle: "雕刻与铭文刻写"
	quest.2E74FD6EF0B10A48.quest_desc: [
		"在&6符文雕刻台&r上切割的符文，可在&6符文铭刻祭坛&r上刻入齿轮"
		"作为模组本身的永久附魔，可与原版附魔叠加。"
	]
	quest.6B19D2B0A43E5792.title: "血色熔炉 (The Sanguine Crucible)"
	quest.6B19D2B0A43E5792.quest_subtitle: "血魔法，该模组中的版本"
	quest.6B19D2B0A43E5792.quest_desc: [
		"生命进入一个 &6Sanguine Crucible&r，血液精华便由此产生，为...提供燃料"
		"禁止砍伐一半的树。尽管名字如此，但这和血魔法章节毫无关系。"
	]
	quest.2A1CF4035E3E5BCE.title: "炼金术"
	quest.2A1CF4035E3E5BCE.quest_subtitle: "炼金术士 (The Concocter)"
	quest.2A1CF4035E3E5BCE.quest_desc: [
		"药水与&6仙品&r在&6调配器&r中酿造。仙品可让你与一个"
		"状态效果而非来源，而调谐则能解锁后半部分的"
		"研究树。"
	]
	quest.48982F0B1A6F04AF.title: "地狱熔炉 (The Infernal Furnace)"
	quest.48982F0B1A6F04AF.quest_subtitle: "冶炼，已被禁止"
	quest.48982F0B1A6F04AF.quest_desc: [
		"在&6Infernal Furnace&r里冶炼快得多，代价则是地狱般的"
		"essence。Hexium 和 Hallowsteel 是在此之后制作的。"
	]
	quest.202F2F50231DA476.title: "仪式祭坛 (The Ritual Altar)"
	quest.202F2F50231DA476.quest_subtitle: "大工程需要一个房间"
	quest.202F2F50231DA476.quest_desc: [
		"放置在&6仪式祭坛&r周围的道具、血信使、天琴、香炉，"
		"让它执行该模组中最大的配方。"
		""
		"&7道具错误或距离太远，仪式就会失败。魔导书上有布局说明。&r"
	]
	quest.18174F898ECF4918.title: "神圣的（Hallowed）"
	quest.18174F898ECF4918.quest_subtitle: "第九个源头"
	quest.18174F898ECF4918.quest_desc: [
		"&6Hallowed&r essence 位于八种之上，是模组中最难获得的物品"
		"可以任意规模生产。Hallowsteel 魔杖帽才是值得折腾的理由。"
	]
	quest.75C065F245C6F9F5.title: "一位大魔导师的法杖"
	quest.75C065F245C6F9F5.quest_subtitle: "你可以组装的最佳部分都在这里"
	quest.75C065F245C6F9F5.quest_desc: [
		"一套镶嵌了你能组装的最佳核心和电容的&6大法师宝石&r，别无他物"
		"每个部分都是一个独立的研究条目，所以这是一个长期的项目。"
	]
	quest.028D953A1A7FD12C.title: "整棵树 The Whole Tree"
	quest.028D953A1A7FD12C.quest_subtitle: "九个来源，全部都被读取了"
	quest.028D953A1A7FD12C.quest_desc: [
		"所有源都已调谐，所有学科都已开启，并且魔导书里没有灰色条目"
		"留在里面的东西。"
		""
		"&7手册清空前，必须研究以上所有条目。预计会花费大量时间。"
		"比其他任何章节都要花费更长的时间。&r"
	]
	chapter.1D21A70AB9E008B9.title: "原始魔法 (Primal Magick)"
	chapter.1D21A70AB9E008B9.chapter_subtitle: ["大地、海洋、天空、太阳和月亮——还有格里莫亚标记为禁忌的另外三种。"]
	quest.3CE4EE4B21CEC15B.title: "神秘精华 (Arcane Essence)"
	quest.3CE4EE4B21CEC15B.quest_subtitle: "该模组的唯一一种配料"
	quest.3CE4EE4B21CEC15B.quest_desc: [
		"&6秘术精华&r会从该模组的塔楼和魔法宝箱中掉落，而且几乎"
		"这里的一切都是由它建造的。深板岩层中的&6神秘残骸&r是"
		"秘银路线。"
		""
		"&7这本书和工具位于本页顶部，四页书卷垂下"
		"它们，还有塔楼和战利品都位于下方。&r"
	]
	quest.0866CE340C54E9D3.title: "一本被铁封印的典籍"
	quest.0866CE340C54E9D3.quest_subtitle: "铁链、皮革和纸张"
	quest.0866CE340C54E9D3.quest_desc: [
		"一本&6魔法书&r里装着法术和施放所需的法力。铜制的脆弱日志是"
		"最便宜的；铁、金和钻石书能装得更多。"
		""
		"&7它放在副手，用按键绑定施放，而不是右键单击。&r"
	]
	quest.5D30681BF8000FE4.title: "铭文工作台 (The Inscription Table)"
	quest.5D30681BF8000FE4.quest_subtitle: "在书里施放一个法术"
	quest.5D30681BF8000FE4.quest_desc: [
		"在&6铭文台&r上把卷轴里的法术移到书的槽位中。卷轴"
		"可从战利品、模组塔楼和墨水中获得。会消耗一张卷轴，请谨慎选择"
		"在确认前请检查物品栏中的位置。"
	]
	quest.6FC7B0C00C0087E9.title: "墨水和炼药锅"
	quest.6FC7B0C00C0087E9.quest_subtitle: "制作你自己的卷轴吧"
	quest.6FC7B0C00C0087E9.quest_desc: [
		"墨水从&6炼金术坩埚&r中产出，分为五个等级，更优质的墨水能写出"
		"将更高级别的法术施放到空白卷轴上。"
		""
		"&7同一个炼药锅可以酿造药水，效果与原版药水叠加。&r"
	]
	quest.54554D09EFE7221B.title: "神秘锻造台 (The Arcane Anvil)"
	quest.54554D09EFE7221B.quest_subtitle: "升级你现有的东西"
	quest.54554D09EFE7221B.quest_desc: [
		"在&6秘法砧&r上为装备应用&6升级球体&r和&6符文&r：更多法力，更短"
		"冷却时间，更强的学校亲和力。每种物品数量有限，请规划好套装。"
	]
	quest.67BF8F82AB765F98.title: "迷失的指南针 (The Wayward Compass)"
	quest.67BF8F82AB765F98.quest_subtitle: "找到塔楼"
	quest.67BF8F82AB765F98.quest_desc: [
		"指向一个&6迷途罗盘&r，它就会找到该模组的结构：火术士塔、唤魔者"
		"堡垒、冰蜘蛛巢、远古战场、城堡。"
		""
		"&7如果先找到，卷轴地图对特定地图也有同样的效果。&r"
	]
	quest.5BD129D2C787DDBC.title: "城堡 (The Citadel)"
	quest.5BD129D2C787DDBC.quest_subtitle: "好卷轴在哪里可以找到呢"
	quest.5BD129D2C787DDBC.quest_desc: [
		"&6堡垒&r是该模组最大的结构，也是传奇物品的可靠来源"
		"墨水、升级球和更高级的卷轴。这里戒备森严，所以带上"
		"你已经升级过的学校。"
	]
	quest.227E8B8809D08D5E.title: "一个可以存放物品的口袋"
	quest.227E8B8809D08D5E.quest_subtitle: "铁匠自己的维度"
	quest.227E8B8809D08D5E.quest_desc: [
		"施放 &6Pocket Dimension&r 咒语，这是一种末影学派咒语，你会降落在一个小小的"
		"私人空间：一个安静、远离一切事物的地方，用来存放物品和练习法术"
		"你已经建造了。"
	]
	quest.39FCDB9302C87832.title: "火魔法师长袍"
	quest.39FCDB9302C87832.quest_subtitle: "上面刻有学校的盔甲"
	quest.39FCDB9302C87832.quest_desc: [
		"每所学校都有一整套盔甲，可以降低法术消耗并提高其"
		"通过将普通巫师袍与该学派符文结合制成。混合套装通常比"
		"专注于其中一种。"
	]
	quest.33D0C00E14243365.title: "火"
	quest.33D0C00E14243365.quest_subtitle: "直接造成伤害的流派方式"
	quest.33D0C00E14243365.quest_desc: [
		"灼热之手、火球、烈焰风暴。火焰是最直接的伤害类型，而且它"
		"有自己专属的塔可供掠夺。火焰符文是围绕空白处的八根烈焰棒"
		"runestone; 火魔法师塔里就有升级球。"
	]
	quest.430AE8D133443E1A.title: "死去的国王"
	quest.430AE8D133443E1A.quest_subtitle: "爱尔德利奇，还有一个生命汲取器"
	quest.430AE8D133443E1A.quest_desc: [
		"&6Eldritch&r学派来自模组本身的boss，还有它的手稿和"
		"生命宝石是它要给予的最后物品。"
		""
		"&7爱尔德利奇魔法是模组中最强的，施放成本也最高。&r"
	]
	quest.7F0936928FAD14DF.title: "远古召唤者套装"
	quest.7F0936928FAD14DF.quest_subtitle: "盔甲树的顶端位置"
	quest.7F0936928FAD14DF.quest_desc: [
		"&6Archevoker&r 板，在神秘砧上升级，每次升级都使用你收集到的球体"
		"通往此处的道路。升级槽位有限，这意味着要决定建筑的用途"
		"在第一个球体放置之前完成。"
	]
	quest.62ABA628305294D2.title: "冰"
	quest.62ABA628305294D2.quest_subtitle: "减速它们，冻结它们，粉碎它们"
	quest.62ABA628305294D2.quest_desc: [
		"霜、冰锥，还有一个可以把首领关进去几秒钟的冰块。"
		"冰蜘蛛巢穴是低温法师装备的所在地。"
	]
	quest.6DB0B904FBB6102B.title: "法杖与刀刃"
	quest.6DB0B904FBB6102B.quest_subtitle: "专注物品"
	quest.6DB0B904FBB6102B.quest_desc: [
		"&6冰杖&r、&6北境之刃&r、&6地狱之刃&r：能施放法术的武器"
		"除了攻击物品外，还有自己的用途。主手拿着法杖，副手拿着书"
		"副手是标准的建造方式。"
	]
	quest.0025AC023FCC224E.title: "一本完整的魔法书"
	quest.0025AC023FCC224E.quest_subtitle: "每个写有文字的物品栏位"
	quest.0025AC023FCC224E.quest_desc: [
		"一本由你选择的法术填满所有栏位的&6Dragonskin&r或钻石书，放在一个"
		"一套能让他们变得便宜的盔甲。"
		""
		"&7法术槽数量由书籍等级决定，所以用实用法术填满最后几个槽位"
		"而不是第二个伤害学派。&r"
	]
	quest.24615257F9F60A8E.title: "戒指与护身符"
	quest.24615257F9F60A8E.quest_subtitle: "施法者的好奇心物品"
	quest.24615257F9F60A8E.quest_desc: [
		"&6恢复戒指&r、&6便捷戒指&r和亲和戒指，还有护身符，它们"
		"提高专注度，全部放在 Curios 栏位。冷却缩减效果最显著"
		"战斗中发挥决定性作用的差异。"
	]
	quest.2707EA92E29594C9.title: "神圣与鲜血"
	quest.2707EA92E29594C9.quest_subtitle: "两个截然相反的学校"
	quest.2707EA92E29594C9.quest_desc: [
		"&6神圣&r能治疗和护盾；&6血液&r消耗自身生命值来跳过法力消耗。"
		"它们本不该被一同使用，而 Holy 是此整合包中最接近的"
		"必须属于一个支援类职业。"
	]
	quest.2882C0493465DFDC.title: "末影与召唤生物"
	quest.2882C0493465DFDC.quest_subtitle: "传送与召唤生物事件生成器"
	quest.2882C0493465DFDC.quest_desc: [
		"&6末影&r在战场上移动你；&6附魔&r用召唤物填满战场"
		"会为你代劳战斗的伙伴。"
		""
		"&7咒术师的护身符可以增加你同时保留的召唤物数量。&r"
	]
	quest.3991AE17DCE7785B.title: "药水类物品"
	quest.3991AE17DCE7785B.quest_subtitle: "来自同一个炼药锅的配方"
	quest.3991AE17DCE7785B.quest_desc: [
		"大锅正在酿造&6闪避&r、&6橡木皮&r、&6隐身&r和恢复药水，在"
		"普通和更高等级。建议随身携带一组高级治疗药水。"
	]
	chapter.0993C72408188148.title: "铁匠的魔法 (Iron's Spells)"
	chapter.0993C72408188148.chapter_subtitle: ["十种魔法学派，一本承载它们的书，以及一把用来改进它们的铁砧。"]
	quest.4040B33EE21FC4A2.title: "灵体词典 (The Dictionary of Spirits)"
	quest.4040B33EE21FC4A2.quest_subtitle: "在绘制任何东西之前请先阅读"
	quest.4040B33EE21FC4A2.quest_desc: [
		"Occultism 的指南是唯一记载了仪式图表的地方，而且"
		"模组里的每个圆圈都在里面。它由一本书和一个恶魔之梦种子制成。"
		""
		"&7第一次召唤分出三支：被束缚的灵魂与它们上方的视野，"
		"中间是宠物和灵魂阶梯，下面是祭坛及其召唤物。&r"
	]
	quest.70D3AD919239E224.title: "粉笔（Chalk）"
	quest.70D3AD919239E224.quest_subtitle: "先白色，再金色"
	quest.70D3AD919239E224.quest_desc: [
		"圆圈是用&6粉笔&r画的。白色是便宜的；金色、紫色和红色表示"
		"更大的仪式需要更纯净的材料，而杂质粉笔是需要净化的中间步骤。"
	]
	quest.05B42EA935F60186.title: "圆圈中的碗 (Bowls in the Circle)"
	quest.05B42EA935F60186.quest_subtitle: "献祭用的，还有金色的"
	quest.05B42EA935F60186.quest_desc: [
		"仪式是一个用粉笔画的圆圈，中心有一个&6黄金祭品碗&r，还有普通的"
		"周围放置着装有原料的&6祭品碗&r。开始时用四个碗；"
		"后面的仪式需要八个方块和一个更大的圆圈。"
	]
	quest.0DC9D1BBA2D2D242.title: "一本束缚之书 (A Book of Binding)"
	quest.0DC9D1BBA2D2D242.quest_subtitle: "为你所召唤之物命名"
	quest.0DC9D1BBA2D2D242.quest_desc: [
		"命名一本&6空白束缚之书&r，命名为Foliot、Djinni、Afrit或Marid，以此决定"
		"圆环能容纳哪种灵魂。Foliot 是最弱的，一切由此开始"
		"带有。"
	]
	quest.52A7E124C052807B.title: "有工作的灵魂 (Spirits With Jobs)"
	quest.52A7E124C052807B.quest_subtitle: "召唤之书 (Books of Calling)"
	quest.52A7E124C052807B.quest_desc: [
		"指派一个绑定灵体与&6召唤之书&r配合工作：一个能砍树的伐木工，"
		"一个整理箱子的清洁工，一个搬运物品的搬运工。在你休息时，它们会一直工作"
		"在其他地方，这正是绑定它们的意义所在。"
	]
	quest.601C4CDC9011661E.title: "召唤一个福里奥特（Foliot）"
	quest.601C4CDC9011661E.quest_subtitle: "第一个灵魂"
	quest.601C4CDC9011661E.quest_desc: [
		"画出圆圈，装满碗，点燃蜡烛，然后读书。灵魂会"
		"出现的物品会进入一个 &6Magic Lamp&r 或直接进入一个任务。"
		""
		"&7A ritual takes a while and can be interrupted, which is why it is done somewhere quiet.&r"
	]
	quest.36E9C33A21468621.title: "召唤祭坛 (The Summoning Altar)"
	quest.36E9C33A21468621.quest_subtitle: "为这个整合包重写了内容"
	quest.36E9C33A21468621.quest_desc: [
		"AK3 更改了这个配方。顶部是两个 &6Candles&r 和一个 &6Wither Skeleton Skull&r，"
		"中间是&6红色羊毛&r，两侧是&6黄色羊毛&r，还有三块&6云杉木板&r"
		"沿着底部边缘放置即可。"
		""
		"&7JEI显示的是整合包版本，而非模组的默认版本。&r"
	]
	quest.3B1DB1AB92634593.title: "异界视野 (Otherworld Sight)"
	quest.3B1DB1AB92634593.quest_subtitle: "护目镜和占卜之杖"
	quest.3B1DB1AB92634593.quest_desc: [
		"&6Otherworld Goggles&r 能揭示没有它们时看不到的方块，还有"
		"&6占卜杖&r能透过石头指向矿石。"
		""
		"&7恶魔之梦果实能以更便宜的价格提供一分钟的相同视野。&r"
	]
	quest.096D9E4D8261FE56.title: "血晶 (Blood Crystals)"
	quest.096D9E4D8261FE56.quest_subtitle: "祭坛常用的催化剂"
	quest.096D9E4D8261FE56.quest_desc: [
		"本整合包中几乎所有的召唤都使用原始魔法&6血晶&r作为其"
		"催化剂，放置在祭坛上，周围环绕着材料。原始魔法的"
		"因此，被禁研究封锁了这整个分支。"
	]
	quest.30A569429F56DF0E.title: "Djinni 和 Afrit"
	quest.30A569429F56DF0E.quest_subtitle: "登上精神的阶梯"
	quest.30A569429F56DF0E.quest_desc: [
		"每个灵界等级都会产生更多效果，需要更大的圆圈和更稀有的材料。"
		"&6Djinni&r管理机器；&6Afrit&r开采深矿。紫色粉笔给djinni，红色"
		"用于 afrit。"
	]
	quest.7213E006ED48BC94.title: "Iesnium"
	quest.7213E006ED48BC94.quest_subtitle: "一种只有灵魂才能看到的金属"
	quest.7213E006ED48BC94.quest_desc: [
		"&6Iesnium&r 矿石仅在佩戴护目镜时存在于下界，并且它是"
		"mod的后期方块由此建造。护目镜和一把镐子就足以完成这次旅行。"
	]
	quest.7D1DD61054C11EFA.title: "召唤某个小东西"
	quest.7D1DD61054C11EFA.quest_subtitle: "一头猪，然后是一个德拉格（Draugr）"
	quest.7D1DD61054C11EFA.quest_desc: [
		"祭坛上放着一个血晶，周围站着三只活鸡，会返还一头猪，"
		"测试运行。一个骨块和腐肉，加上一头被献祭的猪，叫做&6Draugr&r。"
		""
		"&7此处的每个配方都需要一个活祭品站在祭坛区域内。&r"
	]
	quest.11263387FEF6B44B.title: "伙伴生物"
	quest.11263387FEF6B44B.quest_subtitle: "你的肩膀上有个小东西在晃动"
	quest.11263387FEF6B44B.quest_desc: [
		"Occultism 的附魔仪式能产生许多小型伙伴，比如蝙蝠、"
		"海狸、魔鬼、巨龙、凝视者，各有自己的诡计。大多数想要一个地精"
		"圆形；只有海狸、鹿、鹦鹉、铁匠和贪婪者会从Foliot身上掉落。"
		""
		"&7「熟悉的戒指」能让你携带一个并随时替换。戒指本身需要一个灵魂宝石。&r"
	]
	quest.7B7C40CD67D6A6CA.title: "存储执行器"
	quest.7B7C40CD67D6A6CA.quest_subtitle: "Occultism 的仓库解决方案"
	quest.7B7C40CD67D6A6CA.quest_desc: [
		"被束缚的灵魂所获取的存储容器是一个带有稳定器的&6维度矩阵&r"
		"和一个执行器。它不需要电力或线缆，而是消耗灵魂，并且"
		"矩阵本身是一种地精仪式，所以先绑定一个地精。"
	]
	quest.48740E7892E85EED.title: "召唤一个大型生物"
	quest.48740E7892E85EED.quest_subtitle: "先兆者与远古残骸"
	quest.48740E7892E85EED.quest_desc: [
		"&6三个凋零骷髅头颅&r和一头猪去取&6Harbinger&r。 &6十六个骨头"
		"用方块&r和金锭就能换到&6远古残骸&r。比直接找它们便宜多了"
		"竞技场，而且你仍然必须赢得战斗。"
	]
	quest.1F990B50E582132E.title: "驯服一只马里德（Marid）"
	quest.1F990B50E582132E.quest_subtitle: "最后一个灵魂"
	quest.1F990B50E582132E.quest_desc: [
		"&6Marid&r 是 Occultism 的顶端，一位采矿大师，也是最昂贵的圈子"
		"该模组需要 iesnium 和绿宝石块、钻石以及一个恶魂之泪。"
	]
	quest.7D5FC4D5F43F8C29.title: "尖叫怪与灵魂 (Skreecher and Soul)"
	quest.7D5FC4D5F43F8C29.quest_subtitle: "来自 Alex's Mobs 的召唤生物"
	quest.7D5FC4D5F43F8C29.quest_desc: [
		"一个带有三个潜声脉和一瓶发酵蜘蛛眼的&6潜声催化剂&r会召唤一个"
		"Alex's Mobs &6Skreecher&r。它的灵魂是这个整合包最后一个配方中的一个组件"
		"写下的，而且这是这里唯一一个不需要血晶的召唤物。"
	]
	quest.551B21729E028CCB.title: "万物皆答（Everything Answering）"
	quest.551B21729E028CCB.quest_subtitle: "每项工作对应一个圆圈"
	quest.551B21729E028CCB.quest_desc: [
		"灵魂采矿，灵魂搬运，肩上有个伙伴，祭坛在……"
		"一个应要求获取首领的角落。"
		""
		"&7灵魂宝石可以储存活体生物，让你能将其移动到任何地方。&r"
	]
	quest.42BE9028AB0597A8.title: "打开一个传送门"
	quest.42BE9028AB0597A8.quest_subtitle: "整合包自己的最后一个配方"
	quest.42BE9028AB0597A8.quest_desc: [
		"催化剂需要一个骨头头盔，六十四份血液精华粉尘，六十四份坏死之骨，"
		"一个凋零胸甲、一个血晶和一个尖叫灵魂。它会返还一个&6传送门"
		"用于 Iudex 传送门的珍珠&r。"
		""
		"&7JEI does not list this. It is written in the pack's own scripts.&r"
	]
	chapter.2C10191A26D5AF1B.title: "召唤阵 The Summoning Circle"
	chapter.2C10191A26D5AF1B.chapter_subtitle: ["粉笔、灯和附魔生物——还有祭坛，这个整合包重写了自身。"]
	quest.6340CA22FC845EFF.title: "安山岩合金"
	quest.6340CA22FC845EFF.quest_subtitle: "安山岩和一个铁粒"
	quest.6340CA22FC845EFF.quest_desc: [
		"&6安山合金&r是Create的第一个材料，几乎用于其中的所有方块"
		"有，所以按堆叠制作。后期用搅拌器配水槽会快很多。"
		""
		"&7页面顺序：先安山岩，再黄铜：磨石和压榨机在黄铜和皮带之前"
		"并在工匠出现后，将外壳和粉碎轮拆除。&r"
	]
	quest.0960883513DB669C.title: "齿轮与传动轴"
	quest.0960883513DB669C.quest_subtitle: "力量是如何移动的"
	quest.0960883513DB669C.quest_desc: [
		"旋转沿着一根&6Shaft&r直线移动，在&6Cogwheel&r处转弯，并且"
		"改变了&6大型齿轮&r与小型齿轮接触时的速度。"
		""
		"&7速度和压力是两种不同的预算，而且都会耗尽。&r"
	]
	quest.140BD92BAEBE48F4.title: "车轮或风车"
	quest.140BD92BAEBE48F4.quest_subtitle: "水车或风车"
	quest.140BD92BAEBE48F4.quest_desc: [
		"流动水中的&6水轮&r，或者有风帆的&6风车轴承&r。两者皆可"
		"建造后永久免费；此任务会检查轮子是否存在。"
	]
	quest.3F9B030C11322144.title: "一个能运行的工厂"
	quest.3F9B030C11322144.quest_subtitle: "万物，皆已相连"
	quest.3F9B030C11322144.quest_desc: [
		"驱动制造环的水轮，按序组装的机械装置，还有"
		"一列能将产物运送到有用之处的火车。"
		""
		"&7交流发电机将旋转转化为FE，电动机则将其转换回来。这就是方法"
		"创建一个AE2网络。&r"
	]
	quest.4465E88E9523C23A.title: "传送带和漏斗（Belts and Funnels）"
	quest.4465E88E9523C23A.quest_subtitle: "正在移动物品"
	quest.4465E88E9523C23A.quest_desc: [
		"物品在两根轴之间的&6机械传送带&r上运行；&6漏斗&r负责装卸物品；"
		"&6滑道&r在垂直方向上也能做到同样的效果。"
		""
		"&7皮带连接着两个水平或恰好升高一个方块的轴，以便"
		"每个运行中的方块。&r"
	]
	quest.125DFFF0D0162DE3.title: "安山岩外壳"
	quest.125DFFF0D0162DE3.quest_subtitle: "哪些机器被包裹在内部了"
	quest.125DFFF0D0162DE3.quest_desc: [
		"&6安山岩外壳&r是去皮原木和安山岩合金，是每个早期外壳的组成部分"
		"模组中的机器。外壳也能防止物品意外连接到转轴上。"
	]
	quest.1FE156BAA13020EA.title: "火车"
	quest.1FE156BAA13020EA.quest_subtitle: "一条由你亲手建造的铁路"
	quest.1FE156BAA13020EA.quest_desc: [
		"&6Track&r, a &6Station&r, a &6Train Casing&r and a schedule, and Create's trains run"
		"将它们铺设在你放置的任何地方。手持轨道物品，点击一根铁轨，再点击另一根，"
		"并且它会填充你堆叠物品之间的曲线部分。"
	]
	quest.274B1BCBF2371BF8.title: "烈焰人燃烧器"
	quest.274B1BCBF2371BF8.quest_subtitle: "为盆地提供热量"
	quest.274B1BCBF2371BF8.quest_desc: [
		"在&6空烈焰燃烧器&r中捕捉一只烈焰人。用燃料或&6烈焰蛋糕&r来喂养它"
		"用于超高温，这是一个独立的配方等级，而不是更快的配方。"
	]
	quest.174DE339EBF0ADA7.title: "磨坊石 (The Millstone)"
	quest.174DE339EBF0ADA7.quest_subtitle: "廉价地刷怪，效率低下"
	quest.174DE339EBF0ADA7.quest_desc: [
		"将物品放入下方有齿轮的&6Millstone&r中，它会将矿石研磨成："
		"尘土磨成面粉，骨头磨成粉。过程缓慢，几乎不消耗资源，而且能一直运作。"
		"第一个水车。"
	]
	quest.60F24B5741CD6F7A.title: "机械装置（Contraptions）"
	quest.60F24B5741CD6F7A.quest_subtitle: "会一起移动的方块"
	quest.60F24B5741CD6F7A.quest_desc: [
		"&6活塞&r、&6轴承&r、&6龙门架&r和&6滑轮&r可以拾起一个结构并将其移动。"
		"加入钻头和锯子，它就能边采矿边移动。强力胶和底盘决定了什么"
		"哪些会随时间流逝，哪些会永远留存。"
	]
	quest.667C874F4D178EEF.title: "流体"
	quest.667C874F4D178EEF.quest_subtitle: "管道、泵和储罐"
	quest.667C874F4D178EEF.quest_desc: [
		"&6流体管道&r由&6机械泵&r驱动，填充&6流体储罐&r，并由&6出水口&r倾倒"
		"将内容物倒入传送带上的物品。没有泵管的管道完全不起作用。"
	]
	quest.3D1B2CAA040E4D20.title: "压力和盆地 (Press and Basin)"
	quest.3D1B2CAA040E4D20.quest_subtitle: "板子和混合操作"
	quest.3D1B2CAA040E4D20.quest_desc: [
		"板件来自一个位于depot上方的&6Mechanical Press&r；位于&6Mechanical下方的&6Basin&r"
		"搅拌机&r可以混合冷热各种东西。"
		""
		"&7盆子下方的烈焰人熔炉会解锁一半的配方列表。&r"
	]
	quest.7BFC800BBC981BB4.title: "序列组装"
	quest.7BFC800BBC981BB4.quest_subtitle: "带有步骤的配方"
	quest.7BFC800BBC981BB4.quest_desc: [
		"没有人会制作&6精密机械&r。它由一排部署器在车站上建造而成"
		"并按下，一步一步地来。"
		""
		"&7每一步都有失败几率，这就是建造这条线的理由"
		"而不是手动操作。&r"
	]
	quest.7D8E1C1B333F290C.title: "蓝图设计图"
	quest.7D8E1C1B333F290C.quest_subtitle: "建造两次"
	quest.7D8E1C1B333F290C.quest_desc: [
		"用&6Schematic and Quill&r记录一个建筑，再用&6Schematicannon&r将其发射回去"
		"在别处，从一个材料箱里，一边燃烧着火药一边过去。"
		""
		"&7它将逐块复制殖民地建筑方块。&r"
	]
	quest.4DEEE0DABE9CDC52.title: "锌和黄铜"
	quest.4DEEE0DABE9CDC52.quest_subtitle: "第二个等级"
	quest.4DEEE0DABE9CDC52.quest_desc: [
		"&6Zinc&r ore plus copper, mixed over a heater, makes &6Brass&r, and brass is the gate"
		"Create 模组所做的一切巧妙事情上。"
		""
		"&7用烈焰蛋糕喂养的烈焰人熔炉就是你想要的加热器。&r"
	]
	quest.2F0520EC28534C76.title: "电子管组件"
	quest.2F0520EC28534C76.quest_subtitle: "黄铜，以有用的形式存在"
	quest.2F0520EC28534C76.quest_desc: [
		"抛光玫瑰石英和铁板可以制作一个&6电子管&r，然后就能建造智能机器了"
		"from it. 玫瑰石英是用红石粉制作的石英，然后用砂纸打磨而成。"
	]
	quest.2301A6E5B2C75279.title: "机械工匠 (Mechanical Crafters)"
	quest.2301A6E5B2C75279.quest_subtitle: "自动化合成，Create 的方式"
	quest.2301A6E5B2C75279.quest_desc: [
		"相互指向的 &6Mechanical Crafters&r 环会组合配方并吐出物品"
		"出结果。粉碎轮就是这样制作的，几乎所有昂贵的东西都是如此。"
	]
	quest.4FAE5882885980B6.title: "蒸汽与锅炉"
	quest.4FAE5882885980B6.quest_subtitle: "比水车还要多的压力，真是累人"
	quest.4FAE5882885980B6.quest_desc: [
		"将&6蒸汽机&r放在锅炉上，产生的压力是水力的数倍"
		"车轮，随锅炉拥有的坦克数量而缩放。锅炉需要水和热量，两者都需要"
		"其中一些在流体流动后会变得更容易完成。"
	]
	quest.4D980E2D8FA24F6B.title: "压碎车轮"
	quest.4D980E2D8FA24F6B.quest_subtitle: "矿石数量翻倍"
	quest.4D980E2D8FA24F6B.quest_desc: [
		"两个相互转动的&6Crushing Wheels&r将矿石破碎成碎矿石，而这些"
		"熔炼后的产物比投入的还要多。"
		""
		"&7它们必须朝向彼此，所以在激活前检查旋转方向。&r"
	]
	quest.0AFF29B9B036B17A.title: "风扇"
	quest.0AFF29B9B036B17A.quest_subtitle: "一个方块，四个工艺步骤"
	quest.0AFF29B9B036B17A.quest_desc: [
		"吹一个&6Encased Fan&r穿过火焰，它会熔化；穿过水流，它会洗净；穿过"
		"岩浆冒烟，灵魂之火萦绕不散。"
		""
		"&7清洗砾石可获得燧石和铁粒；清洗灵魂沙可获得石英和金粒。&r"
	]
	quest.7F8EEDF5899104B4.title: "部署器和锯子"
	quest.7F8EEDF5899104B4.quest_subtitle: "对腰带进行各种操作"
	quest.7F8EEDF5899104B4.quest_desc: [
		"任何从&6Deployer&r下通过的东西都会获得一个作用于其上的物品；&6Mechanical Saw&r会切割"
		"logs and fells trees. 拿着锄头的部署器是农场；拿着剑的，是生物农场。"
	]
	chapter.5867D20584768412.title: "创建"
	chapter.5867D20584768412.chapter_subtitle: ["齿轮、传动轴和应力——用可移动部件制造机器的模组。"]
	quest.0AB3E3BC613028C7.title: "找到陨石 (Find the Meteorite)"
	quest.0AB3E3BC613028C7.quest_subtitle: "天空石，和四个压力板"
	quest.0AB3E3BC613028C7.quest_desc: [
		"AE2 会在世界各地埋下 &6陨石&r，每个陨石里都有一个装有 &6Inscriber 的箱子"
		"按下&r。缺少任意一个按键，模组会在刻印器处卡住，所以请保持"
		"直到你拥有它们为止，请继续寻找。"
		""
		"在充电器中充能的&6陨石罗盘&r会指向最近的陨石。"
		""
		"&7网络本身沿着本页顶部运行，并连接到后面的"
		"capstone。电缆和电源线在左侧，自动合成在右侧。&r"
	]
	quest.2A3948347CCC752B.title: "无线传输"
	quest.2A3948347CCC752B.quest_subtitle: "口袋里的终端机"
	quest.2A3948347CCC752B.quest_desc: [
		"将网络随身携带，使用一个 &6无线接入点&r 和一个 &6无线"
		"终端&r，在范围内。范围升级可叠加，无线充电器可保持"
		"终端已充满能量。"
	]
	quest.052CD5DDC1E1C463.title: "Certus Quartz"
	quest.052CD5DDC1E1C463.quest_subtitle: "模组本身的晶体"
	quest.052CD5DDC1E1C463.quest_desc: [
		"&6Certus Quartz&r 生成于主世界，生长在以下发现的萌芽方块上"
		"陨石。一个萌芽方块和一个已激活的&6生长加速器&r就能建成农场。"
	]
	quest.682DCD7735B6C0E5.title: "导入和导出"
	quest.682DCD7735B6C0E5.quest_subtitle: "物品的存取与进出操作"
	quest.682DCD7735B6C0E5.quest_desc: [
		"物品通过 &6Import Bus&r 进入，通过 &6Export Bus&r 送出，以及一个"
		"&6Storage Bus&r将箱子视为网络存储设备。"
		""
		"&7A Storage Bus on each Warehouse rack puts the colony's stock on your ME terminal.&r"
	]
	quest.4C40B9BEAABE67CA.title: "充电器"
	quest.4C40B9BEAABE67CA.quest_subtitle: "带电的切尔图斯矿石"
	quest.4C40B9BEAABE67CA.quest_desc: [
		"Certus quartz 在 &6Charger&r 中会变成 &6Charged Certus Quartz&r，用于为...充电"
		"趁你在那里的时候拿一块陨石罗盘。它需要能量，一个振动的燃烧室"
		"煤炭就足以开始了。"
	]
	quest.46298113943CFD6C.title: "给它注入能量"
	quest.46298113943CFD6C.quest_subtitle: "能量接收器和电池单元"
	quest.46298113943CFD6C.quest_desc: [
		"能量通过 &6能量接收器&r 从任何地方输入，并转换为 AE。一个"
		"&6能量电池&r储存缓冲，使网络在停电时仍能运行。"
		""
		"&7创造与附加是最容易到达此处的生成器。&r"
	]
	quest.6010109B26CC22E7.title: "Fluix"
	quest.6010109B26CC22E7.quest_subtitle: "水中的三样东西"
	quest.6010109B26CC22E7.quest_desc: [
		"将&6Charged Certus&r、&6redstone&r和&6nether quartz&r投入水中，它们就会变成"
		"&6Fluix Crystals&r。所有线缆和大多数机器都需要它们。"
		""
		"&7它发生在水中，而不是合成台里。&r"
	]
	quest.4846ABA56376E011.title: "石英玻璃"
	quest.4846ABA56376E011.quest_subtitle: "还有它制作的电缆"
	quest.4846ABA56376E011.quest_desc: [
		"&6Quartz Glass&r 是玻璃和 certus 尘埃，而 &6Fluix Cable&r 用于传输通道"
		"方块。玻璃线缆可传输八个频道；高密度线缆可传输三十二个。"
	]
	quest.7D4D66F82F038408.title: "一面墙，墙内的一切"
	quest.7D4D66F82F038408.quest_subtitle: "一个可以正常工作的网络"
	quest.7D4D66F82F038408.quest_desc: [
		"控制器、驱动、电池、终端和足够的电力来维持其运行。每个箱子里的"
		"基地现在占一个屏幕了。"
		""
		"&7网络分析仪能告诉你频道走向。&r"
	]
	quest.1246B8957DE7B678.title: "铭文刻写者"
	quest.1246B8957DE7B678.quest_subtitle: "处理器被刻印的地方在哪里"
	quest.1246B8957DE7B678.quest_desc: [
		"在每个&6Inscriber&r的末端插槽里放一个压印机，中间放材料，它就会进行压印"
		"电路。三个串联是标准配置；一个串联会很慢。"
	]
	quest.438CDADFED96DDDD.title: "驱动器和终端机"
	quest.438CDADFED96DDDD.quest_subtitle: "十个单元格，一个屏幕"
	quest.438CDADFED96DDDD.quest_desc: [
		"一个&6ME Drive&r可容纳十个单元，而&6ME Terminal&r是你实际使用的窗口。"
		"合成终端就是一个附带了合成网格的机器。"
	]
	quest.3A0D9A0497DDADD2.title: "硅和处理器"
	quest.3A0D9A0497DDADD2.quest_subtitle: "逻辑、计算、工程学"
	quest.3A0D9A0497DDADD2.quest_desc: [
		"&6硅&r由certus dust冶炼而成。与电路和红石一起压制即可"
		"成为三种不同类型的&6处理器&r，堆栈需要所有类型，这使得"
		"这是模组里第一个值得自动化的东西。"
	]
	quest.6EAED796348C07F6.title: "空间存储模组 (Spatial Storage)"
	quest.6EAED796348C07F6.quest_subtitle: "移动一个房间"
	quest.6EAED796348C07F6.quest_desc: [
		"将区域周围的&6Spatial Pylons&r和空间单元选中，然后将其拾起并放置"
		"把它放到别的地方去。"
		""
		"&7由于卡顿，本整合包禁用双方块组件。更大的组件则可以使用。&r"
	]
	quest.082DACCC2712B830.title: "存储单元"
	quest.082DACCC2712B830.quest_subtitle: "住房和组件"
	quest.082DACCC2712B830.quest_desc: [
		"存储单元是 &6单元外壳&r 中的一个 &6存储组件&r，容量从 1k 到 256k 不等"
		"每种物品都多拿了一些，但没有增加种类。"
		""
		"&7类型数量比容量更重要。1k 单元格可容纳 63 种类型。&r"
	]
	quest.3962185DE09008E6.title: "ME控制器"
	quest.3962185DE09008E6.quest_subtitle: "网络的心脏"
	quest.3962185DE09008E6.quest_desc: [
		"&6ME控制器&r是让网络成为网络的关键。其他所有东西都通过它连接"
		"回到原来的地方去。"
		""
		"&7A controller block may touch neighbours on at most two axes. Build them as a"
		"线或半砖，绝不能是三维的角。&r"
	]
	quest.464BAD7146F97E65.title: "形成与湮灭 Formation and Annihilation"
	quest.464BAD7146F97E65.quest_subtitle: "飞机"
	quest.464BAD7146F97E65.quest_desc: [
		"任何接触&6湮灭平面&r的东西都会破碎成网络；一个&6形成平面&r"
		"将方块放回原位。在采石场岩壁上放置的平面是一个井然有序的采矿设置。"
	]
	quest.69E8F96E726734A7.title: "分子组装器"
	quest.69E8F96E726734A7.quest_subtitle: "应要求提供合成配方"
	quest.69E8F96E726734A7.quest_desc: [
		"每个&6分子合成器&r中都有一个配方。在旁边放置足够的"
		"模式提供器和网络按需构建配方。空白模式是"
		"在模式编码终端上编写。"
	]
	quest.250BDB9771B0881E.title: "子网络"
	quest.250BDB9771B0881E.quest_subtitle: "当一个网络还不够用的时候"
	quest.250BDB9771B0881E.quest_desc: [
		"电力会通过&6石英纤维&r，但管道不会，所以需要一个小专用网络"
		"可以挂在大型结构上。子网能让大型建筑保持在频道预算内。"
	]
	quest.311FB8CE34942769.title: "模式提供者"
	quest.311FB8CE34942769.quest_subtitle: "订单将送往何处"
	quest.311FB8CE34942769.quest_desc: [
		"编码模式存在于&6模式提供者&r中，它将材料交给任何"
		"旁边有一个装配器或者一台真正的机器。"
		""
		"&7将第一点指向一个创造搅拌机，网络就会为你运行创造模式。&r"
	]
	quest.2E16895718A1EE42.title: "合成中央处理器"
	quest.2E16895718A1EE42.quest_subtitle: "规划合成配方的那个方块"
	quest.2E16895718A1EE42.quest_desc: [
		"带有存储器和协处理器的&6合成单元&r组成一个&6合成CPU&r，即该方块"
		"规划多步骤合成并执行。更多存储意味着更大的任务；"
		"协处理器意味着更快的处理器。"
	]
	quest.66FCDB75C52A916C.title: "请求一把钻石镐子"
	quest.66FCDB75C52A916C.quest_subtitle: "自动合成，正在工作"
	quest.66FCDB75C52A916C.quest_desc: [
		"在终端中输入，网络就会收集、合成并交付。一切就绪"
		"本页内容为此铺垫，而一个&6合成联合处理器&r是个不错的测试："
		"网络必须规划好几个步骤才能制造一个。"
		""
		"&7如果合成卡住，先检查是否缺少配方或合成器。&r"
	]
	chapter.798D35E38124A0F6.title: "Applied Energistics"
	chapter.798D35E38124A0F6.chapter_subtitle: ["一块陨石，四个压模，和一个能嵌入墙体的仓库。"]
	quest.5F989F91872F2E86.title: "材料与工艺 (Materials and You)"
	quest.5F989F91872F2E86.quest_subtitle: "最先出现的这本书"
	quest.5F989F91872F2E86.quest_desc: [
		"&6Materials and You&r 是 Tinkers' 系列的第一本，涵盖了所有内容直到"
		"你的第一件真正工具。你出生时会有一份副本；一本书和一个配方可以制作另一个。"
		""
		"&7页面分三栏：顶部是工作台，中间是熔炉"
		"在它下面，还有熔炉和底部的各种大工具。&r"
	]
	quest.57E4C68E968B4D1A.title: "图案"
	quest.57E4C68E968B4D1A.quest_subtitle: "一切从这里开始"
	quest.57E4C68E968B4D1A.quest_desc: [
		"木板和木棍组成一个&6图案&r，每个Tinkers' station方块消耗一个。制作"
		"一小撮就够了。"
	]
	quest.0920F27AB1313E31.title: "填缝剂"
	quest.0920F27AB1313E31.quest_subtitle: "粘土、沙子和砾石"
	quest.0920F27AB1313E31.quest_desc: [
		"&6Grout&r 熔炼成 &6Seared Bricks&r，而整个熔炼炉就是用来制作 Seared Bricks 的"
		"制作所需。一个熔炉需要成百个，所以按堆来制作。"
	]
	quest.4400008707620E93.title: "焦灼砖块"
	quest.4400008707620E93.quest_subtitle: "熔化的砂浆混合物"
	quest.4400008707620E93.quest_desc: [
		"在熔炉中烧制 Grout 可得到 &6Seared Brick&r，四个 Seared Brick 可合成该方块。"
		"熔炉的墙壁、地板和所有配件都由它制成。"
		""
		"&7焦灼熔炉是便宜的单方块版本，也是入门首选。&r"
	]
	quest.6263FD3734CB70DC.title: "熔炉和水龙头"
	quest.6263FD3734CB70DC.quest_subtitle: "金属，要去某个地方吗"
	quest.6263FD3734CB70DC.quest_desc: [
		"一次一种物品在加热器上的&6Seared Melter&r中融化，并由&6Faucet&r倾倒"
		"到 &6铸造台&r 或 &6盆&r 中。锭和零件用铸造台，方块用盆。"
	]
	quest.1D5B43A2E52A4265.title: "零件建造者"
	quest.1D5B43A2E52A4265.quest_subtitle: "雕刻工具部件雕刻中"
	quest.1D5B43A2E52A4265.quest_desc: [
		"在&6部件制造台&r中，使用模板将材料雕刻成工具部件。木材和"
		"石头开局，熔炉运行后就能获得更好的金属，书里列出了所有"
		"材料的属性。"
	]
	quest.7A2B029990C0AD2C.title: "施放次数"
	quest.7A2B029990C0AD2C.quest_subtitle: "黄金，一次性消耗品"
	quest.7A2B029990C0AD2C.quest_desc: [
		"将熔化的黄金倒在铸造台的一个部分上，它就会变成一个可重复使用的&6黄金"
		"铸模&r。 &6沙铸模&r是廉价的一次性版本。"
		""
		"&7铸造你最常用的部件：锭、镐头、手柄。&r"
	]
	quest.57E16EF62EC28F5B.title: "Tinker Station 工作台"
	quest.57E16EF62EC28F5B.quest_subtitle: "组装一件工具"
	quest.57E16EF62EC28F5B.quest_desc: [
		"部件在&6Tinker Station&r里组装成工具，当你需要时又可以拆解"
		"想改变点什么。工具会随着使用而升级，升级会赋予"
		"修饰符槽位。"
	]
	quest.2A7C961DF065A3C5.title: "熔炼炉 (The Smeltery)"
	quest.2A7C961DF065A3C5.quest_subtitle: "真正的多方块结构体本身"
	quest.2A7C961DF065A3C5.quest_desc: [
		"建造一个由焦砖构成的空心箱，墙上有一个&6熔炉控制器&r，并带有一个排水口"
		"还有一个熔炉。它能同时熔化多种东西，还能将矿石翻倍。"
		""
		"&7高度即容量，所以值得建得比第一个任务要求的高。&r"
	]
	quest.7E8E314951DBD592.title: "一把你制作的镐子"
	quest.7E8E314951DBD592.quest_subtitle: "头部，手柄，绑定装置"
	quest.7E8E314951DBD592.quest_desc: [
		"三种部件，三种材料，以及一件完全由你选择的工具，而不是"
		"这个配方允许了多么神奇的事情。"
		""
		"&7A broken tool is repaired at the station with its head material, never lost.&r"
	]
	quest.5D137E0DEEF53D42.title: "合金"
	quest.5D137E0DEEF53D42.quest_subtitle: "两种金属，一种更胜一筹"
	quest.5D137E0DEEF53D42.quest_desc: [
		"熔炉将熔化的金属混合：铜和紫水晶混合成紫水晶青铜，铁和"
		"史莱姆炼成史莱姆钢，以此类推。合金需要两种金属同时熔炼，"
		"所以看好坦克。"
	]
	quest.1A26E4A241FE08E2.title: "修饰符"
	quest.1A26E4A241FE08E2.quest_subtitle: "工具变得有趣的地方就在这里"
	quest.1A26E4A241FE08E2.quest_desc: [
		"红石用于速度，石英用于伤害，青金石用于运气，一颗钻石用于提升"
		"耐久度上限。使用&6Tinker's Anvil&r可以应用更坚固的耐久度。"
		""
		"&7修饰符槽位有限，所以工具在消耗前值得先升级。&r"
	]
	quest.7939761740A73820.title: "史莱姆与骨头"
	quest.7939761740A73820.quest_subtitle: "Tinkers' 专属材料"
	quest.7939761740A73820.quest_desc: [
		"&6Necrotic Bone&r 用于生命窃取，史莱姆用于额外耐久度，还有岛屿中的"
		"史莱姆出现的天空。"
		""
		"&7被断骨工具击杀的凋零骷髅会掉落坏死骨骼。&r"
	]
	quest.519F8B58C997E88A.title: "焦灼砖块"
	quest.519F8B58C997E88A.quest_subtitle: "下界熔炼炉"
	quest.519F8B58C997E88A.quest_desc: [
		"&6焦砖&r可以建造&6熔炉&r，即熔炼炉的下界版本"
		"燃料更优，适配套装也不同。它由下界砂浆熔炼而成：岩浆、"
		"用灵魂沙和灵魂土代替黏土。"
	]
	quest.283250E2824F0905.title: "铸造厂"
	quest.283250E2824F0905.quest_subtitle: "更大，并且是副产品而不是合金"
	quest.283250E2824F0905.quest_desc: [
		"在焦黑熔炉中的熔化过程相同：一个&6Foundry Controller&r能容纳更多的金属和"
		"将副产品从矿石中提取出来。无法合金，所以熔炉会保留。"
	]
	quest.05965DD04BCDDB1C.title: "一个合成台"
	quest.05965DD04BCDDB1C.quest_subtitle: "一个工作台搞定所有事情"
	quest.05965DD04BCDDB1C.quest_desc: [
		"将&6工作台&r放置在其他Tinkers'方块旁，即可获得选项卡"
		"顶部共享物品栏，并记住你上次使用的配方。"
	]
	quest.7620649DE1BF4CCD.title: "Tinkers' Integrations 整合包"
	quest.7620649DE1BF4CCD.quest_subtitle: "已添加模组材质，已添加"
	quest.7620649DE1BF4CCD.quest_desc: [
		"&6TCIntegrations&r 将本整合包的其他金属添加到熔炉中：银、魔力钢、"
		"dragonsteel 和其他材料。一块冰和火之银融化了"
		"向下是大多数人铸造工具头所用的第一种模组金属。"
	]
	quest.3B137E50B0B8B567.title: "适用于一切的工具"
	quest.3B137E50B0B8B567.quest_subtitle: "双手剑、手斧、锤子"
	quest.3B137E50B0B8B567.quest_desc: [
		"镐子后面放着大工具，&6手斧&r、&6大锤&r、还有"
		"&6挖掘机&r，所有部件都由更大的零件以相同方式组装而成。"
		""
		"&7锤子挖掘范围是三乘三，耐久度消耗速度是三倍。&r"
	]
	quest.7704AB8F421E2D6C.title: "一个分等级的工具"
	quest.7704AB8F421E2D6C.quest_subtitle: "修饰符槽位，全部已使用"
	quest.7704AB8F421E2D6C.quest_desc: [
		"由熔炉锻造的最佳材料制成的&6大锤&r，最大的工具"
		"该模组已通过使用提升等级，并在铁砧上进行了修改。"
		""
		"&7Tinkers' 工具会逐个部件重建，这样一把工具就能用到整合包结束。&r"
	]
	quest.4CA3972E6990B87B.title: "铁匠大厅"
	quest.4CA3972E6990B87B.quest_subtitle: "车站、熔炉和铸造厂"
	quest.4CA3972E6990B87B.quest_desc: [
		"一个工作台，旁边摆满了各种匠人砧，后面还有一个高高的熔炉，"
		"其余的则在末地建造一个铸造厂。"
	]
	chapter.59DBA3FC299C11F5.title: "Tinkers' Construct"
	chapter.59DBA3FC299C11F5.chapter_subtitle: ["填缝剂、烧制砖块，以及你设计而非制作的工具。"]
	quest.6EB96B048ECBF4A9.title: "不仅仅是一个箱子 Not Just a Chest"
	quest.6EB96B048ECBF4A9.quest_subtitle: "Sophisticated Storage"
	quest.6EB96B048ECBF4A9.quest_desc: [
		"&6Sophisticated Storage&r 将箱子、桶替换为占用更多空间的版本"
		"升级：分类、冶炼、磁铁、过滤器、泵。"
		""
		"三个面板：留在基地的方块，跟随你的背包，"
		"还有那些用来移动物品的管道和零零碎碎的东西。里面几乎没什么东西"
		"还需要其他东西吗？前两者共享一份升级列表。"
		""
		"&7The Storage Controller is banned on this pack for lag, so no recipe here uses it.&r"
	]
	quest.5918E4D9A99F9F04.title: "管道匠模组"
	quest.5918E4D9A99F9F04.quest_subtitle: "一根管道，四种内容物"
	quest.5918E4D9A99F9F04.quest_desc: [
		"&6Pipez&r可移动物品、流体、能量和气体，用扳手可配置每个面"
		"并进行升级以使其更快。通用管道可同时传输所有四种。"
	]
	quest.08DBDBCA063937E2.title: "更好的桶模组 (A Better Barrel)"
	quest.08DBDBCA063937E2.quest_subtitle: "木头，然后是金属"
	quest.08DBDBCA063937E2.quest_desc: [
		"一个&6储物箱&r或&6木桶&r初始有二十七格物品栏和一个升级槽"
		"并从那里爬出来。有限桶能装的种类更少，但每种的数量都多得多。"
	]
	quest.258D3F65E54D7321.title: "万物各归其所，井然有序"
	quest.258D3F65E54D7321.quest_subtitle: "一个会自我存档的基地"
	quest.258D3F65E54D7321.quest_desc: [
		"靠墙放置的过滤桶和一个能自动补充物品的背包。"
		""
		"Applied Energistics 用不同的方式实现了相同的功能。两者都正确。"
	]
	quest.02482ADCEC71E11D.title: "管道升级 (Pipe Upgrades)"
	quest.02482ADCEC71E11D.quest_subtitle: "从基础到终极"
	quest.02482ADCEC71E11D.quest_desc: [
		"每个升级层级都会提高管道每次操作移动的距离和过滤器的数量"
		"方块拥有的面数。"
		""
		"&7在目的地而非源头进行过滤。这样更容易理解。&r"
	]
	quest.4AE8D53C4333C1E1.title: "等级提升"
	quest.4AE8D53C4333C1E1.quest_subtitle: "铜、铁、金、钻石、下界合金"
	quest.4AE8D53C4333C1E1.quest_desc: [
		"将&6Tier Upgrade&r应用于存储方块，即可增加物品栏和升级槽位，无需"
		"先卸载。升级可跳过等级，因此存在从基础到钻石的升级，可节省材料。"
	]
	quest.163725A0293DB910.title: "原地熔炼 (Smelt In Place)"
	quest.163725A0293DB910.quest_subtitle: "熔炉升级"
	quest.163725A0293DB910.quest_desc: [
		"&6自动熔炼&r、&6烟熏&r和&6爆破&r升级可将木桶变为熔炉"
		"会保留自己的输出。燃料放在同一个方块里。"
	]
	quest.3FB2EDE14F6BC8D1.title: "无线充电器"
	quest.3FB2EDE14F6BC8D1.quest_subtitle: "没有连接到终端的电缆"
	quest.3FB2EDE14F6BC8D1.quest_desc: [
		"Powered items stay topped up near a &6Wireless Charger&r: a block one for machines, a"
		"无论携带何种物品，玩家一都能使用。它与AE2无线终端配对，该终端"
		"否则就会毫无悬念地失败。"
	]
	quest.0510940BEAB6FE2A.title: "堆叠的堆叠 (Stacks of Stacks)"
	quest.0510940BEAB6FE2A.quest_subtitle: "堆叠升级物品"
	quest.0510940BEAB6FE2A.quest_desc: [
		"每个槽位可容纳更多物品，已安装&6堆叠升级&r：五个等级和一个omega等级以上"
		"那些。装上一个后，单个桶就能装下整个采矿之旅的鹅卵石。"
	]
	quest.597D3290E9060161.title: "紧凑与虚空"
	quest.597D3290E9060161.quest_subtitle: "两项房屋管理方面的升级内容"
	quest.597D3290E9060161.quest_desc: [
		"&6Compacting&r 能将九件物品自动压缩成方块。 &6Void&r 会将其丢弃"
		"超过你设定的阈值，这样鹅卵石桶就永远不会溢出来。"
	]
	quest.54676119260DC1BA.title: "黑暗实用工具模组"
	quest.54676119260DC1BA.quest_subtitle: "板、护身符和过滤器"
	quest.54676119260DC1BA.quest_desc: [
		"&6Dark Utilities&r 是一个小机关合集：能造成伤害或减速的压力板，"
		"能驱赶失眠和不良效果的护身符，还有农场用的生物过滤器。"
		""
		"&7过滤器决定了怪物农场能杀死某一种生物，而不会杀死其他生物。&r"
	]
	quest.189190B4302E3EA3.title: "自己动手整理一下吧"
	quest.189190B4302E3EA3.quest_subtitle: "过滤器和漏斗的升级组件"
	quest.189190B4302E3EA3.quest_desc: [
		"&6Hopper Upgrade&r 会从一侧的方块中吸取物品，并推入另一侧的方块中"
		"其他，而一个 &6过滤升级&r 决定了它能接受什么。一排过滤后的桶是"
		"一个完全没有红石电路的整理系统。"
	]
	quest.0953065E0C7BB1F3.title: "分享石（Sharestones）"
	quest.0953065E0C7BB1F3.quest_subtitle: "传送石，共享"
	quest.0953065E0C7BB1F3.quest_desc: [
		"任何人都可以使用 &6Sharestone&r，颜色编码确保服务器的网络保持可读性。"
		"绑定卷轴会跳转到固定的一个石头；传送卷轴会跳转到其中的任意一个。"
	]
	quest.612E3FBC0C6B2C18.title: "Upgrading the Backpack"
	quest.612E3FBC0C6B2C18.quest_subtitle: "同样的升级，就在你的背上"
	quest.612E3FBC0C6B2C18.quest_desc: [
		"一个&6背包&r采用相同的升级系列，并与你一同旅行。"
		""
		"&7拾取升级是大多数人会先安装的插槽：掉落物会直接收入背包中。&r"
	]
	quest.5B20AB197FB097C4.title: "喂食与补给"
	quest.5B20AB197FB097C4.quest_subtitle: "两个升级，一个槽位，值得了"
	quest.5B20AB197FB097C4.quest_desc: [
		"&6Feeding&r 饥饿度下降时会为你进食；&6Refill&r 保持你的快捷栏物品充足"
		"背包。喂食加上一组熟食就完全结束了食物管理。"
	]
	quest.5590C330EBD31241.title: "补充库存与存入物品"
	quest.5590C330EBD31241.quest_subtitle: "建造与卸载中"
	quest.5590C330EBD31241.quest_desc: [
		"&6Restock&r 会在放置时从背包中补充你手中的物品，所以很长"
		"墙壁永远不需要重新加载快捷栏。 &6存入&r会将背包里的物品倒入你选择的"
		"所站立的位置。"
	]
	quest.45246BBB9A4CDBDB.title: "磁铁"
	quest.45246BBB9A4CDBDB.quest_subtitle: "将掉落物拉向你"
	quest.45246BBB9A4CDBDB.quest_desc: [
		"&6磁石升级&r能将掉落物从数格外吸向你，配合拾取"
		"升级后的物品会直接放入背包中，无需额外操作。"
		""
		"&7过滤拾取物，否则背包会装满原石。&r"
	]
	quest.26F42366AD10352B.title: "工具和铁砧"
	quest.26F42366AD10352B.quest_subtitle: "那些怪人（The odd ones）"
	quest.26F42366AD10352B.quest_desc: [
		"背包内的物品会由&6Anvil Upgrade&r和&6Tool Swapper&r进行修复"
		"选择适合你正在挖掘的方块的工具。两者都消除了你早已忽略的一项任务。"
	]
	quest.7A159EFFDB01B138.title: "过滤器，正确使用方式"
	quest.7A159EFFDB01B138.quest_subtitle: "物品过滤器"
	quest.7A159EFFDB01B138.quest_desc: [
		"&6物品过滤器&r添加了可按标签、模组、耐久度或名称过滤物品的功能"
		"正则表达式，它们可以替换本页面上的所有过滤器升级。"
		""
		"&7桶中的一个 #forge:ores 过滤器可替代二十个单独条目。&r"
	]
	chapter.0A8A9C4CBCD305E8.title: "存储与物流系统"
	chapter.0A8A9C4CBCD305E8.chapter_subtitle: ["可升级的桶、自动分类的背包，以及它们之间的管道。"]
	reward_table.76A1E25EFB9192BC.title: "殖民地补给品"
	reward_table.736418A1B3A2659D.title: "殖民地工头之镐"
	reward_table.5AE9C2E4BC5FCDBC.title: "Boss Spoils"
	reward_table.017137EC15117A54.title: "丰收篮筐"
	reward_table.3E78741C87DEE070.title: "建筑师木箱"
	reward_table.078591CADBB65507.title: "来自市场的商品"
	reward_table.2E6988B06CB9ED56.title: "从架子上挑选物品"
	reward_table.0B67E1B9CF24ACAB.title: "探险家背包"
	reward_table.77B06603F24C0CB7.title: "龙之宝藏"
	reward_table.2D869CD636311118.title: "神秘试剂 (Arcane Reagents)"
	reward_table.01F7ECB8EB37C398.title: "植物学家的采集工具"
	reward_table.7E63A16E7E2EBDE0.title: "咒术师的镐头"
	reward_table.4483DE7E553C8113.title: "机器零件"
	reward_table.17993CCA0769AEA6.title: "史密斯的镐头"
	reward_table.4328D14793381B86.title: "网络备件"
}
