	quest.778E38574711C83D.quest_desc: [
		"盗贼拥有强大的近战攻击，并掌握多种技巧"
		"- 优势：强大的近战攻击，多样的战斗技巧（眩晕、潜行）"
		"- 弱点：防御力一般，难以对付远程敌人"
		""
		"使用凉亭的咒语绑定台（或你建造的），将普通书籍变为盗贼手册。"
		""
		"在后续的旅程中，你将解锁它能提供的各种能力。"
	]
	quest.778E38574711C83D.quest_subtitle: "将普通书籍变成盗贼手册！"
	quest.778E38574711C83D.title: "流浪者"
	quest.77F63D420EB631F2.quest_desc: [
		"强化回响碎片是强大的终局物品，可用于升级物品等级。本章任务将是你重铸物品的引擎。重铸会根据物品的稀有度赋予随机的属性加成。"
		""
		"要将物品升级，请在主手持有该物品的同时，领取本章任务的奖励。"
	]
