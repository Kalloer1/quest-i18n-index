	quest.60335100FA2C052C.title: "冰冻圣杯"
	quest.617370A12E03BF83.quest_desc: [
		"锻造炉在破坏时会丢失其自定义数据标签。"
		"把你的锻造台放在这里，就能得到一个带有正确数据的新锻造台！"
	]
	quest.617370A12E03BF83.quest_subtitle: "重铸你的物品！"
