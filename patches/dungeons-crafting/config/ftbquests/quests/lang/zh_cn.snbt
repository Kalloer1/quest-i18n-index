	quest.5F0291DAFD87DD5F.quest_desc: [
		"将物品放入动力锻造炉的左上角，然后跳到箱子上方，即可将物品转化为能量。"
		""
		"研磨物品获得的能量等于物品等级乘以20。为物品添加等级需要消耗100点能量。"
		""
		"动力装备只能在地下城结构的战利品箱中找到，但动力锻造炉提供了另一种获取你所需特定装备的方法。"
	]
	quest.5F0291DAFD87DD5F.quest_subtitle: "使用动力锻造炉来开始从物品中提取能量！"
	quest.5F0291DAFD87DD5F.title: "剥离能量等级！"
	quest.5FC362844DA2E65D.quest_subtitle: "使用你的魔杖来施放法术！"
