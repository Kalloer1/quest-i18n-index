		{
			can_repeat: true
			dependencies: ["2ED702F227E0C38A"]
			description: ["Pewter City 的馆主 Brock 使用岩石系的 Cobblemon。他还是收集各种石头和矿石的大粉丝。传言说，当地博物馆的大部分展品都是 Brock 从 Mt. Moon 带来的。"]
			hide_until_deps_visible: true
			icon: "pkgbadges:the_boulder_badge"
			id: "04D10D1F7BE69495"
			optional: true
			rewards: [{
				command: "/trainers makebattle @p Brock"
				icon: "pkgbadges:the_boulder_badge"
				id: "7B756E056E2C8EE3"
				silent: true
				title: "你向布洛克发起了挑战"
				type: "command"
			}]
			subtitle: "信念比石头更坚固！"
			tasks: [
				{
					id: "059CF28AB74CF8E4"
