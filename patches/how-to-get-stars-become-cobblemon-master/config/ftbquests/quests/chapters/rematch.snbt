			x: -2.5d
			y: -3.0d
		}
		{
			can_repeat: true
			dependencies: ["2ED702F227E0C38A"]
			description: ["蔚蓝市道馆馆主小霞是一位强大的对手。她使用强大的水系可布勒蒙，每一只都是她亲手捕捉的。作为众多钓鱼比赛的冠军，她热爱各种海洋宝藏。"]
			hide_until_deps_visible: true
			icon: "pkgbadges:the_cascade_badge"
			id: "3C956AFC5968A86E"
