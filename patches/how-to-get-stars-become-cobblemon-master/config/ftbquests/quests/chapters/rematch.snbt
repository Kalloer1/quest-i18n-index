		{
			can_repeat: true
			dependencies: ["2ED702F227E0C38A"]
			description: ["朱红市的道馆馆主，冲浪手，曾是一名顶级的指挥官和士兵。勇敢、自律、对敌人毫不留情，他的电系可可梦完全体现了这些品质。"]
			hide_until_deps_visible: true
