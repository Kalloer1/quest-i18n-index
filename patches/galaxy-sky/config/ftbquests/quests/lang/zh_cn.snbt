	quest.6419007D77DDA647.quest_desc: ["Allthemodium 的压缩块形态，用于更高级的结构和传送器配方。"]
	quest.65D3B10DD1ED8384.quest_desc: ["Charged Porter 的进阶版，能存储多个目的地，且能量容量更大。"]
