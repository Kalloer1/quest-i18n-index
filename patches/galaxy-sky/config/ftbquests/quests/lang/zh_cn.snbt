	quest.4A7AADAC9D98FDC9.title: "Lightium 工具"
	quest.4DBA0A03A065F06B.quest_desc: ["O terceiro e mais raro minério premium do AllTheModium, encontrado nas profundezas da dimensão do Fim (End) ou do End Mining Dimension. Emite uma aura mística azulada."]
	quest.4DE43F9C9AD644B9.quest_desc: ["RFTools 所有机器的基本基础模块。"]
	quest.4E485C18BBDDD6D1.quest_desc: ["Uma liga metálica que combina Vibranium e Allthemodium, produzida em reatores ou forjas de alta pressão. Usada nas receitas das mesas do Avaritia."]
	quest.513BE3C4C5CB901D.quest_desc: [
