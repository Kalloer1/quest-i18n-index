	quest.582B7E7385B01122.quest_desc: ["O Teleport Pad é o portal de entrada para a dimensão de mineração do AllTheModium (Mining Dimension). Use-o no Overworld clicando com o botão direito enquanto segura um item apropriado para ser teletransportado!"]
	quest.582B7E7385B01122.title: "采矿维度传送门"
