		""
		"当&6装备&r了&b模块扩展卡&r后，你可以通过&3GUI&r来精确地&6调整&r阈值。"
	]
	quest.6E2932D7D8228910.title: "&7压力&c表"
	quest.6F5731A4490A537F.quest_desc: [
