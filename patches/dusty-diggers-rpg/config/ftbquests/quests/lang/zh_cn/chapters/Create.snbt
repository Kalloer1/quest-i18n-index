	quest.5773319EE8B3D45C.quest_desc: ["为&b链传动&r添加了部分&6速度控制&r。"]
	quest.578394EC869C10AB.quest_desc: ["简单的点对点物品运输、电力传输，或是给玩家的低调滑雪缆车——由你决定！"]
	quest.590D73FDE6335297.quest_desc: ["&6测量&r你的装置&d以压力单位形式的&r&6产生&r和&6消耗&r的能量，或其工作速度。"]
	quest.594BC97607EEE341.quest_desc: ["大多数创造模式装置的关键部件：&6交换器&r，可在两个平面之间交换旋转运动的轴线"]
	quest.5D5FC5420738FDE8.quest_desc: ["平平无奇的&b纸板。&r如此普通，却……是通往&o创造&r最新能力集的入口，即本画廊&c\"工厂智能\"&r展区所展示的内容。"]
	quest.5D852AA1930E1019.quest_desc: ["被捕获的烈焰人&6喜欢&r&b鸡蛋&r，就像它们久远的祖先，卡尔西弗一样"]
	quest.607FFC2B7A0F972A.quest_desc: [""]
