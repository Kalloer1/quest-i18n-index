	quest.272E31F15A39517B.title: "聚变反应堆框架"
	quest.27B6C6079B5FE918.quest_desc: ["The &bRotary Condensentrator&r allows you to either &6condense&r a &egas&r into it's &7liquid&r form and vis-versa by pressing the button in the top left of the GUI."]
	quest.27B6C6079B5FE918.title: "旋转冷凝器"
	quest.2821236A1E8FEF73.quest_desc: [
		"&b聚变反应堆端口&r是一条通往&b聚变反应堆&r中心的加固通道。"
		""
		"如果没有任何东西&6连接&r，它的强度与框架相同，但一旦有东西&6连接&r，就能提供一个进出核心的&a单向&r安全通道。"
	]
	quest.2821236A1E8FEF73.title: "聚变反应堆端口"
	quest.2A68AB7D1EDD44BD.quest_desc: [
		"&bStructural Glass&r is a block that can be used in almost any &emulti-block&r as a clear block."
		" "
		"我建议你尝试用它来建造 &b动态储罐&r 的墙壁，而边缘则使用实体的动态储罐方块。"
	]
	quest.2A68AB7D1EDD44BD.title: "结构性玻璃"
	quest.2AABAC42E7880AA1.quest_desc: [
		"&b精英增压管&r将为管道网络的总容量和基础吞吐量增加&9每根管道256,000mb/t&r。"
		""
		"每个“&apull&r”管道都限制为 &964,000mb/t&r。"
	]
	quest.2AABAC42E7880AA1.title: "精英增压管"
	quest.2ADDD30536A7FF68.quest_desc: ["&b反应堆玻璃&r是一种&3超强增强透明材料&r，可用于&b聚变反应堆&r的中心墙壁。每个人都喜欢&6看到&r漂亮的颜色（这些颜色可能会&4把你&r抹杀掉）。</c8>"]
	quest.2B3B96DDFE5D3ACA.quest_desc: ["使用&bBoiler Casings&r可以制作&bTheroelectric Boiler&r，从而&6生成&r额外的&7steam&r，来源包括&cexternal heat&r，以及来自活跃&bFission reactor&r的&9Superheated Liquid Sodium&r。"]
	quest.2B3B96DDFE5D3ACA.title: "锅炉外壳"
	quest.2BDE797C32E308D3.quest_desc: [
		"The &bUltimate Pressurized Tube&r will add &91,024,000mb/t per tube&r to the tube network's total capacity and base throughput. "
		""
		"每个“&apull&r”管道都限制为&9256,000mb/t&r。"
	]
	quest.2BDE797C32E308D3.title: "终极增压管"
	quest.2D4564F6C18AE96B.quest_desc: ["&b高级物流运输机&r可将&a每秒32个物品&r送入运输网络，并以&a每秒2.0米&r的速度进行传输。"]
	quest.2D4564F6C18AE96B.title: "高级物流运输机"
	quest.2E50F969D8AE49B2.quest_desc: ["添加到矩阵的每个&b精英感应单元&r会增加&e204.8 GFE&r的储能。"]
	quest.2E50F969D8AE49B2.title: "精英感应单元"
	quest.2E97456B0ED0AB1A.quest_desc: [
		"&b电动泵&r是用于从世界中大量收集&7液体&r的&e首选&r方法。"
		""
		"将其放置在要抽吸的&7液体&r上方一格，为其提供&e能量&r，并在其上方放置&9管道&r或&9储罐&r即可开始&6抽吸&r液体。"
		""
		"&b升级&r可以极大地提高其抽吸速率。"
		""
