	quest.36D6DCA2535410E0.title: "超大容量 QIO 驱动器"
	quest.37001338052E8335.quest_desc: ["&b终极粉碎工厂&r可同时处理多达&a9&r个粉碎流程，并包含相同的“&e自动分类&r”功能。"]
	quest.37001338052E8335.title: "终极粉碎工厂"
	quest.378E30F8E12695A2.quest_desc: ["&bCharge Pad&r 是一种可以&6放置&r的板子，能为站在上面的任何东西&6充电&r，包括站在上面的玩家的物品栏中任何&e使用能量/电池的&r物品。"]
	quest.378E30F8E12695A2.title: "Chargepad"
	quest.3850B26FC78DD874.quest_desc: [
		"&b基础冶炼厂&r可同时处理多达&a3&r个冶炼过程。"
		""
