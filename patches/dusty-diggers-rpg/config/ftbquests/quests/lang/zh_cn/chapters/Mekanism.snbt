	quest.33AC5F9CFB679483.title: "MekaSuit 头盔"
	quest.33F07E292A9B14B1.quest_desc: ["&b传送核心&r不仅是资源和人，更是整个&6传送&r系统的核心。"]
	quest.33F07E292A9B14B1.title: "传送核心 (Teleportation Core)"
	quest.34B822EC25F66B54.quest_desc: ["&bOsmium Compressor&r 用于将 &3osmium&r &6压缩&r 成特定粉尘，以 &6创造&r 它们的锭。"]
	quest.34B822EC25F66B54.title: "锇压缩机"
	quest.3689AAE9D0DB96FB.quest_desc: ["&bThermal Evaporation Valve&r 用于向塔中&6输入&r和从塔中&6提取&r&7流体&r。输入和输出至少需要&9两个&r。你也可以&6使用&r阀门，从&bThermodynamic Conductors&r中&c输入&r热量。"]
	quest.3689AAE9D0DB96FB.title: "热蒸发阀门"
	quest.36D6DCA2535410E0.quest_desc: [
		"你能想象到的最大的驱动力。"
