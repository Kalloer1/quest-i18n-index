		{
			description: [
				"在 FTB Skies 专家模式中，有许多事件会在你的游戏过程中发生。"
				"这个任务将允许你单独切换它们。"
				""
				"查看下一页以查看所有切换选项"
				"{@pagebreak}"
				""
				"[\"\",\"紫水晶                        \",{\"text\":\"[ 切换 ]\",\"bold\":true,\"color\":\"gold\",\"clickEvent\":{\"action\":\"run_command\",\"value\":\"/events toggle ftbskies:amethyst\"},\"hoverEvent\":{\"action\":\"show_text\",\"contents\":[\"切换紫水晶事件。钻石块可通过此事件转化为紫水晶簇。\"]}}]"
				""
				"[\"\",\"Lootbee                         \",{\"text\":\"[ 切换 ]\",\"bold\":true,\"color\":\"gold\",\"clickEvent\":{\"action\":\"run_command\",\"value\":\"/events toggle ftbskies:bees\"},\"hoverEvent\":{\"action\":\"show_text\",\"contents\":[\"切换 Lootbee 事件。Lootbee 会掉落各种物品！\"]}}]"
				""
				"[\"\",\"Chest                            \",{\"text\":\"[ 切换 ]\",\"bold\":true,\"color\":\"gold\",\"clickEvent\":{\"action\":\"run_command\",\"value\":\"/events toggle ftbskies:chest\"},\"hoverEvent\":{\"action\":\"show_text\",\"contents\":[\"切换拟态事件。它们会从你的一个箱子里生成。拟态生物死亡时会掉落神器\"]}}]"
				""
				"[\"\",\"乌鸦                             \",{\"text\":\"[ 切换 ]\",\"bold\":true,\"color\":\"gold\",\"clickEvent\":{\"action\":\"run_command\",\"value\":\"/events toggle ftbskies:crow\"},\"hoverEvent\":{\"action\":\"show_text\",\"contents\":[\"切换乌鸦事件。有一定几率在附近的草地上生成乌鸦。\"]}}]"
				""
				"[\"\",\"末影幼虫                       \",{\"text\":\"[ 切换 ]\",\"bold\":true,\"color\":\"gold\",\"clickEvent\":{\"action\":\"run_command\",\"value\":\"/events toggle ftbskies:endermite\"},\"hoverEvent\":{\"action\":\"show_text\",\"contents\":[\"切换末影幼虫事件。正在生长的紫水晶有时会生成被附身的末影幼虫。\"]}}]"
				""
				"[\"\",\"青蛙和鱿鱼             \",{\"text\":\"[ 切换 ]\",\"bold\":true,\"color\":\"gold\",\"clickEvent\":{\"action\":\"run_command\",\"value\":\"/events toggle ftbskies:frogs\"},\"hoverEvent\":{\"action\":\"show_text\",\"contents\":[\"切换青蛙事件。有一定几率在水体附近生成青蛙。\"]}}]"
				""
				"[\"\",\"木棍                             \",{\"text\":\"[ 切换 ]\",\"bold\":true,\"color\":\"gold\",\"clickEvent\":{\"action\":\"run_command\",\"value\":\"/events toggle ftbskies:stick\"},\"hoverEvent\":{\"action\":\"show_text\",\"contents\":[\"切换木棍事件。谁不需要木棍呢……对吧？\"]}}]"
				""
				"[\"\",\"茶                              \",{\"text\":\"[ 切换 ]\",\"bold\":true,\"color\":\"gold\",\"clickEvent\":{\"action\":\"run_command\",\"value\":\"/events toggle ftbskies:tea\"},\"hoverEvent\":{\"action\":\"show_text\",\"contents\":[\"切换茶事件。基本就是告诉你服务器正在泡一杯茶。\"]}}]"
				""
				"[\"\",\"村民                         \",{\"text\":\"[ 切换 ]\",\"bold\":true,\"color\":\"gold\",\"clickEvent\":{\"action\":\"run_command\",\"value\":\"/events toggle ftbskies:villager\"},\"hoverEvent\":{\"action\":\"show_text\",\"contents\":[\"切换村民事件。如果没有村民，此事件有几率生成一个村民。\"]}}]"
				""
				"[\"\",\"流浪商人            \",{\"text\":\"[ 切换 ]\",\"bold\":true,\"color\":\"gold\",\"clickEvent\":{\"action\":\"run_command\",\"value\":\"/events toggle ftbskies:wandering_trader\"},\"hoverEvent\":{\"action\":\"show_text\",\"contents\":[\"切换流浪商人。有几率生成一个带有各种交易的自定义流浪商人！\"]}}]"
				""
				"[\"\",\"史莱姆                             \",{\"text\":\"[ 切换 ]\",\"bold\":true,\"color\":\"gold\",\"clickEvent\":{\"action\":\"run_command\",\"value\":\"/events toggle ftbskies:slime\"},\"hoverEvent\":{\"action\":\"show_text\",\"contents\":[\"切换史莱姆事件。会在你的岛屿上生成一个随机大小的史莱姆。\"]}}]"
				""
				"[\"\",\"山羊                             \",{\"text\":\"[ 切换 ]\",\"bold\":true,\"color\":\"gold\",\"clickEvent\":{\"action\":\"run_command\",\"value\":\"/events toggle ftbskies:goat\"},\"hoverEvent\":{\"action\":\"show_text\",\"contents\":[\"切换山羊事件。会在你附近生成一只随机的量子山羊！\"]}}]"
				""
