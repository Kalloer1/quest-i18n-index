	quest.5B32EC7A6CCC143C.quest_desc: [
		"找到你的附魔书制作台（确保它被书架环绕）。"
		""
		"{image:dungeon_heroes:textures/gui/spell_binding.png width:100 height:67 align:center}"
		""
		"将你之前制作的附魔书放入制作台中。"
		""
		"消耗青金石和经验等级以解锁您的第一个法术。"
		""
		"{image:dungeon_heroes:textures/tutorial/frost_bind.png width:100 height:48 align:center}"
		""
		"战利品法术卷轴提供了一种更便宜的替代方案来解锁相同的法术。"
		""
		"{image:dungeon_heroes:textures/tutorial/frost_scroll.png width:100 height:48 align:center}"
		""
		"（注意：法术卷轴只能添加到相匹配的法术书中）"
	]
