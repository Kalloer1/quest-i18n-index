	file.0000000000000001.title: "创建Energistics系统"
	quest.00611844AFD5C31E.quest_desc: [
		"Inscriber 和 Charger 原生支持 RF/FE，但大多数 ME 网络都使用名为 AE 的专用电力系统。"
		""
		"RF/FE 可以通过 ME 控制器直接转换，也可以通过 &b能量接收器&f 转换，后者可以连接到网络的任意部分，转换比例为 2:1 RF:AE。"
	]
	quest.00611844AFD5C31E.quest_subtitle: "能量转换"
	quest.0081604AF08D98A2.quest_desc: [
		"&6大型水车&r的工作原理与普通水车相同，但也有几点不同：它的转速比&e普通水车&r慢，但在因过载而停止前能产生更高的应力容量。此外，无论一侧或多侧被遮挡，它产生的应力单位数量都不会改变。"
		""
		"也可以通过右键点击任意木板类型来更改外观以匹配该木板"
	]
	quest.0081604AF08D98A2.quest_subtitle: "更大但更慢"
	quest.00D06DB43DB3EECB.quest_subtitle: "将此连接到你的能源，即可将能量传送到任何地方"
	quest.00D06DB43DB3EECB.title: "无线连接 (Wireless Connections)"
	quest.0125799CA778E1F4.quest_desc: ["&6齿轮箱&r用于改变旋转方向"]
	quest.0125799CA778E1F4.quest_subtitle: "你可以将每种齿轮箱合成成另一种齿轮箱"
	quest.01F3F0C25BA72BDA.quest_desc: [
		"除了存储物品和流体外，AE2 还提供了一种原生的方法，可将整个 &e结构&f 存储在存储单元中，这与 Compact Machines 模组非常相似。"
		""
		"&bSpatial IO Port&f 允许将位于 &bSpatial Containment Structure&f 内的结构捕获到特制存储单元中，并通过红石信号激活。"
		""
		"如果在占领期间，生物或玩家站在SCS内部，他们也会被传送到该空间的专属维度。如果被占领的是你，请确保有办法进出。"
	]
	quest.01F3F0C25BA72BDA.title: "Spatial IO"
	quest.0228747D6C21928F.quest_subtitle: "制作一把锄头"
	quest.0228747D6C21928F.title: "正在辛勤耕作中"
	quest.029007D8E8446038.quest_desc: ["&6轨道&r是火车需要组装和行驶的基础设施。它们是火车系统正常运行的必要组成部分"]
	quest.029007D8E8446038.quest_subtitle: "火车旅行的关键所在"
	quest.02EA7BD1BE0587EA.title: "基础能量存储升级 I"
	quest.02FDDF872A9667BA.quest_desc: ["&6滑道&r的作用类似于漏斗和投掷器组合，可以堆叠使用，物品会持续向下流动并在末端掉落，但如果&6封闭式风扇&r向上吹气，它也能将物品向上推入&6滑道&r"]
	quest.02FDDF872A9667BA.quest_subtitle: "一种移动物品的办法"
	quest.02FE61BB85143811.quest_desc: [
		"&6加权弹出器&r能让你将物品通过空中传送。"
		"要选择&6弹出器&r的发射位置，请右键单击目标方块，然后放置在&6弹出器&r的发射点。"
		""
		"你可以编辑&6弹出器&r的重量，为此，在&6弹出器&r上找到x，然后按住右键并看向它，接着移动出现的滚动轮，调整你希望在&6弹出器&r上的物品数量"
	]
	quest.02FE61BB85143811.quest_subtitle: "将物品抛掷到空中"
	quest.035D8D1D349F7BC3.title: "进入一个&6远古城市&r"
	quest.037488EF1F3581CE.quest_desc: [
		"默认情况下，没有ME控制器时，ME网络本身的内部缓冲区只有800AE，而每个控制器会增加8kAE。对于足够大的网络，这可能不够用，并可能导致网络在尝试为任何已连接设备回收能量时间歇性断电。"
		""
		"&b能量单元&f能让ME网络储存更多能量，普通能量单元可增加200kAE，&b致密&f能量单元可增加1.6MAE。它们也可放置在网络中任何位置，提供额外的能量缓冲。"
	]
	quest.037488EF1F3581CE.quest_subtitle: "能量存储装置"
	quest.03C063D04037EEA7.quest_desc: ["Create 有一个内置功能叫 &6Ponder&r，你可以按住 W 键，当进度条充满后，就会显示该物品在游戏中的使用方式"]
	quest.03C063D04037EEA7.quest_subtitle: "点击对勾开始学习"
	quest.03E500405A6CA1FB.quest_desc: ["&6半抽屉&r可以容纳相应全尺寸抽屉的一半物品"]
	quest.03E500405A6CA1FB.quest_subtitle: "它里面装着的东西是什么"
	quest.03E6FA4DCB71162E.quest_desc: [
		"&bColor Applicator&f 是一种可充能的工具，用于在游戏内为线缆染色。它大致像一个特殊的 &estorage cell&f，可以装入原版染料或特定颜色的 &epaint balls&f，也可以用 &esnowballs&f 洗去颜色，将线缆恢复为 Fluix 形态。"
		""
		"为电缆上色会消耗内部电池100AE的能量，单次充电总共可覆盖3400个电缆段。"
	]
	quest.03E6FA4DCB71162E.title: "颜色涂抹器"
	quest.03E84F6F607B0C2A.quest_desc: ["开启作弊模式后此功能可用。若未开启，请在领取此任务前暂时开启"]
	quest.03E86E01D0D37F26.quest_subtitle: "用于在&fmekasuit&r和&fmeka-tool&r上安装升级"
	quest.04204B276392D733.quest_subtitle: "动力移动"
	quest.0420DD4A8BB3868F.quest_desc: ["&6机械臂&r可以设置用来将物品从一个地方移动到另一个地方，比如从一个仓库到另一个仓库"]
	quest.0420DD4A8BB3868F.quest_subtitle: "伸出援手"
	quest.043768F941B8A41D.quest_subtitle: "QIO 仪表盘与 QIO 驱动阵列配合使用，用于显示和访问已导入 QIO 系统的物品"
	quest.049BDED68524411F.quest_desc: [
