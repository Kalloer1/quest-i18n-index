	quest.73DFB51FF0D9411C.title: "开发者日志更新记录"
	quest.74FC0DDDB91DB172.quest_desc: [
		"为了方便起见，AE2 提供了一系列用于操作 ME 数据的设备，即在全球范围内移动已存储的物品。"
		""
		"&bME 接口&f就是这类设备之一。作为一种输入设备，接口允许任何物品/流体等通过外部管道输入，然后自动存储在接口所连接的 ME 网络中。"
		""
		"作为输出设备，接口可被配置为从ME网络向自身内部物品栏中保持一定量的可用物品。这样，其他玩家或管道等外部来源就可以接收这些物品了。"
	]
	quest.74FC0DDDB91DB172.title: "输入输出装置"
	quest.751918B18C6F4ECC.quest_subtitle: "将锇金属转化为不同的锭"
	quest.754497AD42B7D3D4.quest_subtitle: "为创造模式提供电力和燃料！"
	quest.75486180B2031285.quest_subtitle: "允许数字矿工将开采的矿石替换为石头"
	quest.75619B23BB13A8D7.quest_desc: ["&6部署器&r是自动化的开端，因为它被用于许多不同的多步骤工艺中，例如&6精密机制&r等"]
	quest.75619B23BB13A8D7.quest_subtitle: "自动化开始"
	quest.7569BB5427BCA43F.quest_desc: [
		"将&b船帆&r连接到&9风车轴承&r上方的木板或其他方块上会产生更大的应力"
		""
		"你可以把它们摆成任何你喜欢的形状"
	]
	quest.7569BB5427BCA43F.quest_subtitle: "更多风帆 = 更快的风车 = 产生更多应力"
	quest.7588C9554B59EA62.quest_desc: ["你已成功合成 &5反物质&r。"]
	quest.7588C9554B59EA62.quest_subtitle: "不可能的任务已完成"
	quest.7588C9554B59EA62.title: "反物质"
	quest.76B45C5766C61369.quest_desc: ["佩戴&6护目镜&r能清楚地看到机器消耗或产生的压力单位（SU）数量，这样就能轻松查明机器停止运行的原因了"]
	quest.76B45C5766C61369.quest_subtitle: "查看额外信息"
	quest.76D185BEC0C37EC0.quest_subtitle: "64x 基础存储容量"
	quest.7713894F96979D3A.quest_subtitle: "使用能量工作的更快镐子"
	quest.77C9EE701F72586D.quest_desc: [
		"&bPortable Cells&f function identically to regular cells in that they can they be inserted into a chest or drive and filled accordingly."
		""
		"不过，与普通单元不同，它们的内容也可以通过单元物品本身单独访问，有点像数字化的ME风味背包。"
	]
	quest.780712A5A04E3E13.quest_desc: [""]
	quest.780712A5A04E3E13.quest_subtitle: "这条机器生产线将帮助你生产裂变燃料，这是“裂变反应堆”运行所必需的！"
	quest.78311531069807DE.quest_desc: [
		"在 Applied Energistics 2 中，每个 ME 网络都有一定数量的可用 &e通道&f，这表示整个网络可以容纳多少联网设备。"
		""
		"通常，直接或间接处理ME数据（存储在网络中的物品）并进行某种I/O的设备会占用一个通道。而仅负责网络内部能量存储的组件，如&e能量电池&f和&e订阅器&f，则&o不&r占用通道。"
		""
		"没有 &bME 控制器&f 的网络被称为“临时”网络，最多只支持 8 个频道。"
	]
	quest.78311531069807DE.title: "关于频道的序言"
	quest.79769004F4EB9285.quest_desc: [""]
	quest.79769004F4EB9285.quest_subtitle: "你已成功合成出钚元素 Plutonium"
	quest.79769004F4EB9285.title: "钚元素（Plutonium）"
	quest.79FCBEBFE6E29E44.quest_desc: ["&6机械钻头&r可以挖掘前方的任何方块，非常适合需要破坏方块来建造的农场，比如鹅卵石农场"]
	quest.79FCBEBFE6E29E44.quest_subtitle: "为你挖掘的矿洞"
	quest.7A6A5261F2755BF1.quest_subtitle: "电气冶炼"
	quest.7A912B457632672E.quest_subtitle: "这个线轴可以连接到低压连接器上"
	quest.7B7D1F0CB326B28F.quest_desc: [
		"&bME IO Port&f 允许将 ME 网络存储的内容在不同存储介质（如 ME 单元和连接到存储总线的容器）之间快速重新排列。"
		""
		"当左侧输入槽插入一个单元时，IO端口可以切换，将单元清空到其他ME存储中，或用来自其他存储的特定物品填充（最好是分区的）单元。"
	]
	quest.7B8E4F1DEC8AD248.quest_subtitle: "便携式炼狱"
	quest.7C3614F9D06BAA49.quest_subtitle: "加固飞行能力（reinforced flight）"
	quest.7CB9A9819217D505.quest_subtitle: "安全装备"
	quest.7CF5BD4235FE4539.quest_desc: [
		"超临界相移器是成本最高、最耗能的设备。"
		""
		""
		"其主要功能是生成&5反物质&r，即Mekanism中最终也是最强大的材料。"
	]
	quest.7CF5BD4235FE4539.quest_subtitle: "反物质合成"
	quest.7CF5BD4235FE4539.title: "建造你的第一个超临界相移器！"
	quest.7DC9A48B25E63807.quest_desc: ["&6黄铜漏斗&r是升级后的安山岩漏斗，可添加物品过滤器，每次最多移动一叠物品"]
	quest.7DC9A48B25E63807.quest_subtitle: "一个升级过的漏斗"
	quest.7DFFD1F66AB6296F.title: "拜访绯红森林"
	quest.7EF1D870E752E4DA.quest_desc: [
		"&6矿车组装器&r能将你想建造的任意机器附着到矿车上，还能移动原版无法移动的物品，如正在生长的紫水晶和刷怪器"
		""
		"&l&c如果你想移动刷怪器，需要在创造配置中启用它&r&r"
	]
	quest.7EF1D870E752E4DA.quest_subtitle: "这可能是最超模的物品之一了"
	quest.7EFBAF3E281D2EBE.quest_desc: [
		"当&bME Storage Bus&f朝向外部存储容器时，该容器将被视为ME网络的一部分，物品可以通过ME直接存取。"
		""
		"存储总线可以设置过滤和优先级，使特定物品优先传输至已连接的存储，但不会将网络中其他地方的已过滤物品回溯移动至该存储。"
	]
	quest.7F5228C9A9FC87D5.quest_desc: [
		"&6密封风扇&r用途广泛，可用于吹爆、清洗、惊吓和熏制物品。旋转方向决定了它是推气还是吸气"
		""
		"要&c吹走&r物品，你需要在风扇前放置一个熔岩源"
		"要&9清洗&r物品，你需要在风扇前放置一个水源"
		"要&b附魔&r物品，你需要在风扇前放置一个灵魂篝火"
		"要&e熏制&r物品，你需要在风扇前放置一个篝火"
	]
	quest.7F5228C9A9FC87D5.quest_subtitle: "有多种用途"
	quest.7F5228C9A9FC87D5.title: "封闭式风扇"
	quest.7FAD53445B3A0946.quest_subtitle: "机械伙伴"
