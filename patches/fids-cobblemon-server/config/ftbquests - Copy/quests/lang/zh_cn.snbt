	file.0000000000000001.title: "Fid's Cobblemon 事件"
	quest.00ADD2809FC49F4A.title: "米达斯黄金武器库"
	quest.011F00CF8259AFD1.quest_desc: [
		"Cobblemon的世界里有许多花卉奇迹——各种不同的&l&2浆果&r&r和其他作物都有其独特的益处。不妨去采摘这些浆果，建造一个大花园吧？这对你和你的宝可梦都大有裨益！"
		""
		"某些浆果树会出现在特定群系中，而有些则只能通过宝可梦获得。出发吧，收集并种植尽可能多的不同浆果！"
	]
	quest.0153D59387F6A20C.quest_desc: [
		"刚开始宝可梦冒险，你很快就会发现宝可梦的&l&ePP&r&r很快就用完了，无法再使用最强的招式。那么，你该如何补充呢？"
		""
		"你可以睡觉，但要让夜晚过去，服务器里&o一定比例的玩家&r也必须这样做。"
		""
		"[ \"在获得治愈机之前，更好的方法是突变奥兰浆果以获得莱帕浆果。有关突变的更多信息，请点击\", { \"text\": \"此处\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"202DA85A2682E350\" } }, \"。\" ]"
	]
	quest.0153D59387F6A20C.title: "没有PP？？"
	quest.018D46ADBF61295D.title: "卡莫特军械库"
	quest.019937E1B4E453C7.quest_desc: [
		"&l修复储罐&r是组装&z修复机器&r所需的3个方块之一。请将它们按任务气泡所示排列，修复储罐在右侧，分析仪和数据监视器堆叠在一起。"
		""
		"修复罐是化石胚胎生长的地方。需要填充&o有机物&r，为胚胎提供适宜的生长环境。"
	]
	quest.01CE5ECBDAF15734.quest_desc: ["可通过突变 Belue 和 Coba 获得。"]
	quest.01CE5ECBDAF15734.title: "罗瓦普浆果"
	quest.02B63C9A9D5842E9.quest_desc: [
		"&l不死图腾&r是Minecraft中的一次性物品，手持或副手持有时能防止玩家死亡一次。"
		""
		"受到致命伤害时会激活，消耗图腾的同时赋予&o再生&r、&o火焰抗性&r和&o吸收&r等效果"
	]
	quest.0309CA9430B67D28.quest_desc: ["如果能活下来的话，去&l&0深暗森林&r&r收集些纪念品吧..."]
	quest.0309CA9430B67D28.title: "四处挖掘雕刻"
	quest.03437405A79E3294.quest_desc: ["&l&6Bronze&r&r is an alloy of &ocopper&r and &otin&r. As such, it is an improved metal, slightly better than iron!"]
	quest.03437405A79E3294.title: "青铜"
	quest.0364E586278B5A86.quest_desc: [
		"&lAprijuice&r 是一种能修改宝可梦骑乘属性的物品。Aprijuice 可由任意七种颜色的 Apricorn、Pep-Up Flower、Energy Root 和任意组合的浆果烹饪而成。所用 Apricorn 的 &zcolor&r 会改变基础属性加成："
		""
		"&4红杏汁&r - +2 加速，-1 耐力"
		"&e黄色阿普里果汁&r - +2 耐力, -1 技能"
		"&9蓝色阿普果汁&r - +2 技能，-1 跳跃"
		"&2青柠汁&r - +2 跳跃, -1 速度"
		"&d粉红阿普果汁&r - +2 速度，-1 加速度"
		"&0黑杏汁&r - 无额外属性加成"
		"白杏汁 - 所有骑行属性-2"
		""
		"{@pagebreak}"
		"某些浆果的味道与骑乘属性相关。"
		""
		"&c加速&r = &c辛辣&r"
		"&e耐力&r = &e酸味&r"
		"&9技能&r = &9干燥&r"
		"&a跳跃&r = &a苦涩&r"
		"&d速度&r = &d甜美&r的"
		""
		"小心地加入浆果作为调味料！"
	]
	quest.0364E586278B5A86.title: "Aprijuice"
	quest.03EA05AE42175754.quest_desc: [
		"&l&2薄荷叶&r&r是一种用于制作薄荷的物品，通过收割薄荷作物的最后阶段获得，可产出1-3片相应的薄荷叶。如果植物未完全成熟，则只会掉落种子。"
		""
		"薄荷叶没有偏好的生物群系，可以在主世界的任何地表生成。"
		""
		"总共四片薄荷叶可以合成一个完整的薄荷，可以改变你的宝可梦的&l属性&r。"
	]
	quest.03EA05AE42175754.title: "薄荷清新"
	quest.045CFE202D4940CA.quest_desc: [
		"&lPasture Block&r 是一种实用方块，允许玩家将宝可梦从电脑中存入周围区域。"
		""
		"牧场方块的主要用途是让玩家能将宝可梦放出到特定区域，它们的行为如同野生宝可梦或被抛出精灵球一样。"
		""
		"在牧场方块上按下使用键会打开玩家的电脑GUI。"
		""
		"牧场方块最多可容纳16只宝可梦。"
		""
		"{@pagebreak}"
		"要&l繁殖&r宝可梦，你需要这个方块。将宝可梦放置在牧场中，点击按钮激活繁殖功能，稍后回来，或许能在牧场方块底部的巢穴区域找到蛋！"
	]
	quest.045CFE202D4940CA.title: "牧场方块与繁殖机制"
	quest.059DFD738EC0970B.title: "潮汐歌手军械库"
	quest.05B10B0A6B8D5B42.quest_desc: ["可通过突变 Touga 和 Occa 获得。"]
	quest.05B10B0A6B8D5B42.title: "番茄浆果"
	quest.05B6B045D15CE269.quest_desc: ["可通过突变 Persim 和 Cheri 获得。"]
	quest.05B6B045D15CE269.title: "Figy 浆果"
	quest.05CC094A7B604DAD.quest_desc: ["击败凋零的奖励是 &zNether Star&r，可用于制作多种强力物品。"]
	quest.05DC390697EBFAB2.quest_desc: ["&l运动球&r等同于高级球，有1.5倍的捕获率加成。"]
	quest.0665A3A34B54EBFC.quest_desc: [
		"如果你的物品栏想分开放置，而不是都挤在终端旁边，该怎么办呢？"
		""
		"制作一些 &l&2Inventory Cables&r&r，并将它们连接到存储箱上的 &lInventory Cable Connectors&r。"
	]
	quest.06FE957AE51AD9FC.title: "钢铁武器库"
	quest.07378EB5AE7CC844.quest_desc: ["这些是&l带框&r的Inventory Cables和Connectors。你可以“上色”它们，使其采用方块纹理，让你的装置看起来更整洁！"]
	quest.07877392BAB79647.quest_desc: [
		"&l导管&r是强大的物品，当玩家接触雨水或水时，会给予&b导管之力&r的AOE效果。"
		""
		"此效果可恢复氧气、提供水下夜视，并将挖掘速度提高16.7%（1/6）。"
		""
		"导管还会对8格范围内的任何敌对生物造成伤害，例如溺尸、守卫和远古守卫者。"
		""
		"导管可以在&o任何&r生物群系和任何高度或深度激活。"
		""
		"{@pagebreak}"
		"要让导管生效，它必须位于一个3x3x3的水体中心，而该水体本身必须被一个激活框架所包围。"
		""
		"框架由围绕导管、沿各轴分布的&l三个5×5的开放方块&r构成。"
		""
		"框架中只有海晶灯、暗海晶灯、海晶灯砖和海晶灯方块会参与激活。"
		""
		"至少需要 &o16 个方块&r，有效范围为 32 个方块。"
	]
	quest.0791550550B3C1A6.quest_desc: ["&lLuxury Balls&r 没有提高捕获率的加成，但用它们捕获的任何宝可梦，亲密度都会提升得更快！"]
	quest.085DC4D1AF85B481.quest_desc: ["&l高速球&r对基础速度100或以上宝可梦的捕获率有4倍加成！"]
	quest.08EBC8B4461F2DDC.quest_desc: ["你可以骑宝可梦飞行，但如果想自己飞呢？&l鞘翅&r依然在那里，在末地船中等着你……"]
	quest.09E180E0A9E68CD5.quest_desc: ["&l&0Durasteel&r&r 是一种更高级的钢，可通过熔炼 &5Manganese&r 和 &#1B8D55Quadrillum&r&r 获得。"]
	quest.09E180E0A9E68CD5.title: "Durasteel"
	quest.0A1383D67C585ED2.title: "银色武器库"
	quest.0A1C83F15DEDA31A.quest_desc: ["可通过变异 Nomel 和 Payapa 获得。"]
	quest.0A1C83F15DEDA31A.title: "蓝色浆果"
	quest.0AF1B8B47C259734.quest_desc: [
		"&l高级无线终端&r在各方面都优于另一个。你可以通过&4shift+右键单击&r无线终端，将其绑定到一个终端集上。"
		""
		"它在 &o64 格外&r（4 个区块长度）就能生效，把信标放在终端附近还能大幅增加范围。"
		""
		"{@pagebreak}"
		"&l1级&r信标会将范围扩展到终端设置维度内的任何地方（确保你已加载终端设置区块）。"
		""
		"&l4级&r信标将允许你跨维度访问终端！&zcross-dimensionally&r！"
	]
	quest.0B10020B7FCC4C39.quest_desc: [
		"&#FFEAB8&lHallowed Ingots&r&r 可以通过在二级合金锻造炉中熔炼奥里哈尔科姆、秘银和亚达曼特矿石获得。"
		""
		"神圣盔甲拥有惊人的&o韧性&r，还能让你看起来无比尊贵。"
		""
		"神圣锭也是制作 &#FFEAB8&l雅典娜之剑&r 所需的材料。"
	]
	quest.0EA458C9D39BF555.quest_desc: ["飞向天空，为我带回10种飞行生物！"]
	quest.0EE8C9716B5ED191.quest_desc: [
		"&2&l摩羯座树&r&r是一种在&l任何&r生物群系中罕见出现的树木。"
		""
		"所有杏树都会生成一种特定的杏子，树上会长有数量不定的这种杏子。"
		""
		"与长在树叶上的杏核互动以收获它们。"
	]
	quest.0EE8C9716B5ED191.title: "精灵球的球壳碎片 (The Shell of the Pokeball)"
	quest.0EFEE87C72270F80.quest_desc: ["&l无线终端&r让你可以远程访问终端。手持无线终端，&4右键&r点击要连接的终端。该设备可在 &o16格&r 内有效。"]
	quest.10065466E72861FD.quest_desc: [
		"这些特殊魔杖能让你一次性放置多个不同朝向的方块。"
		""
		"{@pagebreak}"
		"&l&n模式：&r&r"
		""
		"- 方向模式：从一个方块向9个方向放置单个方块。"
		""
		"- 行/列模式：一次性放置一行或一列的多块方块，按 &l&4X&r&r 可更改方向。"
		""
		"- 填充模式：填充两个角之间的相同方块，或随机填充。"
		""
		"- 区域模式：填充相连的方块，例如将X形的木板结构加厚！"
		""
		"- 网格模式：固定2D网格，使用方向键或GUI更改大小。"
		""
		"- 线路模式：从方块到方块的线路。"
		""
		"- 圆形模式：从中心方块到半径方块画圆（按 &l&4K&r&r 可改为实心圆）。"
		""
		"- 复制模式：在角之间复制。"
		""
		"- 粘贴模式：粘贴之前复制的方块，按 &l&4R&r&r 可在 Y 轴上以 90 度递增循环旋转。"
		""
		"- 爆破模式：用爆炸摧毁方块。在生存模式下，玩家需要有TNT在背包中。"
		""
		"{@pagebreak}"
		"有许多魔杖，每种都有不同的方块放置限制。"
		""
		"- 石制魔杖：放置方块上限为 &l16&r。"
		"- 铁制魔杖：方块限制为 &l32&r。"
		"- 钻石魔杖：放置方块上限为 &l64&r。"
		"- 下界合金魔杖：方块限制为&l256&r。"
	]
	quest.10065466E72861FD.title: "建筑师魔杖"
	quest.10400839D85AA87F.quest_desc: ["可在滴水石、山脉、沙地或火山群系中找到。"]
	quest.10400839D85AA87F.title: "Charti 浆果"
	quest.106FC22647A1B0E0.quest_desc: ["&lHeavy Balls&r的有效捕获加成范围为1倍至4倍，敌人宝可梦越重，加成越高！"]
	quest.10C5B76C07E0FC78.quest_desc: ["&l&bRunite&r&r 是一种强大的金属，可在两个生成高度范围找到：Y 39-53 和 Y -55-37。需要铁质工具或以上才能开采。"]
	quest.10C5B76C07E0FC78.title: "Runite"
	quest.1139A56637D270F0.quest_desc: ["可通过变异 Figy 和 Razz 获得。"]
	quest.1139A56637D270F0.title: "Touga Berry"
	quest.11D52E82D019C3AE.quest_desc: [
		"&l&2传送石&r&r能让你在世界内从一个传送石传送到另一个，甚至可以跨维度传送！"
		""
		"你可以制作它们或在村庄中找到传送石。一旦基座上的深渊守望者被激活，该传送石就会被添加到你的传送石列表中，供你相互传送。"
		""
		"{@pagebreak}"
		"&l&n深渊守望者&r&r"
		""
		"{image:fwaystones:item/abyss_watcher width:50 height:50 align:center}"
		""
		"用于制作传送石，右键可传送到其他传送石，使用时会消耗该物品。"
		"{@pagebreak}"
		"&l&n空白传送石碑卷轴&r&r"
		""
		"{image:fwaystones:item/empty_waystone_scroll width:50 height:50 align:center}"
		""
		"用于存储你发现的所有传送石。使用已填充的传送石卷轴，将向使用该卷轴的玩家揭示所有已存储的传送石。"
		"{@pagebreak}"
		"&l&n本地虚空&r&r"
		""
		"{image:fwaystones:item/local_void_inert width:50 height:50 align:center}"
		""
		"右键路标可将其绑定。右键其他地方，只要该位置存在，即可免费（可配置）传送到已绑定的位置，使用后物品会消失（可配置）。可通过Shift+右键重置物品。"
		"{@pagebreak}"
		"&l&nPocket Wormhole&r&r"
		""
		"{image:fwaystones:item/pocket_wormhole width:50 height:50 align:center}"
		""
		"与深渊观察者类似，它允许玩家在任意地方打开传送界面，但该物品在传送时不会被销毁。"
		"{@pagebreak}"
		"&l&n虚空图腾&r&r"
		""
		"{image:fwaystones:item/void_totem width:50 height:50 align:center}"
		""
		"与本地虚空一样，虚空图腾可以绑定到路石上。如果你装备着已绑定的图腾死亡，它会将你传送到绑定的路石。如果未绑定，它会随机选择一个你已发现的路石。否则，它就像普通的图腾一样。"
	]
	quest.11D52E82D019C3AE.title: "传送石"
	quest.11DB1A13714DAFCF.quest_desc: ["可通过突变奥兰和以下物品之一获得：拉兹、布洛克、纳纳布、威皮尔或皮纳普。"]
	quest.11DB1A13714DAFCF.title: "Leppa Berry"
	quest.1279FD428AD99391.quest_desc: [
		"&lBanglum&r ore can be found in a depth of Y 48-69 and should be mined with iron tools."
		""
		"开采此矿石时，偶尔能获得&l&2邦拉姆碎片&r&r。可用于将邦拉姆装备升级为&l&e传说级变种&r&r，从而获得各种增益！"
		""
		"&o下界邦格姆矿石&r比石质变种更频繁地掉落区块。"
		""
		"这是一种非常&l&4易挥发&r&r的矿石，会爆炸，尤其是在下界。使用带有&o丝绸之触&r的工具会大大降低爆炸几率。"
	]
	quest.1279FD428AD99391.title: "Banglum"
	quest.1297DF4F4049A8F8.quest_desc: [
		"有许多&l著名的地区菜肴&r，你可以亲自烹饪！"
		""
		"收集不同的食物和食材，你肯定能为&o篝火锅&r调配出一些食谱！"
	]
	quest.1297DF4F4049A8F8.title: "环球美食大荟萃"
	quest.12CFB1DA31A20E04.quest_desc: [
		"Inventory Profiles Next 是一款帮助整理和分类物品栏的模组。"
		""
		"&l&n分类：&r&r"
		""
		"按下 &l&4R&r&r 会自动整理你的物品栏。UI 中还有一个 \"Z\" 键，也可以用来整理物品。"
		""
		"还有其他按钮可以按行或列进行排序。"
		""
		"你可以在模组配置菜单中找到许多其他可修改的排序方法。"
		""
		"&l&n合成配方：&r&r"
		""
		"点击合成网格旁的框子即可启用&l自动合成&r。如果&l&4按住 Alt 键点击&r&r输出物品，所有材料将作为&o一整套&r放入合成网格中。"
		""
		"&l&4Shift+alt 加点击&r&r会遍历背包中的每一组物品来制作输出物品。"
	]
	quest.1326AA6E869391F5.title: "普罗米修斯军械库"
	quest.136C2644F5E3208B.title: "水族馆武器库"
	quest.13E291211614CDB8.quest_desc: [
		"&lData Monitor&r 是组装 &zRestoration Machine&r 所需的 3 个方块之一。请将它们按任务气泡所示的顺序放置，Restoration Tank 在右侧，Analyzer 和 Data Monitor 堆叠在一起。"
		""
		"数据监视器显示胚胎的成长进度。"
	]
	quest.13F05FC3A7B0A2BE.quest_desc: ["可通过变异 Sitrus 和 Haban 获得。"]
	quest.13F05FC3A7B0A2BE.title: "波美果浆果"
	quest.13FFABBC8A5A24BD.quest_desc: ["如果敌方宝可梦的性别与你的相反，&lLove Ball&r的捕获率会提高2.5倍。如果它们属于同一物种，捕获率会飙升8倍！"]
	quest.14040081429A2C17.quest_desc: [
		"&l欢迎来到Cobblemon的世界！&r"
		""
		"在这个世界，生物群系非常&l广阔&r而&l绵延不绝&r，正适合这个&o&e可骑乘宝可梦&r&r的新时代！外面有许多宝藏等着你，快出发吧！"
	]
	quest.1440B4A115E6ACB8.quest_desc: ["&lCarmot Bell&r 是一种特殊的可放置工具，能为附近的任何人提供 &2治愈光环&r。"]
	quest.1444F8E8000160FB.quest_desc: ["可在森林、丛林或沼泽生物群系中找到。"]
	quest.1444F8E8000160FB.title: "Tanga Berry"
	quest.14BB110FA2CC440A.quest_desc: [
		"如何将&o多个箱子&r连接起来以创建一个存储系统？将&l&6物品栏连接器方块&r&r放置在你使用的终端后面。然后，你可以将箱子等物品栏方块放置在物品栏连接器&o的相邻位置&r。现在所有物品都会显示在你的终端中！"
		""
		"&o更棒的是：&r你可以将双箱堆叠在一起，无论是水平还是垂直，只要其中一个接触了物品连接器，所有内容都会显示出来！"
	]
	quest.14C378BB68E4B8C3.quest_desc: [
		"&l三叉戟&r是一种可以投掷的宏伟武器。它也有许多专属的附魔。"
		""
		"你可以从挥舞三叉戟的溺尸那里获得稀有掉落，或者从试炼密室中获得，甚至可以用&9水族箱珍珠&r来合成。"
	]
	quest.14F5BF551B9632DC.quest_desc: ["&l治愈球&r能完全治愈被它捕捉到的宝可梦。"]
	quest.153FC04034645E77.quest_desc: ["可通过突变 Pamtre 和 Kelpsy 获得。"]
	quest.153FC04034645E77.title: "烈驰浆果"
	quest.15C38E4B51C059B7.quest_desc: ["捉住10只普通型宝可梦，我就给你一些金币！"]
	quest.15C686082A1BF122.quest_desc: ["&l计时球'&r的效力会根据战斗中经过的回合数最多提升4倍，最多10回合。"]
	quest.16875785F44378F2.quest_desc: [
		"&l&n自然指南针：&r&r"
		""
		"&l&2Nature's Compass&r&r 是一款实用物品，能让你在世界任何地方搜索生物群系的位置并查看相关信息。如果你想找定位建筑的指南针，可以试试 Explorer's Compass。"
		""
		"- 手持自然罗盘，&l&4右键&r&r即可打开生物群系选择界面，从中可以搜索生物群系或查看相关信息。"
		""
		"- &l&4Shift+右键&r&r将重置罗盘的状态。"
		""
		"- 当指南针不指向任何生物群系时，它将指向世界出生点。"
	]
	quest.175B72CB4D34DB18.quest_desc: ["可在山地群系中找到。"]
	quest.175B72CB4D34DB18.title: "Aspear Berry"
	quest.17C90C8FEF38A47C.title: "Durasteel 工具"
	quest.184589CCF1A4DD74.quest_desc: ["捕捉10只带电宝可梦，让火花四射！"]
	quest.19DF3C1711E7E3B9.title: "Carmot 工具"
	quest.1A16EEA020043B2D.quest_desc: ["可在森林群系中找到。"]
	quest.1A16EEA020043B2D.title: "Chesto Berry"
	quest.1A3998AA77D42016.title: "钓鱼船"
	quest.1A57445DD4CC44BC.quest_desc: ["在平原或森林生物群系中使用&lPark Balls&r时，捕获率会提高2.5倍！"]
	quest.1A8487EF38226A2F.quest_desc: ["可通过突变 Lum 和 Leppa 获得。"]
	quest.1A8487EF38226A2F.title: "霍波浆果"
	quest.1ADB5676E7965302.quest_desc: [
		"&lQuadrillum&r 是一种可在 Y 值 12-40 范围内找到的矿石，需要用铁制工具挖掘。"
		""
		"用这种材料可以制作多种工具，比钻石工具稍弱，但你也可以用&l&d锰&r&r将其熔炼成&l&0杜拉钢&r&r！"
	]
	quest.1ADB5676E7965302.title: "四重立方体"
	quest.1B18E77AC18EBDE8.quest_desc: [
		"&l庇护锻造模板&r只能在&o大师级牧师村民&r身上找到。"
		""
		"此模板可帮助您获得两种Aegis之刃：分别是通过Palladium Sword和Hallowed Sword获得的&l&4Blade of Aegis&r&r和&#FFEAB8&lSword of Aegis&r。"
	]
	quest.1B18E77AC18EBDE8.title: "Aegis 锻造模板"
	quest.1B66388A59A28505.quest_desc: ["&lQuick Balls&r 在战斗的第一回合内，捕获率会惊人地提升5倍！"]
