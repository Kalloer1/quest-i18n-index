			x: 1.0d
			y: 0.5d
			shape: "gear"
			description: ["要解锁创意物品章节，你必须完成“...的终结”系列任务。"]
			dependencies: ["2C8AB1F55FB366FF"]
			id: "47900538A09CE4F2"
