		{
			x: 5.5d
			y: 1.5d
			description: ["娜迦BOSS掉落物，可用于合成娜迦套"]
			dependencies: ["4A60E12F4E641F8F"]
			id: "145C87C2CD96D819"
			tasks: [{
				id: "5BE3C7A7A32741AE"
