	order_index: 4
	quest_links: [ ]
	quests: [
		{
			dependencies: ["7207919E6B85EE4E"]
			description: [
				"注意：请确保已在“未来时代：太空”章节提交了20个工程经验宝石以解锁此章节，太空和科幻将同时解锁。"
				""
				"欢迎来到科幻时代！Mekanism 终于为您带来了一系列低、中、高阶段的机器，将您过时的家园和低效的资源处理提升至21世纪。借助我们收集的高科技工具、高端能源发电机、先进的传输系统和复杂的处理机制，您将摆脱“采矿”和“合成”的繁琐任务，迅速迈向新的科技启蒙境界。"
				""
				"借助 Mekanism 的提纯、溶解、化学注入和结晶技术，只要有足够的基础设施和能源，你的锭产量就能翻倍、三倍、四倍，甚至五倍！"
			]
			icon: {
				Count: 1
				id: "mekanism:atomic_disassembler"
				tag: {
					mekData: {
						EnergyContainers: [{
							Container: 0b
							stored: "1000000"
						}]
					}
				}
			}
