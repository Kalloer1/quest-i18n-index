	quest.41E9F40575FB4DAA.quest_desc: ["HAHAHHAHAHA 我们抓住了 &#8E44ADNECROZMA&f，现在距离终结这一切只剩一步之遥！"]
	quest.41E9F40575FB4DAA.quest_subtitle: "不可思议"
	quest.41E9F40575FB4DAA.title: "捕捉了 Necrozma"
