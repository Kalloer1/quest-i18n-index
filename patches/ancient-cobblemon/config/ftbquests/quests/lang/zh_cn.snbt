	quest.088DBF578D0C04F0.title: "击败宝可梦"
	quest.098108C1B0208DB0.quest_desc: ["&#3498DBReshiram&f 栖息在美丽的 &#2ECC71Biome&f 中，但它非常 &#E74C3CDangerous&f 且险恶，不要相信它的 &#E67E22Words&f！点击 &#FFD700Reward&f，&#E74C3CBoss&f 就会出现！"]
