	quest.0D409F3E33BA1257.title: "Pillar"
	quest.0D88E60491704C4E.quest_desc: ["通常在&#3498DB森林&f或&#3498DB平原&f生物群系中，可以找到&#3498DBVerity湖&f&#3498DB结构&f，它是&#3498DBMesprit&f的家园。"]
