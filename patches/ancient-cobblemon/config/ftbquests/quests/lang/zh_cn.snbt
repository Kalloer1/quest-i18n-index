	quest.39B0E5CF13BB35D9.title: "探寻真相，揭开谜底"
	quest.39C5D354ED94C19A.quest_desc: ["有时候，&#2ECC71宁可信其有，不可信其无&f，万一&#FF5733Greninja&f决定要向你&#E74C3C复仇&f呢？哈ahaha"]
