	quest.3D05E9DA1BA46148.quest_subtitle: "正在寻找第 8 个物品"
	quest.3D05E9DA1BA46148.title: "奇玉 (Chi-Yu)"
	quest.3D203B3B1388E69A.quest_desc: ["去&#E74C3C下界&f之前，要不要来些新的&#3498DB神奇&f宝贝&#3498DB球&f？我想我们需要&#F1C40F它们&f！"]
	quest.3D203B3B1388E69A.quest_subtitle: "人越多越热闹！"
	quest.3D203B3B1388E69A.title: "精灵球"
	quest.3D55EF8FEF9DDE43.quest_desc: [
		"我们的&#3498DBMeltan&f可能始于&#F1C40F5级&f，但我们能把它进一步升级为&#FFD700Melmetal&f！为此，请再次使用&#FFD700Mystery Box&f，并收集额外的&#F1C40F50 Metal Points&f来赢取&#FFD700Meltan Candy&f。"
		""
		"给你的 &#3498DBMeltan&f 喂食 &#F1C40F64&f 个 &#FFD700Meltan Candies&f，它就会进化成强大的 &#3498DBMelmetal&f！"
	]
	quest.3D55EF8FEF9DDE43.quest_subtitle: "第5级？"
	quest.3D55EF8FEF9DDE43.title: "捕捉熔岩虫"
	quest.3F81ABA831F116B7.quest_desc: [
		"&#8E44AD厄特纳图斯&f - &#3498DB本&f的故事……哈哈，爱信不信&#3498DB小子&f我不会阻止你……去我的&#8E44AD蛹&f里交500个&#3498DB加勒尔粒子&f。"
		""
		"在那之后，一切就看你的了！"
		""
		"* 抓住我，你就会知道全部真相"
		"* 击败我，然后闭上眼睛，直面现实"
	]
	quest.3F81ABA831F116B7.quest_subtitle: "万物皆有价码"
	quest.3F81ABA831F116B7.title: "加勒尔粒子"
	quest.3FBCC240585C8B63.quest_desc: ["激活传送门并跳进去！"]
	quest.3FBCC240585C8B63.quest_subtitle: "我们到目的地了！"
	quest.3FBCC240585C8B63.title: "末地？"
	quest.3FD75A9BD7B55145.quest_desc: [
		"你好，&#607078训练师&f！"
		"我是本教授，将陪伴你踏上你的&#FF5733旅程&f！"
		"希望你能成功&#2ECC71拯救&f我们的世界。"
		""
		"欢迎来到远古可布勒蒙的世界……"
		""
		"在这个属于我们的&#3498DB远古世界&f里，我们远离机器，远离那个人人都爱的科技世界，最近发生了一些&#E67E22怪事&f，一只怪物...&#9B59B6伊特纳托斯&f正在侵扰着我们人类与宝可梦之间的&#E74C3C和平联盟&f..."
		""
		"完成你的&#F1C40FMinions' Challenges&f章节，并在最后与他们战斗！展现你的&#E74C3CHonor&f，拯救我们的生命。"
	]
	quest.3FD75A9BD7B55145.quest_subtitle: "一个充满战争的世界"
	quest.3FD75A9BD7B55145.title: "开始"
	quest.4047878C25B6CA39.quest_desc: ["或许，&6装备得再好一点&f会有所帮助！"]
	quest.4047878C25B6CA39.quest_subtitle: "正在变强中"
	quest.4047878C25B6CA39.title: "铁质盔甲"
	quest.4120631A6C2D108E.quest_desc: [
		"&#8E44ADNecrozma&f 一定躲在 &#FF69B4Hoopa&f 的恶作剧后面，冲吧！"
		""
		"飞出&#9B59B6末地&f岛屿，找到&#FF69B4Hoopa&f的金字塔。在金字塔中，你需要完成一个&#E67E22迷宫&f，直到找到一个&#F1C40F宝箱&f，并获得你的第一把&#3498DB神殿钥匙&f。"
		""
		"将其放入钥匙孔后，我们就可以去下一个挑战了：一个巨大的幻术师 &#FF69B4Hoopa&f 将会诞生，我们需要消灭它并获得一把 &#3498DBTemple Key&f。"
		""
		"要进入下一个区域，我们需要完成一个&#3498DB测验&f，但我真不知道该怎么完成……"
	]
	quest.4120631A6C2D108E.quest_subtitle: "Hoopa 是一个爱开玩笑的家伙"
	quest.4120631A6C2D108E.title: "找到胡帕金字塔"
	quest.416B59E4A0406D32.quest_desc: ["一只&#3498DB小型&f&#E74C3C怪物&f正在&#E74C3C下界&f肆虐，它并非非常&#2ECC71强大&f的&#F1C40F传说级&f生物，但用得好会很有帮助！"]
	quest.416B59E4A0406D32.quest_subtitle: "滚烫的岩石！"
	quest.419BF332E69A2F00.quest_desc: [
		"既然我们已&#F1C40F变强&f，就需要去寻找&#3498DB基格尔德&f！要找到他，就去到&#3498DB冰冻山峰&f生物群系。千万&#E74C3C不要相信&f他说的话！"
		""
		"到达后，只需点击&#FFD700奖励&f，即可召唤出&#E74C3C首领&f！"
	]
	quest.419BF332E69A2F00.quest_subtitle: "做好准备吧，基格尔德！"
	quest.419BF332E69A2F00.title: "寻找冰封山峰"
	quest.41DC14FBADC2E5A1.quest_desc: ["孩子，我们要去最后一章了！小心可能会发生的事情！"]
