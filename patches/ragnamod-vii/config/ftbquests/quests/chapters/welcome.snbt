				Count: 1b
				tag: {
					modularrouters: {
						ModuleFilter: { }
					}
				}
			}
			x: 1.0d
			y: 0.5d
			shape: "gear"
			description: ["要解锁创意物品章节，你必须完成“...的终结”系列任务。"]
			dependencies: ["2C8AB1F55FB366FF"]
			id: "47900538A09CE4F2"
			tasks: [{
				id: "43845AD1FF4F31E7"
				type: "checkmark"
				title: "创意任务集"
			}]
		}
		{
			title: "虚假玩家"
			icon: "computercraft:turtle_advanced"
			x: -1.0d
			y: 1.5d
			shape: "diamond"
			description: [
				"此整合包包含 FTB Chunks，可让你认领并保护自己的区块，免受任何潜在的破坏。"
				""
				"但放置自动放置或破坏方块的机器，如 Block Placer、Wither Builder 等时，它们无法正常工作。"
				"这很正常，你需要在区块配置中授权Fake Player。"
				""
				"为此，你必须点击背包左上角代表三名玩家（蓝色、绿色和红色）的图标"
				"然后点击右上角的齿轮图标。"
				"以上便是所有可供自定义的区块配置选项了。"
				""
				"§c小心，接受所有虚假玩家后，服务器上的任何人都可能用 RFTools builder 等模组来破坏你的世界。§r"
			]
			dependencies: ["2C8AB1F55FB366FF"]
			id: "508A8EDCA5271990"
			tasks: [{
				id: "26A31CBD381D7BA3"
				type: "checkmark"
			}]
		}
		{
			title: "做好准备迎接挑战吧"
			icon: "ragnamod_seven:sculk_singularity"
			x: 0.0d
			y: 1.5d
			shape: "octagon"
			description: [
				"在这个整合包里，你需要被动地收集一些用于奇点的资源。"
				""
				"查看模组中的奇点，提前规划好需要刷取的内容。"
				"这样你就不用等到游戏后期了。"
			]
			dependencies: ["2C8AB1F55FB366FF"]
			id: "1CCB446F49264C47"
			tasks: [{
				id: "4594366B54D5BC86"
