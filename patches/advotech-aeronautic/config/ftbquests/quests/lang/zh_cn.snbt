	]
	quest.0E77F96C54912959.quest_subtitle: "&7Modular Force Field System"
	quest.0E77F96C54912959.title: "&6伪装模块"
	quest.0E7A32B31BD08D44.quest_desc: [
		"&dTainted Rock&r 和 &dTwisted rock&r 不仅是装饰性石材，更是失衡的产物。它们是材料与 &bSpirit&r 在和谐之外强行结合的结果。单独存在时，它们是诡异的点缀；组合在一起，则能开启更深层的创造。"
		""
		"古人发现，将灵魂编织进石头中，便能创造出炼金与人工的新引擎。请怀着敬畏之心，因为扭曲之物，鲜有能复原的。"
	]
	quest.0E7A32B31BD08D44.quest_subtitle: "石头会记住。腐化会教导。"
	quest.0E7A32B31BD08D44.title: "&d被污染与扭曲&r"
	quest.0E9B432007D015F5.quest_desc: [
		"&6这才是值得为之努力的目标。&r"
		""
		"制作或获取 &6混沌法杖&r。"
		"此阶的工具或武器。更远的射程、更快的速度，通常还有值得学习的特殊能力。"
		"&7Draconic Evolution&r 进阶的一部分。"
		"&8一个分支任务。可选，但很少浪费时间。"
	]
	quest.0E9B432007D015F5.quest_subtitle: "&7龙之进化模组"
	quest.0E9B432007D015F5.title: "&6混沌法杖"
	quest.0EA2CB5683594AB9.quest_desc: [
		"&6这才是值得为之努力的目标。&r"
		""
		"合成或获取 &6河豚&r。"
		"原版游戏中的常见物品，这里用作某种截然不同之物的基础。"
		"&7Minecraft&r 进阶的一部分。"
		"&8这不再影响后续步骤——想建的时候再建，而不是被迫去建。"
	]
	quest.0EA2CB5683594AB9.quest_subtitle: "&7我的世界"
