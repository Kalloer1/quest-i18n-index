	chapter_group.7E3A416D6FB95C7F.title: "众神赐予的礼物"
	quest.0000000000000002.quest_desc: [
		"欢迎来到 &6AdvoTech: 航空科技&r。"
		"这本书是你的整合包指南。每个章节都是一个模组或主题，每个任务都是解锁下一个任务的步骤。"
		"不必按顺序完成——进度是灵活的——但章节大致按照其发挥作用的时间顺序排列。"
		"花点时间阅读第一部分。它涵盖了能让整合包其余部分轻松许多的几个要点。"
		"&8下一步：生存第一晚的基础知识。"
	]
	quest.0000000000000002.quest_subtitle: "&7Where this chapter begins"
	quest.0000000000000002.title: "&6欢迎"
	quest.0000000000000005.quest_desc: [
		"常规规则适用，但会更加严苛。"
		"收集木材，制作工具，建造庇护所，熬过第一个夜晚。本整合包不会改变这一点。"
		"变化的是后续内容：在几日内，你应该会看到 &aMystical Agriculture&r、&bCreate&r 或早期的 &bPowah&r 发电机，而不是石制镐子。"
		"不要过度投资原版装备。它们很快就会被替换掉。"
		"&8下一步：确保你建造的土地安全。"
	]
	quest.0000000000000005.quest_subtitle: "&7在已有基础上进行建造"
	quest.0000000000000005.title: "&6你的第一个夜晚"
	quest.0000000000000008.quest_desc: [
		"在建造基地之前，先占领它。"
		"使用 &eM&r 打开地图，并认领你正在工作的区块。认领的区块会受到保护，不会消耗任何资源。"
		"在服务器上，这是你第一个小时内能做的最重要的事情。"
		"&8下一步：可靠地返回你的基地。"
	]
	quest.0000000000000008.quest_subtitle: "&7下一个等级"
	quest.0000000000000008.title: "&6正在认领您的土地"
	quest.000000000000000B.quest_desc: [
		"现在就设置一个回家坐标，别等迷路了再设置。"
		"地图模组让你能随地放置路标。标记你的基地，标记任何你想回到的建筑，以及你建造的每个维度传送门的入口。"
		"后续章节会带你前往暮色森林、以太、地下花园和另一面。路标能让你免于繁琐的奔波。"
		"&8下一个：这本书的实际运作方式。"
	]
	quest.000000000000000B.quest_subtitle: "&7在已有基础上进行建造"
	quest.000000000000000B.title: "&6找到回家的路"
	quest.000000000000000E.quest_desc: [
		"这本书不仅仅是一个待办事项清单。"
		"每个任务都有说明物品用途和适用场景的描述。悬停任意任务可查看要求；点击已完成的任务以领取奖励。"
		"任务永不过期，书籍也非强制内容——它更像是一场有向导的游览，而非一条固定轨道。"
		"&8下一步：和其他人一起玩。"
	]
	quest.000000000000000E.quest_subtitle: "&7进步，复利增长"
	quest.000000000000000E.title: "&6任务书 The Quest Book"
	quest.0000000000000011.quest_desc: [
		"任务进度在团队内共享。"
		"与其他玩家一起玩的话，请组成团队。团队内所有人共享任务完成进度，这样就能分工合作，而不是重复劳动。"
		"奖励仍需单独领取。"
		"&8下一步：离开时保持机器运行。"
	]
	quest.0000000000000011.quest_subtitle: "&7更进一步的一步"
	quest.0000000000000011.title: "&6团队与共享"
	quest.0000000000000E01.quest_desc: [
		"Relics 是强大的遗物，可在宝箱中找到或通过合成获得。"
		""
		"&d研究台&r至关重要。它能让你鉴定未知遗物，并将其磨成经验值来升级装备。"
	]
	quest.0000000000000E01.title: "遗迹研究 (Relic Research)"
	quest.0000000000000E11.quest_desc: [
		"得赶紧走！"
		""
		"&6旱冰鞋&r可在陆地上增加速度。"
		"&6冰鞋&r能在冰面上赋予惊人的速度。"
	]
	quest.0000000000000E11.title: "速度狂人"
	quest.0000000000000E21.quest_desc: [
		"掌控你脚下这片土地的四大元素。"
		""
		"&c岩浆行者&r：在岩浆上行走并获得火焰抗性。"
		"&bAqua Walker&r：在水上行走，游泳速度更快。"
	]
	quest.0000000000000E21.title: "表面张力"
	quest.0000000000000E31.quest_desc: [
		"终极的鞋履装备。"
		""
		"结合了岩浆行走器和水上行走器的效果。你可以在任何液体上行走！"
	]
	quest.0000000000000E31.title: "两栖动物靴子"
	quest.0000000000000E41.quest_desc: [
		"打得再狠一点。"
		""
		"&cRage Glove&r：生命值越低，造成的伤害越高。"
		"&b破冰者&r: 对冰冻的敌人造成巨额伤害。"
	]
	quest.0000000000000E41.title: "近战大师"
	quest.0000000000000E51.quest_desc: [
		"远程破坏。"
		""
		"&e暗影之刃&r：一种类似回旋镖的投掷武器。"
	]
	quest.0000000000000E51.title: "投掷武器"
	quest.0000000000000E61.quest_desc: [
		"额外的口袋。"
		""
		"&6皮革腰带&r提供额外的腰带槽位。"
		"&2猎人腰带&r在击杀生物时提供加成。"
	]
	quest.0000000000000E61.title: "腰带类物品"
	quest.0000000000000E71.quest_desc: [
		"生存所需的工具。"
		""
		"&b魔法镜子&r：将你传送到出生点/床（就像泰拉瑞亚！）。"
		"&2孢子囊&r：释放孢子对敌人造成伤害。"
		"&6箭袋&r: 用于存放你的箭矢。"
	]
	quest.0000000000000E71.title: "冒险家工具包"
	quest.0000000000000E81.quest_desc: [
		"防御性文物。"
		""
		"&b反射项链&r：将伤害反射回攻击者。"
	]
	quest.0000000000000E81.title: "护盾防御"
	quest.0000000000000E91.quest_desc: ["神秘的力量。"]
	quest.0000000000000E91.title: "神秘物品 (Arcane Artifacts)"
	quest.0000000000000EA1.quest_desc: [
		"等等，我这是在哪儿？"
		""
		"The &5Spatial Sign&r allows you to mark a location and teleport to it later. Very handy."
	]
	quest.0000000000000EA1.title: "标记与回忆"
	quest.0000000000000FA1.quest_desc: [
		"魔法隐藏在万物之中，就连岩石也不例外。"
		""
		"奥术水晶矿石深藏地下。你需要大量这种粉尘来制作魔法组件和符文。"
	]
	quest.0000000000000FA1.title: "神秘起源 (Arcane Beginnings)"
	quest.0000000000000FB1.quest_desc: [
		"在魔法森林中发现的深色坚固木材。"
		""
		"这是制作赫菲斯托斯熔炉和其他魔法结构所必需的。如果你找到一棵树，请（尊重地）把它砍掉。"
	]
	quest.0000000000000FB1.title: "白蜡木"
	quest.0000000000000FC1.quest_desc: [
		"符文是仪式中使用的组件。"
		""
		"你可以制作它们，也可以在世界中找到。其他所有符文的基础都是&5符文&r。"
	]
	quest.0000000000000FC1.title: "符文锻造术"
	quest.0000000000000FD1.quest_desc: [
		"本模组的核心所在。"
		""
		"&4赫菲斯托斯熔炉&r能让你施展强大的仪式。使用时，必须将其放置并建造特定的多方块结构（在下方放置雕纹神秘抛光暗石）。"
		""
		"需要4种能量：&c血液&r、&b奥瑞尔&r、&5灵魂&r和&a经验&r。"
	]
	quest.0000000000000FD1.title: "众神锻造炉"
	quest.0000000000000FE1.quest_desc: [
		"这种神秘的粉尘用于激活锻造炉和转化物品。"
		""
		"用此粉尘右键赫菲斯托斯锻造炉以完成仪式。"
	]
	quest.0000000000000FE1.title: "魔法火药"
	quest.0000000000000FF1.quest_desc: [
		"Forge 的其中一个输入材料。"
		""
