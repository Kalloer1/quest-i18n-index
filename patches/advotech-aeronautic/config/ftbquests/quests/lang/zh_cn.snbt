	quest.0E0C8D65251B2E04.quest_desc: ["&7放入其中的物品会立即充电。由于其大容量且无法输出电力，建议&c不要连接到重要电网&7。同样，在储存电力时破坏该方块，&c电力不会被保留&7"]
	quest.0E0C8D65251B2E04.quest_subtitle: "电池'nt"
	quest.0E0C8D65251B2E04.title: "&7机器框架怜悯机制"
