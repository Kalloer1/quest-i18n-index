	quest.2CC8A11E72F2E9D4.quest_subtitle: "双重挤压"
	quest.2CC8A11E72F2E9D4.title: "&8&l致密压缩机&r"
	quest.2CD415DD37723051.quest_desc: ["&aSpirited Reactor&r。36个绿宝石块。你本可以买个&b城堡&r，却选了个带劲的能源立方体。"]
	quest.2CD415DD37723051.title: "&a&lSpirited Reactor&r"
