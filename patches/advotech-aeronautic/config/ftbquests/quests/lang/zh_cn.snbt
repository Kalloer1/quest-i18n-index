	]
	quest.63BB0C81E7CF8B47.quest_subtitle: "我们又重新掌控了局面！"
	quest.63BB0C81E7CF8B47.title: "&8&l机械装置控制器&r"
	quest.63C0142611F27932.quest_desc: ["&dWixie Charm&r。一个能自动酿造药水的小女巫。终于，你不用再谷歌搜索&eFire Resistance&r的配方了。"]
	quest.63C0142611F27932.quest_subtitle: "神秘的女巫"
