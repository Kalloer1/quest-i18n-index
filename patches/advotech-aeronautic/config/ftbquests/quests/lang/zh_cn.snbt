	quest.6DCC5D179FCDD245.quest_desc: ["让方块四处走动。太可怕了。请&c不要给TNT添加动画&r。"]
	quest.6DCC5D179FCDD245.quest_subtitle: "它还活着！"
	quest.6DCC5D179FCDD245.title: "&e&l激活方块符文&r"
	quest.6DD050D0C3720655.quest_desc: [
