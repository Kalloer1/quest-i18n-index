	quest.5486D1F3633D887E.quest_desc: [
		"描述：完全分子湮灭。将原矿石浸入硫酸中，使其完全熔化为气态浆料。"
		""
		"技术信息：5x 矿石加工的开始。将 1 单位原矿转化为 1000mB 的脏矿浆。"
		""
		"用法：需要庞大的工业设施来生产运行此机器所需的硫酸。"
		""
		"目标：制作一个化学溶解室。"
		""
		"提示：在拥有强大的发电能力和完善的燃气网络之前，请勿尝试5倍处理。"
		""
		"小知识：这代表了现实世界化学提取技术的最高水平。"
	]
	quest.5486D1F3633D887E.quest_subtitle: "&e溶解的矿石"
	quest.5486D1F3633D887E.title: "化学溶解室"
