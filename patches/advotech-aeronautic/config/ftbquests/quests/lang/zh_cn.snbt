	quest.79D04ABDBB4B0DB7.title: "玫瑰金种子"
	quest.79F4137B3D67AF16.quest_desc: [
		"&7当你的反应堆燃烧 Yellorium 时，它会输出"
		"将&3青金石&7放入输出端口。"
		""
		"&a收好这个！它剧毒无比，但绝对是"
		"&a中后期游戏进程的必需品。"
	]
	quest.79F4137B3D67AF16.quest_subtitle: "&7不要把这个扔掉。"
	quest.79F4137B3D67AF16.title: "&3&l放射性废料"
	quest.7A16B12407FA49C9.title: "第一步"
	quest.7A1B2C3D4E5F6000.quest_desc: [
		"&7欢迎来到&cMekanism: Elements&7！"
		""
		"&7原版Mekanism还不够复杂？现在你得从海洋中提取微量元素，从大气中窃取气体，还要玩弄真正的硝酸了。"
		""
		"&c尽量不要让自己发生变异。&7"
	]
	quest.7A1B2C3D4E5F6000.quest_subtitle: "科学，但更难了"
	quest.7A1B2C3D4E5F6000.title: "&b&l欢迎来到元素世界&r"
	quest.7A1B2C3D4E5F6001.quest_desc: [
		"&7从未如此工业化地吸走大气中的生命气息。"
		""
		"&7Build an &bAir Compressor&7 to compress ambient air. Your neighbors won't mind the noise, probably."
	]
	quest.7A1B2C3D4E5F6001.quest_subtitle: "大气盗窃事件"
	quest.7A1B2C3D4E5F6001.title: "&e&l空气操控&r"
	quest.7A1B2C3D4E5F6002.quest_desc: [
		"&7Run the compressed air through the &eAdsorption Separator&7 to rip the &aNitrogen&7, &bOxygen&7, and &dArgon&7 right out of it."
		""
		"&7这就像呼吸一样，不过是机器在呼吸。"
	]
	quest.7A1B2C3D4E5F6002.quest_subtitle: "气体切割机"
	quest.7A1B2C3D4E5F6002.title: "&e&l吸附分离机&r"
	quest.7A1B2C3D4E5F6003.quest_desc: [
		"&7Mix your hard-earned Nitrogen with Hydrogen to make &aAmmonia&7."
		""
		"&7它不仅比乙烯燃烧得更旺，你的喷气背包现在还能用武器级玻璃清洁剂运行！燃烧速度是原来的&l5倍慢&r，垂直推力乘数则为&l1.5倍&r。"
	]
	quest.7A1B2C3D4E5F6003.quest_subtitle: "武器化的窗户清洁器"
	quest.7A1B2C3D4E5F6003.title: "&a&l臭烘烘的飞行&r"
	quest.7A1B2C3D4E5F6004.quest_desc: [
		"&7Mix Ammonia, Oxygen, and Water Vapor to create &cNitric Acid&7."
		""
		"&7要这高腐蚀性噩梦流体干嘛？因为它能真正&e无害化处理核废料&7！终于，你的地下室不再堆满发光的绿桶了。"
	]
	quest.7A1B2C3D4E5F6004.quest_subtitle: "将你的烦恼都融化掉，不留下一丝痕迹"
	quest.7A1B2C3D4E5F6004.title: "&c&l酸性废物处理&r"
	quest.7A1B2C3D4E5F6005.quest_desc: [
		"&7Combine Nitric Acid and Ammonia to create &cAmmonium Nitrate&7."
		""
		"&7这个配方能让你用8倍的效率制作TNT和烟花火箭。服务器管理员绝对爱死这个简单的小技巧了。"
	]
	quest.7A1B2C3D4E5F6005.quest_subtitle: "巨大的爆炸声响起"
	quest.7A1B2C3D4E5F6005.title: "&c&l爆炸倾向&r"
	quest.7A1B2C3D4E5F6006.quest_desc: [
		"&7Extracting &dXenon&7 from Argon."
		""
		"&7惰性气体以懒惰著称，不愿与任何物质反应。尽管如此，还是要强迫它们为你效力。"
	]
	quest.7A1B2C3D4E5F6006.quest_subtitle: "惰性气体"
	quest.7A1B2C3D4E5F6006.title: "&d&l崇高的野心&r"
	quest.7A1B2C3D4E5F6007.quest_desc: ["&7注射&d氙气&7，在服务器卡顿期间安然入睡。提供极高的伤害减免。"]
	quest.7A1B2C3D4E5F6007.quest_subtitle: "午睡时间到了"
	quest.7A1B2C3D4E5F6007.title: "&d&l麻醉剂&r"
	quest.7A1B2C3D4E5F6008.quest_desc: [
