	quest.0F1A91131FB40641.title: "&b黑曜石熔炉"
	quest.0F2772FD08CEEBC0.quest_desc: ["&b程序员&r让你用方块谜题来编程无人机！"]
	quest.0F383CC15654A0F1.quest_desc: ["将2种化学物质合并为1种，希望它们不会因为一点小分歧就分离开来……"]
	quest.0F383CC15654A0F1.quest_subtitle: "一场出于必要而结合的婚姻"
	quest.0F383CC15654A0F1.title: "合并中"
	quest.0F3A6DBAE66E8E86.quest_desc: ["将 &85 个脏土块&r 富集成 &e5 个干净土块&r。"]
	quest.0F3A6DBAE66E8E86.quest_subtitle: "清洁 x5"
