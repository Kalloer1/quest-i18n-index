	quest.7AEC615CA22DC5F7.title: "&6模块吸入净化装置"
	quest.7AF716D795AD7224.quest_desc: [
		"使用 &f铁&r 和 &7焦煤&r 来生产 &8钢&r 和 &c炉渣&r。"
		""
		"因为是基础版，你根本&c无法用漏斗自动化&r。接下来的五个小时，好好享受照顾这个3x3x3的砖块加热器吧。"
	]
	quest.7AF716D795AD7224.quest_subtitle: "这里变得越来越热了"
	quest.7AF716D795AD7224.title: "&c&l原始高炉&r"
	quest.7AFD7448B39763EE.quest_desc: [
		"&a升级到&9硬化热能发电机&a。"
		"&7更高效的将热能转化为电能。"
		"&7考虑使用压缩冰作为冷却剂，用于"
		"&7一个显著的加成。"
