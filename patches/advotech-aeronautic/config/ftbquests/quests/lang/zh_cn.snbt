	quest.7AD303F750E3837B.quest_subtitle: "&7批量存储系统"
	quest.7AD303F750E3837B.title: "箱子"
	quest.7AD9D28587F43CE0.quest_desc: ["用剪刀魔法地剪羊毛。因为用铁工具点它们显然&e太难了&r。"]
