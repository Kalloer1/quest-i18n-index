	quest.5F950149100F5FFA.quest_subtitle: "&7AllTheModium"
	quest.5F950149100F5FFA.title: "&6Allthemodium 胡萝卜"
	quest.5F9EA56031A35021.quest_desc: [
		"&7珍贵的宝石——镶嵌、合成，或是收藏起来。&r"
		""
		"&8种植你的资源。 &dMystical Agriculture&7 种植矿工挖掘的作物。&r"
