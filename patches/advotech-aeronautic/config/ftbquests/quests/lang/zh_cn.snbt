	quest.5619FCF1BCB73C4F.title: "&7&l破坏符文&r"
	quest.5621A2A33355D290.quest_desc: [
		"你玩完了普通Mekanism，心想“这还远远不够微合成！”"
		""
		"欢迎来到&cMekanism: Extras&r。准备好你的存储系统，因为这里的材料成本完全失控了。"
	]
	quest.5621A2A33355D290.quest_subtitle: "准备好你的理智值吧"
	quest.5621A2A33355D290.title: "&4&l真正的终局&r</c2></c1>"
	quest.56252B504FE87E25.quest_desc: [
		"&b无瑕的力量。&r"
		""
		"&7一种高级发电机，能够维持中大型机器装置。它能从标准燃料中提取惊人的能量。"
	]
	quest.56252B504FE87E25.quest_subtitle: "高级能量源"
	quest.56252B504FE87E25.title: "&b&l钻石生成器&r"
	quest.562BBB6BB4CD26C1.quest_desc: [
		"&6The high point of this chapter.&r"
		""
		"制作或获取 &6Glow Module&r。"
		"升级模块。将它们放入插槽中，无需重建整个装置，即可将普通机器升级为高速机器。"
		"&7Modular Force Field System&r 进阶路线的一部分。"
		"&8这不再影响后续步骤——想建的时候再建，而不是被迫去建。"
	]
	quest.562BBB6BB4CD26C1.quest_subtitle: "&7Modular Force Field System"
	quest.562BBB6BB4CD26C1.title: "&6发光模块"
	quest.562F04084E28994D.quest_desc: [
		"一个庞大而贪婪的怪物，能瞬间熔炼矿石，秒制钢铁，还能将&a无用的盔甲和工具回收&r成锭。"
		""
		"请勿用它来加热你的口袋食物。"
	]
	quest.562F04084E28994D.quest_subtitle: "超级熔炉！"
	quest.562F04084E28994D.title: "&c&l电弧炉&r"
	quest.563A4339263115A5.quest_desc: ["更多能让你字面意义上无敌的整合护甲。这个整合包的平衡性已经正式&c不复存在&r了。"]
