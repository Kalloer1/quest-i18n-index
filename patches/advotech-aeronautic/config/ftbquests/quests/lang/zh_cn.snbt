	quest.63CF44B2762D079F.quest_desc: [
		"&6The high point of this chapter.&r"
		""
		"制作或获取 &6Module Hydraulic Propulsion Unit&r。"
		"升级模块。将它们放入插槽中，无需重建整个装置，即可将普通机器升级为高速机器。"
		"&7Mekanism&r 进阶流程的一部分。"
		"&8这不再影响后续步骤——想建的时候再建，而不是因为必须建。"
	]
	quest.63CF44B2762D079F.quest_subtitle: "&7Mekanism"
	quest.63CF44B2762D079F.title: "&6模块：液压推进单元"
	quest.63CF68F01DDA2D46.quest_desc: ["&d1024k Storage&r。一百万个物品。谁有一百万个物品？哦，是你，因为你的&ecobblestone generator&r从第二天起就没停过。"]
	quest.63CF68F01DDA2D46.quest_subtitle: "&7额外存储空间"
	quest.63CF68F01DDA2D46.title: "&d&l1024k 存储组件&r"
	quest.63DD00B99CA27985.quest_desc: [
		"本章的故事将从这里开始。"
		""
		"击败&6Slay the Mimic&r。这可不是靠合成就能过去的——带上你最好的装备，做好在战斗中损失一套装备的准备。"
		"&8下一个：拟态帽、幸运围巾、挖掘爪。"
	]
	quest.63DD00B99CA27985.quest_subtitle: "&c一场战斗，而非配方"
	quest.63DD00B99CA27985.title: "&6击杀拟态怪 (Mimic)</c1>"
	quest.63E7068B0BBB140E.quest_desc: [
		"提高你风扇的&e范围&r和&b速度&r。"
		""
		"Now you can launch skeletons across the room like &7bony projectiles&r. It's highly entertaining."
	]
	quest.63E7068B0BBB140E.quest_subtitle: "工业吹制工艺"
	quest.63E7068B0BBB140E.title: "&3&l风洞升级&r"
	quest.63E74940DB1EFDD8.quest_desc: [
		"我收集的奥术水晶在黑暗中低语，那是一种等待释放的隐秘光芒的韵律。我想知道：如果光是灵魂的呼吸，我能否让它闪耀得更亮？"
		""
		"借助&dLamplighter’s Tongs&r，这一愿景得以实现。一手持钳，一手持晶，光芒渐深，晶体化为Mote，一团悬浮的灵光余烬。"
		""
		"这些光点会随放置处漂流，散发着宁静而永恒的光芒。它们证明了，即便是最微小的火花，也能被教会去铭记太阳。"
	]
	quest.63E74940DB1EFDD8.quest_subtitle: "即便是最微弱的光芒，也渴望被看见。"
	quest.63E74940DB1EFDD8.title: "&d尘埃制作&r"
	quest.63EF4B4AC541CCC0.quest_desc: ["&e硬化熔炉&r。燃料更耐用，但在&c21世纪&r用固体燃料还是感觉很脏。"]
	quest.63EF4B4AC541CCC0.title: "&e&l硬化熔炉器&r"
