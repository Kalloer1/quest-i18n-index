		""
		"制作或获取 &6堆叠升级第6级&r。"
		"升级模块。将它们放入插槽中，无需重建整个装置，即可将普通机器升级为高速机器。"
		"&7Sophisticated Storage&r 进阶流程的一部分。"
		"&8这不再影响后续步骤——想建的时候再建，而不是被迫去建。"
	]
	quest.6DB924C2ADB54C6B.quest_subtitle: "&7Sophisticated Storage"
	quest.6DB924C2ADB54C6B.title: "&6堆叠升级第6级"
	quest.6DB9CBB39E7333D1.quest_desc: [
		"自动化之前，你需要先处理基础材料。"
		""
		"将铜粉和锡粉结合，熔炼出第一块&6青铜锭&r。青铜是你通往蒸汽时代的钥匙！"
	]
	quest.6DB9CBB39E7333D1.quest_subtitle: "你的第一块合金"
	quest.6DB9CBB39E7333D1.title: "&6Bronze Age Begins"
	quest.6DBE719564FADF81.quest_desc: [
		"安装在移动装置上时，它会&b挖掘前方方块&r。"
		""
		"非常适合不小心摧毁自己基地的时候用。"
	]
	quest.6DBE719564FADF81.quest_subtitle: "钻头麦克格里尔博士"
