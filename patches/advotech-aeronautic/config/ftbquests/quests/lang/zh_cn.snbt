	quest.5177F2572AAF8BCE.quest_subtitle: "&7科技的粘合剂。"
	quest.5177F2572AAF8BCE.title: "&8&l介电基座 Dielectric Foundation"
	quest.519B6CD5483BDA32.quest_desc: [
		"&7在匹配的浸渍土上种植，即可无需操作地收获该资源。&r"
		""
