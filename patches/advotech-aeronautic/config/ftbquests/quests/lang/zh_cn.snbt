		"&7Hostile Neural Networks&r 进度的一部分。"
		"&8要么接受，要么拒绝——下一章将在别处继续。"
	]
	quest.6D3C748EFCACEC75.quest_subtitle: "&7敌对神经网络 (Hostile Neural Networks)"
	quest.6D3C748EFCACEC75.title: "&6预测"
	quest.6D6691DB2BB8DD7E.quest_desc: [
