	quest.349255D0F067697D.title: "Imperium Ingot"
	quest.3496706FD46BDD7B.quest_desc: [
		"看...你可以搭建一条庞大而复杂的流水线，用激光和钻头来制造PCB。"
		""
		"或者，你也可以找个机械村民，用&a绿宝石&r付钱。我们都知道你会选哪个。懒鬼。"
	]
	quest.3496706FD46BDD7B.quest_subtitle: "致以我们的问候！"
	quest.3496706FD46BDD7B.title: "&a&l资本主义解决一切&r"
	quest.349BF9AEABFD6FC2.quest_desc: [
		"&7这是你的&dMystical Agradditions&7设置的基础模块——你肯定需要不止一个。&r"
		""
		"&8&dAgradditions&7 系列 — Insanium 及更高阶，专为终极农场主打造。&r"
	]
	quest.349BF9AEABFD6FC2.quest_subtitle: "勇往直前，不断向上"
	quest.349BF9AEABFD6FC2.title: "Insanium 苹果"
	quest.34A7155DA34FCA7F.quest_desc: ["&6烈焰反应堆&r。36个烈焰方块。你杀掉的&e烈焰棒&r数量已经让我感到担忧了。"]
	quest.34A7155DA34FCA7F.title: "&6&l烈焰反应堆&r"
	quest.34AE5C8D28991377.quest_desc: ["&7This mod (in addition to being &cAWESOME!!!&7 (like mr. Torgue said)) consumes so &asmall amount of energy&7 that advanced mekanism cables are enough to supply power to most machines (except mycelial reactor)"]
	quest.34AE5C8D28991377.quest_subtitle: "不要啊啊！我的宝……等等，我们其实没事的。"
	quest.34AE5C8D28991377.title: "&b进度标记器"
	quest.34AEEC21D37D362C.quest_desc: ["&8武器魔典&r会提供剑和斧的&5附魔&r。 \\n\\n大多是有助于击杀敌人的附魔！比如&5锋利度&f和&5火焰附加&r。 \\n&8弓箭魔典&r会提供远程武器，即弓和弩的&5附魔&r。 \\n\\n&5穿透&f、&5力量&f和&5击退&r！"]
	quest.34AEEC21D37D362C.title: "&8武器卷轴"
	quest.34B38BD4A3D44058.quest_desc: [
		"&6这才是值得为之努力的目标。&r"
		""
		"制作或获取&6Book of Shadows Altar&r。"
		"仪式组件。它们缓慢、庄重，通常用于开启无法通过其他方式获得的物品。"
		"&7Hexerei&r 进阶的一部分。"
		"&8这不再影响后续步骤——想建的时候再建，而不是因为必须建。"
	]
	quest.34B38BD4A3D44058.quest_subtitle: "&7Hexerei"
	quest.34B38BD4A3D44058.title: "&6暗影之书祭坛"
	quest.34BACC98EDAD8981.quest_desc: ["更多能让你字面意义上无敌的整合护甲。这个整合包的平衡性已经正式&c不复存在&r了。"]
	quest.34BACC98EDAD8981.quest_subtitle: "神祇睡衣"
	quest.34BACC98EDAD8981.title: "&d&lUnobtainium Mage Leggings&r"
	quest.34C1430DEB334137.quest_desc: [
		"一个巨大的旋转死亡碗。"
		""
		"它能将矿石磨成粉，粉碎烈焰棒，如果&c生物和玩家&r掉进去，绝对会被撕成碎片。小心脚下。"
	]
	quest.34C1430DEB334137.quest_subtitle: "粉碎！！！你的末日到了，就在现在"
	quest.34C1430DEB334137.title: "&8&l破碎机&r</c2></c1>"
	quest.34CE90D9FED228D9.quest_desc: [
		"比之前的版本有所提升的一步。"
		""
		"制作或获取 &6Allthemodium 剑&r。"
		"此阶的工具或武器。更远的射程、更快的速度，通常还有值得学习的特殊能力。"
		"&7AllTheModium&r 进度的一部分。"
		"&8一个分支任务。可选，但很少浪费时间。"
	]
	quest.34CE90D9FED228D9.quest_subtitle: "&7AllTheModium"
	quest.34CE90D9FED228D9.title: "&6Allthemodium 剑"
	quest.34D33C35B2A22209.quest_desc: [
		"&7你需要能量来创造能量。"
		""
		"&aCraft a &cFurnator&a (burns solid fuel like coal)"
		"&a或者一个&cMagmator&a（能燃烧像岩浆这样的液体燃料）。"
		"&a这些是你前期可靠的电力来源。"
	]
	quest.34D33C35B2A22209.quest_subtitle: "&7渴望力量的燃烧。"
	quest.34D33C35B2A22209.title: "&c&l早期生成物"
	quest.34DAE7A987595427.quest_desc: ["用工业液压机的力量来结合矿石。"]
	quest.34DAE7A987595427.quest_subtitle: "液压机"
	quest.34DAE7A987595427.title: "&6&l至尊合成工厂&r"
	quest.34E777BF619BC624.quest_desc: [
		"&6一个里程碑。&r"
		""
