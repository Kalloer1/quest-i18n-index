	quest.37AAE78F1DB28CAC.title: "&2&l基础控制电路&r"
	quest.37AB31F4CCB00A28.quest_desc: [
		"描述：将两种不同的气体结合成一种单一的高活性化合物。"
		""
		"技术信息：仅接受气体（需要 Pressurized Tubes）。不接受液体。"
		""
		"用途：用于混合二氧化硫和氧气以生成三氧化硫，是酸生产的关键步骤。"
		""
		"目标：制作一个化学注入器。"
		""
		"提示：气体网络可能难以可视化。将注料器放置在分离器/氧化器附近，以避免管道混乱。"
		""
		"小知识：攀登矿石倍增阶梯，突破2倍的关键。"
	]
	quest.37AB31F4CCB00A28.quest_subtitle: "&e化学注入 (Chemical Infusion)"
	quest.37AB31F4CCB00A28.title: "化学注入器"
	quest.37B0DD7A5C88DAEF.quest_desc: ["所有卷轴的基础。是时候为了甘蔗而进行大规模&a毁林&r了。"]
	quest.37B0DD7A5C88DAEF.quest_subtitle: "折纸（Origami）"
	quest.37B0DD7A5C88DAEF.title: "&f&l纸&r"
	quest.37BD7CE28F0BE7A6.quest_desc: ["探索《永恒之门》的奇妙之处，掌握其机制。"]
	quest.37BD7CE28F0BE7A6.title: "欢迎来到《通往永恒的门户》"
	quest.37F379D4A4C0E2EA.quest_desc: [
		"将灵魂注入精细织物，便可制成&d灵魂织物&r，一种具有超凡韧性的材料。它会随光线弯曲，握在手中时发出微弱的嗡鸣，仿佛在铭记着编织它的灵魂。"
		""
		"这种丝绸构成了马卢姆后期大部分人造物品的基底——可穿戴、可附魔，并与佩戴者的本质深度共鸣。请虔诚地对待它；它不仅是织物，更是被纺得极薄的记忆。"
	]
	quest.37F379D4A4C0E2EA.quest_subtitle: "由低语纺成的线，比钢铁的束缚更紧密。"
	quest.37F379D4A4C0E2EA.title: "&dSpirit Fabric&r"
	quest.37FAA69F6C4A5249.quest_desc: [
		"自动破坏方块。"
		""
		"非常适合自动化鹅卵石发电机，或者不小心挖掉自己的机器，当你用&c错误的方式&r面对它时。"
	]
	quest.37FAA69F6C4A5249.quest_subtitle: "自动破坏者"
	quest.37FAA69F6C4A5249.title: "&e&l破坏模块&r"
	quest.37FD1F6427B896BE.quest_desc: [
		"&7要达到发电的巅峰水平，"
		"&7你必须分裂原子。"
		""
		"&a挖掘&2铀矿石&a以收集所需材料"
		"&a用于 Powah 反应堆的燃料。"
		""
		"&7它生成在地下深处。带上好的镐子。"
