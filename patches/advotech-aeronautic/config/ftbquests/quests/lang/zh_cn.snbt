	quest.64A331A39085FAC6.title: "&5粉笔白杂质"
	quest.64A7E56F880B1C4D.quest_desc: ["&5Pressurized Spawner&r - 终极的刷怪工具。"]
	quest.64AE60C57DBAA2A8.title: "第一步：基础操作指南"
	quest.64B2DFE5C946A0E0.quest_desc: [
		"描述：在巨大压力下将原始元素锇强行融入其他材料中，使其硬化。"
		""
		"技术信息：使用液态锇（或通过内部缓冲器使用锇物品）来压缩物品。"
		""
		"用途：制作精制黑曜石粉尘和萤石锭所必需。"
		""
		"目标：制作一个锇压缩机。"
		""
		"提示：早期保持奥司米乌姆的供应可能很困难。请确保你的奥司米乌姆产量至少是2倍。"
		""
		"小知识：这是少数将标准金属锭视为化学溶剂的机器之一。"
	]
	quest.64B2DFE5C946A0E0.quest_subtitle: "&8锇压缩机"
	quest.64B2DFE5C946A0E0.title: "锇压缩机"
