	quest.7AFD7448B39763EE.quest_subtitle: "&7更高效的发热转换。"
	quest.7AFD7448B39763EE.title: "&9&lThermo Generator — 硬化版"
	quest.7AFDEBAFEBD0051B.quest_desc: [
		"会移动&e气体&r。"
		""
		"气体和液体一样，但它们更烦人，因为&c普通储罐装不下它们&r。"
	]
	quest.7AFDEBAFEBD0051B.quest_subtitle: "瓦斯面条"
	quest.7AFDEBAFEBD0051B.title: "&2&l基础加压管&r"
	quest.7B09435191E74D2D.quest_desc: ["Tick会加速方块。你的&eTPS下降&r就从这里开始。"]
	quest.7B09435191E74D2D.quest_subtitle: "快进时间，跳过漫长的等待过程。"
	quest.7B09435191E74D2D.title: "&e&l加速符文&r"
	quest.7B0D57E39B760F47.quest_desc: [
		"&7终极高能合金，能量满满！"
		""
