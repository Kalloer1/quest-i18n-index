	quest.5F2D59A5B2E8A95C.quest_subtitle: "&7Powah"
	quest.5F2D59A5B2E8A95C.title: "&b硬化型玩家发射器"
	quest.5F4459663704F3AB.title: "高级机械装置 (Advanced Mechanics)"
	quest.5F46031B1187857A.quest_desc: [
