	quest.641B2F78D08968CB.title: "&bFurnator Nitro"
	quest.6423B49FD30F0EBE.quest_desc: ["一个&e大型基础电容器&r。和普通电容器一样，只是……更大。超棒的模组设计。"]
	quest.6423B49FD30F0EBE.title: "&f&l大型基础电容器&r"
	quest.643154D3FB76A2AD.quest_desc: [
		"你以为本地的野生动物太容易对付了？那就来试试&6Mowzie's Mobs&r吧。"
		""
		"这些生物其实有复杂的攻击动画，所以不能光靠狂点左键就想赢。动动脑子吧。或者别动，然后反复死亡。随你选。"
	]
	quest.643154D3FB76A2AD.quest_subtitle: "左键点击在这里救不了你"
