	quest.1BAA437F5770BC74.title: "&b太阳能电池氮气加速"
	quest.1BAA894EE468E6A6.quest_desc: ["让你的恼人恼虫变得更&c恼人&r。"]
	quest.1BAA894EE468E6A6.quest_subtitle: "牙齿研磨器"
	quest.1BAA894EE468E6A6.title: "&8&lEvocation Upgrade Orb&r"
