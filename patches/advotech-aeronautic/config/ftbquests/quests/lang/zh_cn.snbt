	quest.4DA6CA19AD6974A3.title: "&e&l智能流体管道&r"
	quest.4DB76824CB026487.quest_desc: [
		"&7Connect your Reactor's Steam output to the Turbine"
		"&7使用&bTurbine Fluid Ports&7。"
		""
		"&a你还需要一个流体端口来输出水"
