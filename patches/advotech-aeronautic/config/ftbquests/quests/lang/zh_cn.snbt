	quest.644ED29ABB9DFF33.quest_desc: [
		"描述：捕捉大气气流，驱动涡轮机持续发电。"
		""
		"技术信息：必须有清晰天空的视野。产出会随着放置高度的增加而提高。"
		""
		"用法：放置在最大建造高度，可获得大量早期/中期游戏被动力量。"
		""
		"目标：制作一台风力发电机。"
		""
		"提示：将电缆从建造限制向下连接到基地，即可获得完全免费、无需维护的能源。"
		""
		"小知识：旋转刀刃的动画实际上会根据生成速率而加速！"
	]
