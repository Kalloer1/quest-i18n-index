	quest.519C6E8B455FFFB5.quest_subtitle: "&7硅基印刷术"
	quest.519ECE89F101F355.quest_desc: ["Tier 3 合成台可一次性存放多达 &a8 个配方&r，非常适合复杂的、多步骤的合成设置。"]
	quest.519ECE89F101F355.quest_subtitle: "&7终极自动合成器 Ultimate Auto-Crafting"
	quest.519ECE89F101F355.title: "&c三级合成台"
	quest.51A64468888140B6.title: "第一步"
	quest.51BE5956F0051B12.quest_desc: [
		"&3海洋的恐怖统治者。"
		"&7斯库拉不原谅任何失误。击败她，证明你在海上的统治地位。"
	]
	quest.51BE5956F0051B12.quest_subtitle: "&c一场战斗，而非配方"
	quest.51BE5956F0051B12.title: "&b&l斯库拉"
	quest.51DB0E78FC0863FD.quest_desc: [
		"第一次就得做好，不然以后重做会很麻烦。"
		""
		"制作或获取&bAugment Speed&r。"
		"升级模块。将它们放入插槽中，无需重建整个装置，即可将普通机器升级为高速机器。"
		"&7Iron Furnaces&r 进阶流程的一部分。"
		"&8要么接受，要么拒绝——下一章将在别处继续。"
	]
	quest.51DB0E78FC0863FD.quest_subtitle: "&7铁质熔炉"
	quest.51DB0E78FC0863FD.title: "&b速度增强器"
	quest.51DB1390B90034D2.quest_desc: ["&b初级魔法书&r能让你施放1阶魔法。组合形态和效果，释放你的第一个魔法！"]
	quest.51DB1390B90034D2.quest_subtitle: "你算半个巫师了，勉强算上"
	quest.51DB1390B90034D2.title: "&d&l新手魔法书&r"
	quest.51E0FCCD14BDF4A4.quest_desc: ["刷怪符文用于制作各种修改刷怪器的物品。更强大的修改则需要附魔刷怪符文。\\n\\n我们需要至少 &a70 Eterna&r、&c30% Quanta&r 和 &550% Arcana&r。\\n\\n为此，我们可以使用以下任一方法：\\n\\n14 个非 &9Dormant&r 的 &9Deepshelves&r！\\n12 个 &4Glowing Hellshelves&r 和 2 个 &9Deepshelves&r！\\n12 个 &bCrystalline Seashelves&r 和 2 个 &9Deepshelves&r！"]
	quest.51E0FCCD14BDF4A4.title: "&d&l注入&r刷怪符文"
	quest.51E32E5ED0068C22.quest_desc: [
		"第一次就得做好，不然以后重做会很麻烦。"
		""
		"制作或获取 &bFocus Matrix&r。"
		"魔法指令。每个指令都能扩展你的施法配置能力，并且能以模组从未明确记录的方式相互结合。"
		"&7Modular Force Field System&r 进阶路线的一部分。"
		"&8要么接受，要么拒绝——下一章将在别处继续。"
	]
	quest.51E32E5ED0068C22.quest_subtitle: "&7Modular Force Field System"
	quest.51E32E5ED0068C22.title: "&b聚焦矩阵"
	quest.51EB63A6A6C50D29.quest_desc: [
		"将 &bSU&r 输入到需要它的机器中。如果你懂齿轮的工作原理，还能改变转速。"
		""
		"剧透：你可能并不想这么做就是了。"
	]
	quest.51EB63A6A6C50D29.quest_subtitle: "无聊的齿轮模组 Gears of bore"
	quest.51EB63A6A6C50D29.title: "&6&l齿轮&r"
	quest.51ED629FE0EA3505.quest_desc: [
		"&6压轴石。在此之前的一切都是铺垫。&r"
		""
		"制作或获取 &6Vibranium Block&r。"
		"上层级的原材料。越早实现自动化生产，消耗它的配方就越早不再成为瓶颈。"
		"&7AllTheModium&r 进度的一部分。"
