	quest.5022377093C26A1C.quest_desc: [
		"&6这才是值得为之努力的目标。&r"
		""
		"制作或获取 &6Anti Spawn Module&r。"
		"升级模块。将它们放入插槽中，无需重建整个装置，即可将普通机器升级为高速机器。"
		"Part of the &7Modular Force Field System&r progression."
		"&8这不再影响后续步骤——想建的时候再建，而不是被迫去建。"
	]
	quest.5022377093C26A1C.quest_subtitle: "&7Modular Force Field System"
	quest.5022377093C26A1C.title: "&6反生成模块"
	quest.504549E2A6A5A66E.quest_desc: [
