	quest.5B1D47DBC08CB066.title: "&6收集模块"
	quest.5B1FFF4DD0FA67A0.quest_desc: ["用于建造火车站和组件的建筑材料。"]
	quest.5B1FFF4DD0FA67A0.quest_subtitle: "收集木材以制作火车"
	quest.5B1FFF4DD0FA67A0.title: "&e&l铁路外壳&r"
	quest.5B2B28814698DC95.quest_desc: ["&c瞬间杀死工作半径内的任何生物/动物&7，将其转化为&a经验值&7和&e物品&7。可禁用经验值收集以增加机器的&6战利品&7"]
	quest.5B2B28814698DC95.quest_subtitle: "你们这些血眼生物都给我待着别动！"
	quest.5B2B28814698DC95.title: "&c放我们进去，磨粉机！我们要把你们全部杀光！"
	quest.5B3D4C82E3F9711A.quest_desc: ["&7气动冲击钻&r能瞬间开采大片区域。"]
	quest.5B65C42F19465DAA.quest_desc: [
		"稳步前进。这一步并不华丽，但没有它，本章就无法完成。"
		""
		"制作或获取 &bSolar Panel Blazing&r。"
		"它靠日光获取能量。无需燃料补给，无需维护，只需要地面空间和开阔的天空视野。"
		"&7Powah&r 进阶的一部分。"
		"&8下一个：Solar Panel Niotic。"
	]
	quest.5B65C42F19465DAA.quest_subtitle: "&7Powah"
	quest.5B65C42F19465DAA.title: "&b太阳能板与烈焰人"
	quest.5B6710F3C5ABEC65.quest_desc: [
		"铺平天堂，建起停车场。"
		""
		"走在&7沥青&r上能将移动速度提高20%。非常适合用来逃避环境责任。"
