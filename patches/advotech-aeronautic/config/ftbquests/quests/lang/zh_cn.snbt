	quest.72EAB92AB1EB5A7C.title: "&b菌丝体口臭症"
	quest.72EC815A650AE398.quest_desc: ["在&l&2Frontier&r中，&e前缀&r的稀有度并不重要，但现在&l&eAscent&r中，所有物品都必须是&a不常见&r或以上。 \\n\\n你还需要击杀一个&4入侵者&r，即&6&lApothic&r首领，以提升你的&l世界等级&r。首领的&4稀有度&r并不重要！ \\n\\n&e前缀&r最多只会达到&5史诗&r，但现在&9稀有&r比其他的更常见。我们还可以获得&6神话&r&a宝石&r……但这需要幸运女神的青睐！ \\n\\n说到运气，我们的运气将提升至30%，经验值将跃升至55%，而&aMax Eterna&r将升至&a60&r。 \\n\\n作为回报，&4怪物&r现在将拥有8点护甲值和5点护甲穿透。"]
	quest.72EC815A650AE398.title: "&l世界层级：&e上升"
	quest.72FB30C6DF7AF901.quest_desc: [
		"&7一股黑暗的气息在世界中扎根……"
		""
		"&e恶魔般的克利福斯之树已经苏醒。"
		"&a准备好与终极邪恶势力展开一场战斗吧。"
	]
	quest.72FB30C6DF7AF901.quest_subtitle: "&7更进一步的一步"
	quest.72FB30C6DF7AF901.title: "&4&l克利波斯的苏醒"
	quest.72FD8EF56B4C33AE.quest_desc: [
		"描述：你的第一台真正机器。它通过注入次要物质来改变金属的分子结构。"
		""
		"技术信息：运行需要 FE（Forge 能量）。为注入材料（如红石）设有独立的内部缓冲区。"
		""
		"用法：将红石、煤炭、钻石或黑曜石粉放入次级槽位，将锭放入主槽位。"
		""
		"目标：制作一个冶金注入器。"
		""
		"提示：建造多个注入器。一个用于红石，一个用于碳，可防止缓冲器中的材料浪费。"
		""
		"小知识：冶金注入器是Mekanism中需求量最大的机器，因为其组件要求。"
	]
	quest.72FD8EF56B4C33AE.quest_subtitle: "&c冶金学灌注 (Metallurgic Infusion)"
	quest.72FD8EF56B4C33AE.title: "冶金学注入器"
