	quest.4DA576795CD3FE58.title: "&d&l终极安装器&r"
	quest.4DA6CA19AD6974A3.quest_desc: ["它有流体力学文凭。它能过滤液体，防止你把原油直接泵入饮用水箱。&e(再说一遍)&r。"]
