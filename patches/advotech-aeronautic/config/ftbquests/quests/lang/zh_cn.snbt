	quest.49732F097030B62B.quest_desc: ["&c快速生成&7（更像是刷出）生物，使用&e能量&7和&d液态肉&7。建议使用运输方式将两者输送给&6机械泥土&7以最大化产出。刷出的生物取决于&e光照&7和当前的&a生物群系&7（以及维度）。请注意，如果机械泥土没有获得：&e能量、肉、黑暗&7（或以上全部），它将&c不会刷出生物。&7"]
	quest.49732F097030B62B.quest_subtitle: "它们要来了"
	quest.49732F097030B62B.title: "&c你惊动了兽群，它们正在逼近！"
	quest.497529DBBD7634E8.quest_desc: [
		"&6一个里程碑。&r"
		""
		"制作或获取 &6Module Geiger Unit&r。"
		"升级模块。将它们放入插槽中，无需重建整个装置，即可将普通机器升级为高速机器。"
		"&7Mekanism&r 进阶流程的一部分。"
		"&8一个分支任务。可选，但很少浪费时间。"
	]
	quest.497529DBBD7634E8.quest_subtitle: "&7Mekanism"
	quest.497529DBBD7634E8.title: "&6盖革计数器模块单元"
	quest.4975C7CABFC7C10D.quest_desc: [
		"&7注入了恶魔力量的、会动的巨型护手。"
		"&4它在下界炽热的结构中等待着鲁莽的冒险者。"
	]
	quest.4975C7CABFC7C10D.quest_subtitle: "&6最高等级物品"
	quest.4975C7CABFC7C10D.title: "&c&l下界试炼场"
	quest.497965EC5407FD0A.quest_desc: [
		"不要舔。不要吞。在任何情况下都不可将其丢入水中。"
		""
		"其实，&c把它丢进水里&r。看看会发生什么。（法务部提示：我们不对肢体缺失负责）。"
	]
	quest.497965EC5407FD0A.quest_subtitle: "辛辣的鹅卵石。"
	quest.497965EC5407FD0A.title: "&f&l锂锭&r"
	quest.498CAEE6CFE6DC9C.quest_desc: ["此门仅用于开启海床或地狱床路径，同时强制触发 Apotheosis Gear 的前线世界层级任务。"]
	quest.498CAEE6CFE6DC9C.title: "一扇传送门"
	quest.49904911267E8303.quest_desc: ["当提供能量和消耗限制时，会产生大量热量。非常多的热量"]
	quest.49904911267E8303.quest_subtitle: "像火焰、地狱之火……"
	quest.49904911267E8303.title: "&6电阻加热器"
	quest.49967880EF2FF5C6.quest_desc: [
		"一旦&cDerrick&r排空了加压流体，井口就会停止喷发。"
		""
		"将&6Pumpjack&r放在同一个坑里，无情地吸干地下最后一滴油，直到地面完全干涸。"
	]
	quest.49967880EF2FF5C6.quest_subtitle: "正在努力挖掘中"
	quest.49967880EF2FF5C6.title: "&e&l抽油机&r</c2></c1>"
	quest.49A5842A8A9BE992.quest_desc: [
		"&7在匹配的浸渍土上种植，即可无需操作地收获该资源。&r"
		""
		"&8种植精华种子，收获整个世界——无需矿井的矿石农场。&r"
	]
	quest.49A5842A8A9BE992.quest_subtitle: "种植。收获。重复。"
	quest.49A5842A8A9BE992.title: "铝制种子"
	quest.49ABBF6A422C4F14.quest_desc: [
		"&6这才是值得为之努力的目标。&r"
		""
		"Craft or obtain the &6Module Locomotive Boosting Unit&r."
		"升级模块。将它们放入插槽中，无需重建整个装置，即可将普通机器升级为高速机器。"
		"&7Mekanism&r 进阶流程的一部分。"
		"&8要么接受，要么拒绝——下一章将在别处继续。"
	]
	quest.49ABBF6A422C4F14.quest_subtitle: "&7Mekanism"
	quest.49ABBF6A422C4F14.title: "&6模块机车助推单元"
	quest.49BAD3D066FC088B.quest_desc: [
		"&7精炼金属锭——工具、机器和合金的原材料。&r"
		""
		"&8种植精华种子，收获整个世界——无需矿井即可进行矿物采集。&r"
	]
	quest.49BAD3D066FC088B.quest_subtitle: "精炼完成，随时待命"
	quest.49BAD3D066FC088B.title: "Inferium 锭"
	quest.49C1928F1883A175.quest_desc: [
		"将核心固定在一起，防止其在服务器中猛烈地&c爆炸&r。"
		""
		"实际上，可能还是会的。祝你好运。"
	]
	quest.49C1928F1883A175.quest_subtitle: "结构完整性"
	quest.49C1928F1883A175.title: "&7&l反应堆框架&r"
	quest.49C3E622C7C80980.title: "高级机械装置 (Advanced Mechanics)"
	quest.49F4DE678217297C.quest_desc: [
		"&7头部防护，附带一点小惊喜。&r"
		""
		"&8Inferium 到 Insanium：将泥土变为 Allthemodium 的等级阶梯。&r"
	]
	quest.49F4DE678217297C.quest_subtitle: "用东西把头盖住"
