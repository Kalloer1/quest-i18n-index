	quest.513C011F8D6727BC.quest_subtitle: "&5核心组件"
	quest.514E234BBCFF5309.quest_desc: [
		"&e&l8x 力量！&r"
		""
		"&7既然可以压缩，何必建造一个满是发电机的巨大房间？这个升级后的方块发电量是其基础版本的&a8倍&7，为你节省宝贵的空间和布线成本。"
	]
	quest.514E234BBCFF5309.quest_subtitle: "8倍功率放大器"
	quest.515CDFA79AF74FA3.quest_desc: [
		"&7将开采的矿石粉碎成粉尘！"
		""
		"&b提示：&7这能让你单次采矿获得的材料大大增加。"
	]
	quest.515CDFA79AF74FA3.title: "&9粉碎机 (Pulverizer)"
	quest.516A8D5A1B40907E.quest_desc: [
		"&7挥舞着冰魔法和幻影的亡灵。"
		"&c你可以在主世界寒冷生物群系的稀有塔顶找到他。"
	]
	quest.516A8D5A1B40907E.quest_subtitle: "&7更进一步的一步"
	quest.516A8D5A1B40907E.title: "&b&l夜之巫妖"
	quest.516C39A894BE2754.quest_desc: [
		"描述：专门用于传导热能的铜合金电缆，导热性能极佳。"
		""
		"技术信息：热量传输，Mekanism 的一个独特变量。"
		""
		"用法：将加热器连接到热蒸发装置或锅炉上。"
		""
		"目标：制作热力学导体。"
		""
		"提示：热量会随距离衰减。尽可能将热源靠近目标放置。"
		""
		"小知识：它们在传输大量热量时会物理性地发红发热。"
	]
	quest.516C39A894BE2754.quest_subtitle: "&c热能运输系统"
	quest.516C39A894BE2754.title: "热力物流系统"
	quest.5177F2572AAF8BCE.quest_desc: [
		"&7Every single machine and component in Powah"
		"&7需要这个特定的粘贴配方。"
		""
		"&aCraft a healthy amount of &8Dielectric Paste&a."
		"&a你需要用它来制作棒、外壳和"
