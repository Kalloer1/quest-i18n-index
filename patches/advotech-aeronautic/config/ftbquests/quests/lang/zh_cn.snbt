	quest.625B2D03445F094A.title: "&b介电浆料"
	quest.62954365423D1216.quest_desc: ["在地板上画了一个魔法陷阱。小心别踩到它&e自己&r。"]
	quest.62954365423D1216.quest_subtitle: "踩到裂缝上……就会倒霉一辈子……"
