	quest.0F401394EE48EEDF.quest_desc: [
		"&7头部防护，附带一点小惊喜。&r"
		""
		"&8种植你的资源。 &dMystical Agriculture&7 种植矿工挖掘的作物。&r"
	]
	quest.0F401394EE48EEDF.quest_subtitle: "用东西把头遮住，不然会死。"
