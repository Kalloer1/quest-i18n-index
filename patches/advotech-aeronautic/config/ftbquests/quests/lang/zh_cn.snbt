	quest.5BD6BFF00D7480A9.title: "&c&l精英破坏者&r"
	quest.5BE6823E19B4DD76.quest_desc: ["&aplant sower&7 可在一定半径内种植作物、灌木和树苗。输入可设置和锁定。也可通过菜单左侧的 &dcolorful grid&7 选择已设置作物的位置"]
	quest.5BE6823E19B4DD76.quest_subtitle: "让地球再次变绿"
	quest.5BE6823E19B4DD76.title: "&a嗨，大家好！在今天的这一集里，我们要种一大堆植物！"
	quest.5C00DD4B6F9EC587.quest_desc: [
