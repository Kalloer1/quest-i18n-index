	quest.3B2A000000000230.title: "&6堆叠升级：欧米茄级"
	quest.3B2A000000003001.quest_desc: ["基础流体存储单元。与Storage Housing结合，即可创建一个功能性磁盘。"]
	quest.3B2A000000003010.quest_desc: ["超大容量流体存储。比你需要的更多桶。"]
	quest.3B2A000000004001.quest_desc: ["允许你在网络中数字化存储原始Forge能量（FE）。"]
	quest.3B2A000000004010.quest_desc: ["终极的储能方案！这个磁盘可以储存无限量的Forge能量。"]
	quest.3B2A000000005001.quest_desc: ["允许你的 Refined Storage 网络直接存储 Mekanism 化学品。"]
	quest.3B2A000000006001.quest_desc: ["允许你的 Refined Storage 网络存储 Source（来自 Ars Nouveau）。"]
	quest.3B33F047BCC58BEF.quest_desc: [
		"一个用于烈焰人的笼子。"
		""
		"去找到一个下界堡垒，右键点击烈焰人，然后把它塞进箱子里。别担心，烈焰人很喜欢不费吹灰之力就能得到的免费食物！"
	]
	quest.3B33F047BCC58BEF.quest_subtitle: "薛定谔的燃烧器"
	quest.3B33F047BCC58BEF.title: "&8&l空烈焰燃烧器&r"
	quest.3B4DAAFDC1B4B6C6.quest_desc: [
		"前一步骤的自然延续。"
		""
		"制作或获取 &bEnder Gate Hardened&r。"
		"机器链的又一块组件。单独作用不大，接入工厂的其他部分后，又能减少一项手动操作。"
		"&7Powah&r 进阶的一部分。"
		"&8下一个：末地传送门烈焰人。"
	]
	quest.3B4DAAFDC1B4B6C6.quest_subtitle: "&7Powah"
	quest.3B4DAAFDC1B4B6C6.title: "&b硬化末地传送门方块"
	quest.3B4FBBFCAA2EB992.quest_desc: [
		"末影人很烦人。它们会从你精心设计的陷阱里传送出去。"
		""
		"把这个小方块藏到地板下，他们的传送权限就立刻被撤销了。欢迎来到搅拌机，高个子。"
	]
	quest.3B4FBBFCAA2EB992.quest_subtitle: "无处可逃"
	quest.3B4FBBFCAA2EB992.title: "&5&l末地抑制器&r"
	quest.3B699771827002DC.quest_desc: ["投掷物品。字面意思就是按 &eQ&r，但会消耗法力。"]
	quest.3B699771827002DC.quest_subtitle: "YEET"
	quest.3B699771827002DC.title: "&c&l投掷符文&r"
	quest.3B6D17DF6D0364D9.quest_desc: ["把它扔向你的烦恼，希望它们能神奇地消失。"]
	quest.3B6D17DF6D0364D9.quest_subtitle: "便携式、爆炸性能源。"
	quest.3B6D17DF6D0364D9.title: "&c&l锂充电&r"
	quest.3B99ABCCF42B31D9.quest_desc: ["使法术持续时间更长。现在你被困在一个魔法泡泡里，持续 &e10 分钟&r。"]
	quest.3B99ABCCF42B31D9.quest_subtitle: "超时工作会导致疲劳度上升，请注意休息。"
	quest.3B99ABCCF42B31D9.title: "&a&l时间延长符文&r"
	quest.3B9BFAE88E280B9F.quest_desc: [
		"前一步骤的自然延续。"
		""
		"制作或获取 &7基础化学储罐&r。"
		"流体批量存储。缓冲流体可以防止上游产量下降时导致生产线卡顿。"
		"&7Mekanism&r 进阶流程的一部分。"
		"&8下一个：同位素离心机。"
	]
	quest.3B9BFAE88E280B9F.quest_subtitle: "辛辣酥脆"
	quest.3B9BFAE88E280B9F.title: "&7基础化学储罐"
	quest.3B9C369BDF145675.quest_desc: [
		"&7电缆、线圈和电机是关键合成组件。"
		""
		"&7建造强大的工厂之前，你必须先掌握这些基础电子元件的生产。"
	]
	quest.3B9C369BDF145675.title: "&e基本组件"
	quest.3BE9CB4721F35976.quest_desc: [
		"&6The high point of this chapter.&r"
		""
		"制作或获取 &6Module Solar Recharging Unit&r。"
		"它靠日光获取能量。无需燃料补给，无需维护，只需要地面空间和开阔的天空视野。"
		"&7Mekanism Generators&r 进阶流程的一部分。"
		"&8要么接受，要么拒绝——下一章将在别处继续。"
	]
	quest.3BE9CB4721F35976.quest_subtitle: "&7Mekanism 发电机"
	quest.3BE9CB4721F35976.title: "&6模块太阳能充电单元"
	quest.3BF312BE37759858.quest_desc: [
		"前一步骤的自然延续。"
		""
		"击败&cSlay the Draconic Guardian&r。这无法通过合成来绕过——带上你最好的装备，并准备好在战斗中损失一套装备来学习技巧。"
		"&8下一个：混沌碎片。"
	]
	quest.3BF312BE37759858.quest_subtitle: "&c一场战斗，而非配方"
	quest.3BF312BE37759858.title: "&c击杀龙之守护者"
	quest.3BFD480E65B4C945.quest_desc: [
		"从这里开始，章节内容会变得更加广阔。"
		""
		"制作或获取 &7末地传送门启动器&r。"
		"机器链的又一块组件。单独作用不大，接入工厂的其他部分后，又能减少一项手动操作。"
		"&7Powah&r 进阶的一部分。"
		"&8下一个：基础末地传送门，能量棒入门。"
	]
	quest.3BFD480E65B4C945.quest_subtitle: "&7Powah"
	quest.3BFD480E65B4C945.title: "&7末地传送门启动器"
	quest.3C08195B48DDCCDD.quest_desc: [
		"第一次就得做好，不然以后重做会很麻烦。"
		""
		"制作或获取 &5Magic Lamp Empty&r。"
		"缓慢的仪式魔法。节奏沉稳，回报值得期待。"
		"&7Occultism&r 进阶的一部分。"
		"&8这条分支的尽头。"
	]
	quest.3C08195B48DDCCDD.quest_subtitle: "&7Occultism"
	quest.3C08195B48DDCCDD.title: "&5魔法灯（空）"
	quest.3C09F20961E63A27.quest_desc: [
		"&7Combine chemical gases at an &eunmatched rate&7."
		""
		"&7这个巨大的&6Infuser&7是高端燃料生产和高级矿石加工所必需的。只要确保你有足够的管道来跟上节奏！"
	]
	quest.3C09F20961E63A27.quest_subtitle: "批量灌注 (Bulk Infusion)"
	quest.3C09F20961E63A27.title: "&6大型化学注入器"
	quest.3C30B015A7ADEB3C.quest_desc: ["只会攻击空中的生物。接招吧，&e幻影&r。"]
	quest.3C30B015A7ADEB3C.quest_subtitle: "防空防御系统"
	quest.3C30B015A7ADEB3C.title: "&f&l空中过滤符文&r"
	quest.3C32F5DA6513BBC9.quest_desc: [
		"描述：最原始的发电形式，将热能直接转化为可用电压。"
		""
		"技术信息：可燃烧固体燃料（煤炭、木材）或在岩浆包围时被动运行。"
		""
		"用途：启动冶金注入器的最初动力来源。"
		""
		"目标：制作一个热能发电机。"
		""
		"提示：在其相邻位置浇筑熔岩块可提供免费、无限、但较慢的被动能量。"
		""
		"小知识：它基于塞贝克效应（热电转换）。"
	]
	quest.3C32F5DA6513BBC9.quest_subtitle: "&c热能动力学"
	quest.3C32F5DA6513BBC9.title: "热能发电机"
	quest.3C36B38B3F31E5E6.quest_desc: ["用魔法升级装备。毕竟，用&c巨大的铁锤&r砸脆弱的魔法卷轴，听起来就很合理。"]
	quest.3C36B38B3F31E5E6.quest_subtitle: "是时候用锤子了"
	quest.3C36B38B3F31E5E6.title: "&8&l神秘砧&r"
	quest.3C400389F4FC4FEB.quest_desc: [
		"欢迎来到中压（MV）世界！"
		""
		"你需要 &b铝&r 才能继续。建造一个 &c电动高炉&r 多区块结构，将铝粉熔炼成锭。"
	]
	quest.3C400389F4FC4FEB.quest_subtitle: "轻便且导电"
	quest.3C400389F4FC4FEB.title: "&b铝制时代 (The Aluminum Age)"
	quest.3C53789365D138ED.quest_desc: [
		"Mekanism 能量生产的&e圣杯&r。"
		""
		"把它投入&a燃气发电机&r，所有能源问题都会&b消失&r。"
	]
	quest.3C53789365D138ED.quest_subtitle: "终极燃料"
	quest.3C53789365D138ED.title: "&a&l乙烯&r"
	quest.3C5B608DB4CC3738.quest_desc: [
		"锅炉会消耗大量的水。"
		""
		"制作一个&8青铜水泵&r，并将其放置在无限水源旁边。用流体管道将其连接到你的锅炉上，这样你就再也不用使用水桶了！"
	]
	quest.3C5B608DB4CC3738.quest_subtitle: "无限补水"
	quest.3C5B608DB4CC3738.title: "&8自动化抽水系统"
	quest.3C5E36B1A0F83997.quest_desc: [
		"第一次就得做好，不然以后重做会很麻烦。"
		""
		"制作或获取 &bPlayer Transmitter Niotic&r。"
		"它在机器之间传输资源。吞吐量是关键——传输不足是工厂看似忙碌却毫无产出的最常见原因。"
