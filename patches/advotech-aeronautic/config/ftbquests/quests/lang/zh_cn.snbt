	quest.6C04D3D832735E0C.title: "&6预测"
	quest.6C06098E5FA47F73.quest_desc: [
		"将泥土块放入其中，为其提供动力，看看地下深处隐藏着哪些珍贵矿物。"
		""
		"剧透：通常都是些没用的东西，直到你搜索30个区块为止。"
	]
	quest.6C06098E5FA47F73.quest_subtitle: "你收拾好行囊，再次踏上旅途……"
	quest.6C06098E5FA47F73.title: "&e&l核心样本钻&r"
	quest.6C06E915BA257BD6.quest_desc: [
		"&7头部防护，附带一点小惊喜。&r"
		""
		"&8Inferium 到 Insanium：将泥土变为 Allthemodium 的等级阶梯。&r"
