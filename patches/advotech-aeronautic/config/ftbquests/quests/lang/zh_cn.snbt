	quest.39FA825656E9EE69.quest_subtitle: "&7从这里开始"
	quest.39FA825656E9EE69.title: "&6烛台架灯"
	quest.3A1F000000000010.quest_desc: [
		"&7伟大的旅程始于第一步……"
		"&7还有一个好用的包来携带你的补给品。"
		""
		"&aCraft your very first &6Backpack&a and never"
		"&a又浪费了一个物品栏格子。"
		""
		"&8&o\"明智的旅人总是轻装上阵——\""
		"&8&o却承载着许多东西。\""
	]
	quest.3A1F000000000010.title: "&6&l你的第一个整合包"
	quest.3A1F000000000020.quest_desc: [
		"&7皮革是个不错的开端，但铁器更耐用。"
		""
		"&aUpgrade to an &6Iron Backpack&a to unlock"
		"&a额外的存储行和物品栏位。"
		""
		"&b提示：&7背包可以原地升级——"
		"&7升级过程中物品会留在里面！"
	]
	quest.3A1F000000000020.title: "&e&l更多空间，任君使用"
	quest.3A1F000000000030.quest_desc: [
		"&7黄金——不仅仅是装饰品。"
		""
		"&a&6金背包&a能扩大你的容量"
		"&a显著地。更多槽位，更多可能性，"
		"&a前方还有更多冒险在等着你。"
		""
		"&e别忘了：&7你还可以添加&d升级槽&7"
		"&7to your backpack using the Slot Upgrade item."
	]
	quest.3A1F000000000030.title: "&b&l精通插槽"
	quest.3A1F000000000040.quest_desc: [
		"&7Diamonds are forever — and so is your storage."
		""
		"&a&b&l钻石背包&a是一项工程学的奇迹。"
		"&aWith massive capacity and full upgrade support,"
		"&a你已经准备好迎接世界向你抛来的任何挑战了。"
		""
		"&d试着添加一个&5过滤升级&d来保持"
		"你的物品被完美地整理好了！&d"
	]
	quest.3A1F000000000040.title: "&b&l钻石标准</c2></c1>"
	quest.3A3E9F651117B245.quest_desc: ["没有任何东西能从这个机器里幸存下来。"]
	quest.3A3E9F651117B245.quest_subtitle: "终极破坏者"
	quest.3A3E9F651117B245.title: "&d&l无限粉碎工厂&r"
	quest.3A450F695375EE63.quest_desc: [
		"&a升级到&eNiotic Solar Panels&a。"
		"&7一片这样的田地可以为整个巨型基地供电"
		"&7白天。备用能源电池至关重要。"
