	quest.6E071643A56243A8.quest_desc: [
		"移动了 &fitems&r。"
		""
		"看着物品在透明的管道里缓慢移动。在管道被&c堵塞&r之前，这过程非常&b引人入胜&r。"
	]
	quest.6E071643A56243A8.quest_subtitle: "物品：意大利面 (noodle)"
	quest.6E071643A56243A8.title: "&2&l基础物流运输机&r"
	quest.6E218DFDAF4E435A.quest_desc: [
		"&7基础反应堆有尺寸限制。"
		""
		"&a升级到&8强化等级&a后，你就可以"
		"&a建造真正巨大的多区块结构。替换所有"
		"&a你的基础部件和加固部件，用于"
		"&aunparalleled energy storage and production."
	]
	quest.6E218DFDAF4E435A.quest_subtitle: "&7将事情推向极致。"
	quest.6E218DFDAF4E435A.title: "&8&l加固层级 (The Reinforced Tier)</c2></c1>"
	quest.6E3724DB3BAA5503.quest_desc: [
		"基础 &e金线&r。"
		""
		"软得你大概能嚼得动。请不要嚼它。"
	]
	quest.6E3724DB3BAA5503.quest_subtitle: "闪闪发光的线"
	quest.6E3724DB3BAA5503.title: "&e&l金线&r"
	quest.6E3954737E59279E.quest_desc: [
		"随着技艺的精湛，我再也无法忍受粗铁的沉重。它的冰冷不仅压在我的肉体上，更压在我的精神上。因此，我决心改进曾庇护过我的东西。"
		""
		"锻造灵魂染甲时，我将金属与精粹结合，但这份结合仍需精心照料。每块灵魂染钢之间，我都铺上一层扭曲岩石作为基底，既薄又神圣，用以隔绝我凡人的身躯与金属饥渴的共鸣。"
		""
		"如今，盔甲能庇护肉体与灵魂。当危险临近时，它会发出微弱的嗡鸣，提醒着人们，即便是庇护，也伴随着未知未来的低语。"
	]
	quest.6E3954737E59279E.quest_subtitle: "钢铁守护着身躯。灵魂则需要更温柔的双手。"
	quest.6E3954737E59279E.title: "&dSoulstained Armor&r"
	quest.6E4DFE8557C5AC93.quest_desc: [
		"&6一个里程碑。&r"
		""
		"制作或获取&6Prediction&r。"
		"该模组神秘进阶的又一步。这里的成长曲线很陡峭，跳过阶段往往会得不偿失。"
		"&7Hostile Neural Networks&r 进度的一部分。"
		"&8这不再影响后续步骤——想建的时候再建，而不是被迫去建。"
