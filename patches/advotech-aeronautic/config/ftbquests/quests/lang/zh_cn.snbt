	quest.D2A582A2C0DB7D05.quest_desc: ["&7Assemble the &5Chain of Souls&7 from rare boss drops - the gateway to &dhigh-tier crafting&7."]
	quest.D2A582A2C0DB7D05.title: "&5&l灵魂锁链&r"
	quest.D3DB7B3958DAF067.quest_desc: [
		"&7神话合金 &dUnrealium&7 - 星光中迄今为止&4强度最高的材料&7。"
		""
		"&7该维度的绝对最终形态。"
	]
	quest.D3DB7B3958DAF067.title: "&d&l虚幻锭&r"
	quest.D5188F580569F5ED.quest_desc: [
		"&7四位传奇人物死在你的手中。他们的力量现在属于你了。"
		""
		"&c世界上再也没有能让你感到害怕的东西了。&r"
	]
	quest.D5188F580569F5ED.title: "&4&l&n顶级掠食者&r"
	quest.D5BF79E71563E1A6.quest_desc: [
		"&7Upgrade &fInferium&7 into &2Prudentium Essence&7 - tier 2 of five."
		""
		"&7更好的工具，更快的成长。"
	]
	quest.D5BF79E71563E1A6.title: "&2&l审慎&r"
	quest.E0F59D603E384504.quest_desc: ["&7Craft the &bSeeking Eye&7 and use it on biome flora to &alocate hidden bosses&7."]
	quest.E0F59D603E384504.title: "&b&l寻觅之眼&r</c2></c1>"
	quest.E5961AEC99D74E27.quest_desc: [
		"&7让你的收集者跑起来。在结束前，你需要成千上万个&a&7&b中子堆&7。"
		""
		"&7Compress them in the &bNeutron Compressor&7 into ingots."
	]
	quest.E5961AEC99D74E27.title: "&b&l中子堆&r"
	quest.E6245D513E7159DD.quest_desc: ["&7Weave &1Sculk Armor&7 from reinforced shards. It grows &astronger in darkness&7."]
	quest.E6245D513E7159DD.title: "&1&l潜行盔甲&r"
	quest.EA4A18386C54ED65.quest_desc: ["&7召唤一个&dFoliot&7来守护近乎无限的&dDimensional Matrix&7——Occultism的存储系统。"]
	quest.EA4A18386C54ED65.title: "&d&l维度存储&r"
	quest.EB852A0F61E3B151.quest_desc: [
		"&7&c&lInfinity Ingot&r&7 - 游戏中最昂贵的物品。"
		""
		"&7你所建造的一切，都引向了这一刻。"
	]
	quest.EB852A0F61E3B151.title: "&c&l&n无限锭&r</c3></c2></c1>"
	quest.EE42E8174CF57021.quest_desc: ["&7驯服一只&8乌鸦&7，让它帮你携带物品，并在午夜飞行时陪伴你。"]
	quest.EE42E8174CF57021.title: "&8&l渡鸦伙伴&r"
	quest.EED18FB8E95A3E07.quest_desc: [
		"&7&aMystical Agriculture&7 让你可以&a种植&7几乎所有资源作物。"
		""
		"&7挖掘&eProsperity Ore&7并将其研磨成&eProsperity Shards&7以开始。"
	]
	quest.EED18FB8E95A3E07.title: "&a&l不可能的农耕&r"
	quest.EFA7EAC1D7AFF669.quest_desc: ["&7Place a &6Golden Sacrificial Bowl&7 in a candle-lit circle to begin &5summoning rituals&7."]
	quest.EFA7EAC1D7AFF669.title: "&6&l献祭仪式&r"
	quest.F0D492BE6B0CD563.quest_desc: [
		"&7直面苏醒的、完全形态的可怕&4Qliphoth&7。"
		""
		"&7熬过它的猛攻，并将其摧毁。"
	]
	quest.F0D492BE6B0CD563.title: "&4&l克利福斯&r</c2></c1>"
	quest.F0E8C711A59F9B9B.quest_desc: ["&7Hunt the &6Gauntlet&7 in the &cNether&7 - a colossal fist that hammers the ground beneath you."]
	quest.F0E8C711A59F9B9B.title: "&6&l试炼之路&r</c2></c1>"
	quest.F38DCF5FBE025824.quest_desc: [
		"&7清除&4最高阶传送门&7，获取本整合包中最丰厚的掉落物。"
		""
		"&c带上你最好的装备。和一两个朋友。&r"
	]
	quest.F38DCF5FBE025824.title: "&4&l永恒之门&r"
	quest.F468C823EA53A288.quest_desc: [
		"&7Press a blueprint into the crafting grid with a &6rod&7 and &etool heads&7 to forge a &ePickaxe&7."
		""
		"&7混合材料以获得不同属性！"
	]
	quest.F468C823EA53A288.title: "&e&l你的第一件定制工具&r"
	quest.F47B7939F5BDA685.quest_desc: ["&7熔炼&6辛辛纳石&7，锻造工具以在更深的荒野中生存。"]
	quest.F47B7939F5BDA685.title: "&6&l辛辛纳提石&r"
	quest.F72E73F758438939.quest_desc: [
		"&7&c永恒之门&7会生成&6波次竞技场战斗&7以获取战利品。"
		""
		"&7Craft a &6Gate Pearl&7 and throw it to open a gateway."
	]
	quest.F72E73F758438939.title: "&c&l传送门珍珠&r"
	quest.F9A286AA6D5E0E41.quest_desc: ["&7&bFroststeel&7能冻结它所击中的任何东西——对抗快速生物很有效。"]
	quest.F9A286AA6D5E0E41.title: "&b&l霜钢&r"
