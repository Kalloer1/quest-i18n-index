	quest.793A9453ACB1AFBD.quest_desc: [
		"&7珍贵的宝石——镶嵌、合成，或是收藏起来。&r"
		""
		"&8种植精华种子，收获整个世界——无需矿井即可进行矿物采集。&r"
	]
	quest.793A9453ACB1AFBD.quest_subtitle: "值得挖掘一番"
	quest.793A9453ACB1AFBD.title: "Supremium 宝石"
	quest.794D53CCD6F6C556.quest_desc: ["fusion reactor if the most efficient and safe way of producing power in vanilla mekanism. it consumes D-T fuel or deuterium and tritium. it can be activated by inserting hohlarum full of d-t fuel into the controller when the reactor is suitably heated up via resistive heater or a intense enough laser beam. the reactor itself has 2 modes: air cooled, which outputs energy  and consumes fuel and water cooled which doesnt output as much eneergy but steam instead, which can be then processed by a turbine into even more energy"]
	quest.794D53CCD6F6C556.quest_subtitle: "元数据的力量"
	quest.794D53CCD6F6C556.title: "&b聚变反应堆控制器"
	quest.796432C114B3FCAF.quest_desc: ["&7五个快捷栏，比你的良心更快地删除物品。"]
	quest.796432C114B3FCAF.quest_subtitle: "&c激进删除模式已开启"
	quest.796432C114B3FCAF.title: "&c高级回收工厂"
