	quest.7A1B2C3D4E5F600F.quest_desc: [
		"&7Process your Yttrium to finally get &bHelium Coolant&7."
		""
		"&7冷却效率高达1.5，能以惊人的燃烧速率（1920 mb/t）运行裂变反应堆。堪称过度工程的巅峰之作。"
	]
	quest.7A1B2C3D4E5F600F.quest_subtitle: "冰冷漂浮的气体"
	quest.7A1B2C3D4E5F600F.title: "&b&l浮游冷却剂&r"
