	quest.49F6A9E575A86963.quest_desc: ["基础物品存储层级。与 Storage Housing 结合，创建一个功能性磁盘。"]
	quest.49F6A9E575A86963.quest_subtitle: "&7Refined Storage"
	quest.49F6A9E575A86963.title: "&7&l1k 存储组件&r"
	quest.4A00000000000001.quest_desc: [
		"&8黑石英&r是 Actually Additions 的核心材料。"
		""
		"你可以在世界生成中将其作为矿石找到。多挖一些，因为几乎所有的机器和工具都需要它。"
	]
	quest.4A00000000000001.quest_subtitle: "&7黑暗的基础设施"
	quest.4A00000000000001.title: "&8黑石英"
	quest.4A00000000000002.quest_desc: [
		"在转换物品之前，你需要晶体流（CF），它与标准的FE/RF兼容。"
		""
		"&8煤炭发电机&r是发电的绝佳起点。"
	]
	quest.4A00000000000002.quest_subtitle: "&7基础CF生成器"
	quest.4A00000000000002.title: "&8煤炭发电机"
	quest.4A00000000000003.quest_desc: [
		"&c原子重构器&r会发射激光束，将前方掉落的方块和物品进行转化。"
		""
		"运行需要稳定的 CF（能量）供应。"
	]
	quest.4A00000000000003.quest_subtitle: "&7将物品闪电般升级为更好的物品！"
	quest.4A00000000000003.title: "&c原子重组器"
	quest.4A00000000000005.quest_desc: [
		"将标准资源放置在原子重构器前，即可创造特殊晶体："
		""
		"• Redstone -> Restonia"
		"• 铁 -> Enori"
		"• 青金石 -> 帕利斯"
		"• 煤炭 -> 虚空"
		"• 钻石 -> 钻石粉"
		"• 绿宝石 -> 绿宝石化"
	]
	quest.4A00000000000005.quest_subtitle: "&7注入了原始的力量，充满了能量"
	quest.4A00000000000005.title: "&b重构水晶"
	quest.4A00000000000006.quest_desc: [
		"&e激光中继器&r可在基地内无线传输CF/RF。"
		""
		"你必须使用&cLaser Wrench&r将它们连接起来。右键点击第一个中继器，然后点击第二个。"
	]
	quest.4A00000000000006.quest_subtitle: "&7无线电力传输"
	quest.4A00000000000006.title: "&e能量激光中继器"
	quest.4A00000000000007.quest_desc: [
		"&dEmpowerer&r 是一个多区块合成台。"
		""
		"将 Empowerer 放置在中心，并在其南北东西各 2 格处放置 4 个 &aDisplay Stand&r。"
		"所有5个方块都必须有动力！"
	]
	quest.4A00000000000007.quest_subtitle: "&7真正的潜力被释放了"
	quest.4A00000000000007.title: "&d赋能者 (The Empowerer)</c1>"
	quest.4A00000000000008.quest_desc: [
		"将基础水晶放置在赋能器上，并将所需材料放在4个展示架上。"
		""
		"它会消耗大量能量来制作强化版，用于模组最高等级的机器。"
	]
	quest.4A00000000000008.quest_subtitle: "&7能量脉动中，充满活力"
	quest.4A00000000000008.title: "&5赋能水晶"
	quest.4A00000000000010.quest_desc: [
		"强化的水晶可以解锁强大的饰品。"
		""
		"&a磁化戒指&r能将物品吸向你，而&2生长戒指&r则能加速附近作物的生长。"
	]
	quest.4A00000000000010.quest_subtitle: "&7实用小工具包 (Baubles of utility)"
	quest.4A00000000000010.title: "&6力量戒指模组"
	quest.4A00000000000011.quest_desc: [
		"油菜籽是一种很棒的替代能源。"
		""
		"种植油菜，然后将种子/作物放入&aCanola Press&r中榨取Canola Oil。"
	]
	quest.4A00000000000011.quest_subtitle: "&7正在提取石油"
	quest.4A00000000000011.title: "&a油菜籽压榨机"
	quest.4A00000000000012.quest_desc: [
		"将菜籽油倒入&2发酵桶&r中，将其提炼成精炼菜籽油。"
		""
		"这种流体在油发电机中燃烧时能产生更多的能量！"
	]
	quest.4A00000000000012.quest_subtitle: "&7燃料精炼中"
	quest.4A00000000000012.title: "&2发酵桶"
	quest.4A00000000000013.quest_desc: [
		"&a农夫&r会自动在其前方的一大片区域播种并收割成熟的作物。"
		""
		"给它提供能量和种子，然后提取收获的物品！"
	]
	quest.4A00000000000013.quest_subtitle: "&7自动化农业模组"
	quest.4A00000000000013.title: "&a农夫"
	quest.4A099EA3A896422E.title: "高级机械装置 (Advanced Mechanics)"
	quest.4A0A6DCDBCE017C5.quest_desc: ["&eFlux Compressor&r 将Forge Energy (RF) 直接转化为压缩空气。"]
	quest.4A0A6DCDBCE017C5.quest_subtitle: "&7PneumaticCraft"
	quest.4A0A6DCDBCE017C5.title: "&6Flux Compressor"
	quest.4A171B3234B70105.quest_desc: ["&e硬化反应堆&r。又是36个方块。至少现在能产生&c可观的电力&r了。"]
	quest.4A171B3234B70105.title: "&e&l硬化反应堆&r"
	quest.4A2DE5EB39999369.quest_desc: [
		"从这里开始，章节就不再是入门性质的了。"
		""
		"制作或获取 &aImperium Essence&r。"
		"可再生资源的产出。任何能生长的东西，都是你再也不需要去寻觅的资源。"
		"&7Mystical Agriculture&r 进阶流程的一部分。"
		"&8这不再影响后续步骤——想建的时候再建，而不是被迫去建。"
	]
	quest.4A2DE5EB39999369.quest_subtitle: "&7神秘农业 (Mystical Agriculture)"
	quest.4A2DE5EB39999369.title: "&a帝国精髓"
	quest.4A36248B0C2C4AEF.quest_desc: [
		"&6一个里程碑。&r"
		""
		"制作或获取 &6Hopper Botany Pot&r。"
		"可再生资源的产出。任何能生长的东西，都是你再也不需要去寻觅的资源。"
		"Part of the &7Botany Pots&r progression."
		"&8一个分支任务。可选，但很少浪费时间。"
	]
	quest.4A36248B0C2C4AEF.quest_subtitle: "&7植物学花盆"
	quest.4A36248B0C2C4AEF.title: "&6Hopper Botany Pot（漏斗植物学盆）</c1>"
	quest.4A38E6CA4CEFA19C.quest_desc: [
		"第一次就得做好，不然以后重做会很麻烦。"
		""
		"制作或获取 &a霜钢锭&r。"
		"中级合成材料。单独看很无聊，但数量巨大——在配方堆积前实现自动化生产。"
		"属于&7The Undergarden&r的进阶流程。大多数配置在继续推进前都会停留在这个阶段。"
		"&8下一个：Utherium Crystal，Cloggrum Pickaxe。"
	]
	quest.4A38E6CA4CEFA19C.quest_subtitle: "&7地下花园 (The Undergarden)</c1>"
	quest.4A38E6CA4CEFA19C.title: "&a霜钢锭"
	quest.4A5B6C7D8E9F0D1E.quest_desc: [
		"&6这才是值得为之努力的目标。&r"
		""
		"制作或获取 &6Gargantuan Flux Storage&r。"
		"机器链的又一块组件。单独作用不大，接入工厂的其他部分后，又能减少一项手动操作。"
		"Part of the &7Flux Networks&r progression."
		"&8这条分支的尽头。"
	]
	quest.4A5B6C7D8E9F0D1E.quest_subtitle: "&7Flux Networks"
	quest.4A5B6C7D8E9F0D1E.title: "&6巨型纹流存储装置"
	quest.4A8F00FC61BC6121.quest_desc: ["要升级&9Echoing&r，我们需要几种不同的物品。 \\n\\n蜡烛相对容易获得！还有&9Echo Shards&r……这个可就难了…… \\n\\n获得它们最好的办法是搜刮&6Ancient City&r，但你也可以用几种仪式来制作。 \\n\\n（或者以后用&5Enchanting&r也可以！） \\n\\n&9Echoing Deepshelves&r会掉落更多&5Arcana&r，概率为&515%&r！同时将最大&aEterna&r提升至&a75&r。"]
	quest.4A8F00FC61BC6121.title: "&9回响的深海书架"
	quest.4A9002F6CAAC8781.quest_desc: [
		"&7混合氧化钙粉尘、沙子、铅粉尘和水蒸气。"
		""
		"&7制作能真正抗住爆炸的混凝土，还附带了台阶和楼梯。非常适合用来收容你那注定会爆炸的反应堆。最纯粹的野兽派风格。"
	]
	quest.4A9002F6CAAC8781.quest_subtitle: "最纯粹的野兽派建筑风格"
	quest.4A9002F6CAAC8781.title: "&8&l高品质混凝土&r"
	quest.4A965C944F051570.quest_desc: ["探索 Hexerei 的奇妙之处，掌握其机制。"]
	quest.4A965C944F051570.title: "欢迎来到 Hexerei 魔法世界"
	quest.4A984FABD408EF8B.quest_desc: ["&5Ritual Brazier&r 用于施展大规模环境魔法。用 Ritual Tablet 右键点击它即可开始！"]
	quest.4A984FABD408EF8B.quest_subtitle: "火灾危险"
	quest.4A984FABD408EF8B.title: "&6&l仪式熔炉&r"
	quest.4A9FD155008DE9DA.quest_desc: ["微弱的&e闪电&r。给智能手机充电都勉强，更别说杀死苦力怕了。"]
	quest.4A9FD155008DE9DA.quest_subtitle: "静电"
	quest.4A9FD155008DE9DA.title: "&e&l火花符文&r"
	quest.4AB721B12EBC066C.quest_desc: [
		"本章中接下来的所有内容都从这里开始。"
		""
		"制作或获取&6燧石刀&r。"
		"上层级的原材料。越早实现自动化生产，消耗它的配方就越早不再是瓶颈。"
		"&7Farmer's Delight&r 进度的一部分。"
		"&8下一个：烹饪锅、煎锅、紫颂果。"
	]
	quest.4AB721B12EBC066C.quest_subtitle: "&7Where this chapter begins"
	quest.4AB721B12EBC066C.title: "&6燧石刀"
	quest.4ABBC62189AD5EC8.quest_desc: [
		"将电阻器、电缆和铜组合起来，制作出&e模拟电路&r。"
		""
		"这是基础电气机器的“大脑”。&e自动化这些电路应是你的首要任务！&r"
	]
	quest.4ABBC62189AD5EC8.quest_subtitle: "低压逻辑电路"
	quest.4ABBC62189AD5EC8.title: "&e模拟大脑 (LV)"
	quest.4ABEAAD8B004EF28.quest_desc: ["&7比煤炭更高级。将有机物、树苗或作物转化为环保能源。"]
	quest.4ABEAAD8B004EF28.title: "&a生物发电机"
	quest.4AC105EA45A8DDD2.quest_desc: [
		"&7再次升级你的线缆以保持同步"
		"&7使用烈焰级发电机。"
		""
		"&aCraft &cBlazing Energy Cables&a."
	]
	quest.4AC105EA45A8DDD2.quest_subtitle: "&7吞吐量惊人。"
	quest.4AC105EA45A8DDD2.title: "&c&l炽热电缆"
	quest.4ACF9B24878AAADA.quest_desc: [
		"&3来自虚空的能量。&r"
		""
		"&7Tap into spatial energies by burning &dEnder Pearls&7 and &dEnder Eyes&7. Highly efficient for mid-to-late game setups."
	]
	quest.4ACF9B24878AAADA.quest_subtitle: "虚空能量"
	quest.4ADD954783C9D5B0.quest_desc: ["永久删除物品。消失，&c化为原子&r。"]
	quest.4ADD954783C9D5B0.quest_subtitle: "灭霸的响指"
	quest.4ADD954783C9D5B0.title: "&8&l分解仪式&r"
	quest.4ADF292A6FABD6EC.quest_desc: [
		"需要 &9Blueprints&r 才能使用的豪华工作台。"
		""
		"因为显然，要弄清楚怎么建造电线，需要一张蓝图和一个专用的工作区。"
	]
	quest.4ADF292A6FABD6EC.quest_subtitle: "花式桌子"
	quest.4ADF292A6FABD6EC.title: "&9&l工程师工作台&r"
	quest.4AF410C93641F068.quest_desc: ["用8本&7书&r和一个铁砧，我们就能制作&8拆解手册&r。准确来说是8本，但你懂我的意思！ \\n\\n在铁砧上把物品和&8手册&r结合，就能移除物品上的一半&5附魔&r。 \\n\\n操作完成后，物品会被损坏并失效。不建议使用，最好还是升级它！"]
	quest.4AF410C93641F068.quest_subtitle: "半级附魔，破坏物品"
	quest.4AF410C93641F068.title: "&8废料收集手册"
	quest.4AF80C658F5FD63C.quest_desc: [
		"&7你需要能量来创造能量。"
		""
		"&aCraft a &cFurnator&a (burns solid fuel like coal)"
		"&a或者一个&cMagmator&a（能燃烧像岩浆这样的液体燃料）。"
		"&a这些是你前期可靠的电力来源。"
		""
		"&7两者都可通过所有等级进行升级——一个氮化熔炉"
		"&7燃烧的煤炭块能产生惊人的FE/秒。"
	]
	quest.4AF80C658F5FD63C.quest_subtitle: "&7渴望力量的燃烧。"
	quest.4AF80C658F5FD63C.title: "&c&l早期生成物"
	quest.4B040765D4057A59.quest_desc: [
		"&6压轴之作。在此之前的一切都是铺垫。&r"
		""
		"制作或获取 &6End Prediction&r。"
		"该模组神秘进阶的又一步。这里的成长曲线很陡峭，跳过阶段往往会比节省的时间花费更多。"
		"&7Hostile Neural Networks&r 进度的一部分。"
		"&8这条分支的尽头。"
	]
	quest.4B040765D4057A59.quest_subtitle: "&7敌对神经网络 (Hostile Neural Networks)"
	quest.4B040765D4057A59.title: "&6末地预测结束"
	quest.4B1B64E2DE77172D.quest_desc: ["mekasuit 在没有全套或充能的情况下，就像普通盔甲一样，但一旦充能（并升级），你就能获得魔法抗性、水肺、飞行、速度、跳跃提升等各种便利功能，并且可以随心所欲地开启或关闭。即使是基础盔甲，在充能后也能提供无限保护。"]
	quest.4B1B64E2DE77172D.quest_subtitle: "终极防护，为你带来终极保护"
	quest.4B1B64E2DE77172D.title: "&6基础工程已完成"
	quest.4B1D639262928F5F.quest_desc: ["&7&cME Drive&7 包含了你的存储单元。你的实体物品会在这里被转换为数字数据。"]
	quest.4B1D639262928F5F.quest_subtitle: "&c数字存储系统"
	quest.4B29E4AAD20C2682.quest_desc: ["&7The highest standard tier of capacitor."]
	quest.4B29E4AAD20C2682.title: "&6八进制电容器"
	quest.4B2A7CAAA567ACD4.quest_desc: ["将敌人钉在原地，让你终于可以打出你那&c糟糕的射击&r。"]
	quest.4B2A7CAAA567ACD4.quest_subtitle: "待着。别动。待命。原地待命。"
	quest.4B2A7CAAA567ACD4.title: "&2&l束缚符文&r"
	quest.4B2E853B49079D7E.quest_desc: ["&e硬化岩浆怪&r。现在开始狂饮岩浆。向你的&b临时流体储罐&r告别吧。"]
	quest.4B2E853B49079D7E.title: "&e&l硬化岩浆怪&r"
	quest.4B315A7F0BF78D68.quest_desc: [
		"在世界中放置方块。"
		""
		"将此与 Breaker Module 结合，用复杂的、卡顿的原版风格农场代替普通的机器。"
	]
	quest.4B315A7F0BF78D68.quest_subtitle: "自动建造器"
	quest.4B315A7F0BF78D68.title: "&a&l放置模块&r"
	quest.4B42DE0B8ACC4A56.quest_desc: [
		"你已经具备了前提条件。现在该把它们用起来了。"
		""
		"制作或获取 &6振金锭&r。"
		"中级合成材料。单独看很无聊，但数量需求大——在配方堆积前就自动化生产。"
		"&7AllTheModium&r 进度的一部分。"
		"&8下一个：Allthemodium 方块、Vibranium 升级锻造模板、Vibranium 靴子。"
	]
	quest.4B42DE0B8ACC4A56.quest_subtitle: "&7AllTheModium"
	quest.4B42DE0B8ACC4A56.title: "&6振金锭"
	quest.4B623BE97AB72169.quest_desc: [
		"稳步前进。这一步并不华丽，但没有它，本章就无法完成。"
		""
		"合成或获取 &bBedrock&r。"
		"原版游戏中的常见物品，这里用作某种截然不同事物的基础。"
		"&7Minecraft&r 进阶的一部分。"
		"&8下一个：Infinity Catalyst。"
	]
	quest.4B623BE97AB72169.quest_subtitle: "&7我的世界"
	quest.4B623BE97AB72169.title: "&b基岩版"
	quest.4B694E91ADABACC3.quest_desc: [
		"被俘获的烈焰人，被用作一个简陋的炉子。"
		""
		"喂它煤炭能让东西变热，喂它烈焰蛋糕能让东西变得&c蠢蠢地热&r。"
	]
	quest.4B694E91ADABACC3.quest_subtitle: "辛辣的囚犯"
	quest.4B694E91ADABACC3.title: "&c&l烈焰人燃烧器&r"
	quest.4B694F8EB223DB7C.quest_desc: [
		"Know this, Seeker: the essence of Malum is not mere sorcery, but the shaping of that which lies between thought and form. &dSoulstone&r (both raw and refined) is the keystone of this forgotten craft. From it are born two sacred instruments: the &6Spirit Altar&r, and the &6Crude Scythe&r."
		""
		"古人写道，在现实变薄的地方，灵魂石会发出微弱的嗡鸣，其共振在虚空中低语。寻找这样的石头，或通过炼金仪式将其制成，因为它们会唤醒你自身灵魂中潜藏的气息。"
		""
		"传言说，面纱之外有一座建筑，它会吸引某些遗迹，并用被遗忘的语言低语交易。有人说，第一块灵魂石是通过交易获得的，而非锻造而成。"
	]
	quest.4B694F8EB223DB7C.quest_subtitle: "灵魂并非被发现……而是在寂静中锻造而成。"
	quest.4B694F8EB223DB7C.title: "&d灵魂石&r"
	quest.4B6CC1320A18604F.quest_desc: [
		"&7在匹配的浸渍土上种植，即可无需操作地收获该资源。&r"
		""
		"&8Inferium 到 Insanium：将泥土变为 Allthemodium 的等级阶梯。&r"
	]
	quest.4B6CC1320A18604F.quest_subtitle: "种植。收获。重复。"
	quest.4B6CC1320A18604F.title: "铁质种子"
	quest.4B9455D96952AF6C.quest_desc: [
		"&7&6大型旋转冷凝器&7是标准版的巨大升级。"
		""
		"&7它以&e前所未有的速度&7将气体转化为液体（反之亦然）。非常适合批量处理&b锂&7或&6蒸汽&7。"
	]
	quest.4B9455D96952AF6C.quest_subtitle: "工业冷凝器"
	quest.4B9455D96952AF6C.title: "&6Large Rotary Condensentrator"
	quest.4BA74A76D42C44C6.quest_desc: [
		"&7传奇金属的第二层级。"
		""
		"&a&a振金&a通常可以在高空的"
		"&a下界天花板或扭曲森林深处。"
		"&a它能完美吸收动能。"
	]
	quest.4BA74A76D42C44C6.quest_subtitle: "&7在炽热的深处锻造而成。"
	quest.4BA74A76D42C44C6.title: "&a&l振金"
	quest.4BA8FD5FDC00BE40.quest_desc: ["让路由器不那么慢和烦人的基础物品。"]
	quest.4BA8FD5FDC00BE40.quest_subtitle: "更多的文书工作要处理了"
	quest.4BA8FD5FDC00BE40.title: "&7&l空白升级&r"
	quest.4BD22FBE4A6A9BD7.quest_desc: [
		"描述：将压碎的有机物转化为稳定的能量流。"
		""
		"技术信息：燃烧生物燃料以生成FE。优秀的早期被动能源。"
		""
		"用法：将作物放入破碎机中运行以生产生物燃料来供应。"
		""
		"目标：制作一个生物发电机。"
		""
		"提示：南瓜和甜瓜是制作自动化生物燃料农场的绝佳选择。"
		""
		"小知识：一种非常干净、环保的替代热力发电机方案。"
	]
	quest.4BD22FBE4A6A9BD7.quest_subtitle: "&2生物的力量"
	quest.4BD22FBE4A6A9BD7.title: "生物发电机"
	quest.4C0574C553267E6E.quest_desc: ["请勿浸泡其中，也请勿饮用。非常适合制作高级电池和溶解你最近的所有烦恼。"]
	quest.4C0574C553267E6E.quest_subtitle: "禁忌的汤品。"
	quest.4C0574C553267E6E.title: "&e&l硫酸&r"
	quest.4C24A225F1236E04.quest_desc: [
		"&7在匹配的浸渍土上种植，即可自动收获该资源。&r"
		""
		"&8Inferium 到 Insanium：将泥土变为 Allthemodium 的等级阶梯。&r"
	]
	quest.4C24A225F1236E04.quest_subtitle: "种植。收获。重复。"
	quest.4C24A225F1236E04.title: "Glowstone Seeds"
	quest.4C37356449520E06.quest_desc: ["&7turns seeds, crops and plant into &abiofuel&7, which is useful for things such as blaze burners and ifinity tools (to prevent energy usage)"]
	quest.4C37356449520E06.quest_subtitle: "嗯，不过只对无限工具有用就是了。"
	quest.4C37356449520E06.title: "&2这是什么？生物燃气吗？"
	quest.4C3B000000000010.quest_desc: [
		"&7通往终极冶炼速度的旅程，由此开始。"
		""
		"&a&c铜制熔炉&a的速度略快于"
		"&a普通熔炉，是很好的入门选择"
		"&apoint before you commit your precious iron."
	]
	quest.4C3B000000000010.quest_subtitle: "&7比鹅卵石稍微高级一点的方块。"
	quest.4C3B000000000010.title: "&c&l卑微的开端"
	quest.4C3B000000000020.quest_desc: [
		"&7经典之作。永恒之选。"
		""
		"&a&fIron Furnace&a 提供了显著的提升"
		"&a速度提升于石头之上。它是基础"
		"&a用于所有更高级别的处理。"
	]
	quest.4C3B000000000020.quest_subtitle: "&7模组的名字来源。"
	quest.4C3B000000000020.title: "&f&l经典铁块 The Classic Iron"
	quest.4C3B000000000030.quest_desc: [
		"&7如果你有闲银，这个熔炉"
		"&7为标准的进阶路线提供了另一种选择。"
		""
		"&a它介于铁和金之间，恰到好处"
		"在效率方面来说，&a效率更高一些。"
	]
	quest.4C3B000000000030.quest_subtitle: "&7另一条道路可供选择。"
	quest.4C3B000000000030.title: "&7&l银的冶炼"
	quest.4C3B000000000040.quest_desc: [
		"&7黄金是热的绝佳导体。"
		""
		"&a&e金质熔炉&a熔炼物品的速度非常快，"
		"&a但要当心：它的燃油效率并不高"
		"&athe best."
	]
	quest.4C3B000000000040.quest_subtitle: "&7速度更快，但燃料消耗也更快。"
	quest.4C3B000000000040.title: "&e&l黄金之热"
	quest.4C3B000000000050.quest_desc: [
		"&7现在要进入正题了，好戏才刚刚开始。"
		""
		"&a&b钻石熔炉&a的速度非常快"
		"&a而且非常省油。必备之选，适合"
		"&a任何中后期的基地。"
	]
	quest.4C3B000000000050.quest_subtitle: "&7严肃处理的行业标准。"
	quest.4C3B000000000050.title: "&b&l钻石强度"
	quest.4C3B000000000060.quest_desc: [
		"&7村民们看到这一幕会哭泣的。"
		""
		"&a&aEmerald Furnace&a 在堆栈中熊熊燃烧"
		"&aof items in seconds."
	]
	quest.4C3B000000000060.quest_subtitle: "&7Trading wealth for speed."
	quest.4C3B000000000060.title: "&a&l翡翠效率"
	quest.4C3B000000000070.quest_desc: [
		"钻石品质的美丽变体。&7<c2>"
		""
		"&a&b水晶熔炉&a能让你看到"
		"&a当前正在熔炼的物品，对吧？"
		"透过它透明的外壳，&a可以清楚地看到里面的东西。"
	]
	quest.4C3B000000000070.quest_subtitle: "&7小心你的物品融化了。"
	quest.4C3B000000000070.title: "&b&l晶莹剔透"
	quest.4C3B000000000080.quest_desc: [
		"&7密集、黑暗，且毁灭性地快速。"
		""
		"&a&5Obsidian Furnace&a 是一款顶级机器"
		"&athat requires serious materials to craft."
	]
	quest.4C3B000000000080.quest_subtitle: "&7能完美地保持热量。"
	quest.4C3B000000000080.title: "&5&l黑曜石核心"
	quest.4C3B000000000090.quest_desc: [
		"&7锻造于下界的深处之中。"
		""
		"&a&8下界合金熔炉&a代表着最高境界"
		"&a的标准熔炉技术。它的速度"
		"&a和效率几乎无人能及。"
	]
	quest.4C3B000000000090.quest_subtitle: "&8&l终极的平凡熔炉。"
	quest.4C3B000000000090.title: "&8&l下界合金熔炉"
	quest.4C3B0000000000B0.quest_desc: [
		"&7为什么要一个一个处理，而不能批量处理呢？"
		""
		"&a&9Factory Augment&a 添加了额外的输入项"
		"&a并将输出槽连接到熔炉，从而允许"
		"&a并行冶炼。"
	]
	quest.4C3B0000000000B0.quest_subtitle: "&7一次性熔炼多种物品。"
	quest.4C3B0000000000B0.title: "&9&l工厂增强模块"
	quest.4C3B0000000000C0.quest_desc: [
		"&7需要早点获得电力吗？"
		""
		"&a&eGenerator Augment&a 能将任何铁质熔炉"
		"&a到煤炭发电机中，将固体燃料转化为能源"
		"&a代替熔炼，将其转化为Forge Energy (FE/RF) 能量。"
	]
	quest.4C3B0000000000C0.quest_subtitle: "&7将热能转化为电能。"
	quest.4C3B0000000000C0.title: "&e&l发电机增强器"
	quest.4C3B0000000000D0.quest_desc: [
		"&7普通的熔炼方式就行，但有时你"
		"&7需要专门的工具。"
		""
		"&aInstall a &cBlasting Augment&a to process ores faster,"
		"&a或者一个&6Smoking Augment&a，可以快速烹饪食物。"
	]
	quest.4C3B0000000000D0.quest_subtitle: "&7吸烟与爆破。"
	quest.4C3B0000000000D0.title: "&c&l特殊加热系统"
	quest.4C3B0000000000E0.quest_desc: [
		"&7熔炉技术的绝对巅峰之作。"
		""
		"&a&d彩虹熔炉&a的运行速度非常快，"
		"&a违背常理。它能瞬间清空漏斗里的物品。"
		""
		"&7Requires a Rainbow Core and Plating to craft."
	]
	quest.4C3B0000000000E0.quest_subtitle: "&d&l神级冶炼速度。"
	quest.4C3B0000000000E0.title: "&d&lR&ca&ei&an&bb&9o&5w &f&lFurnace"
	quest.4C48C8155C145A0D.quest_desc: ["这样清理后，你建造过程中浪费了多少资源，就都忘得一干二净了。"]
	quest.4C48C8155C145A0D.quest_subtitle: "清除所有记忆，重新开始。"
	quest.4C48C8155C145A0D.title: "&d&l无限净化工厂&r"
	quest.4C4F0FBE25643834.quest_desc: ["轻巧、闪亮、导电性强。非常适合用于电线，确保你雄心勃勃的新飞机不会立即坠毁。"]
	quest.4C4F0FBE25643834.quest_subtitle: "比你的良心还要轻的东西。"
	quest.4C4F0FBE25643834.title: "&f&l铝锭&r"
	quest.4C57C5532337C7DF.quest_desc: ["&75个格子。将气体变成闪亮岩石，速度惊人。"]
	quest.4C57C5532337C7DF.quest_subtitle: "&c固化术 (Solidification)"
	quest.4C57C5532337C7DF.title: "&c高级结晶化工厂"
	quest.4C5FB10C0B07AE28.quest_desc: ["将物品转化为化学物质"]
	quest.4C5FB10C0B07AE28.quest_subtitle: "恶作剧事件群组事件"
	quest.4C5FB10C0B07AE28.title: "&b化学氧化剂"
	quest.4C606B5AFDDA0B7B.quest_desc: [
		"&6The high point of this chapter.&r"
		""
		"制作或获取 &6混沌之铲&r。"
		"此阶的工具或武器。更远的射程、更快的速度，通常还有值得学习的特殊能力。"
		"&7Draconic Evolution&r 进阶的一部分。"
		"&8这条分支的尽头。"
	]
	quest.4C606B5AFDDA0B7B.quest_subtitle: "&7龙之进化模组"
	quest.4C606B5AFDDA0B7B.title: "&6混沌之铲"
	quest.4C65AA4BED1AAC80.quest_desc: ["会在各处散播有毒粉尘。在基地里施放这个，你的朋友们会&c喜欢&r上它的。"]
	quest.4C65AA4BED1AAC80.quest_subtitle: "过敏症"
	quest.4C65AA4BED1AAC80.title: "&2&l毒孢子符文&r"
	quest.4C72F9C15F17D7A0.quest_desc: [
		"前一步骤的自然延续。"
		""
		"制作或获取&e瓶中云&r。"
		"前往地图危险区域的奖励。你无法通过合成来获得这个。"
		"&7Artifacts&r 进度的一部分。"
		"&8下一个：检查点。"
	]
	quest.4C72F9C15F17D7A0.quest_subtitle: "&7远古遗物"
	quest.4C72F9C15F17D7A0.title: "&e瓶中的云"
	quest.4C75EA4C74D74DC2.quest_desc: [
		"无限的动力传输。"
		""
		"因为你的词汇表里根本就没有“足够”这个词。"
	]
	quest.4C75EA4C74D74DC2.quest_subtitle: "无限的力量"
	quest.4C75EA4C74D74DC2.title: "&d&l无限通用线缆&r"
	quest.4C871CC076835460.quest_desc: [
		"此处的进度会叠加 - 每个等级都会使下一个等级更便宜。"
		""
		"制作或获取 &bBlock Placer&r。"
		"机器链的又一块组件。单独作用不大，接入工厂的其他部分后，又能减少一项手动操作。"
		"&7Industrial Foregoing&r 进阶流程的一部分。"
		"&8这条分支的尽头。"
	]
	quest.4C871CC076835460.quest_subtitle: "&7Industrial Foregoing"
	quest.4C871CC076835460.title: "&b方块放置器"
	quest.4C9D4A8395E29A0F.quest_desc: [
		"链条中的下一个环节。"
		""
		"制作或获取&dDraconic Staff&r。"
		"此阶的工具或武器。更远的射程、更快的速度，通常还有值得学习的特殊能力。"
		"&7Draconic Evolution&r 进阶的一部分。"
		"&8这不再影响后续步骤——想建的时候再建，而不是因为必须建。"
	]
	quest.4C9D4A8395E29A0F.quest_subtitle: "&7龙之进化模组"
	quest.4C9D4A8395E29A0F.title: "&d龙之法杖"
	quest.4CA6D41AF965C048.quest_desc: [
		"第一次就得做好，不然以后重做会很麻烦。"
		""
		"制作或获取 &bBattery Basic&r。"
		"它能缓冲能量，防止间歇性抽能的机器拖垮你的整个网络。"
		"&7Powah&r 进阶的一部分。"
		"&8下一个：电池硬化。"
	]
	quest.4CA6D41AF965C048.quest_subtitle: "&7Powah"
	quest.4CA6D41AF965C048.title: "&b基础电池"
	quest.4CA91251D32C3A20.quest_desc: [
		"&7一种坚固无比的进阶材料。"
		""
		"&7顶级工具、最重盔甲和终局机器建造所必需的材料。"
	]
	quest.4CA91251D32C3A20.title: "&5杜拉提乌姆"
	quest.4CB3E1F490201460.quest_desc: [
		"描述：架起物态之间的桥梁，将气体凝结为液体，或将液体汽化为气体。"
		""
		"技术信息：UI中有一个切换按钮，可在Decondensentrating（液体->气体）和Condensentrating（气体->液体）之间切换。"
		""
		"用途：常用于将水蒸气变回水，或将液态锂变为锂蒸气。"
		""
		"目标：制作一个旋转冷凝器。"
		""
		"提示：确保方向切换已正确设置！这是新手玩家导致机器“故障”的首要原因。"
		""
		"小知识：「Condensentrator」是 Mekanism 独有的有趣组合词。"
	]
