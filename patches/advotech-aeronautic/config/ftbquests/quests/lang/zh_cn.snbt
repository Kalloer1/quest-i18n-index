	quest.049689CDF7366167.quest_desc: ["以物理上不可能的高速向矿石中喷射化学物质。"]
	quest.049689CDF7366167.quest_subtitle: "化学武器战争"
	quest.049689CDF7366167.title: "&e&l绝对注入工厂&r"
	quest.0498A62E1A1689B5.quest_desc: ["&b物质传输器&r会设定你的出发地。为其供电并与拨号装置配对。"]
	quest.0498A62E1A1689B5.quest_subtitle: "&7发送站"
	quest.0498A62E1A1689B5.title: "&d物质传输器"
	quest.04A28060A920A7BE.quest_desc: ["将生物困在圆形区域内。一个用于关押&e受害者&r的魔法围栏。"]
	quest.04A28060A920A7BE.quest_subtitle: "超时角（Timeout corner）"
	quest.04A28060A920A7BE.title: "&e&l收容仪式&r"
	quest.04A2876E463CE32D.quest_desc: [
