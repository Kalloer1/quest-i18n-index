	quest.327E4E164F1454BC.quest_desc: [
		"描述：专为安全运输挥发性化学品而设计的真空密封管。"
		""
		"技术信息：可移动气体、注入类型和颜料。不能移动流体（水、岩浆）。"
		""
		"用法：连接你的氧化器、分离器和PRC。"
		""
		"目标：制作所有等级的增压管。"
		""
		"提示：如果机器不接受管道，请检查是否误将流体输入到了气体接口！"
		""
		"小知识：独特的黄色警示条纹表示化学危险。"
	]
