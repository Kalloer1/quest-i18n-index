	quest.639C47172537988E.quest_desc: ["神圣睡衣。献给当坦克倒下时被&c训斥&r的专职治疗者。"]
	quest.639C47172537988E.quest_subtitle: "Wololo"
	quest.639C47172537988E.title: "&e&l牧师套装&r"
	quest.63BB0C81E7CF8B47.quest_desc: [
		"在移动装置上开启或关闭钻头、锯子等组件 &a开启&r 或 &c关闭&r。"
		""
