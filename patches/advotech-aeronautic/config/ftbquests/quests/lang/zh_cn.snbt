	quest.54E39812F74DD1DD.quest_subtitle: "无线维度传送的核心装置"
	quest.54E440C7CDD80E7A.quest_desc: [
		"它能产生&c热量&r。我的意思是，它能产生的电力少得令人&c失望&r。"
		""
