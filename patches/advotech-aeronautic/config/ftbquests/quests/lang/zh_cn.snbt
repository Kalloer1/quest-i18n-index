	quest.041A1C64A8468087.title: "&6寻找天界骑手 Heavenly Rider"
	quest.0435E1B1C2288B95.quest_desc: ["消耗水和过热冷却剂以产出冷却剂和蒸汽"]
	quest.0435E1B1C2288B95.quest_subtitle: "不要破坏一个水龙头上的东西"
	quest.0435E1B1C2288B95.title: "滚烫滚烫的"
	quest.045470427E2FB572.quest_desc: ["现代交通的甜美蜜露。非常适合为你的小型车辆加油，或者生一个超超超大的篝火。"]
	quest.045470427E2FB572.quest_subtitle: "闻起来像是自由和速度的味道。"
	quest.045470427E2FB572.title: "&e&l汽油&r"
	quest.046DA1A8A5FBA924.quest_desc: [
