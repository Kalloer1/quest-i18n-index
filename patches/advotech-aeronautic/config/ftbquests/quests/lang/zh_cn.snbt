	quest.7D6B86722B2D7B91.title: "煤炭种子"
	quest.7D7DE53A1C6A1573.quest_desc: ["Half the &firon&r in your base just turned into these sticks. For some reason, the mod forces you to craft a &avertical&r and a &ehorizontal&r version. &3 luckily, with a reversible crafting (vertical to horizontal and reverse)"]
	quest.7D7DE53A1C6A1573.quest_subtitle: "Jod 的棒子"
	quest.7D7DE53A1C6A1573.title: "&7&l介电棒&r"
	quest.7D92151B18D44C73.title: "高级机械装置 (Advanced Mechanics)"
	quest.7DAFD84CE5CE1E46.quest_desc: [
		"描述：将极高电压通过电阻线圈，产生纯净的浓缩热量。"
		""
		"技术信息：消耗FE以产生热量。你可以在其UI中设置精确的FE/秒消耗量。"
		""
		"用途：用于将热蒸发植物的温度升至最高。"
		""
		"目标：制作一个电阻加热器。"
		""
		"提示：小心！设置过高的使用限制会很容易耗尽你的整个电力网络。"
		""
		"小知识：原型为现实世界中的工业电阻加热元件。"
	]
	quest.7DAFD84CE5CE1E46.quest_subtitle: "&c电热装置"
	quest.7DAFD84CE5CE1E46.title: "电阻式加热器"
	quest.7DEEFEE99D4F1153.quest_desc: ["充满了诅咒和獠牙。闻起来大概是&c腐肉&r的味道。"]
	quest.7DEEFEE99D4F1153.quest_subtitle: "恐怖故事"
	quest.7DEEFEE99D4F1153.title: "&8&lEvoker Spell Book&r"
	quest.7DF9870C61B1EC89.quest_desc: ["&7Use the Fragment Forge to create Electrum (Gold + Silver) and Invar (Iron + Nickel)."]
	quest.7DF9870C61B1EC89.title: "&e高级合金 (Advanced Alloys)"
	quest.7E0178CE1082F2D0.quest_desc: [
		"Offer five Arcane Spirits to a totem pole and speak the invocation of release... the Unchained Rite."
		""
		"接下来的操作无法撤销。一股原始而古老的潜力席卷大地，将一切自然之物扭曲成被诅咒的倒影。草地变黑，土壤化为被诅咒的土地，就连图腾本身也重生为灵魂木，永远改变了模样。"
		""
		"这种腐化会随时间稳定下来，形成可控的电流，可用来转化新材料。但要小心它培育出的灵魂木树苗。长大后，它们会重现诞生时的瘟疫，再次散播腐化。"
		""
		"请谨慎耕作。你释放的，或许不愿再被束缚。"
	]
	quest.7E0178CE1082F2D0.quest_subtitle: "召唤混沌，便是教会森林尖叫。"
	quest.7E0178CE1082F2D0.title: "&d无拘束仪式&r"
	quest.7E20D87B727C060E.quest_desc: ["&7Plastic's almost here, just need to &csmelt it.&7"]
	quest.7E20D87B727C060E.quest_subtitle: "...were distastrous to human race"
	quest.7E20D87B727C060E.title: "&b干橡胶"
	quest.7E3F362C5CF1391E.quest_desc: ["这个不是主书架进阶所必需的，但对于某些&d&lInfusions&r却是必需的。\\n\\n倒数第二个&lWorld Tier&r，即&6&lSummit&r，会将你的&aMax Eterna&r提升至&a75&r。"]
	quest.7E3F362C5CF1391E.quest_subtitle: "将 Max Eterna 提升至 75"
	quest.7E3F362C5CF1391E.title: "要到达&6&l顶峰"
	quest.7E6890426F32B7C1.quest_desc: [
		"&7这项工程奇迹已经完工了。"
		""
		"&a放置&eTurbine Controller&a。确保你的"
		"&a转子转速保持在最佳RPM范围内"
		"&a以获得最高效率。"
		""
		"&a你已经掌握了核物理学！"
	]
	quest.7E6890426F32B7C1.quest_subtitle: "&e&l终极的能源核心。"
	quest.7E6890426F32B7C1.title: "&e&l最大过载"
	quest.7E68E606E0A554F3.quest_desc: [
		"在第一批祭坛之后的时代，最虔诚的灵魂锻造者也对缓慢的灵体灌注感到厌倦。制造一叠普通的六边形灰烬可能需要耗费整个月。因此，诞生了&d符文木方尖碑&r，这座由神圣黄金和活木构成的纪念碑，旨在加速无形之物的流动。"
		""
		"放置在祭坛范围内时，每座方尖碑都会吸引潜藏的以太并将其引向焦点，使过程加快四分之一。四座方尖碑可和谐共存，其共鸣将时间本身更紧密地编织在仪式火焰周围。"
		""
		"不过要小心，这些灵魂不喜欢急躁。若是听得太仔细，你可能会在空气的噼啪声中听到它们的抗议。"
	]
	quest.7E68E606E0A554F3.quest_subtitle: "耐心是一种美德——但即便是耐心的人，也可能渴望更快的揭示。"
	quest.7E7450BBBC5FD908.quest_desc: ["&6Assembly Line&r 使用气动机械臂和激光来自动化复杂的工艺。"]
	quest.7E7450BBBC5FD908.quest_subtitle: "&7PneumaticCraft"
	quest.7E7450BBBC5FD908.title: "&b装配控制器"
	quest.7E7E2DD65E554CEB.quest_desc: ["将能量传输限制提升至“荒谬”级别。"]
	quest.7E7E2DD65E554CEB.quest_subtitle: "快速充电"
	quest.7E7E2DD65E554CEB.title: "&e&l绝对提供者&r"
	quest.7E83F981C4CE214E.quest_desc: [
		"终极级别的自动合成器。"
		""
		"以惊人的速度合成物品，大幅加快大型自动化合成请求。"
	]
	quest.7E83F981C4CE214E.quest_subtitle: "&7额外存储空间"
