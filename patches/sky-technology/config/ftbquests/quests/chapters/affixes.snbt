		}
		{
			dependencies: ["57AEECE2900A1530"]
			description: ["你现在可以制作回收台了，只需将宝石放入其中，然后点击回收物品按钮即可将其粉碎。你也可以放入任何附加属性物品进行回收，以删除该物品并获得一些稀有度材料。"]
			id: "12C730736EC2057D"
			tasks: [{
				id: "0C145B9219AEE564"
