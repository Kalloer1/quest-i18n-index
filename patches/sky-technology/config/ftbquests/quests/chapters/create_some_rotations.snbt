		{
			dependencies: ["5C71E2011CE50083"]
			description: ["用斧头点击橡木木板可以获得去皮橡木木板。然后用安山合金点击它们，可以获得安山合金外壳。"]
			id: "21CDA16D3989B115"
			tasks: [{
				id: "756C83F694D043BA"
				item: "create:andesite_casing"
