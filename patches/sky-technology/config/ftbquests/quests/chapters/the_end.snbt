		{
			dependencies: ["2CDA6AF9F58F533C"]
			description: ["将物品放入末影箱后，你可以在任何地方打开的末影箱中取用。每个玩家都有自己的末影箱。"]
			id: "70B8F63A4EBBF814"
			tasks: [{
