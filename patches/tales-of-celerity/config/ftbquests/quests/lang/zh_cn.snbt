	quest.1363E5B632BB5AEE.title: "Zane Blood"
	quest.13C806893332FA51.quest_desc: ["击杀混沌与凋零的君主 The Monarch Of Chaos and Wither"]
	quest.1433D5A0B2AC46C5.quest_desc: ["击杀游荡的骑士（Kill The Knight Prowler）"]
	quest.14857DBF1DCBF100.quest_desc: ["如往昔之影般乘风破浪，这艘被诅咒的船只上载满了难以击倒的骷髅。每个甲板都暗藏危险，每个船舱都低语着失落的宝藏，而你挥出的每一击都可能转瞬即逝。只有勇敢者（或鲁莽者）才敢于直面其无情的亡灵船员。"]
	quest.14857DBF1DCBF100.quest_subtitle: "寻找一艘亡灵海盗船"
	quest.14BE211925D8BD63.title: "储存经验值 (Storing XP)"
	quest.14C5133A25B0EA96.quest_desc: ["用吸血鬼獠牙制作一本书，即可获得吸血鬼指南"]
	quest.1500997386FCDE64.quest_desc: ["铁魔法与魔法书指南"]
	quest.151BCC341A9E6C87.quest_desc: ["有 3.33% 的几率代替其他生物生成"]
	quest.154C80564E18D35E.quest_desc: ["更强的法术，需要更高级别的权杖和更高的学派等级"]
