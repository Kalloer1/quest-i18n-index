	quest_links: [ ]
	quests: [
		{
			description: [
				"在英雄的世界里，一件蕴含着Apothic Affix的古老神器，已遗失在时间的深处。传说低语着它迷人的力量，能将魔法编织进现实的纹理。众神选中了你，一位勇敢的冒险者，踏上危险的旅程，找回这件神秘的物品。"
				""
				"{@pagebreak}"
				"踏入险境，深入遗忘的地下城，直面强敌，揭开Apothic Affix的秘密。唯有凭借坚定的决心和机智，你才能成功驾驭其惊人的力量，重塑这个神话世界的命运。"
			]
			id: "5A37E658929CFDD6"
			rewards: [
				{
					exclude_from_claim_all: true
					id: "767BA13D49EA72D4"
					table_id: 6818843643653601848L
					type: "loot"
				}
				{
					exclude_from_claim_all: true
					id: "66568E3CF0A41D92"
					table_id: 3579490975339811271L
					type: "loot"
				}
			]
			size: 3.0d
			subtitle: "&5&o发掘阿波西克前缀 (Unearthing the Apothic Affix)</c2></c1>"
			tasks: [{
				advancement: "apotheosis:affix/root"
				criterion: ""
				id: "3461EE83AF239D75"
				type: "advancement"
			}]
			title: "&d&l令人眼花缭乱的附魔"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["5A37E658929CFDD6"]
			description: [
				"在地球表面深处，蕴藏着一处尚未开发的奇妙宝藏。作为一名勇敢的探险家，你得知了隐藏在迷宫深处的传说级附魔物。传说称，它能赋予普通物品无与伦比的魔力。"
				""
				"{@pagebreak}"
				"手持可靠的镐和坚定的决心，潜入地下世界，穿越险恶的隧道，战胜守护宝藏的邪恶生物。发掘Affix，解锁其秘密，赢取梦寐以求的地下Affix，从此改变你在这无尽冒险世界中的命运轨迹。"
			]
			id: "39823B7C8EE952E8"
			rewards: [
				{
					exclude_from_claim_all: true
					id: "6D811E7D2343D67A"
					table_id: 6818843643653601848L
					type: "loot"
				}
				{
					exclude_from_claim_all: true
					id: "7A35D7ADC3092122"
					table_id: 3579490975339811271L
					type: "loot"
				}
			]
			subtitle: "&5&o地下前缀的追寻之旅"
			tasks: [{
				advancement: "apotheosis:affix/chests"
				criterion: ""
				id: "54277888283DF9F2"
				type: "advancement"
			}]
			title: "&d&l宝藏重现于世"
			x: 0.0d
			y: 5.5d
		}
		{
			dependencies: ["5A37E658929CFDD6"]
			description: [
				"在时间的长河中，一颗散发着无与伦比光芒的远古水晶浮出水面，据说其中蕴藏着等待被发现的沉睡力量。作为被选中的冠军，你肩负着寻找神秘的 Socketable Gem 的崇高使命，这是一种能为装备注入不可思议力量的珍贵宝石。"
				""
				"{@pagebreak}"
				"穿越广袤的疆域，从巍峨山脉到神秘遗迹，在追求中直面自然险恶与邪恶生物。运用你的智慧、勇气，以及天界盟友的帮助，解锁藏于这颗宝石中的古老秘密。"
			]
			id: "7395EAE5CDAAFD8F"
			rewards: [
				{
					exclude_from_claim_all: true
					id: "0A56FBE00ACABCB6"
					table_id: 6818843643653601848L
					type: "loot"
				}
				{
					exclude_from_claim_all: true
					id: "3E4B1A7FEBC8680A"
					table_id: 3579490975339811271L
