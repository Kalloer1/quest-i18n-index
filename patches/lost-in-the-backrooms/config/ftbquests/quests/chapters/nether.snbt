			rewards: [
				{
					command: "/give @p written_book{pages:['[\"\",{\"text\":\"Day 3, Year \",\"bold\":true,\"italic\":true,\"color\":\"#VAR(--TW-PROSE-BOLD)\"},{\"text\":\"???\",\"bold\":true,\"italic\":true,\"obfuscated\":true,\"color\":\"#VAR(--TW-PROSE-BOLD)\"},{\"text\":\"\\\\n\\\\nI\\'ve discovered a fortress today, a massive structure of dark stone. It\\'s filled with strange, skeletal creatures and floating, fiery entities. I\\'ve named them Wither Skeletons and Blazes, respectively. \",\"color\":\"reset\",\"italic\":true}]','{\"text\":\"I\\'ve managed to fend off a few, their strength is formidable but not insurmountable.\",\"italic\":true}'],title:\"Tattered Journal 2\",author:SurrealNirvana}"
