			rewards: [
				{
					command: "/give @p written_book{pages:['[\"\",{\"text\":\"Day 7, Year \",\"bold\":true,\"italic\":true,\"color\":\"#VAR(--TW-PROSE-BOLD)\"},{\"text\":\"???\",\"bold\":true,\"italic\":true,\"obfuscated\":true,\"color\":\"#VAR(--TW-PROSE-BOLD)\"},{\"text\":\"\\\\n\\\\nI\\'ve made a breakthrough. The Blazes drop rods of intense heat when defeated. These Blaze Rods are a key component in brewing potions.\",\"color\":\"reset\",\"italic\":true}]','{\"text\":\"I\\'ve also discovered that the Wither Skeletons, on rare occasions, drop their skulls. I have a feeling these skulls hold a greater purpose.\",\"italic\":true}'],title:\"Tattered Journal 3\",author:SurrealNirvana}"
