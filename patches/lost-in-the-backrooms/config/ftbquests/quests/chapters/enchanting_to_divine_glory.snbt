	order_index: 3
	quest_links: [ ]
	quests: [
		{
			description: [
				"作为一名勇敢的探索者，你踏上危险的旅程，寻找传说中的附魔台。传说它能赋予普通物品非凡的力量。要揭开这件神秘物品的秘密，你必须穿越险恶的地形，克服可怕的挑战，并与神话生物对抗。"
				""
				"{@pagebreak}"
				"深入遗忘的坟墓，解读神秘的卷轴，咨询智慧的贤人，以掌握那难以捉摸的附魔之力，重塑你世界的命运。解开附魔台的奥秘，成为神秘力量的大师，释放你内心的巫师。"
			]
			id: "2E9E9EBE76358F0A"
			rewards: [
				{
					exclude_from_claim_all: true
					id: "25B039A3FCEFBDBF"
					table_id: 6818843643653601848L
					type: "loot"
				}
				{
					exclude_from_claim_all: true
					id: "0C0E44E8F32C07AE"
					table_id: 3579490975339811271L
					type: "loot"
				}
			]
			size: 3.0d
			subtitle: "&5&o揭开附魔台的奥秘面纱"
			tasks: [{
				advancement: "apotheosis:enchanting/enchanter"
				criterion: ""
				icon: "minecraft:enchanting_table"
				id: "78F9564F6FF25723"
				type: "advancement"
			}]
			title: "&d&l附魔之谜团"
			x: 0.0d
			y: 4.0d
		}
		{
			dependencies: ["2E9E9EBE76358F0A"]
			description: [
				"天赋异禀的附魔者，踏上险途，解锁神秘技艺的秘密。你的使命是驾驭宇宙能量，赋予物品无与伦比的力量。历经知识与技能的考验，你必须运用精湛的附魔技艺，将一件普通物品提升至宏伟的30级。"
				"{@pagebreak}"
				""
				"途中，你将遭遇危险的生物，解开神秘的谜题，并与强大的对手交锋。唯有拥抱魔法的本质，超越凡人的极限，你才能成就伟业，重塑命运本身。"
			]
			id: "487E6899ACD40EDB"
			rewards: [
				{
					exclude_from_claim_all: true
					id: "2068F5C16181A545"
					table_id: 6818843643653601848L
					type: "loot"
				}
				{
					exclude_from_claim_all: true
					id: "6BDDE4AAA83AF43D"
					table_id: 3579490975339811271L
					type: "loot"
				}
			]
			subtitle: "&5&o释放远古的力量，唤醒沉睡的潜能！"
			tasks: [{
				advancement: "apotheosis:enchanting/30ench"
				criterion: ""
