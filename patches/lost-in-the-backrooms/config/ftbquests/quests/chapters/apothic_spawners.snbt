					table_id: 3579490975339811271L
					type: "loot"
				}
			]
			subtitle: "&5&o驯服刷怪塔的怒火"
			tasks: [{
				advancement: "apotheosis:spawner/noai"
				criterion: ""
				id: "4859C9819F659D0F"
