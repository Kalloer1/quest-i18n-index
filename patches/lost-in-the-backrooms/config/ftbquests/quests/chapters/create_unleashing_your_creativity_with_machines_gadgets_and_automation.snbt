	order_index: 1
	quest_links: [ ]
	quests: [
		{
			description: ["&a&o欢迎冒险者来到创造的世界。在这里，你将通过装置工艺的艺术，探索一个充满可能性的宇宙。借助创造模组新增的科技元素，你将面临挑战，运用各种动画组件组合，实现自动化、提升美感，并解锁建造的完整潜力。但别担心，名为“沉思”的创造模组内置视觉文档将引导你了解所有新增机制和装置。那么，拿起任意创造模组物品，开启你装置工艺的精彩旅程吧。&r"]
			disable_toast: true
			id: "52D63AA2013A1F0F"
			rewards: [{
				exclude_from_claim_all: true
