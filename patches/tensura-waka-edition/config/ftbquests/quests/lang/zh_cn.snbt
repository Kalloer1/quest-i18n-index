	quest.688F4FF9C43AA4D0.title: "幻影杀手：击杀50次"
	quest.68927017D35A2B57.quest_desc: [
		"&f找到一个红砂遗迹，搜寻其中地狱特有的材料和线索。&r"
		""
		"&f先确保外部安全；在狭窄的室内战斗，不熟悉的能力更难判断。&r"
	]
	quest.68927017D35A2B57.title: "TenSura 地狱：搜寻红砂遗迹"
	quest.68964922AB3E6005.quest_desc: [
		"安装此任务包后，击败 Scylla 10 次。"
		""
		"&a奖励：&f+5,000 最大EP&r"
		"&8此里程碑会与其他击杀目标一同追踪，因此每次击杀都会计入所有目标中。&r"
	]
	quest.68964922AB3E6005.title: "斯库拉：击杀数 10"
	quest.68A436BF95C44A54.quest_desc: [
		"&e&l功能说明&r"
		"&f跺跺脚，将周围的土地高高掀起。&r"
		""
		"&a&l获取方法&r"
		""
		"&f1. 找到一本未绑定的《战斗意志手册》，并至少按住使用键10个游戏刻。此技艺是该手册26种可能卷轴之一。手册在简易地牢、废弃矿井、猪灵堡垒、要塞通道、沙漠金字塔、雪屋、部分试炼室、废弃传送门、大型水下遗迹和林地府邸中有50%的生成概率。它们也出现在矮人道场、蜥蜴人卧室和蚂蚁巢穴考古点中。即使学习失败，手册也会被消耗掉。&r"
		""
		"&f2. 与3级Battlewill Trainer矮人交易。其绑定手册的交易标签明确包含此技艺；购买命名/闪亮手册并按住使用键至少10次。&r"
		""
		"&3&l任务追踪&r"
		"&f学习任务会检查你是否已知此能力。额外的精通或EP任务仅在所有有效路线都需要时才会出现。&r"
		"&8本书无法预测随机战利品、商店轮换、手动掷骰、驯服几率、合约掷骰或不间断的训练时间。&r"
	]
	quest.68A436BF95C44A54.quest_subtitle: "近战战斗意志艺术 • 转生成为史莱姆"
	quest.68A436BF95C44A54.title: "震地踢击"
	quest.68A4A0A6410C0942.quest_desc: [
		"&f满足你的种族和技能路线所示的英雄蛋条件。仅靠高EP无法生成蛋。&r"
		""
		"&f之前获得的英雄之卵仍然有效；开启此任务后无需重复路线。&r"
	]
	quest.68A4A0A6410C0942.title: "英雄路线：制作一个英雄之卵"
	quest.68A7822061EBF63B.quest_desc: [
		"&e&l先检查这个&r"
		"&fElite Tensura 默认禁用 &eETTitleSystem &f游戏规则。服务器所有者必须启用它，才能解锁头衔或应用加成。&r"
		""
		"&f若规则未开启，本章仅作为参考。在刷取无法授予头衔的要求前，请咨询服务器所有者。&r"
	]
	quest.68A7822061EBF63B.title: "标题系统是否已启用？"
	quest.68B51B6D484C822E.quest_desc: [
		"安装此任务包后，击败劫掠者50次。"
		""
		"&a奖励：&f+100 最大EP&r"
		"&8此里程碑会与其他击杀目标一同追踪，因此每次击杀都会计入所有目标中。&r"
	]
	quest.68B51B6D484C822E.title: "掠夺者：击杀50次"
	quest.68CDE93F7E69B109.quest_desc: [
		"安装此任务包后，击败独眼猫头鹰1次。"
		""
		"&a奖励：&f+25 最大EP&r"
		"&8此里程碑会与其他击杀目标一同追踪，因此每次击杀都会计入所有目标中。&r"
	]
	quest.68CDE93F7E69B109.title: "独眼猫头鹰：首次击杀"
	quest.68CFBA2AE2D5A59B.quest_desc: [
		"&e&l功能说明&r"
		"&f释放灵魂的力量，在造成巨额伤害前将附近的实体拉向你。&r"
		""
		"&a&l获取方法&r"
		""
		"&f1. 签订“大于或等于”的风之灵契约。找到并驯服符合条件的元素之灵（适用配置好的驯服概率），或站在祈祷之路中央并持续潜行，持续配置好的祈祷时间；成功则存储更高的契约，并授予所有通过“大于”的“风之灵性魔法”，包括本契约。&r"
		""
		"&d&l灵魂契约&r"
		"&f元素：风。最低契约等级：高等。更高的契约也授予此法术，因为grantSpiritMagic包含存储等级及以下的所有匹配法术。&r"
		""
		"&6&l使用它的生物&r"
		"&f始终拥有此能力：&r"
		"&f坂口日向 (tensura:hinata_sakaguchi); 西尔菲德 (tensura:sylphide)&r"
		"&8看到生物使用此能力，并不意味着它能掉落或传授该能力。请遵循上述方法之一。&r"
		""
		"&3&l任务追踪&r"
		"&f学习任务会检查你是否已知此能力。额外的精通或EP任务仅在所有有效路线都需要时才会出现。&r"
		"&8本书无法预测随机战利品、商店轮换、手动掷骰、驯服几率、合约掷骰或不间断的训练时间。&r"
	]
	quest.68CFBA2AE2D5A59B.quest_subtitle: "精神魔法 • 转生成为史莱姆的那家伙"
	quest.68CFBA2AE2D5A59B.title: "空中之刃"
	quest.68D4D653FAE89400.quest_desc: [
		"&e&l所需物品&r"
		"&e消耗物品：&f冰之精华"
		""
		"&e&l来自&r"
		"&fAttuned Wyrm&8 — 普通进化，丰收节进化&r"
		""
		"&e&l这条路通向何方&r"
		"&fGreater Glacier Wyrm&8 — 普通进化，丰收节进化&r"
		""
		"&a&l如何进化&r"
		"&f1. 获得1个冰精华（mysticism:ice_essence）：击败Undine（必出），或开采Mysticism Ice Ore以获取其配置好的掉落物。然后吃掉或使用掉所有1个；仅携带是不够的，因为此条件会检查物品使用统计。&r"
		"&f2. 打开TenSura进化菜单并选择此种族。该任务不会为您自动进化。&r"
		""
		"&3&l任务追踪&r"
		"&f• 当前种族：小冰川幼龙 — 检查你的当前种族&r"
		"&8追踪器会显示你的进度，但你仍需通过TenSura的进化菜单进行进化。&r"
		"&8命名、身体/形态、位置条件、物品使用次数和一些附加组件计数器无法自动追踪。如果没有追踪器显示，请遵循上述步骤操作。&r"
	]
	quest.68D4D653FAE89400.quest_subtitle: "进化 • 神秘主义"
	quest.68D4D653FAE89400.title: "小型冰川幼龙"
	quest.6917A71B7E4A8AEF.quest_desc: [
		"&e&l所需物品&r"
		"&eEP: &f15,000,000 &8(可配置默认值)&r"
		""
		"&e&l此路的尽头&r"
		"&f这就是该进化路径的终点。"
		""
		"&d&l特殊进度路线&r"
		"&f此注册种族无法通过整合包的常规起始种族进化图到达。可能需要特殊机制、命令、模组特定转换或其他非标准路线。"
		""
		"&a&l如何进化&r"
		"&f1. 将你的基础最大EP提升至至少15,000,000。击败符合条件的敌人以永久成长Aura/Magicules，然后重新打开TenSura进化菜单。临时或装备加成可能会填满显示的EP追踪器，但未满足此基础EP条件。&r"
		"&f2. 打开TenSura进化菜单并选择此种族。该任务不会为您自动执行进化。&r"
		""
		"&3&l任务追踪&r"
		"&f• 最大EP：15,000,000 — 近似值：FTB读取总最大EP；比赛检查基础最大EP&r"
		"&f• 当前种族：龙兽 — 检查你的当前种族&r"
		"&8追踪器会显示你的进度，但你仍需通过TenSura的进化菜单来进化。&r"
		"&8命名、身体/形态、位置条件、物品使用次数和一些附加组件计数器无法自动追踪。如果没有追踪器显示，请遵循上述步骤操作。&r"
	]
	quest.6917A71B7E4A8AEF.quest_subtitle: "最终进化 • 起源传说"
	quest.6917A71B7E4A8AEF.title: "龙之巨兽"
	quest.691A6901557C7C76.quest_desc: [
		"&e&l所需物品&r"
		"&eEP: &f1,500,000 &8(可配置默认值)&r"
		""
		"&e&l来自&r"
		"&f长老汇聚·Aspectborn&8 — 正常进化&r"
		""
		"&e&l此路的尽头&r"
		"&f这就是该进化路径的终点。"
		""
		"&a&l如何进化&r"
		"&f1. 将你的基础最大EP提升至至少1,500,000。击败符合条件的敌人以永久成长Aura/Magicules，然后重新打开TenSura进化菜单。临时或装备加成可能会填满显示的EP追踪器，但未满足此基础EP条件。&r"
		"&f2. 打开TenSura进化菜单并选择此种族。该任务不会为您自动执行进化。&r"
		""
		"&3&l任务追踪&r"
		"&f• 最大EP：1,500,000 — 近似值：FTB读取总最大EP；比赛检查基础最大EP&r"
		"&f• 当前种族：退化 - 排斥之相 — 检查你的当前种族&r"
		"&8追踪器会显示你的进度，但你仍需通过TenSura的进化菜单进行进化。&r"
		"&8命名、身体/形态、位置条件、物品使用次数和一些附加组件计数器无法自动追踪。如果没有追踪器显示，请遵循上述步骤操作。&r"
	]
	quest.691A6901557C7C76.quest_subtitle: "最终进化 • TR: 星光"
	quest.691A6901557C7C76.title: "回归 - 排斥的方面 (Regression - Aspect of Rejection)"
	quest.6921098989B4B892.quest_desc: [
		"&f离开主世界最安全的地方，击败一只TenSura哥布林。注意它的技能、投射物和状态效果，不要把它当成普通的僵尸来打。&r"
		""
		"&f这是一个简单的初次战斗检测。狩猎章节会处理后续的长期击杀里程碑。&r"
	]
	quest.6921098989B4B892.title: "击败一只TenSura怪物"
	quest.69334C534BB9F38D.quest_desc: [
		"&e&l所需物品&r"
		"&eEP: &f400,000 &8(可配置默认值)&r"
		""
		"&e&l来自&r"
		"&f高等兽人&8 — 普通进化&r"
		"&f兽人&8 — 觉醒进化&r"
		"&f兽人灾难&8 — 正常进化&r"
		""
		"&e&l这条路通向何方&r"
		"&f神圣野猪&8 — 普通进化，觉醒进化&r"
		""
		"&a&l如何进化&r"
		"&f1. 将你的基础最大EP提升至至少400,000。击败符合条件的敌人以永久成长Aura/Magicules，然后重新打开TenSura进化菜单。临时或装备加成可能会填满显示的EP追踪器，但未满足此基础EP条件。&r"
		"&f2. 打开TenSura进化菜单并选择此种族。该任务不会自动为您执行进化。&r"
		""
		"&3&l任务追踪&r"
		"&f• 最大EP：400,000 — 近似值：FTB读取总最大EP；比赛检查基础最大EP&r"
		"&f• 当前种族：Spirit Boar — 检查你的当前种族&r"
		"&8追踪器会显示你的进度，但你仍需通过TenSura的进化菜单进行进化。&r"
		"&8命名、身体/形态、位置条件、物品使用次数和一些附加组件计数器无法自动追踪。如果没有追踪器显示，请遵循上述步骤操作。&r"
	]
	quest.69334C534BB9F38D.quest_subtitle: "进化 • 转生成为史莱姆的那件事"
	quest.69334C534BB9F38D.title: "灵魂野猪"
	quest.6935804387A4E517.quest_desc: [
		"安装此任务包后，击败末影翼100次。"
		""
		"&a奖励：&f+1,000 最大EP&r"
		"&8此里程碑会与其他击杀目标一同追踪，因此每次击杀都会计入所有目标中。&r"
	]
	quest.6935804387A4E517.title: "末影地图虫：击杀100次"
	quest.69630105DD1CDB7D.quest_desc: [
		"安装此任务包后，击败 Trilocaris 25 次。"
		""
		"&a奖励：&f+100 最大EP&r"
