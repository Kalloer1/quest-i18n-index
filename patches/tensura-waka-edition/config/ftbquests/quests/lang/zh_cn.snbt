	quest.6889D4335265FE4D.quest_subtitle: "进化 • 神秘主义"
	quest.6889D4335265FE4D.title: "元素领主 Elemental Lord"
	quest.688F4FF9C43AA4D0.quest_desc: [
		"安装此任务包后，击败幻影50次。"
		""
		"&a奖励：&f+100 最大EP&r"
