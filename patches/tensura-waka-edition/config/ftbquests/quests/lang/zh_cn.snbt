	quest.29C9F1F393AA8038.quest_desc: [
		"&e&l所需物品&r"
		"&f此种族不使用常规的EP或物品需求列表。请遵循其下方的路线。"
		""
		"&e&l来自&r"
		"&f高级赛亚人&8 — 普通进化，觉醒进化&r"
