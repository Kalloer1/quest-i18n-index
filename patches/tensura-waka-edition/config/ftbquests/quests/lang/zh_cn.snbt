	quest.37F88BE550E8790A.title: "真计算之主，施维（Schwi）"
	quest.38042BB02CACB304.quest_desc: [
		"&e&l功能说明&r"
		"&f作为魔鬼，用于追踪和管理交易的占位符技能。&r"
