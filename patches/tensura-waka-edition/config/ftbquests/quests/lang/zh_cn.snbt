	quest.35FF47120119F4C3.quest_desc: [
		"&e&l所需物品&r"
		"&eEP: &f200,000 &8(可配置默认值)&r"
		""
		"&e&l来自&r"
		"&fGreater Aspectborn&8 — 觉醒进化&r"
		"&f小收敛方面之子&8 — 正常进化，丰收节进化&r"
		""
