	quest.38042BB02CACB304.title: "魔鬼宿主"
	quest.38075458BF9994CA.quest_desc: [
		"&e&l功能说明&r"
		"&f你的灵魂能独特地抵御伤害，让你能更快或更强地提升防御力。&r"
