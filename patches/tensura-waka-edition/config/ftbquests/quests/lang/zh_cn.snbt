	quest.3A223CED18D6B59F.title: "Gummy Bear: 25 次击杀"
	quest.3A4A8A7533B80DF5.quest_desc: [
		"&e&l所需物品&r"
		"&e需要觉醒才能使用"
		""
		"&e&l来自&r"
		"&fSlayer Fairy&8 — 普通进化、觉醒进化、丰收节进化&r"
		""
		"&e&l此路的尽头&r"
		"&f这就是该进化路径的终点。"
		""
		"&a&l如何进化&r"
		"&f1. 作为真恶魔领主或真英雄觉醒。基本要求接受任一状态；请先完成对应的TenSura觉醒路线。&r"
		"&f2. 打开TenSura进化菜单并选择此种族。该任务不会自动为您执行进化。&r"
		""
		"&3&l任务追踪&r"
		"&f• 真恶魔领主或真英雄 — 准确的TenSura觉醒状态&r"
		"&f• 当前种族：迷失的仙女 — 检查你的当前种族&r"
		"&8追踪器会显示你的进度，但你仍需通过TenSura的进化菜单进行进化。&r"
		"&8命名、身体/形态、位置条件、物品使用次数和一些附加组件计数器无法自动追踪。如果没有追踪器显示，请遵循上述步骤操作。&r"
	]
	quest.3A4A8A7533B80DF5.quest_subtitle: "最终进化 • TR: 噩梦"
	quest.3A4A8A7533B80DF5.title: "迷失的仙女"
	quest.3A529E37F9BE944C.quest_desc: [
		"安装此任务包后，击败 Sissie 1 次。"
		""
		"&a奖励：&f+25 最大EP&r"
		"&8此里程碑会与其他击杀目标一同追踪，因此每次击杀都会计入所有目标中。&r"
	]
	quest.3A529E37F9BE944C.title: "西施：首次击杀"
	quest.3A53B85868FB91D0.quest_desc: [
		"&e&l功能说明&r"
		"&f撕裂空间，连接空间中的两个点。&r"
		""
		"&a&l获取方法&r"
		""
		"&f1. 签订中阶或以上太空灵契约。找到并驯服符合条件的元素灵（适用配置好的驯服几率），或站在祈祷路径中央并持续潜行至配置好的祈祷时间；成功则存储更高阶契约，并授予所有中阶以下的太空灵魔法，包括本契约。&r"
		""
		"&d&l灵魂契约&r"
		"&f元素：空间。最低契约等级：中等。更高等级的契约也会授予此法术，因为 grantSpiritMagic 包含存储等级及以下的所有匹配法术。&r"
		""
		"&3&l任务追踪&r"
		"&f学习任务会检查你是否已知此能力。额外的精通或EP任务仅在所有有效路线都需要时才会出现。&r"
		"&8本书无法预测随机战利品、商店轮换、手动掷骰、驯服几率、合约掷骰或不间断的训练时间。&r"
	]
	quest.3A53B85868FB91D0.quest_subtitle: "精神魔法 • 转生成为史莱姆的那家伙"
	quest.3A53B85868FB91D0.title: "大门"
	quest.3A648A5400B09686.quest_desc: [
		"&e&l功能说明&r"
		"&f每天释放一次你的怪物潜能，将EP翻倍并提升你的身体能力。这样做会给你的身体带来暂时的负担。&r"
		""
		"&a&l获取方法&r"
		""
		"&f1. 选择或进化为以下列出的种族之一。该种族会自动授予此技能。&r"
		""
		"&d&l授予它的种族&r"
		"&fAbyssal Dragonewt (ascension:abyssal_dragonewt); Arch Daemonic Dragon (trnightmare:arch_daemonic_dragon); Arch Dragon (trnightmare:arch_dragon); Chaos Dragon (ascension:chaos_dragon); Corrupted Dragon (ascension:corrupted_dragon); Corrupted Dragonkin (ascension:corrupted_dragonkin)&r"
		"&f被诅咒的龙 (ascension:cursed_dragon); 恶魔巨龙领主 (trnightmare:daemonic_dragon_lord); 死亡巨龙 (trnightmare:death_dragon); 恶魔巨龙神 (ascension:demon_dragon_god); 恶魔巨龙 (ascension:demonic_dragon); 魔鬼巨龙领主 (trnightmare:devil_dragon_lord)&r"
		"&f神圣巨龙 (tensura:divine_dragon); 神圣巨龙领主 (trnightmare:divine_dragon_lord); 神圣盖亚巨龙 (trnightmare:divine_gehenna_dragon); 神圣天界巨龙 (trnightmare:divine_heavenly_dragon); 神圣下界合金巨龙 (trnightmare:divine_netherite_dragon); 神圣虚空巨龙 (trnightmare:divine_void_dragon)&r"
		"&fDragon Lord (trnightmare:dragon_lord); Dragonewt (tensura:dragonewt); Element Dragon (trnightmare:element_dragon); Ender Dragon Prince (trnightmare:ender_dragon_prince); Ender Dragonewt (ascension:ender_dragonewt); Frostwrought Leviathan (mysticism:frostwrought_leviathan)&r"
		"&fGehenna Dragon (trnightmare:gehenna_dragon); Heavenly Dragon (trnightmare:heavenly_dragon); Medium Daemonic Dragon (trnightmare:medium_daemonic_dragon); Medium Ender Dragon (trnightmare:medium_ender_dragon); Medium Holy Dragon (trnightmare:medium_holy_dragon); Medium Nether Dragon (trnightmare:medium_nether_dragon)&r"
		"&f下界合金龙 (trnightmare:netherite_dragon); 霜冻瘟疫九头蛇 (mysticism:rimeblight_hydra); 圣龙 (trnightmare:saint_dragon); 焦尾翼龙 (mysticism:scorchtalon_wyvern); 废料龙 (trnightmare:scrap_dragon); 太阳神幼龙 (mysticism:sundeity_loong)&r"
		"&f真龙之蛙 (tensura:true_dragonewt); 虚空龙 (trnightmare:void_dragon); 虚空龙之蛙 (ascension:void_dragonewt)&r"
		""
		"&3&l任务追踪&r"
		"&f• 学习：龙之形态 — 学习后完成&r"
		"&8这些任务仅追踪进度，不会授予或提升任何技能。&r"
	]
	quest.3A648A5400B09686.quest_subtitle: "内在技能 • 十束：转生者"
	quest.3A648A5400B09686.title: "龙之形态"
	quest.3A6C39D6CA1F0EE9.quest_desc: [
		"安装此任务包后，击败僵尸50次。"
		""
		"&a奖励：&f+100 最大EP&r"
