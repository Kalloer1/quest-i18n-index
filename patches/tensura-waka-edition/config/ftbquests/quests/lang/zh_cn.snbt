	quest.5DB853656DD57ED2.title: "Mine Guardian: 击杀10次"
	quest.5DC229B93EB14F7E.quest_desc: [
		"安装此任务包后，击败 Elokosa Howler 10 次。"
		""
		"&a奖励：&f+75 最大EP&r"
