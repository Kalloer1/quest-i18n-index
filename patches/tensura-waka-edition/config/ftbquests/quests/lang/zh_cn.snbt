	quest.1E2550FA186BE142.quest_desc: [
		"安装此任务包后，击败灯笼100次。"
		""
		"&a奖励：&f+1,000 最大EP&r"
		"&8此里程碑会与其他击杀目标一同追踪，因此每次击杀都会计入所有目标中。&r"
	]
	quest.1E2550FA186BE142.title: "灯笼：击杀数达到 100 次"
	quest.1E2991062B713673.quest_desc: [
		"&e&l所需物品&r"
		"&e消耗物品：&f10× 皇家血液"
		""
		"&e&l来自&r"
		"&f高等兽人&8 — 普通进化&r"
		""
		"&e&l这条路通向何方&r"
		"&f兽人灾难&8 — 正常进化，丰收节进化&r"
		""
		"&a&l如何进化&r"
		"&f1. 获得10个皇家血液 (tensura:royal_blood)：击败皇家兽人 (25%)、兽人领主 (50%) 或兽人灾难 (必出)。然后吃掉或使用全部10个；仅携带是不够的，因为此条件会检查物品使用统计。&r"
		"&f2. 打开TenSura进化菜单并选择此种族。该任务不会为您自动执行进化。&r"
		""
		"&3&l任务追踪&r"
		"&f• 当前种族：兽人领主 — 检查你的当前种族&r"
		"&8追踪器会显示你的进度，但你仍需通过TenSura的进化菜单进行进化。&r"
		"&8命名、身体/形态、位置条件、物品使用次数和一些附加组件计数器无法自动追踪。如果没有追踪器显示，请遵循上述步骤操作。&r"
	]
	quest.1E2991062B713673.quest_subtitle: "进化 • 转生成为史莱姆的那家伙：转生者"
	quest.1E2991062B713673.title: "兽人领主"
	quest.1E34F25B72FDF15D.quest_desc: [
		"安装此任务包后，击败 Aptrgangr 5 次。"
		""
		"&a奖励：&f+50 最大EP&r"
		"&8此里程碑会与其他击杀目标一同追踪，因此每次击杀都会计入所有目标中。&r"
	]
	quest.1E34F25B72FDF15D.title: "Aptrgangr：击杀数 5"
	quest.1E4BF637C9285A0D.quest_desc: [
		"&c仅在准备好删除当前TenSura角色并返回角色创建界面时，领取此命令奖励。&r"
		""
		"&f使用的命令：&7/tensura reset <you> everything&r"
		"&8这是使用次数为2/3的卷轴。它不会使用重置卷轴。&r"
	]
	quest.1E4BF637C9285A0D.quest_subtitle: "领取奖励将执行重置操作"
	quest.1E4BF637C9285A0D.title: "完全角色重置 — 使用 3 次"
	quest.1E4C53362892E132.quest_desc: [
		"安装此任务包后，击败100次蝾螈。"
		""
		"&a奖励：&f+1,000 最大EP&r"
		"&8此里程碑会与其他击杀目标一同追踪，因此每次击杀都会计入所有目标中。&r"
	]
	quest.1E4C53362892E132.title: "墨西哥钝口螈：击杀100次"
	quest.1E5876E9BA3A734F.quest_desc: [
		"&e&l功能说明&r"
		"&f在贪婪地吸收周围人的力量后，你像以前一样吸收能量，独特物品的限制已重置。你的成长激励着所有人。&r"
		""
		"&a&l获取方法&r"
		""
		"&f1. 自动获取检查：master trnightmare:sentient_being；然后 master tensura:gluttony。满足条件后（例如击败另一个生物）触发一次常规EP更新，以便TenSura重新评估可学习的技能。&r"
		""
		"&f2. 从Sentient Being (trnightmare:sentient_being)开始，然后使用TR: Nightmare Ultimate进化。请遵循以下要求。&r"
		""
		"&f3. 在生存模式中击败觉醒的费尔德韦。若已耗尽他的专属奖励，他将转而随机提供一个你未拥有的独特技能。该技能属于奖励池，但结果随机，常规学习限制依然适用，且费尔德韦的奖励通常每名玩家仅限一次。&r"
		""
		"&5&l升级与解锁&r"
		"&e开始于：&r"
		"&f• 通过TR: Nightmare Ultimate进化获得Sentient Being (trnightmare:sentient_being)。&r &7要求：请在目标技能的页面上查看完整要求。&r"
		""
		"&3&l任务追踪&r"
		"&f• 学习：康乃馨 — 学习后完成&r"
		"&8这些任务仅追踪进度，不会授予或提升任何技能。&r"
	]
	quest.1E5876E9BA3A734F.quest_subtitle: "独特技能 • TR: 噩梦"
	quest.1E5876E9BA3A734F.title: "康乃馨"
	quest.1E678551C716F74D.quest_desc: [
		"&e&l功能说明&r"
		"&f召唤一个私密的内部维度。你的皮肤回响会留在外面；如果回响死亡，你将返回到它掉落的位置。再次激活即可离开并重新加入回响。&r"
		""
		"&a&l获取方法&r"
		""
		"&f1. TR: Nightmare 专属自然获取：将EP提升至100,000以上，并将基础最大Magicules至少提升至1,000。再次获得EP以运行常规获取检查；当两个默认条件均满足时，Inner World将自动习得。&r"
		""
		"&3&l任务追踪&r"
		"&f• 学习：内在世界 — 学习后完成&r"
		"&f• 最大EP：100,001 — 可选进度辅助&r"
		"&f• 最大魔法粒子：1,000 — 可选进度辅助&r"
		"&8这些任务仅追踪进度，不会授予或提升任何技能。&r"
	]
	quest.1E678551C716F74D.quest_subtitle: "通用技能 • TR: 噩梦"
	quest.1E678551C716F74D.title: "内部世界"
	quest.1E71E08AAF5B52AA.quest_desc: [
		"安装此任务包后，击败守卫者25次。"
		""
		"&a奖励：&f+100 最大EP&r"
		"&8此里程碑会与其他击杀目标一同追踪，因此每次击杀都会计入所有目标中。&r"
	]
	quest.1E71E08AAF5B52AA.title: "守护者：击杀25次"
	quest.1E72F6F806395D91.quest_desc: [
		"&e&l所需物品&r"
		"&eEP: &f500,000 &8(可配置默认值)&r"
		"&e所需能力/技能：&f理想型"
		""
		"&e&l来自&r"
		"&fHermit&8 — 丰收节进化&r"
		"&f魔法师&8 — 普通进化&r"
		""
		"&e&l这条路通向何方&r"
		"&fDisciple&8 — 普通进化，丰收节进化&r"
		""
		"&a&l如何进化&r"
		"&f1. 将你的基础最大EP提升至至少500,000。击败符合条件的敌人以永久成长Aura/Magicules，然后重新打开TenSura进化菜单。临时或装备加成可能会填满显示的EP追踪器，但未满足此基础EP条件。&r"
		"&f2. 掌握理想 (trnightmare:ideal)。在技能章节中打开对应的任务，了解学习和升级路线。&r"
		"&f3. 打开TenSura进化菜单并选择此种族。该任务不会为您自动执行进化。&r"
		""
		"&3&l任务追踪&r"
