	quest.5C0C60B498D6172F.title: "深海怪：击杀25次"
	quest.5C3B1116ACEFBF3C.quest_desc: [
		"&e&l所需物品&r"
		"&e神秘学专属进化条件"
		""
		"&e&l来自&r"
		"&fGreater Daemon&8 — 普通进化&r"
		""
		"&e&l这条路通向何方&r"
		"&fArch Doll&8 — 普通进化，丰收节进化&r"
		"&fDaemon Doll&8 — 觉醒进化&r"
		""
		"&a&l如何进化&r"
