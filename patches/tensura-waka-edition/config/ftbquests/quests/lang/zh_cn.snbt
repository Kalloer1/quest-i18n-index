	quest.7FB6D88DF5E38543.title: "死亡巨龙"
	quest.7FB768A8FB22D05E.quest_desc: [
		"&e&l所需物品&r"
		"&f此竞赛不使用常规的EP或物品需求列表。请遵循下方的路线。"
		""
