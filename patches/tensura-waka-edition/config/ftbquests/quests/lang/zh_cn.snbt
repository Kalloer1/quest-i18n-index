	quest.7124420C3C56DD59.quest_desc: [
		"&e&l所需物品&r"
		"&eEP: &f200,000 &8(可配置默认值)&r"
		""
		"&e&l来自&r"
		"&f霜狼&8 — 普通进化，丰收节进化&r"
		""
		"&e&l这条路通向何方&r"
		"&f冰川之魂狼&8 — 普通进化&r"
		""
		"&a&l如何进化&r"
		"&f1. 将你的基础最大EP提升至至少200,000。击败符合条件的敌人以永久成长Aura/Magicules，然后重新打开TenSura进化菜单。临时或装备加成可能会填满显示的EP追踪器，但未满足此基础EP条件。&r"
		"&f2. 掌握水元素操控术 (tensura:water_manipulation)。在技能章节中打开对应的任务，查看学习和升级路线。&r"
		"&f3. 掌握风系操控 (tensura:wind_manipulation)。在技能章节中打开对应的任务，查看学习和升级路线。&r"
		"&f4. 掌握冰系操控 (mysticism:ice_manipulation)。在技能章节中打开对应的任务，查看学习和升级路线。&r"
		"&f5. 打开TenSura进化菜单并选择此种族。该任务不会为您自动执行进化。&r"
		""
		"&3&l任务追踪&r"
		"&f• 最大EP：200,000 — 近似值：FTB读取总最大EP；比赛检查基础最大EP&r"
		"&f• 大师：水之操控 — 与TenSura能力完全一致的状态&r"
		"&f• 大师：风系操控 — TenSura 能力状态完全一致&r"
		"&f• 大师：冰操纵术 — 与TenSura能力完全一致的状态&r"
		"&f• 当前种族：Nivalis Frost Wolf — 检查你的当前种族&r"
		"&8追踪器会显示你的进度，但你仍需通过TenSura的进化菜单来进化。&r"
		"&8命名、身体/形态、位置条件、物品使用次数和一些附加组件计数器无法自动追踪。如果没有追踪器显示，请遵循上述步骤操作。&r"
	]
	quest.7124420C3C56DD59.quest_subtitle: "进化 • 神秘主义"
	quest.7124420C3C56DD59.title: "尼瓦利斯霜狼"
	quest.71263A28CEC3BD30.quest_desc: [
		"&e&l功能说明&r"
		"&7The mod does not provide an effect description for this ability.&r"
		""
		"&a&l获取方法&r"
		""
		"&f1. 从「Satanael, Lord of Wrath」(trnightmare:satanael) 开始，然后使用 TR: Nightmare Ego-to-Manas 命名。请遵循以下要求。&r"
		""
		"&f2. TR: 噩梦自我-玛纳斯命名：拥有一个匹配的来源终极：trnightmare:satanael，并发展其对应的自我/人格。将该自我提升至225以上的社交点数，然后通过自我进化界面确认每个阶段直至阶段4。每次尝试默认有12分钟的冷却时间和30%的失败率；失败会减半社交点数。当阶段4报告自我已就绪时，使用自我命名命令/菜单并选择一个名字。第一次命名会支付设定的基础命名成本；模组会创建映射的玛纳斯技能并转移精通度。&r"
		""
		"&5&l升级与解锁&r"
		"&e开始于：&r"
		"&f• ｢ Satanael, Lord of Wrath ｣ (trnightmare:satanael) 通过 TR: Nightmare Ego-to-Manas 命名。&r &7要求：匹配的终极人格和人格面具；社交点数 > 225；人格面具阶段 4；命名成功。&r"
		""
		"&c&l重要&r"
		"&8FTB可以验证来源和产生的技能，但无法读取Ego人格、社交点数、阶段、冷却时间、失败判定或命名成本。&r"
		""
		"&3&l任务追踪&r"
		"&f• 学习：§5Wrath Manas — 学习后完成&r"
		"&f• 学习：「愤怒之主，撒旦尼尔」——替代/匹配来源辅助；自我阶段和人格仍需手动操作&r"
		"&8这些任务仅追踪进度，不会授予或提升任何技能。&r"
	]
	quest.71263A28CEC3BD30.quest_subtitle: "终极技能 • TR: 噩梦"
	quest.71263A28CEC3BD30.title: "Wrath Manas"
	quest.714732334B0C06C2.quest_desc: [
		"安装此任务包后，击败寻声守卫100次。"
		""
		"&a奖励：&f+1,000 最大EP&r"
		"&8此里程碑会与其他击杀目标一同追踪，因此每次击杀都会计入所有目标中。&r"
	]
	quest.714732334B0C06C2.title: "Vindicator：击杀100次"
	quest.71577ABD97F4B502.quest_desc: [
		"&e&l功能说明&r"
		"&f锻造炉回应其主。修复并重铸现有之物，镌刻其上，从无中创造武器，感知石下之矿石，将锻造大师的技艺化为武器。&r"
		""
		"&a&l获取方法&r"
		""
		"&f1. 先使用 Godly Craftsman (tensura:godly_craftsman)，再使用 Elite Ultimate acquisition。请遵循以下要求。&r"
		""
		"&f2. 先使用 Creator (tensura:creator)，再使用 Elite Ultimate acquisition。请遵循以下要求。&r"
		""
		"&f3. 精英终极获取：学习并掌握所有前置技能：tensura:godly_craftsman, tensura:creator。达到至少10,000,000 EP，并觉醒为真恶魔领主或真英雄。再次获得EP以触发常规技能获取检查。启用该技能后，附加包将自动授予终极技能。&r"
		""
		"&5&l升级与解锁&r"
		"&e开始于：&r"
		"&f• 通过精英终极获取神匠 (tensura:godly_craftsman)。&r &7要求：掌握所有列出的前提条件；EP至少10,000,000；真恶魔领主或真英雄；技能已启用。&r"
		"&f• 通过 Elite Ultimate 获取 Creator (tensura:creator)。&r &7要求：掌握所有列出的前提条件；EP 至少 10,000,000；True Demon Lord 或 True Hero；技能已启用。&r"
		""
		"&c&l重要&r"
		"&8精英要求Enabled=false会绕过精通/EP/觉醒的门槛。&r"
		""
		"&3&l任务追踪&r"
		"&f• 学习：赫菲斯托斯，创造之主 — 学习后完成&r"
		"&f• 最大EP：10,000,000 — 默认精英EP阈值&r"
		"&f• 真恶魔领主或真英雄 — 精确的真恶魔领主或真英雄传送门&r"
		"&f• 大师：神级工匠 — 精英所需的确切当前精通度&r"
		"&f• 大师：创造者 — 精英所需的精确当前精通度&r"
		"&8这些任务仅追踪进度，不会授予或提升任何技能。&r"
	]
	quest.71577ABD97F4B502.quest_subtitle: "终极技能 • 精英Tensura"
	quest.71577ABD97F4B502.title: "赫菲斯托斯，创造之主"
	quest.715D05D9B4B394F6.quest_desc: [
		"&e&l功能说明&r"
		"&f作为蝎子之王，你的毒液极具危险性。这是对毒液技能的升级。仅限蝎子之王及其进化分支使用。&r"
		""
		"&a&l获取方法&r"
		""
		"&f1. 选择或进化为以下列出的种族之一。该种族会自动授予此技能。&r"
		""
		"&f2. 自动获取检查：master tensura:poison。满足条件后（例如击败其他生物）触发常规EP更新，以便TenSura重新评估可学习的技能。&r"
		""
		"&d&l授予该种族的种族&r"
		"&f神圣象鼻蝎 (mysticism:divine_loxodrome_scorpion)&r"
		""
		"&3&l任务追踪&r"
		"&f• 学习：致命毒素 — 学习后完成&r"
		"&8这些任务仅追踪进度，不会授予或提升任何技能。&r"
	]
	quest.715D05D9B4B394F6.quest_subtitle: "内在技能 • 神秘主义"
	quest.715D05D9B4B394F6.title: "致命毒素"
