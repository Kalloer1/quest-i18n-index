	quest.760171FE40BD87AB.title: "岩浆涌动"
	quest.76055A1617E8EFC1.quest_desc: [
		"安装此任务包后，击败精英德拉格1次。"
		""
		"&a奖励：&f+25 最大EP&r"
		"&8此里程碑会与其他击杀目标一同追踪，因此每次击杀都会计入所有目标中。&r"
	]
	quest.76055A1617E8EFC1.title: "精英德拉格：首次击杀"
	quest.7605B82F9FCFB90D.quest_desc: [
		"&f触发并赢得一次普通的Minecraft村庄袭击。这些袭击会被大贤者→拉斐尔和多个TR: Nightmare路线所计数。&r"
		""
		"&fTenSura's own raid events do not count. This completes from Minecraft's lifetime raid-win statistic.&r"
	]
	quest.7605B82F9FCFB90D.title: "赢得你的第一次村庄掠夺"
	quest.76218FBC54F800A1.quest_desc: [
