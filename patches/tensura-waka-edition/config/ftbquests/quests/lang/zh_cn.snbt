	quest.3611D4F4A987AFA3.title: "米塔玛的信仰"
	quest.361207E97F628113.quest_desc: [
		"&e&l所需物品&r"
		"&f此竞赛不使用常规的EP或物品需求列表。请遵循下方的路线。"
		""
		"&e&l来自&r"
