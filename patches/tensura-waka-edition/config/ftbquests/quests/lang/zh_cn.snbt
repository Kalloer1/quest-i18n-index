	quest.227C941FB295E11C.title: "棕色獠牙"
	quest.227D59C8EA03BE32.quest_desc: [
		"安装此任务包后，击败冰蜘蛛100次。"
		""
		"&a奖励：&f+1,000 最大EP&r"
