	quest.0FB3EC6FA3EDC178.quest_subtitle: "独特技能 • TR: 噩梦"
	quest.0FB3EC6FA3EDC178.title: "礼物"
	quest.0FBD04198D81E607.quest_desc: [
		"安装此任务包后，击败 Foodgeist 5 次。"
		""
