	quest.500F289588B2160B.quest_desc: [
		"&e&l所需物品&r"
		"&eEP: &f500,000 &8(可配置默认值)&r"
		"&e所需能力/技能：&fAvalon"
		""
		"&e&l来自&r"
		"&f承包商&8 — 正常进化&r"
		"&f流浪者&8 — 丰收节进化版&r"
