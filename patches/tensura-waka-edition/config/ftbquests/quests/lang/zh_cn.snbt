	quest.6CBEE3D82FDEE47F.title: "奥西洛特：首次击杀"
	quest.6CCD5168BF4ED628.quest_desc: [
		"安装此任务包后，击败 Corrodent 50 次。"
		""
		"&a奖励：&f+100 最大EP&r"
		"&8此里程碑会与其他击杀目标一同追踪，因此每次击杀都会计入所有目标中。&r"
	]
	quest.6CCD5168BF4ED628.title: "Corrodent：击杀数 50"
	quest.6CD7B022C43E2C4D.quest_desc: [
		"&f石柱学校的结构通向其命名遭遇。系统地搜查教室，准备好防火和治愈，再进入首领空间。&r"
		""
		"&f进入学校即结束本次访问。准备好追击重复击杀时，使用 Boss 狩猎。&r"
	]
	quest.6CD7B022C43E2C4D.title: "第一阶：学校与静子 (The School and Shizu)"
	quest.6CEF7D4ACBC5DED7.quest_desc: [
		"安装此任务包后，击败翼猫 25 次。"
		""
		"&a奖励：&f+100 最大EP&r"
		"&8此里程碑会与其他击杀目标一同追踪，因此每次击杀都会计入所有目标中。&r"
