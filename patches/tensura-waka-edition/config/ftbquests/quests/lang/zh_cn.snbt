	quest.2D7D434E1B6E713D.title: "僵尸：击杀 25 次"
	quest.2D81A9C459F9EB00.quest_desc: [
		"安装此任务包后，击败僵尸村民10次。"
		""
		"&a奖励：&f+75 最大EP&r"
