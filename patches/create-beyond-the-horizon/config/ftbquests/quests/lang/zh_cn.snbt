	quest.00ECC0C42F53CF51.quest_desc: [
		"备受欢迎的“Veinminer”模组依然在本整合包中！"
		""
		"不过，为了平衡性，&e它现在是一个附魔&r - 所以想要获得如此强大的力量，需要付出一点努力！"
		""
		"&e作为礼物，完成此任务即可获得你的第一本 veinminer 书籍——请明智地使用它！<3&r"
	]
	quest.00ECC0C42F53CF51.quest_subtitle: "挖矿能节省大量时间！"
	quest.015AA5A4F3D74472.quest_desc: [
		"当靠近小型生物、箱子等时，通过下蹲并右键单击它们，你就可以用&b'Carry On'模组将它们拾起！&r"
		""
		"&e非常适合用来重新布置你的基地，或者为农场收集动物&r！"
	]
	quest.015AA5A4F3D74472.quest_subtitle: "You're Coming With Me!"
	quest.01A1230B80D61D72.quest_desc: [
		"《Distant Horizons》也在这个整合包里！"
		""
		"&e这能让你看到远处渲染的LOD区块，既节省性能又能让你看得更远！&r"
		""
		"&c当然，如果你的游戏卡顿，也可以随时禁用这个功能！&r"
	]
	quest.01A1230B80D61D72.quest_subtitle: "从这里能看到我的房子了！"
	quest.05CC8EF03ADD9F8C.quest_desc: [
		"&b'Cooking for Blockheads'&r 模组添加了超多组合方块厨房方块和食物配方！"
		""
		"&e厨房水槽方块甚至能为你提供无限的水源！&r"
	]
	quest.05CC8EF03ADD9F8C.quest_subtitle: "一个伟大厨房的开端！"
	quest.060AC554341A2534.quest_desc: [
		"&b'&bClay Soldiers&r'&r Mod 让你可以创建迷你战场，里面有不同颜色的粘土士兵。"
		""
		"你甚至可以&e给他们工具和坐骑&r - 快来实验看看能发现什么吧！"
		""
		"&b你为什么会需要这个？为什么不呢！&r"
	]
	quest.060AC554341A2534.quest_subtitle: "我的军队将统治一切！"
	quest.060AC554341A2534.title: "Clay Soliders Mod！"
	quest.09452294542305E2.quest_desc: [
		"&b'Productive Bees'&r 是一款科技模组，让你可以通过捕捉和基因改造不同蜜蜂来&b被动地“培育”大多数资源！&r"
		""
		"&e一旦设置正确，这将是一个非常强大的模组！&r"
	]
	quest.09452294542305E2.quest_subtitle: "蜜蜂产钻石！？"
	quest.09452294542305E2.title: "勤劳的蜜蜂模组 (Productive Bees)"
	quest.0AC2BD67B2B14AD8.quest_desc: [
		"由于本整合包的一大重点是乘坐飞空艇旅行，其中一个附加模组（名为“Thick Air”）引入了氧气系统，这意味着你需要为旅程提前规划！"
		""
		"如果你在&e极高处（或极深的地下）&r，需要佩戴&b呼吸器&r才能正常呼吸。"
		""
		"此外，&e某些维度（如末地）完全没有氧气，&r所以你需要带上一个&b潜水服（或鱼鳔）&r才能继续呼吸！"
		""
		"&c你的物品栏里有一个再呼吸器，以防出生点地势过高！&r"
	]
	quest.0AC2BD67B2B14AD8.quest_subtitle: "一定要注意飞行的高度，小心点！"
	quest.0AD4B70082141EEC.quest_desc: [
		"&b'Wisp and Willow' &r是一款全新的魔法主题模组！"
		""
		"&e首先，将橡木树苗和深板岩块投入静水中，以获得柳树苗！&r"
	]
	quest.0AD4B70082141EEC.quest_subtitle: "一个新的魔法模组！"
	quest.0AD4B70082141EEC.title: "小精灵和柳树！"
	quest.0C096D794DB57EA1.quest_desc: [
		"&b'Create Aeronautics: Delivery Required'&r 模组是新版 'Numismatics' 模组中&e赚钱&r的好方法！"
		""
		"&e它能让你制作“合约”和“市场”方块，让你能接受送货合约，然后用赚到的钱在市场里消费！&r"
		""
		"&b此货币也用于本整合包中通过传送石进行传送！&r"
	]
	quest.0C096D794DB57EA1.quest_subtitle: "送货赚钱，轻松愉快！"
	quest.0F31350FCD39EFC2.quest_desc: [
		"此整合包包含名为&b'Numismatics'&r的模组，提供了一套货币和银行系统！"
		""
		"&e- 这种货币非常重要，能让你通过传送石传送、在市场上购买商品，甚至可以和其他玩家交易！&r"
		""
		"&b- 你也可以出售和运送多余的物品来赚钱（具体将在技术章节中说明！）&r"
	]
	quest.0F31350FCD39EFC2.quest_subtitle: "一种能让你生活更轻松的新货币！"
	quest.0FA46B838CB9747E.quest_desc: [
		"在基地附近建了个刷怪塔或下界传送门，厌倦了那些噪音了吗？"
		""
		"&eUse the 'Extreme Sound Muffler' mod to mute those sounds within a local area!"
		"&r"
		"&b要使用模组，请打开物品栏，然后点击GUI右上角的按钮。&r"
	]
	quest.0FA46B838CB9747E.quest_subtitle: "停止烦人的噪音！"
	quest.11053454DE0B49E4.quest_desc: [
		"&b“ComputerCraft”(CC:Tweaked)是一款模组，让你可以通过在自制电脑和屏幕上输入代码，来创建自己的自动化系统！&r"
		""
		"高度可定制，学会正确使用后会非常强大！"
	]
	quest.11053454DE0B49E4.quest_subtitle: "对于任何足够聪明会编程的人来说..."
	quest.11053454DE0B49E4.title: "计算机工艺！"
	quest.13507E931FC8A420.quest_desc: [
		"想合成东西，但另一个物品有相同的配方？"
		""
		"&e只需点击物品上方的“Polymorph”图标，即可在不同配方之间循环切换！&r"
	]
	quest.13507E931FC8A420.quest_subtitle: "一个简单的修复方法！"
	quest.13B11234198BFB3D.quest_desc: [
		"在探索过程中，你可能会遇到一些新的“遗迹”物品。"
		""
		"&b装备后会提供特殊且独特的加成&r，请务必全部查看！"
	]
	quest.13B11234198BFB3D.quest_subtitle: "奇怪的超能力！"
	quest.14203E1D20C58D99.quest_desc: [
		"此整合包包含 &b'Serene Seasons'&r 模组，这意味着 &e天气将随着时间的推移而缓慢变化。&r"
		""
		"&bSeasons also affect the growth of certains crops etc!&r"
	]
	quest.14203E1D20C58D99.quest_subtitle: "动态季节！"
	quest.1455165CD48DAE65.quest_desc: [
		"以下是所有会在世界中生成新建筑和群系的模组列表（我想是这样的）："
		"- 更好的下界 (Better Nether)"
		"- 更好的末地 (Better End)"
		"- Biomes O' Plenty"
		"- Choice Theorem's Overhauled Village"
		"- 气候河流模组"
		"- 海岸波涛"
		"- 大陆板块"
		"- Countered's 地形石板"
		"- 更深更暗 (Deeper and Darker)"
		"- 地下城与酒馆 (Dungeons and Taverns)"
		"- 动态树木模组 (Dynamic Trees)"
		"- 落叶飘落 (Falling Leaves)"
		"- 森林遗迹"
		"- Hopo 更好的废弃传送门"
		"- 混合水生生物"
		"- Immersive Snow"
		"- Immersive Structures"
		"- 小建筑模组 (Little Structures)"
		"- Moog's End Structures"
		"- Moog's Soaring Structures"
		"- Moog's Voyager Structures"
		"- 自然之灵"
		"- 嘎嘎作响的青蛙"
		"- 农夫乐事（含附加组件）"
		"- 宁静季节 (Serene Seasons)"
		"- 出生动画"
		"- Tectonic"
		"- Terralith"
		"- 以太维度"
		"- 墓园 (The Graveyard)"
		"- 厚重的空气"
		"- 旅行者头衔"
		"- 村民名称"
		"- Waystones"
		"- 小精灵和柳树"
	]
	quest.1455165CD48DAE65.quest_subtitle: "有一大堆世界生成模组！"
	quest.1C3B15E4C39D63C9.quest_desc: [
		"刚安顿好，储物空间就快满了？试试数字化存储吧！"
		""
		"使用 &b'Refined Storage'&r 模组创建一个强大的数字存储系统，让你可以 &e将所有物品和流体存储为字节数据&r！"
	]
	quest.1C3B15E4C39D63C9.quest_subtitle: "数字存储！"
	quest.1E334E0C5CF1E33D.quest_desc: ["&b“The Aether”&r 是一款大型 &e维度模组，让你能探索一个充满浮空岛屿和神话生物的世界！&r"]
	quest.1E334E0C5CF1E33D.quest_subtitle: "一个新的天空维度！"
	quest.1E334E0C5CF1E33D.title: "天界！"
	quest.20C5CC3364ACC3A6.title: "更深更暗！Deeper and Darker!"
	quest.21038CF818AC0647.quest_desc: [
		"为了提升整合包的沉浸感，我们添加了一些模组！"
		""
		"&e&n这些是：&r"
		"- 自动HUD"
		"- 动态准星模组 (Dynamic Crosshair)"
		"- 相机重做模组"
		"超多氛围和视觉类模组！&r"
		""
		"&c如果你实在受不了自动隐藏的HUD等，可以编辑它们的配置，或者直接在Modrinth上点击模组旁边的滑块来禁用它们！&r"
	]
	quest.21038CF818AC0647.quest_subtitle: "不得不赞叹这风景！"
	quest.21038CF818AC0647.title: "动态HUD显示模组"
	quest.22E9F585A5FB0267.quest_desc: ["使用&b'Nature's Compass'&r模组，你可以&e找到游戏中的任何生物群系&r（前提是你距离它不超过10,000格）！"]
	quest.22E9F585A5FB0267.quest_subtitle: "找到你的梦想家园！"
	quest.2946596641F3FC79.quest_desc: [
		"想做个背包，但不想杀太多牛怎么办？"
		""
		"&b这下你可以把腐肉熔炼成皮革了！&r"
	]
	quest.2946596641F3FC79.quest_subtitle: "纯素友好型皮革！"
	quest.2A86F9635DCC6622.quest_desc: [
		"此整合包包含 &b'Continents'&r 模组！"
		""
		"这会在不同“大陆”的陆地之间创造出&e广阔的水域&r。"
		""
		"&b在考虑穿越大片水域之前，先造艘像样的船或飞艇怎么样？&r"
	]
	quest.2A86F9635DCC6622.quest_subtitle: "世界现在变得大得多了！"
	quest.2C1FFC3F550EAF1F.quest_subtitle: "总得有点科技含量才行……"
	quest.2CAFE0BC2D64157C.quest_desc: ["有个模组叫&b'Better Archeology'&r，能让你&e在世界各地挖掘各种有趣的化石和物品！&r"]
	quest.2CAFE0BC2D64157C.quest_subtitle: "你会挖出什么东西呢？"
	quest.2CAFE0BC2D64157C.title: "考古学模组！"
	quest.2CC7A0EE74E09B39.quest_desc: ["有许多来自“Critters and Companions”模组的动物，你可以与它们交朋友、驯服它们，带上它们一起冒险！"]
	quest.2CC7A0EE74E09B39.quest_subtitle: "最可爱的伙伴！"
	quest.2CC7A0EE74E09B39.title: "小生物与伙伴！Critters and Companions!"
	quest.2E83567AE3106869.quest_desc: [
		"有多种新动作可以帮助你更好地探索这个世界！"
		""
		"新增耐力系统，支持冲刺、越障、抓握边缘、跳跃等动作！"
		""
		"&e请阅读“Parcool”之书，更好地了解这些招式并学习如何使用它们！&r"
		"&c请注意，出于平衡性考虑，以下招式已被禁用："
		"- 墙壁奔跑"
		"- 滑动"
		"- 闪避 / 翻滚&r"
		""
		""
		"&e另外，按 'Z' 键可以匍匐前进，穿过狭窄的缝隙！&r 有些模组还提供可以钻过的空心方块，比如通风口……"
	]
	quest.2E83567AE3106869.quest_subtitle: "全新的移动技巧！"
	quest.33DEF76BA15ACCE6.quest_desc: [
		"“Exposure”模组是个超棒的补充，让你能制作相机，拍出自己的照片！"
		""
		"&b这些照片可以冲洗出来，放进相册里，或者用来装饰你的基地！&r"
	]
	quest.33DEF76BA15ACCE6.quest_subtitle: "你可以用冒险的照片来装饰你的基地！"
	quest.33DEF76BA15ACCE6.title: "拍你自己的照片啦！"
	quest.3729821A1983FA08.quest_desc: [
		"“Create: Aeronautics” 有一个扩展包，可以让你&b右键点击绳索，然后向上/向下攀爬！&r"
		""
		"在飞艇上上下下时非常有用！"
	]
	quest.3729821A1983FA08.quest_subtitle: "要是你摔倒了，可以抓住这个东西！"
	quest.3729821A1983FA08.title: "可攀爬的绳索"
	quest.3D9EB8270CA685C2.quest_desc: [
		"&e你已获得一些新手装备，助你度过游戏初期！&r"
		""
		"这只是些食物、&b帮助你在黑暗中导航的工具&r、&b一把用来砍下第一棵树的手斧&r，以及最重要的——&b一些指南书&r，帮助你了解本整合包中的一些模组！"
	]
	quest.3D9EB8270CA685C2.quest_subtitle: "不客气！"
	quest.3F1E9F7A31CB7405.quest_desc: ["&bAlex's mobs adds TONS of new mobs&r - take care when travelling the world and good luck finding them all!"]
	quest.3F1E9F7A31CB7405.quest_subtitle: "好多动物啊！"
	quest.40485C937213BCAE.quest_desc: [
		"&b'创造'&r（以及我们为其准备的 600 万个附加内容）是本整合包的核心组件！"
		""
		"&e它提供了大量神奇的机械方块，让你能创造出从自动化存储系统，到能完全飞行、功能齐全的飞艇/飞机/潜艇等各种东西！&r"
	]
	quest.40485C937213BCAE.quest_subtitle: "本整合包的核心基石！"
	quest.40485C937213BCAE.title: "创造！"
	quest.4585910D31F681EE.quest_desc: [
		"&b'更好的下界'&r模组彻底重做了下界维度！"
		""
		"&e请确保你已经准备好迎接即将到来的新挑战！&r"
	]
	quest.4585910D31F681EE.quest_subtitle: "一种全新的地狱体验！"
	quest.4585910D31F681EE.title: "更好的下界！"
	quest.47AD7F2D09AAD06A.quest_desc: [
		"“Freecam” 模组让你可以更轻松地漂浮起来，&e从不同角度欣赏自己的建筑&r！"
		""
		"&b要切换自由视角，请按 'F4'。&r"
	]
	quest.47AD7F2D09AAD06A.quest_subtitle: "建造时很有用！"
	quest.4A8893DC78DBC8C2.quest_desc: [
		"&b“航空学”是“创造”的一个大型扩展，为游戏引入了物理系统。&r"
		""
		"&e正是这个模组，才让我们能制造飞艇、飞机、汽车、潜艇等等。&r"
		""
		"&c我强烈建议你多尝试这个模组，充分利用它，因为它是本整合包的关键部分，也是我最初想制作它的原因！&r"
	]
	quest.4A8893DC78DBC8C2.quest_subtitle: "终于到了事情开始变得有趣的地方了！"
	quest.4AB2E735C62FD1E7.quest_subtitle: "一大堆不同的食物和农业模组！"
	quest.4C7A083F466C6A9A.quest_desc: [
		"&b'Waystones'&r 模组仍在整合包中，但它们将不再生成于村庄！"
		""
		"&e想要路标石，就得用新的创造配方自己制作啦！&r"
		""
		"此外，从一个传送石到另一个的传送费用现在由“钱币学”模组的货币支付！"
	]
	quest.4C7A083F466C6A9A.quest_subtitle: "快速旅行！"
	quest.4C7A083F466C6A9A.title: "传送石传送功能！"
	quest.4DE13B24672131DD.quest_desc: [
		"由于世界里有超多新生物，有个武器系统在身边会让你感觉更安全！"
		""
		"&eCraft yourself some workbenches from the 'TACZ' (Timeless and Classic: Zero) mod to get started!&r"
	]
	quest.4DE13B24672131DD.quest_subtitle: "这可是一番严密的防御！"
	quest.4DE13B24672131DD.title: "枪械！"
	quest.4F26B0BDD3CA617E.quest_desc: ["“Big Cannons” 让你能制作自己的多区块大炮，甚至可以将其放置在飞艇上！"]
	quest.4F26B0BDD3CA617E.quest_subtitle: "轰！"
	quest.4F26B0BDD3CA617E.title: "创造：大型火炮"
	quest.517C1784D6DB9E69.quest_desc: ["修补现在更实用了，&e不用再拿着工具去收集新经验值&r，你现在可以&b直接拿着物品，蹲下，按住右键，用现有的经验值来修理工具！&r"]
	quest.517C1784D6DB9E69.quest_subtitle: "让修补附魔变得更加方便"
	quest.517C1784D6DB9E69.title: "修补机制重做"
	quest.51DE19864DB84E3A.quest_desc: [
		"更沉浸的探索方式，莫过于来自 Flashlight 模组的新型&b“手电筒”或“头灯”&r！"
		""
		"&e这些物品需要电池，能让你以更真实有趣的方式探索洞穴等黑暗区域！&r"
		""
		""
		"&9You can also put lanterns onto your belt in the 'Curios' slot to have dynamic light follow you around whilst you explore!&r"
	]
	quest.51DE19864DB84E3A.quest_subtitle: "探索黑暗洞穴时很有用！"
	quest.51DE19864DB84E3A.title: "闪光灯和灯笼 (Flash Lights and Lanterns)"
	quest.534E2ED82F4EE41D.quest_desc: [
		"&b'WaterFrames'&r 模组让你可以在基地里放置不同的 &e电视！&r"
		""
		"&b这些电视可以在你的基地里播放任何 URL 视频！&r"
	]
	quest.534E2ED82F4EE41D.quest_subtitle: "在你的基地里播放 YouTube 视频！"
	quest.534E2ED82F4EE41D.title: "自定义电视！"
	quest.54F2C73B01D68557.quest_desc: [
		"&b“铁质箱子”&r模组能让你在不建造巨大储物区的情况下扩大存储空间！"
		""
		"&bAdditonally, 'Storage Draws' allow you to store a huge ammount of a single item in a single block.&r"
		""
		"结合这两个模组将极大地缓解你的存储问题！"
	]
	quest.54F2C73B01D68557.quest_subtitle: "更多的存储空间！"
	quest.5554DE931A041A39.quest_desc: [
		"本整合包已针对光影进行了定制（一如既往）！"
		""
		"不过，和所有模组化的Minecraft一样，偶尔会出现一些小故障。"
		"&e如果环顾四周时有画面问题&r（如浮空地形跟随准星等），只需&e重新加载着色器&r即可修复！&e（默认键为\"]\"）&r"
		""
		"&cOf course, if you are getting really bad lag, you could lower the shader settings or just disable it entirely to massively increase FPS! (May be required around large bases etc)&r"
		""
		"&c(默认用于切换光影的按键是 \"[\")&r"
	]
	quest.5554DE931A041A39.quest_subtitle: "真漂亮！在电脑上玩真难！"
	quest.566602F218A96245.quest_desc: [
		"“创造喷气背包”是一个让探索变得更容易的模组，同时配方等也保持平衡！"
		""
		"&b这些喷气背包也可以放在“奇物”栏位里！&r"
	]
	quest.566602F218A96245.quest_subtitle: "探索刚刚变得容易多了！"
	quest.566602F218A96245.title: "喷气背包！"
	quest.574BC32B43F069A4.quest_desc: [
		"“Farmers Delight”模组提供了大量可制作的新作物和食物，极大地增强了游戏的农场元素！"
		""
		"&b它还包含多种厨房方块，可用于制作这些美食！&r"
	]
	quest.574BC32B43F069A4.quest_subtitle: "是时候开始种田了！"
	quest.5A36F2D88783F0CA.quest_desc: ["&b'Straw Statues'&r 是一款有趣的模组，&e让你能为稻草人创造姿势和玩家皮肤，&r用它们来装饰你的基地！"]
	quest.5A36F2D88783F0CA.quest_subtitle: "摆个姿势！Strike a Pose!"
	quest.5A36F2D88783F0CA.title: "稻草人雕像！"
	quest.5F61252B47DCBBD8.quest_desc: [
		"“Magnum Torch”模组让你能制作3种不同类型的特殊火把！"
		""
		"&e这些火把能阻止特定生物在周围一定范围内生成。&r"
		""
		"&bFor example, the diamond torch prevents the spawning of any hostile mobs!&r"
	]
	quest.5F61252B47DCBBD8.quest_subtitle: "终于，一个安全的地方了！"
	quest.5F99C2DD72C8D44A.quest_desc: [
		"&b'Security Craft'&r 是一款专注于通过添加大量新方块（如监控摄像头、视网膜扫描仪和钥匙卡）来&e提供基地安全性的模组！&r"
		""
		"&c目前，安全摄像头无法作用于物理实体，例如飞艇——所以暂时应避免这种情况！&r"
	]
	quest.5F99C2DD72C8D44A.quest_subtitle: "保卫家园！"
	quest.641E378BCB3612D4.quest_subtitle: "几个能帮助你生存的不同技巧！"
	quest.650DD766FAF5EECA.quest_desc: [
		"&n以下是本整合包中大部分（我认为的）建筑模组列表：&r"
		"- 修正案"
		"- 美化村庄 (Beautify)"
		"- 所需方块"
		"- Chipped"
		"- Chisel Reborn"
		"- 杂乱无章的"
		"- 多个“Create”附加组件"
		"- 工厂方块"
		"- 手工合成"
		"- 绵羊灯笼"
		"- 大量「Macaw's」模组"
		"- 重新雕刻的"
		"- 更多方块模组 (Some More Blocks)"
		"- 稻草人雕像"
		"- 补充物品"
		"- WaterFrames"
		"- 可能还有更多内容……"
	]
	quest.650DD766FAF5EECA.quest_subtitle: "这么多不同类型的方块……"
	quest.65ED8F97960391B9.quest_desc: [
		"有了&b'Player Revive'&r模组，&e当你死亡时，你会倒下，一个简短的计时器会开始倒数。 &r"
		""
		"&bOther players can come over and revive you, as long as they make it to you before the timer expires!&r"
	]
	quest.65ED8F97960391B9.quest_subtitle: "不能留下任何一个人！"
	quest.685F114357FAFC6B.quest_desc: [
		"你可能已经注意到了（也可能没有），&e由于“Terrain Slabs”模组，世界现在变得更加平滑了！&r"
		""
		"&bThis mod makes traversal much easier and also massively improves the overall look of the terrain!&r"
	]
	quest.685F114357FAFC6B.quest_subtitle: "一个更加流畅的世界"
	quest.6A5CC27719CB1E8C.quest_desc: [
		"&b'动态树木'&r模组让树木以更独特的方式生长，缓慢蔓延，更加自然！"
		""
		"&b这也意味着你只需要砍掉树最底下的方块，就能让它整棵树倒下！&r"
	]
	quest.6A5CC27719CB1E8C.quest_subtitle: "这感觉就像是违法的一样！"
	quest.6E269DCEC5D51107.quest_desc: [
		"钩爪模组是让前期移动变得更方便的廉价方法！"
		""
		"&b随着时间的推移，它可以进行大量升级，甚至可以让你用钩爪移动实体，比如飞艇！&r"
	]
	quest.6E269DCEC5D51107.quest_subtitle: "就像泰山一样，生活在丛林里"
	quest.6E269DCEC5D51107.title: "Grappling Hook Mod！"
	quest.7058A5BC89281274.quest_desc: [
		"&b'舒适'&r模组让你可以制作睡袋和吊床！"
		""
		"- &e睡袋能让你跳过夜晚，而无需设置重生点&r。"
		"- &eHammocks also do not set your spawn point, but allow you to skip the day instead.&r"
	]
	quest.7058A5BC89281274.quest_subtitle: "可以更多地控制一天中的时间！"
	quest.7058A5BC89281274.title: "睡过白天（或者晚上！）"
	quest.7153B50FA5E8EF56.quest_desc: [
		"&b'Better End'&r 模组彻底重制了末地维度，加入了新的结构、群系和生物！"
		""
		"&e要不造艘飞艇，好在这片新世界里航行？&r"
	]
	quest.7153B50FA5E8EF56.quest_subtitle: "一种全新的虚空等待探索！"
	quest.7153B50FA5E8EF56.title: "更好的末地！"
	quest.79B778CD574E2FD3.quest_desc: ["Immersive Engineering 是一款高质量的工程模组，专注于多方块结构，添加了水轮等众多发电配方！"]
	quest.79B778CD574E2FD3.quest_subtitle: "是时候开启你的工程之旅了！"
	quest.79B778CD574E2FD3.title: "沉浸式工程！Immersive Engineering!"
	quest.7E1686841430527B.quest_desc: [
		"为了节省宝贵的物品栏空间，你可以&b制作弹药箱来批量存储弹药！&r"
		""
		"更进一步的是，你可以在背包的“好奇”栏位中&e放置多个这样的箱子&r！"
		""
		"&e(点击物品栏中玩家图标左上方的图标)&r"
	]
	quest.7E1686841430527B.quest_subtitle: "正在节省宝贵的物品栏空间！"
	quest.7E1686841430527B.title: "好奇地支持弹药箱的功能需求"
	quest.7E8BB0BD993D649B.quest_desc: [
		"有一套超酷的盔甲，但它比你新盔甲更弱？"
		""
		"现在你可以&e穿上你的OP盔甲，但它看起来就像你旧的那套华丽盔甲一样！&r"
		""
		"&bTo do this, open your inventory and click on the cosmetic armour button to the bottom right of the player icon!&r"
	]
	quest.7E8BB0BD993D649B.quest_subtitle: "终于，时尚战胜了实用主义！"
	quest.7FA7328F6D4FF5DF.quest_desc: [
		"有个变焦模组，能让你在探索时更容易发现东西！"
		""
		"你也可以在缩放状态下使用&e滚轮&r来进一步缩放！"
		""
		"&e检查设置中的缩放键，但默认应该是 'V'！&r"
	]
	quest.7FA7328F6D4FF5DF.quest_subtitle: "有助于发现附近的物品！"
