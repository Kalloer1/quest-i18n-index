	order_index: 0
	quest_links: [ ]
	quests: [
		{
			description: [
				"&8&6世代相传，世界被伟大的战争所撕裂。但随后，虚空中出现了一个无意识的恐怖。被称作“守卫者”的异常体带来了威胁要吞噬我们的瘴气。&r"
				"&r"
				"&o&6迫于威胁，各派系签署了《门户公约》。联合议会命你，作为脆弱休战的信使，掌握遍布各地的基础机制与魔法。击退瘴气，并在其踪迹中寻找线索。&r&r"
				""
				"&4&o\"虚空生物毫无心智，但瘴气永不停歇。契约是我们唯一的盾牌。\"&r&r"
			]
			entity_vis_size: 1.0f
			icon: "iceandfire:dread_portal"
			id: "46B96E1D0D8B7BCA"
			shape: "hexagon"
			size: 3.0d
			tasks: [{
				id: "11A022A00DBEAE16"
				title: "伟大的战争"
				type: "checkmark"
			}]
			x: -0.5d
			y: -5.0d
		}
		{
			dependencies: ["46B96E1D0D8B7BCA"]
			description: [
				"&6&o若要对抗门扉之外的存在，力量无法永远借用。每位战士都必须证明自己能够独当一面，如此整体方能团结一致。找出背叛契约的叛徒，夺取这腐败之源的第一把钥匙。&r&r"
				""
				"&4&o“始于旧战的残骸。力量在首场胜利中铸就。”&r&r"
			]
			entity_vis_size: 1.0f
			id: "79F4974E23BC93AA"
			rewards: [{
				auto: "enabled"
				id: "54817231C4FAF88E"
				item: {
					Count: 1
					id: "endrem:corrupted_eye"
					tag: {
						Damage: 0
					}
				}
				type: "item"
			}]
			size: 1.5d
			subtitle: "证明你自己。"
			tasks: [{
				entity: "minecraft:pillager"
				entity_use_tag: false
				entity_vis_idle_mode: "USE_GLOBAL"
				entity_vis_offset_x: 0.0f
				entity_vis_offset_y: 0.0f
