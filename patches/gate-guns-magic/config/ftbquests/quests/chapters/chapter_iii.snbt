	order_index: 2
	quest_links: [ ]
	quests: [
		{
			dependencies: ["7978A173146F39D6"]
			description: [
				"&6&o最终的道路始于世界变得稀薄之处。大门已经抵达，但门后的寂静与其说是和平，不如说更像是某种东西在屏住呼吸。&r&r"
				""
				"&4&o\"如果踪迹到此为止，那么前方等待我们的东西，一定也在等待着我们。\"&r&r"
			]
			entity_vis_size: 1.0f
			icon: "iceandfire:dread_portal"
			id: "61CA71F2A65B0171"
			shape: "hexagon"
			size: 3.0d
			tasks: [{
				id: "5DB44384BA783EB9"
				title: "最后一步"
				type: "checkmark"
			}]
			x: 1.5d
			y: -4.875d
		}
		{
			dependencies: ["61CA71F2A65B0171"]
			description: [
				"&6&o终于，末地本身在你面前展开。空气静止，大地沉默，天空也显得异常，仿佛世界已被剥离至只剩骨架。&r&r"
				""
				"&4&o\"现在已经没有回头路了。\"&r&r"
			]
			entity_vis_size: 1.0f
			id: "5E66F197D6DA73F9"
			rewards: [
				{
					id: "0A143364C101F73C"
					type: "xp"
					xp: 5000
				}
				{
					auto: "invisible"
					id: "34F0B98E5641CC36"
					ignore_reward_blocking: true
					stage: "quest_5e66f197d6da73f9"
					type: "gamestage"
				}
			]
			size: 1.5d
			tasks: [{
				dimension: "minecraft:the_end"
				id: "5A74B5D2B6A4FAEB"
				type: "dimension"
			}]
			x: 8.625d
			y: 0.75d
		}
		{
			dependencies: ["5E66F197D6DA73F9"]
			description: [
				"&6&o巨龙陨落，但此处的胜利尚不完整。末地不会轻易空寂，其阴影仍如未竟的警告般附着于破碎的岛屿。即便如此，战胜者终将能撬开它的宝库。&r&r"
				""
				"&4&o\"一场值得的狩猎，能让被杀的巨龙留下比骸骨更多的东西。\"&r&r"
			]
			entity_vis_size: 1.0f
			icon: "minecraft:dragon_head"
			id: "023B9345FAF2ABCC"
			rewards: [
