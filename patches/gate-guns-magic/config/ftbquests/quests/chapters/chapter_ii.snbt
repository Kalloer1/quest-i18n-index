	order_index: 1
	quest_links: [ ]
	quests: [
		{
			dependencies: ["3C6500736BA4FCB9"]
			description: [
				"&6&o作为议会的使者，魔法种族向你求助。他们的占卜者困惑不已：'守护者'完全没有留下任何法力痕迹。他们断定那是一个源自虚空、没有灵魂的远古邪神。&r"
				"&r&r"
				""
				"&4&o我们无法理解这异常的力量。它没有我们种族所掌握的古老魔法。用你拥有的任何粗浅逻辑或力量，去粉碎它的爪牙吧！\"&r&r"
			]
			entity_vis_size: 1.0f
			icon: "iceandfire:dread_portal"
			id: "5DBF17299A0DE31E"
			rewards: [
				{
					id: "5D86CC3DCFD90267"
					type: "xp"
					xp: 100
				}
				{
					auto: "invisible"
					id: "1A2B3C4D5E6F7081"
					ignore_reward_blocking: true
					stage: "quest_5dbf17299a0de31e"
					type: "gamestage"
				}
			]
			shape: "hexagon"
			size: 3.0d
			tasks: [{
				id: "4EA2F82403092B2D"
				title: "故事将继续进行"
				type: "checkmark"
			}]
			title: "故事将继续进行"
			x: 13.5d
			y: -8.625d
		}
		{
			dependencies: ["5DBF17299A0DE31E"]
			description: [
				"&6&o最初的迹象来自远古力量的残骸。深埋地下的某物已被唤醒，本应长眠不醒的它，如今在岩石下再度涌动。当它坠落时，留下的不应只有寂静。&r&r"
				""
				"&4&o\"古老的遗迹不会永远埋藏，宝藏亦是如此。\"&r&r"
			]
			entity_vis_size: 1.0f
			icon: "cataclysm:desert_eye"
			id: "7E2ECADBF5753E0B"
			rewards: [
				{
					id: "5A949C67F4FE4255"
					type: "xp"
					xp: 5000
				}
				{
					exclude_from_claim_all: true
					id: "592AC75AD72D830F"
