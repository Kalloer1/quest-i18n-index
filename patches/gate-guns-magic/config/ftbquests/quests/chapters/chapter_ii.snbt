					type: "all_table"
				}
				{
					auto: "invisible"
					id: "531E755016D6D9AC"
					ignore_reward_blocking: true
					stage: "ancient_remnant"
					type: "gamestage"
				}
			]
			size: 1.5d
			tasks: [{
				entity: "cataclysm:ancient_remnant"
				entity_use_tag: false
				entity_vis_idle_mode: "USE_GLOBAL"
				entity_vis_offset_x: 0.0f
