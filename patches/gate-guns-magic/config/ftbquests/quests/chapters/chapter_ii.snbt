				value: 1L
			}]
			x: 3.75d
			y: -5.25d
		}
		{
			dependencies: ["7E2ECADBF5753E0B"]
			description: [
				"&6&o海洋随之回应。水面之上，一座古老的城邦矗立在海滨，其残破的殿堂内，某种庞大而古老的生物，随着侵蚀大地的腐化之力而苏醒。击败它将使旧日废墟暴露，可供掠夺。&r&r"
				""
				"&4&o\"即便是漂浮于海上的事物，也终将被深海所吞噬。\"&r&r"
			]
			entity_vis_size: 1.0f
			icon: "cataclysm:storm_eye"
			id: "5FB3D665CD41869F"
			rewards: [
				{
					id: "5DD9A5828FC3E8D8"
