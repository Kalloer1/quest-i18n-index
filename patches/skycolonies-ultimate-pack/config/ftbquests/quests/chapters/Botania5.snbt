	filename: "Botania5"
	title: "如果无事可做"
	subtitle: [
		"这是一系列你可以在世界挂机时完成的系列任务。"
		"这样你就可以在 Mineccraft 里尽情玩耍，再也不用找别的活动了！"
	]
	default_quest_shape: ""
	default_hide_dependency_lines: false
