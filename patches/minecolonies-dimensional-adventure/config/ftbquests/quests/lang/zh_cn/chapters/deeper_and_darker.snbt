# AI 初翻，未人工校对
{
	quest.0450060852F290CA.quest_desc: [
		"&9Deeplands&r是一个黑暗维度，与主世界的&3Deep Dark&r生物群系非常相似。"
		""
		"这片土地遍布着蓝色的 &3Sculk&r、能侦测噪音的 &3Sensors&r 和会发出尖啸的 &3Shriekers&r，一旦你制造太多噪音，它们仍会召唤出可怕的 &9&lWarden&r。"
		""
		"这片深地还栖息着更多独特的&3Sculk生物&r和植物，甚至还包含&3&lOtherside&r的主要核心结构。"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/dnd_land.png width:200 height:100 align:center}"
	]
	quest.0450060852F290CA.title: "&9深层地底世界"
	quest.0850F88E2205623F.quest_desc: [
		"&3Sculk Tendrils&r看起来和Nether里的&bTwisting Vines&r一模一样，只是全身都覆盖着sculk。"
		""
		"探索时请留意脚下，因为它们会作为稀有物品生成在 &9Deeplands&r 的深处"
	]
	quest.0850F88E2205623F.title: "&3潜行触须"
	quest.0B11EAB8D76529E0.quest_desc: [
		"巨大的&6远古城市&r是&2&l原版我的世界&r中最危险的建筑，也是进入&3&lDeeper and Darker&r模组扩展的初始入口。"
		""
		"这个深邃的宝库中遍布着 &3Sculk&r 的斑块、隐藏的宝箱，还有捕食性的 &9&lWarden&r。"
		""
		"最重要的是，建筑群的中心矗立着由坚固的 &8Reinforced Deepslate&r 建造的宏伟传送门框架。"
		""
		"在激活传送门前，收集所有能携带的稀有战利品，并保持安静，以免引起潜伏在阴影中的怪物注意。"
		""
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/all_city.png width:200 height:100 align:center}"
	]
	quest.0B11EAB8D76529E0.title: "探访一座&6远古城市"
	quest.0B718FC37699B822.quest_desc: [
		"在遍布&5Echoing Forest&r的独特&aEcho Trees&r上砍伐，就能收集到大量&aEcho Logs&r。"
		""
		"这些树很容易辨认，因为它们鲜亮的&5紫色树叶&r里藏着宝贵的斯卡勒姆光泽。"
		""
		"原木本身外层是干净的&7浅灰色树皮&r，但剥开后会发现内部是超酷的&a浅绿色原木色&r。"
		""
		"用这种材料建造的木板、栅栏或木制工具都会呈现相同的&a浅绿色&r，看起来清新宜人。"
		""
		"别忘了试试用它们制作门和活板门，会变成带有独特视觉图案的超棒装置。"
	]
	quest.0B718FC37699B822.title: "&a回响之树"
	quest.10E025288BB00657.quest_desc: [
		"在探索茂密的&b繁花洞穴&r时，你会遇到会弹跳的&b史莱姆&r，它们的行为和普通史莱姆完全一样。"
		""
		"它们体型巨大，是严重威胁，拥有 8 &4Hearts&r 的生命值，并能造成巨额伤害。"
		""
		"当你摧毁一个大型生物时，它会分裂成两到四个中型的&bSludges&r。"
		""
		"这些中等体型的生物要弱得多，只有 2 &4Hearts&r 的生命值和较低的伤害，被杀死时会分裂成两到四个小型污泥。"
		""
		"最小的尺寸完全无害，只携带半个&4健康之心&r，对你完全无法造成伤害。"
		""
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/dnd_sludge.png width:100 height:100 align:center}"
	]
	quest.10E025288BB00657.title: "&b污泥"
	quest.13B338F377951032.quest_desc: [
		"强大的&bSonorous Staff&r能让战士掌握可怕的&9&lWarden&r所使用的远程声波武器。"
		""
		"操作此物品时，需按住右键以积蓄内部能量，然后释放以向目标投射毁灭性的&b音波冲击&r。"
		""
		"这把重型武器在每次使用后有局部冷却延迟，并采用严格的耐久度计量，因此需要谨慎部署。"
		""
		"锻造法杖需要将卫道士掉落的一个&9深海之心&r、从&3&l潜行者&r掠夺的两个&3灵魂水晶&r，以及从破碎骷髅身上剥下的两个&3潜行骨&r组合起来。"
	]
	quest.13B338F377951032.title: "&b回响法杖"
	quest.16A2CC83C99B1F86.quest_desc: [
		"在繁茂的&bBlooming Caverns&r中隐藏的稀有&9Water Ponds&r里，你会发现游动的危险&9Angler Fish&r。"
		""
		"它们的行为和普通鱼基本一样，也就是说，如果把它们拖出&9水&r，它们会窒息而死。"
		""
		"它们有 3 &4Hearts&r 的生命值，一旦你踏入它们的池塘就会立即发起攻击。"
		""
		"不过别费心去钓它们了，因为击败它们根本不会掉落任何战利品。"
		""
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/dnd_fish.png width:100 height:120 align:center}"
	]
	quest.16A2CC83C99B1F86.title: "&9安康鱼"
	quest.183F6A790EC006B8.quest_desc: [
		"收割&bBlooming Stems&r时，别指望能找到普通木头；它们看起来更像是紫颂植物和竹子的奇怪混合体。"
		""
		"它们生成在&b繁花洞穴&r的深处，依靠堆叠在其他&b繁花生茎&r上才能挺立，这也是你唯一能发现它们的方法。"
		""
		"你仍然可以用斧头剥去树皮，或者把它们砍倒来制作一套定制的木板。"
		""
		"做好的木板有着超酷的、发光的&b浅蓝色&r，这意味着你用它们建造的家具、楼梯或方块都会呈现出完全相同的蓝色调。"
	]
	quest.183F6A790EC006B8.title: "&b绽放的木材"
	quest.196003E1486ABB31.quest_desc: [
		"要将你的强化&c下界合金&r盔甲和武器升级为精英&9潜声守卫装备&r，你必须获得稀有的&9锻造模板&r。"
		""
		"这些模板模块都隐藏在散布于&6远古都市&r遗迹中的古代宝箱里。"
		""
		"一旦你恢复了一个模板，就可以在工作台里用7个钻石和一个标准的&3Sculk Block&r无限复制它。"
	]
	quest.196003E1486ABB31.title: "&9守卫者升级模板"
	quest.1A2EA742FDED54FF.quest_desc: [
		"在&5回响森林&r里，放眼望去，森林地面都覆盖着&5回声土壤&r。"
		""
		"不要指望这个方块会像家乡的普通&2草&r或泥土那样，因为它们的功能截然不同。"
		""
		"最重要的特性是严格的增长规则：这里不能种植普通树木，因为土壤只会支持并生长定制的&5Echoing Saplings&r。"
	]
	quest.1A2EA742FDED54FF.title: "&5回声土壤"
	quest.1BFE6745F49B4AB0.quest_desc: [
		"你会发现，Sculk Gleam 方块的作用和你在下界找到的发光蘑菇灯完全一样。"
		""
		"需要的话你可以徒手把它们挖掉，但拿一把趁手的锄头能以闪电般的速度把它们砸碎。"
		""
		"紧盯&5Echoing Trees&r的树枝可以轻松采集，或在洞穴潜水时保持警惕，因为它们很少直接从地下墙壁中长出。"
	]
	quest.201E3E41018F9521.quest_desc: [
		"你会发现 &6Gloomy Cacti&r 遍布灼热的 &cOvercast Columns&r，它们的特性几乎和普通的 &2Cacti&r 完全一样。"
		""
		"它们在灼热中茁壮成长，无需一滴&9水&r就能长高，而且一旦碰到锋利的边缘，绝对会伤害你。"
		""
		"那么，它们之间到底有什么区别吗？"
		""
		"是的，有个超棒的快捷方式：把这些火山植物扔进营炉里，就能熔炼成一堆方便的&6橙色染料&r，而不是普通的&2绿色&r染料！"
	]
	quest.201E3E41018F9521.title: "&6忧郁仙人掌"
	quest.21398F45428CD1D1.quest_desc: [
		"探索时注意天花板，留意长在 &bBlooming Caverns&r 内长长的 &bGlowing Vines&r 上的 &6Bloom Berries&r。"
		""
		"当你在它们下方穿行时，会看到这些亮晶晶的果实垂挂着，等着你走近，用简单的右键就能从&bVine&r上摘下它们。"
		""
		"务必把能塞进背包的所有浆果都收起来；这种生存水果是你在整个 &3&lOtherside&r 维度里唯一能找到的野生食物来源。"
	]
	quest.21398F45428CD1D1.title: "&6绽放浆果"
	quest.35629CB10DBDE340.quest_desc: [
		"&6远古神殿&r是一座位于&9深层地&r维度中的金字塔。"
		""
		"由深色的 &8Deepslate&r 和蓝色的 &3Sculk&r 建造，由噪音触发的 &3Sculk Sensors&r 和尖叫的 &3Shriekers&r 守卫。"
		""
		"搜刮顶层的箱子和花瓶，然后挖掘&6金字塔&r的中心，寻找稀有的&e金块&r。"
		""
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/dnd_temple.png width:200 height:100 align:center}"
	]
	quest.35629CB10DBDE340.title: "&6远古神殿"
	quest.36149E69A8C264E4.quest_desc: [
		"你可以在繁茂的&b开花洞穴&r中散落的稀有&9水池&r上，发现独特的&b冰百合&r。"
		""
		"植物由两个不同的部分组成：漂浮的基座和&b冰花&r本身。"
		""
		"底部的浮板漂浮在 &9水&r 上，足够坚固可供你踩踏和用作桥梁，而漂亮的花朵则直接生长在它上面。"
		""
		"如果你想收集它们并带回大本营，请务必带上剪刀，以便干净利落地收割。"
	]
	quest.36149E69A8C264E4.title: "&b冰百合花"
	quest.39100B3867E9C01E.quest_desc: [
		"在探索滚烫的 &cOvercast Columns&r 时，请紧盯地面，留意 &cGloomy Geysers&r。"
		""
		"踏上这些不稳定的方块之一，会立即把你炸飞到空中。"
		""
		"准备好滑翔翼、水桶或缓降药水，因为爆炸无法让你免受落地时的摔落伤害。"
		""
		"如果你想安全地捡起它们带回家用作简易电梯，请务必用带有丝绸之触附魔的镐来采集。"
	]
	quest.39100B3867E9C01E.title: "&c忧郁的间歇泉"
	quest.39BED5DD9D24F98E.quest_desc: [
		"探索深处时，把 &3Sculk Grime&r 当作该模组自定义的普通黏土即可。"
		""
		"你可以在几个不同的生物群系中偶然发现这些土块，用铲子挖掘它们会奖励你一些 &3Grime Balls&r。"
		""
		"你可以轻松地将这些杂乱的土块重新压成坚固的 &3Sculk Grime&r，或者将其提炼成干净的 &3Grime Bricks&r，为你的基地增添一番酷炫的新面貌。"
	]
	quest.39BED5DD9D24F98E.title: "&3潜行泥土块"
	quest.3CF2DFB7F0CE065B.quest_desc: [
		"&cOvercast Columns&r 是一个炽热的、&6橙色&r的生物群系，比该维度中的任何其他区域都要炎热得多。"
		""
		"在这片火山地带，普通的蓝色潜声被&c幽暗潜声&r取代，典型的石头也被深色的&c幽暗板岩&r取代。"
		""
		"地面有灵魂沙、灵魂土，还有漂浮在巨大&c岩浆&r池上的危险&c岩浆块&r。"
		""
		"由于酷热导致普通怪物无法生成，你唯一的伴将是几种稀有的本土植物。"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/dnd_column.png width:200 height:100 align:center}"
	]
	quest.3CF2DFB7F0CE065B.title: "&cOvercast Columns"
	quest.3D579A1F7EFEDD5C.quest_desc: [
		"&9&l坚守者&r是&2&lMinecraft&r中最难对付的BOSS，栖息于游戏中最危险的建筑群深处。"
		""
		"当声学 &3Sculk Shrieker&r 被触发三次，或在首次生成后受到任何扰动时，这种顶级掠食者会立即出现。"
		""
		"这头巨兽拥有高达 500 &4心&r的巨额生命值，可通过重击近战或远程的 &b音波冲击&r 造成致命伤害。"
		""
		"然而，这种怪物存在严重的发育缺陷：它完全失明。当有生物靠近时，它仅能通过声音振动或嗅觉追踪来发现猎物，因此保持23格的防御距离能有效躲避。"
		""
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/warden_roar.png width:100 height:100 align:center}"
	]
	quest.3D579A1F7EFEDD5C.title: "击杀 &9&lWarden"
	quest.44F9B8F285546B2C.quest_desc: [
		"你可以在繁茂的&b开花洞穴&r的地板上搜寻到大量的&b开花苔藓&r。"
		""
		"它就静静地躺在地上，等着你走过来把它敲碎，加入你的收藏。"
		""
		"请注意，这种植物与家乡的普通&2苔藓&r略有不同；喂食骨粉时它不会蔓延到相邻方块，也没有任何合成配方。"
	]
	quest.44F9B8F285546B2C.title: "&b绽放的苔藓"
	quest.45C9D975E3731DFE.quest_desc: [
		"要制作强大的&9强化回响碎片&r，你需要在世界各地追踪三种关键材料。"
		""
		"你的首个也是最容易的目标是一叠&7幻影膜&r，它们由连续几个晚上不睡觉后开始出现的飞行幻影所掉落。"
		""
		"接下来，你需要稀有的&9Echo Shards&r，可以通过洗劫散布在黑暗&6Ancient Cities&r中的宝箱轻松囤积。"
		""
		"你的最终挑战是收集&9Warden Carapaces&r，这是击败恐怖boss&9&lWarden&r后获得的可靠掉落物。"
	]
	quest.45C9D975E3731DFE.title: "&9加固回响碎片"
	quest.4A01C5F5DCF32C19.quest_desc: [
		"传奇的&3Soul Elytra&r拥有与标准&8Elytra&r完全相同的滑翔机制，但经过大幅升级，具有更高的耐久度和额外的护甲保护。"
		""
		"这种高级飞行框架无法使用传统的&7幻影膜&r进行修复，这意味着你必须依靠修补等工具附魔来恢复其完整性。"
		""
		"建造此物品需要将基础&8Elytra&r与四块被Shattered掉落的&3Sculk Bones&r、两份从Sculk Snappers或Leeches采集的&3Soul Dust&r，以及一颗从&3&lStalker&r首领掠夺的发光&3Soul Crystal&r相结合。"
	]
	quest.4A01C5F5DCF32C19.title: "&3灵魂鞘翅"
	quest.4D57A07592AED307.quest_desc: [
		"打碎远古花瓶时要小心，打碎错误的一个会召唤出名为&3&lStalker&r的致命首领。"
		""
		"他拥有 200 &4心&r的巨大生命值，是主要威胁，并有专属的 boss 条来追踪其生命。"
		""
		"如果你想收集珍贵的&3Soul Crystals&r，击败这个怪物是一个必经的里程碑。"
		""
		"他速度极快，一旦抓住你便会造成毁灭性伤害，但幸运的是，他和&9&lWarden&r一样，都完全失明。"
		""
		"不过，他的听力惊人，这意味着他会直接朝你发出的任何声音冲刺过去。"
		""
		"小心他的特殊招式：他会用普通攻击猛砸你，触发大范围爆炸，或者召唤烦人的&3Sculk Leeches&r来啃食你的生命值。"
		""
		"他讨厌外来者，会立即攻击任何非本土 &3Sculk&r 生物的动物或怪物。"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/dnd_stalker.png width:100 height:200 align:center}"
	]
	quest.4D57A07592AED307.title: "&3潜行者"
	quest.56D41A4605C42EB5.quest_desc: [
		"在穿越炎热的 &cOvercast Columns&r 时，留意发光橙色的 &6Crystallized Amber&r 囊袋。"
		""
		"如果你想采集这些方块并添加到你的收藏中，那么你一定需要一把附了丝绸之触的镐。"
		""
		"它们没有重要的合成配方或生存用途，但作为营地周围的装饰方块，效果绝对惊艳。"
	]
	quest.56D41A4605C42EB5.title: "&6结晶琥珀"
	quest.5866438E5D19AB69.quest_desc: [
		"砸碎远古花瓶时要保持警惕，因为好斗的&3Sculk Leeches&r有时会直接从里面冲出来。"
		""
		"当它们成对出现并伏击你时，会给你带来一个不小的惊吓。"
		""
		"它们极其弱小，生命值只有 2 &4Hearts&r，但它们会毫不犹豫地冲向你并发起攻击。"
		""
		"一旦出现就务必消灭它们，因为它们死亡后会轻松掉落&3Soul Dust&r。"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/dnd_leech.png width:100 height:100 align:center}"
	]
	quest.5866438E5D19AB69.title: "&3潜行吸虫"
	quest.59AF80E8EE17C769.quest_desc: [
		"&5回响森林&r是一种简单的生物群系，生长着特殊的&5回响之树&r。"
		""
		"你可以砍伐这些树木来收集&a原木&r用于制作，它们的&5树叶&r会掉落树苗和一种名为 Sculk Gleam 的发光材料。"
		""
		"地面完全被&5回响泥土&r覆盖。这些独特的方块仅用于装饰，无法翻耕为农田或用作普通泥土。\""
		""
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/dnd_forest.png width:200 height:100 align:center}"
	]
	quest.59AF80E8EE17C769.title: "&5回响森林"
	quest.5C983A41886A2B75.quest_desc: [
		"要逃离这个黑暗维度并安全返回&2&l主世界&r，你可以穿过与你进入时完全相同的传送门返回。"
		""
		"只需将一件&9深海之心&r遗物，放置于由&8加固深海板岩&r建造的传送门框架上。"
		""
		"幸运的是，你无需再击杀一个卫道士来寻找这把钥匙；一个备用框架已在&6远古神殿&r的最底部为你建造完毕。"
	]
	quest.5C983A41886A2B75.title: "家，温馨的家！"
	quest.5CCF573B67317591.quest_desc: [
		"在探索茂密的&b繁花洞穴&r时，你会遇到许多&b发光根茎&r。"
		""
		"别试着把它们当梯子用，因为它们无法攀爬，也别费心收集它们当晚餐，因为它们不会掉落任何食物。"
		""
		"它们看起来纯粹是装饰性方块，旨在为洞穴增添一些不错的氛围。"
	]
	quest.5CCF573B67317591.title: "&b发光的根须"
	quest.5E287410EE969244.quest_desc: [
		"你将在 &3&lOther Side&r 的不同生物群系中遇到危险的 &9Shattered&r 怪物。"
		""
		"把它们想象成迷你&9&l卫道士&r——它们完全失明，依靠潜声振动来追踪你在黑暗中的位置。"
		""
		"它们极度厌恶外来者，会立即攻击任何非本土潜行生物的动物或怪物。"
		""
		"这些野兽极其强壮，有 50 &4Hearts&r 的生命值，而且攻击力惊人，所以尽量不要一次性招惹一大群。"
		""
		"如果能击败它们，请务必收集它们掉落的&9Sculk Bones&r，因为之后的重要合成配方会用到它们。"
		""
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/dnd_shattered.png width:100 height:150 align:center}"
	]
	quest.5E287410EE969244.title: "&9破碎的碎片"
	quest.60721C9B94B36C24.quest_desc: [
		"你会在&3&l异世界&r的生物群系中看到长长的、令人毛骨悚然的&3潜行者蜈蚣&r在爬行。"
		""
		"它们是中立生物，拥有 10 &4Hearts&r 的生命值，也就是说，只要你不招惹它们，它们就不会来找你麻烦。"
		""
		"不过，如果你攻击其中一只，整个狼群会像愤怒的狼一样立刻围攻你。"
		""
		"由于它们只会掉落基础的&a经验值&r和一点线，在追踪时最好直接绕过它们。"
		""
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/dnd_centipede.png width:100 height:100 align:center}"
	]
	quest.60721C9B94B36C24.title: "&3潜行者蜈蚣"
	quest.67D38E8A57949B34.quest_desc: [
		"探索漆黑的&9Deeplands&r隧道时，小心脚下出现的&3Sculk Jaws&r。"
		""
		"如果你不小心踩到这些隐藏陷阱，它们会咬住你的腿，把你拽进地板里，在你被困住时造成痛苦的伤害。"
		""
		"如果你想安全地挖它们带回家用作基地防御，请务必用带有丝绸之触附魔的工具来采集。"
	]
	quest.67D38E8A57949B34.title: "&3潜行颌骨"
	quest.68446510A1B0D9B8.quest_desc: [
		"由于绿色植物过度生长，&bBlooming Caverns&r的功能与主世界的繁茂洞穴非常相似。"
		""
		"你会发现植被遍布每个表面——从天花板垂下，从地板向上攀爬，直接从&9水&r中冒出，还有一些完全无法生长的干枯品种。"
		""
		"地下景观由独特的&b开花潜声石&r和柔软的&b开花苔藓&r斑块组成。"
		""
		"Travelers should note that this biome contains active water ponds, serving as the absolute only source of open &9Water&r anywhere in this entire &3&lDimension&r."
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/dnd_cave.png width:200 height:100 align:center}"
	]
	quest.68446510A1B0D9B8.title: "&b繁花洞穴"
	quest.6BB948F44B0950E8.quest_desc: [
		"除了燃烧的 &cOvercast Columns&r，你几乎会在每个生物群系的墙壁和地板上找到 &3Sculk Stone&r。"
		""
		"它能满足你所有的建造需求，行为与主世界的普通&7石头&r完全相同。"
		""
		"你可以在熔炉里轻松烹饪它的原矿版本，以获得光滑的 &3Sculk Stone&r，从而解锁一大堆超酷的新建筑材料。"
		""
		"唯一真正的缺点是，你无法用它来制作石制工具。"
		""
		"不过说实话，你管那么多干嘛？你可是击败了可怕的&9&lWarden&r才来这里的，肯定不需要原始的石制装备了！"
	]
	quest.6BB948F44B0950E8.title: "&3潜行石"
	quest.6E38CF6E7360E9CA.quest_desc: [
		"击败&9&l潜行者&r能获得许多宝贵资源，但&9深海之心&r仍是你的首要目标。"
		""
		"你必须将这件神器放置在&8Reinforced Deepslate&r框架上，才能激活通往&3&lOtherside&r的次元传送门。"
		""
		"确保传送门框架内部及周围的所有方块都被清除，否则传送门将无法点燃。"
		""
		"该生物还会掉落坚固的&9Warden Carapace&r和稀有的&9Echo Shards&r，这些是后期制作高级装备和工具的必要组件。"
	]
	quest.6E38CF6E7360E9CA.title: "&9深海之心"
	quest.6E901EF1CB411088.quest_desc: [
		"传奇的&9卫道士盔甲&r是&c下界合金&r装备的直接升级版本。"
		""
		"锻造一件需要 &9Warden 升级模板&r、&9加固回响碎片&r，以及在锻造台中使用你现有的 &c下界合金盔甲&r。"
		""
		"每件装备都比旧装备多一个护甲点数和额外的护甲保护。"
		""
		"然而，致密合金会完全移除你默认的击退抗性数值。"
		""
		"外观上，这套装备比暗钢更具威慑力。"
		""
		"厚重的&9头盔&r上长着与&9&l坚守者&r头冠相配的巨大角，而厚实的&9胸甲&r中央则镶嵌着发光的核心。"
	]
	quest.6E901EF1CB411088.title: "&9潜行者&r盔甲"
	quest.716FF64ACF896D50.quest_desc: [
		"穿过炎热的&cOvercast Columns&r时，你会发现标准的灰色石头不见了，取而代之的是&cGloomslate&r。"
		""
		"此方块在所有采矿和建筑需求上，与普通的 &3Sculk Stone&r 功能完全相同，但颜色明显更深，呈泥泞的棕色。"
	]
	quest.716FF64ACF896D50.title: "&c灰泥板"
	quest.726A627BD7654E0C.quest_desc: [
		"将装备从&c下界合金&r升级到&9潜声者&r级，对这些工具的整体功能几乎没有影响。"
		""
		"该镐的挖掘速度和采集等级与之前的镐完全相同。"
		""
		"铲子仍然可以挖掘路径，锄头也能以相同的速度将泥土变为耕地。"
		""
		"唯一显著的改进是整个工具套装的攻击伤害值的全面上调。"
		""
		"这项战斗增强意味着，&9Warden Hoes&r的默认伤害高于任何在&2&lVanilla&r中找到的基础武器或锄头。"
	]
	quest.726A627BD7654E0C.title: "&9卫道士&r 工具"
	quest.72EC845C19645AFC.quest_desc: [
		"&3Sculk Vines&r 的行为和你在下界看到的 &4Weeping Vines&r 完全一样，只是被 sculk 完全变异了。"
		""
		"在探索繁茂的 &bBlooming Caverns&r 或深入 &9Deeplands&r 时，你可能会看到它们悬挂在天花板上。"
	]
	quest.72EC845C19645AFC.title: "&3潜行藤本植物"
	quest.736F4A43EEBDD7B3.quest_desc: [
		"别看它们个头小，&3Sculk Snappers&r可是脾气超爆的迷你小怪物。"
		""
		"我看到它们在 &9Deeplands&r 的黑暗隧道里游荡，也藏在茂密的 &cBlooming Caverns&r 里。"
		""
		"They are pretty easy to take out since they only have 6 &4Hearts&r of health, and defeating them rewards you with a handy drop of &3Soul Dust&r."
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/dnd_snapper.png width:100 height:100 align:center}"
	]
	quest.736F4A43EEBDD7B3.title: "&3潜行捕手"
	quest.76F14C2B866B4EAD.quest_desc: [
		"神秘的&3&l异次元&r是所有&3潜行者&r材料和&3潜行者生物&r的最终诞生地，包括灾难性的&9&l潜行者守卫&r。"
		""
		"探索意味着会遇到许多危险、遥远的远古巨兽的表亲，但这个黑暗领域也有显著的优势。"
		""
		"探索地形可获得大量独特的建筑材料和稀有物品，还有无尽的 &3Sculk&r 块，可以采集获得海量 &aXP&r。"
		""
		"拿起高阶锄头，踏上前往&3&l异世界&r核心的探险之旅。"
	]
	quest.76F14C2B866B4EAD.title: "The &3Otherside"
	quest.774D61FEFABEFD9A.quest_desc: [
		"在&9Deeplands&r里小心脚下，因为踩到&3Infested Sculk&r会召唤出名为Shriek Worm的危险迷你Boss。"
		""
		"这些巨大的地下害虫拥有高达 100 &4Hearts&r 的生命值。"
		""
		"靠得太近的话，它会突然冲出来咬你，造成巨额伤害。"
		""
		"好消息是，如果你跑开并保持足够距离，它就会直接退回地板里去。"
		""
		"因为它们不会掉落稀有材料，奖励的&aXP&r也很少，所以最好的办法是完全避免触发它们。"
		""
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/dnd_worm.png width:100 height:200 align:center}"
	]
	quest.774D61FEFABEFD9A.title: "尖叫蠕虫"
	quest.78BCED8699ADEDF4.quest_desc: [
		"你可以在合成台里将&3Soul Dust&r直接熔炼进普通玻璃，制造出实用的&3Soundproof Glass&r。"
		""
		"这些定制玻璃板能像厚羊毛块一样隔绝噪音和振动。"
		""
		"如果你将这种玻璃板放在能侦测噪音的 &3Sculk Sensor&r 或能触发陷阱的 &3Shrieker&r 上方，它们就无法听到你在附近发出的任何声音。"
		""
		"用这种玻璃代替羊毛的好处是，它完全透明，让你能观察到传感器，而不会意外触发它们。"
	]
	quest.78BCED8699ADEDF4.title: "&3隔音玻璃"
	quest.7CBAA67204CC258C.quest_desc: [
		"可怕的&9&l卫道士&r仅靠拳头和声波攻击，但旅人可以将其遗骸打造成特制刀剑和战斧。"
		""
		"&9Warden Sword&r 和 &9Warden Axe&r 都可以通过在锻造台用 &9Reinforced Echo Shard&r 和 &9Warden Upgrade Template&r 强化其 &cNetherite 版本&r 来制作。"
		""
		"每件武器都能造成整整一 &4心&r 的额外战斗伤害，并且比标准装备耐用得多。"
		""
		"在伐木方面，重型斧头砍树依然完全高效。"
	]
	quest.7CBAA67204CC258C.title: "&9卫道士&r武器"
	quest.7FF3EA602FE7A546.quest_desc: [
		"特殊的&3Sculk Transmitter&r是一种仅在&6Ancient Temple&r的宝箱中才能发现的稀有物品。"
		""
		"修复后，这个机械装置将成为远程物流的重要工具。"
		""
		"要初始化设备，你必须对着装有内部接口的任何功能性方块（如储物箱、工作台或熔炉）进行右击+Shift。"
		""
		"此操作将设备永久绑定至该特定方块。"
		""
		"校准后，该工具可让您从世界任何地方远程访问和管理该存储菜单。"
		""
		"要清除内存矩阵并解除方块绑定，只需手持工具在空气中右键单击即可。"
	]
	quest.7FF3EA602FE7A546.title: "&3潜行信标"
}
