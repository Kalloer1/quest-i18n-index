# AI 初翻，未人工校对
{
	quest.0B1DF8A040826D87.quest_desc: [
		"现在你有了 &cRossinite&r，可以将其与 &aBenitoite&r 混合，创造出 &dInsanite&r 锭。"
		""
		"&a本尼托石矿石&r可以在下界中找到。"
	]
	quest.14E5349DD740D026.quest_desc: [
		"要将燃料插入反应堆，你需要选择一个带有 &9Reactor Solid Access Port&r 的侧面，并从物品栏中泵入 &eUranium&r。"
		""
		"最简单的方法是使用像 &aStorage Drawer&r 或者甚至是带有顶部连接着 &9Item Pipe&r 的 &aChest&r，如下图所示。\\n"
		""
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/import.png width:150 height:150 align:center}"
	]
	quest.14E5349DD740D026.title: "被动反应堆燃料补给"
	quest.186731580B14F9D2.quest_desc: [
		"要与我们的涡轮机互动，我们需要几个&6端口&r。"
		""
		"&9流体端口&r用于输入像&b蒸汽&r这样的蒸汽，或排出像&9水&r这样的废气。"
		""
		"因此，你的涡轮机需要两个这样的部件。"
		""
		"&cPower Tap&r可以提取能量，是完成多方块结构所必需的。"
	]
	quest.186731580B14F9D2.title: "涡轮港 (Port O' Turbine)"
	quest.2598273041353196.quest_desc: [
		"建造 &aReprocessor&r 时，你需要至少一个 &eCollector&r 和 &9Waste Injector&r。"
		""
		"&eReprocessor Collector&r必须放置在结构底部中央。"
		""
		"&9废料注入器&r必须放在顶面的中心，也就是你用来输送或投入废料（如&9青金石锭&r）的地方。"
	]
	quest.2598273041353196.title: "正在导入废料"
	quest.25D4406CB86C8CBB.quest_desc: [
		"既然我们已经从反应堆收集了一些&9废料&r，那么进阶的一部分就需要你将获得的某些锭进行“液化”处理。"
		""
		"你知道这意味着什么吗？\\n\\n我们需要制作一个&a流体化器&r！"
		""
		"主要组件是 &aFluidizer Controller&r。建造完成后，右键点击即可打开界面。"
		""
		"在这里，你可以开启或关闭它，查看内部物品和当前电量。"
	]
	quest.2A20000FAEC2E16A.quest_desc: [
		"要从反应堆中提取能量或物品，甚至输入燃料，你需要这些&c必需&r的方块。"
		""
		"&cPower Tap&r 能让你“接入”&9被动&r反应堆产生的能量。你可以连接管道和电缆来提取其中的能量。"
		""
		"每个反应堆都需要 &aAccess Ports&r，既可以用它输入燃料，也可以用来提取废料。通常每个反应堆准备 2 个，分别用于这两种操作，是个不错的选择。"
	]
	quest.2A20000FAEC2E16A.title: "与反应堆进行交互"
	quest.2AF31F1769085641.quest_desc: [
		"&aReprocessor&r 是一个 3x3x7 的多方块结构，有特定的规则来完成该多方块结构的建造。"
		""
		"该多区块结构的核心是 &a控制器&r，只要不在框架上，就可以放置在任意垂直面上。"
	]
	quest.2D592669F4D41793.quest_desc: ["和反应堆一样，框架必须用&dCasings&r建造，但墙壁可以用&9Turbine Glass&r来代替！"]
	quest.2D592669F4D41793.title: "玻璃展示柜"
	quest.354086C858E10154.quest_desc: [
		"既然我们的初级反应堆产出了青金石，就需要一种方法将废料再加工成有用的东西。"
		""
		"为此，我们需要建造另一个多方块结构：&a再处理器&r。"
		""
		"这需要大量的青金石，快开始囤货吧！你可能还需要升级到更大的反应堆。"
	]
	quest.354086C858E10154.title: "废料再加工"
	quest.3C3FE45CEF5E242B.quest_desc: [
		"其他&aReprocessor Parts&r在建造时有固定位置，但这三个部件只要不在框架上，就可以放在任何垂直面上！"
		""
		"&cPower Port&r 用于为多块机器提供动力以处理废料。"
		""
		"&9流体注入端口&r用于注入所需的液体，具体取决于所注入废物的类型。"
		""
		"对于青金石，这意味着水！\\n\\n&a输出端口&r用于输出再加工后的材料。"
		""
		"你可以右键手动取出材料，也可以用管道实现自动化。"
	]
	quest.3F9D553C9FA64F2A.quest_desc: [
		"反应堆是多方块结构，这意味着你可以创建自己定制的尺寸！\\n\\n如果使用&a基础反应堆部件&r，你能建造的最大尺寸反应堆是5x5x5。"
		""
		"使用&eReinforced Reactor Parts&r能制作的最大的&lBiggest&r Reactor是32x32x48。影响反应堆总产出的变量有很多，所以一定要多尝试！"
		""
		"一些总体提示：\\n\\n反应堆越高，能容纳和燃烧的燃料就越多，因为燃料棒更多，意味着总功率更高。这也意味着更高的&c燃烧速率&r。"
		""
		"反应堆越宽，效率越高，前提是你不要向设计中添加更多燃料棒。这意味着整体消耗更少。"
	]
	quest.3F9D553C9FA64F2A.title: "扩建反应堆"
	quest.4415C9F8DA2D7E68.quest_desc: [
		"有了青金石，我们就能制造涡轮的核心——&9涡轮控制器&r。"
		""
		"涡轮机是多方块结构，就像反应堆一样！"
		""
		"它们输入由&dActively Cooled&r Reactors产生的&7Steam&r等蒸汽来创造海量电力！"
		""
		"我们需要一些其他材料才能建造我们的第一个。"
		""
		"注意：基础涡轮零件最多只能用来建造尺寸为 5x5x10 的涡轮。"
		""
		"要建造更大的涡轮机，你必须使用&a加固涡轮机零件&r。"
	]
	quest.4415C9F8DA2D7E68.title: "正在创建涡轮机"
	quest.4745152F6FF242B3.quest_desc: ["当反应堆燃料耗尽时，会产生&9废料&r或&d反应物&r，这些也需要提取。这就是另一个固体访问口的用途！务必将其设置为输出，然后将其连接到某种存储设备中。"]
	quest.4745152F6FF242B3.title: "物尽其用"
	quest.476755275B948A5F.quest_desc: [
		"反应堆还可以用来加热像水这样的&b冷却剂&r来产生&b蒸汽&r，例如&b水蒸气&r。"
		""
		"为此，你需要建造一个加固反应堆。"
		""
		"建造方式和你的3x3x3反应堆一样，但所有部件都需要是&aReinforced Reactor Parts&r。"
		""
		"另外建议尺寸要大于3x3x3。"
		""
		"要输入冷却剂，你需要一个 &9Forge Fluid Port&r。"
		""
		"这将把水等流体导入反应堆，并用于导出反应堆中产生的蒸汽。"
	]
	quest.476755275B948A5F.title: "主动冷却反应堆"
	quest.4AD8363D7359A072.quest_desc: [
		"我们将建造一个尽可能小的被动反应堆，即 &93x3x3&r。任务要求中列出了建造一个所需物品的确切数量。\\n\\n建造时，先用 Casings 搭建一个 3x3x3 的框架。在底部中心的格子上，可以使用另一个 Reactor Casing。每个外壁都需要安装一个 &9reactor component&r，例如 Active Power Tap 或 Solid Access Port。"
		""
		"建造的每个反应堆都需要1个&6Reactor Controller&r，通常放在前墙中央。接着，在多方块中心放置1个&aFuel Rod&r，并在其上方的顶面放置1个&eControl Rod&r。\\n\\n你需要一种输入和输出废料的方法，这可以通过使用&9Reactor Solid Access Ports&r来实现。对于这个建造，请在左侧和右侧各放置一个。\\n\\n要提取电力，我们将把&cActive Power Tap&r放在后墙的中间。放置完成后，反应堆就建造完毕了！你现在可以右键点击控制器来打开界面并启动它！\\n\\n注意：使用&aBasic Reactor Parts&r能建造的最大反应堆是5x5x5。要建造更大的反应堆，你需要使用&eReinforced Reactor Parts&r。"
		""
		"3x3x3 的反应堆看起来会是这样：\\n"
		""
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/3x3.png width:100 height:100 align:center}"
	]
	quest.4AD8363D7359A072.quest_subtitle: "学习基础知识"
	quest.4AD8363D7359A072.title: "&d我们的第一座反应堆"
	quest.4B9E9497E44D0096.quest_desc: [
		"要建造反应堆，你首先需要制作&6反应堆外壳&r。"
		""
		"这些构成了反应堆的框架和墙壁，不过如果你想看到反应堆内部，墙壁也可以用&9Reactor Glass&r来替换。"
		""
		"供未来参考，当某个部件显示“基础”时，意味着它只能与其他基础部件搭配使用。"
		""
		"基础部件也只能用来建造较小的反应堆，因为它们有特定的尺寸限制。请记住这一点！"
	]
	quest.4B9E9497E44D0096.title: "反应堆建筑组件"
	quest.4ED36AA3766E842B.quest_desc: [
		"此时不要建造最小的涡轮机，最好是根据你的&9反应堆&r的设计来建造涡轮机。"
		""
		"首先，你需要建造一台能应对反应堆&9蒸汽产生率&r的涡轮机。"
		""
		"要发挥最大威力，它也需要保持在900RPM或1800RPM。"
		""
		"这需要大量尝试不同的线圈、刀片数量和涡轮机的整体尺寸！"
		""
		"注意：要完成此任务，你需要创建一个任意大小的&d任务界面&r。"
		""
		"放置后，右键屏幕选择此任务作为要求，然后将能量输入任务屏幕方块以填充并完成该任务。"
	]
	quest.4ED36AA3766E842B.title: "&d涡轮机 The Turbine"
	quest.4FA6BEA4E646B742.quest_desc: [
		"在开始建造反应堆之前，我们需要先冶炼一些煤炭或木炭来制造&9石墨锭&r。"
		""
		"石墨和铁是制造反应堆的主要材料之一。"
	]
	quest.4FA6BEA4E646B742.title: "用于外壳的石墨 (Graphite for Casings)"
	quest.501C6B7580453410.quest_desc: [
		"&a流体化器&r是一种可定制的3x3x3最小尺寸的多方块结构。"
		""
		"和其他的多方块一样，框架需要用 Casings 制作，而正面可以用 Glass 制作。"
	]
	quest.55DCA040C84DCEF3.quest_desc: [
		"如果你想获得 &aFluidizer&r 生产的物品，需要在其中一个面上安装一个 &aOutput Port&r。"
		""
		"&a流体化器&r需要电力才能运行，因此需要 &c动力端口&r 来完成结构。"
	]
	quest.5914D015D8543875.quest_desc: [
		"&a流体化器&r有3种模式：固体转流体、两种固体合成流体，或两种流体合成新流体。"
		""
		"这完全取决于你为多方块结构使用的&a注入器&r类型。"
		""
		"例如，如果你想将 &dBlutonium&r 转换为流体，可以使用 1 个 &aSolid Injector&r。"
		""
		"如果你想将两个实体组合成新的东西，就需要用 2 个 &aSolid Injectors&r 来建造多区块结构。"
		""
		"如果你想混合两种流体，需要使用 2 个 &9流体注入器&r。"
		""
		"这看起来可能很复杂，但对进度很重要。例如，你首先需要将 Magentite 在 Fluidizer 中转化为流体，然后用 Ludicrite 将其送入 &aReprocessor&r 以创造 Ridiculite。"
	]
	quest.5A615BB74A5CD332.quest_desc: [
		"使用&aReprocessor&r，我们可以将目前制作的所有东西组合起来，制造出一些新的锭。"
		""
		"注意：你可能需要一个 &9Fluidizer&r 来完成这一步！"
	]
	quest.5AD80D3242DD3F60.quest_desc: ["本模组中最难获得的材料之一！"]
	quest.67AFCBCE7AAC3089.quest_desc: [
		"要让涡轮机运转起来，我们需要这些&c必需&r的组件："
		""
		"- &9转子轴承&r放置在涡轮轴的末端。可以是任意一面，但这决定了轴从何处伸出。通常放置在底面的中心位置。"
		""
		"- &e转子轴&r从一个转子轴承延伸到涡轮的另一侧，直至单个涡轮外壳方块，从而构成涡轮的轴。"
		""
		"- &9转子叶片&r使转子旋转。它们安装在转子轴上，长度可包含多个方块。每片叶片能处理一定量的蒸汽，并根据反应堆的生产率决定所需叶片数量。"
		""
		"这是一个涡轮垂直竖井的示例，顶部放置了铅制涡轮线圈。"
		""
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/maxbasicturbine.png width:150 height:150 align:center}"
	]
	quest.67AFCBCE7AAC3089.title: "涡轮机主轴"
	quest.69642A3618E86DED.quest_desc: [
		"要建造 &aReprocessor&r 的框架，你需要大量的 Casings。这也意味着需要大量的 Cyanite。"
		""
		"先建造一个宽3格、深3格、高7格的空心结构。这就是框架。"
		""
		"操作正确的话，底部和顶部中间会各有一个空位。"
		""
		"垂直面可以使用 &aReprocessor Glass&r 或所需的 &aReprocessor&r 部件，如 Power Port、Controller 等。"
		""
		"如果你想看看框架的样子，可以查看下面的图片！"
		""
		"再处理器多区块结构的框架："
		"{image:ftb_quests:textures/gui/ftb_quests/images/reprocessorframe.png width:150 height:175 align:center}"
		""
		""
		"一个完全建造的再处理器："
		"{image:ftb_quests:textures/gui/ftb_quests/images/reprocessorfull.png width:150 height:150 align:center}"
	]
	quest.69642A3618E86DED.title: "框架"
	quest.6ADDFD55AD0DF7D4.quest_desc: [
		"在&a再处理器&r中结合&9可笑的锭&r和&c罗西尼特&r会创造出&d虚无锭&r。"
		""
		"我们现在可以用这些来制作一块&dInanite&r方块。"
	]
	quest.75AD0CEBC1335915.quest_desc: [
		"&d反应堆控制器&r是反应堆的核心。当反应堆形成后，你可以右键点击终端来打开反应堆界面。"
		""
		"根据反应堆是&9被动冷却&r还是&e主动冷却&r，界面会发生变化。被动冷却反应堆通过燃烧燃料直接发电。主动冷却反应堆利用产生的热量蒸发冷却剂，再将其送入涡轮机发电。"
		""
		"在被动反应器的界面中，你可以查看和切换状态与废料排放。你还会看到温度、反应器的 FE/t 产量，以及每刻燃烧的燃料量。"
	]
	quest.775D176081DD75F5.quest_desc: [
		"在完全建造的涡轮控制器上右键，会显示涡轮接口。"
		""
		"在这里，你可以看到涡轮的所有统计数据。"
		""
		"将鼠标悬停在每个物品上会显示更多信息。"
		""
		"左下角有 2 个箭头，用于控制 &9Flow Rate&r。"
		""
		"这控制着注入涡轮机的加热蒸汽量。"
		""
		"要确定具体数值，请先查看反应堆的&dVapor Production Rate&r。"
		""
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/turbineui.png width:200 height:150 align:center}"
	]
	quest.775D176081DD75F5.title: "涡轮接口"
	quest.7B4AAC741F0A6073.quest_desc: [
		"每个反应堆都需要&9反应堆控制棒&r和&9燃料棒&r。它们控制燃料如何被插入反应堆。"
		""
		"控制棒放置在反应堆的顶面。每个反应堆可以放置多根，但至少需要1根。通常，控制棒越多，反应堆能使用和燃烧的燃料就越多。这可能意味着更高的总功率，但也可能因反应堆配置不同而导致更快的燃烧速率。"
		""
		"每根控制棒都需要足够的燃料棒来延伸到反应堆底部。例如，如果你的反应堆高5格，每根控制棒就需要3根燃料棒来延伸。"
		""
		"右键点击控制棒，通过插入或抽出燃料棒，可以控制反应堆的燃料消耗量。伸出越多，燃烧的燃料就越少。"
	]
	quest.7B4AAC741F0A6073.title: "反应堆控制棒"
	quest.7C4D8AA107780795.quest_desc: [
		"使用&a流体化器&r，我们可以将&d血石&r和&e黄石&r结合，制成&2维德石。"
		""
		"在反应堆中用作燃料时，&2Verderium&r会产生&cRossinite&r作为反应物。我们需要这个！"
		""
		"要将 &2Verderium&r 用作燃料，你需要为反应堆制作 &cFuel Injection Ports&r。"
		""
		"注意：你可能需要清空反应堆中现有的燃料，或者为此目的建造一个新的反应堆。"
	]
	quest.7C4E4793DA887DE4.quest_desc: [
		"基于原版模组 &eBig Reactors&r，&aExtreme Reactors&r 让你能建造可自定义的多方块反应堆！"
		""
		"主要元素当然是铀。你需要这个，还有大量的煤炭和铁才能开始建造。"
		""
		"如果你在途中迷路了，请参考&aThe Extreme Book&r寻求帮助！"
	]
	quest.7C4E4793DA887DE4.title: "欢迎来到 &9Extreme Reactors&r！"
	quest.7E07C5A6FA6B6B1F.quest_desc: [
		"建造好一个功能齐全的&aReprocessor&r后，你就可以输入能量、水和&9Cyanite&r来制造&dBlutonium&r了。"
		""
		"这可以作为反应堆的燃料，并产生名为&9Magentite&r的废料。"
	]
}
