# AI 初翻，未人工校对
{
	quest.02E4DC8A55EA08FD.quest_desc: ["下界合金升级提供最高的可用存储容量，确切地说是 &664x&r 容量。它专为效率和规模至上的终局存储解决方案而设计。"]
	quest.053491865006B19A.quest_desc: ["流体抽屉用于以紧凑的形式存储大量流体。它能与流体管道、机器和自动化系统无缝配合。"]
	quest.079B76C1ED617C6C.quest_desc: ["武器柜专为不可堆叠物品设计。默认情况下，它能存放多达 4,096 件独特物品，非常适合工具、武器、盔甲等。玩家无法直接访问，需通过 Applied Energistics 或 Refined Storage 等外部存储系统连接。"]
	quest.087B79EA6970843A.quest_desc: ["黄金升级可将抽屉的存储容量提升&616倍&r。对于日益增长的资源储备来说，这是一个不错的中期选择。"]
	quest.0982858F9E537655.quest_desc: ["红石升级让抽屉能响应红石信号。这可用于控制物品的存取，实现更高级的自动化和逻辑电路设置。"]
	quest.0C0D00B227C3BB5C.quest_desc: ["推动升级与拉动相反，它会自动将物品从存储中送入相邻的背包。用它可以直接从抽屉向机器、熔炉或处理线供料。"]
	quest.20090C572AB8333D.quest_desc: [
		"配置工具用于锁定抽屉，使其记住内部存储的物品。这对于将物品推入或拉出抽屉的自动化系统尤其有用。"
		""
		"抽屉锁定后，只会接受锁定的物品，不会被其他物品替换，确保存储行为的一致性和可靠性。"
	]
	quest.2212968595CFA436.quest_desc: ["末影抽屉提供跨维度存储。任何配置相同的末影抽屉都会共享内容，让你能从世界任何地方——甚至更远的地方——即时存取物品。"]
	quest.237D5EDE454F371F.quest_desc: ["控制器接入点相当于所连接存储控制器的远程扩展。连接后，它就像控制器本身一样，让你可以从多个位置轻松访问整个抽屉网络。"]
	quest.24BEB50721FCB1B8.quest_desc: ["存储控制器可将多个抽屉链接成一个存储网络，即使它们不直接相邻。通过升级可进一步扩展链接范围，实现更整洁灵活的存储布局。"]
	quest.334126CF176610FC.quest_desc: ["钻石升级可将抽屉的存储容量扩大&624倍&r，使其能容纳海量物品。非常适合游戏后期的自动化和高吞吐量系统。"]
	quest.366C768D3EC05ADF.quest_desc: ["Functional Storage 通过添加多种实用方块来扩展你的存储选项，这些方块专为存放大量单一物品而设计。非常适合管理大量资源，如 Cobblestone、Dirt 和其他常用材料，帮助保持基地整洁有序。"]
	quest.5482EFE6DC5284CD.quest_desc: ["有了收集升级，附近的掉落物会被自动拾取并储存。这对农场、生物掉落物或任何物品会堆积在地面上的装置尤其有用。"]
	quest.5617E925EA668ADF.quest_desc: [
		"链接工具用于将抽屉连接到存储控制器。这样抽屉无需直接接触即可成为共享存储网络的一部分。"
		""
		"要开始链接，右键点击存储控制器以进入配置模式。在此模式下，右键抽屉即可将其添加到控制器的网络中。"
		""
		"手持工具时，还会显示当前连接到控制器的抽屉，方便你验证和管理存储设置。"
	]
	quest.68ADD40682D1C36A.quest_desc: ["简易压缩抽屉是标准压缩抽屉的简化版。它只有两个槽位，可在保持简洁和省空间的同时自动转换物品形态。"]
	quest.6EDD2B5D733C265F.quest_desc: ["Compacting Drawer 可同时存储多种形式的物品，自动在方块、锭、块或类似变体之间转换。这有助于节省宝贵的存储空间，轻松管理压缩资源。"]
	quest.708A6EE2B195CBE7.quest_desc: ["虚空升级可防止存储溢出，在抽屉满后删除多余物品。这对自动化农场或其他容易因物品堆积而引发问题的设置很有用。"]
	quest.74A9EF50A3AF2516.quest_desc: ["铜制升级可将抽屉的存储容量提升&68倍&r。它是早期无需大量材料即可扩展存储的升级选项。"]
	quest.7B5C0D82CF6FAC47.quest_desc: ["Framed Drawer 是一种可定制的抽屉，可通过不同材料进行外观定制。它像普通抽屉一样工作，但能让你将储物系统与基地设计相匹配。"]
	quest.7BA97C7B01035978.quest_desc: ["抽取升级能让存储方块自动从相邻的容器中提取物品。非常适合将机器、箱子或农场的资源直接抽入存储系统，无需手动操作。"]
	task.5BE5F8E4D117050B.title: "功能性存储系统"
}
