# AI 初翻，未人工校对
{
	quest.177B93F194F5B045.quest_desc: ["在气罐和机器之间移动气体（例如，来自Mekanism的气体）。"]
	quest.27D6FC212DDB2780.quest_desc: ["在物品栏或机器之间运输物品（如方块、资源等）。使用管道扳手来设置提取点。"]
	quest.27D6FC212DDB2780.quest_subtitle: "慢工出细活"
	quest.2D16F4D3D45F4B74.quest_desc: ["解锁过滤模式（黑名单、白名单、NBT匹配、目标定位）并提升传输速度。"]
	quest.451A5EAA8659B806.quest_desc: [
		"一种可在一块方块中同时传输物品、流体、能量和气体的组合管道。"
		""
		"吞吐量与单个管道相同，但一个管道即可完成所有工作。因此，多种资源类型只需一个连接。"
	]
	quest.4649F676C3F2BE2B.quest_desc: [
		"过滤目标工具可指定过滤器的物品、流体、气体或能量的具体去向。 (需要“高级过滤器”升级或更高版本)"
		""
		"使用方法："
		""
		"1. 点击一个目标物品栏"
		"2. 打开源物品栏，然后点击“添加”按钮"
		"3. 将管道过滤器放入管道过滤器槽中。"
		"当文本从目的地 \"Any\" 更改为你的目标物品栏的 x,y,z 坐标时，即表示成功。"
	]
	quest.525DDBC34EB0BE89.quest_desc: ["解锁分配模式（循环/最近优先/最远优先/随机）"]
	quest.5C028DF690ABA305.quest_desc: ["提供最高的传输速度。"]
	quest.5D32EE9D036721E2.quest_desc: ["基础升级可解锁红石控制，并提高物品传输速度。"]
	quest.63F4411C8805238E.quest_desc: ["将流体（水、岩浆、模组液体）从储罐或源头输送到其他储罐或机器中。"]
	quest.6ACEE5710A6F27DD.quest_desc: ["在发电机、电池和机器之间传输能量（FE/RF）。"]
	quest.789BAF2437B1C46B.quest_desc: ["默认情况下，管道连接模式为输入模式。潜行+右键单击管道可将其连接模式更改为提取模式，或再次操作以将物品栏与系统断开连接。"]
}
