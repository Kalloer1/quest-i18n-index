# AI 初翻，未人工校对
{
	quest.008D186B4E0ED14F.quest_desc: [
		"蒸汽烤箱是另一种利用蒸汽来干实事的机器。"
		""
		"将蒸汽放入蒸汽炉中，它就能像熔炉一样熔炼其中的任何物品。"
		""
		"将矿石制成锭，并烹饪食物物品。"
		""
		"这是一个由蒸汽烤箱方块组成的2x2x2机器。"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/rail_oven.png width:100 height:100 align:center}"
	]
	quest.020E6AF37A0421C8.quest_desc: [
		"水箱就像在外面放了一个桶一样。"
		""
		"光是这个桶就大得多得多了。"
		""
		"它能收集水，并为蒸汽机车储水。"
		""
		"生成的水量取决于生物群系和天空的可见度。"
		""
		"它由一个3x3x3的水箱方块组成，中间是空的。"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/rail_tank.png width:100 height:100 align:center}"
	]
	quest.032B654201E71618.quest_desc: [
		"这些&c轨道套件&r用于在&7矿车&r上使用实体（实体即生物）。"
		""
		"&c启航工具包&r会拾取附近的所有生物，并将它们放入&7矿车&r中。"
		""
		"&c下船工具包&r可将生物从&7矿车&r中卸下。"
		""
		"&cDumping Kit&r 会将生物从其所处的 &6轨道&r 下方的 &7矿车&r 中掉落。"
	]
	quest.032B654201E71618.title: "实体追踪套件（Track Kits for Entities）"
	quest.035C52EF63AD23A7.quest_desc: [
		"因此模组名为 &lRailCraft&r，其核心内容 &1火车&r、&6铁轨&r 也至关重要。"
		""
		"&2原版&r的适用于其中很多这类情况。"
		""
		"升级后的配方需要更多特殊物品才能制作！"
		""
		"把它们制作出来吧！"
	]
	quest.035C52EF63AD23A7.title: "铁轨"
	quest.068294A7C21DE550.quest_desc: [
		"&c轨道套件&r用于与&6铁轨&r一起制作特殊的&6铁轨&r。"
		""
		"这些&6轨道&r对所有与&1火车&r相关的事情都很有用，比如：让&1火车&r停下、移动&1火车&r和发出红石信号。"
	]
	quest.08457BEED799E600.quest_desc: ["这些新的&7矿车&r主要用于铺设&6轨道&r。\\n\\n&7轨道铺设器&r可以放置&6轨道&r，而&7轨道移除器&r可以移除&6轨道&r。\\n\\n&7轨道替换器&r会用不同的轨道替换现有的&6轨道&r，而&7轨道下切器&r则会替换&6轨道&r下方的方块。"]
	quest.08457BEED799E600.title: "轨道矿车"
	quest.0A43FD0B5C76C1C5.quest_desc: [
		"&l&7RailCraft Reborn&r 为我们添加了高炉多方块结构，可以将铁转化为钢！"
		""
		"建造它需要 34 个高炉砖。"
		""
		"宽度为3格，长度为3格，高度为4格。"
		""
		"正中心的两个方块需要是中空的。"
		""
		"当它完全组装完成并允许你访问其GUI时，你就知道成功了。"
		""
		"你可以在那里放入任何形式的铁，以获取钢和砂砾。"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/rail_furnace.png width:100 height:100 align:center}"
	]
	quest.104049993CC62E7F.quest_desc: [
		"高级物品加载器具备普通加载器的所有功能，并且可以从&6轨道&r附近任何位置使用。"
		""
		"旁边，上面，另一边的旁边。"
		""
		"使用&4撬棍&r来改变它的方向。"
	]
	quest.1698565EBB68DC85.quest_desc: [
		"&6Wye Track&r 是使用尖刺战锤制作的第二条轨道。"
		""
		"它将两条&6轨道&r合并为一条。"
		""
		"如果一个&6轨道&r与另一个相交，&6Y形轨道&r会将&7矿车&r从第一条&6轨道&r转移到相交的轨道上。"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/rail_wye.png width:100 height:100 align:center}"
	]
	quest.1698565EBB68DC85.title: "Wye 轨道"
	quest.170118E3C3C072E5.quest_desc: [
		"&6Junction&r 是由 Spike Maul 制作的最后一个 &6Track&r。"
		""
		"它可作为&6轨道的正常交叉点。"
		""
		"&7矿车&r会保持之前的方向行驶，但现在&6轨道&r可以交叉了。"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/rail_junction.png width:100 height:100 align:center}"
	]
	quest.170118E3C3C072E5.title: "交叉轨道"
	quest.17F7964611D893BE.quest_desc: [
		"流体加载器将有助于保持你的&3蒸汽机车&r正常运行。"
		""
		"必须放置在&6轨道&r上方几格处，它会将流体输送到&5机车&r或&7矿车&r中。"
	]
	quest.184F98BE0F6710E2.quest_desc: [
		"这两个 &c轨道套件&r 用于使用 &7矿车&r 和红石。"
		""
		"&c激活器套件&r会激活任何经过其上的&7矿车&r。"
		""
		"&c探测器套件&r会在有&7矿车&r经过时激活红石信号。"
		""
		"两者都与常规&6轨道&r的&2原版&r计数器相似。"
	]
	quest.184F98BE0F6710E2.title: "红石轨道套件"
	quest.21693C4DE6531D73.quest_desc: [
		"破碎机正如其名所示，就是一个破碎机。"
		""
		"它能粉碎方块来获取制作材料，例如从砖楼梯中获得砖块，或从锭中获得粉尘。"
		""
		"不过，它需要能量才能正常工作！"
		""
		"建造一个需要 3x2x2 的 Crusher 方块。"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/rail_crusher.png width:100 height:100 align:center}"
	]
	quest.249E5C6893387E15.quest_desc: [
		"这些&c轨道&r是用来停放&1机车&r和&7矿车&r的。"
		""
		"&c锁定套件&r会阻止&7矿车&r，只有在接收到红石脉冲时才会启动。"
		""
		"The &cBuffer Kit&r is for the end of your &6tracks&r, will stop them and not start. "
		""
		"&cGated Kit&r 会部署一个与 &6轨道&r 相连的栅栏门。"
	]
	quest.249E5C6893387E15.title: "轨道套件"
	quest.283AB56F81EF03A5.quest_desc: ["要为你的&6电动轨道&r和&e电动机车&r供电，你需要&e框架。框架&r需要供电，并将电力输送给每个连接的&e框架&r。"]
	quest.2869AB982799CF0C.quest_desc: ["&c单向轨道套件&r非常简单。 &7矿车&r只能沿着箭头所指的方向行驶。"]
	quest.2A30595DC6DDBFF7.quest_desc: [
		"&6电动轨道&r用于&e电动机车&r。"
		""
		"它们需要用&e框架&r供电，而且是的，碰到它们会对你造成伤害。"
		""
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/rail_electric_rail.png width:150 height:100 align:center}"
	]
	quest.2AB0FA084739827A.quest_desc: [
		"要使用&9隧道钻&r，你需要一个&9隧道钻头&r。"
		""
		"共有4种不同样式，具体取决于使用的&9Bore Head&r。"
		""
		"它可以被附魔，并且有耐久度，所以你一定要附魔它！"
	]
	quest.2AB0FA084739827A.title: "隧道掘进机头部"
	quest.2D00F85379A4D591.quest_desc: [
		"物品加载器是 RailCraft 中最基础的投掷器。"
		""
		"它必须在&6轨道&r上方，并且可以配置你想要装载到下方&7矿车&r上的内容。"
	]
	quest.31094CC16E710040.quest_desc: [
		"&4撬棍&r是RailCraft的主要工具。"
		""
		"当用于&1机车&r上时，会改变其朝向的方向。"
		""
		"按住 Shift 键点击可以连接&1机车&r和&7矿车&r。"
		""
		"当仅用于&7矿车&r上时，会给予它们轻微的推动力。"
		""
		"在特殊轨道上使用它们时，它们会改变模式。"
		""
		"不同的&4撬棍&r只是外观和伤害不同。"
	]
	quest.31094CC16E710040.title: "撬棍（物品ID：minecraft:crowbar）"
	quest.365D4B1DC953D406.quest_desc: [
		"&7Cart&r Dispenser 正如其名所示。"
		""
		"它可以向前方的&6轨道&r上放置任何&7矿车&r。"
		""
		"需要红石信号才能投掷物品。"
	]
	quest.38451B61E3FC075B.quest_desc: [
		"要获得（煤炭）焦炭，你需要一个焦炭炉。"
		""
		"制作一个需要26个 Coke Oven Bricks，并以中心空出1格的方式，按3x3x3排列放置。"
		""
		"当你能访问GUI且所有元素都显示为单一纹理时，即表示完成。"
		""
		"放置煤炭或煤炭块可获得（煤炭）焦炭和液体焦油！"
		""
		"你可以用任何原木来换取木炭和荧光粉。"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/rail_coke.png width:100 height:100 align:center}"
	]
	quest.3E75AFE3482834C5.quest_desc: [
		"&lRailCraft Reborn&r 让你用重型&1火车&r自动化基地物流。"
		""
		"你可以从简单的&7矿车&r升级到高速的&3电力机车&r。"
		""
		"建造交通灯来避免碰撞，蒸汽锅炉为引擎供能，再用&1隧道掘进机&r自动挖掘道路。"
	]
	quest.3E75AFE3482834C5.title: "Railcraft Reborn"
	quest.3E8C2E7769DFBF35.quest_desc: [
		"与 &3蒸汽机车&r 不同，你不需要向 &e电力机车&r 中添加任何东西。"
		""
		"它通过&6电动轨道&r下方的&e框架&r获取电力。"
		""
		"是的，它只能通过 &6电动轨道&r 运行。"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/rail_electric.png width:100 height:100 align:center}"
	]
	quest.4071BBBE12CACD2D.quest_desc: [
		"&1火车&r分配器是&7矿车&r分配器的改进版。"
		""
		"它能放出整个&1机车&r和更多内容！"
		""
		"设置好要部署的图案，然后给它一个红石信号。"
	]
	quest.425E375A9EC127EB.quest_desc: [
		"&6加固轨道&r是普通&6铁轨&r的升级版！速度略快，而且不会爆炸。"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/rail_reinforced1.png width:150 height:100 align:center}"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/rail_reinforced2.png width:150 height:100 align:center}"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/rail_reinforced3.png width:150 height:100 align:center}"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/rail_reinforced4.png width:150 height:100 align:center}"
	]
	quest.475E307844E3AF7F.quest_desc: [
		"Water Boilers 是 &l&7RailCraft&r 中最实用的机器之一。"
		""
		"它们需要一个燃料燃烧室和顶部的某种锅炉。"
		""
		"燃料燃烧室可以是 1x1、2x2 或 3x3 的。"
		""
		"火箱的大小决定了顶部锅炉的尺寸。"
		""
		"1x1 的 Firebox 只能搭配 1x1 的 Boiler。"
		""
		"对于2x2的燃烧室，可以使用2x2x3的锅炉。"
		""
		"对于3x3的熔炉，可以是3x3x4的。"
		""
		"液态燃料将使用 Creosote 进行加热。"
		""
		"对于实心熔炉，它会使用熔炉能用的任何东西。"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/rail_big_boiler.png width:100 height:100 align:center}"
	]
	quest.475E307844E3AF7F.title: "蒸汽锅炉储罐"
	quest.4A44623D8A307473.quest_desc: [
		"&6高速电动轨道&r就像&6电动轨道&r，但速度更快！"
		""
		"它们还需要普通&6高速轨道&r和&6电力轨道&r所需的&c速度提升&r和&e框架&r来提供动力。"
		""
		"现在你得小心拐角和接触它们了！"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/rail_electric_speed.png width:150 height:100 align:center}"
	]
	quest.5128B119DFFF0C4C.quest_desc: [
		"&3蒸汽机车&r是最基础的&1机车&r。可以通过给它提供水、熔炉燃料和等待来为其提供动力。"
		""
		"需要持续供水才能保持运作。"
		""
		"别担心，这只代表从顶部冒出的烟雾是水蒸气，对环境无害。"
		""
		"煤炭对环境不太好就是了... 管他呢，这可是&2Minecraft&r！"
	]
	quest.5180CDD196518F64.quest_desc: [
		"&6Strap Iron Tracks&r 和 &6Abandoned Tracks&r 一样，非常适合抠门的人。"
		""
		"它们比其他&6轨道&r慢得多，但没有脱轨的风险！"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/rail_strap.png width:150 height:100 align:center}"
	]
	quest.53594EBA9F7BA840.quest_desc: [
		"高级物品卸载器与普通卸载器一样，但可以从任何方向使用。"
		""
		"除了方向之外，别无不同。"
	]
	quest.54F2CB52D3A7BA87.quest_desc: [
		"物品卸载器是物品装载器的反作用装置。"
		""
		"它会从&7轨道车&r中取走物品。这个轨道车也必须在&6轨道&r的上方。"
	]
	quest.55D7CD0FA8F1AE48.quest_desc: [
		"我们此行的目的，就是&5火车&r。"
		""
		"这个模组叫 &l&7RailCraft Reborn&r，别表现得那么惊讶。"
		""
		"有 2 种不同的主 &5火车&r 和 1 种特殊的采矿 &5火车&r。"
		""
		"光有这些&5火车&r可能会有点无聊，不如给它们装上&7矿车&r吧！"
		""
		"将&7手推车&r与&7手推车&r及&5火车&r连接称为耦合，断开则称为解耦。"
		""
		"要连接&5火车&r和&7矿车&r，请使用带耦合&c轨道套件&r的&4撬棍&r或&6轨道&r。"
	]
	quest.5820EDEF71340A1A.quest_desc: [
		"&6废弃轨道&r很适合抠门的人，也好看。"
		""
		"它们可以在没有支撑的情况下跨越几个方块。"
		""
		"它们只能与同向的方块相距2格，或与反向的方块相距1格。"
		""
		"不过，这样做有脱轨的风险，基本上你的&7矿车&r会被甩出&6轨道&r。"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/rail_abandoned.png width:150 height:100 align:center}"
	]
	quest.5E750DB2244A67A1.quest_desc: [
		"用尖刺锤击中&6轨道&r，就能获得第一个&6转向轨道&r。"
		""
		"它可以朝两个方向移动，即向前和向侧面。"
		""
		"可以用轨道旁的开关来切换 &6轨道&r。"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/rail_turnout.png width:100 height:100 align:center}"
	]
	quest.5E750DB2244A67A1.title: "转向轨道 (Turnout Tracks)"
	quest.609CA1ACFA981BD5.quest_desc: ["&cRouting Kit&r 需要配合通行票使用。"]
	quest.61C93ABE07742DCD.quest_desc: [
		"蒸汽涡轮机利用蒸汽来产生FE和EU能量。"
		""
		"这是一个由蒸汽涡轮机外壳组成的3x2x2建筑，需要安装涡轮电机并接入蒸汽管道。"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/rail_turbine.png width:100 height:100 align:center}"
	]
	quest.64C105E1E2F97900.quest_desc: ["尖刺战锤可用于切换普通&6轨道&r的模式。对于尝试建造十字路口非常有用！"]
	quest.64C105E1E2F97900.title: "智能切换器"
	quest.677C5D35DADA4A42.quest_desc: [
		"&c连接器&r用于连接或断开&7矿车&r。耦合是连接&7矿车&r的说法。"
		""
		"可以用&4撬棍&r来配置，实现连接、断开或自动连接。"
		""
		"需要红石才能正常工作。"
	]
	quest.6C14D1B60124C2B2.quest_desc: [
		"&9Tunnel Bore&r非常适合自动放置&6Rails&r，尤其是在山脉或丘陵下方。"
		""
		"要开始工作，需要3样东西：&9钻头&r、煤炭等燃料，以及&6铁轨&r。"
		""
		"一旦集齐了全部3个，就把它放掉吧！"
		""
		"别忘了留意放进去的物品数量！"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/rail_tunnel.png width:100 height:100 align:center}"
	]
	quest.6C163E005351FF6D.quest_desc: ["激活的 &cWhistle Kit&r 在连接红石后，会使 &1Locomotives&r 发出鸣笛声。"]
	quest.6DB65926EE6D6C2E.quest_desc: [
		"这些&c轨道套件&r用于改变你的&7矿车&r的动量。"
		""
		"&c过渡套件&r会改变经过的&1机车&r的速度，需要红石能量。"
		""
		"&c助推器套件&r在供电时会加速&7矿车&r，断电时会减速&7矿车&r。"
		""
		"当&c控制套件&r获得动力时，会推动&7矿车&r，并能改变其推动方向。"
		""
		"&cThrottle Kit&r 会将经过的 &1Locomotive&r 的速度更改为设定的速度，需要用红石供电。"
		""
		"&cLauncher Kit&r 会直接把你的 &7Cart&r 发射出去！"
	]
	quest.6DB65926EE6D6C2E.title: "移动矿车轨道套件 Moving Cart Track Kits"
	quest.6E7C4228CD2B6BB9.quest_desc: [
		"这把&4撬棍&r有几种不同模式，每种都能改变&1机车&r的设计。"
		""
		"默认值，可在将鼠标悬停在物品栏中的物品时查看描述："
		""
		"--none 对应的是 &7灰色&r"
		""
		"--&6万圣节&r，让它变得诡异起来"
		""
		"--还有&c圣诞节&r，让节日气氛更浓！"
	]
	quest.75DD345164EE5CD9.quest_desc: [
		"&6高速轨道&r就像&6加固轨道&r，但速度显然更快。"
		""
		"不过他们需要 &c轨道套件&r 来帮助他们加速！"
		""
		"在拐角处要小心一点。"
		""
		"{image:ftb_quests:textures/gui/ftb_quests/images/rail_speed.png width:150 height:100 align:center}"
	]
	quest.78D8F40AA9568511.quest_desc: [
		"Powered Rolling Machine 是 Manual Rolling Machine 的改进版。"
		""
		"你不必一直盯着机器看，它会自动合成所有物品。"
		""
		"唯一的问题是它需要电力！"
	]
	quest.7D40B80DBBC4E160.quest_desc: [
		"手动滚动机将是你制作铁路材料等各种物品的专属小机器！"
		""
		"当你放入配方且能制作超过1个时，它会在你注视期间自动合成。"
		""
		"制作时离开Rolling Machine会取消制作，并将其放入你的物品栏中。"
		""
		"你必须手动合成最后一个配方！"
	]
	quest.7F4B734CFB0F0306.quest_desc: [
		"这些新的&7矿车&r与特殊的&2原版&r&7矿车&r类似。"
		""
		"&7带储罐的矿车&r可以装载并移动其中持有的任何液体。"
		""
		"&7带能量细胞的矿车&r将用来装载和运输能量！"
	]
