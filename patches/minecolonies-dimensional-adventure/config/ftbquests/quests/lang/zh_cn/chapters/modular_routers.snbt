		""
		"Mk3：高级传送，具有更远的范围和更高的可配置性。"
	]
	quest.2608E085D544C48D.quest_desc: ["将物品强力向前抛出。物品会被抛出数个方块的距离，使此模块在没有管道的情况下也能实现远距离或垂直运输物品"]
	quest.2673AD681C56141F.quest_desc: [
		"将物品从远程的容器中拉入路由器。"
		""
		"Mk1：相邻物品栏提取。"
		""
		"Mk2：射程更远，操控更佳。"
	]
	quest.27EECB88BB0C0785.quest_desc: [
		"空白升级是所有模块化路由器升级的基础合成组件。"
		""
		"升级直接安装在路由器中，一个路由器最多可安装5个升级。"
		""
		"已安装的升级会全局应用于路由器，影响所有兼容模块，且大多数升级可叠加以增强效果。"
	]
	quest.288F955FF1F2965B.quest_desc: ["提高路由器及其模块的运行频率。多个速度升级可叠加，使模块运行速度大幅提升。"]
	quest.2A4B50335E293ECA.quest_desc: [
		"将物品从远程的容器中拉入路由器。"
		""
		"Mk1：相邻物品栏提取。"
		""
		"Mk2：射程更远，操控更佳。"
	]
	quest.2D02A193448879DF.quest_desc: ["销毁传入其中的物品。非常适合清理多余物品，防止背包溢出。"]
	quest.2E70888BC80EB896.quest_desc: ["将路由器中的物品作为实体物品实体掉落至世界中。方向和掉落行为可控制，以实现简单的基于世界的物品输出。"]
	quest.344E3F1F52741C49.quest_desc: [
		"允许路由器在视觉上模仿其他方块。这只是一个外观升级，可用于将路由器隐藏在建筑内或与结构无缝融合。"
		""
		"潜行状态下右键点击路由器，并用方块伪装成该方块。"
	]
	quest.382AA19697486A69.quest_desc: ["当路由器包含特定物品时会发出红石信号。您可以配置要检测的物品和信号强度。"]
	quest.39E1A88165C34AF0.quest_desc: ["破坏模块前方的方块，并将掉落物放入路由器背包。可自动采集方块，并在适用时遵循工具行为。"]
	quest.3CFEA6879492C291.quest_desc: ["使路由器静音。操作路由器时产生的任何声音都将被消音。"]
	quest.3F00B20626CF1A77.quest_desc: ["限制可以交互的路由器。安装后，只有路由器的所有者（以及可能受信任的玩家，取决于配置）才能访问或修改它。"]
	quest.3F00B20626CF1A77.quest_subtitle: "滚出我的草坪！"
	quest.415B9BA6270028A4.quest_desc: ["将附近的物品实体吸入路由器。升级后可增强范围和速度，非常适合农场和生物掉落物收集。"]
