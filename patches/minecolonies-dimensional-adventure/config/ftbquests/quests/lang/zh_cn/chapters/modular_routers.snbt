	quest.5852927F9A6217D0.quest_desc: ["将物品均匀分配到多个目标物品栏中。非常适合在机器或存储系统之间分配资源。"]
	quest.588289B834828DCC.quest_desc: ["保护路由器免受爆炸伤害。安装后，路由器不会被爆炸伤害（如TNT或凋灵）摧毁，有助于保护关键的自动化装置。"]
	quest.5AA88E954F364C99.quest_desc: ["将路由器中储存的能量传输至最远8格内的机器。"]
	quest.61EA7922CACC06C8.quest_desc: ["以更快的速率移动流体。"]
	quest.62F5DBBB59E8B336.quest_desc: [
		"允许路由器一次移动多个物品。每个堆叠升级都会增加每次操作转移的物品数量。"
		""
		"1 堆升级 = 2 个物品。"
		"2 组升级 = 4 个物品。"
		"6 个升级 = 每秒 64 个物品。"
	]
	quest.66A44DFBF6163B81.quest_desc: ["Modular Routers 是一款紧凑而强大的物流模组，专注于精确的物品控制。使用可配置的路由器和模块，你可以以最小的设置来推动、拉动、过滤、分配、合成以及与物品栏或世界互动。它高度灵活且可扩展，用简洁高效的自动化取代笨重的运输系统。"]
	quest.67DECDA4EC04E191.quest_desc: ["允许路由器存储和使用能量。消耗能量的模块需要此模块，并能增加路由器的内部能量容量，以支持更耗能的运作。"]
	quest.6892E93B8F68471B.quest_desc: [
		"同步多个路由器的操作。这有助于确保它们以可预测的顺序协同工作，对于需要精确或定时敏感的自动化设置尤为重要。"
		""
		"你需要在图形用户界面中调整模块。"
	]
	quest.6C79ACEF648796B5.quest_desc: ["模拟对模块前方方块或实体进行右键点击。可用于自动激活机器、按下按钮、使用物品或与方块互动。"]
}
