	quest.5392A8DC9F2C3D5C.quest_desc: ["有了机械压机，你现在可以更高效地制作金属板，每个需要1个锭。"]
	quest.5392A8DC9F2C3D5C.quest_subtitle: "&0&l好多了，好多了"
