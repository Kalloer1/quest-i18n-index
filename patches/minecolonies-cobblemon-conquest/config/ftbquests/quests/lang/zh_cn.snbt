	quest.53B9B9158832250E.title: "&l获取一只以太蜜蜂"
	quest.53CE87B53193C14F.quest_desc: [
		"&l&l时间之树&r&r是一种无法在森林中自然生长的魔法树，必须用“时间之树树苗”种植而成，而这种树苗可以在巨型暮光橡树内的“树木地牢”中找到。"
		""
		"时间之树会加速附近植物的生长。它的时钟在走动，右键点击会使时钟变灰并停止。"
	]
	quest.53F485FF96FB8C9D.quest_desc: ["&l&lNaga Scale Armor&r&r 是由 Naga Scales 制成的盔甲。该盔甲套装仅包含胸甲和护腿。"]
	quest.53F485FF96FB8C9D.title: "Naga鳞片盔甲"
	quest.53FD4FE35BC82D70.quest_desc: ["用作许多机器（如压路机）的暂存和转运区。物品可通过皮带、滑槽、管道等多种方式输入和输出到仓库。"]
	quest.53FD4FE35BC82D70.quest_subtitle: "&0&l请放置于此"
	quest.53FD4FE35BC82D70.title: "&l仓库区"
	quest.54321F1DFF5E20C0.quest_desc: ["&l&l火焰之剑和镐&r&r由火焰锭制成，能灼伤攻击者并自动熔炼方块。"]
	quest.54321F1DFF5E20C0.title: "火焰之剑与镐头"
	quest.54496CB5F8242511.quest_desc: ["When 2 ditto are bred together you can receive a random egg. These eggs can contain literally any species in the game that are &lNOT&r Mythicals, Legendaries, Paradox Cobblemon... It could be an Ultra Rare spawn or you might just meet your 1,000th Rattata. You never know, for all intents and purposes they are weighted equally and it is a true random lottery."]
	quest.54496CB5F8242511.title: "&l捕捉2只百变怪"
	quest.544DA5259949B3C7.title: "&l1k ME 存储组件"
	quest.5458ED1325250C81.quest_desc: ["&l&l三级护身符&r&r是金色的，可以保护玩家的整个物品栏。"]
	quest.5458ED1325250C81.title: "&l保持护身符 III"
