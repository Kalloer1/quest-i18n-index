	quests: [
		{
			dependencies: ["6C0F0540504D9C39"]
			description: ["我爷爷告诉我，耕作就是热爱土地，珍惜大自然给予我们的馈赠。他还告诉我不同季节生长的蔬菜。有些只在特定季节生长，比如冬季，而另一些则生长两季、三季，甚至全年！这也是我应该多样化播种的原因。"]
			id: "241A7CE8AD6753AD"
			rewards: [{
				count: 4
