# AI 初翻，未人工校对
{
	chapter.0A943DE399505A98.title: "客户端 - 市政公共设施"
	chapter.102AEF73B6968C55.title: "客户端 - 存档与物流系统"
	chapter.1B952F0B73A40ABC.title: "第一份契约"
	chapter.1F1CBC61EC8C2CBB.title: "常设命令"
	chapter.239F729D7820EB41.title: "客户端 - 重工业（核能）"
	chapter.255D0CD1EBE456F9.title: "带宽合同"
	chapter.305BBDB486C84AF3.title: "交易大厅"
	chapter.3550A386DDFC4319.title: "客户端 - 铁质精炼 (Ferrous Refining)"
	chapter.4D607A2A0A4D84B1.title: "客户端 - 区域电网"
	chapter.52A1850806116D13.title: "热力学合规性"
	chapter.5549AC0BE80403E9.title: "整合工作"
	chapter.5E308EEF8E82AC69.title: "客户端 - 原子权威 (Atomic Authority)"
	chapter.60DC70E8159E7A33.title: "客户端 - 齿轮锻造厂"
	chapter.689279E9C4E15184.title: "客户端 - 批量仓库"
	chapter.6B21D0F4A73C5E88.title: "客户端 - 高级制造模组 (Advanced Manufacturing)"
	chapter.7DC52BE2F81FD5B7.title: "客户端 - 重工业"
	chapter_group.16D3370CAB8340A1.title: "你的数据中心"
	chapter_group.3E1FA8DB57AA20D0.title: "客户端工作"
	chapter_group.77C03825F033E536.title: "新手引导"
	quest.00043F4A660BCC54.quest_desc: ["入门级。作为第一个箱子还行，但它很快就会成为你的瓶颈。"]
	quest.00043F4A660BCC54.title: "契约 - 铜质木箱"
	quest.01C9E7069FF761A3.quest_desc: ["一位Mekanism操作员希望他们的反应堆只在你的计算机运行时工作。", "放置一个 Compute Interlock，并将其红石输出连接到反应堆的", "逻辑适配器处于激活模式。"]
	quest.01C9E7069FF761A3.title: "客户端站点 - 反应堆联锁装置"
	quest.025255895245FAF2.quest_desc: ["干涸的锅炉会自我销毁。", "泵要装在锅炉前面，而不是后面——客户端已经丢了一个了。"]
	quest.025255895245FAF2.title: "站点安全 - 给水系统"
	quest.03241B4E003A2068.quest_desc: ["足以运行一台反应堆的蒸汽量。", "原子管理局的现代工业化许可证从这里开始。"]
	quest.03241B4E003A2068.title: "契约 13 - 高压电"
	quest.03BC4B14C7562630.quest_desc: ["将原油裂解为各组分，每层一个输出口。", "他们整个化学链的开端。"]
	quest.03BC4B14C7562630.title: "契约 12 - 蒸馏"
	quest.03E2A9A221F6A931.quest_desc: ["潜水装备用的压缩空气，以及其他几个装置所需的燃料。"]
	quest.03E2A9A221F6A931.title: "站点安全 - 背式储罐"
	quest.03F5F31298095AE0.quest_desc: ["重工业已获得核许可证，但没有可开采的矿床。", "所以他们来找你：你的辐射模拟能将计算力转化为铀矿石。", "如果你还没有获得许可证，请查看交易大厅。"]
	quest.03F5F31298095AE0.title: "物资 - 未加工铀矿石"
	quest.04F28AD34367FDD0.quest_desc: ["LWL (光纤) - 单芯光纤，比任何铜制品都跳得远。", "从这里开始，你的链接就不再是限制因素了。"]
	quest.04F28AD34367FDD0.title: "契约 - 第一根纤维"
	quest.051191244EEDF7C4.quest_desc: ["中阶电路，通往电力目录高压部分的入口。"]
	quest.051191244EEDF7C4.title: "组件顺序 - 高级电路"
	quest.05E4E5F3402ABCD9.quest_desc: ["客户端已超出单股限制。八股合并为一股运行。"]
	quest.05E4E5F3402ABCD9.title: "容量订单 - 8 根纤维"
	quest.062D9D8F2CC21EDF.quest_desc: ["客户的抱怨很简单：一种矿石，一种锭，他们却在亏钱。", "富集室能将矿石产量翻倍。它是任何机械动力基地建造的第一台机器", "也是支付所有其他费用的那个。"]
	quest.062D9D8F2CC21EDF.title: "契约 01 - 产量翻倍"
	quest.0669C494C953F82B.quest_desc: ["第二级电路，由装配器制造，MV及以上所有层级所需。"]
	quest.0669C494C953F82B.title: "组件顺序 - 电子电路"
	quest.08364F27230E6B38.quest_desc: ["反应堆外壳。你需要准备很多：这是一个大型的多方块结构。"]
	quest.08364F27230E6B38.title: "建造 03 - 收容设施"
	quest.083F6D2F3540E712.quest_desc: ["将两个网络跨越任何距离或维度连接起来。", "他们清单上的最后一项任务。"]
	quest.083F6D2F3540E712.title: "契约 12 - 量子桥梁"
	quest.086513D523FCB457.quest_desc: ["冷却液入口，热冷却液出口。同一面墙的管道部分。"]
	quest.086513D523FCB457.title: "建造 05 - 流体活板门"
	quest.0889A96EC45D07E5.quest_desc: ["反应堆的结构材料，而且没有任何一种是铀。", "此分支需与燃料线并行运行 - 许可证在关闭前需要两者。"]
	quest.0889A96EC45D07E5.title: "建造 02 - 核合金"
	quest.08F1A7BEF17CF293.quest_desc: ["标准充电器线路的顶端，也是超导电线存在的原因。"]
	quest.08F1A7BEF17CF293.title: "Tier 03 - 高压电"
	quest.096D179F21F710AB.quest_desc: ["将锭压成板 - 出乎意料地多配方中必需的步骤。"]
	quest.096D179F21F710AB.title: "契约 02 - 压制行动"
	quest.0A414D8B9D5BA072.quest_desc: ["装上帆，让天气发挥作用。比水车产量更高", "如果铸造厂有垂直空间的话。"]
	quest.0A414D8B9D5BA072.title: "第02代 - 风"
	quest.0A45EBB7B1A2D7FA.quest_desc: ["无需燃料链即可冶炼，速度远超原版熔炉", "一旦电网能够为其供电即可。"]
	quest.0A45EBB7B1A2D7FA.title: "契约 - 电力冶炼"
	quest.0AB07749C96D0463.quest_desc: ["客户还希望将散装材料压回成完整方块以便运输。", "那就是 Combiner - 反向运行的 Crusher。"]
	quest.0AB07749C96D0463.title: "契约 03 - 重组化合物"
	quest.0B193085EF6ADF0E.quest_desc: ["另一半，而且远比另一半更难获得。"]
	quest.0B193085EF6ADF0E.title: "融合 02 - 氚"
	quest.0B679530DF4750ED.quest_desc: ["向客户端解释为什么这个安装包里没有任何红石。", "鱼竿会直接读取你的计算网络，并报告自身的插入深度：", "完全计算会将其完全取出，零计算会将其驱动至100%。"]
	quest.0B679530DF4750ED.title: "设计审查 - 禁止使用红石电路"
	quest.0BE7906EDDF3128A.quest_desc: ["光纤级线缆需要光纤级交换机，否则交换机会成为瓶颈", "你刚付钱是为了从电缆上移除它。"]
	quest.0BE7906EDDF3128A.title: "升级 - 高级开关"
	quest.0C2304BBEF8E1E63.quest_desc: ["低浓缩氧化铀被装入燃料棒中，反应堆可以实际燃烧它们。"]
	quest.0C2304BBEF8E1E63.title: "许可证 05 - 燃料棒"
	quest.0C6861F12FC9BAB2.quest_desc: ["在客户签字确认之前，合同并未完成。", "确认接口是否真的在为其网络供电 - 检查AE2能量读数", "在开具发票前收取预付款项的能源。"]
	quest.0C6861F12FC9BAB2.title: "验收测试 - ME 能源"
	quest.0CF8627D7F79A860.quest_desc: ["燃烧固体燃料，或直接饮用岩浆。稳定的基载电源选项", "一个无法依赖天气的地点来说。"]
	quest.0CF8627D7F79A860.title: "补给订单 04 - 热能"
	quest.0D2F5B2C45813C46.quest_desc: ["用 Schematic 和 Quill 复制一个装置，然后用 Schematicannon 打印出来。", "客户希望布局可重复，而非定制专属。"]
	quest.0D2F5B2C45813C46.title: "契约 08 - 蓝图设计"
	quest.0D40E352ACC878CB.quest_desc: ["矿车装置 - 熔炉会自己移动，而不是静止不动。"]
	quest.0D40E352ACC878CB.title: "契约 09 - 列车车厢"
	quest.0DF78880F3214D01.quest_desc: ["对整个区域进行自动化提取，并按方块类型过滤。", "在 SkyBlock 岛屿上，它的价值不如听起来那么高——但客户端有真正的地面。"]
	quest.0DF78880F3214D01.title: "契约 05 - 远程提取"
	quest.0EA374435FFE14E0.quest_desc: ["矿物翻倍循环的一半是反向的：破碎机将锭变成粉尘。", "将其与富集室搭配使用，即可闭合循环。"]
	quest.0EA374435FFE14E0.title: "契约 02 - 化为尘埃"
	quest.0F4454D88604DCD4.quest_desc: ["内置终端的单格驱动器。读取单个格子的廉价方式", "而无需占用整个驱动器托架的空间。"]
	quest.0F4454D88604DCD4.title: "契约 07 - 单舱室"
	quest.106DBFD990649186.quest_desc: ["81个格子。升级路径开始变得值得投入的节点。"]
	quest.106DBFD990649186.title: "装修 03 - 金色"
	quest.111DF203C8BB8136.quest_desc: ["燃烧燃料，煮沸水，将蒸汽输送到机器。", "这个时代没有电力：锅炉就是整个电网。"]
	quest.111DF203C8BB8136.title: "契约 01 - 蒸汽发电厂"
	quest.1189639047FAE733.quest_desc: ["十六条。你的脊椎都快变成基础设施了。"]
	quest.1189639047FAE733.title: "容量订单 - 16 根纤维"
	quest.11CF6A4EA20B0D43.quest_desc: ["将编码好的模式输入机器。这才是客户真正想要的合约", "一直以来：仓库都能自己制造东西。"]
	quest.11CF6A4EA20B0D43.title: "契约 09 - 自动合成"
	quest.12ECF4739DBBA13A.quest_desc: ["用于他人自动化项目的信号组件。", "每次送货128个粉尘，当天就能付款。"]
	quest.12ECF4739DBBA13A.title: "红石征调令"
	quest.13465E1F3D3960CC.quest_desc: ["市政电力运行着一个与整合包中其他部分完全独立的电压分级电网。", "他们订购的一切都始于铜线。"]
	quest.13465E1F3D3960CC.title: "基础工程 - 铜线"
	quest.15258C587A71E42F.quest_desc: ["将一个大齿轮和一个齿轮配对以改变速度。", "铸造厂下游使用的每种比例都源于这一种关系。"]
	quest.15258C587A71E42F.title: "基础工程 - 齿轮传动比"
	quest.15417232A0B30E3E.quest_desc: ["铁加碳。钢是几乎所有Mekanism多方块的外壳材料，", "所以客户希望在报价任何机器前，先备齐库存。"]
	quest.15417232A0B30E3E.title: "结构性秩序 - 钢铁"
	quest.1594861D75068278.quest_desc: ["让网站变得严肃的合同：每秒消耗 1,000,000 字节", "三个或以上向一个合成器或托管架供能的架子。", "慢慢来。这件事可一点也不快。"]
	quest.1594861D75068278.title: "Tier-1 客户端 - 一百万字节"
	quest.15F9A37887A50A52.quest_desc: ["网格已批准裂变建造。约束永远优先于燃料：", "先提升外壳的高度。"]
	quest.15F9A37887A50A52.title: "核许可证 01 - 收容"
	quest.171CEF05B0140DDF.quest_desc: ["一个能像玩家一样使用工具和放置方块的机械手。", "铸造炉不再需要操作员一直站在那里操作了。"]
	quest.171CEF05B0140DDF.title: "契约 05 - 部署者"
	quest.1769D5929213F83A.quest_desc: ["燃料柱的封盖。没有封盖的堆芯不是堆芯，而是事故。"]
	quest.1769D5929213F83A.title: "核许可证 03 - 控制棒"
	quest.17B6A1D1EFF845C7.quest_desc: ["将整个房间折叠成一个单元格，然后放在架子上。", "在你说出这句话之前，客户端都不相信这是可能的。"]
	quest.17B6A1D1EFF845C7.title: "契约 11 - 空间存储"
	quest.1A59689612E81D41.quest_desc: ["启动它，并确认它能产生蒸汽和电力而不会发生熔毁。", "该装置按持续输出支付报酬，而非按成功点火支付。"]
	quest.1A59689612E81D41.title: "委托 - 临界性 (Commissioning - Criticality)"
	quest.1ADFE8155206D0F4.quest_desc: ["将化合物与当前物质分离：水分解为氢和氧，以及更多内容。"]
	quest.1ADFE8155206D0F4.title: "契约 08 - 电解作用"
	quest.1B06466A2A2BFC44.quest_desc: ["适用于已超出高级阶段并开始汇聚真实流量的网络。"]
	quest.1B06466A2A2BFC44.title: "升级 - 核心开关"
	quest.1B40A4E7D4457250.quest_desc: ["氘和氚聚变成等离子体。", "它的发电量远超客户端拥有的任何裂变反应堆。"]
	quest.1B40A4E7D4457250.title: "融合 04 - 融合反应堆"
	quest.1B875A5DB7578DDB.quest_desc: ["天然铀主要是没什么用的U-238，含有微量的可裂变U-235。", "只有离心机能分辨它们，而且速度很慢。建造两台。"]
	quest.1B875A5DB7578DDB.title: "建造 01 - 离心机"
	quest.1C6E48F0A9D3B572.quest_desc: ["买错零件了？商店的出售方块能以当前价格的80%回收硬件。", "磨损损坏的组件售价更低，所以趁它们还没熟就卖掉吧。"]
	quest.1C6E48F0A9D3B572.title: "资产处置"
	quest.1CA3ECCF3CCA0884.quest_desc: ["最便宜的收尾方法：把热量转移到别的地方去。", "房间风扇将吸入室的暖空气推入较冷的排出室，消耗40 FE/刻。", "只有排气管一侧确实更凉才会有效——审核检查的是这一点，而不是风扇数量。"]
	quest.1CA3ECCF3CCA0884.title: "疗法 01 - 强制通风"
	quest.1DFE69B7A5F19484.quest_desc: ["客户端手动请求的最深层级：一个矿石换取四个锭。", "此后的内容均为工厂自动化，而非新化学工艺。"]
	quest.1DFE69B7A5F19484.title: "契约 08 - 四重加工"
	quest.1E0455977E02CF1C.quest_desc: ["装置的核心。它为所有设备提供所需的通道；", "没有它，客户端就被限制在一个小型的临时网络中。"]
	quest.1E0455977E02CF1C.title: "契约 05 - 控制器"
	quest.1E79A44AD33E6546.quest_desc: ["常见的废料。不可裂变，但可以填充燃料棒的空间", "并最终衰变为钚同位素。"]
	quest.1E79A44AD33E6546.title: "补给品 - U-238"
	quest.1F49AFA672FF3045.quest_desc: ["Ferrous Refining 已与你签约，开采了整合包中无人染指的矿石。", "准备好锇矿石——几乎所有机器都需要用它来建造。"]
	quest.1F49AFA672FF3045.title: "勘察客户的矿石分布情况"
	quest.200A1F1D20B3B20C.quest_desc: ["证明这个联动装置能像宣传的那样工作。", "故意摧毁你的计算网络，观察反应堆的反应。", "未经测试的保险装置，就不是保险装置。"]
	quest.200A1F1D20B3B20C.title: "验收测试 - 故障安全机制"
	quest.20C1FB2C281CEE0D.quest_desc: ["直接从河流中获得的自由旋转。缓慢，而且永不停止。"]
	quest.20C1FB2C281CEE0D.title: "第 01 代 - 水"
	quest.210C236D178EDD46.quest_desc: ["紧凑型装置将压缩机置于其试图冷却的房间内。而那个房间是有天花板的。", "分体式系统将两者分开：将室内机朝向其所服务的房间放置。"]
	quest.210C236D178EDD46.title: "升级 - 分裂系统"
	quest.21EC05775E58EA75.quest_desc: ["NuclearScience 拥有独立于 Mekanism 裂变反应堆的科技树。", "这是整个许可证所依附的核心部分。"]
	quest.21EC05775E58EA75.title: "建造 01 - 反应堆核心"
	quest.231BB07C79F8A5D6.quest_desc: ["旋转力必须以某种方式传递。齿轮就是实现这种传递的方式。"]
	quest.231BB07C79F8A5D6.title: "基础工程 - 齿轮装置"
	quest.2353E228AE2DBDC3.quest_desc: ["反应堆产生蒸汽，而不是电力。涡轮机才是赚钱的关键。"]
	quest.2353E228AE2DBDC3.title: "建造 04 - 涡轮大厅"
	quest.249748CB5EC8752E.quest_desc: ["电力、算力、一笔交易。你是一家持续经营的企业。", "放置一个任务屏幕并将其绑定到一个站立订单 - 该方块是你的货物存放区，", "并且它直接从管道接收物品，而不是通过菜单点击。", "其他章节是客户端工作：冷却、带宽和交易大厅。"]
	quest.249748CB5EC8752E.title: "开业大吉"
	quest.2528C4CB603E1EFF.quest_desc: ["更坚固的外壳。配方与青铜相同，但运行速度更快。"]
	quest.2528C4CB603E1EFF.title: "基础工程 - 钢制外壳"
	quest.268D9454E0DA2D33.quest_desc: ["燃料棒输入，废料棒输出。普通的机器舱口在这里可活不下来。"]
	quest.268D9454E0DA2D33.title: "建造 04 - 物品活板门"
	quest.275D4F43B71A1CBC.quest_desc: ["在交易任何东西之前，先学会棋盘的移动方式。", "打开商店查看当前价格 - 它们会追踪真实的历史日历", "是日复一日的努力，而非随机漫步。这里的一切都不是运气。"]
	quest.275D4F43B71A1CBC.title: "桌面简报"
	quest.27ABBC340B34FA9A.quest_desc: ["自动化合成，以动力网格的形式排列。", "布局起来很麻烦，这也是整章内容所铺垫的目标。"]
	quest.27ABBC340B34FA9A.title: "契约 06 - 合成网格"
	quest.27AF5C3326942313.quest_desc: ["分离U-235和U-238正是核能的全部难点所在。", "离心机设计得比较慢。建造多个吧。"]
	quest.27AF5C3326942313.title: "许可证 03 - 富集工程"
	quest.27C0CFAE0D622DBE.quest_desc: ["这是建造戒指的方块。反应堆需要大量的这种方块。"]
	quest.27C0CFAE0D622DBE.title: "融合 03 - 收容环"
	quest.27FEB3896099179C.quest_desc: ["相同颜色代码的每个箱子共享一个物品栏，无论距离多远", "跨越维度。两个站点，一个仓库。"]
	quest.27FEB3896099179C.title: "物流 02 - 共享库存"
	quest.29AF5F6643FFB222.quest_desc: ["铺好反应堆室的地板。这将决定该地点的物品", "是一个发电厂，或者是一场缓慢的事故。"]
	quest.29AF5F6643FFB222.title: "建造 03 - 防护罩建造指南"
	quest.2A7F5C2BB987450A.quest_desc: ["产出与建造高度成正比，所以建造位置比数量更重要。"]
	quest.2A7F5C2BB987450A.title: "补给订单 02 - 风"
	quest.2AB55D0C0399B519.quest_desc: ["持有存储单元并将内容上传至网络。", "这一刻，仓库终于可以开始被搜索了。"]
	quest.2AB55D0C0399B519.title: "契约 06 - 驾驶舱"
	quest.2CB31197439BC931.quest_desc: ["将物品、流体和气体汇集于一室。PRC 是 Mekanism 化学系统的入口", "以及更深层的矿石层级。"]
	quest.2CB31197439BC931.title: "契约 07 - 压力工作"
	quest.2CD2993ED43FECF5.quest_desc: ["接触镀层。体积小，效率高，而且他们隔天才下单。"]
	quest.2CD2993ED43FECF5.title: "贵金属订单"
	quest.2CDB52D5585D309A.quest_desc: ["峰值需求与峰值供应不匹配。感应矩阵是缓冲器", "这样电网就能从他们那里购买电力——而且购买量会随着他们的支付能力而增加。"]
	quest.2CDB52D5585D309A.title: "存储契约 - 感应矩阵"
	quest.2CDB55EA8EE660E4.quest_desc: ["核裂变反应堆能接受的最热的东西，", "如果冷却循环跟不上，情况会非常危险。"]
	quest.2CDB55EA8EE660E4.title: "第04周期 - 高浓缩MOX"
	quest.2DDE0E8056E313CF.quest_desc: ["采矿机只会挖掘你指向的、日历上已经达到的日期所对应的矿石。", "选择一个算法，并将硬件提交给它。"]
	quest.2DDE0E8056E313CF.title: "位置 - 选择一个算法"
	quest.2EB0A6552045F1F3.quest_desc: ["最后一个开关层级。由超导运行和完整核心供电，", "这是运输者会加入而非购买的箱子。"]
	quest.2EB0A6552045F1F3.title: "Tier-1 窥视者（Peering）"
	quest.2F0BA190D9A9551B.quest_desc: ["本地的制造商会成排购买铁块，并不会追问来源。", "合成 64 个锭，并将它们输入连接到该合同的任务界面 -", "这里的交付是实体的，订单簿不会从你的腰带上移除它们。", "长期订单：他们明天会想要下一批货。"]
	quest.2F0BA190D9A9551B.title: "废料钢订单"
	quest.30857795C3E80586.quest_desc: ["带附魔台的终端，方便管理员直接从网络存储中合成", "而不是把材料运到工作台上去。"]
	quest.30857795C3E80586.title: "契约 08 - 合成终端机"
	quest.31DD698891DD3B26.quest_desc: ["重水，通过电解普通水制得。", "用这种材料做减速剂的反应堆温度更高，燃料燃烧也更充分。"]
	quest.31DD698891DD3B26.title: "冷却剂 01 - 重水"
	quest.325DE6F2F0A25146.quest_desc: ["将矿石磨成粉末，产量翻倍。", "在每种矿石都能合成的岛屿上，翻倍的价值远超寻常。"]
	quest.325DE6F2F0A25146.title: "契约 03 - 矿石翻倍"
	quest.32E888D32D7ADED0.quest_desc: ["档案与物流希望将整个仓库改造成一个可搜索的系统。", "一切始于在水而非矿中生长的 Certus Quartz。"]
	quest.32E888D32D7ADED0.title: "输入 - 瑟特斯石英 (Certus Quartz)"
	quest.33588275A20FD917.quest_desc: ["第一级电路。从这里开始，机器除了外壳还需要大脑。"]
	quest.33588275A20FD917.title: "组件顺序 - 模拟电路"
	quest.3387E54E295D8C2A.quest_desc: ["最简单的要求：完全没有燃料链的生成。", "每个面板都很弱，只需建造更多即可增强。"]
	quest.3387E54E295D8C2A.title: "补给订单 01 - 白昼之光"
	quest.33BAF41AC05BC5D1.quest_desc: ["没人会为黑暗机架付费。给它供电，让处理器运行起来", "直到读数显示真实的字节/刻数为止。", "这个面板上的一切都取决于这个数字必须大于零。"]
	quest.33BAF41AC05BC5D1.title: "获取呼吸架（Rack Breathing）"
	quest.35957D2B5FF59169.quest_desc: ["在板上完成最后的签字。放下你的计算机，确认驱动杆已安装", "并且会自动关闭反应堆。", "那你卖的是一个安全系统，而不是一个小玩意儿。"]
	quest.35957D2B5FF59169.title: "验收测试 - SCRAM"
	quest.3850044BF7EFF533.quest_desc: ["过滤器加载完成。空气吹尘器可清除机器中积聚的灰尘", "并将其重置到一个干净的基准线上。", "把它当常规工作，别当紧急情况——紧急情况会消耗硬件。"]
	quest.3850044BF7EFF533.title: "计划维护中"
	quest.387A86B1E3A4B2C5.quest_desc: ["该地点的产量现已超过其存储能力。", "QIO 驱动阵列能让他们有一个可搜索的池子，而不是满墙的箱子。"]
	quest.387A86B1E3A4B2C5.title: "契约 09 - 量子存储"
	quest.39BBBB4DE0F711CA.quest_desc: ["常见同位素，也是黄饼的主要产物。本身不可裂变。"]
	quest.39BBBB4DE0F711CA.title: "许可证 02 - U-238"
	quest.3C23A8ED1599F165.quest_desc: ["反应堆与外部世界唯一的接口。", "你专属的跨模组契约就挂在这个方块上——详见整合工作。"]
	quest.3C23A8ED1599F165.title: "核能许可证 04 - 逻辑适配器"
	quest.3C51FE6E19CE5C67.quest_desc: ["U-235和U-238塞进一根棒里。对他们想要的反应堆来说，勉强算个零食。"]
	quest.3C51FE6E19CE5C67.title: "燃料 01 - 单根燃料棒"
	quest.3CB8D18FD763B4F4.quest_desc: ["简单、可靠，而且粗暴。他们会真正运行的第一件事。"]
	quest.3CB8D18FD763B4F4.title: "第 01 代 - 煤炭"
	quest.3CBB6400FB4FACA3.quest_desc: ["审计发现了颗粒物。灰尘沉积在组件上，形成绝缘层，导致温度升高", "直到某个东西被限制或发生故障为止。", "安装粉尘过滤器并保持进气口清洁。"]
	quest.3CBB6400FB4FACA3.title: "疗法 02 - 过滤"
	quest.3E53AAD4D49822AD.quest_desc: ["单次运行六十四条线缆。此时线缆的成本比房间还高。"]
	quest.3E53AAD4D49822AD.title: "容量订单 - 64 根纤维"
	quest.3F7C9D74072B65DF.quest_desc: ["目录的顶部。你拥有的任何东西都无法填满它，", "而这正是 Tier-1 客户所支付的费用。"]
	quest.3F7C9D74072B65DF.title: "契约 - 超导运行 (Contract - Superconducting Run)"
	quest.41645E71442C2507.quest_desc: ["当局已经听说你的数据中心的能力，并希望将其接入网络。", "计算控制棒位于核心下方，直接读取你的网络。", "这与客户端所见的整合工作合同是相同的。"]
	quest.41645E71442C2507.title: "整合 - 计算控制棒 (Compute Control Rod)"
	quest.41C9944A50E23035.quest_desc: ["将电网升级，LV线路无法供电的机器也能运行。"]
	quest.41C9944A50E23035.title: "Tier 02 - 中压电路"
	quest.428A259718521000.quest_desc: ["在LV充电器上充电，将电力带到任何需要的地方。", "在拥有配电网之前，公共事业公司的答案。"]
	quest.428A259718521000.title: "Tier 01 - 存储系统"
	quest.44687105BB34829E.quest_desc: ["原子管理局会审核反应堆建造，不会跳过任何步骤。", "铀浓缩粉是所有应用的基础材料。"]
	quest.44687105BB34829E.title: "许可证 01 - 黄饼"
	quest.44BCB1E70770FB4A.quest_desc: ["需要活动部件的机器的旋转输出，而不仅仅是电流。"]
	quest.44BCB1E70770FB4A.title: "组件顺序 - 电机"
	quest.44C14352A4A70550.quest_desc: ["通过GUI手动出售无法扩展。", "将物品输送到 Log Buyer，让书桌自行清理。"]
	quest.44C14352A4A70550.title: "自动化木制工作台"
	quest.44F4495500D8452E.quest_desc: ["别浪费。这里面每一个都还含有未提取的钚元素。"]
	quest.44F4495500D8452E.title: "第01周期 - 乏燃料"
	quest.458DA09616CCB238.quest_desc: ["闲置计算无法赚取任何东西。将采矿机指向日历上实际存在的算法", "到达目的地并让它发挥作用。", "这是能让你离开键盘时也能获得报酬的第一个合约。"]
	quest.458DA09616CCB238.title: "首个可计费哈希率"
	quest.45FA19C59F40232B.quest_desc: ["吞吐量上的首次实质性提升。"]
	quest.45FA19C59F40232B.title: "契约 10 - 中压电网"
	quest.460912E0B3AE27F6.quest_desc: ["它们自己的矿石，以及每个高级合约所需合金的一半。"]
	quest.460912E0B3AE27F6.title: "材料订单 - 锌 (Zinc)"
	quest.4639F9A69D6C87FC.quest_desc: ["一家空壳公司拥有这座岛屿、一个架子，以及别无他物。", "你刚刚签署了所有三项协议。", "从现在开始，你不再挖矿、种田或探索——你只出售计算力，购买其他一切。", "在告示牌上签名，第一位客户就可以上板了。"]
	quest.4639F9A69D6C87FC.title: "契约 001 - 签订租约"
	quest.46B7B1E5D0D3DCA4.quest_desc: ["根据你设定的规则在物品栏之间移动物品。", "铸造厂不想建造的传送带的替代方案。"]
	quest.46B7B1E5D0D3DCA4.title: "契约 07 - 物品路由"
	quest.46CD7F1E4095DA99.quest_desc: ["将模块绑定到特定鱼竿上，并驱动其插入深度从0%到100% -", "手动操作，或通过外部信号触发。"]
	quest.46CD7F1E4095DA99.title: "契约 - 鱼竿模块"
	quest.4852A4F8B4CE102B.quest_desc: ["它们的网络需要输入FE。能量接收器是输入端口 -", "以及你自己的AE2电源接口合同的输入项。"]
	quest.4852A4F8B4CE102B.title: "契约 04 - 能量摄入"
	quest.499F63A8CEF6786A.quest_desc: ["仅凭蒸汽就能挖掘整个区域。此处可选，客户端有真实地面", "即使你没有这样做，也是如此。"]
	quest.499F63A8CEF6786A.title: "契约 04 - 蒸汽采石场"
	quest.4A7C1E9D6B25F308.quest_desc: ["铀和钍永远不会出现在矿工模拟器的输出中 - 它们需要单独授权。", "辐射模拟通过计算生成它们，而产出的物品是真的热的：", "不带盾牌拿着试试，就知道有多烫了。妥善储存产物。"]
	quest.4A7C1E9D6B25F308.title: "授权合同 - 放射性同位素"
	quest.4AB577BBFADF07C5.quest_desc: ["多方块结构本身。棒材呈网格状放置，并加热相邻的方块，", "所以排列方式决定了客户端获得的是电力还是事故。", "开启前请先阅读指南中的布局说明。"]
	quest.4AB577BBFADF07C5.title: "建造 06 - 核反应堆"
	quest.4BD3B633F5880CBE.quest_desc: ["无损传输。这是公用事业公司的最后命令，也是唯一一根电缆", "这样就不会浪费高压线路输送的电力了。"]
	quest.4BD3B633F5880CBE.title: "最终契约 - 超导电网"
	quest.4BF4A486223E73EF.quest_desc: ["单次运行是点对点。交换网络是网络。", "放置一个标准开关并保持其通电 - 背板会自行消耗 FE。"]
	quest.4BF4A486223E73EF.title: "站点设备 - 开关"
	quest.4C7F0639CD86C14C.quest_desc: ["几乎所有 Electrodynamics 机器的组件门。", "预算要准备充足，这里的东西都离不开预算。"]
	quest.4C7F0639CD86C14C.title: "基础工程 - 基本电路"
	quest.4E03FFFC19A89C61.quest_desc: ["蒸汽熔炉的继任者。添加能量舱口以提高其温度，", "而这种温度正是开启高级合金的关键所在。"]
	quest.4E03FFFC19A89C61.title: "契约 11 - 电动高炉"
	quest.4F14ACE58B13C294.quest_desc: ["整个网络都装进口袋里。需要接入点才能通信。"]
	quest.4F14ACE58B13C294.title: "契约 10 - 无线访问权限"
	quest.4F6B7EE33A7C46C5.quest_desc: ["书桌想要你的液体。通过钱包出售任何开采的硬币，然后勾选此项。", "注意：该模组将硬币视为钱包余额而非物品来追踪，", "所以现在这个就靠自觉运行了，暂时先这样。"]
	quest.4F6B7EE33A7C46C5.title: "实现一个位置"
	quest.5002150D924551DF.quest_desc: ["制冷剂管线穿过墙壁的地方需要合适的密封件，", "或者你刚挖的洞会撤销你刚封的房间。"]
	quest.5002150D924551DF.title: "Site Works - 墙体穿透术"
	quest.508F32CDDA079039.quest_desc: ["一种完全不同的反应堆设计，而且宽容度要高得多。"]
	quest.508F32CDDA079039.title: "许可证 06 - 熔融盐"
	quest.5160E7EBBC4B389C.quest_desc: ["第二个操作员，不同的反应堆模组，以及更干净的机制。", "Compute Control Rod 是一个放置在 NuclearScience 反应堆核心下方的实体方块 -", "完全没有比较器、反相器，也没有任何线路连接。"]
	quest.5160E7EBBC4B389C.title: "客户端 - 控制杆合约"
	quest.51888B790DB0B03C.quest_desc: ["这是末期的合同。首先需要有一座核裂变发电厂在运行", "只是为了达到点燃所需的温度而已。"]
	quest.51888B790DB0B03C.title: "高级许可证 - 融合"
	quest.5200BABB195DDE1D.quest_desc: ["与其自己挖矿，不如出租容量。主机架能将算力转化为收入", "完全不会受到硬币价格的影响。", "无聊，稳定，而且在市场低迷时还能赚钱。"]
	quest.5200BABB195DDE1D.title: "契约 - 托管服务管理"
	quest.5210FC1BF9176380.quest_desc: ["燃烧植物材料制成的生物燃料。如果客户端有农场，完全可再生，", "如果不带，他们就成了累赘和负担。"]
	quest.5210FC1BF9176380.title: "物资订单 03 - 生物质"
	quest.5224B91C82DD3FC3.quest_desc: ["提高每个抽屉的容量，直到墙壁能承受客户端的实际吞吐量。"]
	quest.5224B91C82DD3FC3.title: "批量 02 - 容量升级"
	quest.525908781BDD5B6C.quest_desc: ["每个配方一台机器无法扩展。Tier I 工厂可同时处理多种输入", "也是客户端站点停止作为工坊的那个点。"]
	quest.525908781BDD5B6C.title: "契约 06 - 跨越界限"
	quest.543DE59911AE759C.quest_desc: ["Certus、红石和红石石英融合而成。AE2的标志性材料。"]
	quest.543DE59911AE759C.title: "输入 - 流变（Fluix）"
	quest.544234132060F7B3.quest_desc: ["混合氧化物：将钚重新混入铀中。", "比铀燃烧得更旺，能将废料流转化为燃料流。"]
	quest.544234132060F7B3.title: "循环 03 - MOX 燃料"
	quest.5449E2276A7B20CB.quest_desc: ["区域电网不会与无法储存所产能量的站点进行交互。", "基础能量立方体是他们希望最先安装的计量器和缓冲器。"]
	quest.5449E2276A7B20CB.title: "计量合同"
	quest.5517FAECDFC43603.quest_desc: ["磨石磨盘的大号兄弟：两个轮子相对而立，", "以及熔炉的首次真正吞吐量。"]
	quest.5517FAECDFC43603.title: "契约 04 - 批量粉碎"
	quest.5562580BEE101880.quest_desc: ["氘和氚。聚变反应堆唯一能接受的东西，", "而且比铀要难得多，难以获取。"]
	quest.5562580BEE101880.title: "高级许可证 - D-T 燃料"
	quest.56044B55F8D9066C.quest_desc: ["一台机器是爱好。组装另一台服务器，让它开始工作 -", "容量是这一层你唯一能真正卖出去的东西。"]
	quest.56044B55F8D9066C.title: "Capex - 又一个机架单元"
	quest.56110CF1FD95616C.quest_desc: ["重工业始于电力和机器之前。", "锻造锤能将锭手工制成板。他们之后订购的一切", "位于这个工具的下游位置。"]
	quest.56110CF1FD95616C.title: "基础工程 - 锻造锤"
	quest.56401D4E34835FEC.quest_desc: ["承运商正在考察运力，想知道你究竟能交付什么。", "找到带宽读数，了解你当前运行的评级。", "他们从这里订购的一切，价格都低于那个上限。"]
	quest.56401D4E34835FEC.title: "链接调查"
	quest.56A750CCE09CE7CB.quest_desc: ["邻近的站点运行着一个ME网络，并且一直在将其烧毁。", "安装一个AE2电源接口，并将你的FE接入他们的网络。"]
	quest.56A750CCE09CE7CB.title: "客户端站点 - ME 网络电源"
	quest.56B6A9AD2C7E82C0.quest_desc: ["沿着海岸铺设电缆，长期缺铜。", "比钢的密度低，但它们总是不断订购。"]
	quest.56B6A9AD2C7E82C0.title: "铜制征集令"
	quest.58277F7F739221BF.quest_desc: ["可裂变同位素，稀有的那种。当局批准的每种燃料棒都需要它。"]
	quest.58277F7F739221BF.title: "许可证 04 - U-235"
	quest.598A71A36A5C4B17.quest_desc: ["将物品注入碳、红石或钻石。这就是Mekanism制造每种合金的方式", "后面的契约都假设你已经拥有了前面的契约。"]
	quest.598A71A36A5C4B17.title: "契约 04 - 合金随需供应"
	quest.5A043973609B8155.quest_desc: ["四根棒子捆在一起。这就是核反应堆真正需要投入的东西。"]
	quest.5A043973609B8155.title: "燃料 02 - 四联棒"
	quest.5B08A07C97E956FD.quest_desc: ["燃料已加注，传动装置已安装，护盾已开启，涡轮机正在运转。", "当局批准的是能高效运行的反应堆，而非仅仅能运行的。"]
	quest.5B08A07C97E956FD.title: "委托 - 运行清洁程序"
	quest.5B83D1D203CF077C.quest_desc: ["SkyBlock 岛屿没有矿石。Sim 方块解决了这个问题：它们消耗计算力", "并按定时器生产真实材料。", "弄好一个，你就有了一条补给线，而不是购物清单。"]
	quest.5B83D1D203CF077C.title: "合约 - 模拟撤离行动"
	quest.5BF8A52E70148BCB.quest_desc: ["将原矿石进行研磨。离心分离机只能分离出粉尘。"]
	quest.5BF8A52E70148BCB.title: "补给 - 铀粉尘"
	quest.5C28CE047E2D68E1.quest_desc: ["箱子不适合存放大量物品。抽屉可以存放巨量的单一物品，", "控制器能让一整面墙的物品都像一个单独的背包一样运作。"]
	quest.5C28CE047E2D68E1.title: "批量 01 - 抽屉控制器"
	quest.5DB34E242C9EA954.quest_desc: ["办公楼的幕墙。量大、廉价，可无限重复使用。"]
	quest.5DB34E242C9EA954.title: "批量玻璃订单"
	quest.5DD80B9720E3A611.quest_desc: ["它们的第一种多方块结构：一个带有墙壁舱门的隔热外壳空心箱。", "这使得普通熔炼无法进行，并开启了电气时代。"]
	quest.5DD80B9720E3A611.title: "契约 05 - 高炉"
	quest.5E5E4BA5E1F2F885.quest_desc: ["铁和碳。钢铁开启了第二级机器。"]
	quest.5E5E4BA5E1F2F885.title: "材料订单 - 钢制材料"
	quest.5EF22337940659FB.quest_desc: ["室外机以180 FE/刻的速度进行压缩，并将热量排出室外。", "放在任何有排气口的位置——屋顶、院子，或者岛屿边缘。"]
	quest.5EF22337940659FB.title: "Site Works - 冷凝器"
	quest.5F80B3D71E9A46C2.quest_desc: ["逐个零件地建造第二台一模一样的机器是徒劳的。", "将已组装的服务器放入商店的重置方块，购买一个全新的副本", "按当前零件价格加收5%的费用。"]
	quest.5F80B3D71E9A46C2.title: "采购 - 重复订单"
	quest.5FE0C9D8F053A788.quest_desc: ["ME 线缆可在同一线路中传输物品、信号和能量 -", "这就是为什么AE2网络在整合包中的布线方式与其他任何网络都不同。"]
	quest.5FE0C9D8F053A788.title: "契约 03 - 布设线缆"
	quest.6002C9E3F81B7A45.quest_desc: ["一个制造团队已经超出了自己工具的承载能力。他们已经运行了青铜和钢的", "在原地种植，并希望在它的基础上建造延伸线路。", "在此签字，零件订单就会开始送达。"]
	quest.6002C9E3F81B7A45.title: "客户简报 - 高级制造系统"
	quest.600593C7F036F48A.quest_desc: ["他们的压板机就是一把锻造锤和一个非常疲惫的员工。", "青铜弯曲机可将锭子制成板件和弧形板件，无需摆动。"]
	quest.600593C7F036F48A.title: "重新锻造 - 青铜锻造术"
	quest.60085DABE8526ECF.quest_desc: ["矿石输入，粉尘输出，吞吐量是单个方块单位的数倍。", "需要充足的蒸汽供应——先确定锅炉大小，再确定多区块结构。"]
	quest.60085DABE8526ECF.title: "批量订单 - 蒸汽浸渍法"
	quest.600B278FE06DE914.quest_desc: ["将多方块技巧应用于冶炼：并行处理，一条蒸汽管。", "与研磨机配套使用——先粉碎，再烹饪，无需一根线缆。"]
	quest.600B278FE06DE914.title: "批量订单 - 蒸汽冶炼"
	quest.600DF173D8896359.quest_desc: ["燃料配送是本客户端最大的重复性成本。", "青铜太阳能锅炉用日光来制造蒸汽。更慢、免费，而且永远不会", "凌晨三点的时候就会干涸见底。"]
	quest.600DF173D8896359.title: "Site Works - 太阳能锅炉"
	quest.6010BB57D0A4DD9E.quest_desc: ["二级压榨机。速度更快，吞吐量更高，并且支持后期的电力升级。", "钢铁标志着这个客户端的植物不再仅仅是一项爱好。"]
	quest.6010BB57D0A4DD9E.title: "重新锻造 - 钢铁塑形"
	quest.6013853BC8C057E3.quest_desc: ["手动合金无法扩展。这个会根据时间表将两种输入合并为一种输出，", "而所有高于它的等级，都是同一台机器，只是耗电更高。"]
	quest.6013853BC8C057E3.title: "重新锻造 - 钢合金熔炉"
	quest.60164F1FC0DBD228.quest_desc: ["流体入罐，食物入盒。营地食堂已写入合同。", "这也是将它们的流体运出基地的唯一合理方法。"]
	quest.60164F1FC0DBD228.title: "契约 - 罐头生产线"
	quest.60191903B8F74C6D.quest_desc: ["证明线路有效：按下易拉罐，装满它，然后交上来。", "检查员吃掉样本。这就是全部测试内容。"]
	quest.60191903B8F74C6D.title: "验收测试 - 罐头口粮"
	quest.601BE2E7B112C6B2.quest_desc: ["植物农业方面的发酵。输入糖，输出有用的液体。", "客户端明确要求这是一个工艺单元，而不是一个容器。"]
	quest.601BE2E7B112C6B2.title: "契约 - 酿酒坊"
	quest.601EACCBA92E40F7.quest_desc: ["蒸汽能带你获得钢铁，却无法带你超越钢铁。", "将第一根电缆接到压制线上，然后取走速度。"]
	quest.601EACCBA92E40F7.title: "电气化 - 弯曲"
	quest.602176AFA149BB3C.quest_desc: ["同样的工作，电动的，现在还能接受超频升级。", "从这里开始，客户端的梯队列表就只取决于你能提供多少力量了。"]
	quest.602176AFA149BB3C.title: "电气化 - 合金熔炉"
	quest.6024409399653581.quest_desc: ["又是那个没有锅炉的大型熔炉。", "并行冶炼，冶炼规模取决于你愿意投入多少个能量口。"]
	quest.6024409399653581.title: "批量订单 - 电力冶炼"
	quest.60270A779180AFC6.quest_desc: ["矿石线的另一半。同样的多方块结构，同样的对增幅器的需求。"]
	quest.60270A779180AFC6.title: "批量订单 - 电动浆料处理机"
	quest.6029D45B899C2A0B.quest_desc: ["客户端受够了漏斗。一个机器链驱动着一整排相同的", "将机器对准一个输入面。排好队，连起来，从前面输入。"]
	quest.6029D45B899C2A0B.title: "自动化 - 机械链合器"
	quest.602C9E3F81B7A450.quest_desc: ["一个假装成多台机器的多功能方块。", "放入你想模仿的机器中，它就会并行运行该配方。", "客户端吞吐量问题到此终结。"]
	quest.602C9E3F81B7A450.title: "自动化 - 处理阵列"
	quest.602F682379D31E95.quest_desc: ["无线供电由此开始。先铜后超导，没人会资助超导体绕组", "在他们看到火花跳跃之前就已经完成了。"]
	quest.602F682379D31E95.title: "研究 - 特斯拉线圈绕组"
	quest.6032320771EE98DA.quest_desc: ["绕组堆叠成线圈。它能在开阔空气中短距离投射能量。", "调试期间请保持距离。致命变种的存在自有其道理。"]
	quest.6032320771EE98DA.title: "原型 - 特斯拉线圈"
	quest.6034FBEB6A0A131F.quest_desc: ["发射器。电力通过电缆从一个地点输入，并从另一个地点通过空中输出。", "无需挖掘壕沟，无需布设电缆，也无需协商通行权。", "这就是客户端实际购买的东西。"]
	quest.6034FBEB6A0A131F.title: "Site Works - 特斯拉塔"
	quest.6037C5CF62258D64.quest_desc: ["接收舱能将广播塔转化为可用的机器动力。", "先从LV开始，用一台机器，确认塔能真正升到那个高度再往上爬。"]
	quest.6037C5CF62258D64.title: "委托 - LV 接收器"
	quest.603A8FB35A4107A9.quest_desc: ["同一个链接，多个层级的预留空间。", "现在无线电网可以运行多方块结构，而不是灯了。"]
	quest.603A8FB35A4107A9.title: "升级 - 高压接收器 (HV Receiver)"
	quest.603D5997525C81EE.quest_desc: ["一个足够小可以携带的接收器。工程师行走时，工具在塔上充电", "现场。客户的维护团队再也不会接入任何东西了。"]
	quest.603D5997525C81EE.title: "野外工具包 - 手持接收器"
	quest.6040237B4A77FC33.quest_desc: ["面板大多是单元格。在给他们报价屋顶前，先让单元格线路运行起来。"]
	quest.6040237B4A77FC33.title: "物资 - 太阳能电池板 (Photovoltaic Cells)"
	quest.6042ED5F42937678.quest_desc: ["将日光转化为电力。无需燃料，无需吞吐量，无需关注。", "植物闲置负载的安静基础供应。"]
	quest.6042ED5F42937678.title: "Site Works - LV 太阳能阵列"
	quest.6045B7433AAEF0BD.quest_desc: ["同一屋顶，向上几层。每块面板都很贵，而且这是该地点唯一的电力来源", "运行起来完全没有任何成本。"]
	quest.6045B7433AAEF0BD.title: "升级 - 高压太阳能电池板阵列"
	quest.6048812732CA6B02.quest_desc: ["将植物废料变回肥料。此客户端的农业部分要么支付", "否则将在下一次董事会会议上被取消。"]
	quest.6048812732CA6B02.title: "契约 - 堆肥处理"
	quest.604B4B0B2AE5E547.quest_desc: ["粪便、磷酸、钾。客户端希望你悄悄进行的化学反应", "并且在办公室的下风向位置建造。"]
	quest.604B4B0B2AE5E547.title: "处理 - NPK 肥料"
	quest.604E14EF23015F8C.quest_desc: ["种植、施肥、收获、重复，期间不能有任何村民在场。", "给它施肥，田地就会自动运作了。"]
	quest.604E14EF23015F8C.title: "自动化 - 电动农夫"
	quest.604E65E5E61D631F.quest_desc: ["反应堆的输出对于高压涡轮机来说太大了。", "大型蒸汽涡轮机是将它转换成货币的装置。"]
	quest.604E65E5E61D631F.title: "建造 07 - 涡轮大厅"
	quest.6050DED31B1CD9D1.quest_desc: ["客户的安保人员想要一个带电池的东西。", "从塔上充电，就再也不用插座了。"]
	quest.6050DED31B1CD9D1.title: "送货 - 纳米光剑"
	quest.6053A8B713385416.quest_desc: ["刚从生产线上下来的动力盔甲。", "在此签署即表示该植物能建造青铜时代无法想象的物品。"]
	quest.6053A8B713385416.title: "送货 - 纳米套装"
	quest.613043FEDAAA4D79.quest_desc: ["由耗尽的燃料棒再加工而成。客户端的反应堆已开始自我供能。"]
	quest.613043FEDAAA4D79.title: "第02周期 - 钚元素"
	quest.626C39B7B5E8DC01.quest_desc: ["将流体和物品结合，制成熔炉无法制造的产品。"]
	quest.626C39B7B5E8DC01.title: "契约 09 - 化学反应器"
	quest.629D29B2DF66D86F.quest_desc: ["一个小小的收尾礼：一个会跟随操作员并按需制作的Robit。", "并非必需，但客户端反正也要求了。"]
	quest.629D29B2DF66D86F.title: "契约 10 - 现场助理"
	quest.631ED9AA24350856.quest_desc: ["从外部自动化反应堆需要它自己的小型网络：", "一个与核心、物流电缆和控制器绑定的裂变接口。"]
	quest.631ED9AA24350856.title: "契约 - 远程控制 (Contract - Remote Control)"
	quest.63B72EED503C21BB.quest_desc: ["挖到的硬币在卖出前不是钱。打开钱包，确定一个位置", "按照当前的历史价格出售。", "价格实时反映市场动态——出售是一种决策，而非例行公事。"]
	quest.63B72EED503C21BB.title: "确定你的第一个位置"
	quest.63CC9ED9319BF0EC.quest_desc: ["承保人不会为无人勘测过的地点提供报价。", "打开一个架子，从面板上读取其温度和瓦数。", "此板上的所有疗法都将以你今天发现的数字为评判标准。"]
	quest.63CC9ED9319BF0EC.title: "Thermal Audit: Baseline"
	quest.648ABF25DC9A5F86.quest_desc: ["在某个地点被辐射污染前，会先通知操作员污染程度。"]
	quest.648ABF25DC9A5F86.title: "场地安全 - 勘测仪"
	quest.6565B62D90DB5AE6.quest_desc: ["在权威签署任何东西之前，这一点不容商议。", "没有它就无法处理强化材料，合同会提前终止，以及其他事项。"]
	quest.6565B62D90DB5AE6.title: "现场安全 - 危险品处理"
	quest.6639FC41631ED64B.quest_desc: ["你从一个树和没有首都开始。木材收购商收购原木、木棍和树苗", "按市价算的——这不是做生意，是启动资金。", "清理掉这棵树，把它变成你的第一桶金。"]
	quest.6639FC41631ED64B.title: "将木材全部出售掉，以腾出空间"
	quest.67DDACF5537C6BCC.quest_desc: ["第三级电路——核许可证正在等待的级别。"]
	quest.67DDACF5537C6BCC.title: "组件顺序 - 数字电路"
	quest.6807AAA1A0FFCB30.quest_desc: ["最顶层，而且可以从外面看到里面的东西 -", "在仓库地板上，这比物品栏数量更重要。"]
	quest.6807AAA1A0FFCB30.title: "布置 05 - 水晶"
	quest.68CFC9728BED7721.quest_desc: ["计算、逻辑和工程处理器。", "设置起来很麻烦，而且下游的所有东西都是由它们组成的。"]
	quest.68CFC9728BED7721.title: "契约 02 - 处理器"
	quest.69154A789DC8E21A.quest_desc: ["比普通熔炉更快，而且自身不消耗任何燃料。"]
	quest.69154A789DC8E21A.title: "契约 02 - 蒸汽冶炼"
	quest.69C4565E845D2B03.quest_desc: ["刹车。当局在检查燃料前会先检查刹车。"]
	quest.69C4565E845D2B03.title: "建造 02 - 控制杆"
	quest.6A92C9384444795F.quest_desc: ["移动空气只有在有地方可以将其移动到更冷的地方时才能生效。", "空调通过制冷而非移热来降温——首个真正的解决方案", "你的整个房间都暖和起来之后就可以了。"]
	quest.6A92C9384444795F.title: "补救措施 03 - 主动冷却"
	quest.6B79FF2FEBE85BC0.quest_desc: ["已记录客户端投诉：硬件未变更，吞吐量下降。", "堵住 Rack 的前进气口，观察容量下降，这样你就能一眼认出它了。", "重现故障，然后清除故障。"]
	quest.6B79FF2FEBE85BC0.title: "故障报告 - 入口堵塞"
	quest.6C8C74C50A00346F.quest_desc: ["将电路模式压入硅片中。客户端不能有网络", "直到它们能自己制造处理器为止。"]
	quest.6C8C74C50A00346F.title: "契约 01 - 铭文师"
	quest.6DC93476A859F350.quest_desc: ["54个物品栏 - 单个方块内的双箱，无需考虑双箱的占地面积。"]
	quest.6DC93476A859F350.title: "装修 02 - 铁质风格"
	quest.6DD12415C8716FB7.quest_desc: ["将水晶放入充电器。用于制作流质，", "还有Fluix门，满足这个客户端提出的所有要求。"]
	quest.6DD12415C8716FB7.title: "输入 - 已充能的 Certus 矿石"
	quest.6E787D2E63E03FFE.quest_desc: ["铜和锡。他们的整个蒸汽时代都是由它们建造的。"]
	quest.6E787D2E63E03FFE.title: "材料订单 - 青铜"
	quest.6EDFBD230A821347.quest_desc: ["可裂变同位素，稀有的那种。每根燃料棒都需要它。"]
	quest.6EDFBD230A821347.title: "补给品 - U-235"
	quest.6FFE9564ECCDFB5C.quest_desc: ["乏燃料并非废物。再加工它，该地点就能自给自足。"]
	quest.6FFE9564ECCDFB5C.title: "许可证 07 - 再加工"
	quest.7035D7A897BAC5CD.quest_desc: ["切割工具。这是你的合成器每单位能卖的最高价格 -", "以及板上最慢的合同又重新回到了牌桌上。"]
	quest.7035D7A897BAC5CD.title: "工业钻石"
	quest.71872353B0135F54.quest_desc: ["给它燃料，冷却它，然后将蒸汽导向涡轮机。", "然后盯着热量读数看整整一分钟，再离开。", "一分钟过热反应堆会永远过热——直到它不再过热。"]
	quest.71872353B0135F54.title: "委托 - 进入临界状态"
	quest.71991DAC5F19CD04.quest_desc: ["重氢，从重水中离心分离。核聚变燃料混合物的一半。"]
	quest.71991DAC5F19CD04.title: "融合 01 - 氘原子核"
	quest.71A361F851BDD154.quest_desc: ["完全没有电网也能研磨矿石和作物。", "便宜、缓慢，而且是铸造厂目前负担得起的首种加工方式。"]
	quest.71A361F851BDD154.title: "契约 01 - 研磨任务"
	quest.723151349EB66865.quest_desc: ["目录中最便宜的电缆，也是短距离传输的正确选择", "这样就不会有任何人能够将其饱和了。", "从这里开始，这样停用后你就能感受到区别了。"]
	quest.723151349EB66865.title: "契约 - 最后一公里"
	quest.731A34C906EA2877.quest_desc: ["蒸汽输入，电力输出。重工业不再只是一个蒸汽工厂的时刻到了", "成为一个电网——也是它们的套件能与你FE交汇的节点。"]
	quest.731A34C906EA2877.title: "契约 06 - 电气化"
	quest.7383A634C9B3F5F0.quest_desc: ["后期所有配方的基础。过了这一步，几乎没什么东西是手工制作的了。"]
	quest.7383A634C9B3F5F0.title: "契约 07 - 装配器"
	quest.73847B5EBEA613EB.quest_desc: ["两个单元在连接之前，不能算是一个系统。", "在室内机和室外机之间运行制冷剂管道。"]
	quest.73847B5EBEA613EB.title: "Site Works - 制冷剂运输任务"
	quest.73B0DDC64A8657AD.quest_desc: ["将裂变燃料封存在外壳内的组件。"]
	quest.73B0DDC64A8657AD.title: "核许可证 02 - 燃料柱"
	quest.759CFF3C0E3580ED.quest_desc: ["将下方的盆中物品进行组合。黄铜订单取决于此。"]
	quest.759CFF3C0E3580ED.title: "契约 03 - 混合配方"
	quest.75FF7CA2F217076F.quest_desc: ["仓库里地板上堆满了木箱。从升级路径开始：45个箱子。"]
	quest.75FF7CA2F217076F.title: "装修 01 - 铜制风格"
	quest.761BC919DFC0EA4E.quest_desc: ["108 个槽位，也是客户端请求昂贵物品前的最后一站。"]
	quest.761BC919DFC0EA4E.title: "装修 04 - 钻石"
	quest.762D04711B3776A0.quest_desc: ["运行中的反应堆产出的东西——也就是最终产物。", "反应堆本身不发电，只产生非常热的蒸汽。"]
	quest.762D04711B3776A0.title: "冷却剂 02 - 蒸汽循环"
	quest.7672CD6D4C048480.quest_desc: ["原矿石不可交付。将其熔炼成锭，这才是可交付的形式", "本板上的所有下游合同都已计入价格。"]
	quest.7672CD6D4C048480.title: "熔炼至特定形态"
	quest.76DF69721AB2BB50.quest_desc: ["聚变反应堆产生的是等离子体，而不是蒸汽，只有它能喝下等离子体。", "公告板上最后一个委托任务。"]
	quest.76DF69721AB2BB50.title: "融合 05 - 等离子涡轮机"
	quest.771154D20F82808F.quest_desc: ["最后一项审计内容，也是决定其余一切是否有意义的关键。", "进气口在前，出气口在后——对齐它们，让冷空气和热空气", "永远不要混合，这样就能通过检查了。"]
	quest.771154D20F82808F.title: "认证 - 过道收容协议"
	quest.78BF97A8BF05E0C0.quest_desc: ["第二个站点已开启。口袋是共享物品栏的便携端。"]
	quest.78BF97A8BF05E0C0.title: "物流 01 - 末影袋"
	quest.797BA966D0F2C680.quest_desc: ["Cogwork Foundry 建造的机器依靠旋转而非电力运行。", "安山合金是它们的基础材料，没有它，这个板子上就什么也没有。"]
	quest.797BA966D0F2C680.title: "输入 - 安山岩合金"
	quest.7C84365CEEABAF9C.quest_desc: ["锌和铜混合在一起。部署器及以上的所有内容都受其控制。"]
	quest.7C84365CEEABAF9C.title: "材料订单 - 黄铜"
	quest.7CB64DE1AB501F07.quest_desc: ["框架周围的八块青铜板。每台蒸汽时代的机器都需要一个作为外壳。"]
	quest.7CB64DE1AB501F07.title: "基础工程 - 机器外壳"
	quest.7CC2A58355603902.quest_desc: ["将石英粉熔炼成硅：所有AE2处理器的基板。"]
	quest.7CC2A58355603902.title: "输入 - 硅 (Silicon)"
	quest.7D5B03FAA7732AB4.quest_desc: ["白天免费，夜间无用。按区域而非等级缩放。"]
	quest.7D5B03FAA7732AB4.title: "第02代 - 太阳能"
	quest.7DBD6B94391E201E.quest_desc: ["计算作为材料比作为数字更有价值。", "高级合成器将原始计算力转化为实体物品 -", "也就是另一块板子上所有Standing Order的实际构成材料。"]
	quest.7DBD6B94391E201E.title: "契约 - 材料工作台"
	quest.7F1730115684B8F2.quest_desc: ["整个电力系统的起点。低压，低期望，", "在它存在之前，其他任何方法都无效。"]
	quest.7F1730115684B8F2.title: "Tier 01 - 低压电路"
