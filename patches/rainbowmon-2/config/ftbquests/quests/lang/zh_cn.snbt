	chapter.5000000000000000.title: "沿着道路前行"
	chapter.6000000000000000.title: "畜牧的艺术"
	chapter.7000000000000000.title: "精英之路 (La Voie de l'Elite)"
	quest.1001000000000001.quest_desc: [
		"获取你的图鉴，开始在这个世界中的冒险吧！"
		"它能让你记录所有遇到的宝可梦。"
	]
	quest.1001000000000001.title: "欢迎，驯兽师！"
	quest.1001000000000002.quest_desc: [
		"抓住你的第一只宝可梦！"
		"靠近一只野生宝可梦，降低它的生命值，然后投出你的精灵球。"
	]
	quest.1001000000000002.title: "初次接触"
	quest.1001000000000003.quest_desc: [
		"5 只野生宝可梦，让你的队伍得到锻炼。"
		"战斗是获得经验值的最佳方式。"
	]
	quest.1001000000000003.title: "战斗开始！"
	quest.1001000000000004.quest_desc: [
		"让你的宝可梦之一达到10级。"
		"继续战斗，必要时使用稀有糖果！"
	]
	quest.1001000000000004.title: "最高等级"
	quest.1001000000000005.quest_desc: [
		"Les Apricorns sont la matiere premiere des Poke Balls."
		"先在野外收集一些红色浆果来开始吧。"
	]
	quest.1001000000000005.title: "杏树的丰收季节"
	quest.1001000000000006.quest_desc: [
		"自己制作10个精灵球！"
		"将变形后的 Apricorn 与 Apricorn 唱片相结合。"
	]
	quest.1001000000000006.title: "球体的工匠"
	quest.1001000000000007.quest_desc: [
		"制作一个Sophisticated Backpack来携带所有你的装备。"
		"一个有组织的驯兽师就是一个胜利的驯兽师！"
	]
	quest.1001000000000007.title: "冒险家的双口袋背包"
	quest.1001000000000008.quest_desc: [
		"放置一个睡袋（Comforts）即可在任何地方睡觉！"
		"非常适合在长途探险中寻找宝可梦时使用。"
	]
	quest.1001000000000008.title: "旅行者的休憩之所"
	quest.2001000000000001.quest_desc: [
		"制造4个齿轮，启动你的第一台Create机器。"
		"自动化将改变你的游戏方式！"
	]
	quest.2001000000000001.title: "最初的齿轮装置"
	quest.2001000000000002.quest_desc: [
		"合成一个 Water Wheel 并将其连接到水流上。"
		"这是你的首个免费旋转动力源！"
	]
	quest.2001000000000002.title: "水车 (La Roue a Eau)"
	quest.2001000000000003.quest_desc: [
		"制造一个磨石并将其连接到能源源上。"
		"它可以把矿石和材料磨成有用的粉末。"
	]
	quest.2001000000000003.title: "风车小屋"
	quest.2001000000000004.quest_desc: [
		"Le Mechanical Press permet de comprimer des materiaux et creer des lingots."
		"获取黄铜（铜+锌）的必需品。"
	]
	quest.2001000000000004.title: "机械压榨机"
	quest.2001000000000005.quest_desc: [
		"制造一个机械搅拌机来自动混合材料。"
		"它可以通过将铜和锌一起熔炼来制作黄铜。"
	]
	quest.2001000000000005.title: "Le Melangeur"
	quest.2001000000000006.quest_desc: [
		"传送带（Belts）可以在机器之间运输物品。"
		"制造2条传送带，并开始自动化你的生产线。"
	]
	quest.2001000000000006.title: "运输皮带"
	quest.2001000000000007.quest_desc: [
		"制作一个黄铜外壳，证明你已掌握中期的 Create 内容。"
		"黄铜开启了最先进创造机制的大门。"
	]
	quest.2001000000000007.title: "青铜时代"
	quest.2001000000000010.quest_desc: [
		"合成 Create Goggles 以可视化应力和旋转流。"
		"调试机器时不可或缺的工具！"
	]
	quest.2001000000000010.title: "工程师眼镜"
	quest.3001000000000001.quest_desc: [
		"捕捉10种不同类型的宝可梦。"
		"多样性是一支强大团队的关键！"
	]
	quest.3001000000000001.title: "收藏之旅就此开始"
	quest.3001000000000002.quest_desc: [
		"赢得20场与野生宝可梦的战斗。"
		"训练锻造冠军！"
	]
	quest.3001000000000002.title: "经验丰富的战斗者"
	quest.3001000000000003.quest_desc: [
		"让你的宝可梦首次进化。"
		"达到正确的等级或使用进化石！"
	]
	quest.3001000000000003.title: "进化！Evolution !"
	quest.3001000000000004.quest_desc: [
		"制造并放置一个Cobblemon PC来存储你的宝可梦。"
		"Tu peux aussi y gérer tes équipes et discuter avec des amis."
	]
	quest.3001000000000004.title: "驯兽师的个人电脑"
	quest.3001000000000005.quest_desc: [
		"使用SimpleTMs给你的宝可梦使用一个CT (TM)。"
		"教宝可梦学习一个不在其正常列表中的能力！"
	]
	quest.3001000000000005.title: "能力的主宰者"
	quest.3001000000000006.quest_desc: [
		"将你的宝可梦之一升到30级。"
		"到了这个阶段，某些宝可梦会学会它们最强大的能力。"
	]
	quest.3001000000000006.title: "等级30！"
	quest.3001000000000007.quest_desc: [
		"捕捉25种不同的物种来丰富你的图鉴。"
		"Consulte la Cobblepedia pour trouver les Pokemon qui te manquent !"
	]
	quest.3001000000000007.title: "25 已捕获物种"
	quest.3001000000000008.quest_desc: [
		"捕捉5只火系宝可梦，证明你对火系的掌握！"
		"类型是一切有效 Cobblemon 策略的关键。"
	]
	quest.3001000000000008.title: "类型猎人"
	quest.4001000000000001.quest_desc: [
		"探索 Cobblemon Industries，融合 Create 和 Cobblemon 的模组。"
		"合成这个整合包中的首个物品！"
	]
	quest.4001000000000001.title: "Cobblemon Industries"
	quest.4001000000000002.quest_desc: [
		"用你的 Create 机器自动化精灵球的生成。"
		"使用压榨机+搅拌机+传送带，打造真正的球体工厂！"
	]
	quest.4001000000000002.title: "La Chaine des Balls"
	quest.4001000000000003.quest_desc: [
		"用Create模组搭建一个自动化的Apricorn农场。"
		"使用机械收割机或种植机来自动化收割。"
	]
	quest.4001000000000003.title: "关闭 Apricorns 农场"
	quest.4001000000000004.quest_desc: [
		"合成并激活一个 Create Mechanical Spawner。"
		"它通过旋转能量自动生成怪物。"
	]
	quest.4001000000000004.title: "机械刷怪器"
	quest.4001000000000005.quest_desc: [
		"用你的 Create 机器处理宝可梦浆果。"
		"Le Mechanical Mixer peut combiner des baies pour créer des mélanges puissants."
	]
	quest.4001000000000005.title: "浆果加工厂"
	quest.4001000000000006.quest_desc: [
		"放置一台 CC:Tweaked 计算机，编写你的第一个程序。"
		"Tu peux l'interfacer avec Create pour controler tes usines !"
	]
	quest.4001000000000006.title: "高级计算机科学 (Informatique Avancee)"
	quest.4001000000000007.quest_desc: [
		"使用 Create: Enchantment Industry 自动化附魔过程。"
		"Plus besoin de passer des heures sur une table d'enchantement !"
	]
	quest.4001000000000007.title: "工业附魔（Enchantement Industriel）"
	quest.4001000000000008.quest_desc: [
		"制作 Create Ore Excavation 钻头，实现自动挖矿。"
		"将挖掘机对准矿脉，见证奇迹的发生！"
	]
	quest.4001000000000008.title: "挖掘机械 L'Excavatrice"
	quest.5001000000000001.quest_desc: [
		"放置一个Waystone，以便在各个基地之间传送。"
		"传送石对于快速旅行至关重要！"
	]
	quest.5001000000000001.title: "参考点"
	quest.5001000000000002.quest_desc: [
		"制作一张Warp Scroll，即可传送到任意Waystone。"
		"一个体面旅行者的必备工具！"
	]
	quest.5001000000000002.title: "世界制图师 (Cartographe du Monde)"
	quest.5001000000000003.quest_desc: [
		"在远古城市中找到一个回声碎片，以证明你探索了深海。"
		"这些古老的遗迹也是某些稀有宝可梦的巢穴……"
	]
	quest.5001000000000003.title: "神话与传说"
	quest.5001000000000004.quest_desc: [
		"获取并使用 CobbleNav 在区域间轻松导航。"
		"它会显示附近的宝可梦及其刷新位置。"
	]
	quest.5001000000000004.title: "宝可梦导航仪"
	quest.5001000000000005.quest_desc: [
		"收集20个超球 - 你将会需要它们来对抗突袭首领！"
		"Les Raid Dens font apparaître des Pokémon puissants avec des IV supérieurs à la moyenne."
	]
	quest.5001000000000005.title: "掠夺者巢穴的修复工程"
	quest.5001000000000006.quest_desc: [
		"寻找并挖掘一个考古遗址（更好的考古学）。"
		"独特的文物和稀有的奖励正等着你！"
	]
	quest.5001000000000006.title: "考古学家"
	quest.5001000000000007.quest_desc: [
		"通过 CobbleBadges 赢得你的第一个道馆徽章！"
		"徽章证明了你的驯兽师价值。"
	]
	quest.5001000000000007.title: "道馆徽章"
	quest.6001000000000001.quest_desc: [
		"放置一个牧场方块来开始培育宝可梦。"
		"把两只兼容的宝可梦放进去，然后耐心等待！"
	]
	quest.6001000000000001.title: "牧场物语"
	quest.6001000000000002.quest_desc: [
		"从牧场方块中获得你的第一个宝可梦蛋。"
		"把它放在你的队伍里，边走边孵化它。"
	]
	quest.6001000000000002.title: "一枚珍贵的蛋"
	quest.6001000000000003.quest_desc: [
		"孵化3枚宝可梦蛋。"
		"每次孵化都有几率获得个体值优秀的宝可梦！"
	]
	quest.6001000000000003.title: "La Nursery Ouvre ses Portes"
	quest.6001000000000004.quest_desc: [
		"合成 Power Bracer 来最大化宝可梦的攻击EV。"
		"EV和IV对于竞技宝可梦来说同样重要！"
	]
	quest.6001000000000004.title: "EV 大师"
	quest.6001000000000005.quest_desc: [
		"获得一只至少一项能力值为31的宝可梦。"
		"Utilisez le Destiny Knot pour transmettre les IVs d'un parent à l'œuf."
	]
	quest.6001000000000005.title: "完美的遗产"
	quest.6001000000000006.quest_desc: [
		"孵化总共10个宝可梦蛋。"
		"坚持不懈终有回报：你的刺客们现在开始行动！"
	]
	quest.6001000000000006.title: "繁殖增强器 (Eleveur Prolifique)"
	quest.7001000000000001.quest_desc: [
		"在图鉴中记录100种不同的物种。"
		"探索所有生物群系 - 每个环境都有自己的宝可梦！"
	]
	quest.7001000000000001.title: "图鉴：100 道菜式"
	quest.7001000000000002.quest_desc: [
		"捕捉50种不同的宝可梦物种！"
		"Tu es desormais un dresseur experimente - les legendaires ne sont plus tres loin."
	]
	quest.7001000000000002.title: "五十种物种！"
	quest.7001000000000003.quest_desc: [
		"赢得总共100场战斗！你现在是一名真正的冠军驯兽师了。"
		"使用 CobbleStats 来追踪你的战斗统计数据。"
	]
	quest.7001000000000003.title: "冠军挑战赛（Champion Incontest）"
	quest.7001000000000004.quest_desc: [
		"获得一枚Key Stone，解锁MEGA进化（MEGA Showdown）！"
		"装备在身上，以便在战斗中让你的宝可梦进行巨化进化。"
	]
	quest.7001000000000004.title: "MEGA 战斗！"
	quest.7001000000000005.quest_desc: [
		"制作一套高级下界合金装备。"
		"终极材料，保护最棒的驯兽师！"
	]
	quest.7001000000000005.title: "虚空锻造者"
	quest.7001000000000006.quest_desc: [
		"制造4个精密机械 - 最复杂的Create组件。"
		"需要黄铜、电子管和金箔：这是你掌握 Create 的最终证明。"
	]
	quest.7001000000000006.title: "大型工厂"
	quest.7001000000000007.quest_desc: [
		"Enregistre 250 espèces - tu deviens une légende vivante !"
		"Le Shiny Charm augmentera tes chances de rencontrer des Pokemon Shiny."
	]
	quest.7001000000000007.title: "图鉴：250 道菜式"
	quest.7001000000000008.quest_desc: [
		"证明你已完成一切，锻造出4个下界合金锭。"
		"Cobblemon, Create, exploration, élevage - tu as véritablement maîtrisé Rainbowmon !"
	]
	quest.7001000000000008.title: "彩虹兽：终极进化！"
}
