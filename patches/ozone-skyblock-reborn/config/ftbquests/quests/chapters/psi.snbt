			}]
			x: 2.0d
			y: 3.0d
		}
		{
			dependencies: ["22AEDCCADAFFAC5A"]
			description: [
				"有关Terrasteel仪式的详细信息，请参阅Botania Lexicon。"
				""
				"与曼纳钢制成的盔甲类似，泰拉钢盔甲也能使用背包中的法力来恢复生命。"
				""
				"不过，它的属性与铁制盔甲相比，更类似于下界合金盔甲。"
			]
			id: "41275C2B37848720"
			rewards: [
