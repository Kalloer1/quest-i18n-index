				{
					id: "42DD71432A4A6EFF"
					item: {
						Count: 1
						id: "minecraft:written_book"
						tag: {
							author: "DaRubb3rDucky1"
							filtered_title: "Final Report"
							pages: [
								"{\"text\":\"      Final Report\\n\\nThe previous citizens of this universe were able to summon creatures from other timelines and one of these creatures were pandas. They began genetically modifying these pandas to make them produce resources akin to the chickens from \"}"
								"{\"text\":\"      Final Report\\n\\nuniverse BBL-135. They continued their pursuit for stronger \\\"resource pandas\\\" until the could no longer make them any stronger. At this point the were now producing singularities of resources. These \\nsingularities were\"}"
								"{\"text\":\"      Final Report\\n\\nunlike the data singularities from before in that they were made from one single resource and very unstable. At the slightest bit of excitement they would collapse leaving behind thousands of a single resource. Through more \"}"
								"{\"text\":\"      Final Report\\n\\nexperimentation they were able to create something I call the \\\"Infinity Catalyst\\\" and use that to create an \\\"Infinity Ingot\\\". This Infinity Ingot is a very powerful material and must be contained with neutronium. Even the creation of the \"}"
								"{\"text\":\"      Final Report\\n\\nInfinity Ingot requires neutronium. However, an extremely powerful material such as this does not come without its drawbacks. When combined with fragments of reality these \\\"Infinity Equipments\\\" can produce uncontained black holes. These\"}"
								"{\"text\":\"      Final Report\\n\\ncan even kill someone through Infinity Armor and are what I belive are the cause of the destruction of this universe. With this my work here is done and I'll be heading home soon.\"}"
							]
							title: "最终报告"
						}
					}
					type: "item"
				}
