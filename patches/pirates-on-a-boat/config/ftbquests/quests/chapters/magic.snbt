	quests: [
		{
			description: ["Iron’s Spells ‘n Spellbooks 是一款受经典 RPG 游戏启发的魔法模组，旨在将经典的施法奇幻元素引入游戏。注重成长，你可以通过与危险的巫师战斗、掠夺众多建筑、深入地下城、收集资源和寻找强大的魔法物品来获得力量。"]
			id: "6DA4403ED9F33EA5"
			rewards: [{
				id: "2E54D995F1663DB4"
				item: {
					Count: 1
					id: "patchouli:guide_book"
