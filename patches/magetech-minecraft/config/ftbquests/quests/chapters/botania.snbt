		{
			dependencies: ["0F667F04FA5F2A97"]
			description: [
				"要创造能听从命令的植物，植物学家需要一种将神秘能量注入植物的特殊方法。"
				""
				"&7幸运的是，Petal Apothecary 正好可以做到这一点。"
				""
				"放置在世界中并加入水（右键或用水桶）后，该方块会吸收投入的任何 Mystical Petals 的能量"
				""
				"&7提供正确的花瓣后，投入任意种子即可最终完成制作过程。"
				""
				"手持空手潜行右键点击花瓣药剂师，将移除最后投入的物品。"
			]
			id: "40F5A1075189550F"
			rewards: [{
				count: 16
				id: "4EE395B84C73268F"
				item: "minecraft:wheat_seeds"
				type: "item"
			}]
			shape: "octagon"
			subtitle: "制作一个花瓣药剂师工作台。"
			tasks: [{
				id: "5C65E2B080E985F1"
				item: "botania:apothecary_default"
				type: "item"
			}]
			x: 3.4d
			y: 0.0d
		}
		{
			dependencies: ["40F5A1075189550F"]
			description: [
				"将4片白色花瓣和1个种子放入花瓣药房即可合成，纯雏菊是植物学家最重要的花朵。"
				""
				"&7这种花能将相邻的任何木材和石头方块（如下一页所示）净化为对应的净化版本，即活木和活岩。"
				""
				"这些资源是植物学家职业生涯中重要的合成材料。"
				""
				"&7将其他方块放置在花朵周围也可以净化它们。虽然不像活体方块那样独特和必要，但这些配方仍然很有用：</c1>"
				""
				"下界岩会净化成鹅卵石，灵魂沙会净化成沙子，冰会净化成压实冰，水会净化成雪。"
			]
			id: "096F2F0D9F44C94C"
			rewards: [
				{
					id: "718AEE1B39E4CCAE"
					item: "botania:pure_daisy"
					type: "item"
				}
				{
					id: "6231A5450B88364C"
					type: "xp"
					xp: 150
				}
			]
			shape: "octagon"
			subtitle: "获取一朵纯净雏菊。"
			tasks: [{
				id: "68F076E4EE3CBD78"
				item: "botania:pure_daisy"
				type: "item"
			}]
			x: 4.5d
