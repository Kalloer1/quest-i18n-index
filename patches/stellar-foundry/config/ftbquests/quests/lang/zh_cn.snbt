	quest.1918579C00105426.quest_desc: [
		"合成 Foundry Alloy Mix 并在 JEI 中查看其用途。"
		"2.4.0 版本不再将新组件隐藏在可选配方中。此混合物是迈向发射台的第一步。"
	]
	quest.1918579C00105426.quest_subtitle: "自定义启动链现在从一个可见的包拥有材料开始。"
	quest.1918579C00105426.title: "开始熔炉路线"
	quest.645B124B5404CEDB.quest_desc: [
		"通过恒星锻造炉的转换配方之一来制作恒星钢。"
		"通用 Stellaris 配方已被替换，JEI 会指向预期的整合包配方，而不是默认为 Immersive Engineering 的钢。"
	]
	quest.645B124B5404CEDB.quest_subtitle: "专用钢现已成为发射链的必需部分。"
	quest.645B124B5404CEDB.title: "生产恒星钢（Stellaris Steel）"
	quest.A42C9D7E10B5F361.quest_desc: [
		"制作一个密封机器框架。"
		"这是后期任务电子设备使用的结构核心，证明了各工厂分支正在为一个共享的太空计划提供动力。"
	]
	quest.A42C9D7E10B5F361.quest_subtitle: "工业钢、压力技术和控制电路在此交汇。"
	quest.A42C9D7E10B5F361.title: "建造一个密封机器框架"
	quest.B71E4A2C90D63F58.quest_desc: [
		"制作一个任务数据核心。"
		"它将 Refined Storage 处理器与 Orbital Guidance Chip 连接，是火箭鼻锥和任务系统所必需的。"
	]
	quest.B71E4A2C90D63F58.quest_subtitle: "存储逻辑变成了飞行硬件。"
	quest.B71E4A2C90D63F58.title: "组装一个任务数据核心"
	quest.C94F20A6B17D3E85.quest_desc: [
		"制作四个发射器框架组件。"
		"这些部分被发射台、尾翼、引擎、氧气罐和火箭站所必需。打开JEI查看每个相关配方。"
	]
	quest.C94F20A6B17D3E85.quest_subtitle: "新的配方现已加入主线任务流程中。"
	quest.C94F20A6B17D3E85.title: "制造发射器框架分段"
	quest.0F9CB1D007F3484B.quest_desc: [
		"使用压力密封剂、PneumaticCraft 零件、Stellaris 钢和发射框架段来制作 Stellaris 氧气罐。"
		"这取代了旧的独立路线，使坦克成为工厂整体进度的一部分。"
	]
	quest.0F9CB1D007F3484B.quest_subtitle: "压力技术现已直接绑定到发射框架上。"
	quest.0F9CB1D007F3484B.title: "建造一个氧气罐"
	quest.430CC210EA629E38.quest_desc: [
		"使用 JEI 中显示的 Stellar Foundry 配方制作九个火箭发射台。"
		"原始配方已被替换，因此这不再是可选的替代方案。"
	]
	quest.430CC210EA629E38.quest_subtitle: "该平台现在使用 Foundry Alloy Mix 和 Launch Frame Segments。"
	quest.430CC210EA629E38.title: "建造火箭发射台"
	quest.443BFF8007D296A8.quest_desc: [
		"使用 Launch Frame Segments、Stellaris Steel 和 Create Sail Frames 制作四个 Rocket Fins。"
		"这些是连接第12章路线所需的必要部分。"
	]
	quest.443BFF8007D296A8.quest_subtitle: "创建工程现在会直接贡献给载具。"
	quest.443BFF8007D296A8.title: "制作火箭尾翼"
	quest.6ECF54F778BDA78C.quest_desc: [
		"使用新的恒星熔炉配方来制作火箭引擎和火箭鼻锥。"
		"引擎使用多个技术分支，而鼻锥则需要任务数据核心。"
	]
	quest.6ECF54F778BDA78C.quest_subtitle: "动力、精度、制导和压力系统汇聚一处。"
	quest.6ECF54F778BDA78C.title: "制作引擎和鼻锥组件"
	quest.30221B26A537ED0A.quest_desc: [
		"使用 Mission Data Core、Mission Manifest、Stellaris Steel 和 Launch Frame Segment 制作火箭站。"
		"此配方取代了之前的默认路线。"
	]
	quest.30221B26A537ED0A.quest_subtitle: "Mission Control 使用了相同的启动基础设施构建而成。"
	quest.30221B26A537ED0A.title: "添加一个火箭空间站"
}
