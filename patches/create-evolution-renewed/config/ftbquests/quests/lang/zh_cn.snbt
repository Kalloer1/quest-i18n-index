	quest.6986767827914A8E.quest_subtitle: "装饰方块"
	quest.698D5738EA593FFC.quest_subtitle: "装饰方块"
	quest.6A0B52B4AA96B42E.quest_desc: ["气动锤利用压缩空气发动猛烈的重击，并产生强大的击退效果。其锤头可在石质、铁质、钻石质与下界合金质之间切换。"]
	quest.6A0B52B4AA96B42E.quest_subtitle: "气动近战粉碎器"
	quest.6A25B4076E0CC9CD.quest_desc: ["将其链接到监视器，然后设置起点和终点以定义安全区域。该区域内的目标将不受影响，从而保护友方基地免受火力波及。"]
	quest.6A25B4076E0CC9CD.quest_subtitle: "标记一片禁止开火的区域"
	quest.6A2D63867E5FDE2A.quest_subtitle: "装饰方块"
	quest.6A6CEE66F2315D7B.quest_subtitle: "装饰方块"
	quest.6B4961271FD5583C.quest_subtitle: "装饰方块"
