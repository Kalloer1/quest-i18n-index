	quest.0B8148DAF5CC9DF1.quest_desc: ["用于固定电线，以连接大电流连接器。右键点击两个连接器即可在保持线轴的情况下，在它们之间拉一根电线。"]
	quest.0B8148DAF5CC9DF1.quest_subtitle: "存储大电流电线"
