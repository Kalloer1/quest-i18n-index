	quest.6F79A45B3B7C7922.quest_subtitle: "装饰方块"
	quest.6F8DCE5AA76BBABA.quest_desc: ["一块压制的锌板，是多种电子元件的合成材料。"]
	quest.6F8DCE5AA76BBABA.quest_subtitle: "合成组件。"
	quest.6FE2FE40C2F60183.quest_desc: ["可独立控制两个方向的旋转。"]
