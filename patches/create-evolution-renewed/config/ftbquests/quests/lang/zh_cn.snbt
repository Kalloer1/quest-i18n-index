	quest.0D64DF0EB98C9690.quest_subtitle: "装饰方块"
	quest.0D66BC7C5944593E.quest_subtitle: "装饰方块"
	quest.0D84377B8557480E.quest_desc: ["右键点击带有图表的模拟装置，即可打开其受力分析图——包括升力、推力、重力等——从而找出它无法正常飞行的原因。"]
	quest.0D84377B8557480E.quest_subtitle: "检查你飞行器上的受力情况"
	quest.0DCDD36966636D1E.quest_subtitle: "装饰方块"
	quest.0DDFA97B2CCEC0B5.quest_subtitle: "装饰方块"
	quest.0DEEA086C9B29217.quest_desc: ["“创造家具”是一款能提升《我的世界》体验的模组，它为游戏增添了工业风格的家具！如果你是“创造”模组的粉丝，这款模组能完美补充你的建筑，引入各种材质和颜色的桌子、椅子和凳子。非常适合用来装饰工作室、餐厅或舒适的蒸汽朋克角落！"]
	quest.0DFB345FC3022432.quest_desc: [
		"[ { \"text\": \"创造室内\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4581823B7CB90873\" } } ]"
		""
		""
		"是的，你必须把所有颜色的家具都做出来 :)"
	]
	quest.0DFB345FC3022432.title: "创造室内"
	quest.0E5FC39E6C71A872.quest_desc: [
		"&6&o轴&r&r可用于连接两个机械部件，使其中一个的转动带动另一个转动。"
		""
		"当两个机械部件通过一根轴连接时，施加在任一部件上的任何&2旋转力&r都会连同其&d速度&r一并传递给另一个部件。因此，如果两个部件都施加了应力，就可能导致机器过载。"
	]
	quest.0E5FC39E6C71A872.quest_subtitle: "轴杆是 Create 模组中的一种基础机械部件。"
	quest.0E5FC39E6C71A872.title: "&l&6轴杆"
