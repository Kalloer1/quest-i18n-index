	chapter.085BA5E47FCD552C.title: "欢迎来到创造工坊 (CreateCraft)"
	chapter.2BF5527C4EBD37A2.title: "地平线上的硝烟"
	chapter.3BB5BE862A3FD257.title: "欢迎来到创造工坊 (CreateCraft)"
	chapter.3C02BFE10D790CD3.title: "地平线上的硝烟"
	chapter.48C8A73FBA3728E0.title: "地平线上的硝烟"
	chapter.4DF3F401C474B2D3.title: "地平线上的硝烟"
	chapter.5C2B7902592816BD.title: "欢迎来到创造工坊 (CreateCraft)"
	chapter.5CAD2564E696A1BB.title: "地平线上的硝烟"
	chapter.78B41A775EA3B2B9.title: "地平线上的硝烟"
	quest.0000000000000010.quest_desc: [
		"欢迎来到 CreateCraft Aero SMP！"
		""
		"这个世界融合了机械自动化、神秘魔法和荒野生存。"
		""
		"天空由你征服。齿轮已准备就绪。"
		"你的故事将从何处开始呢？"
	]
	quest.0000000000000010.title: "一个新世界正等待着你"
	quest.0000000000000020.quest_desc: [
		"熬过你的第一个夜晚。"
		""
		"世界很美，却不容你犯错。寻找庇护所，制作工具，活到黎明到来。"
	]
	quest.0000000000000020.title: "第一个夜晚"
	quest.0000000000000030.quest_desc: [
		"找到或制作一块 Waystone 并激活它。"
		""
		"传送石会将你与世界中的一个地点绑定。请给它取个好名字。"
		"你的朋友可以从任何地方瞬移到你的石头上。"
	]
	quest.0000000000000030.title: "标记你的领地"
	quest.0000000000000040.quest_desc: [
		"打开 Xaero's World Map 来确定你的方向。"
		""
		"按 [M] 键打开世界地图。"
		"角落里的迷你地图会一直追踪你的位置。"
	]
	quest.0000000000000040.title: "绘制土地地图"
	quest.0000000000000050.quest_desc: [
		"制作一把铁质镐子。"
		""
		"石头让你起步。铁让你前进。"
		"这个世界上的一切都是由铁打造的。"
	]
	quest.0000000000000050.title: "石头到铁锭的转化过程。"
	quest.0000000000000060.quest_desc: [
		"为自己建造一个家园吧。"
		""
		"每一次伟大的旅程，都始于一个可以回归的地方。"
		"手工、雕刻和装饰性方块重制版为你提供数百种建筑选项。"
	]
	quest.0000000000000060.title: "扎根生长"
	quest.0000000000000070.quest_desc: [
		"你活了下来。你安顿了下来。现在，选择你的使命吧。"
		""
		"齿轮的世界 - 掌握自动化，翱翔天际。"
		"奥术之线 - 研习魔法，让世界臣服于你的意志。"
		"Roots and Hearth - 建造繁荣的定居点，养活服务器。"
		"山脊彼端 - 探索、狩猎、征服未知。"
		""
		"每条路都通往值得去的地方。"
	]
	quest.0000000000000070.title: "选择你的道路"
	quest.0000000000000080.quest_desc: [
		"制作一个复杂的背包 (Sophisticated Backpack)。"
		""
		"你会收集很多东西。背包能让它们井然有序。"
		"随着进度，用过滤、虚空和磁化升级来改进它。"
	]
	quest.0000000000000080.title: "你的第一个物品栏"
	quest.0000000000000110.quest_desc: [
		"每台机器都始于一个单一的转动齿轮。"
		""
		"创造是此整合包的核心。从简单的传送带到庞大的自动化工厂和飞行飞艇，唯一限制的是你的想象力。"
		""
		"制作你的第一个齿轮轮组以开始。"
	]
	quest.0000000000000110.title: "最初的转动"
	quest.0000000000000120.quest_desc: [
		"建造一个水车，并产生你的第一份旋转动力。"
		""
		"放置在流动的水旁边以获得最大速度。"
		"连接更多机器时，请注意你的压力承受能力。"
	]
	quest.0000000000000120.title: "Harnessing the River"
	quest.0000000000000130.quest_desc: [
		"建造一个 Crushing Wheel 装置，让你的矿石产量翻倍。"
		""
		"反向旋转的两个轮子会将原矿压成碎矿，每块矿石大约产出1.5倍的锭。"
		"这是你第一次接触自动化系统。"
	]
	quest.0000000000000130.title: "粉碎雄心壮志"
	quest.0000000000000140.quest_desc: [
		"使用机械搅拌机熔炼黄铜。"
		""
		"黄铜是转折点。它能解锁漏斗、隧道、顺序齿轮箱，以及所有让创造模组大放异彩的组件。"
		"你需要一个烈焰人燃烧器来加热搅拌机。"
	]
	quest.0000000000000140.title: "黄铜时代"
	quest.0000000000000150.quest_desc: [
		"铺设你的第一条蒸汽轨道，并建造一辆机车。"
		""
		"火车连接着你的工厂、农场和朋友。"
		"完善的铁路网络是任何伟大 CreateCraft 帝国的支柱。"
	]
	quest.0000000000000150.title: "钢铁之路"
	quest.0000000000000160.quest_desc: [
		"建造一个 Create: New Age 发电机，将旋转动力转化为电能。"
		""
		"New Age 融合了机械与电气，开启了全新的自动化可能性。"
	]
	quest.0000000000000160.title: "机器中的火花"
	quest.0000000000000170.quest_desc: [
		"建造并驾驶你的第一艘 Create Aeronautics 飞艇。"
		""
		"你从一个齿轮开始，现在你拥有了自己设计的飞行机器。"
		"创造之风的天空，属于那些赢得它的人。"
	]
	quest.0000000000000170.title: "天空之主"
	quest.0000000000000180.quest_desc: [
		"建造一个机械合成器阵列。"
		""
		"自动化你的合成配方。再也不用站在工作台前了。"
		"将其连接到你的物品网络，让机器来完成工作。"
	]
	quest.0000000000000180.title: "经久耐用，坚固可靠"
	quest.0000000000000210.quest_desc: [
		"你感受到了。世界之下有一股电流。一条连接万物的丝线。"
		""
		"Iron's Spells 'n Spellbooks 为 CreateCraft 带来了深邃的魔法。从简单的火球到毁灭性的奥术风暴，力量等待着那些愿意学习的人。"
		""
		"收集你的第一份奥术精华。"
	]
	quest.0000000000000210.title: "Something Stirs"
	quest.0000000000000220.quest_desc: [
		"找到一本法术卷轴，并施放你的第一个法术。"
		""
		"法术卷轴藏在地下城宝箱、村民交易和合成配方中。"
		"右键卷轴即可阅读并将其添加到你的法术库中。"
	]
	quest.0000000000000220.title: "力量的话语"
	quest.0000000000000230.quest_desc: [
		"制作一本魔法书。"
		""
		"一本魔导书将你的法术装订成一本可装备的卷轴。"
		"更高等级的法术书能容纳更多法术，并增强其威力。"
		"把它放在你的非主手物品栏里。"
	]
	quest.0000000000000230.title: "与书页绑定"
	quest.0000000000000240.quest_desc: [
		"在 Curios 栏位中装备一件 Relic。"
		""
		"Relics 是拥有强大被动加成的远古遗物。去搜寻它们，并明智地装备它们。"
		"按[G]打开Curios物品栏。你有4个戒指位、3个护身符位和2个项链位。"
	]
	quest.0000000000000240.title: "旧世界的遗迹 (Relics of the Old World)"
	quest.0000000000000250.quest_desc: [
		"将法术施放等级提升至10级。"
		""
		"每次施放法术都会获得经验。升级以解锁更高级的法术并扩展你的法力池。"
		"专精于一种魔法学派，以解锁其最强大的法术。"
	]
	quest.0000000000000250.title: "魔法能量正在加深"
	quest.0000000000000260.quest_desc: [
		"获得一本精英级法术书，并为其填充12个法术。"
		""
		"你不再是学生了。神秘的力量向你臣服。"
		"将魔法与遗物及奇物相结合，打造一套势不可挡的装备。"
	]
	quest.0000000000000260.title: "紧密交织的线团 Threads Woven Tight"
	quest.0000000000000270.quest_desc: [
		"发现并进入口袋维度。"
		""
		"Iron's Spells 添加了可通过神秘手段进入的个人口袋维度。"
		"一个避难所。一个图书馆。一个圣所。"
	]
	quest.0000000000000270.title: "口袋探险记"
	quest.0000000000000280.quest_desc: [
		"获得一个不死魅力，并将其装备在奇物栏中。"
		""
		"能救你一命的图腾——作为配饰佩戴，以便腾出主手。"
		"没有哪个值得称道的法师会空手赴死。"
	]
	quest.0000000000000280.title: "不死生物的护身符"
	quest.0000000000000310.quest_desc: [
		"没有美食，家就不算家。"
		""
		"Farmer's Delight、Let's Do 套件和 Expanded Delight 将食物变成了 CreateCraft 中一门完整的艺术形式。"
		""
		"制作一个煎锅。开始烹饪吧。"
	]
	quest.0000000000000310.title: "点燃火焰"
	quest.0000000000000320.quest_desc: [
		"种植并收获 Farmer's Delight 的作物。"
		""
		"番茄、洋葱、水稻、卷心菜等作物遍布世界各地。"
		"多样化的农场意味着多样化的菜单。开始种植吧。"
	]
	quest.0000000000000320.title: "播种种子"
	quest.0000000000000330.quest_desc: [
		"制作一个烹饪锅，准备你的第一顿像样的饭菜。"
		""
		"烹饪锅能解锁远超营火的复杂食谱。"
		"烹饪后的食物能赋予强大的增益效果——饱食度、再生能力等。"
	]
	quest.0000000000000330.title: "烹饪锅 (The Cooking Pot)"
	quest.0000000000000340.quest_desc: [
		"烹饪并吃掉 5 种不同的 Farmer's Delight 菜肴。"
		""
		"在野外度过漫长的一天后，来上一顿热腾腾的饭菜，确实令人惬意。"
		"增益效果也不赖，能带来好处。"
	]
	quest.0000000000000340.title: "治愈系美食"
	quest.0000000000000350.quest_desc: [
		"种植葡萄，用 Let's Do Vinery 酿造你的第一瓶葡萄酒。"
		""
		"种植葡萄，用桶发酵，然后将结果装瓶。"
		"优质的年份酒，是真正拓荒者的标志。"
	]
	quest.0000000000000350.title: "葡萄园"
	quest.0000000000000360.quest_desc: [
		"用手工或 Let's Do 家具来装饰你的家。"
		""
		"椅子、桌子、架子、沙发、壁炉。"
		"没有家具的定居点，不过是四面墙壁罢了。"
		"Let's Do Hearth + Timber 添加了木结构和壁炉，让你真正感受到家的温暖。"
	]
	quest.0000000000000360.title: "四面墙壁与一个壁炉"
	quest.0000000000000370.quest_desc: [
		"为你的同伴们举办一场盛宴。"
		""
		"农夫的盛宴物品会将食物放在桌子上，供附近所有玩家共享。"
		"这就是家园小径的意义——不仅为自己，也为社区提供食物。"
	]
	quest.0000000000000370.title: "盛大的宴会"
	quest.0000000000000380.quest_desc: [
		"制作一把 Butchery Bone Cleaver，处理你的第一只大型动物。"
		""
		"Butchery 扩展了肉类和加工系统——更多切割、更多选项、更多配方。"
		"一个合格的厨房需要一个合格的屠夫。"
	]
	quest.0000000000000380.title: "屠夫的技艺"
	quest.0000000000000390.quest_desc: [
		"使用 Expanded Delight 制作一个榨汁机。"
		""
		"榨汁机可将水果和蔬菜加工成新鲜的果汁和饮品。"
		"一杯鲜榨果汁与烹饪锅里的任何菜肴都很相配。"
	]
	quest.0000000000000390.title: "榨汁机 (The Juicer)"
	quest.0000000000000410.quest_desc: [
		"下一个山脊后面总有新东西在等着你。"
		""
		"这个世界并非静止不动。苦力怕有生物群系变种，末影人狡黠，蜘蛛无情，掠夺者袭击则毫不留情。"
		""
		"整装待发。世界在等着你。"
	]
	quest.0000000000000410.title: "世界在召唤你"
	quest.0000000000000420.quest_desc: [
		"杀死25个敌对生物。"
		""
		"Creeper Overhaul、Enderman Overhaul 和 Nyf's Spiders 为每种生物提供了与其生成地生物群系相关的独特变种。"
		"研究它们。它们的行为会因发现地点的不同而有所差异。"
	]
	quest.0000000000000420.title: "黑暗中的事物"
	quest.0000000000000430.quest_desc: [
		"探索地牢、矿井或更好的考古学发掘点。"
		""
		"Better Archeology 添加了新的挖掘点，内含独特的远古奖励。"
		"Lootr 让所有战利品箱为玩家独立生成——每个人都有专属的战利品。"
	]
	quest.0000000000000430.title: "地下深处隐藏着什么"
	quest.0000000000000440.quest_desc: [
		"在掠夺者入侵中存活下来。"
		""
		"Illager Invasion 通过新增的掠夺者类型和残酷的浪潮递增机制，让袭击变得困难得多。"
		"守卫村民会与你并肩作战，但最终决战要靠你自己。"
	]
	quest.0000000000000440.title: "坚守阵地"
	quest.0000000000000450.quest_desc: [
		"建造并驾驶一艘小型船只。"
		""
		"海洋拥有陆地所没有的东西。海岸线、岛屿、水下遗迹。"
		"建造齿轮或加农炮船，看看大海隐藏了什么秘密。"
	]
	quest.0000000000000450.title: "开阔水域"
	quest.0000000000000460.quest_desc: [
		"击败末影龙。"
		""
		"末影人重制版让末地因新行为和末影龙附近的变种而充满生机。"
		"这并非你旅程的终点。它是一扇门。"
	]
	quest.0000000000000460.title: "世界的终结"
	quest.0000000000000470.quest_desc: [
		"乘坐沉浸式航空器或创造航空学飞行器，从空中探索世界。"
		""
		"你从一个铁剑和一个指南针开始。"
		"现在你可以飞行了。"
		"在 CreateCraft 中，没有你无法抵达的地平线。"
	]
	quest.0000000000000470.title: "再远的地平线也不遥远"
	quest.0000000000000480.quest_desc: [
		"用舒适物品合成一个睡袋。"
		""
		"与床不同，睡袋不会设置你的重生点。"
		"非常适合在危险地区进行长途探险时使用。"
		"永远不要在没有它的时候被抓到。"
	]
	quest.0000000000000480.title: "安心休息"
	quest.0000000000000510.quest_desc: [
		"每个伟大的葡萄园都始于单株葡萄藤的种植。"
		""
		"Let's Do Vinery 为 CreateCraft 添加了完整的酿酒系统——从种植葡萄到装瓶成品。"
		""
		"找到并种植你的第一棵葡萄树苗。"
	]
	quest.0000000000000510.title: "第一根藤蔓"
	quest.0000000000000520.quest_desc: [
		"制作一个榨汁机，榨出你的第一批葡萄汁。"
		""
		"榨酒器可以榨出适合发酵的葡萄汁。"
		"把它建在葡萄园附近——你会经常用到它。"
	]
	quest.0000000000000520.title: "迷恋对象（The Crush）"
	quest.0000000000000530.quest_desc: [
		"在发酵桶中发酵葡萄汁。"
		""
		"好酒需要时间。让果汁发酵，等它准备好后再回来。"
		"等待的时间越长，结果就越好。"
	]
	quest.0000000000000530.title: "桶中的耐心"
	quest.0000000000000540.quest_desc: [
		"酿造你的第一瓶葡萄酒。"
		""
		"从葡萄到玻璃。一瓶上好的葡萄酒，是耐心与技艺的结晶。"
		"分享给你的同伴，或者为自己保存起来吧。"
	]
	quest.0000000000000540.title: "第一版复古风格"
	quest.0000000000000550.quest_desc: [
		"建造一个酒架并用瓶子装满它。"
		""
		"没有合适的酒架，酒窖就不算酒窖。"
		"自豪地展示你的收藏品吧。"
	]
	quest.0000000000000550.title: "葡萄酒架"
	quest.0000000000000570.quest_desc: [
		"用酒架填满地窖，并摆上你最珍藏的美酒佳酿。"
		""
		"你从一个单独的藤蔓开始。"
		"现在你是一名酿酒师了。"
		"服务器上最好的桌子，配得上最好的葡萄酒。"
	]
	quest.0000000000000570.title: "宏伟的地下酒窖"
	quest.0000000000000580.quest_desc: [
		"使用 Vinery 的装饰性方块为你的葡萄园建造一个合适的棚架。"
		""
		"葡萄园应该看起来名副其实。"
		"格栅围栏、葡萄叶和藤架柱能打造出美丽的庄园。"
	]
	quest.0000000000000580.title: "The Trellis"
	quest.0000000000000610.quest_desc: [
		"有些地方会让你减速。草地就是其中之一。"
		""
		"Let's Do Meadow 增加了一个充满野花、独特植物和乡村建材的和平生物群系。"
		""
		"找到一个草地群系，然后占领它。"
	]
	quest.0000000000000610.title: "走进草地"
	quest.0000000000000620.quest_desc: [
		"在草地上收集各种野花。"
		""
		"草地花可用于烹饪、装饰和制作。"
		"慢慢来。草地会奖励那些仔细观察的人。"
	]
	quest.0000000000000620.title: "野花丰收"
	quest.0000000000000630.quest_desc: [
		"使用草地材料制作松木台阶。"
		""
		"松木是Meadow的标志性建筑材料之一——温暖、质朴，充满田园气息。"
		"它与 Let's Do Hearth + Timber 搭配得天衣无缝。"
	]
	quest.0000000000000630.title: "草地工艺"
	quest.0000000000000640.quest_desc: [
		"使用 Thatch 和 Meadow 木材建造一座小型草地小屋。"
		""
		"并非每个基地都需要是工厂。有时，草原上的一座安静小屋正是理想之选。"
	]
	quest.0000000000000640.title: "荒野中的一栋小屋"
	quest.0000000000000650.quest_desc: [
		"烹饪一个草原专属的配方。"
		""
		"草地上的花朵和植物会解锁在其他地方找不到的独特配方。"
		"将它们与 Farmer's Delight 的食材结合，以获得最佳效果。"
	]
	quest.0000000000000650.title: "草地厨房"
	quest.0000000000000660.quest_desc: [
		"制作一个奶酪压榨机，压榨你的第一块奶酪轮。"
		""
		"将它们放入框架、放置或使用在配方中。"
	]
	quest.0000000000000660.title: "被压扁的花朵"
	quest.0000000000000670.quest_desc: [
		"在基地周围建造一个草地花园。"
		""
		"用野花、草径和压花画框填满它。"
		"草地不仅仅是一个生物群系。它是一种建造方式。"
	]
	quest.0000000000000670.title: "狂野生物生长的地方"
	quest.0000000000000680.quest_desc: [
		"收集生活在草地里的蜜蜂产出的蜂蜜。"
		""
		"Realistic Bees 模组让蜜蜂的行为更贴近现实——它们会传粉、会群聚，并以新的方式产蜜。"
		"草地是它们的家园。请尊重这片土地。"
	]
	quest.0000000000000680.title: "蜂蜜与草药"
	quest.0000000000000710.quest_desc: [
		"一个繁荣的定居点需要的不止是四面墙。"
		""
		"Let's Do Farm + Charm 为 CreateCraft 添加了市场摊位、农场装饰和村庄魅力。"
		"建造一个像样的市场，让你的社区团结起来。"
		""
		"制作你的第一个市场摊位。"
	]
	quest.0000000000000710.title: "村庄集市"
	quest.0000000000000720.quest_desc: [
		"在你的市场摊位上方放置一个告示牌。"
		""
		"每家好店都需要一块招牌。让顾客知道你卖的是什么。"
		"农场 + 魅力告示牌有多种样式可供选择。"
	]
	quest.0000000000000720.title: "开业大吉"
	quest.0000000000000730.quest_desc: [
		"使用 Farm + Charm 的柳条栅栏建造一个农场围栏。"
		""
		"柳条栅栏能让你的农场看起来更质朴、更有生活气息。"
		"搭配草地草皮和炉火+木材横梁，打造完整的美学风格。"
	]
	quest.0000000000000730.title: "围栏与家具均已配备完毕"
	quest.0000000000000740.quest_desc: [
		"使用 Let's Do Bakery 兼容模组制作一个面包箱。"
		""
		"农场 + 魅力与烘焙坊兼容，添加了面包展示架、篮子和柜台。"
		"没有面包店摊位，村庄集市就不算完整。"
	]
	quest.0000000000000740.title: "面包店柜台"
	quest.0000000000000750.quest_desc: [
		"使用 Let's Do Brewery 兼容模组搭建一个酿造桶。"
		""
		"酿造艾尔、蜜酒和药水，在市场上出售。"
		"酿酒摊位吸引了许多人前来围观。"
	]
	quest.0000000000000750.title: "酿酒摊位"
	quest.0000000000000760.quest_desc: [
		"放置一个来自 Let's Do Candlelight 兼容包的晚餐铃。"
		""
		"在市场或家中享用烛光晚餐，能营造出无与伦比的氛围。"
		"Candlelight 兼容模组为 Let's Do 系列带来了优雅的照明。"
	]
	quest.0000000000000760.title: "烛光晚餐"
	quest.0000000000000770.quest_desc: [
		"建造一个至少有4个摊位的完整市场广场。"
		""
		"面包店。酿酒坊。葡萄园摊位。农场商品柜台。"
		"这就是 CreateCraft 定居点最理想的样子。"
		"一个人们想要去参观的地方。"
	]
	quest.0000000000000770.title: "城镇广场"
	quest.0000000000000780.quest_desc: [
		"制作一个稻草雕像，并将其放置在你的农场中。"
		""
		"每个正规的农场都有一个稻草人看守庄稼。"
		"稻草雕像可以任你摆出各种姿势。"
	]
	quest.0000000000000780.title: "稻草人守卫"
	quest.0000000000000810.quest_desc: [
		"一座伟大建筑的骨架，就是它的栋梁。"
		""
		"Let's Do Hearth + Timber 为 CreateCraft 添加了外露的木框架、石墙和熊熊燃烧的壁炉。"
		"建造一个看起来像已经屹立百年不倒的建筑。"
		""
		"制作你的第一根橡木梁。"
	]
	quest.0000000000000810.title: "框架与横梁"
	quest.0000000000000820.quest_desc: [
		"制作十字梁，并用它们来建造你的建筑。"
		""
		"横梁为墙壁和天花板增添了结构细节。"
		"将它们与草地草皮结合，打造经典的都铎风格。"
	]
	quest.0000000000000820.title: "交叉的木梁"
	quest.0000000000000830.quest_desc: [
		"合成炉灶 + 木材覆盖的乱石堆方块。"
		""
		"粗糙的石墙搭配木框架，构成了标准的 CreateCraft 家园风貌。"
		"混合不同类型的石头，让外观更自然、更古朴。"
	]
	quest.0000000000000830.title: "石和砂浆"
	quest.0000000000000850.quest_desc: [
		"使用Hearth + Timber Shingles方块建造一个像样的屋顶。"
		""
		"斜屋顶会改变人们对一座建筑的感知方式。"
		"与草地茅草尖结合，打造经典小屋轮廓。"
	]
	quest.0000000000000850.title: "头顶上的那片瓦片"
	quest.0000000000000860.quest_desc: [
		"用灯笼铺一条通往你家的路。"
		""
		"一条穿过树林的明亮小径。灯笼悬挂在木梁上。"
		"细节，才是一座房子与一个家之间的区别。"
	]
	quest.0000000000000860.title: "灯笼之路"
	quest.0000000000000870.quest_desc: [
		"使用 Hearth + Timber、Meadow 和 Handcrafted 建造一座完整的木框架庄园。"
		""
		"裸露的横梁。石墙。燃烧的壁炉。手工制作的家具。"
		"这就是一个建造完成的 CreateCraft 家园的样子。"
	]
	quest.0000000000000870.title: "庄园"
	quest.0000000000000880.quest_desc: [
		"在您的家中各处放置蜡烛。"
		""
		"窗台上的蜡烛。桌子上的蜡烛。横梁上的蜡烛。"
		"小细节也能带来大不同。"
	]
	quest.0000000000000880.title: "窗台上的蜡烛"
	quest.0000000000000910.quest_desc: [
		"黎明前，面包师就已经开始工作了。"
		""
		"Let's Do Bakery 为 CreateCraft 添加了面包展示架、面团、糕点和完整的烘焙流程。"
		""
		"从一个面包篮开始。"
	]
	quest.0000000000000910.title: "面包师苏醒"
	quest.0000000000000920.quest_desc: [
		"制作生面团。"
		""
		"所有烘焙食品的基础。将面粉和水混合，然后揉成形状。"
		"面团是面包店制作一切事物的起点。"
	]
	quest.0000000000000920.title: "揉面成团"
	quest.0000000000000930.quest_desc: [
		"烘焙你的第一炉烘焙坊面包。"
		""
		"不是普通的面包——而是来自烘焙工坊兼容包的正宗手工面包。"
		"光是这股香味就值得你付出努力。"
	]
	quest.0000000000000930.title: "黄金外壳"
	quest.0000000000000940.quest_desc: [
		"使用烘焙兼容模组制作蛋糕或糕点。"
		""
		"没有甜点的烘焙店，不过是一家面包店罢了。"
		"糕点、蛋糕和挞类构成了完整的菜单。"
	]
	quest.0000000000000940.title: "Something Sweet"
	quest.0000000000000950.quest_desc: [
		"放置一个展示柜，并用烘焙食品填满它。"
		""
		"一家正经的面包店会展示自家的商品。"
		"展示柜能让你向整个服务器展示你的面包和糕点。"
	]
	quest.0000000000000950.title: "展示柜 The Display Case"
	quest.0000000000000960.quest_desc: [
		"制作一个面包板，用它来展示你的面包。"
		""
		"质朴、实用，又富有美感。"
		"每个面包店柜台都需要一个合适的砧板。"
	]
	quest.0000000000000960.title: "面包板 The Bread Board"
	quest.0000000000000970.quest_desc: [
		"在集市广场设置一个完整的烘焙摊位。"
		""
		"装满面包的展示柜。台面上的面包板。一篮篮新鲜出炉的面包。"
		"面包店开业了。服务器饱腹了。"
	]
	quest.0000000000000970.title: "开设面包店"
	quest.0000000000000980.quest_desc: [
		"烤制并储备足够的面包来喂养整个服务器。"
		""
		"面包师的工作永无止境。但一篮满满的面包就是最好的回报。"
	]
	quest.0000000000000980.title: "清晨的忙碌时光"
	quest.0000000000001010.quest_desc: [
		"酿造出值得一饮的饮品需要耐心。"
		""
		"Let's Do Brewery 通过专门的酿造系统为 CreateCraft 添加了艾尔、蜜酒和汤剂。"
		""
		"制作你的第一个酿造桶，然后开始吧。"
	]
	quest.0000000000001010.title: "酿酒的艺术"
	quest.0000000000001020.quest_desc: [
		"酿造你的第一杯艾尔啤酒。"
		""
		"将你的材料加入酿造桶，让时间来发挥作用。"
		"不同的材料会产生不同效果的药水。"
	]
	quest.0000000000001020.title: "第一杯饮品"
	quest.0000000000001030.quest_desc: [
		"酿造一些啤酒花 (Brew some Hops)"
		""
		"啤酒花是世界上最古老的饮品之一。"
	]
	quest.0000000000001030.title: "蜂蜜蜜酒"
	quest.0000000000001040.quest_desc: [
		"制作一个酿造台，并将其安装在你的酒馆中。"
		""
		"该车站能让你按需供应饮品。"
		"把它连接到桶上，然后开业吧。"
	]
	quest.0000000000001040.title: "酒馆里的酒桶"
	quest.0000000000001050.quest_desc: [
		"酿造一瓶药水。"
		""
		"Tonic 是一种具有有益效果的无酒精饮品。"
		"非常适合战斗、探索，或在长途探险中保持健康。"
	]
	quest.0000000000001050.title: "酿酒师的滋补剂"
	quest.0000000000001060.quest_desc: [
		"制作一个杯架，并用杯子装满它。"
		""
		"正规的酿酒厂就该有正规的饮品器皿。"
		"将你的收藏品展示在柜台上方。"
	]
	quest.0000000000001060.title: "马克杯收藏集"
	quest.0000000000001070.quest_desc: [
		"用小麦、啤酒花和奎宁这三种酿造材料填满你的酿酒厂。"
		""
		"一家完整的酿酒厂能满足每个人的口味。"
		"酒吧开门了。来一杯吧，我请客。"
	]
	quest.0000000000001070.title: "最后一轮"
	quest.0000000000001080.quest_desc: [
		"设置第二个酿造桶，与第一个并行运行。"
		""
		"一家正经的酿酒厂总有些东西在陈酿。"
		"一个桶用于生产。一个用于耐心。"
	]
	quest.0000000000001080.title: "地窖中的木桶"
	quest.0000000000001110.quest_desc: [
		"烛光总有一种能改变一切的特殊魔力。"
		""
		"Let's Do Candlelight 为 CreateCraft 增添了优雅的烛台、餐桌布置和氛围灯光。"
		""
		"制作你的第一个烛台并点燃它。"
	]
	quest.0000000000001110.title: "火焰已被点燃"
	quest.0000000000001120.quest_desc: [
		"使用烛光餐桌布置来设置一张晚餐桌。"
		""
		"餐盘、杯子、餐具。中央有一个烛台。"
		"一张好桌子的细节，能让一顿饭感觉像一场仪式。"
	]
	quest.0000000000001120.title: "餐桌上的晚餐"
	quest.0000000000001130.quest_desc: [
		"将壁烛台放置在家中各处。"
		""
		"壁挂烛台散发出温暖的方向性光线。"
		"用它们来装饰你的走廊和餐厅吧。"
	]
	quest.0000000000001130.title: "柔和的光线"
	quest.0000000000001140.quest_desc: [
		"使用 Candlelight、Handcrafted 和 Farmer's Delight 建造一间完整的餐厅。"
		""
		"一张长桌，配着手工椅子。墙上挂着烛台。烛光晚餐的餐桌布置。"
		"将农夫的恩赐中的美食放在桌上。这就是目标。"
	]
	quest.0000000000001140.title: "餐厅"
	quest.0000000000001150.quest_desc: [
		"在书架旁边放置一根阅读蜡烛。"
		""
		"书本旁的蜡烛。生活中的小确幸之一。"
		"搭配手工制作的扶手椅，打造完整效果。"
	]
	quest.0000000000001150.title: "阅读角 (The Reading Nook)"
	quest.0000000000001160.quest_desc: [
		"制作一盏吊灯，并将其悬挂在餐桌上方。"
		""
		"一盏吊灯主宰着一个房间。"
		"高高的天花板。温暖的光线。摆满食物的桌子。"
		"这就是一个 CreateCraft 宴会大厅的样子。"
	]
	quest.0000000000001160.title: "宴会大厅"
	quest.0000000000001170.quest_desc: [
		"为你的同伴们举办一场烛光晚宴。"
		""
		"一间完整的餐厅。头顶有吊灯。墙上有烛台。桌上有农夫的盛宴物品。还有来自葡萄园的美酒。"
		""
		"这就是 Let's Do 系列任务的最高峰。"
		"一个值得铭记的夜晚。"
	]
	quest.0000000000001170.title: "一个难忘的夜晚"
	quest.0000000000001180.quest_desc: [
		"制作32根不同颜色的蜡烛。"
		""
		"彩色蜡烛能帮你营造氛围。"
		"餐厅用温暖的琥珀色。书房用清凉的蓝色。"
	]
	quest.0000000000001180.title: "蜡烛制造者"
	quest.0000000000001210.quest_desc: [
		"历史就埋藏在外面的某个地方。你只需要知道去哪里寻找。"
		""
		"Better Archeology 为 CreateCraft 添加了新的发掘点、化石类型和古代文物。"
		""
		"找到你的第一个发掘点并开始挖掘。"
	]
	quest.0000000000001210.title: "Something Buried"
	quest.0000000000001220.quest_desc: [
		"在考古发掘点刷出你的第一块可疑方块。"
		""
		"慢慢来。画笔会揭示大地所隐藏的一切。"
		"可疑的沙子和砾石中隐藏着文物、化石和失落的遗迹。"
	]
	quest.0000000000001220.title: "第一笔画笔"
	quest.0000000000001230.quest_desc: [
		"收集 3 个不同的化石碎片。"
		""
		"Better Archeology 添加了隐藏在地下深处的生物化石。"
		"苦力怕化石、蜘蛛化石等，正等待着你去发掘。"
	]
	quest.0000000000001230.title: "化石猎人"
	quest.0000000000001240.quest_desc: [
		"在考古发掘点寻找并收集陶器碎片。"
		""
		"陶器残片诉说着被遗忘的文明的故事。"
		"将它们组合成装饰花盆来展示你的战利品。"
	]
	quest.0000000000001240.title: "远古宝藏"
	quest.0000000000001250.quest_desc: [
		"使用你的陶器碎片制作一个装饰罐。"
		""
		"将你的发现品陈列出来。每种陶片组合都讲述着不同的故事。"
		"将它们放置在你的基地周围，作为你探险的奖杯。"
	]
	quest.0000000000001250.title: "展示台 The Display"
	quest.0000000000001260.quest_desc: [
		"为你的化石和陶器收藏建造一个博物馆展台。"
		""
		"物品展示框、展示柜和装饰性花盆。"
		"真正的考古学家会记录并展示他们的发现。"
	]
	quest.0000000000001260.title: "博物馆"
	quest.0000000000001270.quest_desc: [
		"在 Better Archeology 的考古发掘点中找到一件稀有文物。"
		""
		"最稀有的发现并不一定最大。"
		"耐心和毅力会回报专注的考古学家。"
	]
	quest.0000000000001270.title: "地下深处隐藏着什么"
	quest.0000000000001280.quest_desc: [
		"寻找并探索一处遗迹废墟结构。"
		""
		"遗迹是散布在世界各地、部分被掩埋的古代定居点。"
		"这里有很多可疑方块和陶器碎片。"
	]
	quest.0000000000001280.title: "遗迹小径"
	quest.0000000000001310.quest_desc: [
		"工厂并不一定非得丑陋不可。"
		""
		"Create Deco 添加了工业风格的方块、灯光、金属梁和装饰元素，让你的 Create 建筑既美观又实用。"
		""
		"制作你的第一个 Create 装饰方块。"
	]
	quest.0000000000001310.title: "工厂美学风格"
	quest.0000000000001320.quest_desc: [
		"合成工业铁块，并用它们建造工厂墙壁。"
		""
		"工业铁能为你的创造模式建筑带来厚重、实用的外观。"
		"搭配金属梁和铆接板，营造完整的工厂氛围。"
	]
	quest.0000000000001320.title: "工业用铁"
	quest.0000000000001330.quest_desc: [
		"在你的工厂里放置 Nixie Tubes 或 Industrial Lights。"
		""
		"装饰性照明与工业美学完美契合。"
		"尼可森管显示数字和字母。工业灯照亮大型空间。"
	]
	quest.0000000000001330.title: "点亮工作室"
	quest.0000000000001340.quest_desc: [
		"使用金属梁建造一个结构框架。"
		""
		"金属梁是任何伟大工厂的骨架所在。"
		"可用于天花板、支撑柱和头顶平台。"
	]
	quest.0000000000001340.title: "金属框架"
	quest.0000000000001350.quest_desc: [
		"制作Dean砖块，用它们来建造工厂的地板和墙壁。"
		""
		"Dean Bricks 砖块具有那种磨损、陈旧的工业外观。"
		"苔藓变种能为你的建筑增添古朴韵味。"
	]
	quest.0000000000001350.title: "迪恩砖块"
	quest.0000000000001360.quest_desc: [
		"在工厂内部建造一个专用的机械装置室。"
		""
		"一个围绕你的 Create 机器设计的房间——配有 Create 装饰墙、合适的照明和金属梁天花板。"
		"形式追随功能。然后形式改善功能。"
	]
	quest.0000000000001360.title: "机械装置房间"
	quest.0000000000001370.quest_desc: [
		"使用 Create Deco 建造一个完全装饰好的 Create 工厂。"
		""
		"工业铁墙。金属梁天花板。尼可森管显示屏。迪恩砖地板。"
		"你的工厂应该像它所生产的一切一样令人印象深刻。"
	]
	quest.0000000000001370.title: "陈列室"
	quest.0000000000001380.quest_desc: [
		"制作铆接面板，用于你的工厂外墙。"
		""
		"铆接板能让你的工厂外观显得厚重而坚固。"
		"非常适合用于严肃的工业设施的墙壁。"
	]
	quest.0000000000001380.title: "铆接就绪，整装待发"
	quest.05C662C991C13CEE.quest_desc: [
		"榨取你的第一批水果和蔬菜。"
		""
		"Expanded Delight 的果汁能提供烹饪食物所没有的独特增益效果。"
		"番茄汁、浆果汁等饮品正等待着你来制作。"
	]
