# AI 初翻，未人工校对
{
	chapter.60DE000000000002.title: "绘制王国的地图"
	chapter.60DE000000000002.chapter_subtitle: [
		"建筑、新群系和遥远世界——探索 &6Valhelsia Structures&r、&6Regions Unexplored&r 等更多内容。"
	]
	quest.0D00000000000002.title: "找到一个村庄"
	quest.0D00000000000002.quest_subtitle: "贸易与庇护所"
	quest.0D00000000000002.quest_desc: [
		"追踪一个&6村庄&r——一个有村民可供交易、有床可供睡眠的安全港湾。"
		"一个不错的早期行动基地。"
		"&7保护子民免受掠夺。&r"
	]
	quest.0D00000000000003.title: "掠夺者前哨基地"
	quest.0D00000000000003.quest_subtitle: "危险与宝藏"
	quest.0D00000000000003.quest_desc: [
		"侦察一个&6掠夺者前哨基地&r——有掠夺者守卫，但战利品丰富。"
		"清理出一片地方，获取补给和一个Allay。"
		"&7注意船长。&r"
	]
	quest.0D0000000000000C.title: "制图师塔 (Cartographer Tower)"
	quest.0D0000000000000C.quest_subtitle: "购买地图"
	quest.0D0000000000000C.quest_desc: [
		"在 Moog's Voyager 中找到一个 &6制图师塔&r——一个可以领取指向其他地标地图的地方。"
		"这里的地图会指引你走向冒险。"
		"&7跟随它们的指引前进。&r"
	]
	quest.0D00000000000006.title: "女巫小屋"
	quest.0D00000000000006.quest_subtitle: "女巫的住所"
	quest.0D00000000000006.quest_desc: [
		"在沼泽里发现一个&6女巫小屋&r——很适合用来收集女巫掉落物，还能当个阴森的大本营。"
		"Valhelsia 的众多建筑之一。"
		"&7Mind the cauldron.&r"
	]
	quest.0D00000000000004.title: "城堡遗迹"
	quest.0D00000000000004.quest_subtitle: "昔日辉煌，今已陨落"
	quest.0D00000000000004.quest_desc: [
		"探索一座&6城堡遗迹&r——一座宏伟堡垒的残骸，里面满是战利品。"
		"完整城堡中的一部分风味展示。"
		"&7正戏前的开胃菜。&r"
	]
	quest.0D00000000000005.title: "城堡"
	quest.0D00000000000005.quest_subtitle: "一座宏伟的堡垒"
	quest.0D00000000000005.quest_desc: [
		"寻找一座完好的&6城堡&r——瓦尔赫西亚最宏伟的建筑，守卫森严，回报丰厚。"
		"任何探险家都会为之欣喜的宝藏。"
		"&a奖励：来自王国战利品的一件物品。&r"
	]
	quest.0D00000000000007.title: "红木森林"
	quest.0D00000000000007.quest_subtitle: "高耸入云的树木"
	quest.0D00000000000007.quest_desc: [
		"伫立在《未探索区域》的&6红杉树&r之间——这些巨树让原版世界相形见绌。"
		"优质的木材和壮丽的景色。"
		"&7One of many new biomes.&r"
	]
	quest.0D00000000000008.title: "沼泽地"
	quest.0D00000000000008.quest_subtitle: "浑浊的湿地"
	quest.0D00000000000008.quest_desc: [
		"踏入&6沼泽地&r——一个拥有独特动植物群落的阴郁湿地生物群系。"
		"充满神秘气息，秘密重重。"
		"&7在水中小心脚下。&r"
	]
	quest.0D0000000000000D.title: "热带雨林"
	quest.0D0000000000000D.quest_subtitle: "生机勃勃，喧闹非凡"
	quest.0D0000000000000D.quest_desc: [
		"穿越一片茂密的&6热带雨林&r——充满活力、层次丰富、生机勃勃。"
		"Regions Unexplored 重塑了整个世界的地图。"
		"&7Go find the rest yourself.&r"
	]
	quest.0D0000000000000E.title: "宏伟的大教堂"
	quest.0D0000000000000E.quest_subtitle: "Moog's Voyager Structures"
	quest.0D0000000000000E.quest_desc: [
		"来自 Moog's Voyager Structures 的宏伟&6大教堂&r——野外最壮丽的建筑，彩绘玻璃和拱顶大厅值得一游。"
		"&a奖励：一块领地和一件来自王国战利品的工具。&r"
	]
	quest.0D0000000000000F.title: "大理石城堡"
	quest.0D0000000000000F.quest_subtitle: "ATi Structures"
	quest.0D0000000000000F.quest_desc: [
		"A sprawling noble estate of white marble from &6ATi Structures&r, tucked into the hills. Plenty of rooms to loot."
	]
	quest.0D00000000000010.title: "黑暗塔"
	quest.0D00000000000010.quest_subtitle: "ATi Structures"
	quest.0D00000000000010.quest_desc: [
		"一座直入云霄的阴沉&6黑暗塔楼&r——自上而下戒备森严，山顶等待着最丰厚的战利品。"
	]
	quest.0D00000000000011.title: "猴面包树稀树草原"
	quest.0D00000000000011.quest_subtitle: "尚未探索的区域 (Regions Unexplored)"
	quest.0D00000000000011.quest_desc: [
		"广袤的金色草原，矗立着巨大的&6猴面包树&r——来自Regions Unexplored的标志性生物群系。"
	]
	quest.0D00000000000012.title: "秋日枫树林"
	quest.0D00000000000012.quest_subtitle: "尚未探索的区域 (Regions Unexplored)"
	quest.0D00000000000012.quest_desc: [
		"一片被永远困在秋季的森林，在&6枫树&r的树冠下，一片赤橙。"
	]
	quest.0D00000000000013.title: "桉树林"
	quest.0D00000000000013.quest_subtitle: "尚未探索的区域 (Regions Unexplored)"
	quest.0D00000000000013.quest_desc: [
		"高大的苍白&6桉树&r矗立在柔软的蓝绿色灌木丛中——一片宁静、通透的林地。"
	]
	chapter.60DE000000000001.title: "武器库"
	chapter.60DE000000000001.chapter_subtitle: [
		"刀剑、盔甲和模块化装备 — &6Simply Swords&r、&6Immersive Armors&r 和 &6Silent Gear&r。"
	]
	quest.0A00000000000002.title: "一把称职的利刃"
	quest.0A00000000000002.quest_subtitle: "简易刀剑模组"
	quest.0A00000000000002.quest_desc: [
		"用 &6Simply Swords&r 锻造一把铁质长剑——该模组在原版剑的基础上增加了数十种新武器类型。"
		"每种武器类型都有不同的操作方式——攻击距离、速度、横扫。"
		"&7找到适合你的风格。&r"
	]
	quest.0A00000000000008.title: "西洋剑与日本刀"
	quest.0A00000000000008.quest_subtitle: "不同的钢材种类"
	quest.0A00000000000008.quest_desc: [
		"制作一把西洋剑（快速、精准）和一把太刀（横扫）——两种截然不同的战斗风格。"
		"用它们对付几个生物，感受其中的差异。"
		"&7更高等级造成的伤害更高。&r"
	]
	quest.0A00000000000007.title: "下界合金双手剑"
	quest.0A00000000000007.quest_subtitle: "一把强大的武器"
	quest.0A00000000000007.quest_desc: [
		"锻造一把下界合金双手剑——一款能劈开人群的重型武器。"
		"&a奖励：一块领地和一件来自王国战利品的工具。&r"
		"&7你收藏的刀剑中最引以为傲的那一把。&r"
	]
	quest.0A00000000000003.title: "重型盔甲"
	quest.0A00000000000003.quest_subtitle: "沉浸式盔甲模组 (Immersive Armors)"
	quest.0A00000000000003.quest_desc: [
		"用&6Immersive Armors&r制作重型胸甲——该模组添加了多个具有独特外观和特性的主题盔甲套装。"
		"更重的盔甲以速度换取防护。"
		"&7Browse the sets in JEI.&r"
	]
	quest.0A00000000000004.title: "主题套装"
	quest.0A00000000000004.quest_subtitle: "骨骼与更远的地方"
	quest.0A00000000000004.quest_desc: [
		"骨盔是众多主题部件之一——混搭不同套装，打造你想要的造型和增益效果。"
		"某些套装在同时穿戴时会提供套装效果。"
		"&7为场合选择合适的着装。&r"
	]
	quest.0A00000000000009.title: "神圣盔甲"
	quest.0A00000000000009.quest_subtitle: "顶级防护，尽在掌握"
	quest.0A00000000000009.quest_desc: [
		"神圣胸甲是这里最强的盔甲之一——一套合格的毕业套装。"
		"搭配同系列装备，效果更佳。"
		"&7经久耐用，历久弥新。&r"
	]
	quest.0A00000000000010.title: "蓝图"
	quest.0A00000000000010.quest_subtitle: "Silent Gear 从这里开始"
	quest.0A00000000000010.quest_desc: [
		"合成&6蓝图之书&r — &6无声齿轮&r用零件制造工具和武器，蓝图可解锁每种类型。"
		"将蓝图添加到书中以学习新装备。"
		"&e一整套模块化齿轮系统——这就是入口。&r"
	]
	quest.0A00000000000011.title: "齿轮锻造台"
	quest.0A00000000000011.quest_subtitle: "整理好你的装备"
	quest.0A00000000000011.quest_desc: [
		"&6齿轮锻造台&r用于将主部件、杆和可选的尖端组装成齿轮。"
		"不同材料带来不同属性——混合搭配，打造完美工具。"
		"&7尝试组合不同的部件。&r"
	]
	quest.0A00000000000012.title: "制作你的工具"
	quest.0A00000000000012.quest_subtitle: "镐和剑"
	quest.0A00000000000012.quest_desc: [
		"制作 Silent Gear Pickaxe 和 Sword — 它们会获得经验、升级，并且可以升级和修理而不会丢失进度。"
		"添加提示、涂层和握把以进行自定义。"
		"&e能与你一同成长的装备。&r"
	]
	quest.0A00000000000013.title: "金属压制机"
	quest.0A00000000000013.quest_subtitle: "制作零件"
	quest.0A00000000000013.quest_desc: [
		"&6金属压机&r可将锭压制为棒、板及其他齿轮部件。"
		"你需要它来制作自定义的部件组合。"
		"&7把它放在锻造台旁边。&r"
	]
	quest.0A00000000000014.title: "合金与绯红铁"
	quest.0A00000000000014.quest_subtitle: "高级材料"
	quest.0A00000000000014.quest_desc: [
		"&6合金锻造台&r可将金属熔炼成更坚固的合金；&6绯红铁&r是一种用于高级装备的下界金属。"
		"合金能解锁最佳属性组合。"
		"&7通往终局装备的道路。&r"
	]
	quest.0A00000000000005.title: "宝石工艺"
	quest.0A00000000000005.quest_subtitle: "Silent Gems"
	quest.0A00000000000005.quest_desc: [
		"&6Silent Gems&r 添加了红宝石、蓝宝石、托帕石等——可用于装饰方块、灯具和玻璃的彩色宝石。"
		"它们与 Silent Gear 搭配起来也很适合用于主题建筑。"
		"&7在地下深处开采它们。&r"
	]
	chapter.378B07B3885291AA.title: "下方的深邃之地"
	chapter.378B07B3885291AA.chapter_subtitle: [
		"开启通往&2Undergarden&r无日洞穴的传送门——全新的石头、金属、怪物和首领。"
	]
	quest.4B00000000000001.title: "催化剂 (The Catalyst)"
	quest.4B00000000000001.quest_subtitle: "通往深处的钥匙"
	quest.4B00000000000001.quest_desc: [
		"合成&2催化剂&r——开启通往Undergarden传送门的物品。"
		"你将建造传送门框架，并用这个来激活它。"
		"&7通往下方的入口。&r"
	]
	quest.4B00000000000002.title: "进入地下花园 (Undergarden)"
	quest.4B00000000000002.quest_subtitle: "一个没有太阳的世界"
	quest.4B00000000000002.quest_desc: [
		"用&2Depthrock Bricks&r（或其他任何石砖方块）建造一个传送门框架，然后用催化剂右键内部底座，即可开启通往&2Undergarden&r的道路。"
		"这是一个广阔而黑暗的洞穴维度——没有天空，也没有太阳。"
		"&e带上光源和食物。&r"
	]
	quest.4B00000000000003.title: "Mine Depthrock"
	quest.4B00000000000003.quest_subtitle: "当地的石头"
	quest.4B00000000000003.quest_desc: [
		"&2Depthrock&r 是 Undergarden 的基础石材——收集一叠用于制作工具和建造。"
		"到处都是，就像主世界的鹅卵石一样。"
		"&7你的第一份资源。&r"
	]
	quest.4B00000000000004.title: "碎片火把"
	quest.4B00000000000004.quest_subtitle: "点亮黑暗"
	quest.4B00000000000004.quest_desc: [
		"用&2Utheric Shards&r（从Utherium矿石中挖掘）合成&2Shard Torches&r——它们能驱赶在黑暗中生成的&2Rotspawn&r。"
		"把它们放在基地和路径周围，用来阻挡怪物潮。"
		"&7携带一叠物品。&r"
	]
	quest.4B00000000000006.title: "Cloggrum"
	quest.4B00000000000006.quest_subtitle: "第一种金属"
	quest.4B00000000000006.quest_desc: [
		"熔炼 &2Cloggrum&r — 地下花园的铁质金属，用于制作工具和盔甲。"
		"在洞穴各处作为矿石被发现。"
		"&7你的初始工具包在这里面。&r"
	]
	quest.4B00000000000007.title: "Froststeel"
	quest.4B00000000000007.quest_subtitle: "冰冷的金属"
	quest.4B00000000000007.quest_desc: [
		"&2Froststeel&r 是一种更冷、更坚固的金属，能打造出更好的装备。"
		"比cloggrum更高级一点的物品。"
		"&7挖得更深才能找到它。&r"
	]
	quest.4B00000000000008.title: "Utherium"
	quest.4B00000000000008.quest_subtitle: "治疗水晶"
	quest.4B00000000000008.quest_desc: [
		"&2Utherium&r 晶体蕴含着恢复之力——备受青睐，可用于制作顶级装备和饰品。"
		"稀有且值得一探究竟的宝藏。"
		"&7地下花园的宝藏。&r"
	]
	quest.4B0000000000000C.title: "Cloggrum齿轮"
	quest.4B0000000000000C.quest_subtitle: "剑和盾牌"
	quest.4B0000000000000C.quest_desc: [
		"锻造一把 Cloggrum 剑和一面 Cloggrum 盾——足以应对地下危险的坚固装备。"
		"Cloggrum 比铁更胜一筹，盾牌也比原版更坚固。"
		"&7探索前做好准备。&r"
	]
	quest.4B0000000000000B.title: "弹弓 (The Slingshot)"
	quest.4B0000000000000B.quest_subtitle: "远程凝胶生物"
	quest.4B0000000000000B.quest_desc: [
		"&2弹弓&r可以发射&2黏球&r和&2格鲁格&r——方便远程戳击Undergarden的怪物。"
		"便宜又好玩。"
		"&7远离残暴者。&r"
	]
	quest.4B00000000000005.title: "Undergarden 作物"
	quest.4B00000000000005.quest_subtitle: "奇怪的食物"
	quest.4B00000000000005.quest_desc: [
		"收集&2Gloomgourds&r、&2Underbeans&r和&2Blisterberries&r——能让你在地下继续前行的食物。"
		"泡泡浆果能治愈，但会灼伤——请谨慎使用。"
		"&7为长途探险而驯养它们。&r"
	]
	quest.4B0000000000000D.title: "枯竭的矿井"
	quest.4B0000000000000D.quest_subtitle: "旧时的运作方式"
	quest.4B0000000000000D.quest_desc: [
		"探索一个&2枯竭的矿井&r——废弃的隧道，内有矿石和战利品。"
		"一个适合早期掠夺的好地方标记。"
		"&7小心伏击。&r"
	]
	quest.4B0000000000000E.title: "Denizen 营地"
	quest.4B0000000000000E.quest_subtitle: "本地居民的巢穴"
	quest.4B0000000000000E.quest_desc: [
		"找到一个&2Denizen Camp&r，这里是Undergarden居民的家园。"
		"把它搜刮了——小心点。"
		"&7它们可不欢迎外来者。&r"
	]
	quest.4B00000000000009.title: "地下墓穴"
	quest.4B00000000000009.quest_subtitle: "首领巢穴"
	quest.4B00000000000009.quest_desc: [
		"找到&2地下墓穴&r——藏有Undergarden守护者及其顶级战利品的地下城。"
		"这就是首领等待的地方。"
		"&e准备好迎接战斗吧。&r"
	]
	quest.4B0000000000000F.title: "Undergarden 生物"
	quest.4B0000000000000F.quest_subtitle: "残暴者和腐化兽"
	quest.4B0000000000000F.quest_desc: [
		"击杀 &2Brutes&r 和 &2Rotbeast&r——这些在洞穴中游荡的强力敌怪。"
		"残暴者像卡车一样猛撞；保持移动。"
		"&7证明你能在地下生存下来的证据。&r"
	]
	quest.4B0000000000000A.title: "被遗忘的守护者 (The Forgotten Guardian)"
	quest.4B0000000000000A.quest_subtitle: "击败首领"
	quest.4B0000000000000A.quest_desc: [
		"在地下墓穴中直面&2被遗忘的守护者&r——Undergarden的强力首领。"
		"&a奖励：一块领地和一件来自王国战利品的工具。&r"
		"&7击败它，征服深海。&r"
	]
	chapter.131E14E9D091F1A7.title: "禁忌之术 (The Forbidden Arts)"
	chapter.131E14E9D091F1A7.chapter_subtitle: [
		"奥术水晶、祝福金、暗物质和龙鳞——来自&6禁忌奥术&r的炼金术。"
	]
	quest.4A00000000000001.title: "神秘水晶 (Arcane Crystals)"
	quest.4A00000000000001.quest_subtitle: "开采魔法矿石，挖掘神秘力量"
	quest.4A00000000000001.quest_desc: [
		"Mine &6Arcane Crystals&r — 驱动《禁断的阿卡努斯》中几乎所有事物的发光宝石。"
		"在地下深处发现。"
		"&7先抓一大把来开始吧。&r"
	]
	quest.4A00000000000002.title: "神秘水晶粉尘"
	quest.4A00000000000002.quest_subtitle: "把它们磨成粉吧"
	quest.4A00000000000002.quest_desc: [
		"将神秘水晶磨成粉——大多数配方中使用的精炼形式。"
		"一种你总想备好的基础试剂。"
		"&7一路向前，不断努力。&r"
	]
	quest.4A00000000000003.title: "Mundabitur 尘埃"
	quest.4A00000000000003.quest_subtitle: "净化用的尘埃粉末"
	quest.4A00000000000003.quest_desc: [
		"合成 &6Mundabitur 粉尘&r — 撒布后可净化和准备用于仪式与转化的方块。"
		"需要激活赫菲斯托斯锻造炉。"
		"&7仪式的关键试剂。&r"
	]
	quest.4A00000000000008.title: "赫菲斯托斯锻造炉"
	quest.4A00000000000008.quest_subtitle: "建造，而非合成"
	quest.4A00000000000008.quest_desc: [
		"&6赫菲斯托斯熔炉&r是禁地秘典中心的仪式祭坛。它没有配方——只需摆出结构并激活它。"
		""
		"&e材料：&r45 块抛光暗石、9 块镀金雕纹抛光暗石、4 块雕纹秘法抛光暗石、一张锻造台和一份 Mundabitur 粉尘。"
		""
		"&e形状：&r先放置一个镀金凿刻方块作为中心。用凿刻神秘方块接触它的四个侧面。用抛光暗石填充周围的环形区域。然后将剩下的八个镀金凿刻方块均匀地分布在最外层——这八个位置稍后会成为你的基座。"
		""
		"将锻造台放在中心方块上，保持上方空间为空，然后潜行并右键点击锻造台，使用&6Mundabitur Dust&r。闪电会劈下，锻造台就会变成熔炉。"
		""
		"&7开采完成的锻造炉会掉落物品，所以一旦你拿到手，这个任务就算完成。把它放回原处即可。&r"
	]
	quest.4A00000000000005.title: "Deorum"
	quest.4A00000000000005.quest_subtitle: "受祝福的黄金"
	quest.4A00000000000005.quest_desc: [
		"合成 &6Deorum&r，一种比普通黄金坚硬得多的祝福黄金金属。"
		"在合成台将金锭与神秘水晶粉、mundabitur 粉和木炭组合。"
		"&7高级工具和方块的基础。&r"
	]
	quest.4A00000000000009.title: "克利巴诺（Clibano）"
	quest.4A00000000000009.quest_subtitle: "快速熔炼"
	quest.4A00000000000009.quest_desc: [
		"建造一个 Clibano 熔炉并制作其核心——它的熔炼速度比普通熔炉快得多，温度也高得多。"
		"矿石处理方面的重大升级。"
		"&7保持燃料充足。&r"
	]
	quest.4A0000000000000D.title: "量子捕手"
	quest.4A0000000000000D.quest_subtitle: "将生物装进瓶子里面去"
	quest.4A0000000000000D.quest_desc: [
		"量子捕手能将活物捕捉进一个可携带和释放的瓶子里。"
		"方便移动生物或建造农场时使用。"
		"&7右键点击生物即可捕捉它。&r"
	]
	quest.4A00000000000004.title: "暗物质"
	quest.4A00000000000004.quest_subtitle: "被禁止的材料"
	quest.4A00000000000004.quest_desc: [
		"在熔炉中冶炼 &6Edelwood Log&r 以制作 &6Dark Matter&r。"
		"一种致密而强大的合成组件。"
		"&7用于最黑暗的配方中。&r"
	]
	quest.4A00000000000006.title: "白蜡木（Edelwood）"
	quest.4A00000000000006.quest_subtitle: "黑暗之树"
	quest.4A00000000000006.quest_desc: [
		"种植&6Edelwood&r树——它们的深色原木可被雕刻成罐子、管道和工具。"
		"一种可再生的、能储存奥瑞能量的木材来源。"
		"&7种植一片小树林。&r"
	]
	quest.4A0000000000000C.title: "Utrem Jar"
	quest.4A0000000000000C.quest_subtitle: "将魔法流体装瓶收集起来"
	quest.4A0000000000000C.quest_desc: [
		"Utrem Jar（玻璃和埃德尔木木板）可储存 xpetrified 和其他魔法液体。"
		"让你的仪式流体随时可用。"
		"&7为你的锻造区制作几个吧。&r"
	]
	quest.4A0000000000000A.title: "黑曜石骷髅头"
	quest.4A0000000000000A.quest_subtitle: "一个奥瑞尔遗迹方块"
	quest.4A0000000000000A.quest_desc: [
		"合成 &6Obsidian Skull&r — 被 &6Obsidiansteel&r 包裹的骷髅头。"
		""
		"Obsidiansteel 需要用原始铁和玄武岩在 Clibano 中熔炼，但前提是 Clibano 中已镶嵌了 &6Artisan Relic&r 作为增强器。Artisan Relic 会出现在村庄的铁匠、工具匠和武器匠的箱子里，所以如果还没找到，就去几个村庄搜刮一下吧。"
		""
		"头骨是一个可放置的方块，与 Aureal 相关，会随着时间的推移经历裂纹、破碎、褪色和永恒等阶段。"
		"&7把它设置在你的仪式区附近。&r"
	]
	quest.4A0000000000000B.title: "恒星物质"
	quest.4A0000000000000B.quest_subtitle: "星辰石，深埋地下"
	quest.4A0000000000000B.quest_desc: [
		"Mine &6Stellarite&r from &6Stella Arcanum&r ore, found deep underground — a fallen-star material for the highest-tier crafts."
		"&7如果你推进到 Forbidden Arcanus 那么远，就能喂养 Tier 4 锻造升级和 Boss 捕捉器了。&r"
	]
	quest.4A0000000000000E.title: "铁匠的锤子 (The Blacksmith's Gavel)"
	quest.4A0000000000000E.quest_subtitle: "仪式的开端是什么"
	quest.4A0000000000000E.quest_desc: [
		"完成的锻造炉本身不会自动运作。右键点击锻造炉并使用&6Blacksmith Gavel&r即可开始仪式。"
		""
		"头部由黏土制成，然后用木棍和锭子固定。法槌有常见的材料等级，任何等级都能触发仪式——更好的法槌只是更耐用。"
	]
	quest.4A0000000000000F.title: "仪式基座 (Ritual Pedestals)"
	quest.4A0000000000000F.quest_subtitle: "祭品放置的位置在哪里"
	quest.4A0000000000000F.quest_desc: [
		"&6暗石基座&r用于放置仪式消耗的物品。将它们放置在环绕熔炉的八个镀金凿刻方块上。"
		""
		"主材料放入锻造炉中，其余放在基座上。大多数仪式只用八个位置中的六个，所以六个就足够了。"
	]
	quest.4A00000000000010.title: "喂养熔炉"
	quest.4A00000000000010.quest_subtitle: "四种类型的精华"
	quest.4A00000000000010.quest_desc: [
		"每个仪式都会消耗精华，熔炉会追踪四根条——&6Aureal&r、&6Blood&r、&6Souls&r和&6Experience&r。你可以通过熔炉界面下方的槽位来填充它们。"
		""
		"&eAureal&r — Aureal Bottles，一瓶再生药水 II 周围环绕着八个神秘水晶粉尘。"
		"&e血液&r — 伤害锻造炉旁的生物，血液会直接流入瓶中，或使用副手的&6试管&r来收集血液并带回。"
		"&e灵魂&r — 用&6灵魂提取器&r作用于灵魂沙，或在夜间游荡的迷失灵魂。"
		"&e经验&r — 用附魔瓶，或者把附魔工具扔进去烧掉附魔来获取精华。"
		""
		"&7所有进度条覆盖成本前，仪式将不会开始。&r"
	]
	quest.4A00000000000011.title: "更强大的锻造炉"
	quest.4A00000000000011.quest_subtitle: "第二级"
	quest.4A00000000000011.quest_desc: [
		"锻造炉始于&6Tier 1&r。更高等级能容纳更多精华，解锁更深层仪式——本章末的盔甲需要&6Tier 2&r。"
		""
		"在锻造台本身上进行升级：主要材料是&6Edelwood Planks&r，并在基座上放置4个Arcane Crystal和4个&6Spawner Scrap&r。Spawner Scrap可通过破坏怪物生成器获得。"
		""
		"&7升级后的锻造炉开采一次即可，然后放回原处。&r"
	]
	quest.4A00000000000007.title: "神秘巨龙（Draco Arcanus）"
	quest.4A00000000000007.quest_subtitle: "艺术大师"
	quest.4A00000000000007.quest_desc: [
		"&6Draco Arcanus&r 是 Forbidden Arcanus 能打造的顶级板甲——在 Tier 2 锻造炉上重铸的末地合金盔甲。"
		""
		"胸甲配方：主材料为 &6下界合金胸甲&r，周围放置 4 个 &6龙鳞&r 和 3 个 &6黑曜钢锭&r。龙鳞由龙掉落或在战利品中出现；黑曜钢锭来自 Clibano。"
		""
		"这是一个代价高昂的仪式——开始前请先存入你的奥瑞尔。"
		"&a奖励：一块领地和一件来自王国战利品的工具。&r"
		"&eForge the chestplate to finish The Forbidden Arts.&r"
	]
	task.6A00000000000008.title: "建造一座赫菲斯托斯锻造炉"
	task.6A00000000000013.title: "将锻造台升级到第2级"
	chapter.564E30088D7581A6.title: "召唤的艺术"
	chapter.564E30088D7581A6.chapter_subtitle: [
		"将异界灵体束缚于你的麾下——&5Occultism&r的仪式。"
	]
	quest.1F00000000000001.title: "灵体词典"
	quest.1F00000000000001.quest_subtitle: "你的 Occultism 指南"
	quest.1F00000000000001.quest_desc: [
		"合成&5灵魂词典&r——右键打开阅读，里面记载了所有灵魂的名字和仪式说明。"
		"之后你还需要用一本缚灵之书来刻写灵体的名字。"
		"&7神秘之路的开端。&r"
	]
	quest.1F00000000000003.title: "粉笔和刷子"
	quest.1F00000000000003.quest_subtitle: "绘制仪式法阵"
	quest.1F00000000000003.quest_desc: [
		"合成白色粉笔和刷子，绘制用于举行召唤仪式的仪式圈。"
		"每个仪式都有特定的粉笔画图案——请查阅词典。"
		"&7Draw on a clean floor.&r"
	]
	quest.1F00000000000004.title: "献祭碗 (Sacrificial Bowls)"
	quest.1F00000000000004.quest_subtitle: "请手持你的祭品物品"
	quest.1F00000000000004.quest_desc: [
		"在仪式圈周围放置祭品碗（中心放一个金碗）来盛放材料。"
		"仪式会消耗碗里的东西。"
		"&7You'll want several.&r"
	]
	quest.1F0000000000000D.title: "彩色粉笔 (Colored Chalks)"
	quest.1F0000000000000D.quest_subtitle: "高级圆形结构"
	quest.1F0000000000000D.quest_desc: [
		"黄色、紫色和红色的粉笔可以解锁更高级的仪式圈。"
		"更高级别的灵魂需要更华丽的图案。"
		"&7在攀爬层级时制作它们。&r"
	]
	quest.1F00000000000005.title: "绑定一个 Foliot"
	quest.1F00000000000005.quest_subtitle: "你的第一只灵魂生物"
	quest.1F00000000000005.quest_desc: [
		"使用&5束缚之书：福里奥&r举行仪式，召唤并束缚你的第一个也是最弱的灵体。"
		"Foliots 负责最简单的任务和工艺。"
		"&e召唤的真正起点就在这里。&r"
	]
	quest.1F0000000000000A.title: "绑定一个地精（Djinni）"
	quest.1F0000000000000A.quest_subtitle: "更强大的精神力量"
	quest.1F0000000000000A.quest_desc: [
		"精灵是更进一步的提升——绑定一个即可解锁更好的工艺和服务。"
		"需要一个比Foliot更华丽的圆形装置。"
		"&7Tier 2 of four.&r"
	]
	quest.1F0000000000000B.title: "绑定一个阿弗利特（Afrit）"
	quest.1F0000000000000B.quest_subtitle: "火焰之灵"
	quest.1F0000000000000B.quest_desc: [
		"阿弗瑞特是用于高阶仪式和制作的强大火之灵。"
		"现在已经快到顶部了。"
		"&7Tier 3 of four.&r"
	]
	quest.1F0000000000000C.title: "驯服一只马里德（Marid）"
	quest.1F0000000000000C.quest_subtitle: "最伟大的精神"
	quest.1F0000000000000C.quest_desc: [
		"马里德是神秘学中最强大的灵体——束缚它即可解锁最高阶的仪式。"
		"一项严肃的任务，回报同样丰厚。"
		"&e第4级 — 登峰造极。&r"
	]
	quest.1F00000000000011.title: "矿工之魂 The Miner Spirit"
	quest.1F00000000000011.quest_subtitle: "自动化资源收集系统"
	quest.1F00000000000011.quest_desc: [
		"将矿工灵魂绑定到&5魔法灯&r中，它就会为你挖掘其他维度的矿石和方块。"
		"被动资源的重要来源之一。"
		"&7给它喂食，让它工作。&r"
	]
	quest.1F00000000000014.title: "与马利德签订契约"
	quest.1F00000000000014.quest_subtitle: "最伟大的恶魔，已被束缚，效忠于你"
	quest.1F00000000000014.quest_desc: [
		"&dMarid&r 是 Occultism 模组中最高阶的恶魔，只有在较低的 Foliot、Djinni 和 Afrit 被召唤后才能召唤。"
		"运行马利德束缚仪式，即可获得&d束缚之书（马利德）&r，这份契约能让你召唤一个马利德为你效力。"
		"&e获得一本束缚之书（Marid）以完成召唤的艺术。&r"
	]
	task.3F0000000000001A.title: "驯服一只马里德（Marid）"
	quest.1F00000000000012.title: "伙伴生物"
	quest.1F00000000000012.quest_subtitle: "召唤一个伙伴生物"
	quest.1F00000000000012.quest_desc: [
		"The Familiar Ring binds a small familiar that follows you and grants passive perks."
		"不同的宠物会提供不同的增益效果。"
		"&7收集几个，然后交换它们。&r"
	]
	quest.1F00000000000013.title: "维度存储（Dimensional Storage）"
	quest.1F00000000000013.quest_subtitle: "深不见底的空间"
	quest.1F00000000000013.quest_desc: [
		"建造一个存储控制器和维度矩阵，将近乎无限的物品存放在口袋维度中。"
		"一位灵魂为你守护着一切。"
		"&e神秘学的答案，用于存储。&r"
	]
	quest.1F00000000000006.title: "占卜之杖 (The Divination Rod)"
	quest.1F00000000000006.quest_subtitle: "找到任何东西都可以"
	quest.1F00000000000006.quest_desc: [
		"制作&5占卜杖&r——对准一个方块，它会指向地下最近的同类方块。"
		"寻找其他石头和矿石的必备工具。"
		"&7你在这里的第一件真正工具。&r"
	]
	quest.1F00000000000007.title: "另一个世界 (The Otherworld)"
	quest.1F00000000000007.quest_subtitle: "看见那看不见的东西"
	quest.1F00000000000007.quest_desc: [
		"种植一棵异界之树，并制作异界护目镜，用你的第三只眼来观察隐藏的异界方块。"
		"有些资源只有在透过面纱观察时才会出现。"
		"&7戴上护目镜，开启你的第三眼。&r"
	]
	quest.1F00000000000002.title: "恶魔之梦"
	quest.1F00000000000002.quest_subtitle: "神秘作物"
	quest.1F00000000000002.quest_desc: [
		"通过破坏草来寻找&5Demon's Dream Seeds&r，然后用它们种植&5Datura&r植物。"
		"它的叶子是 Occultism 仪式和第三眼酿造的核心试剂。"
		"&7便宜又实用——早点种上一片地吧。&r"
	]
	quest.1F00000000000008.title: "银色"
	quest.1F00000000000008.quest_subtitle: "神秘金属（The occult metal）"
	quest.1F00000000000008.quest_desc: [
		"开采和冶炼&5银&r——奥术主义工具和仪式的基础金属。"
		"像其他矿石一样，在地下被发现。"
		"&7准备好一组的物品备用。&r"
	]
	quest.1F0000000000000F.title: "附魔的镐子 (Infused Pickaxe)"
	quest.1F0000000000000F.quest_subtitle: "银质工具"
	quest.1F0000000000000F.quest_desc: [
		"附魔镐是一种可以用灵魂能量充能的银色工具。"
		"比原版铁更实用的升级物品。"
		"&7保持满格状态。&r"
	]
	quest.1F00000000000009.title: "Iesnium"
	quest.1F00000000000009.quest_subtitle: "下界金属"
	quest.1F00000000000009.quest_desc: [
		"&5Iesnium&r 是一种来自下界的稀有金属，需要借助你的灵魂才能开采。"
		"最强的神秘学材料。"
		"&7带上火焰保护装备。&r"
	]
	quest.1F00000000000010.title: "Iesnium 镐"
	quest.1F00000000000010.quest_subtitle: "顶级工具"
	quest.1F00000000000010.quest_desc: [
		"Iesnium 镐是最好的神秘采矿工具——速度快、耐用，且充满灵性。"
		"抵达下界金属的奖励。"
		"&7终局挖掘。&r"
	]
	chapter.3108386352D52F8B.title: "灵魂艺术 (The Spirit Arts)"
	chapter.3108386352D52F8B.chapter_subtitle: [
		"收割灵魂，将其锻造成力量——&bMalum&r的奥术。"
	]
	quest.1E00000000000001.title: "神秘学百科全书"
	quest.1E00000000000001.quest_subtitle: "你的 Malum 手册"
	quest.1E00000000000001.quest_desc: [
		"制作&bEncyclopedia Arcana&r——它能解释Malum中的灵魂、亲和性以及所有配方。"
		""
		"需要一本普通书和一块&b精炼灵魂石&r，所以先去挖灵魂石吧——它和铁在同一深度。将原矿石熔炼即可得到精炼的。"
		"&7整部艺术的指南。解锁新材料时阅读条目。&r"
	]
	quest.1E00000000000002.title: "种植符文木（Runewood）"
	quest.1E00000000000002.quest_subtitle: "神秘古树"
	quest.1E00000000000002.quest_desc: [
		"种植一棵Runewood树苗，培育出大多数Malum方块所由构成的神秘古树。"
		"在这里，Runewood 是你主要的合成木材。"
		"&7尽早种下一小片树林。&r"
	]
	quest.1E00000000000003.title: "采集灵魂石 Mine Soulstone"
	quest.1E00000000000003.quest_subtitle: "点燃灵魂的燃料"
	quest.1E00000000000003.quest_desc: [
		"挖掘&b灵魂石原矿&r——这种石头能承载并引导灵魂。"
		"你需要稳定的祭坛和试剂供应。"
		"&7像任何矿石一样，在地下被发现。&r"
	]
	quest.1E00000000000004.title: "烈焰石英"
	quest.1E00000000000004.quest_subtitle: "炽热的试剂"
	quest.1E00000000000004.quest_desc: [
		"收集&bBlazing Quartz&r，一种用于火焰相关配方和精炼的热试剂。"
		"在许多合成配方中与灵魂石搭配使用。"
		"&7储备一叠物品。&r"
	]
	quest.1E00000000000005.title: "粗糙的镰刀 (The Crude Scythe)"
	quest.1E00000000000005.quest_subtitle: "收割灵魂"
	quest.1E00000000000005.quest_desc: [
		"制作一把&b镰刀&r，用它杀死生物，将它们的灵魂粉碎成灵魂碎片。"
		"不同的生物会掉落不同的精神亲和力。"
		"&eMalum的核心循环——收割灵魂以驱动一切。&r"
	]
	quest.1E00000000000006.title: "灵魂罐 Spirit Jar"
	quest.1E00000000000006.quest_subtitle: "将你的灵魂存放在这里"
	quest.1E00000000000006.quest_desc: [
		"灵魂瓶会自动收集并储存附近的零散灵魂碎片。"
		"在祭坛旁放置一个，这样就不会有任何东西被浪费。"
		"&7让你的收获井井有条。&r"
	]
	quest.1E00000000000007.title: "灵魂祭坛"
	quest.1E00000000000007.quest_subtitle: "你的制作之心"
	quest.1E00000000000007.quest_desc: [
		"建造&b灵魂祭坛&r——将物品放置其上，并向灵魂喂食以合成Malum的试剂和装备。"
		"用基座将其包围以添加材料。"
		"&e所有高级功能都通过这个祭坛运行。&r"
	]
	quest.1E00000000000008.title: "木炭与灰烬"
	quest.1E00000000000008.quest_subtitle: "基础试剂"
	quest.1E00000000000008.quest_desc: [
		"&b秘法木炭&r和&b诅咒灰烬&r是你在祭坛上精炼的第一批试剂。"
		"它们会转化为更高级别的材料。"
		"&7保持一定的储备量。&r"
	]
	quest.1E00000000000010.title: "奥瑞克余烬"
	quest.1E00000000000010.quest_subtitle: "黄金燃料"
	quest.1E00000000000010.quest_desc: [
		"&b金质余烬&r是一种经过提炼、带有金色光泽的燃料，适用于最强大的工艺。"
		"在祭坛上结合早期试剂制作而成。"
		"&7一个中等里程碑。&r"
	]
	quest.1E00000000000009.title: "灵魂浸染钢锭"
	quest.1E00000000000009.quest_subtitle: "具有代表性的金属材质"
	quest.1E00000000000009.quest_desc: [
		"Forge &bSoul Stained Steel&r — Malum 的标志性金属，通过将灵魂与铁结合制成。"
		"所有工具、武器和盔甲的基础材料。"
		"&e在大规模冶炼前攒好灵魂。&r"
	]
	quest.1E0000000000000A.title: "灵魂锻造武器"
	quest.1E0000000000000A.quest_subtitle: "剑与镰刀"
	quest.1E0000000000000A.quest_desc: [
		"制作灵魂浸染钢剑和镰刀——由注入灵魂的钢铁锻造而成的坚固武器。"
		"镰刀收割所杀生物的灵魂，在战斗中补充你的灵魂储备。"
		"&7添加更多符文。&r"
	]
	quest.1E0000000000000B.title: "符文工作台 (The Runic Workbench)"
	quest.1E0000000000000B.quest_subtitle: "自己刻制你的符文"
	quest.1E0000000000000B.quest_desc: [
		"建造&b符文工作台&r，在石板镌刻符文——Malum的附魔类系统。"
		"符文不是装备在物品上，而是用&b符文胸针&r佩戴在身上，每只手一个符文，以获得被动增益。"
		"&7自由搭配，打造适合你的建筑。&r"
	]
	quest.1E0000000000000F.title: "炼金术的推动力"
	quest.1E0000000000000F.quest_subtitle: "熔炉之心"
	quest.1E0000000000000F.quest_desc: [
		"&b炼金催化剂&r是&b灵魂熔炉&r的核心——它将原始灵魂凝聚成更精纯、更强大的形态。"
		"用力过猛会导致催化剂受损，所以注意你的仪式。"
		"&7献给专注的灵魂锻造者。&r"
	]
	quest.1E0000000000000E.title: "扭曲试剂 (Twisted Reagents)"
	quest.1E0000000000000E.quest_subtitle: "黑暗材料"
	quest.1E0000000000000E.quest_desc: [
		"收集 &b扭曲岩石&r 和 &b阴郁滑石&r — 用于最黑暗、最强大配方的腐化材料。"
		"在扭曲的、充满灵气的地方可以找到。"
		"&7小心处理腐化现象。&r"
	]
	quest.1E0000000000000C.title: "哭泣的深井"
	quest.1E0000000000000C.quest_subtitle: "打开通往虚空的道路"
	quest.1E0000000000000C.quest_desc: [
		"组装&b哭泣之井&r——一口通往&8虚空&r的原始汤仪式井，这是Malum精神艺术的最深层，也是其最黑暗材料的来源。"
		"&a奖励：一块领地和一件来自王国战利品的工具。&r"
	]
	chapter.0CD78EB2BA047964.title: "女巫的魔药酿造术"
	chapter.0CD78EB2BA047964.chapter_subtitle: [
		"草药、蜡烛、大锅和扫帚——&dHexerei&r的巫术。"
	]
	quest.1D00000000000001.title: "暗影之书 (The Book of Shadows)"
	quest.1D00000000000001.quest_subtitle: "你的女巫手册"
	quest.1D00000000000001.quest_desc: [
		"合成&d暗影之书&r——它包含所有 Hexerei 配方，并指导你完成合成。"
		""
		"你需要皮革、一本书、动物脂肪和一颗&d鼠尾草种子&r。鼠尾草在草地上野生生长，所以坐下制作前，先破坏几株植物吧。"
		"&7随时备着；这里的大多数物品都显示配方。&r"
	]
	quest.1D00000000000012.title: "暗影之书祭坛"
	quest.1D00000000000012.quest_subtitle: "一个可以学习的地方"
	quest.1D00000000000012.quest_desc: [
		"将你的《暗影之书》放置在祭坛上以显示它并固定你的工作区。"
		"在它的周围搭建好你的酿造区。"
		"&7为你打造的整洁家园。&r"
	]
	quest.1D00000000000002.title: "研钵和研杵"
	quest.1D00000000000002.quest_subtitle: "将你的材料进行研磨"
	quest.1D00000000000002.quest_desc: [
		"研钵和研杵可将草药、花瓣和材料研磨成粉末和粉尘。"
		"许多配方需要研磨的原料——这是你的第一件工具。"
		"&7廉价又实用。&r"
	]
	quest.1D00000000000007.title: "草药存储箱"
	quest.1D00000000000007.quest_subtitle: "罐子和宝箱"
	quest.1D00000000000007.quest_desc: [
		"Herb Jars 和 Coffers 能帮你整理日益增长的试剂收藏。"
		"快速访问能让酿造速度更快。"
		"&7宝箱装有普通物品；罐子专门存放草药。&r"
	]
	quest.1D00000000000003.title: "种植鼠尾草"
	quest.1D00000000000003.quest_subtitle: "从种子到干粮的旅程"
	quest.1D00000000000003.quest_desc: [
		"种植&d鼠尾草种子&r，收割叶子，然后将它们烘干成&d干鼠尾草&r。"
		"干草药是大多数酿造和仪式的支柱。"
		"培育稳定的供应来源。"
	]
	quest.1D00000000000011.title: "智慧燃烧之盘"
	quest.1D00000000000011.quest_subtitle: "烟雾与净化"
	quest.1D00000000000011.quest_desc: [
		"在燃烧板上燃烧干燥鼠尾草，释放净化烟雾和仪式效果。"
		"用于净化区域和施展某些仪式。"
		"&7在工作台附近点燃它。&r"
	]
	quest.1D0000000000000B.title: "蜡烛舀勺"
	quest.1D0000000000000B.quest_subtitle: "制作你自己的蜡烛吧"
	quest.1D0000000000000B.quest_desc: [
		"蜡烛舀子能将蜡和线变成蜡烛。"
		"蜡烛点亮仪式，标记典礼空间。"
		"&7提前制作一批。&r"
	]
	quest.1D00000000000004.title: "蜡烛"
	quest.1D00000000000004.quest_subtitle: "仪式之光"
	quest.1D00000000000004.quest_desc: [
		"蜡烛被用来布置仪式并为女巫团增添装饰。"
		"某些仪式对颜色和排列顺序有要求。"
		"&7简单，但必要。&r"
	]
	quest.1D00000000000005.title: "混合炼药锅"
	quest.1D00000000000005.quest_subtitle: "Where brews are made"
	quest.1D00000000000005.quest_desc: [
		"&d混合锅&r是Hexerei的核心。装满水，在底下生火，投入材料即可酿造。"
		"看着药水调配完成，水的颜色也随之发生变化。"
		"&eYour main crafting station from here on.&r"
	]
	quest.1D00000000000006.title: "血瓶 (Blood Bottle)"
	quest.1D00000000000006.quest_subtitle: "将血液装进瓶子里面去"
	quest.1D00000000000006.quest_desc: [
		"用血符将混合坩埚中收集到的血液装瓶。"
		"血液是 Hexerei 配方中的关键材料——尤其是飞行扫帚。"
		"&7小心处理。&r"
	]
	quest.1D0000000000000A.title: "血之印记"
	quest.1D0000000000000A.quest_subtitle: "在炼药锅中采集血液样本"
	quest.1D0000000000000A.quest_desc: [
		"血印是一个&6混合熔炉&r的附件。激活后，跳入装有液体的熔炉的生物（或你）会向其中献出血液。"
		"三滴血足以装满一个血瓶。"
		"&7威力强大，但并非胆小者所能承受。&r"
	]
	quest.1D00000000000009.title: "Selenite 和 Moonlight"
	quest.1D00000000000009.quest_subtitle: "月相试剂"
	quest.1D00000000000009.quest_desc: [
		"Selenite Shards 可在丛林和沼泽的晶洞中挖掘；Moon Dust 则用红石和萤石在炼药锅中酿造。"
		"两者都能酿造出最强大的药水。"
		"&7用于高阶魔法的优质材料。&r"
	]
	quest.1D00000000000008.title: "你的第一根扫帚魔杖"
	quest.1D00000000000008.quest_subtitle: "飞向天空"
	quest.1D00000000000008.quest_desc: [
		"制作柳条扫帚——它已准备好飞行。右键骑乘并翱翔。"
		"扫帚的刷子会磨损，所以要备有备用的（在坩埚里酿造湿刷子，然后在晾架上晾干）。"
		"&e经典的女巫骑乘。&r"
	]
	quest.1D0000000000000C.title: "更好的扫帚模组 (Better Brooms)"
	quest.1D0000000000000C.quest_subtitle: "升级并停放它们"
	quest.1D0000000000000C.quest_desc: [
		"桃花心木扫帚比柳木扫帚飞得更快，操控性也更好。"
		"建造一个扫帚架来停放和展示你的扫帚。"
		"&7随着进度不断升级交易。&r"
	]
	quest.1D0000000000000D.title: "乌鸦的附魔生物"
	quest.1D0000000000000D.quest_subtitle: "召唤一只乌鸦"
	quest.1D0000000000000D.quest_desc: [
		"乌鸦笛召唤并命令一只乌鸦伙伴跟随并帮助你。"
		"宠物会帮你收集物品，还能陪伴你左右。"
		"&7Bond with your bird.&r"
	]
	quest.1D0000000000000E.title: "猫头鹰邮局"
	quest.1D0000000000000E.quest_subtitle: "找到鸟巢的巢穴"
	quest.1D0000000000000E.quest_desc: [
		"在世界上寻找一个猫头鹰邮局——那里的猫头鹰能将物品运送到远方。"
		"对于人脉广的女巫来说，是个不错的发现。"
		"&7探索以找到一个。&r"
	]
	quest.1D0000000000000F.title: "找到一个女巫集会 (Coven)"
	quest.1D0000000000000F.quest_subtitle: "自然与黑暗"
	quest.1D0000000000000F.quest_desc: [
		"追踪 &dNature Coven&r 和 &dDark Coven&r——藏有战利品和传说的女巫定居点。"
		"每种都通往不同的工艺道路。"
		"去两个地方都看看。"
	]
	quest.1D00000000000010.title: "巴巴雅加小屋"
	quest.1D00000000000010.quest_subtitle: "会行走的小屋"
	quest.1D00000000000010.quest_desc: [
		"追踪传说中的巴巴雅加小屋，这是 Hexerei 中最稀有的建筑。"
		"它的宝藏会奖励最敬业的女巫们。"
		"&e真正的终局宝藏。&r"
	]
	quest.1D00000000000013.title: "女巫的仪式服饰"
	quest.1D00000000000013.quest_subtitle: "独特的服饰和属于你自己的信使生物"
	quest.1D00000000000013.quest_desc: [
		"&5蘑菇女巫帽&r是女巫的标志性服饰，由你收集到的草药和布料缝制而成。"
		"用&5渡鸦安卡护身符&r绑定一个伙伴乌鸦——通过工艺与你绑定的乌鸦伙伴。"
		"&eCraft the Mushroom Witch Hat and a Crow Ankh Amulet to finish The Witch's Brew.&r"
	]
	task.3D0000000000001B.title: "制作一个蘑菇女巫帽"
	task.3D0000000000001C.title: "绑定一个乌鸦安卡护身符"
	chapter.70DE000000000001.title: "贸易的工具"
	chapter.70DE000000000001.chapter_subtitle: [
		"让建造、装饰和日常游戏更顺畅的实用模组——值得了解的好帮手。"
	]
	quest.7A00000000000021.title: "凿子和变体方块"
	quest.7A00000000000021.quest_subtitle: "重新雕刻和打磨过的物品"
	quest.7A00000000000021.quest_desc: [
		"制作一把&6凿子&r，将普通方块变成数十种干净的装饰性变体——柱体、面板、图案等等。"
		"右键使用凿子打开菜单，然后选择你想要的变体。"
		"&7Rechiseled and Chipped 涵盖了大多数原版和模组方块。&r"
	]
	quest.7A00000000000022.title: "Chipped"
	quest.7A00000000000022.quest_subtitle: "数千种方块变体"
	quest.7A00000000000022.quest_desc: [
		"&6Chipped&r 添加了合成台（如木匠台），为木材、石头等提供了大量装饰性变体。"
		"放置一个方块，即可从数百种风格中任选其一。"
		"&7为建筑增添细节的最快方法。&r"
	]
	quest.7A00000000000023.title: "FramedBlocks"
	quest.7A00000000000023.quest_subtitle: "任何形状，任何纹理"
	quest.7A00000000000023.quest_desc: [
		"&6FramedBlocks&r 是一种空白方块，你可以用任何其他形状的方块来伪装它——石板、楼梯、斜坡、柱子。"
		"手持任意方块，右键点击带框方块即可应用该方块的外观。（带框锤会调整并去除伪装。）"
		"使用任意材料建造无缝的自定义形状。"
	]
	quest.7A00000000000024.title: "手工制作的家具"
	quest.7A00000000000024.quest_subtitle: "桌子、椅子和装饰品"
	quest.7A00000000000024.quest_desc: [
		"&6手工打造&r添加了家具——桌子、椅子、架子、长凳、餐具和小饰品——来装饰室内。"
		"用不同类型的木材进行搭配组合。"
		"&7让房间看起来更有生活气息。&r"
	]
	quest.7A00000000000025.title: "Macaw's Collection"
	quest.7A00000000000025.quest_subtitle: "门、屋顶、桥梁等等"
	quest.7A00000000000025.quest_desc: [
		"&6Macaw's&r 模组添加了各种风格的门、窗、屋顶、围栏、活板门、桥梁、路径和灯光。"
		"详细建造所需的一切物品。"
		"&7与其他建筑模组堆叠放置。&r"
	]
	quest.7A00000000000026.title: "建筑套装"
	quest.7A00000000000026.quest_subtitle: "现成的调色板"
	quest.7A00000000000026.quest_desc: [
		"&6Medieval Buildings&r、&6Royal Variations&r和&6Fusion&r添加了整套匹配的方块——砖块、木材、装饰条和连贯纹理。"
		"城镇和城堡的绝佳起点位置。"
		"&7Browse them in the creative menu or JEI.&r"
	]
	quest.7A00000000000027.title: "附魔分解台"
	quest.7A00000000000027.quest_subtitle: "恢复附魔效果"
	quest.7A00000000000027.quest_desc: [
		"&6附魔分解台&r能将工具、武器或盔甲上的附魔转移到书上。"
		"在拆解旧装备前，先回收附魔效果。"
		"&7消耗一些经验值，但可以保存很棒的附魔。&r"
	]
	quest.7A00000000000028.title: "无生物区域"
	quest.7A00000000000028.quest_subtitle: "巨型火把和巨型长柄火把"
	quest.7A00000000000028.quest_desc: [
		"放置一个 &6Megatorch&r 或 &6Magnum Torch&r 即可阻止大范围内的怪物生成——无需照亮每个角落。"
		"一个火把就能让基地或农场保持安全。"
		"&7大型建筑的神器，节省大量时间。&r"
	]
	quest.7A00000000000029.title: "树木收割机"
	quest.7A00000000000029.quest_subtitle: "砍倒了整棵树"
	quest.7A00000000000029.quest_desc: [
		"使用&6Tree Harvester&r，砍断树木的底部树干即可一次性将其全部砍倒。"
		"再也不用为了散落的树叶和原木而攀爬了。"
		"&7适用于任何斧头。&r"
	]
	task.7C00000000000026.title: "明白了！"
	task.7C00000000000029.title: "明白了！"
	chapter.70DE000000000003.title: "存储与旅行"
	chapter.70DE000000000003.chapter_subtitle: [
		"携带更多物品，四处走动——背包、传送石、手推车、马车和船只。"
	]
	quest.6F00000000000001.title: "你的第一个背包"
	quest.6F00000000000001.quest_subtitle: "穿戴上你的储物装备"
	quest.6F00000000000001.quest_desc: [
		"制作一个&6背包&r，并将其佩戴在背部（或直接手持）以获得大量额外物品栏。"
		"在任何地方用按键绑定打开它——无需放置箱子。"
		"&7Dye it any color and name it if you like.&r"
	]
	quest.6F00000000000002.title: "更大的背包模组 (Bigger Backpacks)"
	quest.6F00000000000002.quest_subtitle: "更多行，更多物品栏位"
	quest.6F00000000000002.quest_desc: [
		"将基础背包沿等级阶梯升级 — &e铜、铁、金、钻石、下界合金&r — 每个都会增加存储行和升级槽。"
		"升级会保留你的内容和设置。"
		"铁是一个不错的早期目标。"
	]
	quest.6F00000000000003.title: "钻石背包"
	quest.6F00000000000003.quest_subtitle: "严肃的容量需求"
	quest.6F00000000000003.quest_desc: [
		"钻石等级可容纳大量物品，并为自动化解锁更多升级槽位。"
		"安顿下来后，钻石就值了。"
		"&7还剩最后一个等级。&r"
	]
	quest.6F00000000000004.title: "下界合金背包"
	quest.6F00000000000004.quest_subtitle: "最高等级"
	quest.6F00000000000004.quest_desc: [
		"下界合金背包&e防火&r，容量最大，升级槽最多。"
		"它能承受岩浆和火焰的灼烧——你的装备安全之所。"
		"&a奖励：一块领地和一件来自王国战利品的工具。&r"
	]
	quest.6F00000000000005.title: "背包升级模组内容更新"
	quest.6F00000000000005.quest_subtitle: "升级系统"
	quest.6F00000000000005.quest_desc: [
		"制作一个 &6升级底座&r — 每个背包升级的核心。"
		"升级背包槽位，赋予背包新能力：自动拾取、磁铁、合成、喂食、工具切换等。"
		"&7更高级的背包能同时容纳更多升级。&r"
	]
	quest.6F00000000000006.title: "自动拾取物品"
	quest.6F00000000000006.quest_subtitle: "吸走掉落物"
	quest.6F00000000000006.quest_desc: [
		"拾取升级能让你的背包自动拾取地上的物品。"
		"设置过滤器，使其只抓取你想要的东西。"
		"非常适合用于采矿和生物农场。"
	]
	quest.6F00000000000007.title: "磁石升级"
	quest.6F00000000000007.quest_subtitle: "从指定范围内拉取物品"
	quest.6F00000000000007.quest_desc: [
		"磁石升级可将附近的物品和经验值直接吸向你。"
		"与拾取结合使用，即可横扫一片区域。"
		"&7Toggle it off when you don't want the clutter.&r"
	]
	quest.6F00000000000018.title: "堆叠升级 I"
	quest.6F00000000000018.quest_subtitle: "将你的物品堆叠数量翻倍"
	quest.6F00000000000018.quest_desc: [
		"制作一个&6堆叠升级1级&r，并将其放入背包中，使每个格子能容纳多一倍的物品。"
		"非常适合运输成千上万的石头、泥土和矿石。"
		"&7需要升级台才能建造。&r"
	]
	quest.6F00000000000019.title: "堆叠升级 II"
	quest.6F00000000000019.quest_subtitle: "四倍的收获量"
	quest.6F00000000000019.quest_desc: [
		"&6堆叠升级2级&r使每个格子的堆叠数量变为四倍。"
		"单个背包格现在可以装下双箱中的一个物品。"
	]
	quest.6F0000000000001A.title: "堆叠升级 III"
	quest.6F0000000000001A.quest_subtitle: "无底运输系统"
	quest.6F0000000000001A.quest_desc: [
		"&6堆叠升级3级&r将每个格子的堆叠量提升至正常值的八倍。"
		"一整天都在挖矿，一次都没回家卸货。"
		"&7如果你填满了这个，更高级别的也存在。&r"
	]
	quest.6F00000000000008.title: "放置一块传送石 (Waystone)"
	quest.6F00000000000008.quest_subtitle: "快速旅行锚点"
	quest.6F00000000000008.quest_desc: [
		"放置并激活一个 &6Waystone&r 来标记地点，然后点击任意 Waystone 即可传送到你已激活的其他 Waystone。"
		""
		"最快的方法是直接寻找：传送石会生成在村庄和世界各处，可以直接挖掘。而制作则需要一个位于中心的&6Warp Stone&r。"
		"&7Scatter them across your world — home, mines, villages, the Nether. Activating one is free and permanent.&r"
	]
	quest.6F00000000000009.title: "传送卷轴"
	quest.6F00000000000009.quest_subtitle: "随时随地进行传送"
	quest.6F00000000000009.quest_desc: [
		"一张传送卷轴能让你瞬移到任何已知的传送石，无需站在上面——单次使用。"
		"紧急情况或长途旅行时很方便。"
		"制作一个用于探险的堆栈。"
	]
	quest.6F0000000000000A.title: "传送石"
	quest.6F0000000000000A.quest_subtitle: "可重复使用的传送门"
	quest.6F0000000000000A.quest_desc: [
		"Warp Stone 的作用和 Warp Scroll 一样，但经过短暂冷却后可以重复使用。"
		"在快捷栏里放一个，就永远不会远离家了。"
		"&a奖励：来自王国战利品的一件物品。&r"
	]
	quest.6F0000000000000B.title: "返回卷轴"
	quest.6F0000000000000B.quest_subtitle: "返回文明社会"
	quest.6F0000000000000B.quest_desc: [
		"一张返回卷轴可让你使用一次便传送到&e最近的已激活的传送石&r——无需绑定。"
		"身处野外深处时，返回安全的廉价方法。"
		"&7要前往特定目的地，请使用下方的绑定卷轴。&r"
	]
	quest.6F0000000000000C.title: "绑定卷轴"
	quest.6F0000000000000C.quest_subtitle: "设置你自己的目的地"
	quest.6F0000000000000C.quest_desc: [
		"绑定卷轴可以绑定到你选择的传送石上，之后可以重复使用来传送到那里。"
		"把它绑定到你的基地、矿井，或者你经常去的地方。"
		"随时可以重新绑定按键。"
	]
	quest.6F0000000000000D.title: "手推车"
	quest.6F0000000000000D.quest_subtitle: "自己动手丰衣足食"
	quest.6F0000000000000D.quest_desc: [
		"手推车是一种你可以拖着走的小型移动箱子。"
		"非常适合搬运大量方块，无需来回跑上百趟。"
		"&7便宜，而且不需要动物。&r"
	]
	quest.6F0000000000000E.title: "补给矿车"
	quest.6F0000000000000E.quest_subtitle: "让动物来搬运它吧"
	quest.6F0000000000000E.quest_desc: [
		"将补给箱连接到马、骡子或驴上，即可获得一个跟随你的大型移动储物箱。"
		"容量远超手推车。"
		"牵着动物走，马车会跟在后面。"
	]
	quest.6F0000000000000F.title: "动物手推车"
	quest.6F0000000000000F.quest_subtitle: "移动牲畜"
	quest.6F0000000000000F.quest_desc: [
		"动物手推车可以装载动物——装上牛、羊或猪，一次就能把整个畜群迁移到新地方。"
		"用小麦一个一个地引诱它们，把它们引开。"
		"&7还有马匹牵引的。&r"
	]
	quest.6F00000000000010.title: "马拉货车"
	quest.6F00000000000010.quest_subtitle: "小跑马车"
	quest.6F00000000000010.quest_desc: [
		"康斯特戈马车是一种大型马车，可供骑乘并装载物品。"
		"骑上马，出发吧——乘客和货物一起上路。"
		"一辆真正的陆地交通工具。"
	]
	quest.6F00000000000011.title: "装甲运兵车"
	quest.6F00000000000011.quest_subtitle: "穿越重重危险，将货物运抵目的地"
	quest.6F00000000000011.quest_desc: [
		"装甲马车是一种更坚固的马车，能在崎岖道路上保护骑手和货物。"
		"适合在定居点之间进行长途、危险的运输。"
		"&a奖励：来自王国战利品的一件物品。&r"
	]
	quest.6F00000000000013.title: "你的第一艘船"
	quest.6F00000000000013.quest_subtitle: "齿轮装置"
	quest.6F00000000000013.quest_desc: [
		"建造并驾驶一艘 &6Cog&r——一种可以在水上航行的轻型帆船。"
		"用一箱补给品装满它，然后扬帆起航。"
		"比船快得多，空间也大得多。"
	]
	quest.6F00000000000014.title: "船舱区 (The Galley)"
	quest.6F00000000000014.quest_subtitle: "更大更快"
	quest.6F00000000000014.quest_desc: [
		"加力船是一艘更大、载货空间和速度都更高的船。"
		"齿轮的升级版，适合真正的航行和运输。"
		"&7加上帆，让它能开得更快。&r"
	]
	quest.6F00000000000015.title: "布里格码头"
	quest.6F00000000000015.quest_subtitle: "旗舰舰"
	quest.6F00000000000015.quest_desc: [
		"布里格号是最大的船——载货量大，多帆，还有装大炮的空间。"
		"你的远洋旗舰。"
		"&a奖励：来自王国战利品的一件物品。&r"
	]
	quest.6F00000000000016.title: "升起风帆"
	quest.6F00000000000016.quest_subtitle: "速度和操控性"
	quest.6F00000000000016.quest_desc: [
		"为船只添加帆以提高速度——帆越多，速度越快。"
		"抓住风，缩短旅行时间。"
		"&7平衡船帆以对抗控制。&r"
	]
	quest.6F00000000000017.title: "大炮"
	quest.6F00000000000017.quest_subtitle: "海上战斗"
	quest.6F00000000000017.quest_desc: [
		"在船上安装大炮并装填炮弹，以在水上进行反击。"
		"击退溺尸、守卫者或敌对海盗。"
		"&a奖励：来自王国战利品的一件物品。&r"
	]
	chapter.388084E512A0ABCB.title: "MineColonies"
	chapter.388084E512A0ABCB.chapter_subtitle: [
		"发现了一个殖民地，招募公民来建造和经营，发展成一个自运转的中世纪城镇。"
	]
	quest.1A00000000000001.title: "找到了你的殖民地"
	quest.1A00000000000001.quest_subtitle: "每个殖民地都始于此处"
	quest.1A00000000000001.quest_desc: [
		"将&6补给营地&r放置在平坦的坚实地面上并打开，即可领取第一个&e市政厅&r和&e建造工具&r。"
		"选个宽敞的地方——随着你添加建筑，殖民地会向外扩张。"
		"&7补给营地只有一个，所以选好位置很重要。&r"
	]
	quest.1A00000000000002.title: "建造市政厅 (Raise the Town Hall)"
	quest.1A00000000000002.quest_subtitle: "殖民地的心脏"
	quest.1A00000000000002.quest_desc: [
		"市政厅建立了你的殖民地，并宣称了周围的土地。"
		"放置方块，然后用建造工具设置地基并确认——雇佣建造者后，他就会开始建造。"
		"随时打开即可查看市民、幸福度和殖民地全局设置。"
	]
	quest.1A00000000000003.title: "建造工具"
	quest.1A00000000000003.quest_subtitle: "每个建筑是如何放置的"
	quest.1A00000000000003.quest_desc: [
		"建造工具可以放置和升级&e所有&r殖民地建筑。"
		"右键打开蓝图菜单，放置透视全息图，旋转并确认。"
		"&7建筑不会立即出现——建造者会逐块处理材料。&r"
	]
	quest.1A00000000000004.title: "雇佣一名建筑师"
	quest.1A00000000000004.quest_subtitle: "没有它，就什么也建不起来"
	quest.1A00000000000004.quest_desc: [
		"放置一个&6建造小屋&r并分配一个公民。建造者会建造和升级其他所有建筑。"
		"建造者需要材料——查看小屋的请求清单并填满，或让信使稍后送达。"
		"&e保持你的建造者补给充足，其他一切都会随之而来。&r"
	]
	quest.1A00000000000005.title: "一个殖民地诞生了"
	quest.1A00000000000005.quest_subtitle: "市政厅已建造完成"
	quest.1A00000000000005.quest_desc: [
		"你的市政厅已经建成，殖民地也已出现在地图上。"
		"从这里你可以建造下面任何小屋——没有固定顺序，所以根据你的殖民地需求来建造。"
		"&a奖励：一个用于扩展边界的领地宣称令牌。&r"
	]
	quest.1A00000000000006.title: "请求系统"
	quest.1A00000000000006.quest_subtitle: "工人如何请求材料"
	quest.1A00000000000006.quest_desc: [
		"工人无法收集所有东西——他们会发出工具、食物和材料的&e请求&r。"
		"有三种方式：将物品放入工人小屋，在市政厅的请求列表上交，或建造&6仓库&r和&6信使&r自动运送。"
		"&7资源卷轴和剪贴板让你随时随地阅读开放请求。&r"
	]
	quest.1A00000000000007.title: "建造家园"
	quest.1A00000000000007.quest_subtitle: "居民们需要居住的地方"
	quest.1A00000000000007.quest_desc: [
		"每个&6住宅&r都容纳着居民，并能提升你的人口上限。"
		"更多床意味着更多工人的空间——在住房短缺前建造住宅。"
		"升级它们以进一步提高上限并保持市民的满意度。"
	]
	quest.1A00000000000008.title: "建造一家酒馆"
	quest.1A00000000000008.quest_subtitle: "招募新市民"
	quest.1A00000000000008.quest_desc: [
		"&6酒馆&r是新公民的抵达地——访客会突然出现，只需支付少量费用即可招募。"
		"还能提供一个采集点并提升幸福感。"
		"源源不断的招募者让你的工人槽位保持满员。"
	]
	quest.1A00000000000009.title: "一个不断发展的村庄"
	quest.1A00000000000009.quest_subtitle: "5名村民"
	quest.1A00000000000009.quest_desc: [
		"你的殖民地已达到 &e5 名居民&r。"
		"住房、食物和职业要领先于人口，这样人口才会持续增长。"
		"&a奖励：随着你的领地扩大，获得另一个领地宣称。&r"
	]
	quest.1A0000000000000A.title: "一个繁华的小镇"
	quest.1A0000000000000A.quest_subtitle: "10名居民"
	quest.1A0000000000000A.quest_desc: [
		"现在有十名公民将你的殖民地称为家。"
		"这个规模的 &6仓库&r和&6快递员&r非常实用——让他们运输材料，建筑师就不会闲着。"
		"&a奖励：获得更多已认领的土地。&r"
	]
	quest.1A0000000000000B.title: "一个繁荣的殖民地"
	quest.1A0000000000000B.quest_subtitle: "25名居民"
	quest.1A0000000000000B.quest_desc: [
		"二十五名居民——一个名副其实的小镇。"
		"&6大学&r研究以及更高级的建筑将推动你迈向50级乃至更高。"
		"&a奖励：一大片领地和一件来自殖民地商店的工具。&r"
	]
	quest.1A0000000000000C.title: "开始一个农场"
	quest.1A0000000000000C.quest_subtitle: "种植殖民地所需的食物作物"
	quest.1A0000000000000C.quest_desc: [
		"放置一个&6农场&r，并在附近标记&e田地&r供农民耕作。"
		"农夫种植和收割作物，为市民提供食物，并为厨师供应食材。"
		"使用建造工具分配田地，并选择每种田地生长的作物。"
	]
	quest.1A0000000000000D.title: "建造一个渔场"
	quest.1A0000000000000D.quest_subtitle: "来自水中的食物"
	quest.1A0000000000000D.quest_desc: [
		"海岸或湖泊上的&6渔夫小屋&r能稳定地提供鱼类。"
		"鱼是早期的廉价食物——只需一间小屋和一个工人。"
		"&7农场启动期间的良好备份。&r"
	]
	quest.1A0000000000000E.title: "让所有人都吃饱肚子"
	quest.1A0000000000000E.quest_subtitle: "餐厅大厅"
	quest.1A0000000000000E.quest_desc: [
		"市民没有食物就会饥饿和不开心。 &6厨师&r将生食材变成饭菜，为大家服务。"
		"保持厨师的农场和鱼类产出充足，整个殖民地就能吃饱。"
		"&c饥饿的公民工作效率低，还可能离开——别忽视这一点。&r"
	]
	quest.1A0000000000000F.title: "建造一个面包店"
	quest.1A0000000000000F.quest_subtitle: "面包和更美味的餐点"
	quest.1A0000000000000F.quest_desc: [
		"&6面包师&r将小麦变成面包和烘焙食品，为你的食物增添多样性。"
		"多样化的饮食能让村民比日复一日的同一餐更快乐。"
		"靠你农场的小麦为生。"
	]
	quest.1A00000000000010.title: "饲养牲畜"
	quest.1A00000000000010.quest_subtitle: "牛仔、牧羊人、猪倌、养鸡人、兔笼"
	quest.1A00000000000010.quest_desc: [
		"动物饲养员会饲养牛、羊、猪、鸡和兔子，为你提供肉、羊毛、皮革、鸡蛋和牛奶，无需你动手。"
		"建造所有五个牧民小屋（包括兔笼）即可完成此任务。"
		"&7Wool and leather also feed your crafters.&r"
	]
	quest.1A00000000000011.title: "砍伐木材"
	quest.1A00000000000011.quest_subtitle: "护林员的木屋"
	quest.1A00000000000011.quest_desc: [
		"&6Forester&r会砍伐树木并重新种植，确保木材供应源源不断。"
		"木材能为锯木厂和几乎所有早期建筑提供燃料。"
		"给他们一把斧头和一片森林，让他们去工作。"
	]
	quest.1A00000000000012.title: "挖掘一个矿井"
	quest.1A00000000000012.quest_subtitle: "矿石和石头"
	quest.1A00000000000012.quest_desc: [
		"&6矿工&r会挖掘一条合适的竖井，并运出石头、煤炭和矿石。"
		"它们的产出会供给 Stonemason 和 Smeltery。"
		"升级矿井，以到达更深、更富有的矿层。"
	]
	quest.1A00000000000013.title: "建造一个锯木厂"
	quest.1A00000000000013.quest_subtitle: "木材变成木板和零件"
	quest.1A00000000000013.quest_desc: [
		"&6锯木场&r用林业匠的木材制作一切木制物品——木板、木棍、工具、家具部件。"
		"许多建筑材料请求都可以在这里得到满足。"
		"&7Pairs with the Forester.&r"
	]
	quest.1A00000000000014.title: "建造一个石匠小屋"
	quest.1A00000000000014.quest_subtitle: "将石头变成建筑材料"
	quest.1A00000000000014.quest_desc: [
		"&6石匠&r将矿工开采的石头塑造成砖块、石板、台阶和装饰方块。"
		"许多建筑升级都需要加工过的石头——这间小屋能持续供应。"
		"&7Pairs with the Mine.&r"
	]
	quest.1A00000000000015.title: "建造一个铁匠小屋"
	quest.1A00000000000015.quest_subtitle: "工具和盔甲"
	quest.1A00000000000015.quest_desc: [
		"&6铁匠&r会锻造工人和守卫所需的金属工具和盔甲。"
		"随着建筑的升级，它们需要更好的工具——铁匠会满足这些要求。"
		"需要来自熔炼炉的金属。"
	]
	quest.1A00000000000016.title: "建造一个熔炉（Smeltery）"
	quest.1A00000000000016.quest_subtitle: "将矿石熔炼成锭"
	quest.1A00000000000016.quest_desc: [
		"&6熔炉&r将矿工矿石批量熔炼成锭，为铁匠和机械师提供材料。"
		"随着殖民地的发展，这是金属供应的核心。"
		"用矿石和燃料保持饱腹感。"
	]
	quest.1A00000000000017.title: "派遣一名守卫去巡逻这片区域。"
	quest.1A00000000000017.quest_subtitle: "你的第一位守卫者"
	quest.1A00000000000017.quest_desc: [
		"&6Guard Tower&r会指派一名公民担任守卫，负责巡逻并击退怪物和掠夺者。"
		"守卫会积累经验并升级装备——请保持他们的武装和防护。"
		"建造塔楼以覆盖你的殖民地边缘。"
	]
	quest.1A00000000000018.title: "建造兵营 Barracks"
	quest.1A00000000000018.quest_subtitle: "一个合适的驻军营地"
	quest.1A00000000000018.quest_desc: [
		"&6兵营&r将多个守卫安置在一个升级后的建筑中，并成为你防御的锚点。"
		"附带了可以建造以提供全面覆盖的兵营塔楼。"
		"抵御掠夺者袭击的殖民地的支柱。"
	]
	quest.1A00000000000019.title: "训练你的部队"
	quest.1A00000000000019.quest_subtitle: "弓箭手和骑士们"
	quest.1A00000000000019.quest_desc: [
		"&6Combat Academy&r 训练近战骑士；&6Archery&r 训练远程守卫。"
		"建造两者以获得均衡的防御——弓箭手削弱掠夺者，骑士坚守阵地。"
		"分配公民并为他们装备物品。"
	]
	quest.1A0000000000001A.title: "在袭击中存活下来"
	quest.1A0000000000001A.quest_subtitle: "保卫殖民地"
	quest.1A0000000000001A.quest_desc: [
		"袭击会按计划袭击你的殖民地——野蛮人、海盗，或者更糟的，取决于你建造的位置。"
		"召集你的守卫（&eRallying Banner&r会吸引他们前来）并坚守阵地。"
		"击败10名掠夺者，证明你的防御工事坚不可摧。"
		"&a奖励：从殖民地商店挑选一件物品。&r"
	]
	quest.1A0000000000001B.title: "设置物流系统"
	quest.1A0000000000001B.quest_subtitle: "仓库与快递员"
	quest.1A0000000000001B.quest_desc: [
		"&6仓库&r储存着殖民地共享的物资；&6信使&r会自动在棚屋和仓库之间运输物品。"
		"它们能阻止建造者和工匠因等待材料而无所事事。"
		"&e对于不断壮大的殖民地来说，这是最大的生活质量提升。&r"
	]
	quest.1A0000000000001C.title: "建造一座大学"
	quest.1A0000000000001C.quest_subtitle: "解锁研究内容"
	quest.1A0000000000001C.quest_desc: [
		"&6大学&r能让你研究殖民地范围的升级——更快的工人、更强的守卫、更好的工具等等。"
		"研究需要时间和材料，但增益效果是永久性的。"
		"分配研究人员来加快进度。"
	]
	quest.1A0000000000001D.title: "建造一座图书馆"
	quest.1A0000000000001D.quest_subtitle: "让你的居民变得更强大"
	quest.1A0000000000001D.quest_desc: [
		"图书馆的学者会随着时间的推移提升你市民的技能。"
		"更聪明的市民工作效率更高，产量更大。"
		"&7Pairs with the University's research.&r"
	]
	quest.1A0000000000001E.title: "建造一家医院"
	quest.1A0000000000001E.quest_subtitle: "治愈病人和受伤的人"
	quest.1A0000000000001E.quest_desc: [
		"市民会受伤生病——&6医院&r会为他们治疗，让他们康复而不是死亡。"
		"这里的治愈者会救你，替换掉失去的工人。"
		"用他所需要的药品把它装满。"
	]
	quest.1A0000000000001F.title: "建造一所学校"
	quest.1A0000000000001F.quest_subtitle: "培养技艺高超的孩子们"
	quest.1A0000000000001F.quest_desc: [
		"在&6学校&r里，小公民们向老师学习，成长为更优秀的成年人。"
		"受过教育的孩子们职业生涯起步更快。"
		"从内部培养你殖民地的人才。"
	]
	quest.1A00000000000020.title: "建造一个神秘之地"
	quest.1A00000000000020.quest_subtitle: "幸福感提升效果"
	quest.1A00000000000020.quest_desc: [
		"&6Mystical Site&r 是一座可以提升殖民地幸福度的装饰性建筑。"
		"快乐的殖民地工作效率更高，招募更容易，在压力下也能保持稳定。"
		"&7一场简单又廉价的士气胜利。&r"
	]
	task.3A00000000000005.title: "建造市政厅"
	task.3A00000000000006.title: "明白了！"
	task.3A00000000000009.title: "接触5名村民"
	task.3A0000000000000A.title: "接触10名村民"
	task.3A0000000000000B.title: "招募 25 名村民"
	task.3A00000000000010.title: "建造全部五个牧民小屋"
	task.3A0000000000001A.title: "击败 10 名掠夺者"
	task.3A00000000000020.title: "建造神秘遗迹 (Mystical Site)"
	chapter.57A2320197D49E1E.title: "入门指南"
	chapter.57A2320197D49E1E.chapter_subtitle: [
		"欢迎来到《古代王国4》——你是谁，如何生存，你的故事将走向何方。"
	]
	chapter.5451511F844F25F9.title: "冰与火"
	chapter.5451511F844F25F9.chapter_subtitle: [
		"完整的龙指南：狩猎、采集、驯养、龙钢——以及模组中的其他所有生物。"
	]
	file.0000000000000001.title: "&6远古王国4"
	chapter_group.79D363442938A3A7.title: "&6你的王国"
	chapter_group.208F5E79BC73D0EC.title: "&5魔法之路 (Paths of Magic)"
	chapter_group.62E8BD0CEEC916F5.title: "&c英雄之旅"
	reward_table.00000000CAFEBABE.title: "探险者宝藏 (Explorer's Cache)"
	reward_table.00000000C0FFEE00.title: "王国战利品"
	reward_table.00000000DEADBEEF.title: "龙之宝藏"
	quest.4D00000000000001.title: "欢迎来到古代王国 (Ancient Kingdoms)"
	quest.4D00000000000001.quest_subtitle: "你的故事将从这里开始"
	quest.4D00000000000001.quest_desc: [
		"&6Ancient Kingdoms 4&r 是一个中世纪王国，拥有三大使命：用 &6MineColonies&r 建立活生生的殖民地，精通四种 &5魔法&r，并狩猎统治荒野的 &c巨龙和怪物&r。"
		""
		"这本书是你的指南。章节列在左侧，按路径分组。完成的任务会给予奖励——&e在任务页面上点击它们以领取&r。像这样的任务只是简单的复选框：读完就打勾。"
	]
	task.6D00000000000001.title: "明白了！"
	quest.4D00000000000009.title: "你的起源与阶级"
	quest.4D00000000000009.quest_subtitle: "你是谁，以及你做了什么"
	quest.4D00000000000009.quest_desc: [
		"你初次醒来时，选择了&e起源&r（你的&o本质&r——鸟类滑翔，蜘蛛攀爬，烈焰人免疫火焰，人鱼呼吸水下）和&e职业&r（你的&o职责&r——弓箭手、狂战士、铁匠、牧师、厨师、探险家等）。"
		""
		"随时查看你的能力：打开&e物品栏&r，寻找&eOrigins按钮&r，或在&e选项 > 控制&r中查看“查看起源”的按键绑定。每个能力的工具提示都说明了具体作用——在规划建造前值得一读。"
	]
	task.6D00000000000009.title: "明白了！"
	quest.4D00000000000007.title: "你的第一个夜晚"
	quest.4D00000000000007.quest_subtitle: "日落前找到庇护所"
	quest.4D00000000000007.quest_desc: [
		"旧规则依然适用：在天黑前获取木材、建造庇护所、获得光源——这里的怪物比记忆中更凶恶。"
		""
		"检查你的物品栏：&e职业给了你一套新手包&r，帮你跳过第一天最难的阶段。还有一张床和一些火把也放在房子里了。"
	]
	task.6D00000000000007.title: "明白了！"
	quest.4D0000000000000A.title: "龙之阴影"
	quest.4D0000000000000A.quest_subtitle: "这里住着一个大家伙"
	quest.4D0000000000000A.quest_desc: [
		"看到那道划过太阳的阴影了吗？&c这片疆域属于巨龙&r——从幼龙到能夷平森林的远古泰坦，掌控着火焰、寒冰与闪电。"
		""
		"早期：&e远离巢穴&r。从地牢宝箱中收集&e手稿&r，先了解你的敌人。准备好狩猎后，&c此处有龙&r章节会引导你从第一本 bestiary 到一把龙钢剑——以及一条属于自己的龙。"
	]
	task.6D0000000000000A.title: "明白了！"
	quest.4D0000000000000B.title: "一个王国在等待着你"
	quest.4D0000000000000B.quest_subtitle: "你无法独自完成建造工作"
	quest.4D0000000000000B.quest_desc: [
		"You weren't meant to carry this realm on your back. &6MineColonies&r lets you found a real colony — citizens with names and jobs, builders who raise your city, farmers, guards and couriers."
		""
		"始于简陋的&e补给营地&r，终于设防的首都。准备好统治后，开启&6王冠特许状&r章节。"
	]
	task.6D0000000000000B.title: "明白了！"
	quest.4D00000000000006.title: "选择你的道路"
	quest.4D00000000000006.quest_subtitle: "统治者、魔法师，还是怪物猎人？"
	quest.4D00000000000006.quest_desc: [
		"你已安顿下来，世界向你敞开。三条道路在等待着你："
		""
		"&6你的王国&r — 找到你的殖民地，在这片土地上安居乐业。"
		"&5魔法之路&r — 四种魔法学派，四种代价。"
		"&c英雄之旅&r — 屠龙、锻造装备、探索深渊与遗迹。"
		""
		"没有错误的顺序。全部走一遍——并在&eTools of the Trade&r中查找能让每条路都更顺畅的生活质量工具包。"
	]
	task.6D00000000000006.title: "明白了！"
	quest.4D00000000000008.title: "王国的指令 (Commands of the Realm)"
	quest.4D00000000000008.quest_subtitle: "给每个人的小魔法"
	quest.4D00000000000008.quest_desc: [
		"几个实用的命令对所有旅行者都适用——在聊天框中输入这些："
		""
		"&e/sethome&r 和 &e/home&r — 标记并返回你的基地。"
		"&e/rtp&r — 传送到某个随机又狂野的地方。"
		"&e/back&r — 返回你上次传送（或死亡）的位置。"
		"&e/tpa <player>&r — 请求传送到好友身边。"
	]
	task.6D00000000000008.title: "明白了！"
	quest.4D0000000000000C.title: "加入王国 (Join the Realm)"
	quest.4D0000000000000C.quest_subtitle: "冒险家招募中"
	quest.4D0000000000000C.quest_desc: [
		"问题、截图、王国吹牛权——社区在 Discord 上活跃着："
		""
		"&9&nhttps://discord.gg/duNgHhPB7&r"
	]
	task.6D0000000000000C.title: "打个招呼吧"
	quest.4D0000000000000D.title: "当事情出错时"
	quest.4D0000000000000D.quest_subtitle: "即使是传奇人物也会遇到bug"
	quest.4D0000000000000D.quest_desc: [
		"大型整合包就像一座小城——有时水管会爆裂。"
		""
		"&e游戏卡顿？&r加载后等一分钟；首次启动总是最卡的。"
		"&e崩溃了？&r启动器会记录日志——报告问题时请分享最新的日志。"
		"&e发现 bug 了？&r请在 CurseForge 页面或 Discord 中报告，并说明你当时在做什么。"
	]
	task.6D0000000000000D.title: "明白了！"
	quest.1C00000000000001.title: "手稿"
	quest.1C00000000000001.quest_subtitle: "冰与火的研究材料"
	quest.1C00000000000001.quest_desc: [
		"&e手稿&r是冰与火的货币。你可以在世界中的&e龙巢、独眼巨人洞穴、墓地和战斗塔&r里找到它们。"
		""
		"你需要它们来解锁图鉴的页面。 &7“入门指南”已经给了你几个作为开始——之后找到的一切都要拿上。&r"
	]
	task.3C00000000000001.title: "收集 3 份手稿"
	quest.1C00000000000002.title: "生物图鉴 (The Bestiary)"
	quest.1C00000000000002.quest_subtitle: "该模组的指南手册"
	quest.1C00000000000002.quest_desc: [
		"&e图鉴&r（由3份手稿合成）是冰与火模组的游戏内百科全书。"
		""
		"&e如何解锁页面：&r将生物图鉴放置在&e讲台&r中，并向其投入手稿——每份手稿都会教授一个随机的新生物条目。条目涵盖本章中所有生物的生成地点、掉落物和战斗机制。"
	]
	quest.1C00000000000003.title: "找到一个巢穴 Roost"
	quest.1C00000000000003.quest_subtitle: "火焰所在之处即为目的地"
	quest.1C00000000000003.quest_desc: [
		"龙会出现在两种巢穴中："
		""
		"&e地表巢穴&r — 丘陵，1-3阶的龙在小宝藏上空盘旋。你的首个目标。"
		"&e地下洞穴&r — 大型洞穴巢穴，内有四阶段龙和丰厚宝藏。火龙偏爱炎热生物群系，冰龙偏爱寒冷生物群系，雷龙偏爱湿润生物群系。"
	]
	task.3C00000000000003.title: "发现一个火龙巢穴"
	quest.1C00000000000004.title: "击杀一只火龙"
	quest.1C00000000000004.quest_subtitle: "在它烧毁战利品之前把它干掉"
	quest.1C00000000000004.quest_desc: [
		"&c火龙&r会喷吐能点燃地形并熔化你护甲的火焰。"
		""
		"&e提示：&r 防火药水能抵消大部分危险。保持在地面战斗——攻击翅膀和身体会迫使其降落。不要站在火线上，要围绕它移动。"
		""
		"&7掉落物：鳞片、骨头、头骨和可装瓶的血液。尸体保留——收集所有物品。&r"
	]
	task.3C00000000000004.title: "击杀一只火龙"
	quest.1C00000000000005.title: "击杀一只冰龙"
	quest.1C00000000000005.quest_subtitle: "冰冻的呼吸，将一切冻结在瞬间"
	quest.1C00000000000005.quest_desc: [
		"&b冰龙&r若吐息命中，会将你困在冰块中——在它瞄准下一次攻击时保持静止。"
		""
		"&e提示：&r左右移动，不要暴露在视野中，快打破冰块（用拳头）。力量药水能大幅缩短战斗时间。"
	]
	task.3C00000000000005.title: "击杀一只冰龙"
	quest.1C00000000000006.title: "击杀一只闪电巨龙"
	quest.1C00000000000006.quest_subtitle: "风暴之息"
	quest.1C00000000000006.quest_desc: [
		"&e闪电巨龙&r会释放能穿透盔甲的闪电，将你击飞——坠落伤害能减轻一半。"
		""
		"&e提示：&r使用羽毛坠落装置或缓降药水可以克制它们的最佳技巧。它们比其他品种飞得更高，强弓会有所帮助。"
	]
	task.3C00000000000006.title: "击杀一只闪电巨龙"
	quest.1C00000000000007.title: "龙骨 (Dragon Bone)"
	quest.1C00000000000007.quest_subtitle: "收割骷髅的掉落物"
	quest.1C00000000000007.quest_desc: [
		"分解龙尸以收集&e龙骨&r——最强前龙钢武器的材料。"
		""
		"&79 块骨头能覆盖一把剑和一把弓。更大的龙会掉落更多。&r"
	]
	task.3C00000000000007.title: "收集 9 个龙之骨"
	quest.1C00000000000008.title: "龙骨剑"
	quest.1C00000000000008.quest_subtitle: "比钻石还要好"
	quest.1C00000000000008.quest_desc: [
		"&e龙骨工具和武器&r的配方与原版相同，只是用龙骨代替木棍+材料——而且剑的伤害比钻石剑还高。"
		""
		"全套装备：剑、弓、镐、斧、铲子、锄头。"
	]
	quest.1C00000000000009.title: "血液与心脏"
	quest.1C00000000000009.quest_subtitle: "珍贵的器官组织样本"
	quest.1C00000000000009.quest_desc: [
		"两种你永远不该浪费的掉落物："
		""
		"&c龙之血&r — 在尸体上使用空瓶。锻造龙之熔炉和火焰附魔武器所必需。"
		"&c龙之心脏&r — 一种用于顶级合成的稀有尸体产物。"
	]
	quest.1C0000000000000A.title: "偷一个蛋"
	quest.1C0000000000000A.quest_subtitle: "从4级及以上雌性生物处获得"
	quest.1C0000000000000A.quest_desc: [
		"&e龙蛋&r在击杀&e4-5阶雌龙&r时掉落——多在地下洞穴中。检查尸体和宝藏。"
		""
		"每种颜色的蛋都会孵化出对应颜色的龙，它将属于&e你&r。"
	]
	task.3C0000000000000A.title: "获得一枚末地水晶蛋"
	quest.1C0000000000000B.title: "龙之食粮"
	quest.1C0000000000000B.quest_subtitle: "促进生长的食物"
	quest.1C0000000000000B.quest_desc: [
		"&e龙之食&r（肉+骨粉）是培育你龙的方式——每餐都会让它成长并恢复健康。"
		""
		"在&e3阶段&r，你可以骑乘它，它会和你一起飞翔。继续喂食：手养到5阶段的它会成为族群中最强的盟友。"
	]
	task.3C0000000000000B.title: "合成4份龙之饲料"
	quest.1C0000000000000C.title: "龙之指令模组"
	quest.1C0000000000000C.quest_subtitle: "法杖、号角和长笛"
	quest.1C0000000000000C.quest_desc: [
		"每位驯龙者都需要的三种工具："
		""
		"&e龙之杖&r — 右键点击你的龙以设置游荡/坐下/护送命令。"
		"&e龙之角&r — 将你的龙存储为物品。袖珍级大灾难。"
		"&e龙之笛&r — 召唤你的飞行巨龙降临。"
	]
	task.3C0000000000000C.title: "制作一把龙之法杖"
	task.3C0000000000000D.title: "合成一个龙之角 (Craft a Dragon Horn)"
	quest.1C0000000000000D.title: "建造龙之锻造炉"
	quest.1C0000000000000D.quest_subtitle: "多区块熔炉"
	quest.1C0000000000000D.quest_desc: [
		"&eDragonforge&r 是一种多方块熔炉，可将铁和龙血熔炼成龙钢。砖块由石头和龙骨制成；核心是控制器。"
		""
		"核心是&e非激活&r状态制作的——只有当周围的砖块外壳正确建造完成后，它才会被唤醒。"
		""
		"&e注意：&r只有&c龙息&r才能加热。把它建在你驯服的龙能喷到的地方——或者，如果你喜欢赌博，也可以建在野生龙能喷到的地方。"
	]
	task.3C0000000000000E.title: "合成 8 个 Dragonforge Bricks"
	task.3C0000000000000F.title: "制作一个 Dragonforge Core"
	quest.1C0000000000000E.title: "Dragonsteel"
	quest.1C0000000000000E.quest_subtitle: "终局金属"
	quest.1C0000000000000E.quest_desc: [
		"将&e铁锭 + 火龙血&r投入燃烧的熔炉中，以熔炼&e龙钢锭&r。"
		""
		"龙钢装备是冰与火中最强的——超越下界合金。每种血系的血液都能锻造出具有相应特性的独特钢种。"
	]
	quest.1C0000000000000F.title: "Dragonsteel Arsenal"
	quest.1C0000000000000F.quest_subtitle: "最终阶段"
	quest.1C0000000000000F.quest_desc: [
		"锻造&e龙钢剑&r——伤害巨高，每次击中还能附加灼烧效果。"
		""
		"完整的龙钢套装（盔甲、工具、武器）是本模组提供的最佳装备。从此之后，世间万物都无法超越你。"
	]
	quest.1C00000000000010.title: "科莫多巨蜥"
	quest.1C00000000000010.quest_subtitle: "死亡凝视（The death stare）"
	quest.1C00000000000010.quest_desc: [
		"&e科卡特里斯&r会石化任何被它们盯上的东西——包括透过你的盾牌。"
		""
		"&e计数器：&r 断绝视线，从侧面拉近距离，并从背后发起攻击。会掉落&e科卡特里斯之眼&r，一种能提升攻击力的护身符。"
	]
	quest.1C00000000000011.title: "巨魔（Trolls）"
	quest.1C00000000000011.quest_subtitle: "洞穴残暴者"
	quest.1C00000000000011.quest_desc: [
		"&eTrolls&r 会生成在洞穴和桥下，挥舞着能将你击飞的木棍。"
		""
		"&e计数器：&r日光会将它们变成石头。掉落物：&e巨魔獠牙&r和它们的武器——巨魔武器是早期的强力棍棒。"
	]
	quest.1C00000000000012.title: "独眼巨人"
	quest.1C00000000000012.quest_subtitle: "牧羊人巨人"
	quest.1C00000000000012.quest_desc: [
		"&e独眼巨人&r在岩石岛上放羊，并把玩家像苍蝇一样拍走。它们的抓取攻击会无视你的护甲。"
		""
		"&e对策：&r射击眼睛——爆头会使其失衡。切勿在开阔的近距离作战。"
	]
	task.3C00000000000014.title: "击杀一个独眼巨人（Cyclops）"
	quest.1C00000000000013.title: "海蛇军团"
	quest.1C00000000000013.quest_subtitle: "七种颜色，三种尺寸"
	quest.1C00000000000013.quest_desc: [
		"&3海蛇&r在深海巡逻，一见到船就会攻击。"
		""
		"&e注意：&r在船甲板或岸边战斗，不要下水——它们的游泳速度比你快。掉落&e牙齿和鳞片&r，可用于制作三叉戟和海洋盔甲。"
	]
	quest.1C00000000000014.title: "海妖（Sirens）"
	quest.1C00000000000014.quest_subtitle: "先制作耳塞吧"
	quest.1C00000000000014.quest_desc: [
		"&d塞壬&r会魅惑你，把你拖入水中溺死。它们的歌声会控制你的视角——你会不由自主地走向它们。"
		""
		"&e对策：&r制作&e耳塞&r（两块木板并排），佩戴在奇物栏中即可完全屏蔽歌声。然后去挑战他们，夺取&e海妖之泪&r。"
	]
	quest.1C00000000000015.title: "九头蛇（The Hydra）"
	quest.1C00000000000015.quest_subtitle: "九个麻烦的头颅"
	quest.1C00000000000015.quest_desc: [
		"The &2Hydra&r regrows any head you cut — unless the stump is &eburned&r."
		""
		"&e计数器：&r以火相克：火焰附魔武器、火属性或火焰龙骨剑可阻止再生。毒液吐息是其远程威胁，盾牌可格挡。"
	]
	task.3C00000000000017.title: "击杀一只九头蛇（Hydra）"
	quest.1C00000000000016.title: "戈尔贡（Gorgon）"
	quest.1C00000000000016.quest_subtitle: "永远不要直视她的眼睛"
	quest.1C00000000000016.quest_desc: [
		"&eGorgon&r 在她的丛林神庙里等着。对视 = 立刻变成石像。说的就是你。"
		""
		"&e对策：&r戴上&e眼罩&r（奇物栏）就能安全地与她战斗——失明总比石化要好。她的头是一个能将敌人石化的武器。"
	]
	task.3C00000000000018.title: "找到一个戈尔贡神庙"
	task.3C00000000000019.title: "击杀戈尔贡（Gorgon）"
	quest.1C00000000000017.title: "小精灵们"
	quest.1C00000000000017.quest_subtitle: "小贼大价值"
	quest.1C00000000000017.quest_desc: [
		"&dPixies&r 住在蘑菇圈村庄里，会偷窃熟睡玩家的物品。"
		""
		"&e值得狩猎：&r仙女尘能酿造飞行和幸运药水，而罐装仙女既是灯盏又是幸运符。"
	]
	task.3C0000000000001A.title: "找到一个仙女村庄"
	task.3C0000000000001B.title: "获取仙女粉尘 (Pixie Dust)"
	quest.1C00000000000018.title: "恐怖的女王"
	quest.1C00000000000018.quest_subtitle: "冰与火的最终首领"
	quest.1C00000000000018.quest_desc: [
		"&5Dread Queen&r统治着一座冰冻的堡垒，并豢养着可怕的军团——她杀死的每一个生物都会加入她的军队。"
		""
		"&e计数器：&r带上龙钢、治疗物资，并快速削弱她的召唤物——战斗难度随你放任她的军队成长而提升。这是此世界最艰难的战斗，也是最好的战利品。"
	]
	task.3C0000000000001C.title: "击败恐惧女王"
	quest.1C00000000000019.title: "驯服一只狮鹫鹰"
	quest.1C00000000000019.quest_subtitle: "悬崖传单"
	quest.1C00000000000019.quest_desc: [
		"&e狮鹫&r栖息于山崖。喂它一个&e兔脚&r即可驯服——这样在龙长大之前，你就能给它装上鞍具和盔甲，翱翔天际了。"
		""
		"&7它们会俯冲捕猎猎物，并且适合圈养在围栏里。&r"
	]
	task.3C0000000000001D.title: "制作任意一件龙鳞盔甲部件"
	quest.1C0000000000001A.title: "驯服一只安菲特雷（Amphithere）"
	quest.1C0000000000001A.quest_subtitle: "丛林巨蛇"
	quest.1C0000000000001A.quest_desc: [
		"&2Amphitheres&r 翱翔于丛林之上。驯服方法：&e在飞行途中骑上并抓紧&r，直到它屈服为止。"
		""
		"打破后无需鞍具——勇敢者的免费飞行坐骑。"
	]
	task.3C0000000000001E.title: "锻造一把附魔的龙骨剑"
	quest.1C0000000000001B.title: "死亡蠕虫"
	quest.1C0000000000001B.quest_subtitle: "沙漠伏击者"
	quest.1C0000000000001B.quest_desc: [
		"&e死亡蠕虫&r会游过沙漠沙子，并从你脚下突然冒出。"
		""
		"&e对策：&r注意移动的沙痕，在岩石或硬地上战斗，它们无法潜行。它们的甲壳能制成坚固的盔甲。"
	]
	task.3C0000000000001F.title: "明白了！"
	quest.1C0000000000001C.title: "鬼魂们"
	quest.1C0000000000001C.quest_subtitle: "被诅咒的沉船残骸"
	quest.1C0000000000001C.quest_desc: [
		"&b鬼魂&r会出没于墓地和沉船遗址，穿过墙壁来接近你。"
		""
		"&e计数器：&r它们会受到任何武器的全额伤害——危险在于地形，而非韧性。掉落&e幽灵锭&r，用于制作相位&e幽灵剑&r。"
	]
	task.3C00000000000020.title: "击杀一个幽灵 (Slay a Ghost)"
	task.3C00000000000021.title: "获得一个幽灵锭（Ghost Ingot）"
	quest.1C00000000000020.title: "龙之阶段"
	quest.1C00000000000020.quest_subtitle: "大小 = 危险 = 战利品"
	quest.1C00000000000020.quest_desc: [
		"龙在它们（非常漫长的）一生中会经历 &e5 个阶段&r："
		""
		"&7第1-2阶段：&r幼体和亚成体——可用早期装备击杀。"
		"&e第三阶段：&r成年，能正常飞行和呼吸——带上好盔甲。"
		"&6第4阶段：&r它们守护着地下洞穴，并能掉落&e蛋&r。"
		"&c第5阶段：&r30+ 块泰坦。不要公平地挑战第一只。"
		""
		"更大的龙会掉落更多鳞片、骨头和更好的宝藏战利品。"
	]
	task.3C00000000000022.title: "明白了！"
	task.3C00000000000009.title: "瓶装火龙血"
	task.3C00000000000023.title: "采集一个火龙之心"
	quest.1C00000000000021.title: "龙骨弓"
	quest.1C00000000000021.quest_subtitle: "投石机般的冲击力"
	quest.1C00000000000021.quest_desc: [
		"&e龙骨弓&r的伤害大约是普通弓的两倍，而&e龙骨箭&r则能进一步提升。"
		""
		"这是你在第一阶段与四到五级龙战斗时的推荐武器——在它落地前将其击杀。"
	]
	task.3C00000000000024.title: "制作一把龙骨弓 (Craft a Dragonbone Bow)"
	task.3C00000000000025.title: "合成8支龙骨箭"
	quest.1C0000000000001D.title: "龙之盔甲"
	quest.1C0000000000001D.quest_subtitle: "给你的龙穿上盔甲"
	quest.1C0000000000001D.quest_desc: [
		"驯服一条龙后，要保护好它：制作&e龙甲&r——由金属锭（铁到龙钢）锻造的头、颈、躯干和尾甲。"
		""
		"身穿盔甲的龙在战斗中能抗住更多伤害。任何部件都算数。 &7关于你自己的盔甲，请参见 Dragonsteel Arsenal。&r"
	]
	quest.1C0000000000001E.title: "火焰浸染之刃"
	quest.1C0000000000001E.quest_subtitle: "武器 + 龙之血"
	quest.1C0000000000001E.quest_desc: [
		"在合成台里将&e龙骨剑&r和&c火龙血&r组合，即可锻造出&c火焰龙骨剑&r——它能点燃所有击中的物体。"
		""
		"&7冰和闪电血液以同样的方式制造冰冻和电击变种。&r"
	]
	quest.1C0000000000001F.title: "孵化入门教程 101"
	quest.1C0000000000001F.quest_subtitle: "每种生物都有不同的孵化方式"
	quest.1C0000000000001F.quest_desc: [
		"将鸡蛋放置在合适的条件下，然后等待几分钟："
		""
		"&c火之卵：&r点燃它（它不会燃烧）。"
		"&b冰蛋：&r将其浸入水中。"
		"&e闪电蛋：&r把它放在雨里就行了。"
		""
		"幼崽&e会自动与你建立联系&r——恭喜你，这是一条龙。"
	]
	task.3C00000000000026.title: "制作一个龙之竖笛"
	quest.1C00000000000022.title: "驯服一只海马（Hippocampus）"
	quest.1C00000000000022.quest_subtitle: "海马（The sea horse）"
	quest.1C00000000000022.quest_desc: [
		"&3海马&r游弋在温暖的海洋。用&e海带&r驯服它们，骑上马鞍，比任何船都更快地穿越海洋。"
	]
	task.3C0000000000002C.title: "杀死一条死亡蠕虫"
	task.3C00000000000028.title: "制作耳塞（Craft Earplugs）"
	task.3C00000000000016.title: "获得一个海妖之泪"
	quest.1C00000000000023.title: "潮汐三叉戟"
	quest.1C00000000000023.quest_subtitle: "蛇之锻造"
	quest.1C00000000000023.quest_desc: [
		"用海蛇的獠牙和鳞片锻造&3Tide Trident&r——比普通三叉戟更强，而且无需Riptide就能返回。"
	]
	task.6B00000000000002.title: "进入地下花园 (Undergarden)"
	task.6B00000000000003.title: "Mine 32 深度岩层"
	task.6B0000000000000D.title: "发现一个枯竭的废弃矿井"
	task.6B0000000000000E.title: "找到一个定居者营地"
	task.6B00000000000008.title: "熔炼 3 个 Cloggrum 锭"
	task.6B00000000000009.title: "熔炼 3 个 Froststeel 锭"
	task.6B00000000000012.title: "击杀 3 个残暴者"
	task.6B00000000000013.title: "击杀一只腐化生物"
	task.6B0000000000000B.title: "探索地下墓穴 (Catacombs)"
	task.6B0000000000000C.title: "击败被遗忘的守护者 (Slay the Forgotten Guardian)"
