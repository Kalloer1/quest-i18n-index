	task.0F00000000000003.title: "找到一个掠夺者前哨基地"
	task.0F0000000000000C.title: "找到一个制图师塔 (Cartographer's Tower)"
	task.0F00000000000004.title: "发现一处城堡遗迹"
	task.0F00000000000005.title: "发现一座城堡"
	task.0F00000000000006.title: "找到一个女巫小屋"
	task.0F00000000000007.title: "进入红杉林 (Enter the Redwoods)"
	task.0F00000000000008.title: "进入沼泽地（Enter the Bayou）"
