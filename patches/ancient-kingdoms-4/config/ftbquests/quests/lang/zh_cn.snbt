	task.0F00000000000029.title: "进入一片秋日的枫树林中"
	task.0F0000000000002B.title: "进入桉树林中"
	chapter.60DE000000000004.title: "忙碌的蜜蜂们"
	chapter.60DE000000000004.chapter_subtitle: [
		"数百种特化蜜蜂，在你统治的同时收集金属、宝石和魔法。"
	]
	quest.4E00000000000001.title: "养蜂入门 101"
	quest.4E00000000000001.quest_subtitle: "蜂巢之心"
	quest.4E00000000000001.quest_desc: [
		"&6Productive Bees&r将原版游戏中的单一蜜蜂变成了数百种特化品种，在你睡觉时收集金属、宝石和魔法。"
		"一切由此展开：捕捉野生蜜蜂，为它们筑巢，采集蜂巢，培育出更强大的蜜蜂。沿着蛛网的任意分支前进。"
		"&e先制作一个高级蜂箱吧。&r"
	]
	task.4F00000000000001.title: "获取《养蜂入门 101》"
	quest.4E00000000000002.title: "巢穴定位器"
	quest.4E00000000000002.quest_subtitle: "指明方向"
	quest.4E00000000000002.quest_desc: [
		"&6Nest Locator&r 会嗅出附近的野生蜜蜂巢穴。右键点击可标记最近的巢穴。"
		"野生蜂巢隐藏在各地的树木、洞穴和生物群系中——每个蜂巢都住着一只不同的蜜蜂。"
	]
	task.4F00000000000002.title: "获取巢穴定位器 Nest Locator"
	quest.4E00000000000003.title: "蜜蜂笼"
	quest.4E00000000000003.quest_subtitle: "捕捉并携带物品，将其放入背包中。"
	quest.4E00000000000003.quest_desc: [
		"一个&6蜜蜂笼&r可以把蜜蜂从巢里捉出来，这样你就能把它带回家了。"
		"右键蜜蜂可将其困住，右键蜂巢可将其释放到内部。"
	]
	task.4F00000000000003.title: "获取蜜蜂笼 (Bee Cage)"
	quest.4E00000000000004.title: "坚固的蜜蜂笼"
	quest.4E00000000000004.quest_subtitle: "可重复使用的捕捉装置"
	quest.4E00000000000004.quest_desc: [
		"&6坚固的蜂笼&r和纸笼一样，但不会损坏，所以你可以反复迁移蜜蜂。"
	]
	task.4F00000000000004.title: "获得坚固的蜜蜂笼 Sturdy Bee Cage"
	quest.4E00000000000005.title: "蜜蜂瓶"
	quest.4E00000000000005.quest_subtitle: "向它们炫耀一下吧"
	quest.4E00000000000005.quest_desc: [
		"&6蜜蜂瓶&r可将捕获的蜜蜂展示在架子上——方便在不丢失的情况下储存未使用的繁殖蜜蜂。"
	]
	task.4F00000000000005.title: "获取蜜蜂瓶"
	quest.4E00000000000007.title: "扩展箱 Expansion Box"
	quest.4E00000000000007.quest_subtitle: "成长的空间，无限可能"
	quest.4E00000000000007.quest_desc: [
		"将&6Expansion Box&r堆叠在蜂巢顶部以增加槽位——在相同占地面积内容纳更多蜜蜂和蜂巢。"
	]
	task.4F00000000000007.title: "获取扩展箱 (Obtain Expansion Box)"
	quest.4E00000000000008.title: "画布蜂巢"
	quest.4E00000000000008.quest_subtitle: "任何木材，任何外观都可以"
	quest.4E00000000000008.quest_desc: [
		"&6画布蜂巢&r可以涂成任何木材或方块的颜色——纯装饰，功能和高级蜂箱完全一样。"
	]
	task.4F00000000000008.title: "获取画布蜂巢 Canvas Hive"
	quest.4E00000000000009.title: "喂食石板"
	quest.4E00000000000009.quest_subtitle: "让它们吃饱肚子"
	quest.4E00000000000009.quest_desc: [
		"在蜂巢下放置一个&6Feeding Slab&r，并用花朵或植物填满，这样蜜蜂就能在没有花园的情况下持续产蜜。"
	]
	task.4F00000000000009.title: "获取喂食石板 Feeding Slab"
	quest.4E0000000000000A.title: "离心机"
	quest.4E0000000000000A.quest_subtitle: "把梳子打碎"
	quest.4E0000000000000A.quest_desc: [
		"&6离心机&r能将蜂巢旋转分离，产出蜂蜜、蜂蜡和蜜蜂的特产（金块、粉末、宝石）。"
		"手动摇杆启动；所有蜂巢都先放这里。"
	]
	task.4F0000000000000A.title: "获取离心机 Centrifuge"
	quest.4E0000000000000B.title: "装瓶器"
	quest.4E0000000000000B.quest_subtitle: "把蜂蜜装进瓶子里面去"
	quest.4E0000000000000B.quest_desc: [
		"&6Bottler&r 会从相邻的蜂巢或储罐中填充蜂蜜，无需手动右键蜂巢即可自动化制作蜂蜜瓶。"
	]
	task.4F0000000000000B.title: "获取瓶装瓶器（Bottler）"
	quest.4E0000000000000C.title: "加热离心机"
	quest.4E0000000000000C.quest_subtitle: "更快，解放双手"
	quest.4E0000000000000C.quest_desc: [
		"&6加热离心机&r用熔炉燃料代替人力——喂它煤炭，它就会自动处理梳子。"
	]
	task.4F0000000000000C.title: "获取加热离心机 Heated Centrifuge"
	quest.4E0000000000000D.title: "动力离心机"
	quest.4E0000000000000D.quest_subtitle: "全自动化工厂建造指南"
	quest.4E0000000000000D.quest_desc: [
		"&6动力离心机&r消耗Forge能量，全速处理蜂巢——蜂蜜提取的终局阶段。"
	]
	task.4F0000000000000D.title: "获取动力离心机 (Powered Centrifuge)"
	quest.4E0000000000000F.title: "蜂蜜小点心"
	quest.4E0000000000000F.quest_subtitle: "蜜蜂的食物和贿赂手段"
	quest.4E0000000000000F.quest_desc: [
		"用 &6蜂蜜点心&r 喂养蜜蜂可以触发繁殖，也是下面机器的货币。制作一叠吧——你会用到很多。"
		"&e通往基因学的大门。&r"
	]
	task.4F0000000000000F.title: "获取蜂蜜小点心"
	quest.4E00000000000010.title: "繁殖室"
	quest.4E00000000000010.quest_subtitle: "创造新的生物品种"
	quest.4E00000000000010.quest_desc: [
		"将两只蜜蜂和蜂蜜点心放入&6Breeding Chamber&r进行繁殖。组合正确的蜜蜂会解锁新的特殊蜜蜂（金属、宝石、精华）。"
	]
	task.4F00000000000010.title: "获取繁殖室（Breeding Chamber）"
	quest.4E00000000000011.title: "BaBee 孵化器"
	quest.4E00000000000011.quest_subtitle: "孵化幼崽"
	quest.4E00000000000011.quest_desc: [
		"&6BaBee孵化器&r能快速将幼蜂培育成成蜂，并能复制基因——通往完整蜂群的快捷方式。"
	]
	task.4F00000000000011.title: "获取 BaBee 孵化器"
	quest.4E00000000000012.title: "基因索引器"
	quest.4E00000000000012.quest_subtitle: "读取DNA序列"
	quest.4E00000000000012.quest_desc: [
		"&6基因索引器&r能从蜜蜂体内提取基因并储存起来——生产力、性情、耐力、天气和行为都存在于DNA中。"
	]
	task.4F00000000000012.title: "获取基因索引器 (Gene Indexer)"
	quest.4E00000000000013.title: "被压扁的蜜蜂材料"
	quest.4E00000000000013.quest_subtitle: "瓶装基因学 (Bottled genetics)"
	quest.4E00000000000013.quest_desc: [
		"&6Squashed Bee Material&r 是蜜蜂被杀死后留下的东西——基因研究的原始材料。"
		"用&6离心机&r分离出&6基因样本&r，然后用基因索引器和蜂蜜点心将其特性嫁接到另一只蜜蜂上。"
		"&7这就是建造完美、快速、平静、不知疲倦的蜜蜂的方法。&r"
	]
	task.4F00000000000013.title: "获取压扁的蜜蜂材料"
	quest.4E00000000000014.title: "Treat on a Stick"
	quest.4E00000000000014.quest_subtitle: "带领它们四处走动"
	quest.4E00000000000014.quest_desc: [
		"一根&6棒棒糖&r能吸引蜜蜂跟随你——将一只散养的蜜蜂赶回蜂巢，而无需将其关进笼子里。"
	]
	task.4F00000000000014.title: "获得一根棍子上的诱饵"
	quest.4E00000000000015.title: "下界金巢穴"
	quest.4E00000000000015.quest_subtitle: "下界蜜蜂模组 (Bees of the Nether)"
	quest.4E00000000000015.quest_desc: [
		"每个生物群系都隐藏着独特的野生蜂巢，里面有不同的蜜蜂品种。在&6下界金蜂巢&r中会生成采金蜜蜂——带上坚固的蜂箱和火焰抗性。"
		"&7找到并破坏蜂巢，收集所有种类的蜜蜂。&r"
	]
	task.4F00000000000015.title: "获取下界金巢穴"
	quest.4E00000000000016.title: "石英巢穴"
	quest.4E00000000000016.quest_subtitle: "更为罕见的是，它们会出现在更稀有的物品中，例如："
	quest.4E00000000000016.quest_desc: [
		"&6石英巢穴&r里住着能产出下界石英的蜜蜂。像这样稀有的巢穴，正是你寻找值得繁育的异种蜜蜂的地方。"
	]
	task.4F00000000000016.title: "获取石英巢穴"
	quest.4E00000000000019.title: "橡木鸟巢"
	quest.4E00000000000019.quest_subtitle: "一切开始的地方"
	quest.4E00000000000019.quest_desc: [
		"普通的&6橡木蜂巢&r悬挂在寻常的森林里，里面住着你的第一批野生蜜蜂。"
		"&7巢穴狩猎的入门教程。&r"
	]
	task.4F00000000000019.title: "获取橡木鸟巢 (Obtain Oak Nest)"
	quest.4E0000000000001A.title: "石头巢穴"
	quest.4E0000000000001A.quest_subtitle: "从山丘中挖掘而来"
	quest.4E0000000000001A.quest_desc: [
		"&6石巢&r位于岩石和洞穴中，是居住在石头里的蜜蜂的家。"
	]
	task.4F0000000000001A.title: "获取石头巢穴"
	quest.4E0000000000001B.title: "沙巢"
	quest.4E0000000000001B.quest_subtitle: "沙漠居民"
	quest.4E0000000000001B.quest_desc: [
		"&6沙巢&r会出现在沙漠和海滩，庇护着适应炎热的蜜蜂。"
	]
	task.4F0000000000001B.title: "获取沙巢 Sand Nest"
	quest.4E0000000000001C.title: "芦苇巢穴"
	quest.4E0000000000001C.quest_subtitle: "在水边"
	quest.4E0000000000001C.quest_desc: [
		"&6芦苇巢&r生长在河流和沼泽地带的甘蔗丛中。"
	]
	task.4F0000000000001C.title: "获取芦苇巢穴"
	quest.4E0000000000001D.title: "Glowstone Nest"
	quest.4E0000000000001D.quest_subtitle: "下界之光"
	quest.4E0000000000001D.quest_desc: [
		"&6Glowstone Nest&r 附着在末地天花板，里面住着采集萤石的蜜蜂。"
	]
	task.4F0000000000001D.title: "获取发光石巢穴"
	quest.4E0000000000001E.title: "灵魂沙巢穴"
	quest.4E0000000000001E.quest_subtitle: "来自灵魂山谷的馈赠"
	quest.4E0000000000001E.quest_desc: [
		"&6灵魂沙巢穴&r埋在灵魂沙谷中，栖息着诡异的灵魂蜜蜂。"
	]
	task.4F0000000000001E.title: "获取灵魂沙巢穴"
	quest.4E00000000000017.title: "捕手 The Catcher"
	quest.4E00000000000017.quest_subtitle: "自动捕获"
	quest.4E00000000000017.quest_desc: [
		"&6Catcher&r会自动将进入范围的蜜蜂装入囊中，并产出笼中蜜蜂——实现无人值守的野外采集。"
	]
	task.4F00000000000017.title: "获取捕手 The Catcher"
	quest.4E00000000000018.title: "养蜂大师"
	quest.4E00000000000018.quest_subtitle: "蜂巢可以自行运作"
	quest.4E00000000000018.quest_desc: [
		"有了动力离心机来分解蜂巢，还有繁殖的蜜蜂来填满蜂箱，一台机器就能完成闭环：&6蜂蜜发电机&r燃烧蜂蜜产生Forge Energy，用蜜蜂自己养活整个系统。"
		"制作蜂蜜发电机，建立一个自给自足的蜂场。"
		"&a奖励：一块领地和一件来自王国战利品的工具。&r"
	]
	task.4F00000000000018.title: "制作一个蜂蜜发电机"
	chapter.7BEAB90AA8BC0395.title: "炉火与丰收"
	chapter.7BEAB90AA8BC0395.chapter_subtitle: [
		"种植、烹饪、酿酒——农夫的喜悦与酿酒坊，尽享美好生活。"
	]
	quest.4C00000000000001.title: "厨房已经开启"
	quest.4C00000000000001.quest_subtitle: "每一餐的开始之处"
	quest.4C00000000000001.quest_desc: [
		"&6Farmer's Delight&r将单调的进食变成了真正的烹饪。从一个&6砧板&r开始：放置它，然后用刀在上面将原木切成木板、雕刻肉类和准备食材。"
		"其他一切由此延伸——为你提供食物的农场、你烹饪的菜肴，以及让你杯中常满的葡萄园。"
		"&eSlice something on a cutting board to begin.&r"
	]
	task.6C00000000000001.title: "获取“厨房开启”成就"
	quest.4C00000000000002.title: "烹饪锅 (The Cooking Pot)"
	quest.4C00000000000002.quest_subtitle: "汤、炖菜和高汤类物品"
	quest.4C00000000000002.quest_desc: [
		"&6烹饪锅&r放在热源上，将食材熬煮成营养丰富的汤和炖菜。"
		"投入食材和容器（碗），加热后它就会慢慢煮熟。"
		"&7整合包里的大部分美食都出自这个锅。&r"
	]
	task.6C00000000000002.title: "获取烹饪锅 The Cooking Pot"
	quest.4C00000000000003.title: "煎锅（The Skillet）"
	quest.4C00000000000003.quest_subtitle: "快把它煎熟吧"
	quest.4C00000000000003.quest_desc: [
		"&6煎锅&r能在热源上快速煎制食物——甚至可以随身携带，随时随地烹饪。非常适合煎蛋、肉类和快速餐点。"
	]
	task.6C00000000000003.title: "获取煎锅 The Skillet"
	quest.4C00000000000004.title: "炉子 (The Stove)"
	quest.4C00000000000004.quest_subtitle: "一个像样的炉灶台"
	quest.4C00000000000004.quest_desc: [
		"&6炉灶&r是一种专用加热方块：将煎锅放在上面，或为其添加燃料，即可被动烹饪放置在其上的食物。它是厨房的核心。"
	]
	task.6C00000000000004.title: "获取炉灶 The Stove"
	quest.4C00000000000005.title: "盛宴"
	quest.4C00000000000005.quest_subtitle: "用你自己的田地和藤蔓制作的一餐"
	quest.4C00000000000005.quest_desc: [
		"&6Stuffed Pumpkin&r 是 Farmer's Delight 最宏伟的菜肴——一个装满农场里煮熟作物的完整南瓜。"
		"再配上一瓶用自家葡萄园里的葡萄压榨发酵而成的&6红酒&r。"
		"&eCraft a Stuffed Pumpkin and a Red Wine to finish Hearth and Harvest.&r"
	]
	task.6C00000000000005.title: "制作一个填充南瓜（Stuffed Pumpkin）"
	task.6C00000000000054.title: "装一瓶红葡萄酒"
	quest.4C00000000000006.title: "肥沃的土壤"
	quest.4C00000000000006.quest_subtitle: "让它长得更快一点"
	quest.4C00000000000006.quest_desc: [
		"&6富饶的土壤&r能让作物生长更快，可用有机堆肥制作。高产 Farmer's Delight 花园的基础。"
	]
	task.6C00000000000006.title: "获取富饶的土壤"
	quest.4C00000000000007.title: "西红柿"
	quest.4C00000000000007.quest_subtitle: "藤蔓到铁板"
	quest.4C00000000000007.quest_desc: [
		"种植&6番茄&r种子；成熟的藤蔓会持续产出。酱汁、汤品等的基础食材。"
	]
	task.6C00000000000007.title: "获取番茄"
	quest.4C00000000000008.title: "洋葱"
	quest.4C00000000000008.quest_subtitle: "给所有东西都加上风味"
	quest.4C00000000000008.quest_desc: [
		"&6Onions&r grow from a placed onion and flavor a huge range of dishes — keep a stock going."
	]
	task.6C00000000000008.title: "获取洋葱（Onions）"
	quest.4C00000000000009.title: "卷心菜"
	quest.4C00000000000009.quest_subtitle: "树叶和卷轴"
	quest.4C00000000000009.quest_desc: [
		"&6卷心菜&r能产出沙拉和卷心菜卷的叶子——一种廉价、管饱的早期作物。"
	]
	task.6C00000000000009.title: "获取卷心菜"
	quest.4C0000000000000A.title: "稻田 (Rice Paddies)"
	quest.4C0000000000000A.quest_subtitle: "在浅水中生长"
	quest.4C0000000000000A.quest_desc: [
		"&6稻&r生长在浅水中，晒干后成为稻穗——烹饪和炒米饭菜肴的基础。"
	]
	task.6C0000000000000A.title: "获取水稻田 (Obtain Rice Paddies)"
	quest.4C0000000000000B.title: "一把好刀"
	quest.4C0000000000000B.quest_subtitle: "厨师的工具"
	quest.4C0000000000000B.quest_desc: [
		"&6刀&r可将肉切块、切薄片，还能处理砧板。可从燧石升级到铁、金、钻石或下界合金以提高耐用性。"
	]
	task.6C0000000000000B.title: "获得一把好刀"
	quest.4C0000000000000C.title: "蔬菜汤"
	quest.4C0000000000000C.quest_subtitle: "第一锅炖菜"
	quest.4C0000000000000C.quest_desc: [
		"&6蔬菜汤&r是一道用自家作物制作的简易早期烹饪锅菜肴——管饱又便宜。"
	]
	task.6C0000000000000C.title: "获取蔬菜汤 (Obtain Vegetable Soup)"
	quest.4C0000000000000D.title: "营养丰富的炖菜"
	quest.4C0000000000000D.quest_subtitle: "锅里的肉块 (Meat in the pot)"
	quest.4C0000000000000D.quest_desc: [
		"&6牛肉炖菜&r及其同类能提供大量饱食度，是殖民地厨房的主力军粮。"
	]
	task.6C0000000000000D.title: "获取丰盛的炖菜"
	quest.4C0000000000000E.title: "鸡汤 (Chicken Soup)"
	quest.4C0000000000000E.quest_subtitle: "治愈系美食"
	quest.4C0000000000000E.quest_desc: [
		"&6鸡汤&r能恢复饥饿并短暂提升再生能力——战斗前很实用。"
	]
	task.6C0000000000000E.title: "获取鸡肉汤 (Chicken Soup)"
	quest.4C0000000000000F.title: "派和甜点"
	quest.4C0000000000000F.quest_subtitle: "烘焙一份美味点心"
	quest.4C0000000000000F.quest_desc: [
		"&6苹果派&r（以及巧克力/甜浆果派）可以整片烘焙——适合分享的甜点，为盛宴画上圆满句号。"
	]
	task.6C0000000000000F.title: "获取派和甜点"
	quest.4C00000000000010.title: "种植一片葡萄园"
	quest.4C00000000000010.quest_subtitle: "藤上的葡萄串"
	quest.4C00000000000010.quest_desc: [
		"&5Let's Do Vinery&r 添加了葡萄。将&6Red Grape Seeds&r种在棚架旁，它们会攀上结出果实的藤架——还有白色品种和生物群系葡萄。"
		""
		"种子由葡萄酿造而成，所以你的第一批种子必须从野外生长的藤蔓上采摘。"
	]
	task.6C00000000000010.title: "获得并种植一个葡萄园"
	quest.4C00000000000011.title: "收获葡萄"
	quest.4C00000000000011.quest_subtitle: "红色和白色"
	quest.4C00000000000011.quest_desc: [
		"从成熟的藤上采摘&6红葡萄&r。葡萄是制作果汁和葡萄酒的原材料。"
	]
	task.6C00000000000011.title: "获得丰收的葡萄"
	quest.4C00000000000012.title: "白色葡萄"
	quest.4C00000000000012.quest_subtitle: "为了更优质的葡萄酒"
	quest.4C00000000000012.quest_desc: [
		"&6白葡萄&r由自己的种子生长，能酿出更清淡的葡萄酒——收集两种颜色以获得多样性。"
	]
	task.6C00000000000012.title: "获取白色葡萄"
	quest.4C00000000000013.title: "葡萄汁"
	quest.4C00000000000013.quest_subtitle: "在发酵之前先按下按钮"
	quest.4C00000000000013.quest_desc: [
		"将葡萄踩碎或压榨成&6葡萄汁&r——可以直接饮用，也可以是酿造桶中葡萄酒的第一步。"
	]
	task.6C00000000000013.title: "获取葡萄汁"
	quest.4C00000000000014.title: "苹果压榨机"
	quest.4C00000000000014.quest_subtitle: "苹果酒和果汁"
	quest.4C00000000000014.quest_desc: [
		"&6苹果压榨机&r能将苹果榨成&6苹果汁&r，静置发酵后能酿成&6苹果酒&r——最简单的入门饮品。"
	]
	task.6C00000000000014.title: "获取苹果压榨机 The Apple Press"
	quest.4C00000000000015.title: "发酵桶"
	quest.4C00000000000015.quest_subtitle: "将果汁变成葡萄酒"
	quest.4C00000000000015.quest_desc: [
		"&6发酵桶&r能将葡萄汁随时间陈酿成葡萄酒。不同的葡萄和木材会产出不同的年份酒。"
	]
	task.6C00000000000015.title: "获取发酵桶 Fermentation Barrel"
	quest.4C00000000000016.title: "葡萄酒架"
	quest.4C00000000000016.quest_subtitle: "存放你的地窖物品"
	quest.4C00000000000016.quest_desc: [
		"&6酒架&r可以展示和存放你的瓶子——为你的陈年佳酿建造一个合适的酒窖。"
	]
	task.6C00000000000016.title: "获取葡萄酒架 The Wine Rack"
	quest.4C00000000000017.title: "一段美好的旧时光"
	quest.4C00000000000017.quest_subtitle: "国王的饮品"
	quest.4C00000000000017.quest_desc: [
		"像&6樱桃酒&r这样的瓶装酒能带来强大的食物和效果加成。为你的繁荣殖民地干杯。"
	]
	task.6C00000000000017.title: "获得一瓶上好的陈年佳酿"
	quest.4C00000000000018.title: "苹果酒"
	quest.4C00000000000018.quest_subtitle: "日常饮品"
	quest.4C00000000000018.quest_desc: [
		"&6Cider&r 是一种快捷廉价的发酵饮品——专为殖民地劳工们准备的马克杯。"
	]
	task.6C00000000000018.title: "获取苹果酒 (Cider)"
	chapter.20DE000000000001.title: "王国的军团 (Armies of the Realm)"
	chapter.20DE000000000001.chapter_subtitle: [
		"建立战争经济，率领一支受命军队，包含工人、士兵、火炮、攻城武器和受保护的运输队。"
	]
	quest.2000000000000001.title: "征服者手册"
	quest.2000000000000001.quest_subtitle: "百年战争"
	quest.2000000000000001.quest_desc: [
		"&6Hundred Years Warfare&r 让你建立战争经济，领导一支受命军队——工人NPC、士兵、攻城器械和受保护的商队。"
		"先制作&6征服者手册&r：这是模组内置的教程，详细说明了招募、命令和各个站点。"
		"&e本章为引导教程；手册中有详细说明。&r"
	]
	task.2100000000000001.title: "征服者手册"
	quest.2000000000000002.title: "合成工作站"
	quest.2000000000000002.quest_subtitle: "工作发生的地方"
	quest.2000000000000002.quest_desc: [
		"放置一个 &6Crafting Workstation&r，然后召唤一个 &6Craftsman&r 工人来运行它（见 Workers）。在没有匹配的工人被指派之前，工作站不会有任何作用；更多的工人会让它们运行得更快。"
	]
	task.2100000000000002.title: "合成工作站"
	quest.2000000000000003.title: "仓库"
	quest.2000000000000003.quest_subtitle: "中央商店"
	quest.2000000000000003.quest_desc: [
		"&6仓库控制器&r锚定了一个共享货堆。你的工人会在此存放物资，士兵和站点会从中取用——这是整个行动的核心枢纽。"
	]
	task.2100000000000003.title: "仓库"
	quest.2000000000000004.title: "补给点"
	quest.2000000000000004.quest_subtitle: "将部队留在战场上"
	quest.2000000000000004.quest_desc: [
		"士兵需要补给，补给来源是你或一个&6补给点&r。在战线附近建造一个，让你的军队远离家园时不至于挨饿。"
	]
	task.2100000000000004.title: "补给点"
	quest.2000000000000005.title: "命令法杖"
	quest.2000000000000005.quest_subtitle: "下达命令吧"
	quest.2000000000000005.quest_desc: [
		"&6Command Staff&r可选中单位并发布命令——移动、驻守、攻击、列队。你也可以按住Command Wheel键打开快捷面板，或进入RTS模式以完全控制摄像头。"
	]
	task.2100000000000005.title: "命令法杖"
	quest.2000000000000007.title: "农业工作站"
	quest.2000000000000007.quest_subtitle: "喂养军队"
	quest.2000000000000007.quest_desc: [
		"放置一个&6农田工作站&r，并指派一名农民 - 它会种植士兵们食用的食物。"
	]
	task.2100000000000007.title: "农业工作站"
	quest.2000000000000008.title: "采矿工作站"
	quest.2000000000000008.quest_subtitle: "挖掘战争宝箱"
	quest.2000000000000008.quest_desc: [
		"&6采矿工作站&r会指派矿工挖掘矿石和石头——每件武器背后的原始财富。"
	]
	task.2100000000000008.title: "采矿工作站"
	quest.2000000000000009.title: "木材工作站"
	quest.2000000000000009.quest_subtitle: "木材和竖井"
	quest.2000000000000009.quest_desc: [
		"一个&6伐木工作站&r会派伐木工去砍树，用于建造和制作工具。"
	]
	task.2100000000000009.title: "木材工作站"
	quest.200000000000000A.title: "钓鱼工作站"
	quest.200000000000000A.quest_subtitle: "来自水中的口粮补给品"
	quest.200000000000000A.quest_desc: [
		"在附近的岸边建造一个&6钓鱼工作站&r，可以获得稳定的食物供应。"
	]
	task.210000000000000A.title: "钓鱼工作站"
	quest.200000000000000B.title: "召唤工人"
	quest.200000000000000B.quest_subtitle: "雇佣兵劳工"
	quest.200000000000000B.quest_desc: [
		"每个工作站都需要一个工人。从&6工人卷轴&r中召唤他们——在招募列表的&6佣兵&r种族下可以找到，就像&6农夫卷轴&r一样。右键卷轴召唤NPC，然后将其分配到匹配的工作站。"
		"所有工坊的人员都是这样配备的。"
	]
	task.210000000000000B.title: "召唤工人"
	quest.200000000000000C.title: "仓库存储系统"
	quest.200000000000000C.quest_subtitle: "扩大储备量"
	quest.200000000000000C.quest_desc: [
		"&6仓储存储&r方块能扩展你的仓库，让工人存取更多货物。"
	]
	task.210000000000000C.title: "仓库存储系统"
	quest.200000000000000D.title: "运输工作站"
	quest.200000000000000D.quest_subtitle: "自动移动货物"
	quest.200000000000000D.quest_desc: [
		"&6运输工作站&r会指派搬运工在指定路线（最多50格）的站点间运输物品——无需管道的自动化。使用运输订单来设置路线。"
	]
	task.210000000000000D.title: "运输工作站"
	quest.2000000000000018.title: "补给车队"
	quest.2000000000000018.quest_subtitle: "在路上进行交易"
	quest.2000000000000018.quest_desc: [
		"建造一个&6商队码头&r，在定居点之间运行自动化贸易车队。用一辆马车装载它（参见&6存储与旅行&r），并将士兵卷轴放入其箱中作为守卫——这些正是你在此招募的部队。"
		"船队将货物从一个码头运到另一个码头，并带着利润返回。"
	]
	task.2100000000000018.title: "补给车队"
	quest.200000000000000E.title: "招募民兵"
	quest.200000000000000E.quest_subtitle: "你的第一个士兵"
	quest.200000000000000E.quest_desc: [
		"民兵是廉价的矛兵，也是早期军队的支柱。在&6招募界面&r招募他们——按住命令轮并点击招募，或右键&6征服者法杖&r。选择一个种族，选择单位和等级，并支付经验和资源成本。你将持有&6民兵卷轴&r，用于管理你招募的单位。"
	]
	task.210000000000000E.title: "招募民兵"
	quest.200000000000000F.title: "招募弓箭手"
	quest.200000000000000F.quest_subtitle: "远程降雨效果（范围）"
	quest.200000000000000F.quest_desc: [
		"&6弓箭手&r能在步兵逼近前，从远处削弱敌人。在&6招募界面&r招募他们——按住命令轮键并点击招募，或右键点击&6征服者法杖&r。选择一个种族，选择单位和等级，并支付经验和资源成本。单位类型之间存在克制关系，所以要混合你的部队。"
	]
	task.210000000000000F.title: "招募弓箭手"
	quest.2000000000000010.title: "招募骑兵部队"
	quest.2000000000000010.quest_subtitle: "骑着它们冲下去"
	quest.2000000000000010.quest_desc: [
		"骑兵冲锋迅速，击溃溃逃之敌——开阔地形的利器。在&6招募界面&r招募他们——按住命令轮并点击招募，或右键&6征服者法杖&r。选择种族、单位和等级，并支付经验和资源成本。"
		""
		"重型佣兵马是&6骑乘长矛手&r。也有更轻的骑手——骑乘轻型长矛手和骑乘弓箭手——每种都有编号等级，成本更高但伤害更大。"
	]
	task.2100000000000010.title: "招募一名骑乘长枪手"
	quest.2000000000000011.title: "手炮"
	quest.2000000000000011.quest_subtitle: "早期的火药配方需要用到木炭和硫磺。"
	quest.2000000000000011.quest_desc: [
		"制作一把&6手炮&r——第一件火器。声音大，装填慢，近距离威力惊人。"
	]
	task.2100000000000011.title: "手炮"
	quest.2000000000000012.title: "火绳枪"
	quest.2000000000000012.quest_subtitle: "一把更稳定的枪"
	quest.2000000000000012.quest_desc: [
		"&6Matchlock&r 比手炮更可靠的火器，射程更远，威力更大。"
	]
	task.2100000000000012.title: "火绳枪"
	quest.2000000000000013.title: "铸造子弹"
	quest.2000000000000013.quest_subtitle: "给枪上膛，弹药补给"
	quest.2000000000000013.quest_desc: [
		"制作&6子弹&r——手炮和燧发枪的消耗品。战斗前多备一些。"
	]
	task.2100000000000013.title: "铸造子弹"
	quest.2000000000000014.title: "大炮"
	quest.2000000000000014.quest_subtitle: "野战火炮"
	quest.2000000000000014.quest_desc: [
		"&6大炮&r将铁弹投向战场。攻城器械就像士兵一样从招募界面中部署，只是消耗的资源更多。"
	]
	task.2100000000000014.title: "大炮"
	quest.2000000000000015.title: "轰炸目标：将炸弹投掷到指定位置，摧毁所有方块。"
	quest.2000000000000015.quest_subtitle: "打破墙壁"
	quest.2000000000000015.quest_desc: [
		"&6炮兵&r会向防御工事投掷巨石。当你的军需库负担得起时，在招募界面招募它。"
	]
	task.2100000000000015.title: "轰炸目标：将炸弹投掷到指定位置，摧毁所有方块。"
	quest.2000000000000016.title: "伟大的炮击"
	quest.2000000000000016.quest_subtitle: "攻城破城者"
	quest.2000000000000016.quest_desc: [
		"&6巨炮&r是武器库中最大的火炮——任何直接命中之物都无法幸存。是你攻城列车的巅峰之作。"
	]
	task.2100000000000016.title: "伟大的炮击"
	quest.2000000000000006.title: "征服者之杖 (The Conqueror's Staff)"
	quest.2000000000000006.quest_subtitle: "召集宿主，做好准备迎接即将到来的挑战"
	quest.2000000000000006.quest_desc: [
		"&6征服者法杖&r是终极指挥工具：右键打开&6招募界面&r，即可同时指挥所有部队。"
		"经济运转，士兵列队，火炮和攻城器械已备，你已拥有一支真正的中世纪军队。来自&6战争与税收&r和&6MineColonies&r定居点的殖民地税收有助于支付账单。"
		"合成征服者法杖，以战领主的身份驰骋沙场。"
	]
	task.2100000000000006.title: "征服者之杖 (The Conqueror's Staff)"
