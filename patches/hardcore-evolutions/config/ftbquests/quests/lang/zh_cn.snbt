	quest.59165A3DAA4028F5.quest_desc: ["海洋将其掩埋自有原因。不管怎样，把它挖出来。"]
	quest.59165A3DAA4028F5.quest_subtitle: "杀死 1 只 [Coralssus]"
	quest.59165A3DAA4028F5.title: "&4[试炼一] 沉没的泰坦"
	quest.591CE113C5B2389B.quest_desc: ["所有插槽都构建于其基础之上。"]
	quest.591CE113C5B2389B.quest_subtitle: "16x 宝石熔合板岩"
	quest.591CE113C5B2389B.title: "熔合板岩"
	quest.597597E4D010285E.quest_desc: [
		"---------------------------------"
		"生命值 - &n5-26&r"
		""
		"精神健康 - &n60-81&r"
		""
		"护甲 - 0"
		""
		"最低EP - 1000"
		""
		"最大EP - 3000"
		"---------------------------------"
		"一支装备精良的兽人先遣队正朝附近的定居点进军。在兽人领主到来前将其消灭。"
		""
		"装备了铁质盔甲和斧头。由于武器亲和性，他们挥舞斧头时造成的伤害是1.5倍，并且基础生命值远高于哥布林。"
		""
		"在沙漠和恶地附近生成"
	]
	quest.597597E4D010285E.quest_subtitle: "杀死 10 个 [奥克]"
	quest.597597E4D010285E.title: "D级任务“兽人先锋”"
	quest.5A274CF63EB9411D.quest_desc: ["四个炉子，四个烈焰人。下界不是可选项。"]
	quest.5A274CF63EB9411D.quest_subtitle: "4x 烈焰人燃烧器"
	quest.5A274CF63EB9411D.title: "烈焰人燃烧器"
