	quest.7E45F1A10C0DE001.quest_desc: [
		"---------------------------------"
		"&c木板是空的。每份契约都已签署，每只野兽都已登记在册。"
		""
		"剩下的就是公会从未公布的名单——那些仅存的"
		"低声说道，因为没有猎人回来证实过他们的话。"
		"---------------------------------"
		"&7本章其他25个合约全部完成前无法解锁。"
		""
		"&7Every boss in this pack carries &l10x&r&7 its normal health."
		"带上朋友，带上Hihi'Irokane，带上时间。"
	]
	quest.7E45F1A10C0DE001.quest_subtitle: "工会曾向你要求的一切，以及工会本身"
	quest.7E45F1A10C0DE001.title: "&4&lSS级 &c\"最终契约\""
	quest.B83D1D9BAAAD6384.quest_desc: [
		"---------------------------------"
		"&7一场开始的赛跑。道路由此开启。"
		""
		"&7生命值 &f-10   &7精神值 &f+15"
		"&7光环 &f500   &7魔法粒子 &f500"
		"&7攻击&f-0.7   &7攻击速度&f0"
		"---------------------------------"
		"一种缺乏智慧和野心的幽灵种族。它们通常很温顺，但一旦被激怒就会变得极其残忍。"
		""
		"&e> 这场比赛有自己的章节。道路在那里继续延伸。"
	]
	quest.B83D1D9BAAAD6384.quest_subtitle: "开始比赛"
	quest.B83D1D9BAAAD6384.title: "史莱姆"
