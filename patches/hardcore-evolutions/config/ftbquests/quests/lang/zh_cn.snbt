	quest.3B67FF3D61681B11.title: "&d深渊之神"
	quest.380D64932C59E78D.quest_desc: [
		"&8&m"
		"&7进化所需： &f50,000,000 EP"
		""
		"&7生命值 &f+2240      &7精神生命值 &f+27470"
		"&7光环 &f45,000,000      &7魔法粒子 &f5,000,000"
