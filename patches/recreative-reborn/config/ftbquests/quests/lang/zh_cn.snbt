	quest.7C85F70D21AF3D72.quest_desc: ["获取石英，用于大多数中后期内容的资源"]
	quest.7CF23D3CA1F606F4.quest_desc: ["制作一个可防止大炮自毁的粉末装药"]
	quest.7E29A5703A248C0B.quest_desc: ["获取磁铁矿，一种用于为发电机线圈供电的方块"]
