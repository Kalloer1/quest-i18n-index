	quest_links: [ ]
	quests: [
		{
			description: [
				"每一顿美餐都始于最初的一粒种子。"
				""
				"在本章中，你将学会种植各种作物，发现新食材，并利用德雷克天堂的肥沃土地。从简单的蔬菜到奇特的作物，每一次收获都带来烹饪、贸易和自给自足的新机遇。"
				""
				"&eHealthy crops require time, care, and patience. Experiment with different farms, organize your fields, and watch your homestead flourish with every passing season."
				""
				"&7\"最好的收成，都是一粒种子一粒种子种出来的。\""
			]
			icon: "minecraft:wheat"
			id: "762EB0D67A87E9FC"
			rewards: [
				{
					id: "72A5AD3F826B68E9"
					item: "sereneseasons:calendar"
					type: "item"
				}
				{
					id: "67F9310CBA93D44B"
					item: "croptopia:guide"
					type: "item"
				}
			]
			subtitle: "&7从种子到收获"
			tasks: [{
				id: "3457980946DA5AA7"
				title: "点击我！"
				type: "checkmark"
			}]
			title: "&6&l农作物"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["762EB0D67A87E9FC"]
			description: [
				"健康的作物始于健康的土壤。"
				""
				"在种植第一块田地之前，你需要用天然材料合成&e有机堆肥&f。放置在世界中后，堆肥会随时间慢慢成熟，最终变成&e富饶的土壤&f。"
				""
				"富饶的土壤能为农场提供肥沃的基础，许多农业模组都使用它来种植更强壮、更健康的作物。花时间准备优质土壤，未来将收获更丰硕的回报。"
				""
				"&e成功的农夫知道，丰收始于第一粒种子被种下之前很久。"
				""
				"&7\"最富饶的田野，都是从一砖一瓦建起的。\""
			]
			id: "76ABC2F5E9EBF0EF"
			rewards: [{
				id: "111F4E2C0EC4E4CC"
				item: {
					Count: 1
					id: "minecraft:iron_hoe"
					tag: {
						Damage: 0
					}
				}
				type: "item"
			}]
			subtitle: "合成有机堆肥并放置以制作肥沃土壤。"
			tasks: [
				{
					id: "127E0259ED48A567"
					item: "farmersdelight:organic_compost"
					type: "item"
				}
				{
					id: "718812B9B93370E4"
					item: "farmersdelight:rich_soil"
					type: "item"
				}
			]
			title: "&6&l泥土不伤人</c2></c1>"
			x: 0.0d
			y: -2.0d
		}
		{
			dependencies: ["76ABC2F5E9EBF0EF"]
			description: [
				"健康的作物需要的不只是水和阳光，还需要富含营养的土壤。"
				""
				"来自 Farm and Charm 的 &e木制筒仓&f 能让有机物缓慢分解成宝贵的 &e肥料&f。通过回收自然资源，你将获得稳定的养分供应，帮助作物生长得更快更健康。"
				""
				"维护良好的筒仓是成功农场的重要组成部分，能将日常废料转化为最宝贵的资源之一。"
				""
				"&e最优秀的农夫不会浪费大自然的馈赠——他们会将其归还给土地。"
				""
				"&7\"善待土壤，土壤也会善待你。\""
			]
			id: "161CF1B1D0F647BE"
			rewards: [{
