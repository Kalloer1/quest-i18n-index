	quest.00000000000000AF.quest_desc: [
		"&9PneumaticCraft: Repressurized&r 是一款主打&o&b物流&r、&o&b自动化&r，以及靠炸东西赚钱的游戏。"
		""
		"掌握压缩空气和热量将是你旅程的开始。"
	]
	quest.00000000000000AF.quest_subtitle: "*完成&b&n&o钢锭&r任务后解锁*"
	quest.00000000000000AF.title: "欢迎来到 &6PneumaticCraft: Repressurized"
	quest.00000000000000BD.quest_desc: [
		"虽然它不会让你被来自太空的危险面条拜访，也不会辐射乡村一千年，但高压空气本身也可能很危险，超过压力会导致该方块破裂并丢失。"
		""
		"用一点红石和一个中继器，就能为你的新空气压缩机建造一个简单的红石切断电路。"
	]
	quest.00000000000000BD.title: "空气压缩机"
	quest.00000000000000C3.quest_desc: ["再周密的计划也可能因意外而失败。请在压缩机和压力舱安装安全升级，以防止意外快速解体。"]
	quest.00000000000000C3.title: "安全升级"
	quest.00000000000000C7.quest_desc: [
		"固体燃料威力强大，但缺乏精细控制，因为即使红石关闭了压缩机，它们也会在燃料完全燃烧前持续产生压力。"
		""
		"考虑升级到更安全的燃料来源吧。"
	]
	quest.00000000000000CC.quest_desc: ["在高压空气是主要能源的情况下，热量是一个次要但同样重要的机制。高级压缩机和其他机器需要加热或冷却才能正常运行。"]
	quest.00000000000000CC.title: "Subzero"
	quest.00000000000000CF.quest_desc: [
		"Vortex Tube 基于在特殊腔室中使高压空气旋转以产生温差，通过控制压力来精细调节加热或制冷的程度。"
		""
		"不过，涡管并非产生热量的唯一方式。在JEI中查找热管的用途，会发现许多可用于加热和冷却的方块和液体。"
		""
		"最后，PneumaticCraft 内置了对 Mekanism 热量系统的支持，并与 Integrated Dynamics 兼容。一些主要的热源包括："
		""
		"● 外部加热器 (External Heater)"
		"● 电阻加热器 (Resistive Heater)"
		"● 燃木取暖器"
	]
	quest.00000000000000D2.quest_desc: ["&6热管&r可用于在方块间快速无损地传输热量。用它将热量从涡流管输送到一台或多台机器。热量也可直接用于为熔炉供电。"]
	quest.00000000000000D2.title: "热传导管"
	quest.00000000000000D5.quest_desc: [
		"你可能已经注意到，Vortex Tube消耗大量空气且不响应红石。要关闭它，必须切断空气供应。Regulator Tube Module正是为此而设。"
		""
		"将其放置在压力管线上，并向其施加红石信号。15 的信号将完全阻止气流，关闭下游所有机器。"
	]
	quest.00000000000000D9.quest_desc: [
		"&6Heat Frame&r可放置在任何物品栏上，使其能利用热量或冷量进行合成。加热时，它能像熔炉一样熔炼物品。冷却时，则可以制作各种实用物品。"
		""
		"要冷却液体，请将 PneumaticCraft 储罐或水桶装满并放入物品栏。只要有空间，冷却后的物品就会出现在箱子里。"
	]
	quest.00000000000000DC.quest_desc: [
		"&e通用传感器&r是一种强大的方块，能根据多种条件输出红石信号，例如检测附近玩家、玩家右键方块、方块存在、光照强度，甚至方块当前的温度。"
		""
		"读取热量时，尽量对准热管或 PNC:R 机器，而不是带加热框架的背包。"
	]
	quest.00000000000000E0.quest_desc: ["去舀一桶油，就像个肮脏的混血儿。通常在地下就能找到，看小地图就能轻松发现。"]
	quest.00000000000000E0.title: "粗俗与未开化 (Crude and Un-Cultured)"
	quest.00000000000000E2.quest_desc: [
		"Gas Lift 可用于将流体从世界中抽出。将其放置在任意流体的源方块上方，插入钻探管并提供空气。管道将向下延伸至源方块，提升器会尝试抽取所有附近相连的源方块。"
		""
		"潜行+右键任意PNC:R方块，使用气动扳手即可立即拾取，同时保留储存的空气和升级。此方法也适用于压力室阀门。"
	]
	quest.00000000000000E7.quest_desc: [
		"将&e控制器&r放置，并在其上方堆叠2-4个输出装置即可建造&e炼油厂&r。务必将所有侧面进行隔热！建议使用物流网络提取输出物以作进一步处理。提供热量和石油即可开始流程。"
		""
		"通过控制器读取比较器的数值，是控制涡流管、防止燃料浪费的绝佳方法。"
	]
	quest.00000000000000E7.title: "石油精炼厂"
	quest.00000000000000EA.quest_desc: [
		"简称TPP，这台机器利用热量和压力的结合来改变固体和液体的状态。近年来，它甚至被用于厨房。"
		""
		"将机器排成一行，可以让它们通过侧面共享热量和压力。"
	]
	quest.00000000000000EA.title: "热气动加工"
	quest.00000000000000EE.quest_desc: ["用于制作速度升级的绝佳材料。"]
	quest.00000000000000EE.title: "润滑剂"
	quest.00000000000000F1.quest_desc: ["需要更多？考虑将其他燃料转换一下吧。"]
	quest.00000000000000F1.title: "LPG"
	quest.00000000000000F4.quest_desc: ["即将到来的海中的一滴落点。"]
	quest.00000000000000F4.title: "熔融塑料"
	quest.00000000000000F8.quest_desc: ["这燃料还不错……不过或许需要进行一点改造。"]
	quest.00000000000000F8.title: "柴油发动机"
	quest.00000000000000FB.quest_desc: ["流体混合器主要用于生物柴油加工链的最后一步。它还能产生一种非常有用的副产品——甘油。"]
	quest.00000000000000FB.quest_subtitle: "混合搭配，乐趣无穷"
	quest.00000000000000FD.quest_desc: [
		"生产可再生塑料和润滑剂的第一步，使用TPP创造酵母培养液需要精确的温度控制。"
		""
		"尝试使用低功率热源，如火把、不同隔热等级，甚至不同生物群系或维度，以找到可靠的生产文化的方法。"
	]
	quest.00000000000000FD.title: "酵母培养物"
	quest.0000000000000100.quest_desc: ["乙醇可以单独燃烧，但它也可以被精炼，这绝对值得一做！"]
	quest.0000000000000100.title: "乙醇"
	quest.0000000000000103.quest_desc: ["或者，随便哪个种子都可以，反正都一样。"]
	quest.0000000000000103.quest_subtitle: "给豌豆一个机会"
	quest.0000000000000103.title: "植物油"
	quest.0000000000000107.quest_desc: ["一条可持续的前进道路。"]
	quest.0000000000000107.title: "生物柴油"
	quest.000000000000010B.quest_desc: [
		"&2物流框架&r和模块是物流网络的核心。框架可以安装在任何物品栏上，并使用物流配置器进行配置。"
		""
		"对于更复杂的设置，可能需要使用其他物品栏来“扩展”机器。"
		""
		"例如，你可以在熔炉上使用请求器框架将物品拉入其中，然后用漏斗将产物取出。漏斗上的提供者框架可以将物品送回网络。"
	]
	quest.000000000000010B.title: "物流系统"
	quest.0000000000000110.quest_desc: ["一个抗爆炸的箱子，被破坏时仍能保留其内容物。"]
	quest.0000000000000114.quest_desc: ["强化箱的进阶版，拥有更大的物品栏、单个物品类型的数量筛选、远程物品收集，以及向附近物品栏推拉物品的能力。"]
	quest.0000000000000119.quest_desc: ["PNC漏斗过滤快，方向随心，支持多种实用升级。更多信息请查看其GUI。"]
	quest.0000000000000119.title: "漏斗（Hoppers）"
	quest.000000000000011D.quest_desc: [
		"PNC:R 的物流系统相当强大，但需要预先规划，并且移动物品和流体需要消耗空气。"
		""
		"当用于压力管网络时，它允许大量物品和流体通过同一条线路同时瞬时移动。"
	]
	quest.000000000000011D.title: "合乎逻辑的前进道路"
	quest.0000000000000120.quest_desc: [
		"&e红石模块&r用于通过管道网络传输红石信号，从而实现信号的读取和输出。使用时不需要空气。"
		""
		"将模块扩展卡安装到模块中，使其能执行更复杂的操作，例如充当时钟、信号计数器或切换器。"
	]
	quest.0000000000000120.title: "红石模块"
	quest.0000000000000123.quest_desc: [
		"&a模块扩展卡&r可插入各种管道模块以增强其功能。调节器管道模块、压力表管道模块、红石模块和通风口模块都能从中获益匪浅。"
		""
		"考虑使用高级压力计模块和一些红石模块来升级压缩机的红石控制。"
	]
	quest.0000000000000123.quest_subtitle: "树莓派"
	quest.0000000000000126.quest_desc: ["&e物流无人机&r是在不想搭建完整空中基础设施时的得力助手。尝试使用物流框架，部署物流无人机来帮你搬运物品。"]
	quest.0000000000000126.quest_subtitle: "飞行马戏团"
	quest.0000000000000129.quest_desc: [
		"制作并部署一个 &9Harvest Drone&r 来自动化作物农场或树木农场。使用 Collector Drone 来保持整洁。"
		""
		"请参阅PNC手册或物品提示，了解其运作说明。"
	]
	quest.000000000000012C.quest_desc: [
		"&2充电站&r对于自动为无人机充电至关重要。放置一个，并向其中插入&d分配器升级&r，使其能为上方的实体充电。附近的无人机在需要时会自动寻找可用的充电站。"
		""
		"站在这样的&2充电站&r上，你背包里的物品也会被充能。"
	]
	quest.000000000000012F.quest_desc: ["在无人机中安装一个或多个物品生命升级，以帮助它们保持正常工作。它们偶尔会受到环境危害的损害，而这些升级将使其能够自我修复。"]
	quest.000000000000012F.quest_subtitle: "在她需要的时候提供帮助"
	quest.0000000000000132.quest_desc: ["在无人机中安装待机升级，以节省一些空气。"]
	quest.0000000000000135.quest_desc: ["在您的采集无人机中安装一些物品栏升级组件。"]
	quest.0000000000000135.title: "物品栏升级"
	quest.0000000000000138.quest_desc: ["在收集无人机中安装几个范围升级模块。"]
	quest.0000000000000138.quest_subtitle: "他正在长途跋涉，坚持不懈"
	quest.000000000000013B.quest_desc: ["在无人机或其他方块中放置几个，可以加快进程。"]
	quest.000000000000013E.quest_desc: [
		"&d可编程无人机&r是PNC:R自动化能力的巅峰，它们能与方块和实体互动，使用武器和工具，并根据复杂条件执行动作，可能性近乎无限。"
		""
		"快来探索这款可视化编程语言，看看你能创造出什么吧！如果想不到主意，可以试试这些："
		""
		""
		"● 自动化 &o&3Botania 的符文祭坛&r"
		"● 自动化 &o&dPNC:R’s Biodiesel&r"
	]
	quest.000000000000013E.title: "可编程无人机"
	quest.0000000000000142.quest_desc: ["&c远程控制器&r是可编程接口设备，通过操作全局变量来工作。结合通用传感器使用时，可用于远程红石，也可用于控制可编程无人机。"]
	quest.0000000000000145.quest_desc: ["将&e塑料&r桶&o&b倒&r入世界可以开始冷却，但肯定有更好的方法吧？"]
	quest.0000000000000145.title: "塑料"
	quest.0000000000000148.quest_desc: ["居家购物的终极体验。只需点击按钮，订单便会瞬间送达。"]
	quest.0000000000000148.title: "优先派送任务书文本"
	quest.000000000000014B.quest_desc: ["随时可以从阿马德龙处获得。不过当地的压力机械师通常也会作为初始交易提供它们……"]
	quest.000000000000014E.quest_desc: [
		"用于为蚀刻准备空PCB。没有速度升级的话，这个过程会很慢……建议将阈值设为60-70%左右，这样在等待的同时也有不错的蚀刻几率。强烈建议自动化此过程。"
		""
		"失败的PCB可以被回收利用。"
	]
	quest.0000000000000151.quest_desc: [
		"制作电路板的下一步是在此储罐中进行蚀刻，该储罐可同时容纳和处理多达25个空PCB。"
		""
		"仅在蚀刻木板时施加热量，酸才会被消耗。"
		""
		"这样做能显著加快蚀刻过程，一桶材料可制作多个PCB。"
	]
	quest.0000000000000151.title: "蚀刻槽"
	quest.0000000000000155.quest_desc: [
		"&6组装台&r提供了更简单的电路板制作方式，并能解锁其他高级配方。"
		""
		"每个部件都有其放置限制。具体放置规则请参阅 PNC:R 手册。"
		""
		"一个简单的布局可以在 2x3 的空间内完成，不过："
		""
		"&eIO&r (&b导入&r)、&2控制器&r、&eIO&r (&b导出&r)、&d钻头&r、&9工作台&r、&6激光&r"
	]
	quest.0000000000000155.title: "装配台"
	quest.0000000000000168.quest_desc: [
		"将其放入装配控制器并提供空气以启动。强烈建议升级速度。"
		""
		"钻探与激光程序允许装配台制作仅需钻头或激光的配方。大多数情况下，没有理由使用单独的程序。"
	]
	quest.0000000000000168.title: "组装程序"
	quest.000000000000016B.quest_desc: [
		"便携式流体存储。还能填充水桶和其他储罐，用于自动化。"
		""
		"将它们垂直堆叠，并用气动扳手右键点击以形成一个多方块储罐。"
	]
	quest.000000000000016B.title: "流体储罐"
	quest.0000000000000171.quest_subtitle: "*完成&b&n&o签署契约&r任务后解锁*"
	quest.0000000000000179.title: "抽屉钥匙的"
	quest.0000000000000415.quest_desc: [
		"采用先进的加工方法，可以制造出更坚固的压力管，从而达到更高的压力。"
		""
		"&5高级压缩机&r必须保持低温，因此并非总能成为特定任务的最佳选择。"
		""
		"不过，有些机器只有在高级压缩机产生的压力下才会开始工作。"
	]
	quest.0000000000000417.quest_desc: [
		"保持压力只是硬币的一面。创造真空同样可以带来很大好处。"
		""
		"真空中的&e压力舱&r可用于从物品中提取附魔。"
	]
	quest.0000000000000554.quest_subtitle: "*完成&b&n&o铁制工具&r任务后解锁*"
