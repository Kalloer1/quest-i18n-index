	quest.3C5645FC080DFE9A.quest_desc: ["&6速度模块&r &n允许&r SecurityCraft 的&e部分方块&r以比平时&o&b更快的速度运行&r。"]
	quest.3C5D84B0D51474E7.title: "&4生长与加速生长&r &f&oTier 5"
	quest.3CA57107EB36818B.quest_desc: [
		"便携式&d气场&r源，可与多种&e工具&r搭配使用。"
		""
		"潜在用途请参阅&9自然光环之书&r中关于&2自然工具&r的章节。"
	]
	quest.3CA5D58AD8C37B7C.quest_desc: [
