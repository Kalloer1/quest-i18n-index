	]
	quest.4DA04ABF4FF2625C.title: "&9Aureal"
	quest.4DA1C95BED78A662.quest_subtitle: "比下界合金还要好"
	quest.4DA1C95BED78A662.title: "&1Draco Arcanus Armor&r"
	quest.4DAC24440803FE58.quest_desc: [
		"&3Spatial Anchor&f 是源自 &dSpatial IO&r 系列的一种辅助装置，其功能就是一个简单的 &nchunk loader&r。"
		""
		"When connected to an &5ME network&r, the &3Anchor&r will &nforce-load&r all the chunks occupied by the &5ME network&r across all cables and devices, excluding subnetworks, as long as the network remains powered."
	]
	quest.4DB38D4B758A861D.quest_desc: [
		"&2括号&r是装饰性物品，用于&3竖井&r、&a齿轮&r和&9流体管道&r上。"
		""
		"&2括号&r可以作为一种方法，&o&b用来将&r相邻的管道&o&b彼此&r分隔开来。"
	]
	quest.4DB38D4B758A861D.title: "&bBratchets"
	quest.4DCC1256167B4A02.quest_subtitle: "一种坚硬、滑溜的金属，以其减速能力而闻名"
	quest.4DCC1256167B4A02.title: "Froststeel Ingot"
	quest.4DE55B68AB69EFC7.quest_desc: [
		"一张&1网络卡&r存储着&d网络接收器&r的坐标。"
		""
		"玩家需要将&1网络卡插入到&r一个&e网络发射器&r中。"
	]
