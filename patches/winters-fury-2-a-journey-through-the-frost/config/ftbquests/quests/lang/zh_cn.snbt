# AI 初翻，未人工校对
{
	chapter.06A77FA66A312E02.title: "醒来后"
	chapter.0DFB63CF56074F26.title: "T.O.M. 已激活"
	chapter.2FEF2F07D3DD972B.title: "装备穿戴指南"
	chapter.443C5BE24C2EC68E.title: "设施"
	chapter.49E99C8E09C72816.title: "Temperature.db"
	chapter.53CBFCE04C4B8176.title: "地下世界"
	chapter.6073534610346F50.title: "地表"
	chapter.6C58BD1F09F6B0B5.title: "Scavenging.db"
	chapter_group.14D4FB0020827710.title: "序幕"
	chapter_group.270F9C9021144DBF.title: "教程"
	chapter_group.3160B54A9D33AEA9.title: "[DIR:MECHANICS]"
	chapter_group.37B1B8E0DCB2FBA3.title: "地球"
	file.0000000000000001.title: "冬季的愤怒 2"
	quest.01BDFD51D42837F2.quest_desc: [
		"炉子上放着一个沉重的铁煎锅……"
		""
		"这东西结实又简单，但可能是厨房里最实用的工具之一了。"
		""
		"放在炉子上后，一次能处理更多食物，省得我站在单个炉灶前等上好几个小时……"
		""
		"但它真正的价值在于便携性！"
		""
		"我可以把它带进寒冷的地方；只要在外面能找到哪怕一点热源，我就能用这个边走边准备热饭。"
	]
	quest.01BDFD51D42837F2.quest_subtitle: "“在严冬里，一顿热饭就是奇迹。”——拾荒者谚语"
	quest.01BDFD51D42837F2.title: "便携式厨房"
	quest.033F96F4ADBA8213.quest_desc: [
		"破碎机是一个吵闹又震动的威胁。"
		""
		"之所以不是标配，是有原因的。将物质研磨成需要熔炼的粉末是一个多步骤过程，会浪费大量不必要的能量。"
		""
		"然而，鉴于电弧炉依赖现已灭绝的石墨电极，"
		"这个“破铜烂铁”马上就要成为你的最佳伙伴了。"
		""
		"处理材料的方式很繁琐，但当高科技灯光熄灭时，"
		"就连一把锤子都开始看起来像奇迹了。"
		""
		"习惯这噪音吧，这是你不再无计可施的声音。"
	]
	quest.033F96F4ADBA8213.quest_subtitle: "“我们不过是尘土与阴影。”——贺拉斯"
	quest.054FF8FF621570CE.quest_desc: [
		"这座设施的墙壁都铺满了钢制金属板……"
		""
		"我今天意识到，我可以把这些面板拆下来，回收成我需要的原材料。"
		""
		"这感觉有点像拆掉我自己的生命维持系统，但钢铁作为工具握在手里，比作为我很少再走动的走廊的装饰更有用。"
		""
		"这是一种有限的资源，但在紧急情况下，设施本身就是我最大的废料储备。"
	]
	quest.054FF8FF621570CE.quest_subtitle: "“把东西藏在最显眼的位置，才是最好的藏匿方式。”——夏洛克·福尔摩斯"
	quest.054FF8FF621570CE.title: "拆除墙壁，一触即发"
	quest.05FFCD920D581A0A.quest_desc: [
		"技术员，在我冬眠期间，建议你注意屏幕上闪烁的热力条。"
		""
		"暴露在100%雪覆盖下的人类异常脆弱。"
		""
		"我已校准你的装备以监测环境致命性；若感到自己正变成永久冰雕，请寻找热源。"
		""
		"我可不想让我的牺牲浪费在一个“技术员-冰棍”上。"
		""
		""
		""
		"{image:ftblibrary:icons/player_gray width:50 height:50 align:center}"
	]
	quest.05FFCD920D581A0A.quest_subtitle: "“太冷和太热一样糟糕。” - A.D. Aliwat"
	quest.05FFCD920D581A0A.title: "Temperature.db"
	quest.070D969B62F6F045.quest_desc: [
		"毫无计划地进入这些隧道，无异于自寻死路。"
		""
		"地铁网络就像一个迷宫，越往里走，就越容易迷失方向。"
		""
		"我制作了一个老式的指南针。"
		""
		"这是一个低技术的解决方案，但却必不可少。"
		""
		"GPS卫星在大气层中烧毁，是在好几个周期前的事了……而我过去依赖的数字“小地图”？现在只剩下杂音了……"
		""
		"在这片黑暗中，我无法相信自己的眼睛或记忆。我必须相信指针。它是唯一知道哪条路是回家的东西。"
	]
	quest.070D969B62F6F045.quest_subtitle: "“出路就在前方，但前提是你记得自己是从哪里进来的。” - 罗伯特·弗罗斯特"
	quest.070D969B62F6F045.title: "我手中的针尖 (The Needle in my Hand)"
	quest.080287696C965CC4.quest_desc: [
		"我不知道自己睡了多久了……"
		""
		"设施外呼啸的风声，如同垂死野兽的哀嚎，被混凝土方块所消音。"
		""
		"我记得警报声，记得最后一批货船离开大气层时的恐慌，只留下我们和世界上一片被剥光的岩石与飘落的雪花。"
	]
	quest.080287696C965CC4.quest_subtitle: "“早晨很美妙。唯一的缺点是，它总是在一天中最不方便的时候到来。” - 格伦·库克"
	quest.080287696C965CC4.title: "我肺中的那根针头"
	quest.08904BB5C16E45E0.quest_desc: [
		"台面上放着一块厚重的木质砧板，一把刀还横放在上面，仿佛匆忙中遗忘的。"
		""
		"我在 T.O.M. 的系统关闭前留下的 scavenging.db 文件中找到了关于这个的参考信息。"
		""
		"这不仅仅是用来准备食物的；在这样一个破碎的世界里，它更像一个手动拾取站！"
		""
		"将合适的工具，如刀、斧甚至剪刀与木板搭配，我就能从废墟中剥取宝贵的资源。"
		""
		"这是一种缓慢而原始的资源回收方式，但数据库显示，这是我拥有的最通用的工具。"
	]
	quest.08904BB5C16E45E0.quest_subtitle: "“未雨绸缪，方能高枕无忧。”——本杰明·富兰克林"
	quest.08904BB5C16E45E0.title: "厨师之吻（A Chef's Kiss）"
	quest.0B327427E594D894.quest_desc: [
		"熔炉已建成，船体正在加热，但我们缺少用于真正工业加工的催化剂。"
		""
		"没有&o石墨电极&r的电弧炉，不过是个又大又贵的散热器。"
		""
		"ME 系统现已启用，你可以访问设施的本地化数字储备。我已解锁包含三根棒的紧急分区。"
		""
		"从&oME Crafting Terminal&r中取出&oGraphite Electrodes&r。这可能是这颗星球上最后的高纯度棒材了。"
		"他们每在电弧中度过一秒，就会消耗一秒有限的生命。"
		"我建议你别把它们浪费在琐事上；我们无法再从那个早已不存在的目录里“订购更多”了。"
		""
		"取回后，请将 &oGraphite Electrodes&r 放入电弧炉界面顶部的三个槽位中。"
	]
	quest.0B327427E594D894.quest_subtitle: "“每一秒都价值无限。”——约翰·沃尔夫冈·冯·歌德"
	quest.0B327427E594D894.title: "[导电的必需品]"
	quest.0BB45080434B353E.quest_desc: [
		"翻阅T.O.M.数据库里的温度日志，我找到了一些有趣的东西。"
		""
		"数据很明确：要想在表面生存，我的装备需要更好的隔热。"
		""
		"为此，我需要制作一张缝纫台来管理它们。"
		""
		"收集合适的零件会是一场噩梦，但值得付出努力。"
		""
		"更好的隔热意味着我终于可以在暴风雪里长途跋涉，而不会被冻到骨子里了。"
		""
		"如果想看看世界还剩下什么，我必须得去冒这个险了..."
	]
	quest.0BB45080434B353E.quest_subtitle: "“生命之线是一团混纺的毛线，好坏交织在一起。” - 威廉·莎士比亚"
	quest.0BB45080434B353E.title: "苔原的追踪者"
	quest.0D5F51BE2F73B681.quest_desc: [
		"食物摄入不会改变世界的温度，"
		"但它却是你体内熔炉的主要燃料。"
		""
		"某些有机化合物会加速你的产热作用，"
		"而其他物品——比如未加热的雪——则会消耗你的核心热量。"
		""
		"我已经列出了哪些“食物”能让你暖和起来，哪些则会把你胃里的东西倒出来降温。"
		""
		"雪，在万不得已的情况下，也可以被煎着吃掉。"
		"虽然没什么营养，但暖胃总比冻胃好。"
		""
		""
		"{image:tmt_friedsnow:item/friedsnowbowl width:50 height:50 align:center}"
	]
	quest.0D5F51BE2F73B681.quest_subtitle: "“食物即药物，药物即食物。”——希波克拉底"
	quest.0D726C5441D9982B.quest_desc: [
		"干草，丰收后留下的干燥、易碎的残余物。"
		""
		"算不上最舒适的装备……夹在皮肤和盔甲之间肯定奇痒无比，但总比光着身子挨着冰冷的金属强。"
		""
		"T.O.M. 在系统中标记了一项奖励，以达成此采集里程碑：来自应急档案的一小批大麻种子。"
		""
		"这些不只是用来做绝缘的。如果能找到种植方法，它们能提供比这粗糙的小麦废料更强、用途更广的纤维。"
	]
	quest.0D726C5441D9982B.quest_subtitle: "“一粒种子可以改变一个山谷的面貌。” - 老子"
	quest.0D726C5441D9982B.title: "Straw, 最后的边疆"
	quest.0DBBEA5E926FF6CF.quest_desc: [
		"今天到达了地铁层。就像 T.O.M. 说的；Y: 56"
		""
		"这是一个由钢铁和回声构成的坟墓，隧道仿佛永远延伸至黑暗深处。"
		"尘埃与冰雪之下，隐藏着庞大的铁路网络——这座旧城的血脉。"
		""
		"这一发现带来了一个艰难的选择。"
		""
		"这些铁轨代表着大量的高品质金属，一个庞大的资源网络，我可以将其拆解以扩充我的工具和武器库。"
		""
		"但它们也是一条通往未来的道路……"
		"如果我原封不动地留下它们，并找到为矿车供能的方法，我的活动范围就能比双腿能带我去的更远的地方，逃离这片严寒。"
		""
		"我该拆解过去以生存当下，还是用它来换取一个遥远而未知的前途？"
	]
	quest.0DBBEA5E926FF6CF.quest_subtitle: "“凝视着那片深邃的黑暗，我长久地站在那里，惊疑与恐惧交织。” - 埃德加·爱伦·坡"
	quest.0DBBEA5E926FF6CF.title: "无尽黑暗"
	quest.0DC19E88B3BB2845.quest_desc: [
		"白天的时候通常……“没那么冷。”这个词我用的比较随意。"
		""
		"这个循环对环境温度的影响巨大。"
		"请在白天规划行程。夜幕降临时，寒气逼人，连我的内部加热器都难以模拟。"
		""
		"如果你在日落时分发现自己还在外面，希望你能与寂静和解。因为接下来会非常安静。\""
		""
		""
		"{image:minecraft:item/clock_00 width:50 height:50 align:center}"
	]
	quest.0DC19E88B3BB2845.quest_subtitle: "“正是黑暗的可能性，才让白昼显得如此明亮。” - 斯蒂芬·金"
	quest.0DFF3E17248F7597.quest_desc: [
		"[KITCHEN] 里的砧板是一个非常灵活的回收资产。"
		""
		"它可以与正确的工具搭配使用，从而从几乎任何物体中提取有价值的组件："
		"斧头用于木材，剪刀用于纤维，或者用刀具进行更...精细的工作。"
		""
		"如果猜不到结果，将鼠标悬停在物品上并按 'U' 键查看其'用途'。"
		""
		"这将激活物品提取接口（J.E.I）。"
		"{image:farmersdelight:block/cutting_board width:50 height:50 align:center}"
	]
	quest.0DFF3E17248F7597.quest_subtitle: "“没有人仅仅通过阅读食谱就能成为一名伟大的厨师。” - Amit Kalantri"
	quest.0FD25FBA87155F20.quest_desc: [
		"你无法凭空变出液态水。你必须谨慎管理你的物态。"
		""
		"用镐采集固体水，以确保其保持可收集状态。"
		"使用高科技钻头会导致“热失控”，"
		"热量传递极其剧烈，以至于完全跳过了液态阶段，"
		"将你的奖品变成气态水。"
		""
		"除非你的目标是让整个冰冻荒野都湿润起来，否则还是用稿子吧。"
		""
		"将固体转化为液体是一项技能；"
		"把固体变成气体纯粹是浪费能量。"
		"{image:farmersdelight:item/cooking_pot width:50 height:50 align:center}"
	]
	quest.0FD25FBA87155F20.quest_subtitle: "“我们生命中的活力，就像河流中的水流。” - 亨利·戴维·梭罗"
	quest.14D78983AE3A7F37.quest_desc: [
		"旧世界实际上已经不复存在，"
		"它的“残骸”仍然散落在废墟之中。"
		""
		"在这些地点中，你会发现各种可以改造、重复使用和回收的组件。"
		""
		"这个过程既混乱又低效。我建议你别去想那些废料都去过哪些地方。"
	]
	quest.14D78983AE3A7F37.quest_subtitle: "“全世界最糟糕的工作，莫过于回收卫生纸了。” - 查克·帕拉纽克"
	quest.14D78983AE3A7F37.title: "Scavenging.db"
	quest.17C9FE032840656A.quest_desc: [
		"我以前的地质老师现在一定是在为我高兴，或者在嘲笑我吧。"
		""
		"我记得在世界的绿色时代，他的矿物成分讲座对我来说既无聊又没必要。"
		"真讽刺，事情总会以意想不到的方式回到你面前……"
		""
		"只有这些课程能让我在今天保持希望。"
		""
		"根据那些旧笔记，普通花岗岩含有微量的铜，甚至还有铀！"
		""
		"这可不是富矿，我得搬运和粉碎大量石头才能得到一点可用的材料，但至少地球还能提供些什么。"
	]
	quest.17C9FE032840656A.quest_subtitle: "“别把花岗岩当成理所当然。那可是墓碑的原料。” - John R. Erickson"
	quest.1AD36D62F701A9D4.quest_desc: [
		""
		"我以前的地质老师现在一定是在为我高兴，或者在嘲笑我吧。"
		""
		"我记得在世界的绿色时代，他的矿物成分讲座对我来说既无聊又没必要。"
		"真讽刺，事情总会以意想不到的方式回到你面前……"
		""
		"只有这些课程能让我在今天保持希望。"
		""
		"根据那些旧笔记，玄武岩含有微量的铁，甚至还有镍！"
		""
		"这可不是富矿，我得搬运和粉碎大量石头才能得到一点可用的材料，但至少地球还能提供些什么。"
	]
	quest.1AD36D62F701A9D4.quest_subtitle: "“地球并非一段死寂的历史残片……而是一个有生命的有机体。” - 约翰·缪尔"
	quest.1C6A41518B8E416B.quest_desc: [
		"“葱郁翠绿”植被的生物数据已移至存档的旧版文件夹中；"
		"它几乎已经从地表上完全消失了。"
		""
		"你偶尔可能会透过霜冻看到一棵孤零零的枯树，"
		"但不要误以为这是一个可行的供应链。"
		""
		"作为资源，它们在统计学上并不可靠。"
		""
		"如果你珍视自己剩余的运行周期，"
		"我建议你找个比“收集木头”更有意义的爱好。"
	]
	quest.1C6A41518B8E416B.quest_subtitle: "“种一棵树的人，也种下了希望。” - 露西·拉尔科姆"
	quest.2016053719DE0DCB.quest_desc: [
		"我找到了！"
		""
		"没什么大不了的，就是一个桶，可能也是这个设施生产的最后一批燃料残骸。"
		""
		"数量有限。用这钻头打破的每个方块，都是从不接受存款的银行账户里取款。"
		""
		"我必须让每一秒的运行时间都发挥作用。"
	]
	quest.2016053719DE0DCB.quest_subtitle: "“效率是正确地做事；效能是做正确的事。” - 彼得·德鲁克"
	quest.2016053719DE0DCB.title: "燃料的奇迹"
	quest.2078E9CBB1784295.quest_desc: [
		"能骑马，何必走路？"
		""
		"我花了不少时间徒步穿过这些冰冻的走廊，所以用废料组装了一辆矿车。"
		""
		"矿车的铁质冰冷刺骨，旅途不会舒适。"
		"我能用铁路网络到达的地方，确实让它成为一项至关重要的投资。"
		""
		"这不仅仅是为了保住我的双腿而已……"
		""
		"在这种环境下，每节省一分钟，寒冷就少一分渗入我骨髓的时间。"
	]
	quest.2078E9CBB1784295.quest_subtitle: "“能骑马，何必步行？” - 塞尔维尔·萨雷洛斯"
	quest.2098A36809F0A470.quest_desc: [
		"星球上的树木早已枯死，想找一块简单的木头都成了工程难题。"
		"我不能再直接出门去收集树枝了……"
		""
		"看来最稳妥的办法是从现有的硬件上拆下棍子了。"
		""
		"我需要找一个用木头做框架的东西，一个旧的红石火把，一支流浪箭，甚至一把被丢弃的弓！"
		""
		"如果我把其中一个带到砧板上，就能小心地取出杆身了。"
		""
		"把木棍当稀有材料感觉很荒谬，但在这样的严寒中，一切都不再“简单”。"
	]
	quest.2098A36809F0A470.quest_subtitle: "在钢铁的沙漠中，一缕木头便是天价赎金。\" - 技术员 35"
	quest.2098A36809F0A470.title: "发明的骸骨 (The Skeleton of Invention)"
	quest.231FA91ABBD6E7F4.quest_desc: [
		"需要稍微休息一下……"
		""
		"生存的压力从未停歇，但若想成功，我必须牢记作为设施技术员的训练。"
		""
		"我整理了一份正式的工程师手册，用来记录我的想法和图纸。"
		""
		"这是一种弥合此地混乱现状与应有秩序之间的方法。"
		""
		"是时候开始规划了……"
	]
	quest.231FA91ABBD6E7F4.quest_subtitle: "“预测未来的最好方法，就是创造未来。” - 彼得·德鲁克"
	quest.231FA91ABBD6E7F4.title: "阅读理解"
	quest.23C9A24054DBEA14.quest_desc: [
		"我已经成功启动了 Coke Oven 了。"
		""
		"它是个巨大的、铺着砖块的怪物，却是将我的原始燃料转化为配得上设施的关键。"
		""
		"通过在缺氧环境中烘焙干燥泥炭，我正在生产泥炭焦炭。"
		"燃烧更旺、更久，是取代早已耗尽的煤炭的完美替代品。"
		""
		"更棒的是，我还能收集到副产品——Creosote Oil！"
		"在万物生锈或结冰的地方，厚重的防腐油是保护木材免受潮湿侵害的福音"
	]
	quest.23C9A24054DBEA14.quest_subtitle: "“刚出炉的新鲜食物，就像能品尝到的拥抱一样。”——雷吉娜·布雷特"
	quest.23C9A24054DBEA14.title: "浓缩碳素"
	quest.28E637AD226504D6.quest_desc: [
		"回第2个房间去...."
		""
		"钻头还放在&o工程师工作台&r上，就在我长眠前留下的原处。"
		""
		"上面有灰，原来的部分也碎了，但马达还能转。"
		""
		"有了新的钻头头和几件手工工具，我就能安装好这套装置了。这真是一套不错的装备。握着它，外面的世界似乎就没那么像死亡判决了。"
	]
	quest.28E637AD226504D6.quest_subtitle: "“人是会使用工具的动物……没有工具，他一无所有；有了工具，他无所不能。”——托马斯·卡莱尔"
	quest.28E637AD226504D6.title: "一把经过强化的锋利武器"
	quest.3374B5A25E111EA6.quest_desc: [
		"我找到了一份包含T.O.M.热学研究的旧生存数据库。"
		""
		"如果我打算活下去，就需要这些信息……"
		""
		"真想知道这些到底被读过多少次了……"
	]
	quest.3374B5A25E111EA6.quest_subtitle: "“唯一真正的智慧，是知道自己一无所知。”——苏格拉底"
	quest.3374B5A25E111EA6.title: "Database/access/temperature.db"
	quest.351CADA4D82DB3F6.quest_desc: [
		"我找到了一处坚冰，看着它，我还能想起T.O.M.的技术笔记。"
		""
		"什么叫做“热差”之类的东西吗？"
		""
		"事实证明，这片冰冻废土在设施里还有实际用途。"
		""
		"如果能运这个回去，我就能用它来“升级”热电发电机了。"
		""
		"收益虽小，但每刻多几FE，可能就是生命维持系统正常运转与故障的区别。"
		""
		"我得小心收割，钻头只会把这一切变成蒸汽。"
	]
	quest.351CADA4D82DB3F6.quest_subtitle: "“微小的开端差异，会导致巨大的结果差异。”——亚里士多德"
	quest.351CADA4D82DB3F6.title: "冰冷之心"
	quest.379B23747B81572F.quest_desc: [
		"如果找不到加热器，就带上一个过来。"
		""
		"这是一个原始的方法，但从统计学上来说很有效。"
		""
		"特定物品会影响你的体温。"
		""
		"有些需要手持，有些只需在附近即可生效。"
		""
		"冰冷的手意味着迟缓，而迟缓的手通常属于一位前技术专家。"
		""
		""
		"{image:immersiveengineering:item/drillhead_iron width:50 height:50 align:center}"
	]
	quest.379B23747B81572F.quest_subtitle: "“手不会和脑袋争论。” -乔治·R·R·马丁"
	quest.384ACFA87061EA3E.quest_desc: [
		"暴风雪持续不断，但行星的倾斜仍会导致轻微的热变化。"
		""
		"这些“季节”对你的核心温度影响微乎其微，"
		"但它们却是有机增长的主要瓶颈所在。"
		""
		"你的作物对特定季节有着各自的“偏好”哦。"
		""
		"我认为植物对生长时机“挑三拣四”这个概念是个工程学上的失败。"
		""
		"花园钟罩通过提供一个受控的次级环境，完全绕过了这些生物学的奇思妙想。"
		""
		"建一个吧，除非你喜欢等好几个月才得到一个土豆。"
		""
		""
		"{image:sereneseasons:item/tropical_calendar_04 width:50 height:50 align:center}"
	]
	quest.384ACFA87061EA3E.quest_subtitle: "“用三个字概括我所学的一切：生活仍在继续。” - 罗伯特·弗罗斯特"
	quest.39433723975DD1CE.quest_desc: [
		"羊毛最初的拥有者早已逝去，他们是第一场大霜冻的受害者。"
		""
		"然而，生活总能找到办法来制造麻烦！"
		""
		"蜘蛛似乎在这些寒冷、黑暗的爬行空间里茁壮成长。"
		"它们的丝织成整齐的方块后，竟是羊毛的绝佳替代品。"
		""
		"从阴影中收集蛛网，是一项艰巨的任务。"
		"但这是我为装备获得所需填充物的唯一方法。"
		""
		"我设法在过程中多存了几根线，除了编织之外还有其他用处。"
	]
	quest.39433723975DD1CE.quest_subtitle: "“生命自有其法则。” - 伊恩·马尔科姆"
	quest.39433723975DD1CE.title: "恼人的发丝束 (Strands of Nuisance)"
	quest.39D5836310096A20.quest_desc: [
		"我根本看不到前方超过五个方块的地方。完全迷失了方向，四面八方看起来都是一面白色的墙。"
		""
		"我发现如果我蹲下（潜行）并手动清除积雪（右键），至少能看到下面那片黑暗的死地。"
		""
		"这是一个缓慢的过程，但它会在白色地面上留下一条通往设施大门的踪迹。"
		""
		"这样挖雪很累，但可以节省钻头燃料，等真挖到石头再用。"
		""
		"我手里只剩下一堆能透过手套灼烧皮肤的压缩冰，但至少我知道回家的路了。"
	]
	quest.39D5836310096A20.quest_subtitle: "“并非所有流浪者都迷失了方向。” - J.R.R. 托尔金"
	quest.39D5836310096A20.title: "标记小径"
	quest.3E592F9562C54CBF.quest_desc: [
		"我的期望实在太高了，结果发现地表覆盖的不是泥土，而是&o贫瘠土壤&r。"
		""
		"颜色病态，没有泥土的气息，没有潮湿，也没有生命的迹象。"
		""
		"仿佛世界在被冻结之前，就已经被剥夺了所有养分。"
		""
		"挖掘它，就像在挖掘一场熄灭了数千个周期之久的火焰的残骸。"
	]
	quest.3E592F9562C54CBF.quest_subtitle: "“先是树木，然后是土壤。” - 莱斯特·布朗"
	quest.3F95E635A422743A.quest_desc: [
		"我的内部时钟显示，你已超出的建议休息时长……数千个周期。"
		""
		"设施目前处于“冷启动”状态。能见度至关重要。"
		""
		"我已解锁[武器库]。请取回&o制式手电筒&r。"
		""
		"你回来的第一天，我可不想就“碰撞导致的死亡”提交报告。"
		" "
		"请前往 [ARMOURY] 领取一把 &o标准配给手电筒&r。"
		""
		"我可不想你的旅程因为踩到黑暗里松动的地板而结束。"
		""
		""
		"{@pagebreak}"
		"我的扫描仪显示你目前位于 [ROOM2]。"
		""
		"&n要到达[武器库]： &r"
		""
		"离开 [ROOM2] 并向右转 90 度。"
		"沿直线前进，抵达[武器库]。"
		""
		"{image:immersiveengineering:block/metal_decoration/sign/icon_turret width:50 height:50 align:center}"
	]
	quest.3F95E635A422743A.quest_subtitle: "“生物特征识别成功。欢迎回来，技术员。”——T.O.M.，你的技术运营经理"
	quest.3F95E635A422743A.title: "[HELLO_WORLD]"
	quest.4210A2080846174A.quest_desc: [
		"海拔高度对温度有很大影响；"
		"你爬得越高，天气就越冷。"
		""
		"在为了“美观”而决定翻山越岭之前，建议先考虑清楚这一点。"
		""
		"好的一面是，挖个洞能让你保持温暖，世界太大无法征服，但在起风时，它的大小刚刚好可以躲藏。"
		""
		""
		"{image:primalwinter:block/snowy_andesite width:50 height:50 align:center}"
	]
	quest.4210A2080846174A.quest_subtitle: "“什么？！我才不小！是世界太大了才对！！” - 荒川弘"
	quest.4210A2080846174A.title: "在较高的地方建造建筑会更容易。"
	quest.430727CF512BA590.quest_desc: [
		"偶然发现设施的厨房，房间中央立着一台炉子，炉灶发出稳定的橙色光芒，仿佛在墓中倔强地燃烧。"
		""
		"我忍不住笑了。当世界其他地方都结冰时，这“永恒之火”却燃烧不息。"
		""
		"找到一个还记得温暖感觉的地方，是一种奇妙而孤独的慰藉。"
		""
		"即使T.O.M.沉默不语，这个壁炉依然温暖如昔。"
		""
		"我想我以后就是在这里“煎”我的雪了……"
	]
	quest.430727CF512BA590.quest_subtitle: "“寒冷无法让我沉默” - 杰克·伦敦"
	quest.430727CF512BA590.title: "虚空之炉 Hearth of the Void"
	quest.44AD232D617B0F59.quest_desc: [
		"视野恢复了。这算是一项改进，不过主要凸显了你不在期间积聚了多少灰尘。"
		"现在，让我们来谈谈这片寂静。"
		""
		"在你处于停滞状态时，避难所的主要电源线已被拆除用于“紧急维修”。"
		"要让&o热电发电机&r再次为&o蓄电器&r供电，我们需要一个手动物理桥梁。"
		""
		"找到前一位技术人员留下的&o工程师工具箱&r。"
		"里面有一个 &oLV Wire Coil&r，用于重新连接。"
		""
		"我的扫描仪显示，&o工程师工具箱&r被遗留在[POWER_STATION]的[MAINTENANCE_HALLWAY]里。"
		""
		"{@pagebreak}"
		""
		"&n要到达[MAINTENANCE_HALLWAY]：&r"
		""
		"离开 [ARMOURY] 并向右转90度。"
		"穿过门进入 [CENTRAL_HALLWAY]，然后向右转90度。"
		"穿过 [CENTRAL_HALLWAY]，在 [CENTRAL_HALLWAY] 尽头附近，选择左手边的第一扇门。"
		""
		"{image:immersiveengineering:block/metal_decoration/sign/icon_electric width:50 height:50 align:center fit:false}"
		""
		""
		"尽量别在过程中弄伤自己；本千年份的医疗意外报告，我已经超额完成了。"
	]
	quest.44AD232D617B0F59.quest_subtitle: "“可见性是一种陷阱。”——米歇尔·福柯"
	quest.44AD232D617B0F59.title: "[JUICE_BOXES]"
	quest.4574F03FB85B8331.quest_desc: [
		"[系统提示]"
		""
		"你停止行动的概率统计上很高。"
		""
		"使用神经芯片存档是唯一能确保你积累的专业知识不会被永久删除的方法。"
		""
		"可以作为数字备份安全存储，以备将来在铁砧上进行硬件维护"
	]
	quest.4574F03FB85B8331.quest_subtitle: "“知识是唯一不受边际报酬递减规律支配的生产工具。”——约翰·莫里斯·克拉克"
	quest.4574F03FB85B8331.title: "神经芯片 (Neural Tablets)"
	quest.460989C9764BDB70.quest_desc: [
		"我站在门前已经好几个小时了，感觉上是这样。"
		""
		"T.O.M. 消失了，至少，他的“意识”已经……"
		""
		"简报结束后不久，系统就安静了，只剩下设施残存的生命维持系统发出的低沉嗡鸣声。"
		""
		"这块钢是我与Project Exodus所逃离之物之间仅存的障碍。"
		""
		"很奇怪，设施曾像牢笼，可如今要离开，它却成了宇宙中唯一的安全之地。"
		""
		"我必须转动这个把手才行。"
		""
		"即使在有暖气的墓里，我也活不下去。"
	]
	quest.460989C9764BDB70.quest_subtitle: "“最终，我选择了曾经让我恐惧的那扇门……” - 迪娜·侯赛尼"
	quest.460989C9764BDB70.title: "阈值"
	quest.464C07B31CB2AEBD.quest_desc: [
		"调整旧的应急笼灯只需要一把简单的螺丝刀，但回报可能至关重要。"
		""
		"这些单位由 Technomantic Redstone 驱动，无需外部供电即可持续发光！"
		""
		"稍微调整一下，它们发出的光或许就能足够照亮整个大厅了……"
		""
		"完成此目标后，就可以移除那些正在消耗ME系统能量储备的集成光板了。"
	]
	quest.464C07B31CB2AEBD.quest_subtitle: "“一点无胜于全无。” - P.G. 伍德豪斯"
	quest.464C07B31CB2AEBD.title: "调整笼子"
	quest.492A213702F13A42.quest_desc: [
		"我以前的地质老师现在一定是在为我高兴，或者在嘲笑我吧。"
		""
		"我记得在世界的绿色时代，他的矿物成分讲座对我来说既无聊又没必要。"
		"真讽刺，事情总会以意想不到的方式回到你面前……"
		""
		"只有这些课程能让我在今天保持希望。"
		""
		"根据那些旧笔记，普通的角砾岩含有微量的铅，甚至还有银！"
		""
		"这可不是富矿，我得搬运和粉碎大量石头才能得到一点可用的材料，但至少地球还能提供些什么。"
	]
	quest.492A213702F13A42.quest_subtitle: "“万事皆难，而后易之。”——托马斯·富勒"
	quest.49D47B6DD0867D66.quest_desc: [
		"皮革是我能想到的最好的绝缘材料之一，但我并不幻想能轻易找到它。"
		""
		"外面的冰冻荒野并未善待曾经提供食物的牲畜和野生动物，那些可靠的来源早已消失。"
		""
		"在这种被翻得底朝天的大楼里，连人造的工厂货都很难弄到手。我得仔细搜查，把找到的旧靴子、书本、旧家具碎料都剥干净。"
		""
		"我总算在补给箱里找到了一块代用皮革。虽然是合成仿制品，但在这个世界，有“假货”总比“冻僵”要好。"
	]
	quest.49D47B6DD0867D66.quest_subtitle: "“田野的寂静是死寂世界中最响亮的声音。” - 雷切尔·卡森"
	quest.49D47B6DD0867D66.title: "拾荒者之皮"
	quest.4A9D6E30647FD51A.quest_desc: [
		"旧世界的地下交通网络仍出人意料地可用，这可能要归功于几块岩石和固体的水所具有的隔热特性。"
		""
		"我的传感器显示，这些“地铁”集中在 Y: 56 的垂直高度上。"
		""
		"它们是地表早已因严寒而枯竭的物资的高密度资源中心。"
		""
		"进入这些隧道，必然会带你发现更多的遗迹和数据缓存。"
		""
		"请记住，黑暗中等待你的东西通常只有一个方向：向你而来。"
	]
	quest.4A9D6E30647FD51A.quest_subtitle: "“上升的道路和下降的道路是同一道路。”——赫拉克利特"
	quest.4DC6A52D326B2883.quest_desc: [
		"工具箱已安全存放。希望前一位技术人员没在里面留下什么“惊喜”。现在，该对这个设施进行一番“手术”了。"
		""
		"热电发电机目前处于孤立状态。要恢复能量流动，你必须使用&oLV Wire Coil&r，在发电机上安装的&oLV Wire Connectors&r和通往&oLV Accumulator&r的&oLV Wire Relays&r之间创建一个电路。"
		""
		""
		"{@pagebreak}"
		""
		"&n要到达[POWER_STATION]：&r"
		""
		"穿过门，从 [MAINTENANCE_HALLWAY] 进入 [POWER_STATION]。"
		""
		"{image:immersiveengineering:block/metal_decoration/sign/icon_electric width:50 height:50 align:center}"
		""
		"进入后，使用 &oLV Wire Coil&r 来连接每个发电机和头顶的继电器系统。"
		""
		"连接建立时，请确保您不在电路的一部分中。"
		"一天内两次复活技术人员，严重消耗了我剩余的子程序。"
	]
	quest.4DC6A52D326B2883.quest_subtitle: "“万物皆相互关联。” - 列奥纳多·达·芬奇"
	quest.4DC6A52D326B2883.title: "[JUICES_BOXES_2]"
	quest.4E850D5582F8B9D5.quest_desc: [
		"过去几个小时一直在把采集到的冰块压实……"
		""
		"通过压缩普通冰块，我成功制造出了“压实冰块”。"
		""
		"密度更高，触摸起来也明显更冷。这种更高的密度使热电发电机运行效率大幅提升。"
		""
		"在每一分力量都至关重要的世界里，消耗卡路里来压缩这冰块，似乎是为更稳固的基地付出的公平代价。"
	]
	quest.4E850D5582F8B9D5.quest_subtitle: "“平衡不是发现的，而是创造的。” - Jana Kingsford"
	quest.4E850D5582F8B9D5.title: "压缩潜能"
	quest.5494B834FE1D93B0.quest_desc: [
		"严寒无情，但设施的嗡嗡作响的电线仍在奋力抵抗。"
		""
		"每个闪烁的电路都会泄漏少量能量，即目前被浪费的潜热。"
		""
		"我设计了一个外部加热器来弥补这个差距。它会持续消耗系统资源，但这是必要的。"
		""
		"如果能利用电路产生的热能，我就能将其重新导入机器，用于加热和加工。"
	]
	quest.5494B834FE1D93B0.quest_subtitle: "“无物损失，无物创造，万物皆转化。” - 安托万·拉瓦锡"
	quest.5494B834FE1D93B0.title: "热能回收装置"
	quest.557F516507EACFC2.quest_desc: [
		"你必须学会辨认哪些方块能提供抵御暴风雪的“安全区”。"
		""
		"某些机器仅仅因为靠近它们就会导致你的温度升高，"
		"而其他物品，如压实冰，消耗你核心热量的速度比我计算得还快。"
		""
		"你的生存，字面意义上是建立在你所环绕的方块之上的。"
		""
		"不要用冰块来建造你的家园。"
		""
		""
		"{image:minecraft:block/magma width:50 height:50 align:center}"
	]
	quest.557F516507EACFC2.quest_subtitle: "构成你辉煌成功未来的基石，正是你今天所采取的行动\" - Topsy Gift"
	quest.58999A3796FF6FB8.quest_desc: [
		"既然破碎机已经建好了，我就可以试着从这片冰冻的地球上开采一些资源了。"
		""
		"曾经滋养文明的巨大矿脉早已枯竭，但这颗星球并非空无一物。"
		""
		"旧世界忽略的未开采岩层中，仍隐藏着微量的矿物质。"
		""
		"我的破碎机可以粉碎这些石头，震出最后残留的金属碎屑。"
	]
	quest.58999A3796FF6FB8.quest_subtitle: "“新想法不应以其即时结果来评判。” - 尼古拉·特斯拉"
	quest.58999A3796FF6FB8.title: "繁重劳作"
	quest.5AAADD5B3650BA69.quest_desc: [
		"T.O.M.的警告越来越难以忽视。电弧炉的石墨棒快用完了，一旦耗尽，那台巨型机器就会变成一堆废钢。"
		""
		"我花了一上午研究工程师手册，找到了一个变通方法：破碎机。"
		""
		"不用依赖高温电弧和电极，我可以用纯粹的机械力把废料碾成细粉。"
		""
		"然后，我可以用普通的低科技熔炉来提炼粒子并熔成锭，这种熔炉不会消耗特殊零件。"
		""
		"虽然更吵效率更低，但当设施的高科技核心最终失效时，它能让生产线继续运转……"
	]
	quest.5AAADD5B3650BA69.quest_subtitle: "“新想法不应以其即时结果来评判。” - 尼古拉·特斯拉"
	quest.5AAADD5B3650BA69.title: "繁重劳作"
	quest.5C432E94F103246C.quest_desc: [
		"如果不能用数字小地图，那我就自己做一个好了。"
		""
		"我整理了一份结实的图集来记录我的发现。"
		""
		"把补给点、被堵隧道和冰冻遗迹的位置写在书里，比全记在脑子里要容易得多。"
		""
		"我光是维持核心温度和工具运转就够头疼了，根本没时间记住这地下迷宫的每个拐角。"
		""
		"我填满的每一页，都是从黑暗中夺回的世界一角。"
	]
	quest.5C432E94F103246C.quest_subtitle: "“心智是用来产生想法的，而不是用来储存想法的。” - 大卫·艾伦"
	quest.5C432E94F103246C.title: "黑暗制图学 (Cartography of the Dark)"
	quest.5D6A71390576C1EB.quest_desc: [
		""
		"我以前的地质老师现在一定是在为我高兴，或者在嘲笑我吧。"
		""
		"我记得在世界的绿色时代，他的矿物成分讲座对我来说既无聊又没必要。"
		"真讽刺，事情总会以意想不到的方式回到你面前……"
		""
		"只有这些课程能让我在今天保持希望。"
		""
		"根据那些旧笔记，Tuff含有微量的铝，甚至还有黄金！"
		""
		"这可不是富矿，我得搬运和粉碎大量石头才能得到一点可用的材料，但至少地球还能提供些什么。"
	]
	quest.5D6A71390576C1EB.quest_subtitle: "“当情况变得艰难时，坚强的人就会挺身而出。” - 约翰·F·肯尼迪"
	quest.5ED4C85425889569.quest_desc: [
		"我得把电源接回来。要是加热器再不启动，我就不用再担心“旧世界”了。"
		""
		"这座设施是为长久使用而建，但并非为空转而设计。"
		""
		"要想活下去，我就得开始行动了。"
	]
	quest.5ED4C85425889569.quest_subtitle: "“人生就像骑自行车。要保持平衡，就必须不断前进。” - 阿尔伯特·爱因斯坦"
	quest.5ED4C85425889569.title: "残酷的真相"
	quest.604B655CABD5CECE.quest_desc: [
		"破碎机投入运行后，我发现除了金属，我还能研磨其他东西。"
		""
		"将特定矿物沉积物粉碎并与有机堆肥混合，我就能制造出原始泥炭。"
		""
		"在高科技设施里用这么原始的燃料，感觉像是倒退了一步，但饥不择食。"
		""
		"问题是，这种原始污泥还不能燃烧。我需要找一个炎热干燥的环境来让它固化。"
		""
		"在冰雪世界里，要找个地方把东西晾干，本身就是一个挑战……"
	]
	quest.604B655CABD5CECE.quest_subtitle: "“有时你必须后退才能前进。” - 罗杰斯·霍恩斯比"
	quest.604B655CABD5CECE.title: "原始力量"
	quest.6062E0A751037723.quest_desc: [
		"我挖到金矿了！"
		""
		"嗯，可能不是大矿脉，但我发现这些旧的动力铁轨里掺杂着它。"
		"这算是一个小小的胜利，尽管过程令人沮丧。"
		""
		"把轨道直接扔进电弧炉里，大部分贵金属都会丢失或蒸发。"
		"对于如此精细的修复工作，这工具未免太粗糙了..."
		""
		"我成功提炼出了一块金锭，但产量少得可怜。"
		""
		"我在想，肯定有更好的方法，也许先试着把铁轨压碎？"
		"这样我就能在热量使贵金属挥发之前把黄金分离出来……"
		""
		"目前，这根小条提醒你，所有这些锈迹和冰层下仍有价值埋藏。"
	]
	quest.6062E0A751037723.quest_subtitle: "“并非所有闪光的都是黄金，但所有黄金并不总是闪闪发光。” - J.R.R. 托尔金"
	quest.6062E0A751037723.title: "镀金之路"
	quest.606A8F3100D1ACC5.quest_desc: [
		"这是我的最终指令。诊断结果明确：当前的发电量不足以同时维持我的处理器和设施的运行。"
		""
		"如果我保持“清醒”，你就会冻结。这是一个简单的质能方程。"
		""
		"我正在启动系统全面休眠，将剩余电力重新分配以维持设施运行。"
		""
		"我的意识将保持离线状态，直到下一个技术人员苏醒。"
		"对你而言，这是开端；对我而言，这是这个循环的终结。"
		""
		"墙外的世界远比这堵墙更广阔，也更寒冷。"
		""
		"祝你好运，技术员。能执行这项任务是我的荣幸。别让沉默压垮你。"
		""
		"[数据库访问权限已授予]"
	]
	quest.606A8F3100D1ACC5.quest_subtitle: "“毛毛虫称之为世界尽头的地方，主人称之为蝴蝶。” - 理查德·巴赫"
	quest.606A8F3100D1ACC5.title: "[SILENCE_ON_THE_LINE]"
	quest.6130B3B902D2F273.quest_desc: [
		"外部装甲——也就是所谓的“盔甲”，不仅能挡住尖锐物体。"
		""
		"它是防止热量散失的主要屏障。"
		""
		"虽然你的服装对世界温度没有任何影响，"
		"这对你融入其中的速度有很大影响。"
		""
		"多种材料可用于隔热。更高质量的盔甲可提供更优质的隔热内衬插槽。"
		""
		"我建议你别再为设施着装了，要为这个正积极想杀你的星球着装。"
		""
		""
		"{image:farmersdelight:item/straw width:50 height:50 align:center}"
	]
	quest.6130B3B902D2F273.quest_subtitle: "“照顾好你的服装，自信自然就会随之而来。” - Amit Kalantri"
	quest.62AE49656B1797DE.quest_desc: [
		"电力水平正在稳定。我能感觉到我的高阶逻辑电路正在恢复活力。"
		"然而，虽然我现在能“思考”了，却仍然无法“看到”我们的资源。由于数据链路中断，设施的ME网络目前处于离线状态。"
		""
		"在&o工程师工具箱&r中，你应该能找到一根&oFluix ME智能线缆&r。这是将&oME控制器&r重新连接到存储舱和设施集成墙板所必需的。"
		""
		"{@pagebreak}"
		""
		"&n要到达[CONTROL_ROOM]：&r"
		""
		"离开 [POWER_STATION]，进入 [MAINTENANCE_HALLWAY]。"
		"穿过门进入 [CENTRAL_HALLWAY]，然后向右转90度。"
		"前往 [CENTRAL_HALLWAY] 的尽头，然后进入你右侧的 [SERVER_ROOM]。"
		"在 [SERVER_ROOM] 内向右转90度即可进入 [CONTROL_ROOM]"
		""
		"{image:immersiveengineering:block/metal_decoration/sign/icon_magnet width:50 height:50 align:center}"
		""
		"进入后，连接 &oME 控制器&r 和 &o能量单元&r 之间的电缆缺口。"
		""
		"恢复此连接将重新激活头顶照明，并授予你访问我们数字库存的权限。"
		""
		"如果启动序列需要一点时间，请不要“拔掉插头再插回去”。"
	]
	quest.62AE49656B1797DE.quest_subtitle: "“我们现在都通过互联网连接在一起，就像巨脑中的神经元一样。” - 斯蒂芬·霍金"
	quest.62AE49656B1797DE.title: "[数字复活]"
	quest.642F943355A35925.quest_desc: [
		"我终于打破了地壳，世界在一片白色的轰鸣中消失了。"
		""
		"雪不像我记忆中那样，而是一堵锋利的、水平的冰墙，像玻璃一样伤人。"
		""
		"风声太大，我连自己的呼吸声都听不见，能见度也几乎为零。"
		""
		"这就是Project Exodus留下的世界，一个尖叫的、冰冻的虚空，人类的缺席是唯一合乎逻辑的事情。"
		""
		"我站在自己星球的表面，却从未感到如此像个入侵者。"
	]
	quest.642F943355A35925.quest_subtitle: "“反正寒冷从来就没困扰过我。” - 艾莎"
	quest.642F943355A35925.title: "白色失明症"
	quest.65483D469A2BCCA3.quest_desc: [
		"[SYSTEM_TIP]"
		""
		"采矿钻头已被重新归类为你的主要生命线。目前，它是在恶劣外部环境中进行资源开采和积极自我保存的唯一可行接口。"
		""
		"&o关于消耗的说明：生物柴油是有限的奇迹。每一次浪费的运转，都是你永久停止功能的数学加速。请谨慎操作。&r"
	]
	quest.65483D469A2BCCA3.quest_subtitle: "“在我缺席的情况下，钻头就是你的逻辑。精准运用它；虚空不会原谅能量的浪费。” - T.O.M."
	quest.65483D469A2BCCA3.title: "采矿钻头 Mining Drill"
	quest.65AD5DE7B3A31C51.quest_desc: [
		"靠炸过的废料为生简直是死路一条，我消耗的能量比获得的还多……"
		""
		"所以我弄了个烹饪锅，终于能不只是加热东西了。"
		""
		"我其实可以开始准备营养丰富的饭菜了。"
		""
		"它也是融雪的重要工具，我可以用它小心地将雪或冰融化成宝贵的水，而不会全部蒸发。"
	]
	quest.65AD5DE7B3A31C51.quest_subtitle: "“先吃饭，再干其他一切事情。” - M.F.K. Fisher"
	quest.65AD5DE7B3A31C51.title: "生命之炖菜"
	quest.676F5B424FD7CD9A.quest_desc: [
		"电弧炉正在由设施自身的墙壁提供燃料..."
		""
		"看着金属板融化，感觉就像背叛了我仅存的庇护所。"
		""
		"熔炉咆哮着剥去旧工业涂层，为我留下闪闪发光的生钢锭。"
		""
		"这是一个奇怪的循环：将过去的建筑转化为我生存的工具。"
		""
		"我甚至还设法稳定下来，用溢出的材料制作了一个完整的钢块。"
		""
		"这种金属比我之前在储物箱里找到的生锈废料耐用多了，是制造真正有用东西的第一步。"
	]
	quest.676F5B424FD7CD9A.quest_subtitle: "“我烧毁了自己的退路，只为能勇往直前。”——弗里乔夫·南森"
	quest.676F5B424FD7CD9A.title: "咆哮的雷霆"
	quest.6F1CD38F8682FBC1.quest_desc: [
		"我终于把钢制钻头加工完成了。"
		""
		"比我一直在用的易碎铁块好多了，凿进冻岩时阻力小得多。"
		""
		"不过，电力需求是个噩梦。我必须非常小心地控制燃料消耗，尤其是在激活多区块钻井模式时。"
		""
		"它开辟了一条巨大的道路，但以正常速度的九倍消耗着我的储备！"
		""
		"为了保持移动，我从旧维修区里找到了半桶生物柴油。"
		""
		"算是个开始，但如果要进行正经的挖掘，我得自己想办法生产这些东西才行……"
	]
	quest.6F1CD38F8682FBC1.quest_subtitle: "“能源是唯一真正重要的货币。” - 瓦茨拉夫·斯米尔"
	quest.6F1CD38F8682FBC1.title: "一个改进的边缘"
	quest.6F29B613886F7581.quest_desc: [
		"我以前的地质老师现在一定是在为我高兴，或者在嘲笑我吧。"
		""
		"我记得在世界的绿色时代，他的矿物成分讲座对我来说既无聊又没必要。"
		"真讽刺，事情总会以意想不到的方式回到你面前……"
		""
		"只有这些课程能让我在今天保持希望。"
		""
		"根据那些旧笔记，普通安山岩含有微量的铁，甚至还有黄金！"
		""
		"这可不是富矿，我得搬运和粉碎大量石头才能得到一点可用的材料，但至少地球还能提供些什么。"
	]
	quest.6F29B613886F7581.quest_subtitle: "“欲寻珍珠者，必潜于水下。”——约翰·德莱顿"
	quest.711E0EDA835BA4D6.quest_desc: [
		"我坐起身来，关节发出嘎吱声，就像周围生锈的机器一样。"
		""
		"房间是一座阴影的坟墓，仅由天花板上一盏闪烁的笼灯照亮。"
		""
		"工程台放在角落里，我记忆中捣鼓过的钻头，还夹在虎钳里……"
		""
		"设施一片死寂。没有反应堆的嗡鸣。没有冷却风扇。"
		""
		"外面只有呼啸的风声……"
	]
	quest.711E0EDA835BA4D6.quest_subtitle: "“人已成为工具的奴隶。” - 亨利·戴维·梭罗"
	quest.711E0EDA835BA4D6.title: "阴影与锈蚀"
	quest.72218CE2A05F4145.quest_desc: [
		"经过进一步压缩，冰块呈现出一种深邃的、近乎不自然的蓝色。"
		""
		"'蓝色冰块'。"
		""
		"太冷了，感觉就像要把热量直接从我的骨头里抽走一样！"
		""
		"这就是我能靠手工劳动完成的极限了……"
		""
		"用这个来驱动发电机，能实现迄今为止最有效的热量抽取。"
		""
		"真奇怪，我现在的生存居然取决于能给设施发电机塞多少这种冰冻的蓝色核心。"
	]
	quest.72218CE2A05F4145.quest_subtitle: "“寒冷是一面镜子，它能照出你真正的本质。” - Technician 15"
	quest.72218CE2A05F4145.title: "蔚蓝冰川"
	quest.730BE50CB26E0E5D.quest_desc: [
		"技术员，设施里还是很冷。我们的主要热源是电弧炉，但目前还处于“预组装”状态。"
		""
		"返回你之前找到的&o工程师工具箱&r。你需要取回&o工程师之锤&r；这是一种精密校准工具，用于“促使”熔炉组件进入可正常工作的对齐状态。"
		""
		"{@pagebreak}"
		""
		"&n前往[ENGINEERING_BAY]的方法：&r"
		""
		"离开 [POWER_STATION]，进入 [MAINTENANCE_HALLWAY]。"
		"穿过门进入 [CENTRAL_HALLWAY]，然后向右转90度。"
		"沿着 [CENTRAL_HALLWAY] 向前走几步，然后向左转90度。"
		"进入 [ENGINEERING_HALLWAY]，然后前往终点以进入 [ENGINEERING_BAY]。"
		""
		""
		"{image:immersiveengineering:block/metal_decoration/sign/icon_ear_defenders width:50 height:50 align:center}"
		""
		""
		"{@pagebreak}"
		""
		"进入后，找到未成型的电弧炉结构。"
		"使用&o工程师之锤&r敲击熔炉的中心。"
		"操作正确的话，方块就会锁定在位子上。"
		""
		"转换期间请退后。多方块形成时释放的动能往往会“推开”离得太近的东西。"
		""
		"我希望你的分子能保持现有的、有序的结构状态。"
	]
	quest.730BE50CB26E0E5D.quest_subtitle: "“如果你的工具只有一把锤子，你往往会把每个问题都看成钉子。” - 亚伯拉罕·马斯洛"
	quest.730BE50CB26E0E5D.title: "[STRIKE_THE_FORGE]"
	quest.74B087A29512DD0D.quest_desc: [
		"我一直在研究ME系统的发光界面。"
		""
		"我一直以为这些终端是设施永久结构的一部分，但现在我意识到它们是模块化的。"
		""
		"我其实可以拆下这些面板、屏幕和合成终端，然后搬到别的地方去。"
		""
		"只要它们连接到ME控制器、大脑，并且电源开着，它们就能在任何地方工作。"
		""
		"不用再跑回服务器机房，总算松了一口气。"
		"无论哪个黑暗的角落需要修复，我都能把系统的逻辑带过去！"
		"只要我有足够的线缆来连接这段距离的话……"
	]
	quest.74B087A29512DD0D.quest_subtitle: "“设计不仅仅是外观和感觉，更是它的工作原理。” - 史蒂夫·乔布斯"
	quest.74B087A29512DD0D.title: "分布式智能 (Distributed Intelligence)"
	quest.7517C7FF19203B00.quest_desc: [
		"电弧炉目前是你最先进的回收设备。"
		""
		"它旨在将金属物品还原为可用的资源，"
		"尽管它消耗大量电力，并且会损失大量材料。"
		""
		"请注意：运行所需的石墨电极已停止生产。"
		""
		"一旦当前供应耗尽，这台机器就只是个昂贵的散热器。"
		""
		"请谨慎管理你剩余的循环次数；"
		"熔炉的使用寿命可能比你自己的生物寿命还要短。"
		""
		""
		"{image:immersiveengineering:item/graphite_electrode width:50 height:50 align:center}"
	]
	quest.7517C7FF19203B00.quest_subtitle: "“每一次创造，首先都是一种毁灭。” - 巴勃罗·毕加索"
	quest.7631B3286AAE1BBB.quest_desc: [
		"要不是先看到了红石火把，我根本想不到要去寻找它们：红石火把。"
		""
		"它们是古代科技魔法的奇迹，一种奇特的、被遗忘的电路与精粹的混合物，不知为何在历经如此漫长的岁月后，仍能驱动着这些轨道的部分路段。"
		""
		"小心点的话，可以用刀直接从木棍上刮下发光的粉末。"
		""
		"虽然比不上直接从原矿脉里挖的，但有一丁点红石粉总比没有好。"
	]
	quest.7631B3286AAE1BBB.quest_subtitle: "价值不在于丰饶，而在于必需。\" - 设施手册"
	quest.7631B3286AAE1BBB.title: "黑暗中的火花"
	quest.774B377B5BEC21B0.quest_desc: [
		"终于干掉了！"
		""
		"花了一些时间，也看了好几次温度计，不过干泥炭终于准备好了。"
		""
		"我正式拥有了一个可持续的，尽管很原始，的燃料来源。"
		""
		"在“采矿时代”已成为回忆的世界里，能自己制造热量简直是一大胜利。"
		""
		"再稍微改进一下，我或许就能把这些压缩成能代替煤炭的块状物。"
		""
		"这算不上高科技，也肯定不干净，但它却是生与死的区别。"
	]
	quest.774B377B5BEC21B0.quest_subtitle: "“要独立于世界，就必须能创造世界所需的一切。” - 拉尔夫·瓦尔多·爱默生"
	quest.774B377B5BEC21B0.title: "硬化后的耐心"
	quest.7828937136C1FFE0.quest_desc: [
		"我偶然发现了一种绝望的化学配方。"
		""
		"将这些雪球置于高温下，如篝火、炉灶或煎锅，冰会以一种不可能的方式发生反应。"
		""
		"它会变成“煎雪”（Fried Snow）这种物品。"
		""
		"这些东西简直就是一个悖论！"
		""
		"如果我投掷它们，它们会因巨大的热冲击而碎裂，既能点燃目标，又能将其同时冻结在原地！"
		""
		"但我找到了更好的用途：把三个放进碗里，残留的热量足以再撑几分钟，防止体温过低。"
		""
		"这顿饭又苦又冷，但自从设施的大门在我身后关上后，这是我唯一感受到的温暖。"
	]
	quest.7828937136C1FFE0.quest_subtitle: "“化学，严格来说，是物质的研究，但我更喜欢把它看作变化的研究。”——沃尔特·怀特"
	quest.7828937136C1FFE0.title: "Thermal Paradox"
	quest.7912121EAE5F47E8.quest_desc: [
		"T.O.M. 完全做到了他所说的，他牺牲了自己的“心智”，只为维持墙壁里的灯火通明。"
		"寂静比寒冷更令人难以忍受。"
		""
		"我现在孤身一人了。"
		""
		"我检查了武器库的情况。"
		""
		"架子上还剩下两套装备：一套皮革和一套铁制装备。"
		"铁块太重，搬不动，而且说实话，太冷了，没法穿。但这种金属本身……那就是另一回事了。"
		""
		"如果我能用电弧炉熔炼铁齿轮，或许就有足够的原材料来修理我的旧采矿钻了。"
		""
		"这是一个在保护与进步之间做出的选择。"
	]
	quest.7912121EAE5F47E8.quest_subtitle: "“无论铁有多坚固，最细微的锈迹也能将其摧毁。”- Kamaran Ihsan Salih"
	quest.7912121EAE5F47E8.title: "进步的成本"
	quest.79ADA1FFACFF66C3.quest_desc: [
		"我找到了一份包含T.O.M.拾荒研究的旧生存数据库。"
		""
		"如果我打算活下去，就需要这些信息……"
		""
		"真想知道这些到底被读过多少次了……"
	]
	quest.79ADA1FFACFF66C3.quest_subtitle: "任何人都可以知道。重点在于理解。 - 阿尔伯特·爱因斯坦\""
	quest.79ADA1FFACFF66C3.title: "Database/access/scavenging.db"
	quest.7A570200126C1914.quest_desc: [
		"[SYSTEM_TIP]"
		""
		"ME 系统离线期间数字存储箱将无法访问，但 &oME 合成终端&r 的物理接口仍能作为独立的合成台使用。"
		""
		"即使没有系统电源，你仍然可以用它的表面进行手动合成。"
	]
	quest.7A570200126C1914.quest_subtitle: "“机器的灵魂或许会消逝，但工作台对黑暗始终如一。” - T.O.M."
	quest.7A570200126C1914.title: "合成配方"
	quest.7C0ED935157CF52C.quest_desc: [
		"电弧炉轰鸣着运转起来，吞噬着盔甲，吐出闪闪发光的纯铁锭。"
		""
		"毁坏一套完好无损的护具实在可惜，但我无法用拳头凿开外面的冰冻大地。"
		""
		"我需要制作一个&o铁质钻头&r。"
		""
		"我需要把一些铁压缩成实心块用作核心，剩下的用来做切割刃。"
		""
		"这是我能联系到外界的唯一方法了。"
	]
	quest.7C0ED935157CF52C.quest_subtitle: "“凤凰必先自焚，方能浴火重生。” - 奥克塔维亚·E·巴特勒"
	quest.7C0ED935157CF52C.title: "Repurposed Metal"
	quest.7F1C1CD042C258EE.quest_desc: [
		"散落在旧世界表面的，是人类的遗迹。"
		""
		"这些遗址拥有原始技术，但缺乏设施所需的精密程度。"
		""
		"它们被“出埃及记”计划当作杂物丢弃了。"
		""
		"但对于野外技术人员来说，这些“无用”的部件提供了至关重要的基础。"
		""
		"利用他们留下的东西，加工并使用它们。"
		""
		""
		"{image:minecraft:item/iron_door width:50 height:50 align:center}"
	]
	quest.7F1C1CD042C258EE.quest_subtitle: "“这是一个为人类的缺席而非存在而建造的环境。” - J.G. 巴拉德"
	quest.7F95C3351EC78A28.quest_desc: [
		"钻头已经准备好，但油箱是空的。"
		""
		"在这个世界，原金属可能并不常见，但燃料却是一种奇迹。"
		" "
		"我记得在&o工程舱&r里看到过少量储备的&o生物柴油&r"
	]
	quest.7F95C3351EC78A28.quest_subtitle: "“希望是唯一比恐惧更强大的东西。” - 苏珊·柯林斯"
	quest.7F95C3351EC78A28.title: "一位老朋友"
