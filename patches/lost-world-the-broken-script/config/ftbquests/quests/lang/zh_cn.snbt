	quest.3FEEA74E9B7526EB.quest_desc: [
		"0nullvoid0 开始写日记，并在休息两周后注意到服务器上出现了一个新结构。它看起来像一个由各种新方块建造的祭坛。"
		""
		"但他没多想就继续前进了，尽管在那座建筑出现后，他经历了严重的卡顿。"
		""
		"后来，他决定为所有成员建造一个基地 - &l\"氏族必须壮大\"&r"
	]
