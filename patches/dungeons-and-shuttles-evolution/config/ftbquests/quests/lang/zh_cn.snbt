	file.0000000000000001.title: "地牢与穿梭：进化版"
	quest.000193AA8BF1C635.quest_desc: ["熔炼 Electrotine 铁化合物以获得 Electrotine 合金锭。"]
	quest.001C93E964AF3BF5.quest_desc: ["还有更多其他东西……"]
	quest.001C93E964AF3BF5.title: "无尽钻头 #2"
	quest.0023FC148D6EA670.quest_desc: ["漏斗会自动在容器之间移动物品。它能从上方吸入物品并转移到下方的物品栏中，使自动化变得简单高效。"]
	quest.005756454C330F88.quest_desc: ["电池盒是储存电力的好方法。但要让它能使用电力，你必须右键将电池放置其上。这样它就能在电池本身储存能量了。"]
	quest.0072F08C927B5DD5.quest_desc: [
		"威龙胸甲本身实用性很低。把它看作一个高科技底盘，需要仔细配置和升级才能发挥其全部潜力。"
		""
		"&a配置：你必须打开 Draconic Evolution HUD（默认键：Shift+A）来调整你的盔甲设置。"
		""
		"&a能量：没有能量的话，这身盔甲毫无用处。进入战斗前，请确保已完全充满电。"
		""
		"&a升级：要解锁飞行、护盾或速度等功能，必须通过融合合成安装升级模块。"
		""
		"先别担心模组，随着任务进程的推进，你会学会制作这些高级升级。"
	]
	quest.007890EE1CA8101A.quest_desc: ["这是一个简单的物品。用于某些配方中。"]
	quest.009E64FECB66DFAB.quest_desc: ["炼药锅可以装水、岩浆或粉末雪。可用于填充瓶子、给物品染色或收集雨水。"]
	quest.00A391B6572BB5B0.quest_desc: [
		"铸造台需与熔炉配合使用，以制作金属工具、锭及其他金属物品。它必须放置在熔炉出料口下方才能工作。"
		""
		"铸造盆也是熔炉的一部分，用于将熔融材料制成方块。与铸造台一样，它需要熔炉出料口的连接。"
	]
	quest.00A391B6572BB5B0.title: "铸造台 \& 盆子"
	quest.00CBC7C5A2861B93.quest_desc: ["合成几个光伏复合材料。"]
	quest.00CBC7C5A2861B93.title: "光伏复合材料"
	quest.00D03EE4E38712F9.quest_desc: ["将机器效率提升至 Inferium 之上。"]
	quest.00D7E7C191553DA6.quest_desc: ["在合成网格中组合 2 个碳纤维以获得碳纤维网。"]
	quest.00D7E7C191553DA6.title: "碳质网格"
	quest.00DC277004D44508.quest_desc: ["这种材料拥有 Allthemodium 级别的挖掘能力，可以破坏 Minecraft 中遇到的任何矿石！"]
	quest.00E6AB4395F9B8E9.quest_desc: [
		"在末地发现的稀有矿石。使用Neptunium级或以上工具挖掘，以解锁强大的合成配方。"
		""
		"&a💡 提示：这种矿石可以在末地找到，但不在主岛上。你需要探索末地的外围岛屿才能找到它。"
	]
	quest.00E6AB4395F9B8E9.title: "Allthemodium 矿石！"
	quest.014566455020269D.quest_desc: ["终极炖菜主要用于制作无限催化剂。"]
	quest.01756E8D47642D5C.quest_desc: [
		"要到达水星，需要普通火箭模型。"
		""
		"&c返程时你需要带上另一个火箭发射台。"
	]
	quest.0188394757EF0000.quest_desc: ["制作一个铜质胸甲。"]
	quest.01930B5305950769.quest_desc: [
		"在 Infernal Venus Barrens 的深处，有一种传奇材料：Vibranium。它是高端工程的基石，也是备受青睐的 Unobtainium-Vibranium Alloy 的关键组件（详情请参阅 Ores and Alloys Tier 2）。"
		""
		"重要指令：探险期间必须收集大量金星沙。没有它，就无法提炼振金。"
		""
		"&a💡 提示：位于 Y=-64 和 Y=29 的层之间。"
		""
		"&a群系：仅在 Infernal Venus Barrens 中生成。"
	]
	quest.01930B5305950769.title: "振金矿石！"
	quest.01A0A6123E82A0BB.quest_desc: ["合成几个铝土矿种子。"]
	quest.01A0A6123E82A0BB.title: "铝土矿种子"
	quest.01C1F7F239DB3D14.quest_desc: ["好的，我们继续下一个任务……姜！"]
	quest.01C1F7F239DB3D14.title: "姜（Ginger）"
	quest.01D66AF2EB888814.quest_desc: ["用于制作美味佳肴。大多数食谱需要碗或有时需要玻璃瓶。确保在下方放置火等热源！"]
	quest.01E91ECCCF46DDDF.quest_desc: [
		"地表是一片单调的荒原，遍布着巨大的陨石坑和耸立着高耸嶙峋的灰色山脉。这是一个极端的世界，阳光下炙烤，阴影中冰冻。"
		""
		"这片荒凉的外表下，隐藏着复杂的洞穴网络。深处富含铁和铀。小心脚下，地形和辐射一样无情。"
	]
	quest.01FA4C31E3FED61F.quest_desc: ["黑暗力量宝石做的碗？:) 管他呢，合成一个空口承诺碗。"]
	quest.020D6B268FA35118.quest_desc: ["收获完全成熟的翡翠种子植物后，你会得到翡翠精华。"]
	quest.020D6B268FA35118.title: "翡翠精华"
	quest.020E2194F25648F8.quest_desc: ["既然你已经开始生成RF，就需要一种高效存储的方法。能量立方体正是完美的解决方案！它能储存大量能量，并在需要时将其分配给机器。"]
	quest.023891A8B88EBAAA.quest_desc: ["T9太阳能电池板超赞。一次建造两个。接收光照时可产生8,388,608 RF/FE/秒！"]
	quest.023891A8B88EBAAA.title: "中子星太阳能板！"
	quest.023CF9D36D2E9BAA.quest_desc: ["购买一些奖励吧！"]
	quest.023CF9D36D2E9BAA.title: "羊驼生成蛋"
	quest.025257E7CCBAB7A7.quest_desc: [
		"要推进此任务线，你必须达到行星探索的所需阶段。目前进度被两个关键里程碑所锁定："
		"- 金星"
		"- 火星"
		""
		"如果卡住了，请咨询主线任务，确保你的太空计划进度跟上。不要掉队！"
	]
	quest.0267217DF3E51D7B.quest_desc: ["用你的血液提取器，你可以在世界放置液态血液。如果暴露在雨中，它最终会硬化成硬化血液。用燧石和钢镐破坏时，这些方块会掉落硬化血液碎片。但如果雨水淋上它们，它们会重新变成液态血液。"]
	quest.0267217DF3E51D7B.title: "硬化血液碎片"
	quest.02D6E4C31CD2F560.quest_desc: ["有了神秘农业，你可以种植和培育几乎所有需要的材料。从 Inferium 开始，逐步升级到强大的精华作物！"]
	quest.02D6E4C31CD2F560.title: "&e更多 Inferium！"
	quest.030797D416F60C06.quest_desc: ["黑曜石TNT用黑曜石加固以增强强度。也制作一个吧。"]
	quest.0324642571A1789A.quest_desc: [
		"在开始发电之前，我们需要一点红石。"
		""
		"&a💡 提示：如果没在别处找到铁镐，你应该解锁铁匠铺来制作一个。"
	]
	quest.0324642571A1789A.title: "一点红石电路的知识"
	quest.036743802C8BD34C.quest_desc: ["合成几个钛种子。"]
	quest.036743802C8BD34C.title: "钛合金种子"
	quest.03BDB210A37C8D97.quest_desc: ["收集末地石并将其粉碎。"]
	quest.03BDB210A37C8D97.title: "末石粉尘"
	quest.03F46F1FAA0227BF.quest_desc: [
