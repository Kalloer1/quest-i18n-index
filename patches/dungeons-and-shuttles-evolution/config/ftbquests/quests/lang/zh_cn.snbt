	quest.6315DB46F5B42C0D.title: "烈焰粉！"
	quest.631B14A7C84E5C32.quest_desc: ["购买一些奖励吧！"]
	quest.631B14A7C84E5C32.title: "战利品袋"
	quest.632AF429F9DF1F62.quest_desc: ["你可以使用材料液化器来熔炼宝石。"]
	quest.6369A77752A57F91.quest_desc: ["购买一些奖励吧！"]
	quest.6369A77752A57F91.title: "土豆们"
	quest.63B56E54F97F6E57.quest_desc: [
		"爆炸工程的一大步提升。"
		"蓝色炸弹的引爆有轻微延迟，爆炸范围也更广——但它仍然不会留下弹坑。"
	]
	quest.63BEFCE54D608F1C.quest_desc: [
		"强化锤子！"
		""
		"&a💡 提示：如果不知道如何生产钢，请遵循本章：&o“矿石与合金”"
	]
	quest.63CA3629DBDA15E7.quest_desc: [
		"创造灵气并将其反馈回环境的方法有很多。"
		""
		"&a💡 提示：当然，Nature's Aura 也添加了自动化此类流程的方法。"
	]
	quest.63D9B03D178D5D8D.quest_desc: ["制作杯镍需要在熔炉或更高级的合金冶炼厂中，将退火铜和镍锭组合在一起。"]
	quest.63D9B03D178D5D8D.title: "杯镍合金"
	quest.63DB393C1AD541FB.quest_desc: ["将4个线合成一块白色羊毛。找不到附近绵羊时的实用技巧！"]
	quest.63DB393C1AD541FB.title: "白色羊毛块"
	quest.63EB8F4F81F98D27.quest_desc: ["米面团是一种组件。可用于制作生米面包。"]
	quest.63EB8F4F81F98D27.title: "米面团 (Rice Dough)"
	quest.63F4C947BC1F4D6B.quest_desc: ["使用陶土桶来生产一些淡水。"]
	quest.63F4C947BC1F4D6B.title: "淡水"
	quest.64281EF62AE96CDA.quest_desc: [
		"乌鲁金属是现存最强大、最稀有的金属。"
		"其惊人的耐久度和能量共振使其强度无与伦比——非常适合传奇级工具和盔甲。"
		"锻造它需要奇特的材料、流体合金，以及可能只有少数人见过的神话组件。"
		""
		"完成旅途并不需要这些材料——但对于追求真正精通的人来说，这是最后的考验。"
		""
		"&a(当然，还有比这强得多的材料。)</c1>"
	]
	quest.64281EF62AE96CDA.title: "乌鲁金属锭！"
	quest.643A48E9E5C7366C.quest_desc: ["收获完全成熟的煤炭种子植物后，你会得到煤炭精华。"]
	quest.643A48E9E5C7366C.title: "煤炭精华"
	quest.645480FD6047F235.quest_desc: ["近乎最大化的机器输出的顶级升级。"]
	quest.6460BAE91B56EFE2.quest_desc: ["高级电路可用于多种中高级制作配方，例如 Empowerer 和 stc！"]
	quest.6460BAE91B56EFE2.title: "&c高级电路！"
	quest.649A700DE88F345D.quest_desc: [
		"硫磺是由各种模组添加的一种非金属。找到一些硫磺矿脉，尽可能多地收集吧。"
		""
		"提示：(Y轴高度 = 55至80) 硫磺矿石看起来像黄色安山岩。"
	]
	quest.649A700DE88F345D.title: "硫磺"
	quest.64B90F7AD1E944BE.quest_desc: ["龙之核心是龙之进化的重要合成材料。它用于许多配方，也可将生物生成器稳定化为稳定生物生成器。"]
	quest.64CE7A077DB6829F.quest_desc: ["鸡蛋是一种用途广泛的食材，可用于多种食谱。它是任何厨房的必备品！"]
	quest.64CE7A077DB6829F.title: "鸡蛋"
	quest.64FC77D656FAC3E2.quest_desc: ["数据存储核心是制作数据存储芯片和终极电路所需的专用组件。也用于一些需要关键数据处理的高级机械中。"]
	quest.65935C0EA92D8F7B.quest_desc: ["切割机能让你获得更好的螺栓、齿轮、环和杆的比率。每次使用时会消耗少量润滑剂。"]
	quest.659A05BA1DBC7D4A.quest_desc: ["腐肉可以做成一道非常美味的菜肴。"]
	quest.659A05BA1DBC7D4A.title: "肝脏和洋葱"
	quest.65B2DC6C3DAF0E66.quest_desc: ["制作几个僵尸种子。"]
	quest.65BA69CEDE2D3A2A.quest_desc: [
		"用于制作第5阶精华种子。"
		"无法种植，仅能用作更高级作物的合成材料。"
	]
	quest.65BA69CEDE2D3A2A.quest_subtitle: "种子合成配方"
	quest.65C560B0E21E4BFD.quest_desc: [
		"正在铸造... 铸造成功 :)"
		"提示是对你现有工具的增强功能。"
	]
	quest.65C560B0E21E4BFD.title: "剑"
	quest.65CDE4DE6A5F94A6.quest_desc: ["MMU 是一种用于高级机器和电路组件的关键电子元件。它负责数据控制和内存访问。"]
	quest.65CDE4DE6A5F94A6.title: "内存管理单元"
	quest.65DC499CEDE5DB3A.quest_desc: ["制作几个铝种子。"]
	quest.66523A5E045CD33F.quest_desc: ["购买一些奖励吧！"]
	quest.66523A5E045CD33F.title: "战利品袋"
	quest.667F2802B79F702A.quest_desc: ["钻石宝箱所在的空间的同一位置。"]
	quest.6682F3288652BC40.quest_desc: ["制作一个铝土矿镐头，这是挖掘铋和钴等更坚硬矿石所必需的。"]
	quest.66B00FAAFD55D1BE.quest_desc: ["在化学反应器中使用大量硫酸和铂，你将得到铂硫酸液体。"]
	quest.66B00FAAFD55D1BE.title: "铂硫酸 #6"
	quest.66BD505148BCFB12.quest_desc: ["硅晶圆是高级电子元件的关键材料，用于制作电路和高新技术组件。"]
	quest.66BD505148BCFB12.title: "硅晶圆？"
	quest.66BD6E891AD85DF2.quest_desc: [
		"Wyvern 弓使用 RF/FE 进行充能和射击，最多可储存 100 万 RF。它提供了多种选项来定制玩家的弓。"
		""
		"Wyvern之剑使用RF/FE进行充能和施放，最多可储存100万RF。它有一个范围伤害选项，可以在首次命中后攻击3x3范围内的生物。"
		""
		"&c需要升级的模块！"
	]
	quest.66BED23BEF96D9B3.quest_desc: ["处理器被用于无数设备和机器中。"]
	quest.66BED23BEF96D9B3.title: "逻辑处理器"
	quest.6705E63052B6CF47.quest_desc: ["面包是最基础的食物。"]
	quest.6705E63052B6CF47.title: "面包"
	quest.67156219805EC64A.quest_desc: ["适合强大精华种子的肥沃土壤。可解锁更强的资源生长。"]
	quest.6728F445599635DE.quest_desc: ["制作一双钢制靴子。"]
	quest.673BACAF0E9373B9.quest_desc: ["收集一些物品，为即将到来的重要步骤做好准备。"]
	quest.673BACAF0E9373B9.title: "自然资源"
	quest.673F89F58FF466CD.quest_desc: ["计算处理器需要 Certus Quartz 晶体！"]
	quest.674E53C384A9B7BD.quest_desc: ["这个重型头部可用于制作能在3×3区域内采矿的锤子。将其与手柄和部件结合，即可打造出能一次性破坏多个方块的工具——非常适合快速清理石头和矿石。"]
	quest.675C4AAE26058F59.quest_desc: [
		"铁栅栏是建造安全基础设施的第一步。"
		""
		"&9Upon completion of this quest you will unlock the chapter: &o\"Protect the Earth\""
	]
	quest.675C4AAE26058F59.title: "&9解锁：&6&l保护地球"
	quest.6790641A6C33FD37.quest_desc: [
		"神圣契约是最难获得的物品之一。你需要深入探索猪灵村庄和远古金字塔才能获得它。"
		"这是制作灵魂绑定水晶的关键材料！"
	]
	quest.67AE3958EE5DD8BD.quest_desc: ["下界之星精华可用于制作下界之星碎片，进而转化为下界之星。"]
	quest.67AE3958EE5DD8BD.title: "下界之星"
	quest.680E799BAD6F52E1.quest_desc: [
		"Rolling Machine 用于生产各种线圈，以及铁轨和矿车等原版物品。它需要 &9Electronic Circuit&r，你无法在任务中制作它，但它之后也会至关重要。"
		""
		"&a💡 提示：用扳手拆解这台机器！强烈建议你在继续之前，先推进一下章节 &9&o\"矿石与合金 II\"。 &r&a"
	]
	quest.680E799BAD6F52E1.title: "&eRolling Machine"
	quest.6826712B89B85BBF.quest_desc: [
		"叶生成器只需放置在树叶旁边就能产生RF。"
		"它会摧毁树叶，每破坏一片树叶生成 300 RF。"
	]
	quest.68520168C6DDDD11.quest_desc: ["你可以通过粉碎金叶来获得金叶子。"]
	quest.68520168C6DDDD11.title: "金叶子！"
	quest.6853C066E44F5E5D.quest_desc: [
		"本任务书将一步步引导你完成这款充满挑战与乐趣的专家级整合包。基于传奇的 &6&lDDSS &rmodpack，&6&lDaSE &r为你带来重制配方、更严峻挑战和更丰厚回报的全新体验。"
		""
		"每个任务的难度决定了你获得的奖励：更难的任务能提供更好的战利品！完成任务后，你将赚取金币，可用于在任务商店中购买商品。"
		""
		"硬币等级："
		"&6T1 - 铜币"
		"&7T2 - 铁币"
		"&eT3 - 金币"
		"&bT4 - 钻石硬币"
		"&aT5 - 绿宝石硬币"
		"&9T6 - 下界合金硬币"
	]
	quest.6853C066E44F5E5D.quest_subtitle: "DaSE 简介"
	quest.6853C066E44F5E5D.title: "&l&2欢迎来到《地牢与穿梭：进化版》"
	quest.686224352F5A16FB.quest_desc: ["以更快速度和更广范围滋养你的作物。"]
	quest.68634EA7AAD7EECE.quest_desc: ["首先，用你的新剪刀找些绵羊来获取羊毛。"]
	quest.68634EA7AAD7EECE.title: "床所需的羊毛方块 (Wool for the Bed)"
	quest.6882BBB73170E74C.quest_desc: ["钻头可以通过各种升级进行增强。速度增强器在使用时可暂时提高挖掘速度。"]
	quest.6882BBB73170E74C.title: "更多钻头升级！"
	quest.68959C3B91300F5F.quest_desc: [
		"此物品可在设定范围内吸引附近的物品和XP球。右键可调整范围，Shift+右键可开启/关闭。吸引近处物品消耗极少或无需消耗血液，而远距离吸引则需要更多。潜行可防止吸引物品。"
		""
		"反向合成会生成相反的版本，该版本会排斥物品和经验球。"
	]
	quest.68A5FEA80EA07B53.quest_desc: ["由干肉、浆果和脂肪制成的营养生存食品。持久耐饿，能量满满——非常适合长途旅行或艰难战斗。"]
	quest.68A5FEA80EA07B53.title: "Pemmican"
	quest.69280F5FAACEC6AD.quest_desc: ["此物品会将抽屉变为虚空抽屉，一旦装满，所有放入的物品都会消失。"]
	quest.6955E1C44446B6BC.quest_desc: ["购买一些奖励吧！"]
	quest.6955E1C44446B6BC.title: "兔子生成蛋"
	quest.6957034FB6916226.quest_desc: ["制作一个 Electrotine 发电机。"]
	quest.69718F18EF6B96C0.quest_desc: [
		"电弧炉是一个巨大的5×5×5多方块结构，能处理大量矿石、合金和高级材料。它使用电极和稳定的电力来高效运行。配置得当，它甚至能将矿石产量翻倍，并处理小型机器无法完成的特殊配方。"
		""
		"做好准备，这会消耗大量的钢铁！"
	]
	quest.69718F18EF6B96C0.title: "电弧熔炉"
	quest.697D49A54C1EC304.quest_desc: ["用于组装机器组件并为采矿钻和左轮手枪等工具应用升级的专用工作台。每位工程师的必备品！"]
	quest.69A0BD8AF23AAB60.quest_desc: ["你需要更多的铜锭！"]
	quest.69A0BD8AF23AAB60.title: "更多铜矿石！"
	quest.69BB80092BE7A0ED.quest_desc: [
		"高级工作台开启了通往强大工具和复杂机器的道路。"
		"有了这张桌子，你就能创造远超基础知识的配方了。"
		"制作你的第一个高级工作台，解锁高级科技！"
	]
	quest.69BB80092BE7A0ED.title: "&a高级合成？"
	quest.69E92D48F72B0D3C.quest_desc: [
		"在 Stellaris 中，你需要火箭发射台才能将你的宇宙飞船送入太空。"
		"放置9个方块组成3×3的正方形，创建一个可用的发射台。"
	]
	quest.69E92D48F72B0D3C.title: "发射台"
	quest.6A0A0A258208DDD4.quest_desc: ["1k ME 存储组件用于制造 1k ME 存储单元或更高级别的存储组件。"]
	quest.6A385D1D161076A8.quest_desc: ["如你所愿，让我们开始你的首次升级。要开始定制装备，你首先需要制作所有增强项的基础：模块核心。"]
	quest.6A385D1D161076A8.title: "模块核心"
	quest.6A4EF2362880CD1F.quest_desc: ["购买一些奖励吧！"]
	quest.6A4EF2362880CD1F.title: "绵羊生成蛋"
	quest.6AB622B2A7D017E4.quest_desc: ["XyCraft 宝石深藏于地下，有三种鲜艳的颜色。"]
	quest.6AB622B2A7D017E4.title: "红色 Xychorium 宝石"
	quest.6ABBA7DBFD78B212.quest_desc: [
		"原子重构器是 Actually Additions 模组中一台使用 RF 能量，通过激光束将各种方块和物品转化的关键机器。该机器对于制作 Restonia 晶体和其他高级材料等许多配方都至关重要。"
		""
		"&a💡 提示：Actually Additions 有官方网站，上面有更详细的机器和功能说明与指南。请访问：&ohttps://ellpeck.de/actaddmanual/"
	]
	quest.6ABBA7DBFD78B212.title: "原子重组器 (Atomic Reconstructor)"
	quest.6AC3D00CF9C4F860.title: "Vindicator 猎人"
	quest.6B41704F591ABDD6.quest_desc: ["用 Infusion Crystal 合成 Intermedium Essence。"]
	quest.6B41704F591ABDD6.title: "Tertium Essence"
	quest.6B44938AC91E8553.quest_desc: ["菜籽油可用于油发电机。其GUI会显示发电量，但可以进一步升级以获得更多电力！破坏油发电机时，内部的液体将保留下来。"]
	quest.6B44938AC91E8553.title: "力量！"
	quest.6B4FA513A5E57E44.quest_desc: ["使用冶金注入器以获得精炼黑曜石粉尘。"]
	quest.6B4FA513A5E57E44.title: "精炼发光石锭"
	quest.6B5825FB58ED37EF.quest_desc: ["氧气分配器可以让你用氧气填满一个房间。为此，请将装满氧气的氧气罐与水分离器放置在一起。"]
	quest.6B73159629246DC0.quest_desc: ["好的，我们继续下一个任务……茄子！"]
	quest.6B73159629246DC0.title: "Eggplant"
	quest.6B7375520ECCC07F.quest_desc: [
		"骨粉是快速种植作物、树木和草地的方法。"
		"将植物堆肥以获得更多的骨粉！"
	]
	quest.6B7375520ECCC07F.title: "高效制作骨粉！"
	quest.6B9B40FDE83C6C4B.quest_desc: [
		"手中有最后5个重型工程方块，你现在拥有一切所需来建造电弧炉！"
		"查看工程师手册了解具体结构，并使用投影仪辅助建造。"
		""
		"&a💡 提示：建造完成后，用工程师之锤右键点击炼药炉即可组装多方块结构！"
	]
	quest.6B9B40FDE83C6C4B.title: "最终组装：电弧炉 (Arc Furnace)"
	quest.6BA0C5C095916F83.quest_desc: ["高级机器框架用于制作高级机器外壳。"]
	quest.6BA0C5C095916F83.title: "机器框架"
	quest.6BB096D8B3508336.quest_desc: [
		"献给众神的祭品是一个由1个祭品台和36朵花组成的多方块结构。"
		"要制作祭品，你需要召唤之魂。"
	]
	quest.6BC4D21D82ADB034.quest_desc: ["Infinity Catalyst 用于制作模组中的许多工具和组件，包括 Infinity Ingot。"]
	quest.6BC4D21D82ADB034.title: "Infinity Catalyst"
	quest.6BC7C0584B32A536.quest_desc: ["强化玻璃是 Tech Reborn 添加的一种不透明方块。由于其极高的爆炸抗性，这种材料非常适合建造特殊机器。"]
	quest.6BC7C0584B32A536.title: "强化玻璃"
	quest.6BCDA8148F61FDD0.quest_desc: ["升级后的太阳能电池板能产生惊人的 512 FE/刻，是目前最强大的被动能源之一。把它放在阳光下，就能享受源源不断的能量——完全无需维护！"]
	quest.6BD4B66EF8EE2EED.quest_desc: [
		"Refined Storage 让物品的存取变得轻松快捷。要开始使用，你需要 &6处理器绑定&r——这是用来制作系统核心：处理器的重要组件。"
		"没有绑定，没有自动化！"
	]
	quest.6BD4B66EF8EE2EED.title: "Refined Storage"
	quest.6BF005B1CC048699.quest_desc: ["制作一个基础网格。它由不同材料制成，材料越贵重，耐久度就越高。"]
	quest.6C03F95FD5C57A3D.quest_desc: ["购买一些奖励吧！"]
	quest.6C03F95FD5C57A3D.title: "甘蔗 (Sugar Cane)"
	quest.6C4AF7F969021C94.title: "凋零猎人"
	quest.6C5D2C13AB6A0905.quest_desc: ["我稍后会用到暗钢锭。先做一些这个。"]
	quest.6C5D2C13AB6A0905.title: "暗钢 (Dark Steel)"
	quest.6C64311984860BD1.quest_desc: ["此材料为黑曜石等级。这意味着你可以用它来提取黑曜石。"]
	quest.6C75B5ACCF2DAAE2.quest_desc: ["购买一些奖励吧！"]
	quest.6C75B5ACCF2DAAE2.title: "燧石"
	quest.6C7D3B52B2163910.quest_desc: ["60k NaK冷却单元是一种主要用于合成的冷却剂。"]
	quest.6C7D3B52B2163910.title: "60k NaK 冷却剂单元"
	quest.6C81BFD6429546B5.quest_desc: [
		"热交换器用于将气体、液体或高温物品冷却至极低温度。"
		"你可能已经知道这也是一个多区块结构。你需要在主结构中安装不同的舱口，才能使其正常运行。"
		""
		"&a💡 提示：将MI扳手靠近已放置的机器，它会显示多方块结构和组装方法。"
	]
	quest.6C81F9D8A05451EE.quest_desc: ["鸡蛋三明治，嗯，听起来不错。"]
	quest.6C81F9D8A05451EE.title: "鸡蛋三明治"
	quest.6C8DB253852755A3.quest_desc: ["将 Cryonite Powder 放入 Material Liquefier 可获得 Cryofluid。Cryofluid 是一种极冷的液体，主要用于高级冷却应用和高端机械。"]
	quest.6C8DB253852755A3.title: "Cryofluid 桶"
	quest.6C8E93FC8C0D2F21.quest_desc: ["白色魔法粉尘是一种经过提纯的魔法物质，用于许多高级仪式和合成配方中。"]
	quest.6C8E93FC8C0D2F21.quest_subtitle: "&9解锁：&f&l白色魔法 - 二级。"
	quest.6CB3C6A46AB2B3EC.quest_desc: ["Inferium Ingot 是制作高级工具和盔甲的关键材料。使用 Prosperity Shards 和 Inferium Essence 来制作这种神秘资源，解锁新的可能性！"]
	quest.6CB3C6A46AB2B3EC.title: "Inferium 锭"
	quest.6CD5E9E490419558.quest_desc: ["Enervator会释放含有CF/FE/RF的物品，并将能量储存在其能源供应中。"]
	quest.6D0D82B93E26D534.title: "Grottol"
	quest.6D50658B450D918E.quest_desc: ["将沙质玻璃熔炼以获得沙质玻璃粉尘。"]
	quest.6D50658B450D918E.title: "沙质玻璃粉尘"
	quest.6D60AC68218E5870.quest_desc: ["用于需要Supremium essence的强大合成配方中。"]
	quest.6D60AC68218E5870.quest_subtitle: "&9解锁：&5&l神秘农业三级。"
	quest.6D836B97A678E180.quest_desc: ["用聪明的方法把原木变成木板！不用锯子，每根原木能制作2块木板。但用锯子，效率会翻倍，每根原木能制作4块木板。要动脑，不要蛮干！"]
	quest.6D836B97A678E180.quest_subtitle: "高效合成 #1！"
	quest.6D836B97A678E180.title: "木板"
	quest.6DC3CB2C579BFA1A.quest_desc: ["收获完全成熟的钨种子植物后，你会得到钨精粹。"]
	quest.6DC3CB2C579BFA1A.title: "钨精矿"
	quest.6DCD407BE1435FCF.quest_desc: ["铜质储罐是你的下一层级流体储罐，可储存32桶（32,000 mB）流体。"]
	quest.6DEDFEDD06E5DDC3.quest_desc: ["肉喂食器是工业向前模组添加的物品。它能在玩家背包中自动保持饱食度。肉喂食器需要液态肉来运行，可以通过右键点击储罐来填充或清空。当玩家的饥饿度或饱食度低于满格时，肉喂食器会消耗400 mB液态肉，恢复1/2格饥饿度和1格饱食度。"]
	quest.6E04832112087146.quest_desc: ["蓝宝石是 Tech Reborn 模组添加的一种宝石。收集更多吧！"]
	quest.6E04832112087146.title: "蓝宝石！"
	quest.6E076915DC8463C3.quest_desc: ["购买一些奖励吧！"]
	quest.6E076915DC8463C3.title: "试管 (Test Tubes)"
	quest.6E1A4F0AF89A8BD7.quest_desc: ["升级套件是用于逐步将现代工业化机器升级到更高级别的物品。"]
	quest.6E3B1AF6599B97AF.quest_desc: ["可以使用翡翠精华来制作翡翠锭。"]
	quest.6E3B1AF6599B97AF.title: "Emerald"
	quest.6E54B1CE9D7ABE7C.quest_desc: ["该专用模块可在运行期间自动清除不需要的副产品，保持矿车的液体储罐干净且功能正常。"]
	quest.6E54B1CE9D7ABE7C.title: "Pump"
	quest.6E6CA5A0DD5E4D0D.quest_desc: ["你可以在下界顶部找到大多数发光石。"]
	quest.6E6CA5A0DD5E4D0D.title: "萤石！Glowstone!"
	quest.6E8D115D6AAC5A96.quest_desc: ["合成一把铁剑。"]
	quest.6EB949A1D701043C.quest_desc: ["Applied Energistics 2 主打智能存储和自动化。首先，我们需要制作两种核心资源：&9Certus Quartz Crystals&r 和 &dFluix Crystals&r。它们将成为我们 ME 系统的核心，所以多备几个备用！"]
	quest.6EB949A1D701043C.title: "Applied Energistics"
	quest.6EC29641D10E1420.quest_desc: ["购买一些奖励吧！"]
	quest.6EC29641D10E1420.title: "鸡蛋"
	quest.6ED88C970BEB060B.quest_desc: ["操作高级机械前，必须准备好合适的清洁组件。这些工具能确保机器得到安全高效的维护。"]
	quest.6ED88C970BEB060B.title: "洁净室协议"
	quest.6EEFDBCE987FA053.quest_desc: ["黄金可用于制作红石组件、工具和魔法物品。它很稀有，所以能挖就挖吧！"]
	quest.6EEFDBCE987FA053.title: "黄金"
	quest.6F16929C945D5AA1.quest_desc: ["铱的生产很复杂，但掌握它是推进后期科技的关键！"]
	quest.6F28E89B4E32ED6C.quest_desc: ["购买一些奖励吧！"]
	quest.6F28E89B4E32ED6C.title: "铜制工具"
	quest.6F3972FB0E363797.quest_desc: ["购买一些奖励吧！"]
	quest.6F3972FB0E363797.title: "箭矢"
	quest.6F43971FB11E56BD.quest_desc: ["由 EvilCraft 添加的 Dark Gem。可在 Y 坐标 0 到 66 的高度找到。"]
	quest.6F43971FB11E56BD.title: "黑暗宝石"
	quest.6F52C57067B1B031.quest_desc: ["别担心——现在用3个恒星碎片和1个下界之星，就能将量子捕手升级为强大的首领捕手。"]
	quest.6F652E02A6F1186C.quest_desc: ["ME 驱动器允许用户存储多达 &b10 个 ME 存储单元&r，而 ME 箱子只能放置单个单元。"]
	quest.6FA675FB33E07F85.quest_desc: ["破碎机将固体材料研磨成粉尘。"]
	quest.6FA675FB33E07F85.title: "又一个破碎机？"
	quest.6FCC9414CC5CC661.quest_desc: ["好吧，那就做两个出来吧！"]
	quest.6FCC9414CC5CC661.title: "基础抽屉"
	quest.6FCC99CCE5839282.quest_desc: ["收获完全成熟的硅种子植物后，你会得到硅精粹。"]
	quest.6FCC99CCE5839282.title: "硅质精华"
	quest.6FCDE84C526DD384.quest_desc: ["好，来试试我们的新机器，放一桶水进去然后等着。"]
	quest.6FCDE84C526DD384.title: "盐块"
	quest.6FE0AA1C3428663E.quest_desc: [
		"然而，当涉及到下界维度时，普通的骨粉效果就不那么好了。"
		""
		"不过，这个问题可以通过使用绯红粉轻松避免。"
		""
		"这种物质不仅能像骨粉一样，让任何下界疣植物生长得更快"
	]
	quest.6FE0AA1C3428663E.title: "绯红美食"
	quest.6FF2673F0F976AB0.quest_desc: ["这只是一个粉末而已……"]
	quest.6FF2673F0F976AB0.title: "粉末状无存储物品"
	quest.701AAC457D7BBF21.quest_desc: [
		"使用原子重构器，你可以将普通铁锭转化为高级科技的关键组件——Enori水晶。"
		"使用原子重构器，你可以将普通的铁锭方块转化为 Enori 水晶方块。"
	]
	quest.701AAC457D7BBF21.title: "Enory 水晶"
	quest.704753A709AB20F1.quest_desc: ["高级控制电路的升级版，用于许多高级机器和组件中。价格不菲——最好在装配器中制作以节省材料！"]
	quest.7048F9382CDA5C6C.quest_desc: ["用于配置机器、旋转方块以及在沉浸式工程（Immersive Engineering）中构建多方块结构。"]
	quest.7053A2BF448AB0C1.quest_desc: ["基础模块有多种等级，是完成各种疯狂事情所必需的。"]
	quest.709711254B30FD92.quest_desc: ["好的，我们继续下一个任务……辣椒！"]
	quest.709711254B30FD92.title: "墨西哥辣椒"
	quest.70E3D43910AC7953.quest_desc: [
		"退火铜是通过加热铜然后缓慢冷却制成的，使其更柔软、更易于加工。"
		"在高炉中将其炼制出来。"
	]
	quest.70E3D43910AC7953.title: "退火铜"
	quest.70E8A53D23B12FA0.quest_desc: ["LV 电线连接器用于将低压 (LV) 电线连接到机器和电源。将其放置在方块上，右键单击以连接 LV 电线线圈。"]
	quest.70E8A53D23B12FA0.title: "LV 电线连接器"
	quest.70EE5EE4A6212B62.quest_desc: ["钻石箱子提供的存储空间比铁箱子或金箱子大得多，是一次巨大的升级。"]
	quest.7102081CA7384A67.quest_desc: ["铋矿石自然生成于下界，外观呈红橙色，与钴矿石相似。"]
	quest.7102081CA7384A67.title: "铋（Bismuth）"
	quest.7134C3CB2BC1FC6A.quest_desc: ["好的，我们继续下一个任务……莴苣！"]
	quest.7134C3CB2BC1FC6A.title: "生菜"
	quest.713915E4FBDDBD25.quest_desc: ["在Y轴高度2以上，你会发现大量萤石矿石。主要用于制作魔法化合物和星光化合物。"]
	quest.713915E4FBDDBD25.title: "萤石"
	quest.7155AF6791F054D2.quest_desc: [
		"不需要出示火把。易燃物品！！"
		"如果木材用完了，你就得用石头来制作。"
	]
	quest.7155AF6791F054D2.title: "石制火把"
	quest.7195AE034EEAE00D.quest_desc: ["卷起来的餐点既容易准备又美味可口。"]
	quest.7195AE034EEAE00D.title: "Wraps"
	quest.71A4EDBC4AC1E6CE.quest_desc: ["使用机器升级底座，制作你的第一个升级。Inferium机器升级能将处理速度提高1.2倍，但同时也会消耗更多燃料。"]
	quest.71BAC5A2B66937F4.quest_desc: ["购买一些奖励吧！"]
	quest.71BAC5A2B66937F4.title: "火把"
	quest.71CB6F07216EE36C.quest_desc: ["Wyvern 能量核心是 Draconic 核心的进阶版。它用于更高级的合成配方，比如所有 Wyvern 工具和盔甲，这也是你的下一个目标。"]
	quest.71CB6F07216EE36C.title: "Wyvern Core！"
	quest.71DB130D8FD31D22.quest_desc: [
		"破坏者会破坏其前方的方块。它可以朝任何方向。"
		""
		"手持红石火把右键点击时，它会在被红石停用模式和响应脉冲模式之间切换。"
	]
	quest.7223095162F7C9D8.quest_desc: [
		"要制作一个末地钢锭，你需要一个暗钢锭、一个黑曜石方块和一些末地石。"
		"暗钢很容易生产——真正的挑战在于组合材料！"
	]
	quest.7223095162F7C9D8.title: "末地钢 End Steel"
	quest.7249692A4D9F7325.quest_desc: ["如果你想用它来挖掘泥土，那么挖掘机会很有用。"]
	quest.72530D5DC5611A72.quest_desc: ["一大堆TNT可不是浪得虚名哦。:)"]
	quest.7258E693B337DBBF.quest_desc: ["铁质精华可用于制作铁锭。"]
	quest.7258E693B337DBBF.title: "铁"
	quest.725ED43BE9392CF0.quest_desc: ["面团可用于制作各种食物，例如面包。"]
	quest.725ED43BE9392CF0.title: "面团"
	quest.728A059E89B4949C.quest_desc: ["然后去弄几个油桶（Oil Buckets）回来。"]
	quest.728A059E89B4949C.title: "油桶！"
	quest.72AADF01A32733DE.quest_desc: ["Clibano Core 是 Clibano 多区块结构的主要组件。建造完成后，用 Mundabitur 粉尘右键即可激活熔炉。"]
	quest.72AADF01A32733DE.title: "克利巴诺 #2"
	quest.72BE5231B27D03B6.quest_desc: [
		"要解锁更强大的法术，你需要一种特殊的魔法木材。"
		"远古木在现实世界自然生长——去寻找一棵，开启你的下一步魔法学习。"
	]
	quest.72BE5231B27D03B6.title: "寻找魔法木材"
	quest.72C68C9230EAC317.quest_desc: [
		"振金粉尘本身不稳定且无法使用。要释放其真正潜力，你需要用仅在红色星球上发现的反应性材料——火星沙来加工它。"
		"将两者放入高级合金熔炉中，即可打造出强大的振金锭。"
		""
		"&a💡 提示：这种矿石只能在火星上找到。"
	]
	quest.72C68C9230EAC317.title: "振金"
	quest.72CDC89C55BF8D14.quest_desc: ["收获完全成熟的自然种子植物后，你会得到自然精华。"]
	quest.72CDC89C55BF8D14.title: "自然精华"
	quest.72E57904E75F587F.quest_desc: ["数字电路用于包含多个同时运行的操作的工业控制系统中的紧凑型机器。"]
	quest.72E57904E75F587F.title: "数字电路"
	quest.72FE98AF258B5669.quest_desc: [
		"将固态硅电池在熔炉中熔炼，以获得液态硅电池！"
		""
		"&a💡 提示：把它放在地上，用桶拾起，这样你就可以在任何地方使用它了。"
	]
	quest.72FE98AF258B5669.title: "熔融硅 #2"
	quest.72FFA7874C0248A8.quest_desc: ["从 Mob Slaughter Factory 收集一些 Liquid Meat。"]
	quest.7314C14EDBC88056.quest_desc: ["真空罐能让你把食物放进罐子里，这样就能在太空里吃东西了。"]
	quest.7316C6E840E736CC.quest_desc: [
		"灯笼是一种装饰性光源，能发出明亮的光，非常适合照亮你的建筑并防止怪物生成。"
		"用铁粒和火把制作，能为任何建筑增添质朴的魅力。"
	]
	quest.7316C6E840E736CC.title: "灯笼"
	quest.731E1E37F98A5101.quest_desc: [
		"工业机械外壳是多种高级配方中使用的组件。"
		""
		"&a将高炉的所有外壳更换为新的，以提高热量和功率。"
		""
		"&a岩浆在中心时："
		"&a工业机械外壳：3675热量"
	]
	quest.731E1E37F98A5101.title: "工业机械外壳"
	quest.73307BA7120D55E3.quest_desc: ["用邪恶粉尘填满碗！"]
	quest.7347F753CB471E7D.quest_desc: ["收获完全成熟的铜种子植物后，你会得到铜精华。"]
	quest.7347F753CB471E7D.title: "铜质精华"
	quest.736B1B489CFDA4B7.quest_desc: [
		"在末地寻找远古残骸，并将其熔炼成下界合金废料。"
		"在熔炉中结合四个下界合金废料和四个金锭，以制作一个下界合金锭。"
	]
	quest.736B1B489CFDA4B7.title: "下界合金锭"
	quest.737420EBDA89A695.quest_desc: ["是时候制作一些青铜工具了！"]
	quest.737420EBDA89A695.title: "青铜时代！"
	quest.738C244BBFEE10B6.quest_desc: ["顶级农田，产量极佳。最强作物所需。"]
	quest.738D9CEB016ECED2.quest_desc: ["尖刺是EvilCraft添加的一个组件。可用于制作各种工具，如血液提取器或尖刺板。"]
	quest.738D9CEB016ECED2.title: "尖刺！"
	quest.73B2CBC8913F414A.quest_desc: [
		"龙蛋能量虹吸管是一种RF/FE发电机，利用龙蛋内的能量持续输出200RF/FE/t。要使其工作，需将龙蛋置于顶部。若成功运行，虹吸管将变为紫色。"
		""
		"听起来可能不强，但它是一个无需燃料、昼夜都能工作的无限能源……"
	]
	quest.73F19A0EEE00A054.quest_desc: [
		"化学反应釜用于将两种流体（及其他物品）结合成第三种流体或物品。其输入速率为128能量，内部缓冲为10,000能量。"
		""
		"&a💡 提示：使用扳手来拆除这台机器！&r"
	]
	quest.73F7FBC2AA10A4EC.quest_desc: ["炸鱼和薯条简直太美味了。"]
	quest.73F7FBC2AA10A4EC.title: "鱼和薯片"
	quest.740C898DCFE64886.quest_desc: ["奇点是一种高度压缩的材料。一个奇点需要2300个同类型的物品。"]
	quest.74104BC409F512A6.quest_desc: ["使用冰之精华来制作一些压缩冰。"]
	quest.74104BC409F512A6.title: "压缩冰"
	quest.74171DEC3252655B.quest_desc: [
		"Infusion Altar 是一种通常用于创造种子的合成结构。该结构由 1 个 Infusion Altar 和 8 个 Infusion Pedestal 组成。"
		"你需要用魔杖来激活祭坛。"
	]
	quest.74171DEC3252655B.title: "祭坛 #2"
	quest.741CA10F7E9B3F1C.quest_desc: [
		"符文可能从基岩层到Y坐标2的高度生成。包括暗石附近！"
		""
		"&a💡 提示：如果没在别处找到铁镐，你应该解锁铁匠铺来制作一个。"
	]
	quest.741CA10F7E9B3F1C.title: "符文（Runes）"
	quest.742F9B2BCED3BB1F.quest_desc: ["毫无疑问，这些锭非常重要——现在轮到你来制作了。使用合成器以及所有准备好的组件来制造几个终极锭。"]
	quest.742F9B2BCED3BB1F.title: "终极锭（The Ultimate Ingot）"
	quest.747CFD864A463118.quest_desc: ["收割一株完全成熟的僵尸种子植物后，你会得到僵尸精华。"]
	quest.747CFD864A463118.title: "僵尸精华"
	quest.74964ACBEA5E44AD.quest_desc: [
		"Draconium Ore 仅在金星上生成。开采一块 Draconium Ore 会掉落 1-4 个 Draconium Dust。使用 Fortune 附魔可以增加掉落量。"
		""
		"收集足够的塔西特非常重要，否则你将无法处理这些粉尘！"
		""
		""
		"&a💡 提示：龙晶矿石可在 Y=9 和 Y=40 的层位之间找到"
	]
	quest.74964ACBEA5E44AD.title: "德拉科尼乌姆！"
	quest.74B48FB05730CA2F.quest_desc: ["使用木之精华来合成木材。"]
	quest.74B48FB05730CA2F.title: "木材"
	quest.74BFB3963D92E99C.quest_desc: ["这是升级套件中最后也是最顶级的套件。"]
	quest.74C67B10E77B8FEA.quest_desc: [
		"一个4×3×3的多方块结构，专用于合金生产。你可以使用提供的蓝图查看具体布局和所需方块。"
		""
		"这台机器能更快、更高效地生产合金。"
		""
		"&a💡 提示：每次操作都会消耗能量和燃料。熔岩是一个可行的选择，每次操作消耗 200mb。"
	]
	quest.74DE1BD1F0A3407D.quest_desc: ["橄榄是Pam's HarvestCraft添加的一种多用途作物。它们可以从橄榄树上收获，并用于制作橄榄油，这是各种食谱的关键配料。"]
	quest.74DE1BD1F0A3407D.title: "橄榄树"
	quest.74E7441F175890F1.quest_desc: [
		"工匠遗物是在部分村庄建筑中找到的第一件遗物。"
		"在 Clibano 中使用它，可以让你制造出 Obsidiansteel。"
	]
	quest.74F0C562DD86D7E3.quest_desc: [
		"活性锻造能量接口用于以FE的形式提取反应堆产生的能量。"
		"你还需要两个 Reactor Solid Access Ports——一个用于插入燃料，另一个用于提取废料。"
	]
	quest.74F0C562DD86D7E3.title: "反应堆输出与访问端口 \\n"
	quest.75114D655F12450A.quest_desc: [
		"比普通农田的作物产量更高。"
		"用于种植更高等级的精华作物。"
	]
	quest.7527428828D29C69.quest_desc: ["双联破碎机的工作原理与普通破碎机相同，但可以同时处理两种物品，效率提高了一倍。"]
	quest.75358638C6A1B2E2.quest_desc: [
		"在工业电解器中处理硝石以获得钾。"
		"用同一台机器处理粘土粉以提取钠。"
	]
	quest.75358638C6A1B2E2.title: "钠和钾元素（Sodium and Potassium）"
	quest.75A6C08C141F13F0.quest_desc: ["将煤炭/木炭粉与砾石在合成网格中混合即可制作出焦炭粉。"]
	quest.75A6C08C141F13F0.title: "可卡因粉尘"
	quest.75D5420C9C7B5DDE.title: "猪灵暴徒猎人"
	quest.7620A2626F676A6C.quest_desc: ["接下来，你需要收集 28 个加固爆破砖和数个钢制脚手架来完成电弧炉的结构。"]
	quest.7620A2626F676A6C.title: "加固的爆炸砖块！"
	quest.7621581A19E4AEBA.quest_desc: [
		"工程师的工作台并非普通的工作台——它是一个强大的工作站。"
		""
		"灵感源自 Artisan Worktables 模组，并由 Custom Machinery 实现。"
	]
	quest.7621581A19E4AEBA.quest_subtitle: "工坊"
	quest.7621581A19E4AEBA.title: "&e工程师的工作室"
	quest.7622681F4B78BFD7.quest_desc: [
		"一种能锁定附近威胁的基础自动化炮塔。"
		"可靠、固定，并且时刻处于警戒状态。"
	]
	quest.766C52C556DE201C.quest_desc: ["Unobtainium Vibranium Alloy 是一种非常坚固的高品质合金，由 Vibranium、Allthemodium、Unobtainium 和 Blazing Dust 制成！"]
	quest.766C52C556DE201C.title: "不可得振金合金"
	quest.76A8E8117407FD94.quest_desc: ["赋能器是一种用于升级水晶和其他物品的中阶方块。将待赋能的物品放置在赋能器上，并将所需材料放置在距离其恰好两格的展示架上。为每个支架注入能量以开始过程——消耗足够能量后，物品将被赋能。"]
	quest.76A8E8117407FD94.quest_subtitle: "完成精英工作台任务 (Complete Elite Craftingtable Quest)"
	quest.76A8E8117407FD94.title: "Empowerer"
	quest.774FCFA19D3F53A9.quest_desc: ["一种由混合金属锭冶炼而成的精炼材料。常用于高级机器和工具中。"]
	quest.774FCFA19D3F53A9.title: "高级合金锭 (Advanced Alloy Ingots)"
	quest.776448A88CDC6D4C.quest_desc: [
		"随着龙晶终于落入你手，龙之进化的奥秘将由你掌控。这标志着你向终极力量巅峰——贪婪之地的攀登。"
		""
		"Infinity Ingot 是进阶的核心，是制造 Sword of the Cosmos 等神级物品的关键。准备好迎接最疯狂的合成配方吧！"
	]
	quest.776448A88CDC6D4C.title: "无限锭！Infinity Ingot!"
	quest.77785614A747E6EA.quest_desc: ["制作盐的方法有很多，但目前最简单的是在厨房工坊里制作。"]
	quest.77785614A747E6EA.title: "盐分"
	quest.77865466BCB9DF32.quest_desc: ["购买一些奖励吧！"]
	quest.77865466BCB9DF32.title: "蘑菇"
	quest.779008411621FC76.quest_desc: ["锂矿石生成于地下深处，Y坐标-62至4之间。它是更高级材料和加工的重要资源。"]
	quest.779008411621FC76.title: "锂元素"
	quest.77AB36E987740D28.quest_desc: ["是时候煮些热狗了！"]
	quest.77AB36E987740D28.title: "热狗堡"
	quest.77AD8D3A5D0601CB.quest_desc: ["将草方块放置在不同位置，可以获得不同的种子！"]
	quest.77AD8D3A5D0601CB.title: "番茄种子"
	quest.77B533799EBF2499.quest_desc: [
		"世界破坏者会自动附魔为幸运X。"
		""
		"用世界破坏者右键并按住 Shift 可将其设为“锤子”模式，再次右键并按住 Shift 可切换回普通模式。在锤子模式下破坏一个方块会摧毁一个 17x17x17 立方体内的所有方块。"
		"为避免卡顿，所有物品将一同放入一个物质簇中掉落，而不是单独掉落。"
	]
	quest.7840F201C753ADEF.quest_desc: ["在熔炉中熔炼你的 Sand Coal Compound 以获得 Silicon Boule。"]
	quest.7840F201C753ADEF.title: "获取用于硅基芯片3的材料"
	quest.78A1ED5093D11E7C.quest_desc: ["使用僵尸精华来制作腐肉。"]
	quest.78A1ED5093D11E7C.title: "腐肉 (Rotten Flesh)"
	quest.78A228A99EC206DD.quest_desc: ["木制崇高工匠台是一个便携的合成台，带有额外储物空间，让你随时随地都能方便地存放材料。"]
	quest.78A7DE44E0731497.quest_desc: ["使用蓝图来制作燧石零件。"]
	quest.78A7DE44E0731497.title: "&7工具零件"
	quest.78D97CADE6809630.title: "利维坦（The Leviathan）"
	quest.78FADFE18B8B18C0.quest_desc: ["为你的弓准备一些小型投射物总没坏处……"]
	quest.78FADFE18B8B18C0.title: "箭矢"
	quest.790FA222274D900F.quest_desc: ["工业肥料的作用与骨粉类似，但效果更强。它也可用于特定机器以实现作物自动化生长。"]
	quest.790FA222274D900F.title: "肥料"
	quest.7920494B2E2DD7BB.quest_desc: ["购买一些奖励吧！"]
	quest.7920494B2E2DD7BB.title: "管道"
	quest.795C7F6B42DFA889.quest_desc: ["溶解室是一种多功能机器，能将物品和流体结合，制造高级组件、工具和资源。它能同时处理固体和液体输入，遵循特定配方。将所需物品放入输入槽，提供正确的流体，并用FE供电即可开始制作。"]
	quest.796B4996DDA222AD.quest_desc: ["借助你的 Inferium Crystal 来合成 Prudentium Essence。"]
	quest.796B4996DDA222AD.title: "审慎精华！Prudentium Essence!"
	quest.79908B4F3750EDCB.quest_desc: ["背包很实用，但要是能随时随地合成物品呢？有了合成升级，你的背包就能变成便携的合成台！安装升级后，随时都能使用内置的合成网格。"]
	quest.7995E13CD686F9F7.quest_desc: ["晶化锭主要用于增强各种生产过程。例如，它们可用于单次操作大规模生产电路或微芯片。"]
	quest.7995E13CD686F9F7.title: "晶化锭 (Crystaltine Ingots)"
	quest.79A64C98083DDF25.quest_desc: ["高级能量激光中继器是能量激光中继器的升级版，传输的能量是原来的10倍，但损耗也更高，为8%。"]
	quest.79A77745FA7C0406.quest_desc: ["醋也是一种重要的配料。"]
	quest.79A77745FA7C0406.title: "醋"
	quest.7A532F1834896ADC.quest_desc: ["购买一些奖励吧！"]
	quest.7A532F1834896ADC.title: "基本控制电路"
	quest.7AA3C32F2659E795.quest_desc: ["只有最敬业的精华采集者才能收集到如此多的能量。收集 64 个 Insanium 方块以证明你的技艺——并获得配得上你努力的奖励。"]
	quest.7AA3C32F2659E795.quest_subtitle: "&9最终形态"
	quest.7AA3C32F2659E795.title: "&dInsanium 方块"
	quest.7AD92EE94494BF46.quest_desc: ["制作一张床，这样你就能舒舒服服地度过夜晚了。"]
	quest.7AD92EE94494BF46.title: "晚安！Good Night!"
	quest.7AE731850E4EA1EC.quest_desc: ["硅板被用于许多配方中。"]
	quest.7AE731850E4EA1EC.title: "硅晶圆板"
	quest.7AFEB6B3D205486E.quest_desc: ["用香酥酥皮包裹鲜嫩牛肉制成的奢华菜肴。任何盛宴的绝佳美味——浓郁、饱腹，是展示烹饪技巧的绝佳选择！"]
	quest.7AFEB6B3D205486E.title: "惠灵顿牛肉派"
	quest.7B178808EDA2DD68.quest_desc: ["制作几个哥布林钢种子。"]
	quest.7B771424B6B37A9D.quest_desc: ["收集一些奶酪。"]
	quest.7B771424B6B37A9D.title: "奶酪！"
	quest.7B8C0A78D1B1C400.title: "避难所！"
	quest.7B8E7A1B975AB6F1.quest_desc: ["和普通水桶一样，但由木头制成。"]
	quest.7B8E7A1B975AB6F1.title: "白蜡木桶（Edelwood Buckets）"
	quest.7BB4E94D7805A853.quest_desc: ["购买一些奖励吧！"]
	quest.7BB4E94D7805A853.title: "铜制工具"
	quest.7BBE812EBFEDBB38.quest_desc: ["继续用锡矿石吧！我相信你以前肯定见过这种矿石。"]
	quest.7BBE812EBFEDBB38.title: "锡矿石"
	quest.7BC093B2A89E2959.quest_desc: ["只需收集一些硫磺粉尘即可。"]
	quest.7BC093B2A89E2959.title: "硫磺 #3"
	quest.7BF9C8A239F1DFA9.quest_desc: [
		"纳夸达是一种非常宝贵和重要的资源，用于许多先进技术中。它还有助于简化推进剂混合物的生产！"
		""
		"&a💡 提示：你可以在月球上 Y 坐标 -44 到 56 之间的任何地方找到这种矿石，通常以矿脉形式存在。"
	]
	quest.7BF9C8A239F1DFA9.title: "纳夸达矿石！"
	quest.7C16A55117E3E9FB.quest_desc: ["钻头的使用方式与稿子和铲子类似。它每挖掘一个方块消耗能量。可以在能量增强器中充能，也可以通过手持钻头潜行右键进行升级。钻头还可以染成16种颜色。"]
	quest.7C16A55117E3E9FB.title: "钻头"
	quest.7C1ADB75D4A1FCA6.quest_desc: [
		"木制流体储罐由Fluid Tank模组添加，用于储存液体。你可以垂直堆叠它们以组合成更大的储罐，连接管道向其中泵送液体，或者手持水桶或其他流体容器右键单击即可添加/移除液体。"
		"一点小小的帮助："
		"&a1000 mB = 1 B"
	]
	quest.7C1ADB75D4A1FCA6.title: "第一液体储罐"
	quest.7C202530120A9EB8.quest_desc: ["Mob Slaughter Factory 是 Industrial Foregoing 添加的机器。用于将生物和动物加工成液态肉和粉色史莱姆。被该机器杀死的动物不会掉落物品或经验。默认工作区为机器前方 1x3x1，可通过范围扩展器扩大。被杀生物每生命点产生 5 mb 液态肉和 1 mb 粉色史莱姆（牛和猪为 50 mb 液态肉和 10 mb 粉色史莱姆）。"]
	quest.7C202530120A9EB8.title: "生物屠杀工厂"
	quest.7C2A16BEE92A9216.quest_desc: [
		"Tier 1 Base Module 可以在月球地牢的宝箱中找到。此模块是制作前往金星所需的微型火箭模型所必需的。"
		""
		"&9拿到一个并在月球上办完事后，就该返回你的基地了。"
	]
	quest.7C2B2DDB18045CF3.quest_desc: [
		"锑主要用于制造合金，但现代工业化模组会将其用于机器中。"
		""
		"&a提示：可在Y轴-64至64的高度找到。"
	]
	quest.7C2B2DDB18045CF3.title: "Antimony Ingots"
	quest.7C41C3E839C015EE.quest_desc: ["XyCraft 宝石深藏于地下，有三种鲜艳的颜色。"]
	quest.7C41C3E839C015EE.title: "绿色 Xychorium 宝石"
	quest.7C454BA4858B3409.quest_desc: ["购买一些奖励吧！"]
	quest.7C454BA4858B3409.title: "铜制工具"
	quest.7C46CC8A7A783230.quest_desc: ["将生米面包放入熔炉以获得熟米面包。"]
	quest.7C46CC8A7A783230.title: "米面包"
	quest.7C4A776AF482C6E8.quest_desc: ["好的，我们继续下一个任务……大蒜！"]
	quest.7C4A776AF482C6E8.title: "大蒜"
	quest.7C716BFA687B3D2A.quest_desc: ["购买一些奖励吧！"]
	quest.7C716BFA687B3D2A.title: "数据存储核心"
	quest.7C742B01AC0F1DE9.quest_desc: ["将龙尘和塔尔西斯锭在任意合金熔炉中冶炼即可得到龙晶锭。"]
	quest.7C742B01AC0F1DE9.title: "Draconium 锭"
	quest.7C74F02ACE9D22BB.quest_desc: [
		"Inferium Essence 是 Mystical Agriculture 添加的一种组件。用于制作第一级种子和更高级别的 Essence。"
		""
		"可以通过收割 Inferium 植物、挖掘 Inferium 矿石，或由生物掉落获得。"
	]
	quest.7C74F02ACE9D22BB.title: "Inferium"
	quest.7C8C43886F530B18.quest_desc: ["苔石是一种普通的装饰元素，制作起来也很简单。"]
	quest.7C8C43886F530B18.title: "长满苔藓的鹅卵石"
	quest.7C93755D871EFAA7.quest_desc: ["收获一株完全成熟的烈焰种子植物后，你会得到烈焰精华。"]
	quest.7C93755D871EFAA7.title: "烈焰精华"
	quest.7CA4C21D97536FBC.quest_desc: ["购买一些奖励吧！"]
	quest.7CA4C21D97536FBC.title: "&a加速混合物"
	quest.7CA6C686AE82E37C.quest_desc: ["酿酒厂能将各种流体转化为更轻的部分。这对石油加工会很有用。"]
	quest.7CC171467620B32F.quest_desc: ["将沙质玻璃粉和橡胶放入空单元格中，以获得填充的胶水化合物单元格。"]
	quest.7CC852DBF71B8AAD.quest_desc: ["模拟电路的基础组成部分。"]
	quest.7CC852DBF71B8AAD.title: "模拟电路主板"
	quest.7CD15496F9BFC525.quest_desc: [
		"Calorite 是一种树脂状材料，以其卓越的耐热性而闻名。因此，它自然生成在极端温度常态化的下界。使用 Neptunium 级或以上工具挖掘，以解锁强大的合成选项。"
		""
		"&a💡 提示：稀有矿石可在 Y 坐标 4 到 34 的层级找到。"
	]
	quest.7CD15496F9BFC525.title: "卡洛里特矿石"
	quest.7CD6FAA71121017D.quest_desc: [
		"流体容易储存，但气体呢？Mekanism 的基本化学储罐能让你安全储存和运输气体。"
		"制作一个。"
	]
	quest.7CEC4C32C8610DD4.quest_desc: [
		"此升级可增加 Tech Reborn Machine 所能储存的最大能量值。"
		"现在我们进入了 Tech Reborn 机械的世界，这将在游戏后期发挥巨大作用！"
	]
	quest.7CF105D2B5AE583B.quest_desc: ["合成几个自然种子。"]
	quest.7CFDBE864D62FE0D.quest_desc: ["合成一个火粘土。"]
	quest.7CFDBE864D62FE0D.title: "熔炉 #2"
	quest.7D01596FFC8BDFF2.quest_desc: [
		"物品激光中继器是一种无线物品传输装置。默认传输范围为15格。"
		""
		"&a💡 提示：使用激光扳手可以轻松连接继电器！"
	]
	quest.7D01596FFC8BDFF2.title: "物品激光中继器"
	quest.7D3A6B6E0E0C15D2.quest_desc: [
		"火箭是Stellaris添加的一种载具，用于前往月球和空间站。"
		"可以填充 3000 mb 的火箭燃料。"
		""
		"&a💡 提示：火箭内的箱子是可选的，可提供额外储物空间。还有不同的插槽可用于各种升级。"
		""
		"&c返程时你需要带上另一个火箭发射台。"
	]
	quest.7D3A6B6E0E0C15D2.quest_subtitle: "&9解锁：&6&l主线任务 - 第五阶段。"
	quest.7D5DB5C5DABD47AD.quest_desc: ["而现在是最难的部分了……"]
	quest.7D5DB5C5DABD47AD.title: "无尽钻头 #3"
	quest.7D621DF418C6CC2F.quest_desc: ["奶酪是一种由牛奶制成的乳制品，而且非常美味。"]
	quest.7D621DF418C6CC2F.title: "奶酪"
	quest.7D716482CA1B53FE.quest_desc: ["木制外壳用途广泛，可用于制作箱子升级组件等。"]
	quest.7DA61EDD39FE1E50.quest_desc: ["这种机器外壳是建造不锈钢管道机器外壳所需的组件之一，但也用于许多多方块结构中。"]
	quest.7DA61EDD39FE1E50.title: "洁净不锈钢机器外壳"
	quest.7DC4DEDD78504498.quest_desc: ["射程升级可以增加炮台的射程。"]
	quest.7DFB0E9FFF03F788.quest_desc: [
		"Extraneous Firestarter 是利用灵气为自己谋利的方法：它能从世界中收集灵气，无需任何燃料即可为熔炉提供动力。"
		"只需把它放在熔炉上即可。"
	]
	quest.7DFBD1E402CDE95D.quest_desc: ["1k ME 存储组件用于制造 1k ME 存储单元或更高级别的存储组件。"]
	quest.7E089975A882EECC.quest_desc: [
		"只需少量灵气，此法杖即可召唤浮光，照亮你的前路。"
		"优雅高效的照明方案，尤其适用于黑暗或地下区域。"
	]
	quest.7E26601EB00F521B.quest_desc: ["购买一些奖励吧！"]
	quest.7E26601EB00F521B.title: "史莱姆生成蛋"
	quest.7E3CCD5B8D1C6B22.quest_desc: ["购买一些奖励吧！"]
	quest.7E3CCD5B8D1C6B22.title: "鳕鱼生物蛋"
	quest.7E3DCE7FCE6923A8.quest_desc: ["Superium Coal 燃烧时间超长！比普通煤炭长 12 倍！"]
	quest.7E3DCE7FCE6923A8.title: "Imperium 煤炭"
	quest.7E4A146555DF4799.quest_desc: [
		"微型火箭模型能让你抵达金星！"
		""
		"&c返程时你需要带上另一个火箭发射台。"
	]
	quest.7E574C5EA424D481.quest_desc: ["&e铜质细线&f是用于&e高级电机&f的组件。"]
	quest.7E850CE97F09C3CD.quest_desc: ["合成几个精制黑曜石种子。"]
	quest.7E90032E034D0B8C.quest_desc: ["购买一些奖励吧！"]
	quest.7E90032E034D0B8C.title: "沙质煤炭化合物"
	quest.7EC299912C29B8D4.quest_desc: [
		"旋风棱镜是一种用于制作白色魔法粉尘的神秘组件。它能引导光与运动，体现了平衡与元素能量。"
		""
		"&e作为奖励，你将获得一个幻影生物蛋——请谨慎使用。"
	]
	quest.7EC299912C29B8D4.title: "旋风原始人"
	quest.7ECB4885E865B64B.quest_desc: ["乳胶处理单元用于制造干橡胶。它将消耗500 mB水、750 mB乳胶和能量，生成1个干橡胶。每个过程耗时5秒，每生产1个干橡胶消耗2000能量。"]
	quest.7EE8F8EB9D93D408.quest_desc: ["流体存储的升级！锡制储罐可容纳高达 64,000mB 的流体，并可垂直堆叠以扩展容量。"]
	quest.7F14E56A4A42B730.quest_desc: ["一款简单却令人满足的经典——烤得恰到好处的甜玉米。"]
	quest.7F14E56A4A42B730.title: "玉米棒子（带叶）"
	quest.7F2064323D24D822.quest_desc: ["你即将进入更复杂、更耗资源的内容。这一章需要时间、努力和智慧的资源管理。祝你好运，你一定会需要！"]
	quest.7F2064323D24D822.title: "&e扩展你的工具包！"
	quest.7F383AA57082166A.quest_desc: ["制作 Invar 需要在 Foundry 或更高级的 Alloy Smelter 和 Advanced Alloy Smelting Factory 中组合 Iron 和 Nickel Ingot。"]
	quest.7F383AA57082166A.title: "Invar"
	quest.7F38673C728748D9.quest_desc: ["对于血液魔法，请先收集一些黄金、铁、红石、青金石和钻石！"]
	quest.7F38673C728748D9.title: "&e启动黑魔法！"
	quest.7F51603D045DC1FA.quest_desc: ["制作一个钢制头盔。"]
	quest.7F82585FA06C6466.quest_desc: ["合成几个石英富集铁种子。"]
	quest.7F86A36C57C53F91.quest_desc: [
		"在强大仪式中用作催化剂的神秘物品。"
		"将其与正确物品一同放置在祭坛旁，召唤之灵便会触发远古魔法，召唤出隐藏的力量。"
		"没有它，仪式将保持休眠状态。"
	]
	quest.7F86A36C57C53F91.title: "召唤之灵"
	quest.7FBC9E9E6C3C713E.quest_desc: ["将铁砂放入电解器中可获得锰粉，这是制作铱的重要原料——没错，我们还在制作铱。:)"]
	quest.7FBC9E9E6C3C713E.title: "锰粉 #7"
	quest.7FC7DA4326F7F8BE.quest_desc: ["制作一套铜质护腿。"]
	quest.7FCD021C40ECE5CF.quest_desc: ["简易甜菜根汤制作教程。"]
	quest.7FCD021C40ECE5CF.title: "甜菜根汤"
	quest.7FD98C35B5B34EDC.quest_desc: [
		"要制作更多食物，你需要一张桌子来准备美味佳肴。"
		""
		"灵感源自 Artisan Worktables 模组，并由 Custom Machinery 实现。"
	]
	quest.7FD98C35B5B34EDC.title: "&e欢迎来到厨房！"
	quest.7FDBDAF6910C8FFB.quest_desc: ["购买一些奖励吧！"]
	quest.7FDBDAF6910C8FFB.title: "胡萝卜"
	quest.7FFAF8D3B3306E62.quest_desc: ["赋能油菜籽用于制作赋能油。一个晶化油菜籽和四个油菜籽可以在赋能器中转换为一个赋能油菜籽。"]
	quest.7FFAF8D3B3306E62.title: "赋能的油菜种子"
