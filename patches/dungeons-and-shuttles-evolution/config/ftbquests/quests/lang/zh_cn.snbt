	quest.6045FF950C984A2E.quest_desc: ["合成几个冰种子。"]
	quest.60778D8946B674FA.quest_desc: [
		"通过基于光环的锻造创造的神秘锭。"
		"使用融合后的材料在祭坛上操作，并确保有足够的灵气环绕着你。"
	]
	quest.60963902731DE620.quest_desc: [
		"使用原子重构器，你可以将普通钻石转化为钻石晶体。"
		"使用原子重构器，你可以将普通的钻石块转化为钻石晶体块。"
	]
	quest.60C95D5005ED98EF.quest_desc: ["Tech Reborn 电池是一种可充电电池，用于为各种方块和工具供电。它也用于各种机器的配方中。"]
	quest.60FDF28A1EE84786.quest_desc: ["将碳网放入压缩机（或等效机器）中，以制造碳板。这些是后期制作高端机器和高级物品的重要组成部分。"]
	quest.60FDF28A1EE84786.title: "碳质板"
	quest.6130A386B3A478F7.quest_desc: ["使用你的手来获取骨粉。"]
	quest.6130A386B3A478F7.title: "白色染料"
