	quest.6140C99537A0B576.quest_desc: ["用于制作电气机器和变压器的铜线圈方块。"]
	quest.61B2EE7761289FA4.quest_desc: [
		"有机堆肥在流体提取器中用于生产甲烷气体，非常有用。"
