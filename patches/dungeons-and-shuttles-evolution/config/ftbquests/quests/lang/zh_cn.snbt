	quest.5CD33EB2CCD8B77E.title: "末影锭"
	quest.5CE0F4EC882C8607.quest_desc: ["收获完全成熟的哥布林钢种子植物后，你会得到哥布林钢精华。"]
	quest.5CE0F4EC882C8607.title: "哥布林钢铁精华"
	quest.5CE655C1DB5E841D.quest_desc: ["ME 合成终端让你完全访问 ME 系统，并内置了合成网格。借助 JEI 支持，它能自动从存储中填充配方——合成从未如此简单。"]
	quest.5CE655C1DB5E841D.quest_subtitle: "完成塑料片任务（Plastic Sheets Quest）"
	quest.5CE655C1DB5E841D.title: "智能合成访问权限"
	quest.5D02369AA18E75CB.quest_desc: ["收获完全成熟的铁种子植物后，你会得到铁精粹。"]
	quest.5D02369AA18E75CB.title: "铁质精华"
	quest.5D237B59B6ED2E42.quest_desc: [
		"水分离器能将水转化为氧气和氢气。"
		""
		"将水放入第二个槽位，机器就会生成氢气和氧气，你可以在储罐下放置桶来收集。"
	]
	quest.5D41B06568B233BA.quest_desc: [
		"Hooked 模组引入了多种抓钩，每种都具有独特的能力，有助于探索和移动。"
		""
		"&a装备一个在“钩爪”栏位，让你的冒险更上一层楼！"
	]
	quest.5D41B06568B233BA.title: "准备好去探索了吗？！"
	quest.5D572AAB6E558080.quest_desc: ["附魔铁锭是一种基础资源。将铁锭放置在附魔祭坛上即可制作。"]
	quest.5D572AAB6E558080.title: "附魔金属锭"
	quest.5D62B16909303CA5.quest_desc: [
		"钢是通过将铁与碳以及其他材料结合制成的。"
		"为了提高效率，建议将完整的铁块转化为钢——但要做好高燃料消耗的准备！"
	]
	quest.5D62B16909303CA5.title: "第一块钢！"
	quest.5D7008A2FAD11948.quest_desc: ["化学反应釜能让物品和流体发生反应。我们将在下一步使用它。"]
	quest.5D7008A2FAD11948.title: "化学反应器 #4"
	quest.5DBA28B1CD575F58.quest_desc: ["开采一些原始钠达后，在熔炉中将其熔炼成用于高科技制作的提纯形式——精炼钠达。"]
	quest.5DBA28B1CD575F58.title: "精炼的纳夸达合金"
	quest.5DCA262BD711F8CE.quest_desc: ["电缆将ME机器连接起来。机器相邻放置时会自动连接，但要跨越距离，则需要电缆来维持网络运行。"]
	quest.5DCA262BD711F8CE.title: "正在连接系统"
	quest.5DD18664A5BD1751.quest_desc: [
		"森林仪式可以使用橡木树苗或丛林树苗来施展，具体取决于配方。"
		""
		"要开始仪式，将所需物品放在木制支架上，并在中心种下必要的树苗。"
	]
	quest.5DD18664A5BD1751.title: "森林仪式 #3"
	quest.5DE18808E923C203.quest_desc: ["铬精粹可用于制作铬锭。"]
	quest.5DE18808E923C203.title: "铬合金锭 Chromium Ingot"
	quest.5DECD68D6F75446A.quest_desc: ["合成一个钨种子！"]
	quest.5E1498D580A8C947.quest_desc: ["它将风车的能量产量精确地提高两倍。"]
	quest.5E1498D580A8C947.title: "改进风车"
	quest.5E3C61735372025A.quest_desc: [
		"弓是一种用于射箭的远程武器。"
		"远程战斗必备！"
	]
	quest.5E3C61735372025A.quest_subtitle: "弓"
	quest.5E3C61735372025A.title: "远程武器！"
	quest.5E680E63D5F07040.quest_desc: [
		"你也可以用桶来运输液体。"
		""
		"&a该整合包将桶的堆叠数量增加到16。"
	]
	quest.5EAF3C91FB065A94.quest_desc: [
		"风力涡轮机利用巨大的叶片从风中发电。它需要1x1x5的空间，并且必须视野开阔才能运行。它在所有天气条件下，无论昼夜都能正常工作。"
		""
		"&a💡 提示：放置得越高，发电量越大。"
	]
	quest.5EB1091A8739B644.quest_desc: ["购买一些奖励吧！"]
	quest.5EB1091A8739B644.title: "牛生成蛋"
	quest.5EBB76813637E171.quest_desc: ["蓝图在手，是时候制作太刀刀身了。用钢锭和太刀蓝图开始，再搭配任意工具棒，即可挥刀斩敌。"]
	quest.5EC9D0DA054992AF.quest_desc: ["将你的酸面包烤制以获得酸面包。"]
	quest.5EC9D0DA054992AF.title: "酸面包（Sourdough Bread）"
	quest.5F22091057D05FA3.quest_desc: ["ME控制器是你的ME网络的“大脑”，使用密集电缆时每侧可提供多达&b32个频道&r。每个网络只能有一个，但可以将其扩展为多方块结构以获得更强的功能和更精细的控制。"]
	quest.5F22091057D05FA3.title: "网络核心"
	quest.5F42278B53D71365.quest_desc: ["用于高端机械和精密设备的精炼电路。"]
	quest.5F46861B1A0CFE59.quest_desc: [
		"电解器利用能量将流体和特定物品分解为其基本成分。"
		"常用于从水中提取氢和氧，以及从尘埃或碎片等物品中提取材料。"
	]
	quest.5F488B445B7C8D99.quest_desc: [
		"TheKanthal Coil 是一种用于各种高级配方中的组件。"
		""
		"&a将电炉的所有外壳更换为新的，以提高热量和功率。"
	]
	quest.5F488B445B7C8D99.title: "坎塔尔线圈"
	quest.5F61E0B8824074A5.quest_desc: ["Storage Drawers 模组意外地给游戏添加了不同的储物抽屉 :) 你可以把很多物品放进去，但只能放一种。如果满了，还有升级组件，Shift + 右键抽屉并插入升级组件即可。"]
	quest.5F739ED4FC57A1AA.quest_desc: ["过滤模块用于各种配方中。例如：升级模板"]
	quest.5F8999D8D0416314.quest_desc: ["和大多数整合包一样，先收集些木头来开始吧！"]
