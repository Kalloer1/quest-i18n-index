	quest.5F8999D8D0416314.title: "&e所需木材"
	quest.5FA0F9CC64F603A2.quest_desc: ["腐肉... 没用，但是... 把腐肉放进熔炉里，然后..."]
	quest.5FA59527F7D1B093.quest_desc: ["用这个工具，你可以随心所欲地召唤一次！但它只能使用一次，所以召唤风暴的成本很高。"]
	quest.5FAC23842FC293F0.quest_desc: ["铅矿石可以在Y坐标-24到40的层级找到。"]
	quest.5FAC23842FC293F0.title: "铅制物品"
	quest.601AEE0FF3F3B1BB.quest_desc: ["我们先从多方块结构最重要的核心方块开始。"]
	quest.601AEE0FF3F3B1BB.title: "Master Assambler 2k25 #2"
	quest.6045790112418DBE.quest_desc: ["购买一些奖励吧！"]
