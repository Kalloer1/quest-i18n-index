		{
			dependencies: ["35C32229A51A1B7D"]
			description: ["乘坐潜艇离开伊利亚斯城是我最后想到的事，但不幸的是，我在这里的时间里，交到的朋友和敌人一样多。"]
			entity_vis_size: 1.0f
