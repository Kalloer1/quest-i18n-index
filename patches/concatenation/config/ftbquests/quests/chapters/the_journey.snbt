		{
			dependencies: [
				"76D7A6B494BCAABC"
				"79C2F929FF9F1586"
				"152DC73801813764"
				"43593B9FF0498E58"
			]
			description: [
				"&8“为了将远古血肉塑造成更耐用的材料，我们必须诱使其‘感染’一块精制的黑曜石锭。”"
				"&b“这过程很昂贵，但硬化肉锭比单独的肉要实用得多。”"
			]
			entity_vis_size: 1.0f
			icon: "the_deep_void:hard_flesh_ingot"
			id: "04FB6C65AF290FFC"
			rewards: [{
				id: "6F20B29C9DBD031C"
