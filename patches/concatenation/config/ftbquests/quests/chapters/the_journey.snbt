			}]
			x: 35.0d
			y: 22.5d
		}
		{
			dependencies: [
				"23F4617A86D5F64E"
				"483A8C4A3EE05C52"
			]
			description: [
				"好酷的名字。至少我是这么认为的。"
				""
				"&c\"那只是这件文物的名字而已。\"&r"
				""
				"肯定有更深层的含义吧？凤凰是什么来着，好久没见过了。凤凰之羽是将天使之心倒在天使羽毛上制成的，是一种更强大但不可堆叠的死亡作弊方式。"
			]
			entity_vis_size: 1.0f
			id: "3BC974F6785A43B3"
			rewards: [{
				count: 5
				id: "2DBCA354DB93BF21"
				item: "reliquary:angelheart_vial"
				type: "item"
			}]
			tasks: [{
				id: "31FE2C17AA05CDF8"
				item: "reliquary:phoenix_down"
				type: "item"
			}]
			x: 35.0d
			y: 21.5d
		}
		{
			dependencies: ["4E4E81226BED0E7C"]
			description: [
				"“这看起来像是塔牌的低劣仿冒品。”"
				""
				"&c“不，不，不。塔牌的效果就源于此。古代工程师曾请求一位古代遗物之王，将这项能力发扬光大。”&r"
				""
				"“一位曾是国王的古代遗物收藏家？”"
				"{@pagebreak}"
				"&c“以前的遗物收藏家更少见，你知道的。他们没有像我们这样举办大型派对或有组织的社会来收集稀有部件。”&r"
				""
				"“别表现得好像你活了一千年一样老成。”"
			]
			entity_vis_size: 1.0f
			hide_dependency_lines: true
			id: "23F4617A86D5F64E"
			rewards: [{
				id: "44A9342C1349C618"
				item: "minecraft:bat_spawn_egg"
				type: "item"
			}]
			tasks: [{
				id: "50BA59F871D27A44"
				item: "reliquary:angelic_feather"
				type: "item"
			}]
			x: 34.0d
			y: 21.5d
		}
		{
			dependencies: ["550D01E852BFE592"]
			description: [
				"我于是问这位遗物持有者，他是否有能辅助采矿的遗物。那肯定是只有技术人员或工程师才能使用的东西。"
				"{@pagebreak}"
				"&c\"这个小玩意儿是个挺简单但有效的工具。它本质上是个可重复使用的智能炸药棒。只需往里放点火药，对准你不喜欢的地面，然后砰！瞬间爆炸。它在某些方面甚至比真正的爆炸更好，因为它不会伤害使用者，也不会炸掉矿石这类你真正想要的东西，这样你就可以从容地收集它们了。不过，它的缺点是爆炸本身不造成任何伤害，这促使我创新出了我至今最喜欢的创造之一。\"&r"
			]
			entity_vis_size: 1.0f
			id: "471939DE22B5426B"
			rewards: [{
				count: 128
				id: "1A78708496A8CEF5"
				item: "minecraft:gunpowder"
				type: "item"
			}]
			size: 0.9d
			tasks: [{
				id: "48BBC7D237937923"
				item: "reliquary:destruction_catalyst"
				type: "item"
			}]
			x: 30.649999999999995d
			y: 26.05d
		}
		{
			dependencies: ["081070F7CBF61207"]
			description: [
				"&c“啊，我幸运的改变。这枚硬币其实蕴含着相当可观的运气，这可不只是空谈！自从我创造出这件遗物以来，财富和宝贵的经验似乎都更愿意选择我作为主人。幸运的是，它有办法停用这个效果，否则我肯定会惹怒不少恰好把大量宝藏陈列在房间里的权贵，哈哈。”&r"
				"{@pagebreak}"
				"“不过，我见过很多人手里都拿着这枚硬币。”"
				""
				"&c\"嗯……虽然不是独一无二的，但这绝对是一件遗迹！\"&r"
				""
				"“你看起来并不令人信服。”"
			]
			entity_vis_size: 1.0f
			id: "0901394AD3A5FDAB"
			rewards: [{
				id: "6124B6F0F9E2A86C"
				type: "xp_levels"
				xp_levels: 1
			}]
			tasks: [{
				id: "47A1211F79140D97"
				item: "reliquary:fortune_coin"
