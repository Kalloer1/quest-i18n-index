				type: "item"
			}]
			size: 1.15d
			tasks: [{
				id: "69E34EEB7779B8FF"
				item: {
					Count: 1
					id: "reliquary:alkahestry_tome"
					tag: {
						Damage: 1001
					}
				}
				type: "item"
			}]
			x: 33.77499999999999d
			y: 27.075000000000003d
		}
		{
			dependencies: ["4E4E81226BED0E7C"]
			description: [
				"天使之心瓶是遗物收藏家的主要手段：无数次地欺骗死亡。或者至少，取决于他们口袋里堆叠的瓶子数量。"
				"{@pagebreak}"
				"传说曾有位大法师用这瓶药剂挑战神明。闪电与神罚都无法将其击败，至少无法将其杀死，他被投入虚空，尸身再未寻见。"
			]
			entity_vis_size: 1.0f
			hide_dependency_lines: true
			id: "483A8C4A3EE05C52"
			rewards: [{
				count: 9
