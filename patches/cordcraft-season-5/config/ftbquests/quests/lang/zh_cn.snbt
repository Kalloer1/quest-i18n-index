	quest.446D405D6AE877C6.quest_desc: ["将基础尺寸增加 256。"]
	quest.44BC2C5575C34972.quest_desc: [
		"将&6矿车组装器&r放置在轨道上。将其置于轨道上，然后放置任意类型的&8矿车&r，并使用某种&c红石信号&r来激活它，它就会变成一个装置。"
		""
		"查看 JEI 了解配方，并思考如何使用它。"
	]
	quest.460EDCA441B28854.quest_desc: ["从背包中向背包内选定的物品栏位补充物品。"]
	quest.4645CCDEB520F92C.quest_desc: [
		"砧板是最好用的工具之一。"
		""
		"砧板有很多用途，建议通过 JEI 查看具体用法！"
