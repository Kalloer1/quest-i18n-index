	quest.4A89295E621DED70.quest_desc: ["从产生能量的方块中接收能量，并将其输入到你的能量网络中。"]
	quest.4AE653B544F89A35.quest_desc: [
		"&9水轮&r被认为是最基础、最入门的自动SU（压力单位）生产装置。"
