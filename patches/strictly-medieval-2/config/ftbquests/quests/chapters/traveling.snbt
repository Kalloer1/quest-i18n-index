					item: {
						id: "minecraft:written_book"
						Count: 1
						tag: {
							pages: [
								"{\"text\":\"Welcome To Strictly Medieval 2.\\n\\nIn this world, your Quest Book will be your best friend for learning new mods or old to you. Gathering skills and items, and much more. \\n\\nSome quest require a crafting check. If so SHIFT+CLICK when -->\"}"
								"{\"text\":\"completing the craft for FORGE to read the craft.\\n\\nCoins are the main source of revenue for villagers. You have a \\\"Purse\\\" top right of your inventory.\\n\\nNeed Help in the world? Find a Companion! --->\"}"
								"{\"text\":\"Feed them the food the request. You can armor them up and give them items and use them as storage.\\n\\nProject MMO handles all the requirements and skills you will gather in the top left of your screen. you can look at any block/item and press P to learn more -->\"}"
								"{\"text\":\"about that item. you can also, while not looking at anything, press P and open the glossary to do a search for a specific item (top right of menu).\\n\\nAny further Questions you can Contact me via discord, i love and appreciate everyone who plays my packs ->\"}"
								"{\"text\":\"and love to help out. \\n\\nThanks for playing\\n\\n- OJ\"}"
							]
							title: "请阅读我！"
							author: "Orangejewce92"
						}
