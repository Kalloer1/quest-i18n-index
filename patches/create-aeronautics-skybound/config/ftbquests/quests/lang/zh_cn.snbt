	quest.0057091087F93369.quest_subtitle: " 装饰方块"
	quest.00ACD837E30165B3.quest_desc: [" 从 FE 中产生旋转能量。可作为 ComputerCraft 的外设。实现在电学模组与 Create 的动能系统之间进行桥接。"]
	quest.00ACD837E30165B3.quest_subtitle: "将FE转化为旋转力"
	quest.00D4D974BDB2CE18.quest_subtitle: "装饰方块"
	quest.00D9CE4397D427BC.quest_subtitle: "装饰方块"
	quest.00F44F4FA88A59F9.quest_desc: ["当受到旋转力时，绳索绞盘会将连接的绳索卷进或放出，从而提升或降低悬挂在其上的任何物品。将其与绳索连接器搭配，即可连接各种装置。"]
	quest.00F44F4FA88A59F9.quest_subtitle: "卷进和放出绳索"
	quest.012DFCAD0BAAE1EC.quest_subtitle: "装饰方块"
	quest.0164D7D89151BAC5.quest_subtitle: "装饰方块"
	quest.016DE6F430DD8293.quest_desc: ["[ { \"text\": \"创建枪械制造\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"7A9EC265305FC6D1\" } } ]"]
	quest.018C899D0D27FAF7.quest_desc: [
		"与拉杆类似，通电插销可以通过右键点击来开启或关闭。它会发出红石信号，该信号可被其他信号切换开启或关闭。"
		""
		"当从侧面通电时，通电插销会被关闭。当从背面通电时，通电插销会开启。"
	]
	quest.018C899D0D27FAF7.quest_subtitle: "通电插销会发出红石信号，该信号可被其他信号切换开启或关闭。"
	quest.01B70D4768B7450D.quest_subtitle: "装饰方块"
	quest.01B852D1F40D9E4B.quest_desc: ["一种致密厚重的石头，可用作基础的迫击炮弹。虽然粗糙，但用来越过城墙向敌人投射时非常有效。"]
	quest.021AF20A6B63F0B0.quest_subtitle: "装饰方块"
	quest.0251560FBD2D0D1B.quest_desc: ["右键点击即可抓取：移动鼠标可以倾斜这根杆，每个方向都会通过其独立的红石链接频率传输信号，信号强度随倾斜角度变化。按下 ESC 可释放。潜行状态下右键点击可打开其配置界面，红石信号可将当前的倾斜角度锁定。"]
	quest.0251560FBD2D0D1B.quest_subtitle: "操纵杆是一种通过红石链接进行通信的双轴控制杆。"
	quest.02E1214A73069308.quest_desc: ["钍矿从钍矿石中开采出来，并精炼成为核反应堆供能的放射性燃料。"]
	quest.02E1214A73069308.quest_subtitle: "核能的原始燃料"
	quest.0354DB37FD2030EE.quest_desc: ["由生物质和种子油精炼而成的生物燃料——对于您的燃烧器而言，这是一种比种子油更高效的液体燃料。"]
	quest.0354DB37FD2030EE.quest_subtitle: "一种高效的易燃液体"
	quest.038C1B51E29482E4.quest_subtitle: "装饰方块"
	quest.03C35DD849D39960.quest_subtitle: "装饰方块"
	quest.03CB4B44E73A22B3.quest_desc: ["检测附近红石链接的距离。打开其配置以设置最小和最大范围，将距离转换为模拟红石信号。"]
	quest.03CB4B44E73A22B3.quest_subtitle: "感应到红石链接的距离"
	quest.0402E92EB181F281.quest_subtitle: "装饰方块"
	quest.045FBC3A653F7687.quest_desc: ["它能将旋转传递至设定角度，然后在输入停止时弹回起始位置。红石信号可将其固定在该位置，且角度限制可配置。"]
	quest.045FBC3A653F7687.quest_subtitle: "扭力弹簧可在角度限制内传递旋转。"
	quest.0488989FD7F5AF42.quest_desc: ["将铁锭放入轧机中获得。"]
	quest.0488989FD7F5AF42.quest_subtitle: "合成组件。"
	quest.0495E9DC993B07ED.quest_desc: ["指挥家哨子可让您向附近的指挥家和火车吹哨下达指令——是管理和调度铁路的实用工具。"]
	quest.0495E9DC993B07ED.quest_subtitle: "向您的火车和指挥家发出信号"
	quest.04B2B0351546810E.quest_subtitle: "装饰方块"
	quest.04BF2BB47D90E214.quest_desc: ["右键单击任意方块即可设置坐标。"]
	quest.0537A184C9C87B76.quest_desc: ["一种逐层构建的更强力磁铁，其磁力比红石磁铁更强。"]
	quest.0537A184C9C87B76.quest_subtitle: "更强的层压磁铁"
	quest.053FDD5AD459D89A.quest_desc: ["螺旋桨轴承会连接到其前方的方块上，并将任意一组有效的船帆转化为能产生推力的螺旋桨。船帆越多，推力效率就越高；反转旋转方向即可反转推力方向。"]
	quest.053FDD5AD459D89A.quest_subtitle: "旋转螺旋桨以产生推力"
	quest.05674EC2F9DCA5B9.quest_desc: ["它的工作原理与标准的大型轮胎完全相同——只是颜色发生了变化。将大型轮胎与粉色染料一同合成即可制得。"]
	quest.05674EC2F9DCA5B9.quest_subtitle: "一个染成粉色的大型轮胎。"
	quest.05B0ED6E96F9C98F.quest_desc: ["使用部署器将座椅安装到底盘上。"]
	quest.05C1F9477895F68A.quest_desc: ["它的行为方式与悬浮石完全相同。在结晶悬浮石混合物时，副手手持蓝色染料即可制得。"]
	quest.05C1F9477895F68A.quest_subtitle: "悬浮石的一种蓝色染料变体。"
	quest.06474AE970E3263B.quest_desc: ["这三个插槽可插入网络控制器。身份识别过滤器可排除特定玩家和船只，使其不被自动锁定；侦测过滤器可隐藏选定的生物和实体类型；锁定过滤器可启用自动锁定并设置其行为方式。"]
	quest.06474AE970E3263B.quest_subtitle: "决定网络能看到什么并攻击什么"
	quest.06474AE970E3263B.title: "过滤器"
	quest.066D922BF446DAC2.quest_desc: ["它将珊瑚流体转化为锻造能量，并从顶部和底部面输出电力。"]
	quest.066D922BF446DAC2.quest_subtitle: "珊瑚发电机利用珊瑚流体发电。"
	quest.06738D4C5672FC30.quest_subtitle: "装饰方块"
	quest.067F616B9FBFF858.quest_desc: ["一块带有对角“斜切”的装饰面板，可用于为火车、车厢和车站增添色彩与细节。提供全部十六种染料颜色。"]
	quest.067F616B9FBFF858.quest_subtitle: "装饰性火车面板"
	quest.06A5DB38BEB2AB65.quest_desc: ["将其安装在控制台的插槽上，即可通过红石链接频率传输模拟信号。传输功率与拉杆被推动的距离相匹配。"]
	quest.06A5DB38BEB2AB65.quest_subtitle: "拉杆模块是一个已安装的模拟拉杆。"
	quest.06C3F8867FB76CD3.quest_subtitle: "装饰方块"
	quest.07439BFD3361B311.quest_subtitle: "装饰方块"
	quest.074A4F5C89155D9C.quest_desc: ["其工作原理与标准轮胎完全相同——只是颜色不同。将轮胎与粉色染料一同合成即可制作。"]
	quest.074A4F5C89155D9C.quest_subtitle: "一个染成粉色的轮胎。"
	quest.0756F9AE5F2C72EF.quest_desc: ["&d速度&r指的是旋转部件的旋转快慢；其单位为每分钟转数（RPM），可通过转速表查看。"]
	quest.0756F9AE5F2C72EF.title: "&d速度"
	quest.075E97B2BB5F93DF.quest_desc: ["玩家无法添加或移除物品，但可以通过滑道、漏斗和物品舱口等组件进行操作。"]
	quest.075E97B2BB5F93DF.quest_subtitle: "默认情况下，每个物品储藏块的存储空间为20组。"
	quest.07774C6EA6E662CA.quest_desc: ["一种升级后的充能器，能更快地处理物品，并以更高的速率生产过充材料。"]
	quest.07774C6EA6E662CA.quest_subtitle: "速度更快、等级更高的充能器"
	quest.07BE6D0CE9B587AA.quest_desc: ["其工作原理与标准轮胎完全相同——只是颜色不同。将轮胎与蓝色染料一同合成即可制作。"]
	quest.07BE6D0CE9B587AA.quest_subtitle: "一个染成蓝色的轮胎。"
	quest.07CD5DFEA3D079F7.quest_subtitle: "装饰方块"
	quest.07CD69D9A4712343.quest_desc: ["其工作原理与标准大型轮胎完全相同——只是颜色不同。将大型轮胎与橙色染料一同合成即可制作。"]
