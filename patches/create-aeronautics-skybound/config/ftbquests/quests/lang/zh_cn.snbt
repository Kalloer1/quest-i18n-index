	quest.0834527ED1C0E83B.quest_desc: ["允许将 FE 带入“机械动力”装置内部并使用。"]
	quest.0834527ED1C0E83B.quest_subtitle: "在装置上移动和移除 FE"
	quest.0840C62E91BAD7FE.quest_desc: ["将红石链接频率分配给其按键，然后联机打字机就能像控制面板一样触发这些频率，在激活期间接管移动和绑定按键。一个方块就构成了完整的驾驶舱。"]
	quest.0840C62E91BAD7FE.quest_subtitle: "用于红石链接频率的键盘"
	quest.0862532B03A09F0A.quest_subtitle: "装饰方块"
	quest.0899F1A317DE5D5C.quest_desc: ["它能让潜艇漂浮，并能用压载舱通风口注水。其容量可通过“机械动力”的工程师护目镜查看。"]
	quest.0899F1A317DE5D5C.quest_subtitle: "压载舱用于控制潜艇的浮力。"
	quest.089F935634066F2C.quest_subtitle: "装饰方块"
	quest.08AF9A4BF08A3178.quest_desc: [
		"霓虹数字管可用于显示所连接红石元件的红石信号强度。它将显示最高的已连接信号强度。"
		""
		"当使用带有名称的命名牌或剪贴板上的文本右键点击时，该霓虹数字管以及相邻的霓虹数字管都将显示该文本。"
	]
	quest.08AF9A4BF08A3178.quest_subtitle: "霓虹数字管是一种可以显示文本或数字的方块。"
	quest.08C5D49B7352385A.quest_desc: ["它的工作原理与标准轮胎完全相同——只是颜色不同。将轮胎与绿色染料一同合成即可制作。"]
	quest.08C5D49B7352385A.quest_subtitle: "一个染成绿色的轮胎。"
	quest.08E454B4D7404865.quest_desc: ["更长的枪管可以收紧霰弹枪的散布范围并延长其有效射程，使其在近距离之外也能发挥作用。"]
	quest.08E454B4D7404865.quest_subtitle: "霰弹枪射程升级"
	quest.09197DD41E190CC2.quest_desc: ["它的效果与标准的“巨型轮胎”完全相同——只是颜色不同。将“巨型轮胎”与棕色染料一同制作即可。"]
	quest.09197DD41E190CC2.quest_subtitle: "一个染成棕色的“巨型轮胎”。"
	quest.0935AFDD2EC55212.quest_desc: ["一块带有对角“斜切”的装饰面板，可用于为火车、车厢和车站增添色彩与细节。提供全部十六种染料颜色。"]
	quest.0935AFDD2EC55212.quest_subtitle: "火车装饰面板"
	quest.09BE3D92053AE1F8.quest_desc: ["当尝试将“滚筒”放置在方块顶面时，它会被放置在该方块上方一格处，效果类似于“机械搅拌机”或“机械压力机”。尽管它看起来占据了几格空间，但实际上只占用一格。它还具备“放置辅助”功能，可以轻松地将“滚筒”放置在滚筒两侧的任一侧。使用“扳手”并潜行即可拾起“滚筒”。"]
	quest.09BE3D92053AE1F8.quest_subtitle: "“机械滚筒”可用于清理和铺设“机械装置”的路径。"
	quest.09C30D87FA134FCB.quest_desc: ["“氧气扩散器”从“电解机”获取氧气，为密封潜艇注入可供呼吸的空气，且潜艇越大消耗的氧气越多。使用红石信号激活。"]
	quest.09C30D87FA134FCB.quest_subtitle: "为你的潜艇注入可供呼吸的空气"
	quest.0A74B10BE687F032.quest_desc: ["枪械工作台用于制造武器"]
	quest.0A90DA31CA402DF7.quest_desc: ["一种圆柱形、锅炉状的方块，用于建造蒸汽机车的车身。提供全部十六种染料颜色，可与您的涂装相匹配。"]
	quest.0A90DA31CA402DF7.quest_subtitle: "装饰性锅炉方块"
	quest.0A93FEE51028A7ED.quest_desc: ["其特性与 Levitite 完全相同。在结晶 Levitite 混合物时，将橙色染料持于副手即可制作。"]
	quest.0A93FEE51028A7ED.quest_subtitle: "经橙色染料染色的 Levitite 变体。"
	quest.0A9BABB3943B966E.quest_desc: ["一种升级版发射器，可快速连续发射火箭，而非一次一枚。"]
	quest.0A9BABB3943B966E.quest_subtitle: "自动火箭发射器"
	quest.0ABCC30DE11FCCB2.quest_subtitle: "装饰方块"
	quest.0AC15613BD86D48F.quest_desc: ["一种带有对角线“斜切”的装饰面板，可用于为火车、车厢和车站增添色彩与细节。提供全部十六种染料颜色。"]
	quest.0AC15613BD86D48F.quest_subtitle: "装饰性火车面板"
	quest.0B3E3CDFD6607DE0.quest_subtitle: "装饰方块"
	quest.0B7FC480B3025463.quest_subtitle: "装饰方块"
	quest.0B8148DAF5CC9DF1.quest_desc: ["用于存放电线，以连接大电流连接器。右键点击两个连接器即可在保留线轴的同时在它们之间拉一根电线。"]
	quest.0B8148DAF5CC9DF1.quest_subtitle: "存储大电流电线"
	quest.0B8814167E371927.quest_subtitle: "装饰方块"
	quest.0B9964971081961A.quest_subtitle: "装饰方块"
	quest.0BAF6C7CDBE66846.quest_subtitle: "装饰方块"
	quest.0BBE6CADED48A971.quest_desc: [
		"用股票代码点击股票链接，即可将其连接到该网络。将生物放入座椅或烈焰燃烧器后方的股票代码处，即可将其变为股票管理员。"
		""
		"库存管理员可以看到网络上的所有物品。用户界面会显示已连接的库存链接数量。如果库存管理员处于未锁定状态，玩家可以搜索网络、请求物品，并为自己的请求指定一个收货地址。"
		""
		"如果库存管理员已锁定，其他玩家将无法访问其用户界面。库存管理员仍然可以接受购物清单。"
	]
	quest.0BBE6CADED48A971.quest_subtitle: "库存行情器用于从物流网络请求物品。"
	quest.0C23D806E2E32342.quest_subtitle: "装饰方块"
	quest.0C84748F861F2036.quest_desc: ["一个控制杆，它会接管你的鼠标，实现双轴倾斜控制，并通过可配置的红石链接频率进行传输——这是手动驾驶飞机的自然方式。"]
	quest.0C84748F861F2036.quest_subtitle: "双轴飞行操纵杆"
	quest.0C893A47E35B7F5D.quest_desc: ["刺刀可以安装在武器上，增加近战刺杀功能，让你在近身时绝不会毫无防备。"]
	quest.0C893A47E35B7F5D.quest_subtitle: "固定在枪械上的刀刃"
	quest.0C8F501F6BDFFB92.quest_desc: ["将金锭放入轧辊机中获得。"]
	quest.0C8F501F6BDFFB92.quest_subtitle: "合成组件。"
	quest.0CCF10D10F894B7A.quest_desc: ["它的功能与标准的大型轮胎完全相同——只是颜色不同。将大型轮胎与灰色染料一起合成即可制作。"]
	quest.0CCF10D10F894B7A.quest_subtitle: "涂成灰色的大型轮胎。"
	quest.0CFCA0E2A5DAC0EF.quest_subtitle: "装饰方块"
	quest.0D07BA73F633A641.quest_desc: [
		"找到矿脉后，放置取样钻头。待其完成后，用图鉴右键点击它。"
		""
		"你的矿脉图鉴现在已包含该矿脉的所有详细信息，让你可以根据此矿脉进行筛选。"
	]
	quest.0D11F4CFEADCA66D.quest_desc: [
		""
		"[ { \"text\": \"创造物品与附加件\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"41A3DDA294728106\" } } ]"
	]
	quest.0D158BAE5A38798A.quest_desc: ["允许玩家飞得更快、移动和游泳的速度也更快。在水中也能生效"]
	quest.0D2A68789BF0E3E2.quest_subtitle: "装饰方块"
	quest.0D64DF0EB98C9690.quest_subtitle: "装饰方块"
	quest.0D66BC7C5944593E.quest_subtitle: "装饰方块"
	quest.0D701C18E51413C8.quest_desc: ["它的功能与标准的“狰狞轮胎”完全相同——只是颜色有所变化。将“狰狞轮胎”与橙色染料一同合成即可制作。"]
	quest.0D701C18E51413C8.quest_subtitle: "一个染成橙色的“狰狞轮胎”。"
	quest.0D84377B8557480E.quest_desc: ["手持“示意图”右键点击“模拟机械装置”，即可打开其受力分析图——包括升力、推力、重力等——从而找出它无法正常飞行的原因。"]
	quest.0D84377B8557480E.quest_subtitle: "检查你的装置所受的力"
	quest.0DCDD36966636D1E.quest_subtitle: "装饰方块"
	quest.0DDFA97B2CCEC0B5.quest_subtitle: "装饰方块"
	quest.0DE6BF03E14CC2B0.quest_desc: ["它利用加压水和动能来产生推力。你施加的压力和速度越大，前进得就越快。"]
	quest.0DE6BF03E14CC2B0.quest_subtitle: "“水上推进器”能推动你的潜艇在海中前行。"
	quest.0DEEA086C9B29217.quest_desc: ["“创造家具”是一款能增强《我的世界》体验的模组，它为游戏增添了工业风格的家具！如果你是“创造”模组的粉丝，这款模组将引入各种材质和颜色的桌子、椅子和凳子，与你的建筑完美搭配。非常适合用来装饰工作室、餐厅或舒适的蒸汽朋克角落！"]
	quest.0DFB345FC3022432.quest_desc: [
		"[ { \"text\": \"创建内饰\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4581823B7CB90873\" } } ]"
		""
		""
		"是的，你必须把所有家具都做成各种颜色 :)"
	]
	quest.0DFB345FC3022432.title: "创建内饰"
	quest.0E5FC39E6C71A872.quest_desc: [
		"一根 &6&o轴&r&r可用于连接两个机械部件，使其中一个部件的旋转带动另一个部件旋转。"
		""
		"当两个机械部件通过一根轴连接时，施加在任一部件上的任何&2旋转力&r都会连同其&d速度&r一同传递给另一个部件。因此，如果两个部件都施加应力，就可能导致机器过载。"
	]
	quest.0E5FC39E6C71A872.quest_subtitle: "轴是“创建”模组中的一种基础机械部件。"
	quest.0E5FC39E6C71A872.title: "&l&6轴"
	quest.0E78B1230C3C72FF.quest_desc: ["一种精准且节省空间的杠杆：右键单击并拖动即可设置其模拟红石输出。使用扳手可以反转信号，使其非常适合用作引擎和燃烧器的节流阀。"]
	quest.0E78B1230C3C72FF.quest_subtitle: "紧凑型模拟红石信号源"
	quest.0EE2E9EB6DC01E34.quest_subtitle: "精密机械装置是众多合成部件之一。"
	quest.0F350D71442844CC.quest_subtitle: "装饰方块"
	quest.0F38A68481CF104F.quest_subtitle: "装饰方块"
	quest.0FEE05D17B88BAA0.quest_subtitle: "装饰方块"
	quest.1017233885BB0793.quest_desc: ["使用黄铜，你可以将铜制背式储罐升级为飞行背包，利用其内部的压缩空气推动自己在空中飞行。"]
	quest.103D729D5E2D57CA.quest_subtitle: "装饰方块"
	quest.104F5EA4EB94E7BC.quest_desc: ["适用于重型武器的大型刺刀，为发射器等武器增添强力的近战攻击能力。"]
	quest.104F5EA4EB94E7BC.quest_subtitle: "超大号武器刀刃"
	quest.105F557611E5A1B2.quest_subtitle: "装饰方块"
	quest.1068BE1AD535C83F.quest_desc: ["向其输入红石信号即可旋转到相应的比例角度，满信号可转至其可配置范围的最末端。右键单击可设置范围，请注意它会完成当前动作后才会响应新信号。"]
	quest.1068BE1AD535C83F.quest_subtitle: "机械伺服可根据红石信号设定的角度进行旋转。"
	quest.106C8ECB590FA10C.quest_desc: ["将瞄准镜安装在枪械上即可进行瞄准和缩放，让远程射击变得更容易命中。"]
	quest.106C8ECB590FA10C.quest_subtitle: "用于缩放的武器配件"
	quest.10D73ECEC48C238F.quest_desc: ["带有对角“斜切”的装饰面板，可用于为火车、车厢和车站增添色彩与细节。提供全部十六种染料颜色。"]
	quest.10D73ECEC48C238F.quest_subtitle: "装饰性火车面板"
	quest.110ECA0EC95029E6.quest_desc: ["Aeroworks 现已整合了手柄、用于精确转向的机械伺服和步进伺服，以及带有多种可安装控制模块的控制台，可用于为您的飞行器打造真正的驾驶舱。"]
	quest.110ECA0EC95029E6.quest_subtitle: "用于 Create Aeronautics 的一系列控制方块——包括陀螺仪、操纵杆、伺服和完整的控制控制台。"
	quest.113E1D3C37C63088.quest_desc: ["将金片放入轧机中获得。"]
	quest.113E1D3C37C63088.quest_subtitle: "合成组件。"
	quest.113EB654AC951E00.quest_subtitle: "装饰方块"
	quest.1149E806E09A2907.quest_subtitle: "装饰方块"
	quest.11A671DBEB7F78C9.quest_desc: ["功能类似于机械压力机。右键点击此机器并放入一个模板，然后在下方放置金属/复合板材，它就会根据模板生产零件。空手状态下 Shift+右键点击可移除已附着的模板。"]
	quest.11C4A42A7CF3ECC5.quest_subtitle: "装饰方块"
	quest.11C71C10990E8731.quest_desc: ["一种可向偏航和俯仰方向调整推力方向的定向推进器，其推力可由红石控制。每个侧面都有一个信号输入口，可使其朝该方向倾斜；使用 FE 能量运行。"]
	quest.11C71C10990E8731.quest_subtitle: "可自动瞄准的推进器"
	quest.11F75DD040DB17D5.quest_subtitle: "装饰方块"
	quest.1238442EB5F11C85.quest_subtitle: "装饰方块"
	quest.128AA441B49ADCA8.quest_desc: ["一种可向偏航和俯仰方向调整推力以实现转向的定向推进器。每个侧面都可接收红石信号，使其朝该方向倾斜。"]
	quest.128AA441B49ADCA8.quest_subtitle: "矢量推进器可以调整其推力方向。"
	quest.1339E01691579FC0.quest_desc: ["其工作原理与标准的小轮胎完全相同——只是颜色不同。将小轮胎与粉色染料一同合成即可制成。"]
	quest.1339E01691579FC0.quest_subtitle: "一个染成粉色的小轮胎。"
	quest.1345BAD71D0CBBEA.quest_desc: ["为其提供水和锻造能量（FE）即可生产氧气。它可由 Create: Crafts \\& Additions、New Age 或 Power Grid 提供动力。"]
	quest.1345BAD71D0CBBEA.quest_subtitle: "电解槽可将水转化为氧气。"
	quest.134B26C2E1C8A942.quest_subtitle: "装饰方块"
	quest.135E27A19B935CD7.quest_desc: [
		"右键点击链式传送带的链条以设置蛙口的目标，然后放置蛙口。蛙口可以放置在距离其目标链条最多 4 个方块侧方和下方的位置。"
		""
		"蛙口只会接收与其地址相匹配的包裹。地址可以通过右键点击已放置的蛙口或在它的用户界面中进行设置。"
		""
		"除非在用户界面中设置为“仅发送包裹”，否则蛙口只会发送与其地址不匹配的包裹。"
	]
	quest.135E27A19B935CD7.quest_subtitle: "包裹蛙口用于在链式传送带之间搬运纸箱包裹。"
	quest.13709C8FE062A3E8.quest_subtitle: "装饰方块"
	quest.13782C30B48A2E4F.quest_desc: ["&c应力&r是机械部件运行所需的能量，由网络中所有相互连接的部件共享；其单位为应力单位（SU）。特定部件的 &c应力&r需求或产量，可以通过佩戴工程师护目镜来查看，而网络的总 &c应力&r则可以使用应力计进行测量。"]
	quest.13782C30B48A2E4F.title: "&c应力"
	quest.138498F781268701.quest_desc: ["它的工作原理与标准轮胎完全相同——只是颜色不同。将棕色染料与轮胎一同合成即可制作。"]
	quest.138498F781268701.quest_subtitle: "一个染成棕色的轮胎。"
	quest.138A8C0EFBD15ECD.quest_subtitle: "装饰方块"
	quest.139328F8641818F5.quest_desc: ["适用于发射器的爆炸火箭。小型火箭的装药量更轻，可实现速度更快但威力更小的射击。"]
	quest.139328F8641818F5.quest_subtitle: "发射器的弹药"
	quest.13A4E7CB941F105C.quest_desc: ["安装在雷达轴承上，接收器负责收集所连接的碟形天线和平板天线的信号。每个雷达装置都需要一个接收器才能运作。"]
	quest.13A4E7CB941F105C.quest_subtitle: "雷达装置的核心"
	quest.13EC05BE3F4F7CF4.quest_desc: ["信号机安装在火车信号上方的杆子上，通过一个可移动的臂来物理显示该信号的当前状态，让你可以一目了然地读取你的网络。"]
	quest.13EC05BE3F4F7CF4.quest_subtitle: "火车信号视觉指示器"
	quest.1407EB3E7053F429.quest_desc: ["一种混合合成方块，结合了旋转动力和电力，用于制造高级物品，包括磁铁和升级材料。它能为其下方的传送带或货仓中的物品充能。"]
	quest.1407EB3E7053F429.quest_subtitle: "用动力和旋转为物品充能"
	quest.1472CD31A689D536.quest_desc: ["一种机械式炮闩，可将火炮后膛牢固密封。与传统的前膛装填设计相比，可以实现更快的重新装填。"]
	quest.147FC2959F9FC5F5.quest_desc: [
		"&6火车&r是 &3&3在火车轨道上行驶的&r&r装置<c7>。"
		""
		"组装"
		"1) 放置轨道，并用一个车站方块右键点击它。将车站方块放置在轨道附近。"
		""
		"2) 右键点击车站并选择“创建火车”，进入组装模式（车站上会显示蓝色旗帜）。"
		""
		"3) 在轨道上蓝色标记的位置放置一个或多个火车外壳。这些外壳会变成转向架。"
		""
		"4) 组装完成后，每个转向架将自动连接成列车的一部分。"
		" "
		"5) 放置一个列车控制方块，使其朝向车站指定的方向。在控制方块后方为驾驶员放置一个座位或烈焰燃烧器。"
		""
		"6) 使用强力胶等方块粘合工具将所有部件连接在一起（绿色高亮部分）。"
		""
		"7) 完成后，使用车站界面尝试组装列车。如果列车组装失败，车站界面会显示错误信息。常见错误详见下文。"
	]
	quest.147FC2959F9FC5F5.quest_subtitle: "列车外壳用于机车运输。"
	quest.14BF7274FD72C650.quest_subtitle: "装饰方块"
	quest.1536FAF4533B14B5.quest_desc: ["它能像矢量推进器一样提供推力，但运行所需的是泵送的液态燃料，而非FE。从下方为其输送燃料，并用红石控制节流阀。"]
	quest.1536FAF4533B14B5.quest_subtitle: "液态燃料矢量推进器"
	quest.154E9FD4B949BE3B.quest_subtitle: "装饰方块"
	quest.1556C1785FEBF54B.quest_desc: ["它的行为方式与浮石完全相同。在结晶浮石混合物时，将灰色染料拿在副手即可制作。"]
	quest.1556C1785FEBF54B.quest_subtitle: "浮石的一种灰色染料变体。"
	quest.15BDA3D9B6B28C8E.quest_subtitle: "装饰方块"
	quest.15DC91086C8F20D4.quest_subtitle: "装饰方块"
	quest.166E91F5D0498A1C.quest_subtitle: "装饰方块"
	quest.16A1D6FB8DB6A528.quest_subtitle: "装饰方块"
	quest.16CCD2BE50B84D2D.quest_desc: ["特斯拉尾翼可发动电力反击"]
	quest.16D59B5EAA220E3B.quest_subtitle: "装饰方块"
	quest.16DB6ABA82040A72.quest_subtitle: "装饰方块"
	quest.16EDF4808ED3BCDB.quest_desc: ["它的工作方式与标准大轮胎完全相同——只是颜色发生了变化。将大轮胎与石灰染料一同制作即可。"]
	quest.16EDF4808ED3BCDB.quest_subtitle: "一个染成石灰色的大轮胎。"
	quest.172BBA1DCEDD6B3A.quest_desc: ["灵活的线路，可在您的装置中传输电流。它们能实现在发电机、马达、通电装置及其他能量设备之间的电力传输。"]
	quest.172BBA1DCEDD6B3A.quest_subtitle: "合成组件"
	quest.177C0E37A35A14F4.quest_desc: [
		"当由动能提供动力时："
		""
		"会开始使所连接的结构朝向当前小时方向旋转。如果第一个结构前方存在第二个独立结构，它将充当分针。"
		""
		"可从方块侧面进入数值设置界面，用于更改指针顺序或切换为类似时钟物品的24小时制读数。"
	]
	quest.177C0E37A35A14F4.quest_subtitle: "发条轴承是机械轴承的进阶版本，可根据当前的游戏时间旋转最多两个时钟指针。"
	quest.17D0698D08215065.quest_desc: ["一种圆柱形、锅炉状的方块，用于建造蒸汽机车的车身。提供全部十六种染料颜色，以匹配您的涂装。"]
	quest.17D0698D08215065.quest_subtitle: "装饰性锅炉方块"
	quest.17DC15D630B68361.quest_desc: ["弹匣履带通过弹药带为转轮供弹，极大地增加了其在重新装填前可发射的子弹数量。"]
	quest.17DC15D630B68361.quest_subtitle: "转轮容量升级"
	quest.17DCE87DC09D628D.quest_desc: ["实体传送器可以将任何实体传送到一个实体传送器接收器。它使用传送汁作为燃料。要将其与实体传送器接收器连接，请使用 TP 链接。"]
	quest.17E2FDDC3AF13ED1.quest_subtitle: "装饰方块"
	quest.17E782AB29435F2A.quest_desc: ["投掷绳索连接器，将绳索连接到远处的锚点，再将其连回绳索绞盘。这是一种快速将自身固定到地形或其他装置上的方法。"]
	quest.17E782AB29435F2A.quest_subtitle: "将绳索投掷到锚点"
	quest.182EBAFAD48AA85E.quest_desc: [
		"&n&l&a创造进化&r&r&r是一款基于《创造》模组的整合包，你的目标是利用 &n&l《创造》6.0&r&r 及其最佳附加模组的力量，建造复杂的机器、动力工厂，甚至是庞大的列车。"
		""
		"你将从小规模开始，但很快你就能实现农场自动化、为整个系统供能，并建造出能为你移动、挖掘和制作的精巧装置。"
	]
	quest.1837076B0EA3C11A.quest_desc: [
		"机械传送带是一种机械组件，用于传递旋转并移动物品和实体。"
		""
		"放置传送带至少需要两根 &6轴&r。右键单击第一根轴，然后再右键单击第二根轴即可放置传送带。无论长度如何，这只会消耗一条机械传送带。两根轴必须朝向同一方向。"
		""
		"机械传送带可以放置在任意数量水平、垂直或对角线（朝向 Y 轴 45°）排列的转轴上，前提是没有任何障碍物，且总长度不超过二十个方块。机械传送带还要求两个转轴朝向相同。"
	]
	quest.18594A0013B696D4.quest_desc: ["根据其朝向输出红石信号，默认向下坡方向发射。使用其值框设置信号最强的角度——非常适合自动调平。"]
	quest.18594A0013B696D4.quest_subtitle: "读取你的倾斜度和朝向"
	quest.1876601DA32D8FFD.quest_desc: ["提升狼的护甲值和生命值，并赋予其火焰免疫效果"]
	quest.187FE6A1129EFDC9.quest_desc: ["用于间接火力的高抛物线投射物。迫击炮弹以速度换取高度，使其能够打击掩体后方或墙顶的目标。"]
	quest.18DE1971E66D39E8.quest_subtitle: "装饰方块"
	quest.18DEEA2136F90546.quest_desc: ["你可以在地牢中找到蓝图"]
	quest.191A2F855396BDCD.quest_desc: ["自动为使用燃料的小工具和护甲补充燃料。"]
	quest.1978F486110CBC58.quest_desc: ["其作用方式与标准的大型轮胎完全相同——只是颜色不同。将大型轮胎与青色染料一同合成即可制作。"]
	quest.1978F486110CBC58.quest_subtitle: "一个染成青色的大型轮胎。"
	quest.197AB0E07A40512F.quest_subtitle: "水车是一种旋转动力来源。当水流冲刷水车时，它会生成旋转力。"
	quest.19CA43E37C9DFD02.quest_desc: ["A 带有对角“斜切”的装饰面板，可用于为火车、车厢和车站增添色彩与细节。提供全部十六种染料颜色。"]
	quest.19CA43E37C9DFD02.quest_subtitle: "装饰性火车面板"
	quest.19F98EEB9FD2AA5A.quest_desc: ["一个圆柱形、锅炉状的方块，用于建造蒸汽机车车身。提供全部十六种染料颜色，以匹配您的涂装。"]
	quest.19F98EEB9FD2AA5A.quest_subtitle: "装饰性锅炉方块"
	quest.1A39BEF8AE87A47A.quest_desc: ["反应堆散热口会从反应堆中收集热量，并将其分配到相连的管道中。"]
	quest.1A39BEF8AE87A47A.quest_subtitle: "从反应堆中排出热量"
	quest.1A3C7EB8A16B244C.quest_desc: ["其作用方式与标准的巨型轮胎完全相同——只是颜色不同。将红色染料与巨型轮胎一同合成即可制作。"]
	quest.1A3C7EB8A16B244C.quest_subtitle: "一个染成红色的巨型轮胎。"
	quest.1A61ABEC34369F47.quest_desc: ["一个可在未通电时改变旋转方向的换挡器"]
	quest.1A7A743DC5970B6D.quest_subtitle: "装饰方块"
	quest.1A860155658FC9FD.quest_subtitle: "装饰方块"
	quest.1A8C05A7097D795F.quest_desc: [""]
	quest.1A9E3C04FD1175B0.quest_desc: ["锅炉加热器的工作原理与烈焰燃烧器相同，但它使用的是热量而非可燃燃料。"]
	quest.1A9E3C04FD1175B0.quest_subtitle: "使用管道输送的热量来加热锅炉"
	quest.1AA59324FF59C543.quest_desc: ["一个带有对角“斜切”的装饰面板，可用于为火车、车厢和车站增添色彩与细节。提供全部十六种染料颜色。"]
	quest.1AA59324FF59C543.quest_subtitle: "装饰性火车面板"
	quest.1AE7D3151046ACB2.quest_desc: ["其作用方式与标准的小轮胎完全相同——只是颜色不同。将橙色染料与小轮胎一同合成即可制作。"]
	quest.1AE7D3151046ACB2.quest_subtitle: "一个染成橙色的小轮胎。"
	quest.1B04A295850D0F00.quest_subtitle: "列车观测者用于检测经过的列车。"
	quest.1B46271C2C22D0F4.quest_desc: ["分裂枪管可将钉枪的输出分散成数枚钉子，每次射击都能将它们喷洒到更宽广的扇形区域。"]
	quest.1B46271C2C22D0F4.quest_subtitle: "钉枪枪管升级"
	quest.1B65E8BE91A087DA.quest_desc: [
		"放置链式传送带后，可以用链条右键点击它们，将其连接到其他链式传送带上。再次右键点击该链式传送带即可取消选择。"
		""
		"链式传送带之间的最大放置距离为 32 个方块，如果距离为 32 个方块，则可以向侧面额外延伸 8 个方块。"
		""
		"链式传送带在有高度差的情况下连接的最大角度为 45°，这大约相当于每水平 2 个方块对应 1 个垂直方块。中心对中心的最长直线坡度为 30L 比 14H。"
	]
	quest.1B65E8BE91A087DA.quest_subtitle: "链式传送带用于运输纸箱包裹。"
	quest.1B7E32BFF923587C.quest_subtitle: "装饰方块"
	quest.1C0C32B31CEBFFE7.title: "标牌"
	quest.1C2A78D2E27BB4D4.quest_subtitle: "装饰方块"
	quest.1C33870BEE8D21BA.quest_desc: ["任何火炮的命脉所在。无论是简单的石弹还是高爆炮弹，弹药都必须精心制作，以确保可靠性——并避免哑火！"]
	quest.1C8376900AE4279D.quest_desc: ["紧凑型大炮推进剂，可以填充不同等级的更强力推进剂。"]
	quest.1CB771DFCD8E6104.quest_subtitle: "装饰方块"
	quest.1CC06C4B4C26D8EB.quest_desc: ["它的工作方式与标准轮胎完全相同——只是颜色会发生变化。将轮胎与红色染料一起制作即可。"]
	quest.1CC06C4B4C26D8EB.quest_subtitle: "一个染成红色的轮胎。"
	quest.1D00D782B8F0B6D6.quest_desc: [
		"机械搅拌器由内部的齿轮驱动，其作用方式与齿轮本身无异，会将旋转传递给相邻的组件，并向侧面传递和反转旋转。"
		""
		"搅拌器需要其动力源提供至少 30 RPM 的旋转速度才能工作。搅拌器的速度越快，处理原料的速度就越快。"
		""
		"搅拌器必须放置在集水盆正上方，两者之间间隔 1 个方块才能工作。通过将原料投入搅拌器来输入有效的配方后，搅拌器会自动将这些原料混合。"
	]
	quest.1D00D782B8F0B6D6.quest_subtitle: "机械搅拌器是一种机械组件，可将搅拌配方和无形状合成配方应用于集水盆中的物品。"
	quest.1D197B1919452187.quest_desc: ["一种紧凑型红石链接器，无需占用额外方块空间，即可为按钮、拉杆和已连接的拉杆添加无线红石功能。"]
	quest.1D25F4E1ABD9FBC6.quest_desc: ["通过对钻石充能获得。"]
	quest.1D25F4E1ABD9FBC6.quest_subtitle: "合成物品。"
	quest.1D4E2D891761080F.quest_desc: ["反应棒可使核反应得以进行。"]
	quest.1D4E2D891761080F.quest_subtitle: "容纳驱动核裂变的燃料。"
	quest.1DBA8DD396081924.quest_desc: ["接口必须相对放置，间隔 1-2 个方块，一个安装在带有流体储罐的机械装置上，另一个保持固定。需要使用流体泵才能向机械装置中注入或从中提取液体。要将液体泵送至另一个储罐，只需用流体管道连接固定接口和流体储罐即可，但移动液体时需要使用泵。"]
	quest.1DBA8DD396081924.quest_subtitle: "便携式流体接口用于向机械装置的流体库存中注入或从中提取流体。"
	quest.1DE518F08CA41569.quest_subtitle: "装饰方块"
	quest.1E01AC22D5903AD1.quest_desc: ["安装了齿轮的手摇曲柄。适用于齿轮比设置和狭窄空间。"]
	quest.1E10DF8C6E1DB362.quest_subtitle: "装饰方块"
	quest.1E7AEBE54E36EC20.quest_subtitle: "装饰方块"
	quest.1F36CF5D11E08839.quest_desc: ["用于连接锻铁能量方块与大电流导线，传输的电量远超小型连接器。"]
	quest.1F36CF5D11E08839.quest_subtitle: "大电流能量节点"
	quest.1F6F077E5A84C184.quest_desc: ["它的行为方式与悬浮石完全相同。在结晶悬浮石混合物时，手持淡蓝色染料即可合成。"]
	quest.1F6F077E5A84C184.quest_subtitle: "悬浮石的一种淡蓝色染色变体。"
	quest.1FA5F057BD19565D.quest_desc: [
		"[ { \"text\": \"创建装饰\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"55F4BB16DB93C01E\" } } ]"
		""
		"是的，你必须亲手制作所有装饰品 :)"
	]
	quest.1FDBAB8FCE901BB3.quest_desc: ["一种圆柱形、类似锅炉的方块，用于建造蒸汽机车的车身。提供全部十六种染料颜色，可匹配你的涂装。"]
	quest.1FDBAB8FCE901BB3.quest_subtitle: "装饰性锅炉方块"
	quest.1FDBB75ECD39FB24.quest_desc: [
		"物品排水槽一次最多可容纳 1500mb 流体。需要流体泵才能提取流体。"
		""
		"水槽会自动将其输出的流体存入放置在附近的项目排水槽中。"
	]
	quest.1FDBB75ECD39FB24.quest_subtitle: "物品排水槽会从放置在其上的物品（如桶和瓶子）中排出流体。"
	quest.1FEFD4A091122E0C.quest_desc: ["用旋转力使其转动，从而为校准推进器等方块产生 FE——转速越快，产生的 FE 就越多。工业发电机是更高输出版本。"]
	quest.1FEFD4A091122E0C.quest_subtitle: "发电机将旋转转化为 Forge 能量。"
	quest.200C7DCA8C9775E8.quest_subtitle: "装饰方块"
	quest.204DC04BB63BE796.quest_subtitle: "装饰方块"
	quest.2098CA328801A7A3.quest_desc: ["可容纳一个已捕获的物理造物，以便您携带它并在稍后将其打印回世界中。"]
	quest.2098CA328801A7A3.quest_subtitle: "便携式结构容器可将一个造物存储为便携式蓝图。"
	quest.2098E696235F3F72.quest_subtitle: "装饰方块"
	quest.20E81D9330FA1564.quest_desc: ["有了可以飞行的装置后，下一步就是控制。接下来的方块涵盖了转向、传感器以及与红石连接的控制系统，用于操控您的机器。"]
	quest.20E81D9330FA1564.quest_subtitle: "操控、感知并指挥您的造物"
	quest.20E81D9330FA1564.title: "导航"
	quest.212E674A67684837.quest_subtitle: "装饰方块"
	quest.21495368D43E2A78.quest_subtitle: "装饰方块"
	quest.215D766150B54B17.quest_desc: ["用于存放电线，以连接低电流连接器。右键点击两个连接器即可在保持线轴的情况下在它们之间拉一根电线。"]
	quest.215D766150B54B17.quest_subtitle: "存储低电流电线"
	quest.2162DB844DCC7459.quest_desc: ["您可以在地牢中找到蓝图"]
	quest.218D2983736284D7.quest_desc: [
		"Schematics 可用于 Schematicannon 或 Deployers。使用前，必须右键单击并借助屏幕上的控件来调整位置，从而选定 Schematic 的坐标。按住 Shift 键并右键单击可打开一个界面，用于输入精确的坐标。"
		""
		"手持 Schematic And Quill 右键单击两个方块，以选定要复制到 Schematic 中的区域。再次右键单击可为该 Schematic 命名、保存和/或上传。"
		""
		"保存 Schematic 会将其上传至 Schematic 文件，以便再次使用 Schematic And Quill。执行“保存并上传”后，无需 Schematic Table 即可在 Schematicannon 或 Deployer 中使用该 Schematic And Quill。"
		""
		"按住 Shift 键并右键单击可取消选区。按住 Ctrl 键可在半空中高亮一个方块，并通过滚动来调整距离。选定两个方块后，观察所选区域的各个面，然后按住 Ctrl 键并滚动以调整大小。"
		""
		"如果已保存一个 Schematic，则可以使用 Schematic Table 将其复制到一个空的 Schematic 中。此操作可在不同世界之间进行。"
	]
	quest.218D2983736284D7.title: "Schematics"
	quest.2190A7DE1035B4A3.quest_desc: ["手持空的 Chunk Loader 右键单击 Ghast，即可将其捕获。"]
	quest.21A830CC8DAD6566.quest_desc: [
		"右键点击铁轨，然后将车站在距离铁轨 15 个方块内放置。车站只有在放置在直轨上时才能生成列车，而转向架只能放置在长度为 3 个方块的直轨上。"
		""
		"在界面中，车站可以被命名；这些名称将用于非玩家操控的列车识别车站。当列车无法被指令前往一个与当前所在车站同名的车站，否则它会在多个同名的车站中选择最近的可访问车站。"
		""
		"如果车站被使用了名称，该名称也会像旗帜一样显示在地图上。"
	]
	quest.21A830CC8DAD6566.quest_subtitle: "列车车站用于生成、拆解和引导列车。"
	quest.21B40BEC30B40491.quest_desc: [
		"手持漏斗时，玩家无法访问物品栏，而是会将物品放入其中。潜行状态下右键点击漏斗，会将其置于输入模式。"
		""
		"使用扳手点击漏斗，可在输入和输出模式之间切换。可以施加红石信号来停止漏斗的输入或输出。右键点击漏斗并将其对准机械传送带，会使传送带向前延伸一个方块。"
	]
	quest.21B40BEC30B40491.quest_subtitle: "安山岩漏斗用于从物品栏中提取或插入物品，其性质与黄铜漏斗类似。"
	quest.21B40BEC30B40491.title: "漏斗"
	quest.21C1B82822A265E6.quest_desc: ["向其施加红石信号，以释放电解器产生的氧气。潜艇越大，消耗的氧气就越多。"]
	quest.21C1B82822A265E6.quest_subtitle: "氧气扩散器可让您的潜艇内部保持呼吸顺畅。"
	quest.21E6582F7CFB0C50.quest_desc: ["核反应堆是产生大量热量的绝佳方式。"]
	quest.21E6582F7CFB0C50.quest_subtitle: "建造核反应堆的外壳。"
	quest.220D373752A1C70A.quest_desc: ["网络控制器是每条网络构建的核心方块。使用数据链将其与监视器、雷达和武器网络连接，并插入过滤物品来控制其可见和可瞄准的目标。"]
	quest.220D373752A1C70A.quest_subtitle: "雷达网络的核心。"
	quest.2224562C0A197981.quest_desc: [
		"&l<< 通用 >>&r"
		"&5&l<< 自动化 >>&r&r"
		"&3&l<< 装饰 >>&r&r"
		"&2&l<< 实用工具 >>&r&r"
		"&4&l<< 载具 >>&r&r"
		"&b&l创造航空&r&r"
		""
		"&a&l创造进化&r&r"
		""
		"&l&n&4存在错误，请勿合成&r&r&r"
	]
	quest.224B05FA6B4DDAC3.quest_subtitle: "装饰方块"
	quest.22A7A43271207EDE.quest_desc: ["制造一列至少包含 6 节车厢的火车。"]
	quest.22AC3C79141AB3FC.quest_desc: ["将一张电金板放入轧机中获得。"]
	quest.22AC3C79141AB3FC.quest_subtitle: "合成组件。"
	quest.22B2AE9DDBBC5079.quest_desc: ["其作用与标准的小轮胎完全相同——只是颜色不同。将小轮胎与紫色染料一同合成即可制作。"]
	quest.22B2AE9DDBBC5079.quest_subtitle: "一个染成紫色的小轮胎。"
	quest.22EADF4D0392DDBF.quest_subtitle: "装饰方块"
	quest.232BDFE44283C641.quest_desc: ["最高等级的电动机，为高要求的机械提供最高的旋转输出和应力承受能力。"]
	quest.232BDFE44283C641.quest_subtitle: "最强大的电动机。"
	quest.23333F57CC56FE69.quest_desc: ["A machine that converts electrical energy back into rotational force, allowing it to power Create machinery using electricity."]
	quest.23333F57CC56FE69.quest_subtitle: "将电能转回旋转动力"
	quest.23A9A2D399A7BF94.quest_desc: [
		"Elevator Pulley 的运行方式与 Rope Pulley 非常相似，并共享某些功能。与 Rope Pulley 不同，它可以穿过方块，并且除非右键点击该滑轮，否则不会变回方块。"
		""
		"要组装一个 Elevator Pulley，装置上必须只有一个水平的 Redstone Contact。如果添加了多个，则 Elevator 将无法组装。如果任一条件不满足，在查看 Elevator Pulley 时会显示相应的错误消息。"
	]
	quest.23A9A2D399A7BF94.quest_subtitle: "Elevator Pulley 是一种可用于轻松建造多层电梯的装置。"
	quest.23C4D2DA6DEB2D9A.quest_desc: ["它的行为与 Levitite 完全相同。在结晶 Levitite Blend 时，将 lime dye 持于副手即可制作。"]
	quest.23C4D2DA6DEB2D9A.quest_subtitle: "经过 lime dye 染色的 Levitite 变体。"
	quest.2479F1DB0C7B4227.quest_subtitle: "装饰方块"
	quest.24CFA0022432887E.quest_desc: [
		"当玩家放置时，阈值开关会尝试朝向相邻的容器。如果存在多个容器或没有容器，阈值开关可能会朝向玩家，并且可以像往常一样使用扳手进行调整。目前，它无法垂直放置。"
		""
		"可以设置物品阈值来决定红石信号何时开启或关闭。开关刚被放置时处于关闭状态，直到容器装满 75% 后开启，然后一直保持开启状态，直到容器内物品减少到 25% 时关闭。"
		""
		"箱子图标代表容器的填充程度，以及当前的信号状态（开启/关闭），具体取决于箱子图标所在的轨道。箭头代表容器阈值，当箱子图标到达箭头位置并切换轨道时，即可直观地看到这一变化。"
		""
		"点击下方阈值条旁边显示两个相反箭头的按钮，即可反转信号。"
	]
	quest.24CFA0022432887E.quest_subtitle: "阈值开关可以测量容器的填充程度，并能在设定的阈值下发出红石信号。"
	quest.24DDED464AE48E05.quest_subtitle: "在接收到红石信号时，反转输出的旋转力。"
	quest.24EF403EFD9364EA.quest_subtitle: "装饰方块"
	quest.251A6CA0F0E72812.quest_desc: ["它的工作原理与标准的小轮胎完全相同——只是颜色不同。将小轮胎与白色染料一起合成即可制作。"]
	quest.251A6CA0F0E72812.quest_subtitle: "A 白色染色的小轮胎。"
	quest.251ED9DA3DE04C84.quest_desc: ["它的功能与标准巨型轮胎完全相同——只是颜色不同。将黑色染料与巨型轮胎部件一同合成即可制成。"]
	quest.251ED9DA3DE04C84.quest_subtitle: "A 黑色染色的巨型轮胎。"
	quest.2580602D7B567F11.quest_desc: [""]
	quest.25B581A958F22442.quest_desc: ["光学传感器会发射出自己的光束，当有方块阻挡时，它会发出红石信号，信号强度取决于该方块的距离——可作为高度计或接近传感器使用。"]
	quest.25B581A958F22442.quest_subtitle: "检测其视线范围内的方块。"
	quest.25F85A44A7263CE2.quest_subtitle: "装饰方块。"
	quest.261ABBDC3DABD8B3.quest_desc: ["一个仅在输入按配置方向旋转时才会耦合的离合器。"]
	quest.266333887C50549A.quest_subtitle: "装饰方块。"
	quest.267D46D6C7A4135D.quest_desc: ["使用数据链连接各个组件：将雷达连接到显示器，将控制器连接到支架，或将整个网络连接起来。蓝色链接表示雷达网络，红色链接表示武器网络。"]
	quest.267D46D6C7A4135D.quest_subtitle: "连接雷达网络。"
	quest.26FC1ECA5BD96A5A.quest_subtitle: "装饰方块。"
	quest.2714522D47F8DF76.quest_subtitle: "装饰方块。"
	quest.27501BB6D880313F.quest_subtitle: "装饰方块。"
	quest.27C77E7A13ADCD22.quest_desc: ["一种升级后的电动机，其旋转力和应力承受能力均强于基础电动机。"]
	quest.27C77E7A13ADCD22.quest_subtitle: "更强大的电动机。"
	quest.27CF01E530CC4280.quest_desc: ["它的功能与标准轮胎完全相同——只是颜色不同。将青色染料与轮胎部件一同合成即可制成。"]
	quest.27CF01E530CC4280.quest_subtitle: "A 青色染色的轮胎。"
	quest.27D967F82EA5FCB6.quest_desc: ["霰弹枪以宽广的散射模式发射霰弹，近距离杀伤力巨大。弹鼓、泵和各式枪管可以改变其容量、装填速度和散射范围。"]
	quest.27D967F82EA5FCB6.quest_subtitle: "近距离散落的弹丸"
	quest.27E82AF63B72C2D3.title: "创建内部结构"
	quest.28051E5A4E16EEB3.quest_subtitle: "装饰方块"
	quest.28F474CD6C235765.quest_desc: ["带有一个对角线“斜切”的装饰面板，可为火车、车厢和车站增添色彩与细节。提供全部十六种染料颜色。"]
	quest.28F474CD6C235765.quest_subtitle: "火车装饰面板"
	quest.29109FB86FC8C337.quest_desc: ["将其安装在控制台上即可实现左右转向。它通过独立的红石链接频率传输信号，其功率随转向角度变化而变化。"]
	quest.29109FB86FC8C337.quest_subtitle: "转向轮模块是一个可安装的转向盘。"
	quest.291911E6EC50FEFC.quest_desc: ["用于抓取、移动和重新定位航空学物理结构的磁场枪。"]
	quest.291911E6EC50FEFC.quest_subtitle: "磁场枪可从远处操控物理载具。"
	quest.295355BB9EAD84CE.quest_subtitle: "装饰方块"
	quest.297482217403729E.quest_desc: ["当与其连接的炮架正确对准目标时，火控装置会立即发出红石信号，让您能够自动触发开火。"]
	quest.297482217403729E.quest_subtitle: "对准目标后拉动扳机"
	quest.297D9D3AFF54F578.quest_subtitle: "装饰方块"
	quest.29D1EEFD160B4FB7.quest_desc: ["坚固的玻璃窗，能让潜水艇在深海中观察外部而不会因压力而破裂。提供铁质和铜质加压玻璃两种变体。"]
	quest.29D1EEFD160B4FB7.quest_subtitle: "加压玻璃为潜水艇提供耐压舷窗。"
	quest.29D1EEFD160B4FB7.title: "加压玻璃"
	quest.2A1672C12095B77D.quest_desc: ["通电后，经过设定的延迟时间，会发出一段短的红石脉冲。按住右键可进入其“数值设置”界面来设定延迟时间。延迟时间可在 2 刻钟至 60 分钟之间调节。此外，还可以使用剪贴板将延迟时间复制并粘贴到其他中继器或脉冲延长器上。"]
	quest.2A1672C12095B77D.quest_subtitle: "经过设定的延迟时间后发送一段脉冲。"
	quest.2A16B58B805EAA44.quest_desc: ["将其放置在旋转速度至少为 30 RPM 的转轴上方，并在其下方放置一张导航桌。插入一枚导航罗盘后，它会根据与目标的距离输出红石信号，同时将罗盘传递到下方的桌子上。"]
	quest.2A16B58B805EAA44.quest_subtitle: "导航追踪器可读取你与目标之间的距离。"
	quest.2A404708E175235F.quest_desc: [
		"可以通过流体管道从流体储罐中存储和提取流体。流体管道可以放置在流体储罐的任何面上：顶部、底部或侧面。储罐的观察窗可以用扳手切换。"
		""
		"流体管道中的流动方向表示流体是将被注入储罐还是从储罐中抽出；如果流体流向储罐，则会被储存在罐中。同样，如果流体管道（通过机械泵）从储罐向外流动，则储罐中的流体将被抽出到该管道中。"
	]
	quest.2A404708E175235F.quest_subtitle: "流体箱是一种流体存储装置，每个方块最多可存储 8 桶流体。"
	quest.2A551BE1F400D395.quest_desc: ["通过旋转提供动力，并通过管道与压载水箱连接，压载通风口可管理水箱中的水量以实现下潜或上浮。它必须接触海水；反转旋转即可将水排出。"]
	quest.2A551BE1F400D395.quest_subtitle: "将水注入和排出压载水箱"
	quest.2A5F1CF43B2A25B1.quest_desc: ["将其安装在控制台上，即可设置模拟油门输出。其红石链接频率传输的功率与油门的推入程度相匹配。"]
	quest.2A5F1CF43B2A25B1.quest_subtitle: "油门象限是一个已安装的油门杆。"
	quest.2A633229781DDBFC.quest_desc: ["向压载水箱注水即可下沉，排空水箱即可上浮。水箱越多，能增加的重量就越大——一艘重型潜艇需要大量水箱。"]
	quest.2A633229781DDBFC.quest_subtitle: "让潜艇能够上浮和下潜"
	quest.2A6ECCE28B9C64FB.quest_desc: ["一个黄铜制的空中伙伴，如果玩家持有控制器，它就会跟随玩家。"]
	quest.2AD699385AFD7EC6.quest_desc: ["燧发枪是初始枪械，使用纸弹装填。装填速度较慢但制作成本低，是许多枪管和枪膛升级的基础。"]
	quest.2AD699385AFD7EC6.quest_subtitle: "一款简单的单发黑火药手枪"
	quest.2ADDA74C73C08DB2.quest_desc: ["一个齿轮箱，其所有 4 个侧面的旋转方向均可独立配置"]
	quest.2AF85A5EE9A8CCBA.quest_desc: ["一个仅在输入转速高于可配置阈值时才会耦合的离合器"]
	quest.2B034CFAB4E61883.quest_desc: ["扩散枪管可扩大弹丸散布范围，在近距离覆盖更大区域，但会牺牲射程。"]
	quest.2B034CFAB4E61883.quest_subtitle: "霰弹枪散布升级"
	quest.2B3A70E34CB0CE21.quest_desc: ["自动补充消耗燃料的道具和护甲。"]
	quest.2B66C393EA75E762.quest_desc: ["口袋维度遥控器可将玩家传送至一个用于测试或存放机器或方块的自定义维度中的小房间。"]
	quest.2B78716AFA762871.quest_subtitle: "装饰方块"
	quest.2B860A075CE180C0.quest_desc: ["最强的充能器，能以最高速度为物品充能，从而大规模生产过充材料。"]
	quest.2B860A075CE180C0.quest_subtitle: "顶级充能器"
	quest.2BAB0966D120FD5B.quest_subtitle: "装饰方块"
	quest.2BCD965B53AA7702.quest_subtitle: "装饰方块"
	quest.2C00F0070ACC0D49.quest_desc: ["其工作原理与铜制流体储罐相同，但每个方块可容纳的流体量翻倍。"]
	quest.2C00F0070ACC0D49.quest_subtitle: "铂金流体储罐可大量储存流体。"
	quest.2C1CBD078BDBA583.quest_desc: ["该拉杆可发出强度可调的红石信号。右键点击可增强信号强度，Shift+右键点击可减弱信号强度。佩戴工程师护目镜时，查看拉杆即可看到当前信号强度。"]
	quest.2C1CBD078BDBA583.quest_subtitle: "模拟拉杆用于通过玩家输入发出可变信号。"
	quest.2C224C8A4945C10E.quest_desc: ["其工作原理与标准小轮胎完全相同——只是颜色不同。将小轮胎与黄色染料一同合成即可制作。"]
	quest.2C224C8A4945C10E.quest_subtitle: "一个染成黄色的小轮胎。"
	quest.2C249B79E1B80CBB.quest_desc: ["右键点击接收器即可设置坐标。"]
	quest.2C50E0D12250E1A5.quest_desc: ["它的运作方式与标准的“怪物轮胎”完全相同——只是颜色发生了变化。将淡蓝色染料与“怪物轮胎”一同制作即可。"]
	quest.2C50E0D12250E1A5.quest_subtitle: "一个染成淡蓝色的“怪物轮胎”。"
	quest.2C51DD06F3E9AA06.quest_desc: ["“创造深海”（亦称“创造潜艇”）扩展了“创造”模组和 Sable 物理引擎的系统，使玩家能够建造、驾驶并生存于功能完备且基于物理的潜艇中。"]
	quest.2C51DD06F3E9AA06.quest_subtitle: "“创造航空”模组中的潜艇！"
	quest.2C585F7EFC9B3380.quest_desc: ["拔出插销并投掷：破片手榴弹会在短暂的引信后爆炸，将破片散布到一片广阔区域。"]
	quest.2C585F7EFC9B3380.quest_subtitle: "可投掷的爆炸物"
	quest.2CD70FCC8B119D7A.quest_desc: ["泵上的棕色箭头符号表示流动方向。使用扳手可以改变流动方向。当使用扳手时，整个阀门看起来会旋转 180 度。棕色的方向箭头会出现在泵齿轮的另一侧。"]
	quest.2CD70FCC8B119D7A.quest_subtitle: "机械泵每次只会朝一个方向输送流体。"
	quest.2CF12EE122D19969.quest_desc: ["检测附近红石连接件的角度：正前方的连接件会发出完整信号，而角度越浅，输出信号越弱——这对于定位和对齐很有用。"]
	quest.2CF12EE122D19969.quest_subtitle: "感应红石连接件的方位"
	quest.2D120A624CB6E71F.quest_subtitle: "装饰方块"
	quest.2D48935A2672EB8B.quest_desc: ["烈焰枪燃烧燃料，在近距离喷射出持续的火焰，点燃路径上的一切。"]
	quest.2D48935A2672EB8B.quest_subtitle: "喷射出一股火焰流"
	quest.2D5881A96D74E6CE.quest_subtitle: "装饰方块"
	quest.2D690C364D0A6EBB.quest_desc: ["监视器会在雷达屏幕上显示探测到的目标。用数据链将其连接到网络控制器，然后点击屏幕上的目标，即可让武器瞄准。"]
	quest.2D690C364D0A6EBB.quest_subtitle: "显示雷达探测到的所有内容"
	quest.2D6FF740F5A6A951.quest_desc: ["它的功能与标准的小轮胎完全相同——只是颜色不同。将小轮胎与红色染料一同制作即可。"]
	quest.2D6FF740F5A6A951.quest_subtitle: "一个染成红色的小轮胎。"
	quest.2D70F503EA6F2994.quest_desc: ["预先制作好的螺旋桨，可以直接安装在螺旋桨轴承上。两者旋转时都能产生推力——帆面积越大，拉力就越强。"]
	quest.2D70F503EA6F2994.quest_subtitle: "现成的螺旋桨叶片"
	quest.2DDEE427631057EE.quest_subtitle: "装饰方块"
	quest.2E04E637DF99BB5A.quest_subtitle: "装饰方块"
	quest.2E2AE972B1AABC41.quest_subtitle: "装饰方块"
	quest.2E8B8DBE61162084.quest_desc: [
		"它们可以被过滤以只允许特定物品通过，并且可以用红石信号停止。与漏斗不同，它们可以同时插入和提取物品，但只能垂直工作。"
		""
		"当直接位于一个容器正下方时，过滤槽会兼作一个值设置二极管，和黄铜漏斗非常相似。滑槽可以调节，以提取最多或恰好设定数量的物品。智能滑槽的值设置即使在上方容器被摧毁后也会保存，但这不会影响滑槽在没有容器时的行为。"
	]
	quest.2E8B8DBE61162084.quest_subtitle: "智能滑槽的行为与黄铜漏斗类似。"
	quest.2EEBDC974094D856.quest_desc: ["它的工作方式与标准的小轮胎完全相同——只是颜色发生了变化。将小轮胎与淡蓝色染料一起合成即可制作。"]
	quest.2EEBDC974094D856.quest_subtitle: "一个染成淡蓝色的小轮胎。"
	quest.2EEEC66CD4A82F71.quest_desc: ["增加狼的护甲值"]
	quest.2F0B0D4401AA455E.quest_desc: [
		"可以使用扳手来为隧道安装窗户。"
		""
		"隧道不会阻止传送带上的物品被封闭式风扇处理，但会阻止气流超出传送带的范围。"
		""
		"安山岩隧道还可用于将单个物品从经过的堆叠中分离出来，并将其导向侧方输出。"
	]
	quest.2F0B0D4401AA455E.quest_subtitle: "用于机械传送带的装饰性隧道。"
	quest.2F0B0D4401AA455E.title: "隧道"
	quest.2F6B432512FA2A65.quest_desc: ["连接到任意容器以扩展其表面积。非常适合在狭窄空间内存取物品，以及与阈值开关进行巧妙搭配。"]
	quest.2F7927F6017F4F61.quest_subtitle: "装饰方块"
	quest.2F7C30CFCD7A1215.quest_desc: ["A 激光笔通电后会发射激光，当激光束未被阻挡时，激光传感器可以检测到——这是一种干净利落的方式，可用于跨越间隙发送红石信号，或在有物体阻挡光束时触发机关。"]
	quest.2F7C30CFCD7A1215.quest_subtitle: "光束上的红石"
	quest.2FF2B3FE18ABCB2D.quest_desc: ["安装式光源会发出照明"]
	quest.300A77D1A972AC59.quest_desc: ["一种圆柱形、类似锅炉的方块，可用于建造蒸汽机车的车身。提供全部十六种染料颜色，以匹配你的涂装。"]
	quest.300A77D1A972AC59.quest_subtitle: "装饰性锅炉方块"
	quest.302D29E43E9C9A94.quest_desc: [
		"当与任意物品栏相邻放置时，打包机可以从其附着的物品栏中制作纸箱包裹。该过程无需额外材料。"
		""
		"当通入红石信号时，打包机会尝试尽可能地将包裹装满。一个纸箱包裹有 9 个物品栏槽位。在打包机上放置一张写有文字的告示牌，即可为制作出的纸箱包裹标注一个收件地址。"
	]
	quest.302D29E43E9C9A94.quest_subtitle: "打包机用于制作纸箱包裹。"
	quest.3087A48BAF370918.quest_subtitle: "装饰方块"
	quest.30A84C6A54BD336E.quest_desc: [
		"一台固定的机械钻头会破坏其正前方的方块，所需时间为（45 x 硬度）/RPM 秒，并且会对周围区域内的实体造成伤害。"
		""
		"A 由 &3机械装置&r驱动的机械钻头可以破坏方块，并会对与之碰撞的生物造成伤害，而无需直接提供旋转力。"
		""
		"机械钻头破坏一个方块所需的时间取决于机械装置的速度和方块的硬度值。对生物造成的伤害也取决于机械装置的速度。"
	]
	quest.30A84C6A54BD336E.quest_subtitle: "机械钻头是一种用于破坏方块的方块。"
	quest.30AE6897560E6C83.quest_desc: ["对称帆只会产生阻力，而非升力。当它们与气流成一定角度时，会减慢并转向一个机械装置，使其非常适合用于控制和稳定表面。它们还可以相互连接，轻松组成风车，并能染成任何颜色。"]
	quest.30AE6897560E6C83.quest_subtitle: "用于转向和稳定的阻力面"
	quest.30BFB48A05925FCC.quest_desc: ["将其连接到船只机械装置上，即可让它漂浮在水面上。"]
	quest.30BFB48A05925FCC.quest_subtitle: "浮筒能让船只漂浮在水面上。"
	quest.30CE22AC51635FE5.quest_desc: ["它的工作原理与标准的小轮胎完全相同——只是颜色不同。用小轮胎和黑色染料合成即可制作。"]
	quest.30CE22AC51635FE5.quest_subtitle: "染成黑色的小轮胎。"
	quest.30DD5E8D2F10797B.quest_subtitle: "装饰方块"
	quest.30F4C647F289C629.quest_desc: ["[ { \"text\": \"制作雷达\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"43D55282EF608566\" } } ]"]
	quest.31272DC7D6BB93F1.quest_desc: ["一种圆柱形、类似锅炉的方块，用于建造蒸汽机车的车身。提供全部十六种染料颜色，以匹配您的涂装。"]
	quest.31272DC7D6BB93F1.quest_subtitle: "装饰性锅炉方块"
	quest.3170383261F4ED60.quest_subtitle: "装饰方块"
	quest.318E6E97C7B24074.quest_subtitle: "装饰方块"
	quest.31BE1CBEE49C518D.quest_desc: [
		"洒水器是一种方块，当通过管道为其提供流体时，它会将流体分布在下方的一个小区域内。"
		"不同的流体可能会产生不同的效果。"
		""
		"-熔岩会对下方的实体造成少量火焰伤害"
		"-水会使下方区域变湿，让游戏世界误以为那里正在下雨。"
		"-药水会对下方的实体施加其效果，持续短暂时间"
		"-液体肥料，会对方块施加骨粉效果。"
	]
	quest.3218D5377A9D9373.quest_subtitle: "装饰方块"
	quest.322ED3D5037ACE11.quest_desc: ["它的工作原理与标准的“怪物轮胎”完全相同——只是颜色不同。将黄色染料与“怪物轮胎”一同合成即可制作。"]
	quest.322ED3D5037ACE11.quest_subtitle: "一个染成黄色的“怪物轮胎”。"
	quest.32387E8E41A570F3.quest_desc: ["一种用于装配了“链接与插销”车钩的火车车厢的木质端梁。用木板右键点击它即可更换木材，并用染料染成您喜欢的颜色。"]
	quest.32387E8E41A570F3.quest_subtitle: "带车钩的木质车头板"
	quest.32543D43C10B908A.quest_subtitle: "装饰方块"
	quest.326F7E4191A3B586.quest_desc: ["右键将其点击在“车轮支架”上，即可在地面上滚动。将其与染料一同合成，即可制作出 16 种彩色变体之一。"]
	quest.326F7E4191A3B586.quest_subtitle: "“怪物轮胎”，一个体型巨大、适用于全地形的车轮。"
	quest.32CE815B4AE226A7.quest_desc: ["选择一段铁轨，然后在附近放置耦合器。它可以在不解体的情况下连接或分离列车；使用扳手设置间隙，并在耦合、解耦或两者兼有的模式之间切换。"]
	quest.32CE815B4AE226A7.quest_subtitle: "在列车行驶过程中进行耦合与解耦。"
	quest.32D333DA3E31A217.quest_desc: ["更强的信号会使它转动的角度更大，每一步的大小都可以通过右键单击进行配置。来自两侧的信号会使其朝相反方向转动；同时为两侧供电则会使其保持在原位。"]
	quest.32D333DA3E31A217.quest_subtitle: "步进伺服电机会根据红石设定的固定步数进行转动。"
	quest.3308C9FB157052BF.quest_desc: ["它的功能与标准的“巨型轮胎”完全相同——只是颜色不同。将白色染料与“巨型轮胎”一同合成即可制作。"]
	quest.3308C9FB157052BF.quest_subtitle: "一个染成白色的“巨型轮胎”。"
	quest.330AEE6657D71B98.quest_desc: ["将任意下界合金物品放在两个破碎轮之间进行粉碎。"]
	quest.330AEE6657D71B98.title: "下界合金碎片"
	quest.337A6F12AA7787A7.quest_desc: ["它的行为与“悬浮石”完全相同。在结晶“悬浮石混合物”时，将白色染料拿在副手即可制作。"]
	quest.337A6F12AA7787A7.quest_subtitle: "“悬浮石”的一种白色染色变体。"
	quest.33CA43DD32CBFF1F.quest_desc: [
		"该整合包包含近400个模组，提供了丰富的“机械动力”附加内容，涵盖机械、自动化、物流和战斗等多个方面，同时还带有一个专注于“机械动力：航空”的任务系统，引导你从制作第一个装置逐步发展到建造完整的飞行器项目。"
		""
		"Beyond Create 整合包增添了新的维度、生物、动物和多样化的内容，在保持对主要主题专注的同时，丰富了整体体验。"
	]
	quest.33CA43DD32CBFF1F.quest_subtitle: "这是一个围绕 Create Aeronautics 及其主要附加模组构建的整合包，游戏世界采用浮空岛屿地形生成。"
	quest.33FD60BF45473C41.quest_desc: ["当足够多的 Levitite 附着在机械装置上时，就能使其保持悬浮，但它无法自行提升高度。在结晶 Levitite 混合物时，手持染料即可制作出彩色变体。"]
	quest.33FD60BF45473C41.quest_subtitle: "Levitite 能让模拟机械装置保持悬浮。"
	quest.340E8841095673AD.quest_desc: ["当使用红石提供动力并注入 Forge 能量 (FE) 时，它能提供定向推力。"]
	quest.340E8841095673AD.quest_subtitle: "离子推进器使用电力而非燃料驱动。"
	quest.343CBD6F1DF829A4.quest_subtitle: "装饰方块"
	quest.345621C5B198C54D.quest_desc: ["它会伪装成你为其应用的任意方块，并且与普通的装饰面不同，它能承受 Create 机械装置和物理船只的组装过程。此外还提供定向覆盖物变体。"]
	quest.345621C5B198C54D.quest_subtitle: "覆盖物是一种能够承受组装过程的装饰面。"
	quest.3495F5EFD3BB85A5.quest_subtitle: "装饰方块"
	quest.349AF0A9826EF920.quest_desc: ["由放射性钍提炼而成的精炼核燃料，装入反应堆棒中以驱动裂变反应。"]
	quest.349AF0A9826EF920.quest_subtitle: "反应堆堆芯的燃料"
	quest.350F81A0F8E205A8.quest_subtitle: "装饰方块"
	quest.3562111D841CF498.quest_desc: [
		"序列换挡器一次最多可接收 5 个命令。将光标悬停在命令上并在界面中滚动即可调整每个命令。"
		""
		"第一列包含“按角度转向”、“按活塞转向”、“定时延迟”、“等待新的红石脉冲”和“结束”等命令。前两个只是不同的旋转测量方式，第三个会让换挡器在继续执行下一个命令前进行等待，而第四个则会在换挡器收到下一次脉冲前停止序列。"
		""
		"第二列用于调整每个命令的测量值。"
		""
		"第三列用于调整速度和方向。"
	]
	quest.3562111D841CF498.quest_subtitle: "序列换挡器可以更精细地控制旋转动力，允许在一段时间内对旋转进行多次更改。"
	quest.35639D4A6DDF6FF9.quest_desc: ["当离合器未激活时，它会像轴一样传递旋转。当它被激活时，就会停止传递旋转。"]
	quest.35639D4A6DDF6FF9.quest_subtitle: "当施加红石信号时，会停止输出旋转。"
	quest.35895F3FBB5729CC.quest_subtitle: "装饰方块"
	quest.35BC6997EC5EFC02.quest_desc: ["准备好发电机线圈和碳刷后，你就可以开始建造电机和 energiser，让你的电力派上用场了。"]
	quest.35BC6997EC5EFC02.quest_subtitle: "你的第一台电力机器"
	quest.35C37231C1C86294.quest_desc: [
		"强力胶有两种使用方法：逐方块模式和区域模式。你可以在同一个装置中混合使用这两种方法。"
		""
		"每次使用胶水时，它会损失一点耐久度。你可以为其附魔“耐久”和“修补”，以延长其使用寿命。"
		""
		"在“逐块搭建”模式下，胶水的作用类似于史莱姆球。右键单击线性或径向底盘，即可将胶水涂在其一个面上，从而粘附其他方块。要从底盘上移除胶水，请潜行并空手右键单击。"
		""
		"在“区域”模式下，你可以将一组已经放置好的方块粘合在一起。首先右键单击该区域的一个角，然后移动到相对的角。此时会出现一个绿色方框，显示所选区域。再次右键单击即可粘合这些方块。如需取消，请潜行并右键单击。第二个角最远可在 24 个方块之外，总体积最多可达 2312 个方块。无论选区有多大，都只消耗一点耐久度。重叠的粘合区域会合并，同时保持其形状。在“区域”模式下，你无法选择底盘的某个面——否则会切换到“逐块搭建”模式。为避免这种情况，请单击底盘的侧面。"
	]
	quest.35C37231C1C86294.quest_subtitle: "强力胶可将&3机械装置&r中的结构固定在一起。"
	quest.35C37231C1C86294.title: "&a强力胶"
	quest.35DCDAD0D682D173.quest_desc: [
		""
		"[ { \"text\": \"制作护目镜\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"7B9EE1A765FB668A\" } } ]"
	]
	quest.35F24F6E403AADA1.quest_desc: ["一个在全部6个侧面都带有轴的齿轮箱。概念上它与平行齿轮箱使用相同的内部机制，因此顶部和底部的转速为一般速度的一半"]
	quest.3617DE87C4E1BCB9.quest_desc: ["手摇曲柄通过玩家互动产生少量&a旋转力&r。"]
	quest.362A97A645F66E98.quest_subtitle: "装饰方块"
	quest.364EC3CEAF5E7C0A.quest_desc: ["可在整个装置中传输电流的柔性电线。它们能实现在发电机、马达、能量器及其他能量设备之间的电力传输"]
	quest.364EC3CEAF5E7C0A.quest_subtitle: "合成组件"
	quest.365991A48CDEC367.quest_subtitle: "装饰方块"
	quest.36760F31374EB61E.quest_desc: ["从种子中压榨出的种子油——一种基础液体燃料，为烈焰燃烧器装上吸管后即可使用。"]
	quest.36760F31374EB61E.quest_subtitle: "一种简单的易燃液体"
	quest.36823A164BAC5DAB.quest_subtitle: "装饰方块"
	quest.369A7E3794430DC4.quest_desc: ["右键将其放置于车轮支架上，即可在地面上滚动。与染料一同合成可制成16种颜色变体之一。"]
	quest.369A7E3794430DC4.quest_subtitle: "小型轮胎，最紧凑的全地形车轮。"
	quest.36A0FF0E41D07FA5.quest_desc: ["可在整个装置中传输电流的柔性电线。它们能实现在发电机、马达、能量器及其他能量设备之间的电力传输"]
	quest.36A0FF0E41D07FA5.quest_subtitle: "合成组件"
	quest.36C12A39A071A6E2.quest_desc: ["生物雷达可高亮显示附近的敌对生物"]
	quest.36C254F62F5C0600.quest_desc: ["带有一条对角线“斜切”的装饰面板，可为列车、车厢和车站增添色彩与细节。提供全部十六种染料颜色。"]
	quest.36C254F62F5C0600.quest_subtitle: "装饰性列车面板"
	quest.36C7A185BBD7793F.quest_subtitle: "装饰方块"
	quest.36D68FE6D787432A.quest_subtitle: "装饰方块"
	quest.37470C1074D26F54.quest_subtitle: "装饰方块"
	quest.376B7DE621CAB6FB.quest_subtitle: "装饰方块"
	quest.37744FC6B3FEC91C.quest_subtitle: "装饰方块"
	quest.37C182DB7AFC5A18.quest_desc: ["其作用方式与标准大型轮胎完全相同——只是颜色不同。将大型轮胎与浅灰色染料一同制作即可。"]
	quest.37C182DB7AFC5A18.quest_subtitle: "染成浅灰色的大型轮胎。"
	quest.37F5736AE870A237.quest_desc: ["将其放置在火炮底座下方并连接到网络后，它会自动调整火炮的偏航（左右瞄准）以追踪选定目标。"]
	quest.37F5736AE870A237.quest_subtitle: "控制火炮底座的旋转"
	quest.380EAB5C20B79421.quest_subtitle: "装饰方块"
	quest.3843E8F66DE41E4A.quest_subtitle: "装饰方块"
	quest.384E1F8C7B6B590B.quest_desc: ["转轮手枪通过旋转枪管发射转轮手枪子弹，六发后需重新装填。它可接受加长枪管、供弹带和自动射击等升级。"]
	quest.384E1F8C7B6B590B.quest_subtitle: "一种可连射六发的副武器"
	quest.385C311DDF5493DD.quest_desc: ["其作用方式与标准小型轮胎完全相同——只是颜色不同。将小型轮胎与青色染料一同制作即可。"]
	quest.385C311DDF5493DD.quest_subtitle: "染成青色的小型轮胎。"
	quest.3885C5AF41E9AC61.quest_subtitle: "装饰方块"
	quest.3888CBB0389365F8.quest_desc: ["可在整个装置中传输电流的柔性电线。它们能实现在发电机、马达、通电装置及其他能量设备之间的电力传输。"]
	quest.3888CBB0389365F8.quest_subtitle: "合成组件"
	quest.388F1D60D40F63B7.quest_desc: ["加特林机枪以极快的速度从100发弹药中倾泻加特林子弹。该武器专为压制火力而设计，与鼓形弹匣和机械瞄具搭配效果极佳。"]
	quest.388F1D60D40F63B7.quest_subtitle: "高容量转管机枪"
	quest.38AD5F8E550EAE93.quest_subtitle: "装饰方块"
	quest.38CDA0888E1222A5.quest_subtitle: "装饰方块"
	quest.38E9C4DB82B1279A.quest_desc: [
		"当处于静止状态时，某些物品可以应用于方块的过滤器。如果方块有过滤器，则只会影响该机械装置实体。如果在组装前和组装期间用红石信号供能，则机械装置实体会以禁用状态启动。请注意，安装在&3机械装置&r上的红石和拉杆均无效果。"
		""
		"当安装在已组装的机械装置上时，可以右键点击机械装置控制杆来启用或禁用特定的机械装置实体。"
	]
	quest.38E9C4DB82B1279A.quest_subtitle: "机械装置控制杆用于控制机械装置实体。"
	quest.38EC378844976A93.quest_desc: ["为你的HUD增添关于已放置组件的额外信息——应力、螺旋桨推力和气流、升力气体数据等。在调试飞行机器时，这是必读资料。"]
	quest.38EC378844976A93.quest_subtitle: "工程师的飞机护目镜"
	quest.39124F73B82400F4.quest_desc: ["将来自“机械动力”模组的机器产生的旋转能量转化为FE，效率约为75%，从而实现能量回馈。"]
	quest.39124F73B82400F4.quest_subtitle: "将旋转转化为FE"
	quest.3942693AC85D4BA5.quest_subtitle: "装饰方块"
	quest.397463A72646B6E1.quest_subtitle: "装饰方块"
	quest.398299220A1A3895.quest_subtitle: "装饰方块"
	quest.398BA75CFB6FB80E.quest_subtitle: "装饰方块"
	quest.39B1210D4B069FD6.quest_subtitle: "装饰方块"
	quest.39C4C92457767F18.quest_subtitle: "装饰方块"
	quest.39E3C2D99DD35934.quest_desc: ["一种用于机械装置的轻型帆块，可以复制其接触的任何材质的外观。它还有更宽的尺寸，可用于塑造大型机翼和翼型。"]
	quest.39E3C2D99DD35934.quest_subtitle: "轻量级仿制帆块"
	quest.3A2633B6030BBC52.quest_desc: ["工程师护目镜在佩戴时，会显示所观察机器在运行时的应力影响。当查看应力计或速度计时，它们还会显示数值并高亮当前的旋转状态。此外，它们还能显示储罐内的流体量以及储罐的总存储容量。"]
	quest.3A2633B6030BBC52.quest_subtitle: "工程师护目镜是一种可穿戴物品，能让用户看到已放置机器的更多细节。"
	quest.3A526F4EAF77091F.quest_desc: ["一种自动装弹机，可将弹药推入火炮的后膛。它需要旋转动力才能运作，并能确保稳定的重新装填。"]
	quest.3A5BF29CC2D01DCF.quest_subtitle: "装饰方块"
	quest.3A60017A8CE7DCC4.quest_subtitle: "装饰方块"
	quest.3AE1748998242726.quest_desc: [
		""
		"[ { \"text\": \"打造花哨玩意儿\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"61F76D3FF8262A54\" } } ]"
	]
	quest.3B13D36A4F35C461.quest_subtitle: "装饰方块"
	quest.3B4F880DC32D4830.quest_desc: ["水下性能出色，但在水外则毫无用处——是建造潜艇的首选螺旋桨。"]
	quest.3B4F880DC32D4830.quest_subtitle: "潜艇螺旋桨是一种专为水下推进而设计的推进器。"
	quest.3B5D4F93B2DFF4CC.quest_desc: ["它的功能与标准“怪物轮胎”完全相同——只是颜色不同。将“怪物轮胎”与紫色染料一同制作即可。"]
	quest.3B5D4F93B2DFF4CC.quest_subtitle: "一个染成紫色的“怪物轮胎”。"
	quest.3B730A7FADE609EB.quest_desc: ["一种用于封堵轨道末端的缓冲块，用以标记线路的终点。可通过右键点击染料进行染色。"]
	quest.3B730A7FADE609EB.quest_subtitle: "线路终点止动块"
	quest.3B73F2EBCCD1884C.quest_desc: ["自动为使用水的装置和护甲补充物资。"]
	quest.3BEDE46A6B0D3C28.quest_desc: ["它的功能与标准“轮胎”完全相同——只是颜色不同。将“轮胎”与紫色染料一同制作即可。"]
	quest.3BEDE46A6B0D3C28.quest_subtitle: "一个染成紫色的“轮胎”。"
	quest.3C2A896C6CD20F37.quest_subtitle: "装饰方块"
	quest.3C50C3A24410BC3C.quest_subtitle: "装饰方块"
	quest.3C6E18AC535941AB.quest_desc: [
		"使用“工厂量规”点击“库存链接”，即可将其与该网络关联。单个方块最多可放置 4 个“工厂量规”。"
		""
		"可通过将物品放入“工厂量规”的过滤槽，或在用户界面中设置物品，来设定其监控某个物品。设置物品后，主用户界面即可使用。"
		""
		"可在用户界面中设置请求包裹的送达地址。这可将包裹分拣至正确位置。还可设置“承诺”的过期时间。"
		""
		"用户界面会显示在“数值设置”屏幕中设定的存储量以及当前未兑现的承诺数量。数值设置屏幕：长按右键可打开“数值设置”屏幕，并调整希望在存储中保留的物品数量。此数值可设为任意数量（*），最高可达 100 件或堆叠。"
	]
	quest.3C6E18AC535941AB.quest_subtitle: "工厂仪表用于通过物流网络发送请求，以便在已连接的存储中维持特定数量的物品。"
	quest.3C7E5C34E73D540A.quest_subtitle: "装饰方块"
	quest.3C8DB1D9EFD2D61C.quest_subtitle: "装饰方块"
	quest.3C9CA12BBFE38D67.quest_subtitle: "装饰方块"
	quest.3CA5DFF1105281D6.quest_desc: ["用于 FE 的多方块能量存储装置——用于缓冲或储存电力以备后用，或平滑电力波动。"]
	quest.3CA5DFF1105281D6.quest_subtitle: "多方块 FE 电池"
	quest.3CA678F45B241AA6.quest_desc: ["已加工成放射性形态的钍——这是制造核燃料的一步。请小心处理。"]
	quest.3CA678F45B241AA6.quest_subtitle: "浓缩的放射性钍"
	quest.3CBCC5392095BA97.quest_subtitle: "装饰方块"
	quest.3CF4E2C7995F6550.quest_desc: ["[ { \"text\": \"创建连接\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"0221FE72F998600E\" } } ]"]
	quest.3D410A0C549DF290.quest_desc: ["一种用于铸造火炮零件的特殊可塑形砂。当在铸造台周围围绕模板填充时，它会形成浇筑熔融金属所需的空心形状。"]
	quest.3DABBC295F8A8491.quest_desc: ["带有对角“斜切”的装饰面板，可用于为火车、车厢和车站增添色彩与细节。提供全部十六种染料颜色。"]
	quest.3DABBC295F8A8491.quest_subtitle: "装饰性火车护板"
	quest.3DD31828D9BB77F2.quest_desc: ["将任意钻石物品放在两个压碎轮之间进行压碎"]
	quest.3E26F6522B3D3E58.quest_desc: ["其作用方式与标准巨型轮胎完全相同——只是颜色不同。将绿色染料与巨型轮胎合成即可制作。"]
	quest.3E26F6522B3D3E58.quest_subtitle: "染成绿色的巨型轮胎。"
	quest.3E2F2B5AC8E36B91.quest_subtitle: "装饰方块"
	quest.3E68A212BCC5641E.quest_desc: ["其作用方式与标准大型轮胎完全相同——只是颜色不同。将绿色染料与大型轮胎合成即可制作。"]
	quest.3E68A212BCC5641E.quest_subtitle: "染成绿色的大型轮胎。"
	quest.3EB0E7153013F10C.quest_desc: ["使用部署器将卡丁车发动机安装到底盘上。"]
	quest.3EC84EB6EA2E0FDC.quest_desc: ["右键将轮胎安装到轮座上即可完成装配。轮胎有小号、标准、大型和巨型四种尺寸，适用于任何地形。"]
	quest.3EC84EB6EA2E0FDC.quest_subtitle: "轮胎能让你的装置在地面上行驶。"
	quest.3ECC524616BA2DCD.quest_desc: ["一种圆柱形、锅炉状的方块，用于建造蒸汽机车的车身。提供全部十六种染料颜色，可匹配你的涂装。"]
	quest.3ECC524616BA2DCD.quest_subtitle: "装饰性锅炉方块"
	quest.3EDE6A8D45B59544.quest_desc: ["为速射自动炮打造的独立式弹药筒。结构紧凑、装填迅速，持续射击时杀伤力惊人——非常适合压制敌人的推进。"]
	quest.3EE264726A5354CC.quest_desc: ["让你可以在生存模式下保存、打印和删除实体造物——这是工具枪蓝图工作流程的核心。"]
	quest.3EE264726A5354CC.quest_subtitle: "生存结构工具枪是专为生存模式设计的工具枪。"
	quest.3EE5BE3E543ABBD6.quest_subtitle: "装饰方块"
	quest.3EF7DE98852E959C.quest_subtitle: "装饰方块"
	quest.3F07EDD7B6338C36.quest_subtitle: "装饰方块"
	quest.3FABA7C4ABBD3813.quest_desc: ["一种专为自动火炮设计的速射后膛装填机制。通电后，可快速连续地供弹和射击。"]
	quest.40295A58589A7250.quest_desc: ["创建：《爱与战争》旨在将《Create》的建造与基建玩法，与 Flan 模组的火力相结合，打造一款注重生存与建造进阶的“复古酷炫”枪械模组。"]
	quest.4057912E322E9DBD.quest_subtitle: "装饰方块"
	quest.4058BCBC7493D7BB.quest_desc: ["强力胶的便捷替代品：点击两个点即可创建一个粘合盒，然后按住 Ctrl 并滚动滚轮来调整其大小。与强力胶不同，它不会在复杂的建筑上形成不必要的连接。"]
	quest.4058BCBC7493D7BB.quest_subtitle: "用于机械装置的定向粘合剂"
	quest.40E750430BD7FD79.quest_desc: ["[ { \"text\": \"创建新家具\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"0DEEA086C9B29217\" } } ]"]
	quest.40EFF12F6BD08A28.quest_desc: ["它的行为方式与悬浮石完全相同。在结晶悬浮石混合物时，将品红染料持于副手即可制作。"]
	quest.40EFF12F6BD08A28.quest_subtitle: "悬浮石的一种品红色染色变体。"
	quest.40F8FF1E85694FD4.quest_desc: ["将铜板放入轧机中即可获得。"]
	quest.40F8FF1E85694FD4.quest_subtitle: "合成组件。"
	quest.40FB7ECF967AE45A.quest_desc: ["不通电时，其行为方式与封闭式齿轮相同。为其提供一个模拟红石信号，即可根据轴的情况减缓齿轮转速，从而通过红石精细调节旋转速度。"]
	quest.40FB7ECF967AE45A.quest_subtitle: "红石控制齿轮箱"
	quest.4154C3D38114568D.quest_subtitle: "装饰方块"
	quest.4181323BF72047A9.quest_desc: [
		"右键点击一个有时刻表的合格列车员，将时刻表交给他们。列车员必须是直接坐在已组装列车车头控制装置前的生物，或是以类似方式放置的烈焰人燃烧器。"
		""
		"可以添加 3 种类型的命令。"
		""
		"&n前往车站&r - 导航至指定的列车车站。"
		"&n更新时刻表标题&r - 路线名称，显示在显示链接中列车车站的摘要里。"
		"&n限制最高速度 &r- 更改前往车站时的最高速度。"
	]
	quest.4181323BF72047A9.quest_subtitle: "列车时刻表用于向非玩家列车员下达指令。"
	quest.41E21358995A0078.quest_desc: ["再生外壳会随着时间的推移缓慢治愈狼。"]
	quest.41E9AE1746036791.quest_subtitle: "装饰方块"
	quest.41E9FC34375A4762.quest_subtitle: "装饰方块"
	quest.421EA2CE61003DA1.quest_desc: ["允许玩家飞得更快、移动和游泳得更快。与燃料配合使用。"]
	quest.4266BF7FCE3B4330.quest_desc: [
		"齿轮是《Create》模组中用于传递旋转的基础机械部件。"
		""
		"大齿轮是齿轮的放大版本，能够传递拐弯处的旋转并为旋转速度控制器供能。"
		""
		"齿轮有三种主要的啮合方式："
		""
		"- 当两个齿轮并排（非对角）放置且朝向相同时，它们就会啮合。当其中一个齿轮受到旋转力时，该力会以相同速度但相反方向传递给另一个齿轮。"
		""
		"-两个大齿轮在相互垂直放置时会啮合，从而改变其轴线和方向，但不会改变其速度。"
		""
		"-一个齿轮和一个大齿轮在对角线方向放置且朝向相同时会啮合。大齿轮的转速将是齿轮的一半。"
	]
	quest.4266BF7FCE3B4330.title: "齿轮"
	quest.4272553A76B98C8A.quest_subtitle: "装饰方块"
	quest.4279B2C4BD52ED14.quest_subtitle: "装饰方块"
	quest.427CB698EA6AB226.quest_desc: ["其作用与普通轮胎完全相同——只是颜色不同。将轮胎与灰色染料一同合成即可制得。"]
	quest.427CB698EA6AB226.quest_subtitle: "一个染成灰色的轮胎。"
	quest.428643ABDE915454.quest_desc: ["自动射击装置可让左轮手枪在按住时持续射击，以牺牲精准瞄准为代价换取纯粹的射速。"]
	quest.428643ABDE915454.quest_subtitle: "左轮手枪射速升级"
	quest.4294F26E8D2BA9CB.quest_desc: ["反应堆外壳的一种透明变体，可用于在保持反应堆密封的同时为其建造窗户。"]
	quest.4294F26E8D2BA9CB.quest_subtitle: "透明反应堆墙壁"
	quest.42A7F6375FDC57BD.quest_desc: ["其特性与悬浮石完全相同。在结晶悬浮石混合物时，手持黑色染料即可制得。"]
	quest.42A7F6375FDC57BD.quest_subtitle: "悬浮石的一种黑色染色变体。"
	quest.43079D90150A1845.quest_desc: ["其作用与普通轮胎完全相同——只是颜色不同。将轮胎与品红色染料一同合成即可制得。"]
	quest.43079D90150A1845.quest_subtitle: "一个染成品红色的轮胎。"
	quest.431EC43C4F988CF1.quest_desc: ["碳刷可保持与旋转部件的电气接触。是电机和发电机线圈的关键原料。"]
	quest.431EC43C4F988CF1.quest_subtitle: "用于电机和线圈的接触刷"
	quest.434A32B75ADC9EDA.quest_subtitle: "装饰方块"
	quest.4383C171599FFDEC.quest_desc: [
		""
		"[ { \"text\": \"创建传送门\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"7DBD8E66451BD4DA\" } } ]"
	]
	quest.43902B53F47A8770.quest_subtitle: "制作组件。"
	quest.439DF3FDD2E418EA.quest_subtitle: "装饰方块"
	quest.43A313839B7A6D00.quest_desc: ["它的功能与标准的大轮胎完全相同——只是颜色不同。将大轮胎与蓝色染料一同制作即可。"]
	quest.43A313839B7A6D00.quest_subtitle: "一个染成蓝色的大轮胎。"
	quest.43CBA06DCCAC3A8A.quest_desc: ["它的功能与标准的小轮胎完全相同——只是颜色不同。将小轮胎与品红色染料一同制作即可。"]
	quest.43CBA06DCCAC3A8A.quest_subtitle: "一个染成品红色的小轮胎。"
	quest.43D5364C7603F129.quest_desc: [
		"切片机是一种类似于机械搅拌机或机械压力的机器。它会自动识别《农夫乐事》中的所有切割配方。从这个意义上说，它是一个自动切菜板。"
		""
		"要使用它，必须通过右键点击将正确的工具放入机器中。默认情况下，只允许使用刀具和斧头。"
	]
	quest.43D55282EF608566.quest_desc: ["Create：雷达增加了一个完整的探测与武器控制系统。建造旋转的雷达天线来扫描区域，通过数据链路将它们连接到显示器，并让自动瞄准控制器将你的火炮对准雷达所探测到的任何目标。"]
	quest.43D55282EF608566.quest_subtitle: "使用雷达进行探测、追踪和锁定目标"
	quest.43E4EE94BB396A7C.quest_desc: ["用于塑造杆状物和线材的制作机器，是构建电气元件所必需的。"]
	quest.43E4EE94BB396A7C.quest_subtitle: "将锭轧制成杆状物和线材"
	quest.43FAF8E191552C9E.quest_desc: ["它的功能与标准小轮胎完全相同——只是颜色不同。将小轮胎与石灰染料合成即可制作。"]
	quest.43FAF8E191552C9E.quest_subtitle: "一个染成石灰色的小轮胎。"
	quest.44194CEF6E737561.quest_desc: ["对实体单位效果更强的自动炮弹药。"]
	quest.4446C9E3387287A9.quest_desc: ["它的功能与标准轮胎完全相同——只是颜色不同。将轮胎与石灰染料合成即可制作。"]
	quest.4446C9E3387287A9.quest_subtitle: "一个染成石灰色的轮胎。"
	quest.445EA2148F9B31E6.quest_desc: ["发射器发射的火箭会在撞击时爆炸——这种重型武器能摧毁成群敌人或防御工事。"]
	quest.445EA2148F9B31E6.quest_subtitle: "肩扛式火箭发射器"
	quest.445EC4706FBE3A4A.quest_desc: ["它能将输入的红石信号强度转换为可配置的红石输出信号。"]
	quest.445EC4706FBE3A4A.quest_subtitle: "红石转换器会重新映射信号强度。"
	quest.4474950744B2A197.quest_desc: ["Create Aeronautics：工具枪是一款扩展模组，旨在将类似 VMod 的工程工作流程引入 Create Aeronautics 载具环境，并专门针对 Aeronautics 的物理结构进行了适配与扩展。"]
	quest.4474950744B2A197.quest_subtitle: "一款 Create Aeronautics 工具扩展模组，增加了工具枪式的蓝图系统以及用于保存、打印、删除和操作物理构件的磁场枪。"
	quest.4474950744B2A197.title: "Create Aeronautics：工具枪"
	quest.449AB1FA8A928BF2.quest_desc: [
		""
		"[ { \"text\": \"Create 机械伙伴\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"7655E21D5CFB174C\" } } ]"
	]
	quest.449B33FFDD357065.quest_desc: ["它的行为方式与 Levitite 完全相同。在结晶 Levitite 混合物时，将黄色染料拿在副手即可制作。"]
	quest.449B33FFDD357065.quest_subtitle: "Levitite 的一种黄色染料变体。"
	quest.44AF361FFD44C532.quest_desc: ["霰弹枪弹药的全套组合：标准弹丸、能点燃目标的燃烧弹，以及更强韧的钢制版本——能发射穿甲飞镖的穿甲弹。"]
	quest.44AF361FFD44C532.quest_subtitle: "霰弹枪弹药"
	quest.44D127D6C4FA6368.quest_desc: ["它会显示船体承受的压力，并将其与最弱方块所能承受的最大压力进行比较。连接一个显示链接，即可将深度和船体完整性广播到显示板上——再用命名牌为深海中的鱼命名，送给你的朋友。"]
	quest.44D127D6C4FA6368.quest_subtitle: "压力计可读取您潜艇的深度和船体安全状况。"
	quest.4505622C1471A71F.quest_subtitle: "装饰方块"
	quest.4512B97451C2221F.quest_desc: ["机械臂可以从其放置位置 5 个方块半径范围内的各种方块中取出或存入物品。将扳手悬停在已放置的机械臂上，即可查看其选中的方块。机械臂一次最多可传输一组物品。"]
	quest.4512B97451C2221F.quest_subtitle: "机械臂是一种用于传输物品的方块。"
	quest.45389293F537AB71.quest_subtitle: "装饰方块"
	quest.4546E59E305FA58C.quest_subtitle: "装饰方块"
	quest.4567FAE026077E3E.quest_desc: ["物品传送器可以将一组物品传送至物品传送器接收器。它使用传送汁作为燃料。要将其与物品传送器接收器连接，请使用 TP 链接。"]
	quest.45770072CFE9C70F.quest_desc: ["专为直射火炮设计的重型强力炮弹。从用于摧毁防御工事的实心弹，到可造成毁灭性范围伤害的爆炸弹，种类繁多。"]
	quest.457D2B870376D2FE.quest_subtitle: "装饰方块"
	quest.4581823B7CB90873.quest_subtitle: "装饰方块"
	quest.459E24BD2F3DB8C7.quest_subtitle: "装饰方块"
	quest.45BA5B8A785E1B82.quest_desc: [
		"使用扳手对一个组件操作，会使其围绕你交互的面旋转。"
		""
		"使用扳手对一个组件、红石组件、铁轨或原版铁轨变体操作，会将其拆解并放入你的物品栏。任何可以通过右键点击进行旋转或其他交互的方块，都必须在潜行状态下拆解。"
		""
		"将光标悬停在某些可配置的组件上时，可以通过滚动来配置。"
		""
		"对于线性底盘等某些组件，可以按住 Ctrl 键一次性配置所有已连接的组件。"
	]
	quest.45BA5B8A785E1B82.quest_subtitle: "扳手是一种用于旋转、拆解和配置组件的工具。"
	quest.45D1E4AD19D56356.quest_subtitle: "装饰方块"
	quest.45D5802C64FBAC40.quest_subtitle: "装饰方块"
	quest.45EF93C539B4689C.quest_desc: ["它的工作原理与标准轮胎完全相同——只是颜色不同。将轮胎与黄色染料一起合成即可制作。"]
	quest.45EF93C539B4689C.quest_subtitle: "一个染成黄色的轮胎。"
	quest.45FADC0FF7BF9A58.quest_desc: ["A 用于建造蒸汽机车车身的圆柱形锅炉状方块。提供全部十六种染料颜色，可与您的涂装相匹配。"]
	quest.45FADC0FF7BF9A58.quest_subtitle: "装饰性锅炉方块"
	quest.46004D01A142777E.quest_subtitle: "智能流体管道可用于只允许特定液体通过。"
	quest.461E3EE93322116C.quest_desc: ["其工作原理与标准巨型轮胎完全相同——只是颜色不同。将巨型轮胎与青色染料一同制作即可。"]
	quest.461E3EE93322116C.quest_subtitle: "一个染成青色的巨型轮胎。"
	quest.4623694A2DBB1542.quest_subtitle: "装饰方块"
	quest.4692806B2567E677.quest_subtitle: "装饰方块"
	quest.46BBBC2AE23D9E77.quest_subtitle: "装饰方块"
	quest.46C99C4ABD414586.quest_subtitle: "装饰方块"
	quest.46D3B104FDA42E44.quest_subtitle: "装饰方块"
	quest.46F87864666E33F0.quest_subtitle: "装饰方块"
	quest.474804E4154F2C34.quest_desc: ["使用发电机为其提供 FE，然后施加红石信号以启动。用电离热力学装置右键点击，可将其升级为灵魂之火以获得更强推力，但功耗翻倍。"]
	quest.474804E4154F2C34.quest_subtitle: "校准推进器利用电能推动您的载具。"
	quest.47745C8FF94FF640.quest_subtitle: "装饰方块"
	quest.47A8E06BD832A6AF.quest_desc: ["带有对角“斜切”的装饰面板，可用于为列车、车厢和车站增添色彩与细节。提供全部十六种染料颜色。"]
	quest.47A8E06BD832A6AF.quest_subtitle: "装饰性列车面板"
	quest.47B1FE98C581834D.quest_desc: ["将其右键点击在车轮支架上，即可在地面上滚动。与染料一同制作，可得到 16 种彩色变体之一。"]
	quest.47B1FE98C581834D.quest_subtitle: "轮胎，一种标准的越野车轮。"
	quest.482B7634F42B4D71.quest_subtitle: "装饰方块"
	quest.48604F54874176D0.quest_subtitle: "装饰方块"
	quest.4861419A7B1821DE.quest_subtitle: "装饰方块"
	quest.488574695C845D32.quest_desc: ["它会消耗有效的液体燃料来产生热量，并在运行时允许流体通过。它还支持红石恒温器控制。"]
	quest.488574695C845D32.quest_subtitle: "液体燃烧器利用液体燃料产生热量。"
	quest.489B3BC42C93DE24.quest_subtitle: "装饰方块"
	quest.48D6A12A1FBD6D16.quest_desc: ["铸造盆盖用于熔化金属以铸造大炮。"]
	quest.48F9C017C806DF66.quest_desc: ["一种圆柱形、类似锅炉的方块，用于建造蒸汽机车的车身。提供全部十六种染料颜色，以匹配您的涂装。"]
	quest.48F9C017C806DF66.quest_subtitle: "装饰性锅炉方块"
	quest.4905CD63121F13EA.quest_desc: ["自动为使用燃料的工具和盔甲补充燃料。"]
	quest.4941F57A0BC50DE6.quest_desc: ["将火车座椅留在您开始旅行的位置 5000 个方块以外的地方。"]
	quest.495C3C490E5F0C1F.quest_desc: ["旋转时可驱动潜艇在水中航行。在水下表现出色，但在开阔空气中则毫无用处。"]
	quest.495C3C490E5F0C1F.quest_subtitle: "水下推进器"
	quest.49603BFCDB242BC2.title: "贴花"
	quest.497B68AABAA5281A.quest_subtitle: "装饰方块"
	quest.497E077E0D3B64A4.quest_desc: ["[ { \"text\": \"创建航空学\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6142979F2E5E54E5\" } } ]"]
	quest.49D9442F89A06EA6.quest_desc: ["一块带有对角“斜切”的装饰面板，可用于为火车、车厢和车站增添色彩与细节。提供全部十六种染料颜色。"]
	quest.49D9442F89A06EA6.quest_subtitle: "装饰性火车面板"
	quest.4A22534045841AE4.quest_desc: ["缠绕着节日彩灯的铜制线轴。其作用与铜制线轴类似，可用于低电流布线，但喜庆得多。"]
	quest.4A22534045841AE4.quest_subtitle: "节日低电流线轴"
	quest.4A47E558AD90EB64.quest_desc: ["提供一个可同时访问两个库存的界面。此外还带有筛选槽，可快速对传入的物品进行分类。"]
	quest.4A7F96E62A5845C5.quest_desc: [
		"机械活塞是一种会与不可移动方块发生碰撞的机械装置。"
		""
		"要实现延伸，活塞末端必须装有活塞延伸杆，并且需要旋转动力。延伸杆的最大长度为 64 个方块，此数值可在配置中更改。"
		""
		"当旋转方向反转时，活塞会缩回。活塞末端必须用史莱姆球处理成粘性状态，才能将推动的方块一同带回。"
	]
	quest.4A7F96E62A5845C5.quest_subtitle: "机械活塞是一种在获得旋转动力后，可以推动 &3机械装置&r 的活塞。"
	quest.4AA6E52423B4A264.quest_desc: ["红石磁铁可以吸引或排斥其他磁铁——异极相吸，同极相斥。切换它们即可将机械装置固定在一起或将其弹开。"]
	quest.4AA6E52423B4A264.quest_subtitle: "可用红石切换的磁铁"
	quest.4AEAEBF9EC825F7B.quest_desc: ["在直接模式下，输入信号会直接映射到输出比例；在增量模式下，每次脉冲都会逐步改变比例。"]
	quest.4AEAEBF9EC825F7B.quest_subtitle: "红石传动齿轮可通过红石传递旋转。"
	quest.4B004B3ADE6EC396.quest_desc: ["标准大型火炮推进剂"]
	quest.4B151EB06E665C09.quest_subtitle: "装饰方块"
	quest.4B25616E0908ABB5.quest_subtitle: "装饰方块"
	quest.4B4E27C7DF1C753A.quest_subtitle: "装饰方块"
	quest.4B7AF631F982F9A5.quest_desc: ["电解槽由 FE 提供动力并注入水，可生产氧气扩散器所需之氧气，以维持船员在水下呼吸。"]
	quest.4B7AF631F982F9A5.quest_subtitle: "将水转化为氧气"
	quest.4B900A64C051C07F.quest_subtitle: "装饰方块"
	quest.4B976C143EDA4317.quest_desc: [
		"外壳是《Create》中多种合成配方的组成部分，也可用于装饰和美化。"
		""
		"外壳共有四种类型：安山岩外壳主要用于基础的 &3装置&r。"
		""
		"外壳只能通过将有效的合金或锭材物理应用于任意去皮原木或木材变体来合成。原木会自行转化为外壳。"
		""
		"机械传送带、转轴和齿轮可以包裹在大多数外壳中，从而为被包裹的方块增添装饰。不过，铜制外壳只能用于流体管道。同样，流体管道也无法安装其他类型的外壳。"
	]
	quest.4B976C143EDA4317.title: "&l&6安山岩外壳"
	quest.4BB13C80196FD034.quest_desc: [
		"&l&6Create&r&r 是一款功能极其丰富且视觉效果引人入胜的《我的世界》模组，它为游戏增添了种类繁多的机械组件和自动化工具。与传统科技模组不同，&6&lCreate&r&r 专注于动能驱动，允许玩家使用齿轮、轴、传送带和旋转装置来建造复杂的机器。从自动农场和物品分类器，到可移动的 &3&l机械装置&r&r和火车，该模组通过运动与工程原理激发了玩家的创造力。"
		""
		"Create 的一大特色是名为 &n&oPonder&r&r 的内置教程系统。当玩家手持 &nW&r 键并将鼠标悬停在物品栏中的模组物品上时，即可查看动画演示，了解该物品的工作原理。Ponder 让学习该模组的过程变得直观又富有沉浸感，将理解复杂机械原理的过程变成一种与游戏玩法无缝衔接的愉悦体验。"
	]
	quest.4BB13C80196FD034.quest_subtitle: "Create"
	quest.4BB13C80196FD034.title: "&l&6Create"
	quest.4BC778CA91E06E6C.quest_desc: ["可合成的磁性物品，具有递增的容量和范围。用于发电机线圈和充能器的合成，以提升电力性能。"]
	quest.4BC778CA91E06E6C.quest_subtitle: "磁性矿石块"
	quest.4BE8715B5216E26F.quest_subtitle: "合成组件。"
	quest.4C7CD3858A2BE870.quest_desc: [
		"机械压力机是一种机械部件，可对位于其下方的物品施加压制、填充和压缩配方。它用于将锭压制成板，而板是更高级别部件的重要原料。"
		""
		"机械压力机由一根内置的轴提供动力，可从相对两侧访问。与轴类似，压力机也会沿其轴传递旋转。当它接收更快的&a旋转动力&r时，处理物品的速度也会加快。"
	]
	quest.4C8DDA689FE8369D.quest_desc: ["一桶悬浮液混合物，这种液体会结晶成悬浮石。将其倒出并加热以启动反应，反应随后会蔓延至整个液池。"]
	quest.4C8DDA689FE8369D.quest_subtitle: "会变成反重力晶体的液体"
	quest.4C900E5C7D80C67F.quest_desc: ["从下方用燃烧器对其进行加热，它就会产生旋转力。移除热量后，它会逐渐停止。"]
	quest.4C900E5C7D80C67F.quest_subtitle: "斯特林发动机可将热能转化为旋转。"
	quest.4CAC3786D1E665E1.quest_subtitle: "装饰方块"
	quest.4CD565A8B60FF798.quest_desc: ["它的功能与标准的大型轮胎完全相同——只是颜色不同。将大型轮胎与品红染料一同制作即可得到它。"]
	quest.4CD565A8B60FF798.quest_subtitle: "一个染成品红色的大型轮胎。"
	quest.4CD822763FCBF7EF.quest_desc: ["根据其速度输出红石信号，信号朝远离运动方向的一侧发出。在它的值框中设置速度以获得最强信号。"]
	quest.4CD822763FCBF7EF.quest_subtitle: "读取你的移动速度"
	quest.4D927A321278CF28.quest_desc: ["放置在含有矿脉的区块中时，可提取无限地下矿石的机器。必须配备机械钻头，并以至少 30 RPM 的旋转动力驱动（速度越快，生产速率越高）。提取的原矿通过漏斗输出，当内部存储达到 16 个单位时，机器会自动停止。"]
	quest.4D998F75DA4690FA.quest_subtitle: "装饰方块"
	quest.4E5BFAA7E55C6A83.quest_subtitle: "装饰方块"
	quest.4E5C6F23628A9982.quest_desc: ["外壳链传动装置可以垂直或水平并排放置，形成一条在所有方块之间传递旋转动力的链条。这些方块必须侧面相接（而非轴向与侧面相接），且处于同一条直线上才能形成链条。外壳链传动装置的轴向可以全部平行，也可以旋转方块以使轴向相互垂直。外壳链传动装置也能通过其旋转轴传递&a旋转动力&r，但这不属于同一链条的延续。"]
	quest.4E5C6F23628A9982.quest_subtitle: "外壳链传动装置是一种可以像机械皮带一样传递旋转的方块。"
	quest.4E8EE0AB4FC2C8D6.quest_subtitle: "装饰方块"
	quest.4EBBEFC2579A8440.quest_subtitle: "装饰方块"
	quest.4EC20D5D0EEC1DF7.quest_desc: ["[ { \"text\": \"手摇曲柄\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"3617DE87C4E1BCB9\" } } ]"]
	quest.4EC499B88FBFA01C.quest_desc: ["储存动能应力以供后续使用。以物品形式保留电荷，从而实现远距离能量传输。电池容量、放电时的转速以及应力冲击值均可配置。"]
	quest.4ECDD706A12D0B55.quest_desc: ["其工作原理与标准的大型轮胎完全相同——只是颜色有所变化。将大型轮胎与黑色染料一同制作即可。"]
	quest.4ECDD706A12D0B55.quest_subtitle: "一个染成黑色的大型轮胎。"
	quest.4F19053A36114341.quest_desc: ["它会根据红石模拟信号来调整其旋转输出——某一侧的信号越强，它就会向该侧倾斜得越多。"]
	quest.4F19053A36114341.quest_subtitle: "倾斜适配器可利用红石来调节旋转角度。"
	quest.4F1FA866A2F510A1.quest_desc: ["将一块电金锭放入轧机中即可获得。"]
	quest.4F1FA866A2F510A1.quest_subtitle: "合成组件。"
	quest.4F2F6E31C38DA17F.quest_desc: ["自动为使用水的工具和盔甲补充水。"]
	quest.4F38ABDB12AD7680.quest_desc: [
		"手持伸缩握柄时，玩家的攻击距离会增加 4 个方块，且击退效果也会增强。将其放在副手时，这些加成依然有效。"
		""
		"当使用伸缩握柄破坏方块、放置方块或攻击生物时，无论其位于主手还是副手，都会损耗耐久度；除非与已填充的铜制背罐或下界合金背罐配合使用，此时将消耗背罐中的空气。"
		""
		"与强力胶和砂纸类似，它也可以使用“经验修补”和“耐久”附魔书进行附魔。"
	]
	quest.4F3D30ADFE877038.quest_desc: ["[ { \"text\": \"创建\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4BB13C80196FD034\" } } ]"]
	quest.4F99F8D62C2E9D33.quest_subtitle: "装饰方块"
	quest.4FCCEB8B6A6AA643.quest_desc: ["储存少量能量——这是电动机、交流发电机及其他动力机器的核心原料。"]
	quest.4FCCEB8B6A6AA643.quest_subtitle: "合成组件。"
	quest.4FDF302D1E8EFA59.quest_desc: ["Create New Age 是 Create 模组的一个附加模组，它通过与电力系统的整合来扩展游戏内容。为此，它添加了许多与现实中的对应物相似的多方块结构。此外，Create: New Age 并不仅限于电力，还为 Create 加入了核能。"]
	quest.4FDF302D1E8EFA59.quest_subtitle: "为 Create 模组添加电力与核能"
	quest.4FEFB2F08A61A1D6.quest_desc: ["它的工作原理与标准的小轮胎完全相同——只是颜色不同。将小轮胎与棕色染料一同合成即可制作。"]
	quest.4FEFB2F08A61A1D6.quest_subtitle: "一个染成棕色的小轮胎。"
	quest.500FA9792456C013.quest_desc: ["物理组装机可将一组粘合在一起的方块变成一个模拟装置——这是一个真正的、由物理驱动的物体，你可以让它飞行、下沉或行驶。先将方块粘合在一起，然后按住右键并拉动操纵杆即可完成组装。"]
	quest.500FA9792456C013.quest_subtitle: "每个模拟装置的核心"
	quest.504757B76E9743CB.quest_subtitle: "装饰方块"
	quest.50581515CDE49180.quest_desc: ["它的工作原理与标准的大轮胎完全相同——只是颜色不同。将大轮胎与棕色染料一同合成即可制作。"]
	quest.50581515CDE49180.quest_subtitle: "一个染成棕色的大轮胎。"
	quest.50CE0BD7B0BC4017.quest_desc: ["流体阀门可以通过在侧面施加旋转力来在开启和关闭之间切换。这通常通过阀门手柄或换挡杆来完成。阀门侧面的一组方向箭头也会随之旋转，以指示阀门是开启还是关闭状态。"]
	quest.50CE0BD7B0BC4017.quest_subtitle: "流体阀门可用于关闭或开启管道中的流体流动。"
	quest.5111785DAB2ECFB9.quest_subtitle: "装饰方块"
	quest.512C2F38D9309C6E.quest_desc: ["它的工作原理与标准的“怪物轮胎”完全相同——只是颜色不同。将“怪物轮胎”与浅灰色染料一同合成即可制作。"]
	quest.512C2F38D9309C6E.quest_subtitle: "一个染成浅灰色的“怪物轮胎”。"
	quest.513D5B47A7AE1492.quest_desc: ["右键将其放置在车轮支架上，即可在地面上滚动。将其与染料一同合成，可制作出 16 种颜色变体中的一种。"]
	quest.513D5B47A7AE1492.quest_subtitle: "大型轮胎，一种巨大的全地形车轮。"
	quest.513D6027ECB7D891.quest_subtitle: "装饰方块"
	quest.516292716B400BDB.quest_subtitle: "装饰方块"
	quest.518BE9C73EEA15E8.quest_subtitle: "装饰方块"
	quest.519F769CD09D01B1.quest_subtitle: "装饰方块"
	quest.51CCB7ACFD7B45F1.quest_desc: [""]
	quest.51CCB7ACFD7B45F1.quest_subtitle: "黄铜外壳用于更高级的机器中。"
	quest.51D077F9C830AA69.quest_subtitle: "装饰方块"
	quest.525B3ED31D6C1C95.quest_subtitle: "装饰方块"
	quest.5287D9F564797135.quest_desc: ["旋转时会产生推力，并会自动沿一个轴俯仰，以尝试朝向上方。使用扳手右键点击可反转其推力方向。"]
	quest.5287D9F564797135.quest_subtitle: "可自动调整推力方向的螺旋桨"
	quest.52A593D191365A78.quest_desc: ["“领地方块”放置在子层级（一个装置）上时，可让您认领并保护该载具，使您辛苦建造的飞空艇免受恶意破坏。"]
	quest.52A593D191365A78.quest_subtitle: "通过认领来保护您的飞空艇"
	quest.52EEC531B25E99CB.quest_desc: [
		""
		"[ { \"text\": \"创建交易大厅\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"5856137738C5229F\" } } ]"
	]
	quest.52F31F54165F1184.quest_desc: ["带有对角线“斜切”的装饰面板，可用于为火车、车厢和车站增添色彩与细节。提供全部十六种染料颜色。"]
	quest.52F31F54165F1184.quest_subtitle: "火车装饰面板"
	quest.53839611482E91A6.quest_desc: ["可捕捉日光以产生热能的太阳能电池板。"]
	quest.53839611482E91A6.quest_subtitle: "利用阳光产生热能"
	quest.53C002F2ABE538B0.quest_subtitle: "装饰方块"
	quest.53C0234C053BF0CF.quest_desc: [
		"放置一个库存链接以启动一个新的物流网络。在放置前右键单击已放置的库存链接，即可共享该链接的网络。将链接放置在打包机上，即可把打包机连接的库存与该网络连接。"
		""
		"库存链接没有范围限制，但其所在的区块必须处于加载状态，才能被网络识别。"
		""
		"库存链接可以通过物流网络接收和发送请求。"
	]
	quest.53C0234C053BF0CF.quest_subtitle: "库存链接用于将打包机连接到物流网络。"
	quest.53C17A476C27EE6A.quest_desc: ["将它们安装在控制台上，以绑定按键和红石链接频率。普通按钮是单一输入，按钮面板可将多个按钮分组，而按钮键盘则可将大量按钮整合在一个紧凑的网格中。"]
	quest.53C17A476C27EE6A.quest_subtitle: "按钮模块是用于控制台的紧凑型按钮输入设备。"
	quest.53E4FA4FC288F2C4.quest_subtitle: "装饰方块"
	quest.53FD572EEA1B8583.quest_subtitle: "装饰方块"
	quest.541F19F64E5106E5.quest_desc: [
		"脉冲计时器会以设定的时间间隔重复发送红石信号。通过向其提供红石信号可以将其禁用。"
		""
		"可通过长按右键访问其“数值设置”界面来设置间隔时间。延迟时间可在 2 刻钟至 60 分钟之间设置。还可以使用剪贴板将设置复制并粘贴到其他脉冲计时器、脉冲中继器或脉冲延长器上。"
	]
	quest.541F19F64E5106E5.quest_subtitle: "脉冲计时器用于以设定的间隔重复发出脉冲。"
	quest.5452569B53AF9228.quest_subtitle: "装饰方块"
	quest.54589F10802DFE16.quest_desc: ["一个除非通电否则处于未连接状态的离合器"]
	quest.545EE18B03F3A125.quest_desc: [
		""
		"[ { \"text\": \"制作飞行背包\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"491A4EA9E2AE2783\" } } ]"
	]
	quest.546C27255A22817C.quest_desc: ["启用高级移动功能：量子驱动可实现短距离传送。"]
	quest.54E2B7BC6C3019C4.quest_desc: ["在红石供电并提供 FE 能量时可提供定向推力——如果你有富余的电力，就能获得清洁、无燃料的推进方式。"]
	quest.54E2B7BC6C3019C4.quest_subtitle: "电动定向推进器"
	quest.55239B8751A3080F.quest_desc: ["一种由铂金制成的坚固外壳，用于制造和包裹推进机械。"]
	quest.55239B8751A3080F.quest_subtitle: "铂金外壳，推进机械的外壳。"
	quest.553A2C5D3773DF27.quest_desc: ["在雷达装置的接收器周围添加碟片和盘子。每种都能增加探测范围，这两种类型可以自由混合，打造你心仪的外观。"]
	quest.553A2C5D3773DF27.quest_subtitle: "扩大雷达的探测范围"
	quest.554C4AA8E303848B.quest_subtitle: "装饰方块"
	quest.55BFEE429ED3C0B1.quest_desc: ["钉枪利用压缩空气快速发射钉子，弹药来自一个大型弹匣。为其加装分叉枪管或蒸汽引擎，即可实现持续射击。"]
	quest.55BFEE429ED3C0B1.quest_subtitle: "快速射击的钉枪"
	quest.55CB7F7C1F982DBF.quest_desc: [
		"魔杖的有效范围为 50 个方块。"
		""
		"按住 Shift 键并右键单击，即可调整魔杖的设置。可将其设为“单次镜像、矩形或八边形”，并指定镜像所沿用的轴。"
		""
		"在地面上右键单击即可放置魔杖。再次右键单击可将其放置到别处。在“单次镜像”或“矩形”设置下，也可以在游戏中直接调整其朝向。在空气中右键单击，或从快捷栏中移除魔杖，即可将其从世界中移除。"
		""
		"在魔杖周围放置或破坏方块，即可让魔杖将操作镜像到另一侧（或多侧）。放置方块时会从背包中取出相应的方块，而破坏方块时，所有物品都会在玩家破坏的方块位置生成。"
	]
	quest.55CB7F7C1F982DBF.quest_subtitle: "对称魔杖是一款实用的建造工具，可以对放置的方块进行镜像。"
	quest.55DBEABEF5174219.quest_desc: ["它为飞行器添加了火箭式推进器、机翼、燃烧器和燃料系统，让你能够利用纯粹的推力来驱动和操控你的飞行器。"]
	quest.55DBEABEF5174219.quest_subtitle: "Create Propulsion: Simulated 是一款适用于 Minecraft 1.21.1 的 NeoForge 模组，它将注重推进系统的 Create 玩法引入了 Sable + Create Aeronautics 生态系统中。"
	quest.55DBEABEF5174219.title: "Create Propulsion: Simulated"
	quest.55F444C86FD5516C.quest_desc: ["一小块电金，这种导电合金广泛应用于《Create: Crafts and Additions》模组中。九个金锭可合成一个合金锭。"]
	quest.55F444C86FD5516C.quest_subtitle: "合成组件。"
	quest.55F4BB16DB93C01E.quest_desc: ["Create Deco 是目前最出色的模组，能将你的工业风、都市风或蒸汽朋克风格的建筑提升到全新水平。从走道、笼式灯具到集装箱和金属板，Create Deco 中的各种元素都能与 Create 模组中现有的方块无缝整合。"]
	quest.5628479EB6BB2EBF.quest_desc: ["它的特性与 Levitite 完全相同。在结晶 Levitite 混合物时，将棕色染料持于副手即可合成。"]
	quest.5628479EB6BB2EBF.quest_subtitle: "经过棕色染料着色的 Levitite 变体。"
	quest.5660F00EE9B988BB.quest_desc: ["一种圆柱形、锅炉状的方块，用于建造蒸汽机车的车身。提供全部十六种染料颜色，以匹配你的涂装。"]
	quest.5660F00EE9B988BB.quest_subtitle: "装饰性锅炉方块"
	quest.566D6390193DD77D.quest_desc: [
		"黄铜隧道可用于机械传送带，实现四种功能：1）纯装饰；2）将物品流分流至多个目的地；3）对物品流进行排序；4）合并多个物品流。每个隧道都可以有输入或输出端口。其输入或输出的状态完全取决于传送带接触某一侧的方向。"
		""
		"紧邻放置的隧道会自动被视为一个组，在大多数情况下会从所有输入端收集物品，并分配到所有输出端。物品的分配方式由隧道的数值设置控制。来自不同输入端的物品堆叠在分配前不会被合并。"
	]
	quest.566D6390193DD77D.quest_subtitle: "黄铜隧道是一种只能放置在机械传送带上的机器。"
	quest.566E38B30F4AE69F.quest_desc: ["它的工作原理与标准轮胎完全相同——只是颜色不同。将轮胎与淡蓝色染料一起合成即可制作。"]
	quest.566E38B30F4AE69F.quest_subtitle: "一个染成淡蓝色的轮胎。"
	quest.56964EE9BF575F80.quest_desc: ["它需要旋转动力，并且必须连接到压载水箱，同时至少有一个面接触海水。反转旋转方向即可切换至排水模式，将水重新排出。"]
	quest.56964EE9BF575F80.quest_subtitle: "压载水通风口用于灌满和排空你的压载水箱。"
	quest.56B5C0FE19AAEF4B.quest_subtitle: "装饰方块"
	quest.56C8010167A4B825.quest_subtitle: "装饰方块"
	quest.56E21CF6CEE76C4C.quest_subtitle: "装饰方块"
	quest.570DC20BFC4E3E0C.quest_desc: ["通过为黄金充能获得"]
	quest.570DC20BFC4E3E0C.quest_subtitle: "合成物品"
	quest.5722DD2B679A479E.quest_subtitle: "装饰方块"
	quest.574C7772730A1CC1.quest_desc: ["动力钻头轴可以运输物品，并自动收集任何与之相连的采集装置掉落的物品。使用扳手可在钻头轴和钻头齿轮之间切换，并用工业铁块将它们包裹起来。物品只能从被包裹的中间部分通过——无法通过钻头齿轮或轴的两端。"]
	quest.574C7772730A1CC1.quest_subtitle: "钻头轴可沿动力轴移动物品。"
	quest.5760BF287EEB0C0E.quest_desc: ["它的行为方式与悬浮石完全相同。在结晶悬浮石混合物时，将紫色染料拿在副手即可制作。"]
	quest.5760BF287EEB0C0E.quest_subtitle: "悬浮石的紫色染色变体。"
	quest.57D7693005A610F0.quest_desc: ["它会燃烧固体燃料来加热其上方的机器（例如斯特林发动机），并支持红石恒温器覆盖功能。"]
	quest.57D7693005A610F0.quest_subtitle: "固体燃烧器利用固体燃料产生热量。"
	quest.583AC516A10C9711.quest_subtitle: "装饰方块"
	quest.5856137738C5229F.quest_desc: ["交易站方块可用于在白天自动与村民进行交易。"]
	quest.588415583F6D634E.quest_subtitle: "装饰方块"
	quest.58B8821DCF4DDC81.quest_desc: [
		""
		"[ { \"text\": \"创建复制者+\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"7C5E7060FAB3A110\" } } ]"
	]
	quest.58E158C8F2C04BEB.quest_desc: ["加热悬浮石混合物，将其结晶为悬浮石。为装置连接足够多的悬浮石后，它就会漂浮起来——不过它自身无法提升高度，并且抵抗缓慢移动的能力远大于抵抗快速移动的能力。"]
	quest.58E158C8F2C04BEB.quest_subtitle: "结晶混合物融入悬浮水晶"
	quest.59742E14B716CDB0.quest_desc: ["你可以使用热泵将热量泵送到任何你想要的方向。"]
	quest.59742E14B716CDB0.quest_subtitle: "将热量引导到你需要的地方"
	quest.59993E6A76D3511F.quest_desc: ["反应堆散热口会从正在运行的反应堆中抽出热量，并将其输送到相连的热管中，从而控制核心温度。"]
	quest.59993E6A76D3511F.quest_subtitle: "将热量从反应堆中排出"
	quest.599CBC177D3D745D.quest_desc: ["用绳索耦合器右键点击绞盘和绳索连接器，即可用绳索将它们连接起来。之后可以使用剪刀剪断绳索。"]
	quest.599CBC177D3D745D.quest_subtitle: "将绳索系在绞盘或连接器上"
	quest.599EF0E99664A03B.quest_desc: ["你可以在地牢中找到蓝图"]
	quest.59AB803FFC868FFC.quest_desc: ["它的工作原理与标准轮胎完全相同——只是颜色不同。将轮胎与黑色染料一起制作即可。"]
	quest.59AB803FFC868FFC.quest_subtitle: "一个染成黑色的轮胎。"
	quest.5A2450162FD24F7E.quest_desc: [
		"必须将两个破碎轮水平或垂直放置，彼此间隔一个方块。两个轮子必须施加相反的旋转力。任何需要破碎的物品都必须从轮子向内旋转的位置放入。"
		""
		"通过在轮子正上方的顶部放置一个漏斗，并在下方连接储物箱或传送带，就可以实现破碎轮的自动化。"
	]
	quest.5A2450162FD24F7E.quest_subtitle: "破碎轮会对从轮子旋转相反方向放入的任何物品应用破碎配方。"
	quest.5A2450162FD24F7E.title: "破碎轮"
	quest.5A643C5226143CB9.quest_desc: ["A massive spinning copper coil paired with powerful magnets, converting rotational kinetic energy into electrical power. It serves as the foundational power generator for your grid."]
	quest.5A643C5226143CB9.quest_subtitle: "将旋转转化为电能"
	quest.5AB03B0A601002AA.quest_desc: [""]
	quest.5AE426F22CB8BF98.quest_desc: ["Once mounted on a Control Desk, it works like the standalone Joystick - each direction transmits on its own Redstone Link frequency with power proportional to how far the stick is tilted."]
	quest.5AE426F22CB8BF98.quest_subtitle: "操纵杆模块是一个可以安装在控制台上的双轴操纵杆。"
	quest.5AF1979C8EE3249D.quest_subtitle: "装饰方块"
	quest.5B057D497F07981D.quest_subtitle: "装饰方块"
	quest.5B20D67059C6ACBD.quest_desc: ["A cylindrical, boiler-shaped block for building the body of steam locomotives. Comes in all sixteen dye colours to match your livery."]
	quest.5B20D67059C6ACBD.quest_subtitle: "装饰性锅炉方块"
	quest.5B42670C93888FC4.quest_subtitle: "装饰方块"
	quest.5B44C72D8A598AD2.quest_subtitle: "装饰方块"
	quest.5B50E0BA87CF1BDC.quest_desc: ["It works exactly like the standard Large Tire - only the color changes. Craft a Large Tire together with white dye to make it."]
	quest.5B50E0BA87CF1BDC.quest_subtitle: "一个染成白色的大型轮胎。"
	quest.5B63F1DDEF9ABFF4.quest_desc: ["A longer barrel for the Revolver, boosting range and accuracy in exchange for slightly slower handling."]
	quest.5B63F1DDEF9ABFF4.quest_subtitle: "左轮手枪枪管升级件"
	quest.5BE34A7DF70B1E7F.quest_subtitle: "装饰方块"
	quest.5C2108BD3DEEB0E6.quest_desc: [
		"The Spout is a block used for filling liquid containers such as bottles or buckets, or crafting with liquids."
		""
		"出水口可通过流体管道注入最多 1 桶任意液体，然后会将部分流体倾倒到通过传送带或货站从其下方经过的兼容物品上。"
		""
		"无论使用多少流体，出水口处理一个物品都需要 1 秒，但两次注液之间的延迟可能是由出水口重新注满所需的时间造成的。"
	]
	quest.5C2CF0E0CC94347D.quest_subtitle: "装饰方块"
	quest.5C363998DB5B46F4.quest_subtitle: "装饰方块"
	quest.5C673A5296FD9379.quest_desc: ["一个圆柱形、类似锅炉的方块，用于建造蒸汽机车的车身。提供全部十六种染料颜色，以匹配您的涂装。"]
	quest.5C673A5296FD9379.quest_subtitle: "装饰性锅炉方块"
	quest.5C6E945F38EA9846.quest_desc: ["车轮支架可安装车轮状物品，使装置能够在地面上滚动；从顶部提供动力可刹车，从侧面提供动力可转向。轮胎有小号、标准、大号及巨型四种尺寸，适用于任何地形。"]
	quest.5C6E945F38EA9846.quest_subtitle: "地面车辆用轮胎"
	quest.5C6E945F38EA9846.title: "轮胎"
	quest.5CA8F8A195AD24D8.quest_desc: [
		"使用拉拔机将黄铜板加工成弹壳。通过对黄铜板进行多次拉拔，可以生产各种类型的弹壳，从手枪弹壳到步枪弹壳、榴弹壳乃至炮弹壳。"
		""
		"获得弹壳后，使用部署器为其填充火药，然后插入一个金属锭即可完成子弹的制作。"
	]
	quest.5CCAE584BC13C4E3.quest_subtitle: "装饰方块"
	quest.5CE5CD23C00E3F04.quest_desc: ["它的功能与标准大轮胎完全相同——只是颜色不同。将大轮胎与淡蓝色染料一同制作即可。"]
	quest.5CE5CD23C00E3F04.quest_subtitle: "一个染成淡蓝色的大轮胎。"
	quest.5D0B237AC1C177CA.quest_desc: ["当从下方提供热量时，斯特林发动机将开始缓慢旋转。"]
	quest.5D0B237AC1C177CA.quest_subtitle: "将热能转化为旋转动力。"
	quest.5D745773CEA7E388.quest_desc: ["岩石切割轮可以啃穿石头。钻头轴承至少需要一个它才能进行挖掘——它是机械掘进机的基础。"]
	quest.5D745773CEA7E388.quest_subtitle: "用于掘进钻机的钻孔轮。"
	quest.5D851AA005725F11.quest_desc: ["由铂矿石熔炼而成，用于制作推进装置的机器和外壳。"]
	quest.5D851AA005725F11.quest_subtitle: "铂锭，推进装置的基础金属。"
	quest.5DC411437882B19D.quest_desc: ["一种可骑乘的发射器：装入可投掷的绳索连接器，将绳索发射到锚点上，并可通过红石控制实现免手发射和释放。"]
	quest.5DC411437882B19D.quest_subtitle: "安装在方块上的绳索鱼叉。"
	quest.5DCE62E32B5099CA.quest_desc: ["它的特性与悬浮石完全相同。在结晶悬浮石混合物时，手持绿色染料即可制作。"]
	quest.5DCE62E32B5099CA.quest_subtitle: "悬浮石的一种绿色染色变体。"
	quest.5E0465DA39B3354D.quest_subtitle: "装饰方块。"
	quest.5E051237C5E852FB.quest_desc: ["它的功能与标准巨型轮胎完全相同——只是颜色不同。将巨型轮胎与粉色染料一同制作即可。"]
	quest.5E051237C5E852FB.quest_subtitle: "一个染成粉色的巨型轮胎。"
	quest.5E0D162FB2932A41.quest_subtitle: "装饰方块。"
	quest.5E56F602B8815496.quest_desc: [
		"右键点击一个“红石请求器”选中的股票链接或股票代码，即可将其连接到物流网络，然后将其放置。"
		""
		"您可以在“红石请求器”的菜单中配置其请求。它最多可以请求将 9 种不同物品各 256 个送达指定地址。"
		""
		"当接收到红石信号供电时，请求器会发出其 UI 中设置的请求。如果网络中找不到所需物品，则不会发出请求。"
	]
	quest.5E56F602B8815496.quest_subtitle: "“红石请求器”用于向已连接的打包机请求纸箱包裹。"
	quest.5E6F48677A198FEE.quest_subtitle: "装饰方块"
	quest.5EE479F3CFBBB5DF.quest_desc: ["一种圆柱形、类似锅炉的方块，可用于建造蒸汽机车的车身。提供全部十六种染料颜色，以匹配您的涂装。"]
	quest.5EE479F3CFBBB5DF.quest_subtitle: "装饰性锅炉方块"
	quest.5F078EEB6F883E37.quest_desc: ["附加枪膛让燧发枪在重新装填前可以装填并发射数次弹药，从而缓解其最大的弱点。"]
	quest.5F078EEB6F883E37.quest_subtitle: "燧发枪容量升级"
	quest.5F5ACAA9FF2DF350.quest_subtitle: "装饰方块"
	quest.5F76EA2FEC505EAE.quest_desc: ["它的行为与“浮升石”完全相同。在结晶“浮升石混合物”时，将浅灰色染料拿在副手即可制作。"]
	quest.5F76EA2FEC505EAE.quest_subtitle: "“浮升石”的一种浅灰色染色变体。"
	quest.5FA0FD61BDF44067.quest_desc: ["提供高级移动能力：助推火箭可提供一次速度爆发。"]
	quest.60055D1DE16D8F03.title: "卡丁车"
	quest.6072830A6998AA20.quest_subtitle: "装饰方块"
	quest.6073B047C7B98625.quest_desc: ["它的功能与标准大轮胎完全相同——只是颜色不同。将大轮胎与红色染料一同制作即可。"]
	quest.6073B047C7B98625.quest_subtitle: "一个染成红色的大轮胎。"
	quest.607F881A2C2B5F97.quest_desc: ["它的功能与标准小轮胎完全相同——只是颜色不同。将小轮胎与灰色染料一同制作即可。"]
	quest.607F881A2C2B5F97.quest_subtitle: "一个染成灰色的小轮胎。"
	quest.6083C27BDAD82105.quest_subtitle: "装饰方块"
	quest.6098C7276359A9C5.quest_subtitle: "装饰方块"
	quest.60DBF181ED929607.quest_desc: ["可为齿轮充能，还能向玩家和生物释放具有伤害性的电弧——是一个兼具攻击与实用功能的方块。"]
	quest.60DBF181ED929607.quest_subtitle: "为齿轮充能并电击敌人"
	quest.61348E2551E8AD6C.quest_desc: [
		"旋转速度控制器必须搭配大齿轮才能工作。当由大齿轮提供动力时，旋转速度控制器可从其侧面输出任意所需速度的旋转力。它也能反向工作：当从侧面获得动力时，它会控制大齿轮的转速。"
		""
		"可在机器正面或背面的数值设置界面更改旋转速度和方向。速度最高可设置为顺时针或逆时针 256 转/分钟。"
	]
	quest.61348E2551E8AD6C.quest_subtitle: "旋转速度控制器是一种机械组件，可让玩家精确控制旋转速度。"
	quest.6142979F2E5E54E5.quest_desc: ["Create：航空及其配套模组可让你建造飞艇、热气球、飞机和潜水艇，它们都是完全模拟、由物理驱动的装置。本章将带你从制造第一个螺旋桨开始，逐步打造可操控的飞行机器。"]
	quest.6142979F2E5E54E5.quest_subtitle: "飞向天空"
	quest.614345CE5AB038B6.quest_subtitle: "制造组件。"
	quest.617EBC25B0F97965.quest_desc: [
		""
		"[ { \"text\": \"Create 切片与切割\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6C049540C64342A8\" } } ]"
	]
	quest.61A3BF6B8D5F92EC.quest_desc: [""]
	quest.61A3BF6B8D5F92EC.quest_subtitle: "重型发射器变体"
	quest.61F76D3FF8262A54.quest_desc: ["Create 锦上添花是 Create 模组的一款附加包，它专注于玩家体验，为 Create 建筑与装置增添了全新的装饰性与功能性方块。"]
	quest.61F76D3FF8262A54.title: "Create：锦上添花"
	quest.6262A1BE2DF8FFA1.quest_desc: ["它的工作原理与标准的小轮胎完全相同——只是颜色发生了变化。将小轮胎与蓝色染料一同合成即可。"]
	quest.6262A1BE2DF8FFA1.quest_subtitle: "一个染成蓝色的小轮胎。"
	quest.626580DB654F128D.quest_subtitle: "磨石能够对上方向内放入的任何有效物品应用研磨配方。"
	quest.62671BDA7C583957.quest_desc: ["由有机物制成的生物质，是生产生物燃料和固体生物质颗粒的中间步骤。"]
	quest.62671BDA7C583957.quest_subtitle: "可堆肥的燃料基底"
	quest.62DB74C03D100293.quest_subtitle: "装饰方块"
	quest.62E16AC3521529A6.quest_desc: ["枪托可以稳定枪械，减少后坐力和散布，从而实现更精准、可控的射击。"]
	quest.62E16AC3521529A6.quest_subtitle: "用于提升稳定性的武器配件"
	quest.62F1177325B16068.quest_desc: ["用于大电流连接的金合金线轴，可容纳电线以连接多个大电流连接器。"]
	quest.62F1177325B16068.quest_subtitle: "存放大电流电线"
	quest.62FA8647798A15EE.quest_subtitle: "装饰方块"
	quest.63279EB782F2752F.quest_desc: ["其作用与标准的“怪物轮胎”完全相同——只是颜色不同。将“怪物轮胎”与品红染料一同制作即可。"]
	quest.63279EB782F2752F.quest_subtitle: "一个染成品红色的“怪物轮胎”。"
	quest.632C20063AEF5BE5.quest_desc: ["创建：蒸汽与铁轨模组在“创造”模组的火车系统基础上，增加了新的连接器、信号和轨道工具，并提供了一整套“机车金属”方块，用于装饰你的机车和车厢。"]
	quest.632C20063AEF5BE5.quest_subtitle: "扩展“创造”模组的火车与轨道"
	quest.632D1A4B5C9F4222.title: "&l&4红石"
	quest.634F7742AA16EB11.quest_desc: ["“链接销”是一种装饰性连接器，放置在火车车厢末端，使车厢之间的连接呈现出复古铁路的真实外观。纯属装饰用途。"]
	quest.634F7742AA16EB11.quest_subtitle: "用于火车末端的装饰性连接器"
	quest.6350ADB7540C368D.quest_desc: [
		"如果将智能观察者放置成其正面朝向容器（如机械传送带、漏斗或流体管道），当检测到容器内有物品时，它会发出红石信号。如果智能观察者正前方的方块与过滤器匹配，它也会发出信号。"
		""
		"如果为智能观察者应用了过滤器，那么只有当检测到过滤器中指定的物品时，它才会发出红石信号。"
	]
	quest.6350ADB7540C368D.quest_subtitle: "智能观察者是一种机器，它会根据前方容器内的方块或物品发出红石信号。"
	quest.63E5A6F388AA25D9.quest_subtitle: "装饰方块"
	quest.63E8F78EEA3063F7.quest_desc: ["[ { \"text\": \"齿轮换挡器\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"24DDED464AE48E05\" } } ]"]
	quest.63EDF003DE31445F.quest_desc: ["被充能至高磁通量的磁铁矿，用于制作最强的磁铁和高级组件。"]
	quest.63EDF003DE31445F.quest_subtitle: "高强度磁性方块"
	quest.642230FC856DE526.quest_desc: ["用于为配备“连接销”耦合器的轨道车辆安装端梁（车头）。作为一种模仿方块，它会采用你为其应用的任何材质的纹理。"]
	quest.642230FC856DE526.quest_subtitle: "可复制任意方块的端梁"
	quest.6444F64F434D7D25.quest_subtitle: "装饰方块"
	quest.648B1D6ACDC7A6F2.quest_desc: [
		"将你的旧装备（无论是工具、武器还是盔甲）拆解成锭、块和碎片。"
		"将大多数木方块变体分解成木棍，包括来自其他模组的方块。"
		"你担心会不小心把铁块掉进破碎机里吗？别担心，现在它只会分解成铁锭。大多数其他“紧凑型”方块也是如此。"
		"铁轨、铁栏、碗、相同的音乐唱片，以及你在搜刮完一些模组化地牢后堆满背包的各种物品，现在都有用了。"
		"在搭建好红石装置后，是否还有多余的中继器和活塞闲置着？现在这不再是问题了。"
	]
	quest.64AB5CCDD9860DD8.quest_desc: ["将铁板放入轧机中获得。"]
	quest.64AB5CCDD9860DD8.quest_subtitle: "合成组件。"
	quest.64B39D946D7DAD8A.quest_desc: ["铆接金属是“蒸汽与铁轨”模组的基础材料，可用于合成锅炉、车头框架以及众多装饰面板，赋予机车经典的铆接铁外观。"]
	quest.64B39D946D7DAD8A.quest_subtitle: "标志性的火车建造方块"
	quest.64CF1354946D22B8.quest_subtitle: "装饰方块"
	quest.64E075328853897B.quest_subtitle: "装饰方块"
	quest.64F3F33955B72D60.quest_subtitle: "装饰方块"
	quest.652442BDE0602E91.quest_desc: ["一种强大的钻头，专为精密钻削炮管而设计。"]
	quest.654FBC78D1C3B35D.quest_desc: ["根据海拔高度输出红石信号——默认情况下，海拔越高，信号越强。可在其用户界面中设置最低和最高海拔。"]
	quest.654FBC78D1C3B35D.quest_subtitle: "读取你在空中的高度"
	quest.65715BCC3BF025C1.quest_desc: ["当通入红石信号时，热空气燃烧器会逐渐为其上方的气囊充满提供升力的热空气。输入面板可设置其最大输出量，多个燃烧器可以为同一个气球供能。"]
	quest.65715BCC3BF025C1.quest_subtitle: "为你的气球充入热空气"
	quest.66103C97558260D3.quest_subtitle: "装饰方块"
	quest.66108B4F2DBF2E3F.quest_desc: ["将铜锭放入轧机中获得。"]
	quest.66108B4F2DBF2E3F.quest_subtitle: "合成组件。"
	quest.663F89822E1FF951.quest_desc: ["通过给铁充能获得"]
	quest.663F89822E1FF951.quest_subtitle: "合成物品"
	quest.66934314E00ED53C.quest_subtitle: "装饰方块"
	quest.66AA867F65118548.quest_subtitle: "装饰方块"
	quest.66C3C169307A8025.quest_desc: ["允许玩家飞得更快、移动和游泳速度更快。对水有效"]
	quest.66D9F91519D52482.quest_desc: ["烈焰蛋糕是一种可以喂给烈焰燃烧器以使其超热的物品。"]
	quest.675A9530C02D7A94.quest_desc: ["未通电时，它不会传递旋转。为直边通电可传递旋转，或为反向边通电以翻转其方向——用红石控制旋转方向。"]
	quest.675A9530C02D7A94.quest_subtitle: "红石控制的旋转方向切换器"
	quest.67671FD1B34E7314.quest_subtitle: "装饰方块"
	quest.677DFEE3535D5FB5.quest_desc: ["铺设线缆以在您的建筑中传输FE。使用线缆卷轴放置第一组线缆。"]
	quest.677DFEE3535D5FB5.quest_subtitle: "线缆可在机器之间传输锻造能量。"
	quest.6798E2C1C2A242D5.quest_desc: ["使用控制模块右键点击其插槽即可安装，再将其靠近控制台即可合并为一个统一操控的装置。空手右键可夺取控制权——之后用键盘和鼠标移动已安装的控制器，每个方向都会通过其自身的红石链接频率传输信号。按 ESC 键可释放控制权。"]
	quest.6798E2C1C2A242D5.quest_subtitle: "控制台是可供您安装在飞船上的驾驶舱。"
	quest.67C7CBC848DBCC0C.quest_subtitle: "装饰方块"
	quest.67DCAD0D8E27D742.quest_subtitle: "装饰方块"
	quest.67E3DE0BBB66C30B.quest_subtitle: "装饰方块"
	quest.6803BF9EAF78335C.quest_desc: ["一种圆柱形、类似锅炉的方块，用于建造蒸汽机车的车身。提供全部十六种染料颜色，以匹配您的涂装。"]
	quest.6803BF9EAF78335C.quest_subtitle: "装饰性锅炉方块"
	quest.680DB44761CE8160.quest_desc: ["一种圆柱形、类似锅炉的方块，用于建造蒸汽机车的车身。提供全部十六种染料颜色，以匹配您的涂装。"]
	quest.680DB44761CE8160.quest_subtitle: "装饰性锅炉方块"
	quest.6832CFEAFA7922E8.quest_desc: ["一个在通电时会产生巨大应力的装置，会通过过度施压来使网络中断"]
	quest.68331DDD9F01BDC5.quest_desc: ["使用燃料。"]
	quest.683F038B42039EB4.quest_subtitle: "装饰方块"
	quest.686DA5E275A9290B.quest_desc: ["使用部署器将车轮安装到底盘上。"]
	quest.686DA5E275A9290B.title: "卡丁车车轮"
	quest.6876FDE87B1F5A99.quest_desc: ["火枪枪管可以延长燧发枪的射程和精准度，将手枪变成一把真正的长枪。"]
	quest.6876FDE87B1F5A99.quest_subtitle: "燧发枪枪管升级"
	quest.6887C6B7ED8727B3.quest_desc: ["信封方块可以围成一个密闭空间，充满热空气后便能产生升力。用它们密封一个区域，从下方为其充气，你的装置就会开始上升。右键点击染料即可重新染色。"]
	quest.6887C6B7ED8727B3.quest_subtitle: "建造用于升空的飞艇"
	quest.69189C6AF7556602.quest_subtitle: "装饰方块"
	quest.6938ECBB2B767300.quest_desc: ["自动装弹器可以为你循环装填弹壳，与手动压枪相比，能够提高霰弹枪的射速。"]
	quest.6938ECBB2B767300.quest_subtitle: "霰弹枪装弹升级"
	quest.695CC32ED98F11B3.quest_desc: [
		""
		"[ { \"text\": \"创建中央厨房\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"42195C45933ACA1E\" } } ]"
	]
	quest.69639FE3F7621EB8.quest_subtitle: "装饰方块"
	quest.696631A7286A38E8.quest_desc: [""]
	quest.696631A7286A38E8.quest_subtitle: "驱动自动武器的引擎"
	quest.69816C16E81355E8.quest_desc: ["一个在网络过载后经过设定延迟便会脱开的离合器。可用扳手重置"]
	quest.6986767827914A8E.quest_subtitle: "装饰方块"
	quest.698D5738EA593FFC.quest_subtitle: "装饰方块"
	quest.6A0B52B4AA96B42E.quest_desc: ["气动锤利用压缩空气发动猛烈的重击，并产生强大的击退效果。其锤头可在石质、铁质、钻石质和下界合金质之间切换。"]
	quest.6A0B52B4AA96B42E.quest_subtitle: "气动近战粉碎器"
	quest.6A25B4076E0CC9CD.quest_desc: ["将其与一个监视器连接，然后设置起点和终点来定义一个安全区域。位于该区域内的目标将不受影响，从而保护友方基地免受攻击。"]
	quest.6A25B4076E0CC9CD.quest_subtitle: "标记一片禁止开火的区域。"
	quest.6A2D63867E5FDE2A.quest_subtitle: "装饰方块"
	quest.6A6CEE66F2315D7B.quest_subtitle: "装饰方块"
	quest.6A891A299CB4627F.quest_desc: ["为其提供红石动力，并通过管道注入松节油来推动你的装置。其油门大小与红石信号强度成正比。"]
	quest.6A891A299CB4627F.quest_subtitle: "推进器可提供原始的方向推力。"
	quest.6B4961271FD5583C.quest_subtitle: "装饰方块"
	quest.6B589BB205485486.quest_subtitle: "装饰方块"
	quest.6B7188472F6ED6AF.quest_desc: ["将此物品分配至一个红石链接频率槽，以匹配该槽中的任意物品（包括空气）。"]
	quest.6B8966D7EA9BB5FB.quest_desc: ["已安装齿轮的手摇曲柄。在需要齿轮比和空间狭小时非常实用。"]
	quest.6BC833A2D916A0DC.quest_desc: ["对接连接器需成对使用：将两个连接器相互靠近，一旦对准便会锁定在一起，形成刚性连接——非常适合飞船对接或模块化建造。"]
	quest.6BC833A2D916A0DC.quest_subtitle: "自动对准的刚性耦合器。"
	quest.6C02188DA80AEDAD.quest_subtitle: "装饰方块"
	quest.6C049540C64342A8.quest_desc: ["“Create Slice & Dice”模组提供了多种功能，以增强 &aFarmer's Delight&r 与 &6Create&r 之间的兼容性。虽然它专为 &aFarmer's Delight&r 设计，但即使没有该模组也能运行，并为其他模组增加了一些兼容特性。"]
	quest.6CD96328B7567F46.quest_desc: ["机械收割机在前进时，会收割所有与之接触的成熟作物。"]
	quest.6CD96328B7567F46.quest_subtitle: "机械收割机是一种用于&3机械装置&r上收割农作物的组件。"
	quest.6CEAED7D28C9A033.quest_desc: ["一块带有对角线“斜切”的装饰面板，可用于为火车、车厢和车站增添色彩与细节。提供全部十六种染料颜色。"]
	quest.6CEAED7D28C9A033.quest_subtitle: "火车装饰面板"
	quest.6D03D3B4D83C1840.quest_desc: [
		"用扳手右键点击机械合成器的前方，可以改变其在合成时发送物品的方向。"
		""
		"漏斗或跳板可以自动为机械合成器填充物品。"
		""
		"在机械合成器的背面和侧面，可以使用扳手连接或断开两个相邻合成器的物品栏。不参与相同合成配方的合成器可以共享物品栏。"
		""
		"物品也可以手动放入或取出。"
		""
		"每个机械合成器都有一个内部齿轮，只能由相邻的机械合成器或任意尺寸的齿轮提供动力。这意味着一个装置中只需要由一个机械合成器通过齿轮提供动力即可。"
		""
		"当由旋转动力驱动，并且同时接通了红石信号或所有合成槽都已填满时，机械合成器会将物品传送到相邻的合成器。要成功合成，所有物品最终必须在同一个合成器中汇合。一旦所有物品都抵达最终的合成器，它们就会转化为成品。"
	]
	quest.6D03D3B4D83C1840.quest_subtitle: "机械合成器是一种可以自动合成物品的机器。"
	quest.6D3A3A4F218C6E3E.quest_subtitle: "装饰方块"
	quest.6D53565E445D72D8.quest_subtitle: "装饰方块"
	quest.6D5FC3B862D27741.quest_desc: ["一块由下界合金加固的磁体，拥有最强的力和最远的范围——这是“新时代”磁体系列的巅峰之作。"]
	quest.6D5FC3B862D27741.quest_subtitle: "最强的磁体"
	quest.6D770F5E05CB1BF4.quest_desc: ["将其安装在控制台上，即可控制两个轴向上的俯仰和滚动。每个方向都通过独立的红石链接频率传输信号，其功率与操纵杆的位移相匹配。"]
	quest.6D770F5E05CB1BF4.quest_subtitle: "操纵杆模块是一个已安装的飞机操纵杆。"
	quest.6DE61A1D5AEE2153.quest_desc: ["它的工作原理与标准轮胎完全相同——只是颜色不同。将轮胎与白色染料一同合成即可制作。"]
	quest.6DE61A1D5AEE2153.quest_subtitle: "一个染成白色的轮胎。"
	quest.6DE8ACA4F08C420E.quest_desc: ["在保持两个网络独立的同时，将一个网络的应力承载能力转移到另一个网络。它能保证当目标网络过载时，源网络不会受到影响。"]
	quest.6DFDDCD9C698FB1D.quest_subtitle: "装饰方块"
	quest.6E033C8BD4724C99.quest_desc: ["它的功能与标准“怪物轮胎”完全相同——只是颜色不同。将蓝色染料与“怪物轮胎”一同合成即可制作。"]
	quest.6E033C8BD4724C99.quest_subtitle: "一个染成蓝色的“怪物轮胎”。"
	quest.6E0B19BE3664D674.quest_subtitle: "装饰方块"
	quest.6E14453ED3BE0EE0.quest_desc: ["将其注入推进器，以保持推进器持续工作。按住 Shift 键可预览推力和燃烧率。"]
	quest.6E14453ED3BE0EE0.quest_subtitle: "松节油是为推进器提供动力的燃料。"
	quest.6E1BE7174F44D650.quest_desc: ["它的功能与标准“轮胎”完全相同——只是颜色不同。将浅灰色染料与“轮胎”一同合成即可制作。"]
	quest.6E1BE7174F44D650.quest_subtitle: "一个染成浅灰色的“轮胎”。"
	quest.6E2033C9979AEC0B.quest_desc: ["基础磁铁，也是“新时代”磁铁系列的起点，用于合成更强的磁铁和电子元件。"]
	quest.6E2033C9979AEC0B.quest_subtitle: "入门级磁铁"
	quest.6E3CE8CCE59764E6.quest_desc: ["带有对角线“斜切”的装饰面板，可用于为火车、车厢和车站增添色彩与细节。提供全部十六种染料颜色。"]
	quest.6E3CE8CCE59764E6.quest_subtitle: "装饰性火车面板"
	quest.6E4549AB2029BB05.quest_subtitle: "装饰方块"
	quest.6E4C87C949D196E1.quest_desc: ["在两个碾压轮之间碾压一根羽毛或任意“阿罗尔”"]
	quest.6E5EE3BD432FB23E.quest_desc: ["电子连接器可让你通过线路将设备连接到其他方块"]
	quest.6E5EE3BD432FB23E.quest_subtitle: "将设备接入你的电网"
	quest.6E6E53606F529491.quest_desc: ["一个圆柱形、类似锅炉的方块，用于建造蒸汽机车的车身。提供全部十六种染料颜色，以匹配你的涂装。"]
	quest.6E6E53606F529491.quest_subtitle: "装饰性锅炉方块"
	quest.6E8C6A4A07957E5A.quest_desc: [
		"当软管滑轮受到旋转力时，它可以无限伸长软管。反转旋转力则会使软管缩回方块处。软管滑轮必须先伸长至少一个方块才能开始工作。"
		""
		"软管需要配合流体泵才能排出或灌入液体。"
		""
		"-如果抽出流体，会将一片液体区域排空至软管所在的高度。如果多个软管滑轮从同一水源抽水，只要管道的容量足够，就能有效加快排水过程。"
		""
		"-如果灌入流体，则会淹没任意大小的房间，而软管的位置即为淹没的最高点。"
	]
	quest.6E8C6A4A07957E5A.quest_subtitle: "软管滑轮可以放下一根用于排空液体区域的软管。"
	quest.6EA6C44A8FBFCFD9.quest_desc: ["它的行为与 Levitite 完全相同。在结晶 Levitite 混合物时，将青色染料拿在副手即可合成。"]
	quest.6EA6C44A8FBFCFD9.quest_subtitle: "Levitite 的一种青色染色变体。"
	quest.6F6527213B0E0620.quest_subtitle: "装饰方块"
	quest.6F79A45B3B7C7922.quest_subtitle: "装饰方块"
	quest.6F8DCE5AA76BBABA.quest_desc: ["一块压制的锌板，是多种电子元件的合成材料。"]
	quest.6F8DCE5AA76BBABA.quest_subtitle: "合成组件。"
	quest.6FB3B725E195FEAC.quest_desc: ["它的功能与标准的小轮胎完全相同——只是颜色不同。将小轮胎与绿色染料一同合成即可。"]
	quest.6FB3B725E195FEAC.quest_subtitle: "绿色染色的小轮胎。"
	quest.6FE2FE40C2F60183.quest_desc: ["继电器可独立朝两个方向旋转。"]
	quest.6FFD93A35CC9EC5C.quest_subtitle: "装饰方块"
	quest.700F7947C77D45D5.quest_subtitle: "装饰方块"
	quest.70560303EAB0C0B2.quest_desc: ["放置在火炮底座下方并连接到网络后，它会自动调整火炮的俯仰角（上下瞄准角度），以对准选定的目标。"]
	quest.70560303EAB0C0B2.quest_subtitle: "控制火炮底座的仰角"
	quest.705C8ABB2339A5D5.quest_desc: ["按住右键可抓住方向盘，然后移动鼠标进行转动，从而提供精确的旋转输出。比较器可以读取其角度或是否正在使用中。"]
	quest.705C8ABB2339A5D5.quest_subtitle: "手动旋转控制"
	quest.705E20D143863DAB.quest_subtitle: "装饰方块"
	quest.707D6AB682807C7A.quest_subtitle: "装饰方块"
	quest.70B2D00A76DCDB5C.quest_desc: ["一种灵活的二极管，可根据配置好的序列输出精确计时的红石脉冲。"]
	quest.70F9706FF1886CB2.quest_desc: ["反应堆燃料插入器可让您将燃料插入反应堆。"]
	quest.70F9706FF1886CB2.quest_subtitle: "为反应堆供应燃料"
	quest.7157002074776C07.quest_desc: ["为导航台提供一个导航物品，它就会发射一个指向该目的地的红石信号——这是自动驾驶仪和航向指示器的基础。"]
	quest.7157002074776C07.quest_subtitle: "指示目的地的方向"
	quest.716864737F3D10B2.quest_desc: ["这些枪管可将燧发枪变成一支短程散弹枪。加长版牺牲部分散射范围，换取更远的射程。"]
	quest.716864737F3D10B2.quest_subtitle: "燧发枪散射枪管"
	quest.7191A49B5D5BF7B7.quest_desc: ["在由红石供能且使用松节油作为燃料时提供定向推力。这是一种简单的推进方式，可用于驱动装置移动。"]
	quest.7191A49B5D5BF7B7.quest_subtitle: "燃燃料定向推进器"
	quest.719218CEA358D540.quest_desc: ["右键点击地面，放置一条背向你的火车轨道。火车轨道可以朝八个不同方向放置，分别对应四个基本方向以及它们之间 45° 的增量。轨道也可以放置在上方没有方块紧挨着的方块侧面。这些轨道将具有 45° 的垂直坡度。使用任意镐子破坏轨道，或在潜行状态下用扳手右键点击即可破坏。使用任何其他物品破坏轨道将导致轨道消失。"]
	quest.719218CEA358D540.quest_subtitle: "火车轨道是用于支撑火车的特殊方块。"
	quest.71FB3EA8CB37A038.quest_desc: ["一种消耗品，用于烈焰燃烧器，使其能够燃烧液体燃料（例如生物乙醇或种子油）。"]
	quest.71FB3EA8CB37A038.quest_subtitle: "为烈焰燃烧器供应液体燃料"
	quest.720FCE76832BE25A.quest_subtitle: "装饰方块"
	quest.72237232F1B2318E.quest_desc: ["一顶经典的尖顶列车员帽，可作为帽子佩戴。列车员是“蒸汽与铁轨”的一大特色——而这顶帽子有各种颜色可供选择。"]
	quest.72237232F1B2318E.quest_subtitle: "可佩戴的列车员帽"
	quest.72243D5F4B43912B.quest_desc: ["它的工作原理与标准大轮胎完全相同——只是颜色不同。将大轮胎与黄色染料一同合成即可制作。"]
	quest.72243D5F4B43912B.quest_subtitle: "一个染成黄色的大轮胎。"
	quest.723479C71262BA85.quest_desc: ["A 带有对角“斜切”的装饰面板，可为火车、车厢和车站增添色彩与细节。提供全部十六种染料颜色。"]
	quest.723479C71262BA85.quest_subtitle: "装饰性火车面板"
	quest.727968EAA2864242.quest_desc: ["右键点击一个装有空的“区块加载器”的恶魂即可捕获它。"]
	quest.7283D2C2EED00F55.quest_desc: ["其工作原理与标准的“怪物轮胎”完全相同——只是颜色发生了变化。将灰色染料与“怪物轮胎”一同制作即可。"]
	quest.7283D2C2EED00F55.quest_subtitle: "一个染成灰色的“怪物轮胎”。"
	quest.72A6685CACCD207B.quest_desc: ["加特林子弹可为旋转枪管供弹。“穿透”变体牺牲部分冲击力，换取了穿透护甲的能力。"]
	quest.72A6685CACCD207B.quest_subtitle: "加特林弹药"
	quest.7322A19FDA5B78E1.quest_desc: ["“阀门手柄”的功能与“手摇曲柄”非常相似，但单次使用时其旋转的幅度和方向可以在“数值设置界面”中进行调整。"]
	quest.732D1A96512F2BFD.quest_desc: [
		"“蒸汽机”是一种可提供“旋转力”的方块。在所有生存模式的发电方块中，它的“应力单位”（SU）输出容量最高。它能将“流体箱”中加热水所产生的压力转化为“旋转力”，从而实现大规模的物品生产，并为多个 &3机械装置&r 提供动力。"
		""
		"蒸汽机使用被加热的水来获取动力，并放置在流体储罐上，储罐可用作锅炉。可以在蒸汽机上安装一根轴来产生动能输出。该输出的方向可通过蒸汽机侧面的数值设置进行调整。"
		""
		"要提高总发电量，就需要提升流体储罐锅炉的三个特性（热量、大小、水量）中的一个或多个。这会将锅炉的等级提升至这三个特性中达到的最低等级，从而提高蒸汽机可从该锅炉生成的最大 SU 量。单个蒸汽机最多只能提取 16,384 SU（相当于 1 个锅炉等级）。为了解决这个问题，可以将多个蒸汽机连接到同一个锅炉上以提取更多动力；但这并不会增加锅炉产生的总发电量。"
		""
		""
		"锅炉的尺寸是蒸汽锅炉的基本特性。所需尺寸会受到供热量的影响。对于无动力蒸汽机（0 级），锅炉必须是一个 2x2 的流体储罐，高度最好为一个方块（再高会浪费资源）。对于动力蒸汽机（1 级或更高），锅炉必须每级热量配备 4 个方块。例如，1 级锅炉的储罐必须由至少 4 个流体储罐方块构成，9 级锅炉必须由至少 36 个方块构成，而 18 级锅炉（可达最高等级）则必须由至少 72 个方块构成。"
		""
		""
		"蒸汽锅炉需要热量才能运行。热源必须放置在锅炉储罐下方才能对其产生影响。所有无动力热源产生的热量相同。借助烈焰燃烧器可以产生更多热量，其产生的热量会根据状态而变化。"
	]
	quest.732D1A96512F2BFD.quest_subtitle: "蒸汽机是一种能够提供旋转力的方块。"
	quest.734E4CFD2426E4F4.quest_desc: ["可以使用热管来传播热量。"]
	quest.734E4CFD2426E4F4.quest_subtitle: "在方块之间传递热量"
	quest.73D645ADC3165165.quest_desc: [
		""
		"[ { \"text\": \"创建动力装载机\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"727968EAA2864242\" } } ]"
	]
	quest.73DA0AB42872978D.quest_desc: ["选择一段铁轨，然后在附近放置一个道岔，以控制经过其标记处的列车。用它可将路线导向右侧，或悄悄使用将其导向左侧。"]
	quest.73DA0AB42872978D.quest_subtitle: "红石控制的铁轨岔路口"
	quest.73F308184A32F95D.quest_desc: [
		""
		"[ { \"text\": \"制作工艺品与附加件\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"43E4EE94BB396A7C\" } } ]"
	]
	quest.7416CB3F773510C6.quest_desc: ["一块带有对角线“斜切”的装饰面板，可用于为列车、车厢和车站增添色彩与细节。提供全部十六种染料颜色。"]
	quest.7416CB3F773510C6.quest_subtitle: "列车装饰面板"
	quest.7417FEE6B105B0E2.quest_subtitle: "装饰方块"
	quest.743C84D1D94C5670.quest_subtitle: "黄铜漏斗是一种可以从物品栏中取出或向其中放入物品的方块。"
	quest.745A055A8E60444F.quest_desc: [
		"实体方块目前存在漏洞，如果你建造并&n使用&r它，你的世界将会被摧毁。"
		""
		"&m右键点击带有温控器的液体储罐，可将其转换为分馏塔。"
		"&m用于将原油转化为各种资源。柴油可为你的烈焰燃烧器提供燃料。&r &m煤油可转化为乙烯，乙烯则可制成聚合物——一种用于制作高级枪械的新材料。&r&r"
	]
	quest.745A055A8E60444F.quest_subtitle: "&l&n&4存在漏洞，请勿建造&r&r&r"
	quest.745A055A8E60444F.title: "分馏塔"
	quest.74A7B0B9D9EB1B23.quest_desc: [
		"该灯具可通过红石脉冲激活。激活后，它们将持续发出红石信号。如果多个玫瑰石英灯相邻，激活其中一个灯具会使其他最远 16 格外的灯具关闭。它们发出的红石比较器信号强度取决于比较器与激活灯具之间的距离。"
		""
		"灯具也可以使用扳手手动切换。使用此方法，多个相邻的灯具可以同时处于开启状态。"
	]
	quest.74AD9C3B54878FDB.quest_desc: ["一种螺旋桨轴承，它会试图保持螺旋桨垂直向上，非常适合用于直升机和稳定重心偏高的建筑。红石信号可将其倾斜度重置为水平。"]
	quest.74AD9C3B54878FDB.quest_subtitle: "自动调平螺旋桨轴承"
	quest.74B9BA10EBDCAF89.quest_desc: ["将其安装在装置的任意位置并为其提供旋转能量。陀螺仪的稳定效果会随着输入转速（RPM）的提升而增强。可以使用多个陀螺仪来稳定更大的飞船！"]
	quest.74B9BA10EBDCAF89.quest_subtitle: "陀螺仪是一种旋转的飞轮，可使你的飞船在垂直方向上保持稳定。"
	quest.74C5CD7971637A60.quest_subtitle: "装饰方块"
	quest.74C6ABAB8291BC3B.quest_desc: ["通电后，会像红石中继器一样输出一个指定时间的红石脉冲。可通过长按右键进入其“值设置”界面来设定时间。信号持续时间可从 2 个游戏刻最长设置为 60 分钟。还可以使用剪贴板将设置复制并粘贴到其他延长器或脉冲中继器上。"]
	quest.74C8309747174D8C.quest_desc: ["霰弹枪的鼓形弹匣，可容纳更多弹壳，让你能在再次装填前持续开火更长时间。"]
	quest.74C8309747174D8C.quest_subtitle: "霰弹枪容量升级"
	quest.7524EFB1D33B92E0.quest_subtitle: "装饰方块"
	quest.752D65C71706BDE7.quest_subtitle: "装饰方块"
	quest.75383CA7EADFA8F5.quest_subtitle: "装饰方块"
	quest.7540DDBD4DB959BD.quest_subtitle: "装饰方块"
	quest.756E05D2EDB0D69E.quest_subtitle: "装饰方块"
	quest.75DDDB65930D90BB.quest_subtitle: "装饰方块"
	quest.763A7822DE6E05FA.quest_desc: [
		""
		"[ { \"text\": \"制造巨型加农炮\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"1C33870BEE8D21BA\" } } ]"
	]
	quest.7655E21D5CFB174C.quest_desc: ["在“奇物”栏的头部插槽装备“机械狼链接”即可召唤出狼。"]
	quest.766261AFB8BCC811.quest_desc: ["放置机翼以塑造空气动力学表面。淬火机翼是其更坚固的升级版本。"]
	quest.766261AFB8BCC811.quest_subtitle: "机翼可为你的飞行器提供升力和控制面。"
	quest.768789FEB6EBB8F8.quest_desc: [
		"烈焰燃烧器是一种加热组件，是某些混合配方所必需的。它可用于加热蒸汽机、批量熏制、批量熔炼，也可用作装饰性光源。"
		""
		"烈焰燃烧器内部必须有烈焰才能运作。要将烈焰放入空的烈焰燃烧器中，请在手持空烈焰燃烧器时右键点击烈焰。或者，也可以通过右键点击烈焰刷怪笼来为空烈焰燃烧器充能。此方法可以重复使用，而不会损坏烈焰刷怪笼。"
		""
		"用任何可用作熔炉燃料的物品右键点击烈焰燃烧器，会使其暂时进入加热状态。用烈焰蛋糕右键点击烈焰燃烧器，会使其暂时进入超加热状态。"
		""
		"烈焰内部的烈焰会根据所提供的燃料量改变其大小和纹理，并遵循以下阶段："
		""
		"阶段 1 — 余烬 — 无法为混合提供任何热量。这是放置燃烧器或燃料耗尽时的默认状态。"
		"阶段 2 — 加热/点燃 — 可解锁需要加热的配方。持续时间与燃料的燃烧时间相同，并为每个烈焰燃烧器为蒸汽机提供 1 个加热等级。"
		"阶段 3 — 超加热/沸腾 — 可解锁所有混合配方，并为每个烈焰燃烧器为蒸汽机提供 2 个加热等级。此状态只能通过使用烈焰蛋糕实现，且持续时间固定为 160 秒。在此阶段中，无法为烈焰燃烧器补充燃料。"
	]
	quest.76919513DA354DBC.quest_desc: [
		"齿轮箱可以在四个水平方向上传递旋转动力。其垂直版本（与标准版类似）则可以在四个垂直方向上传递动力。"
		""
		"当从任意输入侧（带有轴状结构的侧面）接收输入时，齿轮箱会以相反的旋转方向向所有其余侧面输出/传递&a旋转动力&r。换言之，当输入为顺时针时，其他3个侧面的输出将为逆时针，反之亦然。"
	]
	quest.76919513DA354DBC.quest_subtitle: "齿轮箱是一种用于在4个方向（水平或垂直）上传输旋转动力的方块。"
	quest.769EFC34C1F05AFC.quest_subtitle: "装饰方块"
	quest.76CF45AA7A6A107E.quest_desc: ["适用于日常使用的标准左轮手枪子弹，以及能够击穿护甲和击败更强大敌人的穿甲弹。"]
	quest.76CF45AA7A6A107E.quest_subtitle: "左轮手枪的弹药"
	quest.76E15279798C3BBB.quest_subtitle: "装饰方块"
	quest.7703F0CA1A8AB6F9.quest_desc: ["安山合金是用于制造安山合金外壳和《机械动力》模组中简单动能方块的一种材料。在众多用途中，它是制作轴以及普通和大型齿轮的必要原料。安山合金是《机械动力》模组中最基础的建造组件材料。"]
	quest.77538A08DA40D357.quest_desc: ["将大型齿轮与小型齿轮连接，从而改变你机械装置的速度。"]
	quest.7758A4AE497B0696.quest_desc: ["它的行为与 Levitite 完全相同。在结晶 Levitite 混合物时，手持粉色染料即可制作。"]
	quest.7758A4AE497B0696.quest_subtitle: "经过粉色染色的 Levitite 变体。"
	quest.7769B67962F5842E.quest_desc: ["[ { \"text\": \"创建蒸汽与铁轨\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"632C20063AEF5BE5\" } } ]"]
	quest.77B2C22D776D1B60.quest_desc: ["将 Forge 能量方块与低压电线连接，从而在整个建筑中传输能量。"]
	quest.77B2C22D776D1B60.quest_subtitle: "低压能量节点"
	quest.77C016A83AD73399.quest_desc: ["允许玩家控制黄铜无人机"]
	quest.77C3D285E52CCA0E.quest_desc: [""]
	quest.77C3D285E52CCA0E.quest_subtitle: "桌布可用于向其他玩家出售物品。"
	quest.77DB80B70AA648B9.quest_subtitle: "装饰方块"
	quest.77EAEEB36316F1D3.quest_desc: ["它的行为与 Levitite 完全相同。在结晶 Levitite 混合物时，手持红色染料即可制作。"]
	quest.77EAEEB36316F1D3.quest_subtitle: "经过红色染色的 Levitite 变体。"
	quest.783A9F94A33BDA01.quest_desc: ["架式弩可提供远程支援"]
	quest.787735334C76F312.quest_subtitle: "装饰方块"
	quest.78E10AA674653EFE.quest_desc: ["激活一个路石即可将其添加到你的网络中，然后在已发现的路石之间传送——这是在飞机场和基地之间快速移动的好方法。"]
	quest.78E10AA674653EFE.quest_subtitle: "快速旅行锚点"
	quest.7917E75BBA3F0614.quest_desc: [
		"首先，在显示方块上使用显示链接进行链接。然后将其放置在将被读取的源方块上。虽然它可以链接到任何方块，但并非所有方块都能充当显示方块或源方块。"
		""
		"右键单击链接即可访问其界面。可通过此界面为输出文本添加额外标签。部分来源提供多种文本格式选项。接受界面设置后，显示链接上的绿灯将开始闪烁，表示信息正传输至显示方块。"
	]
	quest.7917E75BBA3F0614.quest_subtitle: "显示链接用于从一个方块获取信息，并将其发送至能够显示该信息的方块。"
	quest.791D998A97FB6138.quest_desc: [""]
	quest.791D998A97FB6138.quest_subtitle: "合成组件。"
	quest.7939BC69EF3BB4B4.quest_subtitle: "装饰方块"
	quest.794C0CD2DA500874.quest_desc: ["便携式引擎通过燃烧燃料产生旋转动力，为您的装置提供动力，而无需固定的动能连接。它可以双向运行，并能自动注入燃料。"]
	quest.794C0CD2DA500874.quest_subtitle: "紧凑型机载电源"
	quest.794ED2661B8E4621.quest_desc: ["允许玩家飞行、移动和游泳的速度更快。可配合水和燃料使用。"]
	quest.79820F087CB4B43D.quest_subtitle: "装饰方块"
	quest.7993CF479F55FB32.quest_subtitle: "装饰方块"
	quest.79E01F6906DA951A.quest_desc: ["自动为使用水的工具和护甲补充。"]
	quest.79EB7E0D64481D3E.quest_desc: ["其功能与标准的小轮胎完全相同——只是颜色不同。将小轮胎与浅灰色染料一同合成即可制作。"]
	quest.79EB7E0D64481D3E.quest_subtitle: "一个染成浅灰色的小轮胎。"
	quest.79ECE3A166EC3503.quest_desc: [
		""
		"[ { \"text\": \"创建新纪元\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4FDF302D1E8EFA59\" } } ]"
	]
	quest.7A5892B422756F95.quest_desc: ["使用部署器将缓冲器安装在底盘上。"]
	quest.7A9EC265305FC6D1.quest_desc: ["创建：枪械制造功能让你能够用枪架、枪膛、枪管和引擎来组装模块化枪械。打造一把武器，装入合适的弹药，再装上配件来改变它的射击方式。"]
	quest.7A9EC265305FC6D1.quest_subtitle: "亲手打造你的枪械，一件一件组装"
	quest.7AA7094E591A373B.quest_desc: ["一个四个面都朝同一方向旋转的齿轮箱"]
	quest.7AAB0FDFAB0979F3.quest_desc: ["蒸汽哨可以放置在流体储罐上。储罐下方必须有热源，哨子才能工作。它可以通过红石激活。手持哨子右键点击即可延长。哨子最多可以延长 12 次，每个八度音阶最多可演奏 13 个音符。使用扳手可以切换八度音阶；共有 3 个八度音阶可供选择。使用工程师护目镜可以查看当前音符。"]
	quest.7AAB0FDFAB0979F3.quest_subtitle: "蒸汽哨是一种由红石激活的音乐方块。"
	quest.7B1ED64FF75CBD29.quest_subtitle: "装饰方块"
	quest.7B58F7BBFA93F655.quest_subtitle: "装饰方块"
	quest.7B6E46D719CFB570.quest_desc: ["一个用于处理电线的空线轴。右键点击两个已连接的接头，即可移除它们的电线并将其卷回。"]
	quest.7B6E46D719CFB570.quest_subtitle: "可重复使用的线轴"
	quest.7B92C9925325A603.quest_subtitle: "装饰方块"
	quest.7B9EE1A765FB668A.quest_desc: ["[ { \"text\": \"工程师护目镜\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"3A2633B6030BBC52\" } } ]"]
	quest.7BD3E1592E06D507.quest_desc: ["放置雷达轴承，在其前方安装一个雷达接收器，然后添加碟形天线或餐盘。为轴承施加旋转力以驱动整个装置并开始扫描。"]
	quest.7BD3E1592E06D507.quest_subtitle: "旋转雷达以扫描区域"
	quest.7BF2DDD8FDAFECE4.quest_subtitle: "装饰方块"
	quest.7C074B5E2A0EAA63.quest_desc: [
		"要组装一列火车，火车必须至少有一套朝向火车站内创建火车时所处方向的控制器。如果需要非玩家驾驶员，则必须在控制器正后方放置一个烈焰燃烧器或座椅。"
		""
		"在火车上，右键点击火车控制器即可控制火车。此时玩家的常规移动操作将用于控制火车。再次使用控制器或潜行即可停车。在岔路口按住左或右键来选择路径。使用滚轮调节最高速度。按住跳跃键可靠近并对齐车站。如果安装了蒸汽汽笛，则按疾跑键即可鸣笛。"
	]
	quest.7C074B5E2A0EAA63.quest_subtitle: "制造火车时必须使用火车控制器。"
	quest.7C0D7726F7350FCB.quest_subtitle: "装饰方块"
	quest.7C5E7060FAB3A110.quest_desc: [
		"创建：Copycats+ 是一款适用于 Create 模组的 Minecraft 附加包，它将数个先前的“复制粘贴”模组的功能整合到了一个统一的包中。"
		""
		"它添加了一大系列可自定义的装饰方块和物品——即“仿制品”——这些物品会采用其他方块的纹理和属性，同时提供全新的形状和功能。"
	]
	quest.7C8B60D396CDAC80.quest_desc: ["任何火炮的核心部件。必须精心制作——任何瑕疵都可能导致发射时发生灾难性故障！"]
	quest.7C95B87737AE885F.quest_subtitle: "装饰方块"
	quest.7D795E76018CDBD5.quest_desc: ["使用部署器将排气管安装在底盘上。"]
	quest.7D8A6959DA3F5E94.quest_subtitle: "装饰方块"
	quest.7DBC2BE3FDC8A80F.quest_desc: ["它的功能与标准轮胎完全相同——只是颜色不同。将轮胎与橙色染料一同制作即可。"]
	quest.7DBC2BE3FDC8A80F.quest_subtitle: "一个染成橙色的轮胎。"
	quest.7DC0802DE8DAABE4.quest_desc: ["它的功能与标准巨型轮胎完全相同——只是颜色不同。将巨型轮胎与石灰染料一同制作即可。"]
	quest.7DC0802DE8DAABE4.quest_subtitle: "一个染成石灰色的巨型轮胎。"
	quest.7DF6FD2B69C8F93F.quest_desc: ["一个坚固的平台，能让火炮进行旋转和瞄准。它在提供稳定性的同时，还能精确调整火炮的仰角和方向。"]
	quest.7E1BCD3A6AE20348.quest_subtitle: "装饰方块"
	quest.7E2188DA059C8005.quest_desc: [
		"红石中继器可以长距离传输红石信号，并保持其红石信号强度。当被激活时，发送中继器会使具有匹配频率的接收红石中继器发出红石信号，且信号强度保持不变。接收器会输出从发送中继器接收到的最强红石信号强度。"
		""
		"右键点击链接的插槽并放入物品或方块即可更改频率。为两个频率插槽中的至少一个分配物品或方块后，红石链接只会向或从具有匹配频率插槽的链接发送或接收信号。"
	]
	quest.7E2188DA059C8005.quest_subtitle: "红石链接用于向其他链接发送和接收红石信号。"
	quest.7E7202497F167C39.quest_desc: ["与燃烧器类似，蒸汽排气口也能给气球充气——但充的是蒸汽，而且它需要热量、水和锅炉空间，就像蒸汽引擎一样。在红石供能下，多个排气口可以共用一个气球。"]
	quest.7E7202497F167C39.quest_subtitle: "蒸汽动力气球升降"
	quest.7E9F178C0647E20C.quest_desc: [
		"“创建动态村庄”是《Create》的一个附加模组，为村民新增了四种职业："
		""
		"- &6&n机械工程师&r&r -- 买卖《Create》的装置零件"
		""
		"- &6&n液压工程师&r&r -- 买卖《Create》的流体管理零件；如管道、水泵、潜水装备等。"
		""
		"- &n&6火车修理工&r&r -- 买卖《Create》的火车系统零件"
		""
		"- &n&6矿工&r&r -- 买卖《Create》的采矿设备以及矿物/金属"
	]
	quest.7EAE26D617139AA2.quest_desc: ["它的偏航和俯仰方式与普通矢量推进器相同，但燃烧的是泵入的液态燃料，而非使用FE。从下方泵入燃料并用红石控制节流。"]
	quest.7EAE26D617139AA2.quest_subtitle: "一种使用液态燃料的矢量推进器。"
	quest.7EB06EEB27C8DAD6.quest_subtitle: "装饰方块"
	quest.7EB37F2B215C10DC.quest_subtitle: "装饰方块"
	quest.7EBF1BA8E3CD24D5.quest_subtitle: "装饰方块"
	quest.7EC1397C6E9D7E2A.quest_desc: ["一种用于开采无限流体储罐（而非矿石脉）的机器。当它被放置在包含无限流体脉的区块中，并连接到旋转动力和管道后，便会持续生成流体。"]
	quest.7ECADAFE1A8EE5DF.quest_subtitle: "装饰方块"
	quest.7EEA09630CE62CE6.quest_desc: ["手持该物品时右键单击即可扫描区块，从而揭示可以放置开采机械的位置。"]
	quest.7EEA09630CE62CE6.quest_subtitle: "矿石脉探测器是一种用于在“Create 矿石挖掘”附加模组中寻找无限流体和矿石脉的工具。"
	quest.7EF33147EAB0130A.quest_desc: ["旋转轴承会连接到其前方的方块上，并在通电时将一个粘合组组装成模拟装置。旋转动力可以直接穿过它，而红石信号可以解锁它，使其自由旋转。"]
	quest.7EF33147EAB0130A.quest_subtitle: "用于模拟建筑的旋转支架"
	quest.7F121F8D77B8FBA0.quest_subtitle: "装饰方块"
	quest.7F5D32DA7E8D094F.quest_desc: ["[ { \"text\": \"离合器\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"35639D4A6DDF6FF9\" } } ]"]
	quest.7FB9E9293C962C34.quest_subtitle: "装饰方块"
	quest.7FBF4F777DFF824A.quest_desc: ["一种升级版的太阳能加热板，可以捕捉更多日光，比基础版本更快地产生热量。"]
	quest.7FBF4F777DFF824A.quest_subtitle: "更强大的太阳能集热器"
	quest.7FCD34A7D5FB6E71.quest_desc: ["它的工作原理与标准大轮胎完全相同——只是颜色不同。将大轮胎与紫色染料一同合成即可制作。"]
	quest.7FCD34A7D5FB6E71.quest_subtitle: "一个染成紫色的大轮胎。"
	quest.7FEAE5D507495637.quest_desc: ["陀螺仪可保持装置水平稳定，抵抗不必要的翻滚和俯仰。工程师护目镜会显示其当前的稳定状态。"]
	quest.7FEAE5D507495637.quest_subtitle: "自动稳定器方块"
