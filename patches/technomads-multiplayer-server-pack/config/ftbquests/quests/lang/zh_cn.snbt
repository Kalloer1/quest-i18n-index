		"&c&l警告：提交物品将永久消耗它们！"
		"&c完成该任务后，所有已提交的物品都将被销毁。"
	]
	quest.70DD2EA2DF66950E.title: "Waystone 囤积者 III"
	quest.732C92DE7120556C.quest_desc: [
