	quest.676D8795309F6F9D.title: "安山合金囤积者 I"
	quest.67CC865462075984.quest_desc: [
		"方向盘是飞行员控制俯仰、横滚、偏航和推力的接口。将其安装在飞行员视野清晰且易于安全操作的位置。"
	]
	quest.67CC865462075984.title: "飞行控制系统"
