	]
	quest.7AFC0C2F53658D22.title: "凋零骷髅杀手 III"
	quest.7D30205AB671CFD3.quest_desc: [
		"击败 500 名女巫。进度将自动为您的任务团队追踪。"
	]
	quest.7D30205AB671CFD3.title: "女巫猎人 V"
	quest.7D498EE4227A9E41.quest_desc: [
		"提交 64x 下界合金背包以完成此囤积挑战。"
		"&c&l警告：提交物品将永久消耗它们！"
		"&c完成该任务后，所有已提交的物品都将被销毁。"
	]
	quest.7D498EE4227A9E41.title: "下界合金背包囤积者 IV"
	quest.7DE076DE2AB0819B.quest_desc: [
		"提交 256x 铜锭以完成此囤积挑战。"
		"&c&l警告：提交物品将永久消耗它们！"
		"&c完成该任务后，所有已提交的物品都将被销毁。"
	]
	quest.7DE076DE2AB0819B.title: "铜锭囤积者 IV"
	quest.7E3CBD7D34F2EFD7.quest_desc: [
		"提交 1x Gyroscope 以完成此囤积挑战。"
		"&c&l警告：提交物品将永久消耗它们！"
		"&c完成该任务后，所有已提交的物品都将被销毁。"
	]
	quest.7E3CBD7D34F2EFD7.title: "Gyroscope Hoarder I"
	quest.7EF08D76F61AC196.quest_desc: [
		"猎杀5个铜傀儡。进度将自动为您的队伍追踪。"
	]
	quest.7EF08D76F61AC196.title: "铜傀儡猎人 II"
	quest.7F15BA24B1EBBB62.quest_desc: [
		"转速控制器可提供精确的RPM控制。仅在网络未超出其应力极限时，更快的速度才有用。"
	]
	quest.7F15BA24B1EBBB62.title: "旋转控制"
	quest.7F175A7561F8DC4E.quest_desc: [
		"提交 8x Waystone 以完成此囤积挑战。"
		"&c&l警告：提交物品将永久消耗它们！"
		"&c完成该任务后，所有已提交的物品都将被销毁。"
	]
	quest.7F175A7561F8DC4E.title: "Waystone 囤积者 II"
	quest.7F9B110D281D327B.quest_desc: [
		"机械工匠在相连的网格中形成配方。箭头必须将每种材料导向最终的合成台。"
	]
	quest.7F9B110D281D327B.title: "Sequential Fabrications"
	quest.6A11C0DE00000001.quest_desc: [
		"Create 会在游戏中解释其机器。悬停在 Create 物品上并按住 &6W&r 以打开其 Ponder 场景。当方块设置不清时，请使用 Ponder。"
	]
	quest.6A11C0DE00000001.title: "与 Ponder 一起学习"
	quest.6A11C0DE00000002.quest_desc: [
		"&6安山合金&r是Create的基础建筑材料。准备好足够的供应，因为竖井、齿轮、外壳和许多早期机器都依赖它。"
	]
	quest.6A11C0DE00000002.title: "你的第一块合金"
	quest.6A11C0DE00000003.quest_desc: [
		"&6水轮&r能将流动的水转化为旋转动力。将其置于稳定的水流中，并将传动轴连接到其轴心上。"
		"机械装置会关注旋转方向和速度，所以在扩展网络前请检查运动部件。"
	]
	quest.6A11C0DE00000003.title: "生成旋转方向"
	quest.6A11C0DE00000004.quest_desc: [
		"&6Shafts&r 沿直线传递旋转。 &6Cogwheels&r 在相邻轴之间传递旋转，并可改变其方向。"
		"佩戴工程师护目镜并看向网络，即可看到有用的机器信息。"
	]
	quest.6A11C0DE00000004.title: "移动电力装置 (Move the Power)"
	quest.6A11C0DE00000005.quest_desc: [
		"在&6Depot&r上方一格放置一个&6Mechanical Press&r，然后用传动轴为其供电。Depot上的物品现在可以被自动压制了。"
		"如果想在建好前查看布局，请将&6W&r悬停在按钮上。"
	]
	quest.6A11C0DE00000005.title: "建造一台压榨机"
	quest.6A11C0DE00000006.quest_desc: [
		"在两个对齐的传动轴之间使用&6机械传动带&r来运输物品。将传动带连接器应用到第一个传动轴，然后是第二个。"
		"传送带还能实现旋转，适合用于紧凑的早期工厂。"
	]
	quest.6A11C0DE00000006.title: "移动物品"
	quest.6A11C0DE00000007.quest_desc: [
		"&6Millstone&r 是一种简单的动力处理器，用于研磨材料。将其连接到旋转网络，并从上方投入物品。"
		"你现在已经了解 Create 的基本循环：产生动力、传输旋转、移动物品、处理物品。在 &6Rotational Power&r 中继续学习，建造更大的机器。"
	]
	quest.6A11C0DE00000007.title: "你的第一个工作室"
	task.0407468748670926.title: "保护你的建筑免受破坏"
	chapter.C419666DFCF9CB5B.title: "游牧者必备模组"
	chapter.BBD3AACC3D4E5F4B.title: "工业未来（Industrial Horizons）"
	chapter.D1553617C7E813FC.title: "铁路物流系统"
	chapter.55C4EE174EB3E982.title: "大师游牧者"
	chapter_group.DA6F45017148405D.title: "入门指南"
	chapter_group.A71658F53DB7299A.title: "创建工程学（Create Engineering）"
	chapter_group.20015D41C0ADE2D9.title: "游牧科技 (Nomadic Technology)"
	chapter_group.B0953DAFF12DFA41.title: "可选挑战"
	quest.FF0270BF7605CFB6.title: "阅读旋转信息"
	quest.FF0270BF7605CFB6.quest_desc: [
		"齿轮箱能让旋转绕过拐角，无需暴露的齿轮群。注意轴面：每个输出都有用，但相邻轴可能反向转动。"
		"使用 Ponder 和工程师护目镜预测方向后再连接机器。"
	]
	quest.CA178E2D2B7B9F15.title: "工厂动脉"
	quest.CA178E2D2B7B9F15.quest_desc: [
		"机械皮带既能传输物品，也能传递旋转动力。用皮带连接器连接两个平行轴，然后观察皮带运输货物的方向。"
	]
	quest.C85F0A1D207D93C7.title: "受控物流系统 (Controlled Logistics)"
	quest.C85F0A1D207D93C7.quest_desc: [
		"漏斗是创造工厂的大门。安山漏斗提供简单的输入和输出；过滤器和黄铜漏斗可添加精确控制。"
	]
	quest.3D487B29F2AD350D.title: "精密机械装置"
	quest.3D487B29F2AD350D.quest_desc: [
		"精密机械通过反复部署器步骤组装而成。它们能解锁更智能的机器，将工坊变为真正的工厂。"
		"研究物品，在建造前查看完整的序列组装循环。"
	]
	quest.7609BC9190BA3C63.title: "黄铜之手"
	quest.7609BC9190BA3C63.quest_desc: [
		"机械臂在仓库、传送带、水槽和物品栏之间移动过滤后的物品。为每个输出指定明确目的地；优雅的路线规划可防止工厂莫名堵塞。"
	]
	quest.E7EFEC0D3A839819.title: "经过工坊认证"
	quest.E7EFEC0D3A839819.quest_desc: [
		"你的工坊现已具备发电、加工、流体处理、物流、诊断和精密组装功能。"
		"在所有分支安全连接且网络未过载后，再检查此里程碑。前方是更广阔的天地和更艰巨的工程。"
	]
	task.826308F811C6DA66.title: "确认你的工坊已供电、已布线且运行稳定"
	quest.8D961D11CE0E9156.title: "清理机库"
	quest.8D961D11CE0E9156.quest_desc: [
		"组装载具前，请选择一个宽阔的领地建造区。将树木、屋顶、领地标记和不可替代的机器保持在发射包络线之外。"
		"标记一个水平的对接线，并为从多个方向接近留出空间。"
	]
	task.FC442AFD073F3E3D.title: "准备并认领一个安全的建造区域"
	quest.F33D48F13600B482.title: "一架能飞的船体"
	quest.F33D48F13600B482.quest_desc: [
		"建造连贯的框架，将控制装置安装在飞行员可及之处，将升力分布在质心周围，并保持推进系统与船体分离。"
		"仅在结构组装完毕且未遗漏关键方块后检查此项。"
	]
	task.4619DC5AB5293C62.title: "组装一个带有控制器、起落架和推进器的平衡船体"
	quest.85213CA62F11C3A1.title: "地面试炼"
	quest.85213CA62F11C3A1.quest_desc: [
		"在信任开阔天空前，先低功率测试转向、引擎响应、制动和拆解。无法平稳刹车的车辆不应发射。"
	]
	task.6A2A3CCDBBABAFDE.title: "完成低功耗控制和关机测试"
	quest.65F6F63C189593E8.title: "首次飞行"
	quest.65F6F63C189593E8.quest_desc: [
		"只抬起几块方块，保持稳定悬停，轻柔转向，并降落在预定区域内。带上扳手、备用方块和耐心。"
		"受控着陆才算数。陨石坑不过是野外研究罢了。"
	]
	task.E71AD8EB2EA5FD4F.title: "起飞、悬停、转向，然后安全着陆"
	quest.F8BAED6D8D8BF193.title: "返回港口"
	quest.F8BAED6D8D8BF193.quest_desc: [
		"练习从开阔地形接近你的船坞，提前减速，并在任何人开始维修或装载前固定好车辆。"
	]
	task.13F35E25205E7867.title: "停靠、固定、拆解并重新组装车辆"
	quest.CD14B3EC75135D66.title: "超越熟悉的天空 (Beyond the Familiar Sky)"
	quest.CD14B3EC75135D66.quest_desc: [
		"携带食物、工具、导航设备、备用零件和回家方法，完成一次长途探险。建立一个前哨基地，或带回一项有意义的发现。"
		"你不再测试机器了。你正过着游牧生活。"
	]
	task.701CDB55C1C58BA7.title: "完成一次提供的远程探险任务"
	quest.6EB0F7EB7BE2AF17.title: "轻装上阵，未雨绸缪"
	quest.6EB0F7EB7BE2AF17.quest_desc: [
		"游牧者靠出发前的规划生存。带上食物、工具、床、备用材料和回家的标记路线。"
	]
	task.6469AB5000ADB600.title: "离开出生点前请检查你的旅行包"
	quest.A4183F047AC9F8A0.title: "万物皆有口袋 (Everything Has a Pocket)"
	quest.A4183F047AC9F8A0.quest_desc: [
		"精致背包能将维修物资和探险战利品与快捷栏分开。逐步升级，而非一次性携带整个基地的物品。"
	]
	quest.34FD2ABA3C14F1E9.title: "阅读活生生的世界 Living World"
	quest.34FD2ABA3C14F1E9.quest_desc: [
		"自然罗盘可以定位生物群系。用它来寻找资源和景观，而不是在危险的地形中盲目游荡。"
	]
	quest.05B838600882C4D5.title: "地平线上的遗迹"
	quest.05B838600882C4D5.quest_desc: [
		"探险家罗盘会搜寻结构。在进入未知区域前，请确认好你的补给和逃生路线。"
	]
	quest.304894EF2F56D71C.title: "锚定旅程"
	quest.304894EF2F56D71C.quest_desc: [
		"传送石连接着重要的定居点和工坊。请有意识地放置它们；一个有用的网络比散落在各地的孤立传送石更有价值。"
	]
	quest.EAAC276CE6744D16.title: "口袋里的道路 (A Road in Your Pocket)"
	quest.EAAC276CE6744D16.quest_desc: [
		"传送石可提供返回传送石网络的私人路线。请将其放在易取之处，而非埋在探险的战利品下。"
	]
	quest.7736108F13FA05A5.title: "荒野中的一束光"
	quest.7736108F13FA05A5.quest_desc: [
		"建立一个据点，包含住所、食物、标记的地图位置和安全的储物空间。这样即使你离开了，也能帮助下一个旅人。"
	]
	task.99FA9D07F96679B9.title: "建造并占领一个提供的野外前哨基地"
	quest.237F3106F2563DC6.title: "黄铜时代"
	quest.237F3106F2563DC6.quest_desc: [
		"黄铜标志着从简单机制到精密自动化的转变。建造一个加热混合器装置，让锌和铜的加工井然有序。"
	]
	quest.FB2881105EABC9D0.title: "被包含的热量"
	quest.FB2881105EABC9D0.quest_desc: [
		"烈焰燃烧器为盆底提供可控热量。注意高温区，留出安全空间进行喂食或升级。"
	]
	quest.BDD56B26911E92F2.title: "双手永不停歇"
	quest.BDD56B26911E92F2.quest_desc: [
		"机械臂在多个过滤输出共享紧凑空间时表现出色。用于定向路由，而非替代对线路的理解。"
	]
	quest.77905B59FFBAC6AF.title: "旋转至当前方向"
	quest.77905B59FFBAC6AF.quest_desc: [
		"Create Crafts & Additions 将旋转动力转化为电能。Alternator 应置于具有适当冗余容量的稳定网络中。"
	]
	quest.F1DE93D8C122862F.title: "储存风暴"
	quest.F1DE93D8C122862F.quest_desc: [
		"蓄电器在发电和需求之间缓冲电能。将储能视为缓冲空间，而非忽视发电不足的许可。"
	]
	quest.AE484830A62C5E1E.title: "磁性的雄心壮志"
	quest.AE484830A62C5E1E.quest_desc: [
		"发电机线圈开启了创造：新纪元的电力系统。保持电线清晰、有记录，并与移动装置隔离。"
	]
	quest.1DB584DC89792E39.title: "当前正在运动中"
	quest.1DB584DC89792E39.quest_desc: [
		"基础马达将电能转化为旋转，正好在需要的位置完成闭环。"
	]
	quest.800AD8D95B31A576.title: "便携式马力装置"
	quest.800AD8D95B31A576.quest_desc: [
		"柴油发动机为偏远工坊和车辆提供紧凑的旋转动力。确保燃料储存安全，并保持排气区域清洁。"
	]
	quest.BFBB017E32102FB8.title: "工业之心跳"
	quest.BFBB017E32102FB8.quest_desc: [
		"大型柴油发动机是一座重型发电厂。在依赖它之前，先建造燃料生产、储存、关闭接口和仪表系统。"
	]
	quest.8158AD2198E966F2.title: "已测量的力"
	quest.8158AD2198E966F2.quest_desc: [
		"制造大炮是重型工程，不是玩具。只在安全范围内建造炮台，了解弹药，切勿朝向已占用的家园进行测试。"
	]
	quest.49C1153BEC6C67D1.title: "钢铁之路"
	quest.49C1153BEC6C67D1.quest_desc: [
		"将轨道转弯距离纳入基础设施规划。勘测平缓路线，尊重所有权，避免让所有列车都通过单一瓶颈。"
	]
	quest.B78C1A13C06AEDF3.title: "一个有名字的地方"
	quest.B78C1A13C06AEDF3.quest_desc: [
		"火车站会组装火车并定义目的地。为月台、信号机和货运机械留出足够的扩展空间。"
	]
	quest.74E673498AD2FCAF.title: "书面命令"
	quest.74E673498AD2FCAF.quest_desc: [
		"时刻表能让火车成为可靠的工人。从一个简单的路线开始，在增加更多目的地前，先满足每个停靠站的条件。"
	]
	quest.1014148013E69DB9.title: "两条轨道，一个方块，不可共存"
	quest.1014148013E69DB9.quest_desc: [
		"轨道信号机将铁路分为受保护区间。故意向两个方向发出信号，并以低速测试交叉点。"
	]
	quest.7F5F908B0CD66D4C.title: "无需双手的货物搬运"
	quest.7F5F908B0CD66D4C.quest_desc: [
		"便携式存储接口在装置静止时传输物品。对齐两端，给火车时间交换货物。"
	]
	quest.29C9D94B3272B33C.title: "货运容量"
	quest.29C9D94B3272B33C.quest_desc: [
		"物品宝库提供密集且适合自动化的货物存储。使用过滤器，让成功的交付不再变成卸载难题。"
	]
	quest.319A221765E94BD2.title: "游牧快线"
	quest.319A221765E94BD2.quest_desc: [
		"在两个有用的前哨基地之间完成一条自动化货运路线。它必须能自动装载、运输、卸载并返回，无需手动处理物品。"
		"铁路的完成不在于首列列车的运行，而在于其可靠性。"
	]
	task.6E0B1D62E7AD172B.title: "运行一个完全自动化的往返货运服务"
	quest.2B91E709E8801288.title: "Workshop Without Walls"
	quest.2B91E709E8801288.quest_desc: [
		"准备移动基地的后勤核心：大量存储、自动化处理，以及用于装载物资的安全转运点。"
	]
	quest.BA3C28712205A7EB.title: "为长途跋涉提供动力"
	quest.BA3C28712205A7EB.quest_desc: [
		"建造一个能支持远离家园的工坊的电源包。包含发电、缓冲能源、燃料和一个可访问的紧急停机装置。"
	]
	quest.C60EF5C88F552132.title: "永远知道回家的路 (Always Know the Way Home)"
	quest.C60EF5C88F552132.quest_desc: [
		"一次大师级的远征既需要本地导航，也需要战略性的归途路线。准备好一块路石锚和一个可用的铁路时刻表。"
	]
	quest.A17C083C909738CC.title: "天空的统御者"
	quest.A17C083C909738CC.quest_desc: [
		"证明基础飞行包已就绪：智能推进、驾驶控制和便携电源。"
	]
	quest.ECE48B2FC9BD315E.title: "天际堡垒 (The Skybound Citadel)"
	quest.ECE48B2FC9BD315E.quest_desc: [
		"将居住、导航、存储、加工、供电、维修接口和安全飞行整合成一个连贯的移动基地。"
		"它应该能经受住旅途的考验，因为它的设计周全，而不是因为飞行员带了足够的胶水。"
	]
	task.849111EB717A65B8.title: "完成并安全测试一个自给自足的移动基地"
	quest.E532CC97E385A264.title: "告别平坦的道路，迎接未知的挑战"
	quest.E532CC97E385A264.quest_desc: [
		"完成一个服务器规模的项目，帮助未来的游牧民：公共路线、物资齐全的哨站、安全港、贸易中心，或共享工程。"
		"最棒的移动基地并非逃离世界，而是与世界建立更多联系的方式。"
	]
	task.5057814654F033A2.title: "完成并记录一个有用的公共基础设施项目"
}
