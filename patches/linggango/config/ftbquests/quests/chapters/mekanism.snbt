			}]
			title: "<shadow a=0.4><grad from=#4C9BD6 to=#C2E2FF f=0.6>锇压缩机</grad></shadow>"
			x: 4.0d
			y: 2.6d
		}
		{
			dependencies: ["3AACA62471C6A4B3"]
			description: [
				"## <grad from=#E0A64A to=#FFE0AC f=0.6><shadow a=0.3>万物归于尘土</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>土块变成 </grad><grad from=#E0A64A to=#FFE0AC f=0.8>脏土块</grad><grad from=#FFFFFF to=#C7C7C7>，锭变成土块，而鹅卵石变成砾石，再变成沙子。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>这是3x连锁的中间部分，还能悄悄永久解决你的沙子问题。</grad></shadow>"
