			title: "<shadow a=0.4><grad from=#F2C14E to=#FFE9AE f=0.6>生物发电机</grad></shadow>"
			x: 2.5d
			y: -4.2d
		}
		{
			dependencies: ["74200A48498DD7F8"]
			description: [
				"## <grad from=#F2C14E to=#FFE9AE f=0.6><shadow a=0.3>升级</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每秒消耗 </grad><grad from=#F2C14E to=#FFE9AE f=0.8>300</grad><grad from=#FFFFFF to=#C7C7C7> 能量，并储存 </grad><grad from=#F2C14E to=#FFE9AE f=0.8>200,000</grad><grad from=#FFFFFF to=#C7C7C7>。它占据三格高的空间，需要视野开阔的天空。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>大量堆叠这些可以构成一个真正可用的基础电源，而且完全不需要维护。</grad></shadow>"
			]
			id: "4EDD96EB60EF5814"
