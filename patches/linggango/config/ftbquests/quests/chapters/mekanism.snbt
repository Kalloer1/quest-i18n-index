				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#F2C14E to=#FFE9AE f=0.6>燃木取暖器</grad></shadow>"
			x: 25.0d
			y: 3.5d
		}
		{
			dependencies: ["783D70FEAC7A5099"]
			description: [
				"## <grad from=#F2C14E to=#FFE9AE f=0.6><shadow a=0.3>可调节的那个</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将能量转化为热能的效率为 </grad><grad from=#F2C14E to=#FFE9AE f=0.8>60%</grad><grad from=#FFFFFF to=#C7C7C7>，而抽取量则由你自行设定。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>比燃烧效率低，但更容易自动化，而且可以精确控制。</grad></shadow>"
			]
			id: "1427B2D2C24084BE"
