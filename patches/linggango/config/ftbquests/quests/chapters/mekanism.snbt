				}
			]
			shape: "hexagon"
			size: 1.3d
			subtitle: "<typewriter><grad from=#E0A64A to=#E0A64A>要么翻倍，要么一无所有</grad>"
			tasks: [{
				id: "1AE233B4CCFE99F7"
				item: "mekanism:enrichment_chamber"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E0A64A to=#FFE0AC f=0.6>富集室</grad></shadow>"
			x: 7.5d
			y: 0.0d
		}
		{
			dependencies: ["162CE44400A63575"]
			description: [
				"## <grad from=#4C9BD6 to=#C2E2FF f=0.6><shadow a=0.3>制作精炼金属</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将 </grad><grad from=#4C9BD6 to=#C2E2FF f=0.8>锇气</grad><grad from=#FFFFFF to=#C7C7C7>压缩成其他物品。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>黑曜石粉尘可制成 </grad><grad from=#4C9BD6 to=#C2E2FF f=0.8>精炼黑曜石锭</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>萤石粉可以炼成 </grad><grad from=#4C9BD6 to=#C2E2FF f=0.8>精炼萤石锭</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>锇气来自化学氧化器消耗锇锭，所以准备好一摞吧。</grad></shadow>"
			]
			id: "195729280394ABFB"
			rewards: [{
				id: "268A8495184348CE"
				type: "xp"
				xp: 10
			}]
			subtitle: "<typewriter><grad from=#4C9BD6 to=#4C9BD6>用气体把它压扁</grad>"
			tasks: [{
				id: "6934C61AFEB0443D"
				item: "mekanism:osmium_compressor"
