		{
			dependencies: ["4F436770D30D8520"]
			description: [
				"## <grad from=#7FE0B0 to=#D3FFE9 f=0.6><shadow a=0.3>将物品转化为化学品</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将固体蒸发成其气态形式。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#7FE0B0 to=#D3FFE9 f=0.8>硫磺粉</grad><grad from=#FFFFFF to=#C7C7C7>会变成二氧化硫，硫酸的开端。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#7FE0B0 to=#D3FFE9 f=0.8>盐</grad><grad from=#FFFFFF to=#C7C7C7> 变成了钠。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#7FE0B0 to=#D3FFE9 f=0.8>黄饼铀</grad><grad from=#FFFFFF to=#C7C7C7> 会变为 </grad><grad from=#7FE0B0 to=#D3FFE9 f=0.8>250</grad><grad from=#FFFFFF to=#C7C7C7> 氧化铀，核反应堆燃料链由此开始。</grad></shadow>"
			]
