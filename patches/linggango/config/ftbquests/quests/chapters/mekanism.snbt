			]
			subtitle: "<typewriter><grad from=#F2C14E to=#F2C14E>真正能成长的那个</grad></typewriter>"
			tasks: [{
				id: "2C13E8B67BC61E34"
				item: "mekanismgenerators:gas_burning_generator"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#F2C14E to=#FFE9AE f=0.6>燃气燃烧发电机</grad></shadow>"
			x: 2.5d
			y: -6.4d
		}
		{
			dependencies: ["27456841F48DF7C3"]
			description: [
				"## <grad from=#E0A64A to=#FFE0AC f=0.6><shadow a=0.3>酸处理</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一个矿石块加上 </grad><grad from=#E0A64A to=#FFE0AC f=0.8>1个氯化氢</grad><grad from=#FFFFFF to=#C7C7C7> 可以合成 </grad><grad from=#E0A64A to=#FFE0AC f=0.8>4个碎片</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它还能把煤炭变成</grad><grad from=#E0A64A to=#FFE0AC f=0.8>精炼煤炭，</grad><grad from=#FFFFFF to=#C7C7C7>把黑曜石粉尘变成</grad><grad from=#E0A64A to=#FFE0AC f=0.8>精炼黑曜石粉尘，</grad><grad from=#FFFFFF to=#C7C7C7>反正你都需要这两种东西。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>碎片并非终点。它们仍需经过提纯、粉碎和富集，才能成为锭块。</grad></shadow>"
			]
			id: "4F1C04C0F6769825"
			rewards: [
