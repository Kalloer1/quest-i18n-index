			y: -4.8d
		}
		{
			description: [
				"# <grad from=#3FA9C8 to=#B4EAF7 f=0.6><shadow a=0.3>欢迎来到机械动力模组世界</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Mekanism 是重头戏。矿石加工、气体化学、核裂变、核聚变、反物质，还有能飞的动力盔甲。所有这些都由你即将建造的少数几种机器构建而成。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>从这儿看它巨大无比。其实不然。你需要一种金属，一台启动一切的机器，然后一阶一阶地爬梯子。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#3FA9C8 to=#B4EAF7 f=0.6><shadow a=0.3>本章的结构安排</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你脚下这条</grad><grad from=#3FA9C8 to=#B4EAF7 f=0.8>矿脉</grad><grad from=#FFFFFF to=#C7C7C7>从左向右延伸，每块矿石最多可产出五个锭。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#3FA9C8 to=#B4EAF7 f=0.8>在上方，</grad><grad from=#FFFFFF to=#C7C7C7>是力量与电路。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#3FA9C8 to=#B4EAF7 f=0.8>下方</grad><grad from=#FFFFFF to=#C7C7C7>是化学、气体和塑料。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>再往下是</grad><grad from=#3FA9C8 to=#B4EAF7 f=0.8>等级梯子、机器升级和一些有用的方块。</grad><grad from=#FFFFFF to=#C7C7C7></grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#3FA9C8 to=#B4EAF7 f=0.6><shadow a=0.3>之后会发生什么</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>还有四个章节与此相关。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#3FA9C8 to=#B4EAF7 f=0.8>进阶内容</grad><grad from=#FFFFFF to=#C7C7C7>涵盖裂变、涡轮机、感应矩阵、聚变和反物质。</grad></shadow>"
				"{ \"text\": \"Open Mekanism: Advanced\", \"underlined\": \"true\", \"color\": \"#63D2FF\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"1608F5BC7B90120F\" } }"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#3FA9C8 to=#B4EAF7 f=0.8>齿轮</grad><grad from=#FFFFFF to=#C7C7C7> 覆盖了 MekaSuit、Meka-Tool 以及所有可以安装在它们上面的模块。</grad></shadow>"
				"{ \"text\": \"Open Mekanism: Gear\", \"underlined\": \"true\", \"color\": \"#63D2FF\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6D1A34C0FA2E7B85\" } }"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#3FA9C8 to=#B4EAF7 f=0.8>存储</grad><grad from=#FFFFFF to=#C7C7C7> 涵盖了量子物品网络和将气体接入ME系统的方法。</grad></shadow>"
				"{ \"text\": \"Open Mekanism: Storage\", \"underlined\": \"true\", \"color\": \"#63D2FF\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4B90E2D7C6153AF6\" } }"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#3FA9C8 to=#B4EAF7 f=0.8>Evolved Mekanism</grad><grad from=#FFFFFF to=#C7C7C7> 将模组中的每个等级都扩展了四步，超越了原版模组的终点。</grad></shadow>"
				"{ \"text\": \"Open Evolved Mekanism\", \"underlined\": \"true\", \"color\": \"#63D2FF\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"607FC85B97E241AE\" } }"
				""
				"[!tip] 从一块锇锭开始。其他一切都会随之而来。"
			]
			icon: "mekanism:basic_smelting_factory"
			id: "58B125BD4876054C"
