				}
			]
			shape: "gear"
			size: 1.3d
			subtitle: "<typewriter><grad from=#E0A64A to=#E0A64A>两个锭，一块石头</grad>"
			tasks: [{
				id: "405F38D749763F89"
				item: {
					Count: 1
					id: "itemfilters:or"
