			min_width: 360
			shape: "diamond"
			subtitle: "<typewriter><grad from=#F5C542 to=#F5C542>能自我修复至不可损坏的盔甲。</grad></typewriter>"
			tasks: [{
				id: "48E83B33624C6595"
