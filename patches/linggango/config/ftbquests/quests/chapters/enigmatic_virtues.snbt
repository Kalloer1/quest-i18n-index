			size: 1.5d
			subtitle: "<typewriter><grad from=#F5C542 to=#F5C542>唯一的出路。</grad>"
			tasks: [{
				id: "299660CA12F4CDF6"
				item: "covenant_of_the_seven:holy_stone"
