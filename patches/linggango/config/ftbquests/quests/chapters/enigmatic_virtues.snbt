			}]
			title: "<shadow a=0.4><grad from=#F5C542 to=#FFF4CF f=0.6>火焰圣事</grad></shadow>"
			x: -6.0d
			y: 3.0d
		}
		{
			dependencies: ["72680109513597DE"]
			description: [
				"## <grad from=#F5C542 to=#FFF4CF f=0.6><shadow a=0.3>向冰雪宣誓</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>森林仪式、沉睡圣礼、三个 </grad><grad from=#8FD6FF to=#4FA8E8 f=0.8>冰升级球体</grad><grad from=#FFFFFF to=#C7C7C7> 和四个无限之魂。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你受到的所有非</grad><grad from=#FFE9A8 to=#F5C542 f=0.8>冰</grad><grad from=#FFFFFF to=#C7C7C7>伤害都会转化为</grad><grad from=#FFE9A8 to=#F5C542 f=0.8>冰</grad><grad from=#FFFFFF to=#C7C7C7>伤害。</grad></shadow>"
				"[间隔=3]"
