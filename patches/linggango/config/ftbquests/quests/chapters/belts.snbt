			}]
			x: 0.5d
			y: 8.0d
		}
		{
			description: [
				"<shadow a=0.3><grad from=#2FB8B0 to=#A8F0EA f=0.8>镀金羽毛</grad><grad from=#FFFFFF to=#C7C7C7>、reverium 和 </grad><grad from=#2FB8B0 to=#A8F0EA f=0.8>大天使光环</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>光环从天而降，来自你向天空投掷不洁长矛所召唤的、拥有 </grad><grad from=#2FB8B0 to=#A8F0EA f=0.8>4000点生命值的 </grad><grad from=#FFFFFF to=#C7C7C7>天使 Virtue。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在依赖它之前，先读两次名字。</grad></shadow>"
			]
			id: "7E8902B03CF889FC"
			tasks: [{
				id: "4C89C4DAF84ADF6E"
				item: "terramity:fragile_divinity"
				type: "item"
			}]
			x: -3.5d
			y: 8.0d
		}
		{
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>来自</grad><grad from=#2FB8B0 to=#A8F0EA f=0.8>超级嗅探者</grad><grad from=#FFFFFF to=#C7C7C7>的掉落物。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Ultra pelt的暖场表演，而且更容易获得：Super Sniffer有</grad><grad from=#2FB8B0 to=#A8F0EA f=0.8>1500点生命值</grad><grad from=#FFFFFF to=#C7C7C7>，而Ultra则有</grad><grad from=#2FB8B0 to=#A8F0EA f=0.8>9001点</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
			]
			id: "32951D9B744E1713"
			tasks: [{
				id: "1D7F561F02CCECEB"
				item: "terramity:super_sniffers_pelt"
				type: "item"
			}]
			x: -0.5d
			y: 8.0d
		}
		{
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>按键盘上的 </grad><grad from=#2FB8B0 to=#A8F0EA f=0.8>V</grad><grad from=#FFFFFF to=#C7C7C7>键。你会朝所看方向短暂瞬移，片刻后你留下的位置会爆炸。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>同一个按钮，既能进攻又能逃跑，还是Terramity里最好的腰带。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它会从 </grad><grad from=#2FB8B0 to=#A8F0EA f=0.8>Ultra Sniffer</grad><grad from=#FFFFFF to=#C7C7C7>身上掉落，该生物有 </grad><grad from=#2FB8B0 to=#A8F0EA f=0.8>9001 生命值</grad><grad from=#FFFFFF to=#C7C7C7>，不建议招惹它。</grad></shadow>"
			]
