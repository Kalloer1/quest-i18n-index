				}
			]
			shape: "circle"
			size: 1.1d
			subtitle: "<typewriter><grad from=#C8AE86 to=#C8AE86>一摞绿宝石。</grad></typewriter>"
			tasks: [{
				count: 16L
				id: "0BE5B7FCA2AFB9C6"
				item: { Count: 16, id: "minecraft:emerald" }
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>挖掘另一面</grad></shadow>"
			x: 3.3d
			y: 3.6d
		}
		{
			dependencies: ["4DF93BC094C8F0C4"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>Sculk 亲和力</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>对抗深暗的最佳解药，却几乎没人酿造，因为模组从未提及它的存在。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>只要该效果生效，</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>你发出的任何振动都将在被听到前被丢弃，</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>并非减弱，也不是降低。而是丢弃。></grad></shadow>"
				""
				"[!success] 冲刺。破坏方块。打开箱子。投掷物品。站在你旁边的潜行者完全察觉不到任何动静。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>酿造它</shadow></grad>"
				""
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>Awkward Potion</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 加上 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Soul Crystal</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 会给出 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>3 分钟</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 的版本。"
				"[gap=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>隐身药水</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 加上 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>灵魂沙</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 也能得到 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>3分钟版</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，而且灵魂沙便宜得多。"
				"[间隔=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>长效隐身药水</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 加上 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>灵魂沙</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 直接跳到 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>8分钟版</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 本。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>或者用常规方法，给短的那根加 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>红石粉</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[!tip] 灵魂粉尘由潜声嗅探者和潜声吸虫掉落，并填充地下室箱子。它比另一个原料便宜得多，所以用隐身药水而不是笨拙药水来酿造。"
				""
				"[!info] 它能溅射和持续，所以你可以一次性让整个团队都处在效果中。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>它能让你免受潜声网络的探测，但无法让你免受眼睛的注视。任何正常捕猎的生物仍然会正常地捕猎你。</grad></shadow>"
			]
			icon: {
				Count: 1
				id: "minecraft:potion"
				tag: {
					Potion: "deeperdarker:sculk_affinity"
				}
			}
			id: "72599DEFB515D847"
			min_width: 340
			optional: true
			rewards: [
				{
					count: 6
					id: "7AA12C53C306E30A"
					item: "deeperdarker:soul_dust"
					type: "item"
				}
				{
					id: "4590A904B146C0AF"
					type: "xp"
					xp: 150
				}
			]
			shape: "circle"
			size: 1.05d
			subtitle: "<typewriter><grad from=#C8AE86 to=#C8AE86>瓶中的完全寂静</grad></typewriter>"
			tasks: [{
				id: "0881BE8615293072"
				item: {
					Count: 1
					id: "minecraft:potion"
					tag: {
						Potion: "deeperdarker:sculk_affinity"
					}
				}
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>潜行亲和药水</grad></shadow>"
			x: -3.4d
			y: 5.1d
		}
		{
			dependencies: ["3B1E28D454DCF8D4"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>远古花瓶</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>远古遗迹里到处都是它们，值得去挖掘，但最好先了解其中的概率。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>真正的几率</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>自然生成的花瓶会被标记为不安全。你打破的每个花瓶都有 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>16% 的几率</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>被设置陷阱，而被设置陷阱的花瓶会再次判定：</grad></shadow>"
				""
				"- <grad from=#FF7A7A to=#FF3C3C f=0.8>5 percent</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> of all vases spawn the </grad></shadow><grad from=#FF7A7A to=#FF3C3C f=0.8>Stalker</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>, which is a boss bar mini boss with 200 health.</grad></shadow>"
				"[gap=3]"
				"- <grad from=#FF7A7A to=#FF3C3C f=0.8>11 百分比</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>的陶罐会生成 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>1 到 3 个</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Sculk Leeches</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，它们很烦人，但并不危险。"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>另外 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>84 的百分比</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 会直接破坏，而且值得破坏。"
				""
				"[!info] 和平模式下不会生成任何生物，你放置的花瓶会永久标记为安全。你带回家的花瓶是装饰品，不是陷阱。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>掉落物</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>用</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>丝绸之触</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>来打破它，这样你就能保留花瓶本身，而且完全不会掉落任何东西。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>正常破坏可获得 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>1 至 2 卷</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>沙子、线、腐肉、铁、金、绿宝石、钻石、金苹果、附魔书，偶尔还有附魔金苹果或 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>坚守者外壳</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[!warn] 花瓶受重力影响。挖掘其下方的方块会使其掉落，掉落的花瓶即为破损花瓶，包括陷阱判定。"
			]
			icon: "deeperdarker:ancient_vase"
			id: "626B244E01EB57AB"
			min_width: 330
			optional: true
			rewards: [
				{
					exclude_from_claim_all: true
					id: "1F9ABF019555AB70"
					table_id: 4067690183644308744L
					type: "random"
				}
				{
					id: "2197E6DCC1011B02"
					type: "xp"
					xp: 100
				}
			]
			shape: "circle"
			size: 1.0d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>二十分之一是陷阱</grad>"
			tasks: [{
				id: "71E59F99DE575F47"
				item: "deeperdarker:ancient_vase"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#FF3C3C to=#FFAFAF f=0.6>远古花瓶</grad></shadow>"
			x: -1.5d
			y: 5.0d
		}
		{
			dependencies: ["626B244E01EB57AB"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>结晶琥珀</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>琥珀块遍布整个 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Overcast Columns</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，并出现在神庙宝箱中。每个自然生成的琥珀块内部都封印着物品。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>里面有什么</shadow></grad>"
				""
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>85 percent</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> of the time it is loot. Gold, iron, quartz, amethyst, sculk bone, soul dust, sometimes a diamond, rarely a diamond axe.</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>15% 的时间，它会是一只活体 </grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>斯库尔吸虫</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，破坏方块即可将其释放。"
				""
				"[!success] 内容取决于方块位置，而非开启时的随机。这意味着，在 Silk Touched 琥珀的提示框中，你就能看到开启前确切的内部物品。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>如何处理它</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>用</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>丝绸之触</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>来采集，这样方块会完好无损地随身携带，并且工具提示会显示名称。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>直接破坏它，就能获得物品，或者吸血植物，就在那里。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你放置的琥珀没有任何内容，也不会掉落特殊物品，所以不要把它当战利品来源来囤积。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>一面贴着标签的丝绸琥珀墙，是游戏中最便宜的战利品预览。只打破好的那些吧。</grad></shadow>"
			]
			icon: "deeperdarker:crystallized_amber"
			id: "72801D9E8C823717"
			min_width: 330
			optional: true
			rewards: [
				{
					count: 6
					id: "2DBD9818204AC0E4"
					item: "minecraft:amethyst_shard"
					type: "item"
				}
				{
					id: "352A97FF375175EC"
					type: "xp"
					xp: 100
				}
			]
			shape: "circle"
			size: 1.0d
			subtitle: "<typewriter><grad from=#C8AE86 to=#C8AE86>有东西被冻住了</grad>"
			tasks: [{
				id: "4C4AB9535C286B33"
				item: "deeperdarker:crystallized_amber"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>结晶琥珀</grad></shadow>"
			x: -3.4d
			y: 6.3d
		}
		{
			dependencies: ["1C89B122F8DF31FA"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>加固回响碎片</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>所有卫道士装备的升级材料，以及之后所有装备的修理材料。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>配方</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>合成配方，三乘三，一个碎片在外：</grad></shadow>"
				""
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>4</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>潜袭者甲壳</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，呈加号形状。</grad></shadow>"
				"[间隔=3]"
				"- 角落里的：<grad from=#FFC46B to=#FF9E1F f=0.8>4</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>幻影膜</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。"
				"[间隔=3]"
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>1</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Echo Shard</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，在中心位置。</grad></shadow>"
				""
				"[!warn] 每个碎片需要 `four` 个甲壳，每件装备需要 1 个碎片。一套完整的五件工具和四件盔甲需要 `36` 个守卫甲壳。在远古城市里搜寻战利品。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>它将去往何方</shadow></grad>"
				""
				"- 在锻造台旁，使用潜卫升级模板，制作每件潜卫工具和盔甲部件。"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>之后用铁砧修理那套装备。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>L2 补充玩家的回合 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>2</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 碎片、一个下界合金锭和潜卫骨碎片，合成 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>斯库尔金锭</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>回响碎片本身产自远古城市宝箱、远古神殿宝箱，以及用潜卫甲壳输入的Thermal粉碎器中。</grad></shadow>"
			]
			icon: "deeperdarker:reinforced_echo_shard"
			id: "6B06C18FE47C0AC0"
			min_width: 340
			rewards: [
				{
					count: 2
					id: "3BF5228946207D4B"
					item: "deeperdarker:reinforced_echo_shard"
					random_bonus: 2
					type: "item"
				}
				{
					id: "613EF5B8893B80E4"
					type: "xp"
					xp: 200
				}
			]
			shape: "hexagon"
			size: 1.3d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>一个碎片，一次升级。</grad>"
			tasks: [{
				count: 4L
				id: "1D0765244BAD0912"
				item: { Count: 4, id: "deeperdarker:reinforced_echo_shard" }
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#35FCF9 to=#BFFFFD f=0.6>加固回响碎片</grad></shadow>"
			x: 0.0d
			y: 7.8d
		}
		{
			dependencies: ["72801D9E8C823717"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>Sculk Jaw</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一个嵌入地板的嘴巴。 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>8</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它们会生成在每个潜声生物群系的每个区块中，并且看起来几乎和周围的地面一模一样。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>功能说明</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>踩上去会被咬，造成 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>3</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 点伤害。这部分影响不大。"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一口就能消耗掉</grad></shadow><grad from=#FF7A7A to=#FF3C3C f=0.8>整整四格饱食度</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。这可一点都不小呢。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>之后会进入一个 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>35 刻的</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>冷却时间，之后才能再次咬人。</grad></shadow>"
				""
				"[!success] 蹲下会让他们完全无视你。创造模式也一样。悄悄穿过一片颌骨原野，什么事都不会发生。"
				""
				"[!info] 潜声生物可以随意走过它们。下颌不会咬自己。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>收集其一</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Sculk Jaw 只会通过 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>丝绸之触</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>挖掘。用其他方式挖掘，该方块会直接消失。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>放置的颚会持续运作，使其成为服务器上任何玩家的真正恶心基地防御手段。</grad></shadow>"
			]
			icon: "deeperdarker:sculk_jaw"
			id: "48556DB7CB196DCD"
			min_width: 330
			optional: true
			rewards: [
				{
					count: 4
					id: "5F5C79D057065443"
					item: "deeperdarker:sculk_bone"
					type: "item"
				}
				{
					id: "4AD5427BF6725D0B"
					type: "xp"
					xp: 100
				}
			]
			shape: "circle"
			size: 1.0d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>地板是... 下颚！</grad></typewriter>"
			tasks: [{
				id: "365F3A8EA1C3985B"
				item: "deeperdarker:sculk_jaw"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#FF3C3C to=#FFAFAF f=0.6>Sculk Jaw</grad></shadow>"
			x: -3.4d
			y: 7.5d
		}
		{
			dependencies: ["1365482723D67C15"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>被感染的潜声菌</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每区块第二个陷阱群有另外 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>8</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 个，而且比下颚要糟糕得多。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>踏上一步</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>该方块变为普通的潜声方块。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你被击退，远离它。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>A </grad></shadow><grad from=#FF7A7A to=#FF3C3C f=0.8>尖叫蠕虫</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>从你站立的地面钻了出来。</grad></shadow>"
				""
				"[!danger] 尖叫蠕虫有 `100` 点生命，造成 `7` 点伤害，免疫击退，并能移动约五格。它无法移动，但被它困住后你同样无法动弹。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>打破第一关</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>用非</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>丝绸之触</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>和</grad></shadow><grad from=#FF7A7A to=#FF3C3C f=0.8>Sculk Leech</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>来破坏，反而会生成怪物，你什么也得不到。"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>用</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>丝绸之触</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>破坏它，它会悄悄掉落</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>普通潜声块</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，不会生成。被感染的方块本身永远不会掉落。</grad></shadow>"
				""
				"[!tip] 它的硬度是普通潜声菌的一半，所以比旁边的方块明显更快被破坏。如果一片潜声菌比预期挖得更快，请停下来。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>与下颚不同，这里蹲下并不能救你。触发方式是接触，而非噪音。</grad></shadow>"
			]
			icon: "deeperdarker:infested_sculk"
			id: "694286D235BA4998"
			min_width: 330
			optional: true
			rewards: [
				{
					exclude_from_claim_all: true
					id: "7593E0F0F4F85BCB"
					table_id: 4067690183644308744L
					type: "random"
				}
				{
					id: "1065268B64221567"
					type: "xp"
					xp: 100
				}
			]
			shape: "circle"
			size: 1.05d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>那个方块下面有东西。</grad>"
			tasks: [{
				icon: "deeperdarker:infested_sculk"
				id: "377AB36AC9854A5A"
				observe_type: 0
				timer: 0L
				title: "找到被感染的潜声方块"
				to_observe: "deeperdarker:infested_sculk"
				type: "observation"
			}]
			title: "<shadow a=0.4><grad from=#FF3C3C to=#FFAFAF f=0.6>被感染的潜声菌</grad></shadow>"
			x: 4.7250000000000005d
			y: 6.825d
		}
		{
			dependencies: ["62B6AD02F307A3FD"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>隔音玻璃</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>能隔绝振动的玻璃。一侧发生的事，另一侧全然不知。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>用十字形合成 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>4</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>灵魂粉尘</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 和 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>1</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>玻璃</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，用于 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>2</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 个方块。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>它真正的用途是什么</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>位于远古城市或深暗之地的基地，卫道士绝不会注意到你。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>密封一个生物农场，以保持其下方的潜声网络安静。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>使用Sculk传感器的任何红石装置中，声音不会外泄的窗户。</grad></shadow>"
				""
				"[!tip] 灵魂粉尘很便宜。潜声嗅探者和潜声吸虫都会掉落，远古遗迹的地下室箱子里也装满了。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>它的外观也很好看，这才是大多数人制作它的主要原因。</grad></shadow>"
			]
			icon: "deeperdarker:soundproof_glass"
			id: "1365482723D67C15"
			min_width: 330
			optional: true
			rewards: [
				{
					count: 8
					id: "4C4FF415EFB592AA"
					item: "deeperdarker:soundproof_glass"
					type: "item"
				}
				{
					id: "4B0720547CB44BDB"
					type: "xp"
					xp: 100
				}
			]
			shape: "circle"
			size: 1.05d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>在深暗之地内部建造。</grad>"
			tasks: [{
				count: 4L
				id: "178722122C710D61"
				item: { Count: 4, id: "deeperdarker:soundproof_glass" }
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#35FCF9 to=#BFFFFD f=0.6>隔音玻璃</grad></shadow>"
			x: 4.7250000000000005d
			y: 5.25d
		}
		{
			dependencies: ["0286461494ADF352"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>两组木材</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>另一个世界包含两种完整的木制家族，均为标准的原版风格套装，而非装饰方块。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>回声</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>回响森林</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>中，于</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>回响土壤</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>上生长。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>掉落物：</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>回响树苗，</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>这样你就能在主世界种下一片树林，再也不回来了。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>全套。原木、木材、去皮变种、木板、楼梯、半砖、栅栏、栅栏门、门、活板门、按钮、压力板、告示牌、悬挂告示牌、木船和木桶船。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>绽放</shadow></grad>"
				""
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>Blooming Stems</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 生长在 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Blooming Caverns</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 中。完全相同的套装，只是颜色要浅得多。"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>下方的发光藤蔓上长着 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>发光浆果</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，它们可以吃，有百分之八十的几率提供五秒的发光效果。</grad></shadow>"
				""
				"[!info] 两种木材都会燃烧。它们和主世界木材一样易燃，在斯库尔石上火焰永不熄灭的维度中，这一点值得牢记。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>和其他树叶方块一样，收集回声树叶需要剪刀或丝绸之触。</grad></shadow>"
			]
			icon: "deeperdarker:echo_planks"
			id: "62B6AD02F307A3FD"
			min_width: 330
			optional: true
			rewards: [
				{
					count: 2
					id: "6381F40217600E50"
					item: "deeperdarker:echo_sapling"
					type: "item"
				}
				{
					id: "7EBC809D9F95457B"
					type: "xp"
					xp: 100
				}
			]
			shape: "circle"
			size: 1.05d
			subtitle: "<typewriter><grad from=#D77BFF to=#D77BFF>两组完整的木材，没有阳光。</grad>"
			tasks: [
				{
					count: 8L
					id: "5814A0ABB6FFF7EB"
					item: { Count: 8, id: "deeperdarker:echo_planks" }
					type: "item"
				}
				{
					count: 8L
					id: "5D6EAB866B993C37"
					item: { Count: 8, id: "deeperdarker:bloom_planks" }
					type: "item"
				}
			]
			title: "<shadow a=0.4><grad from=#D77BFF to=#F3D6FF f=0.6>回响与绽放</grad></shadow>"
			x: 3.4d
			y: 5.1d
		}
		{
			dependencies: ["449CBD47F373F9E2"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>生物图鉴</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Deeper and Darker 添加了八个生物。其中两个是首领，已在本章上文介绍。其余六个如下所示。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每一个都算作一个 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>潜声生物</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，有三个值得记住的后果：</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它们对 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Sculk传感器、尖叫者和坚守者都是隐形的，可以穿过尖叫者群系而安然无恙。 </grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>A </grad></shadow><grad from=#9DB8D4 to=#5D7791 f=0.8>坚守者</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 无论它们做什么，都不会将任何一只作为目标。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>Sculk Smite</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 对所有生物造成的伤害每级增加 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>2.5</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，五级时最高可达 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>12.5</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，对其他生物则完全无效。</grad></shadow>"
				""
				"[!info] 在异次元中飞舞的幻影也被重新归类为潜声生物，纯粹是因为它们所处的位置。而同一只幻影在主世界则会变回不死生物。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"[!tip] 下面六个生物中，有两个活着的价值远高于死去的。在冲动地杀死它们之前，请先阅读关于潜声嗅探者的任务。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>潜行者和守卫是另外两个。本章更靠后的部分都有它们各自的专属任务。</grad></shadow>"
			]
			hide_dependency_lines: true
			icon: "deeperdarker:sculk_snapper_spawn_egg"
			id: "0D48B050E0ABDB4C"
			min_width: 340
			rewards: [{
				id: "522A472B3A773B94"
				type: "xp"
				xp: 100
			}]
			shape: "hexagon"
			size: 1.6d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>下面有八样东西在生存着……</grad></typewriter>"
			tasks: [{
				id: "202D70A39209A68E"
				title: "打开生物图鉴 bestiary"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#35FCF9 to=#BFFFFD f=0.6>异世界生物图鉴</grad></shadow>"
			x: 0.0d
			y: 9.2d
		}
		{
			dependencies: ["0D48B050E0ABDB4C"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>潜行苔藓</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>异世界的水面高度为 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>17</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，填充它的并非水。该高度以下的所有开放洞穴都填满了 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Sculk Grime</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>锁链</shadow></grad>"
				""
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>Grime Ball</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 是原始掉落物。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>四个可以合成一个 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Sculk Grime</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 方块。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>熔炼一个Grime Ball，你就能得到一块</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Grime Brick</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Grime Bricks 建造 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Sculk Grime Bricks</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，包含楼梯、半砖和墙壁。</grad></shadow>"
				""
				"[!info] 远古神庙的宝箱里装满了这两种物品。顶级宝箱每次会装有 `7 到 13` 块砖和 `8 到 18` 个球，所以你会有用不完的存货。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>这是本模组中少数没有陷阱、没有生物、也没有特殊机制的方块系列之一。只是一个漂亮的深色砖块。</grad></shadow>"
			]
			icon: "deeperdarker:sculk_grime"
			id: "2DCA1B45F0307FC8"
			min_width: 330
			optional: true
			rewards: [
				{
					count: 8
					id: "662A425CFC8834F0"
					item: "deeperdarker:grime_brick"
					type: "item"
				}
				{
					id: "1867CE65B7A05FD7"
					type: "xp"
					xp: 75
				}
			]
			shape: "circle"
			size: 1.0d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>一片没有水的维度之海。</grad></typewriter>"
			tasks: [{
				id: "436B42D53D1747F0"
				item: "deeperdarker:sculk_grime"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#35FCF9 to=#BFFFFD f=0.6>Grime</grad></shadow>"
			x: -1.5d
			y: 9.2d
		}
		{
			dependencies: ["0D48B050E0ABDB4C"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>远古画作</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>该模组添加了</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>七幅</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>画作，均由同一位艺术家创作，且行为方式与游戏中其他所有画作都不同。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>抽象、冒险、回归本源、云朵、回响者、千足虫和黏液怪。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>它们与众不同的原因</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>打破一幅画，它会掉落成一幅能记住自己原貌的</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>画作。原版画作掉落时会变成空白，再次悬挂会重新生成。</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7></grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>物品提示框显示标题、大小和艺术家名称的乱码文本。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>拾取方块也有效，所以你可以复制一个而无需费力寻找。</grad></shadow>"
				""
				"[!tip] 由于它们会保留身份，远古绘画是游戏中唯一可以安全移动的画作。取下你喜欢的那幅，然后把它放到你喜欢的任何地方。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>它们生成在远古神殿内部。注意观察墙壁，而不是跑过去。</grad></shadow>"
			]
			icon: "minecraft:painting"
			id: "685BD6F3413B1082"
			min_width: 330
			optional: true
			rewards: [
				{
					count: 4
