						Count: 1
						id: "minecraft:elytra"
						tag: {
							Damage: 0
						}
					}
					type: "item"
				}
			]
			shape: "octagon"
			size: 1.0d
			subtitle: "<typewriter><grad from=#9DB8D4 to=#9DB8D4>不需要持续烟花的翅膀</grad>"
			tasks: [{
				id: "7D40DD4D3E42FCC6"
