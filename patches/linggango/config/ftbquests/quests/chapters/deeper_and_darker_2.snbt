					xp: 75
				}
			]
			shape: "circle"
			size: 1.0d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>有七个，而且它们被隐藏起来了。</grad>"
			tasks: [{
				id: "0C74A5459C98F474"
				item: "minecraft:painting"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#35FCF9 to=#BFFFFD f=0.6>远古画作</grad></shadow>"
			x: 1.5d
			y: 9.2d
		}
		{
			dependencies: ["0D48B050E0ABDB4C"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>潜行者捕手</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>长着嘴当头的四足潜声生物。 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>12</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>生命值， </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>3</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>伤害，并且会主动攻击，除非你改变主意。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>是 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Deeplands</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 中最常见的生物，每群有 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>3 到 6 个，</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 也出现在森林和洞穴中。</grad></shadow>"
				""
				"[!warn] 它会掉落一个 `Soul Dust`。这就是杀死它的全部奖励，价值远低于活着的 Snapper 所能提供的。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>意义何在</shadow></grad>"
				""
				"可被驯服，驯服后的个体会无限生成附魔书。下方的任务将详细说明具体方法。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>作为潜声生物，潜声捕手走在潜声尖叫者上完全不会触发任何警报。这也让它们无法用作警报器。</grad></shadow>"
			]
			icon: "deeperdarker:sculk_snapper_spawn_egg"
			id: "2C266455E0764F44"
			min_width: 330
			rewards: [
				{
					count: 4
					id: "1AEBDC6CF236CFA7"
					item: "deeperdarker:soul_dust"
					type: "item"
				}
				{
					id: "771E0561F0210C20"
					type: "xp"
					xp: 100
				}
			]
			shape: "rsquare"
			size: 1.2d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>不要杀死这个！！</grad></typewriter>"
			tasks: [{
				entity: "deeperdarker:sculk_snapper"
				id: "237F4B317FBC8220"
				title: "杀死一只潜声嗅探者"
				type: "kill"
				value: 1L
			}]
			title: "<shadow a=0.4><grad from=#35FCF9 to=#BFFFFD f=0.6>Sculk Snapper</grad></shadow>"
			x: -3.5d
			y: 11.0d
		}
		{
			dependencies: ["2C266455E0764F44"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>书籍机器</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>这是整个模组里最值钱的东西，而且游戏里没有任何提示告诉你它的存在。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>驯服者</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>给野生的潜声嗅探者喂食一件</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>附魔的下界合金胸甲</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。不是书，也不是食物。一件带有至少一个附魔的真正下界合金胸甲。</grad></shadow>"
				""
				"[!warn] 是的，这很贵。这是一次性费用，胸甲会被消耗。在决定不值得之前，请先阅读你能获得的内容。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>驯服的河豚能做什么</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>驯服后，它的生命值会从</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>12</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>提升至</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>16</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它会跟随你，听从命令坐下，并像狼一样保护你。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>当它距离你 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>五格以内时，会随机掉落一本 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>随机的附魔书</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 在地上。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>附魔会从游戏中所有非诅咒附魔中随机选取，等级最高可达其最大值，并且有 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>20 的百分比</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 概率让书本获得一个 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>第二个</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 附魔。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在它旁边待上大约每</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>三分钟一本书的时长，</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>就能获得一本了。"
				""
				"[!danger] 本整合包中，每只 Snapper 最多掉落 `8` 本书，由 `snapperDropLimit` 设定。一旦产满八本，便不会再产。驯服多只吧。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>须知事项</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>喂食已驯服的河豚 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>任意附魔物品</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 它会立即完全恢复生命值。"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>击中它，或让其他东西击中它，会使其站起来并停止坐着。它不会解除驯服状态。</grad></shadow>"
				""
				"每只 Snapper 三分钟，八本书不到半小时。驯服四只并带回你的基地。"
			]
			icon: "minecraft:enchanted_book"
			id: "393A18C035D42E7F"
			min_width: 340
			rewards: [
				{
					id: "123448CAEEF8CA79"
					item: "minecraft:enchanted_book"
					type: "item"
				}
				{
					exclude_from_claim_all: true
					id: "6A0085B995C4A8AA"
					table_id: 523655846730814564L
					type: "random"
				}
				{
					id: "1FDB65A4CA990C1F"
					type: "xp"
					xp: 250
				}
			]
			shape: "hexagon"
			size: 1.0d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>会打印附魔书的宠物。</grad>"
			tasks: [{
				id: "308F67F709F942D0"
				title: "驯服一只潜声捕手"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#35FCF9 to=#BFFFFD f=0.6>驯服一只潜声嗅探者</grad></shadow>"
			x: -3.5d
			y: 12.0d
		}
		{
			dependencies: ["0D48B050E0ABDB4C"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>破碎的</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>“The Otherside”的标准重型单位。 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>50</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>生命值， </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>6</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>伤害， </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>3.5</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>护甲和仅有 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>10</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>格的追踪距离。 </grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它运行着与守卫者相同的振动监听器，</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>所以较短的追踪范围并不意味着它找不到你。发出噪音，它就会径直朝噪音走去。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>在哪里</shadow></grad>"
				""
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>回响森林</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 权重为 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>17</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，以 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>2 至 5 个</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 的群体形式存在。这就是它们的家园。"
				"[间隔=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>Deeplands</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 重量为 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>5</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，每 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>2 至 4</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 个一组。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>掉落物</shadow></grad>"
				""
				"<grad from=#FFC46B to=#FF9E1F f=0.8>1 至 3 个</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Sculk Bone</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，每次击杀掉落，Looting 可增加掉落量。Sculk Bone 是制作 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Sonorous Staff</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 和 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Soul Elytra</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 的主要材料。</grad></shadow>"
				""
				"[!tip] 在回响森林中匍匐前进，它们大多会忽略你。如果真的想要骨头，那就反过来，原地冲刺打转。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>破碎者不会攻击其他破碎者，并且会完全无视坚守者。</grad></shadow>"
			]
			icon: "deeperdarker:shattered_spawn_egg"
			id: "796F1BDA482D5C08"
			min_width: 330
			rewards: [
				{
					count: 6
					id: "521FA979725AA6CA"
					item: "deeperdarker:sculk_bone"
					type: "item"
				}
				{
					id: "324DAB980A7F62B9"
					type: "xp"
					xp: 100
				}
			]
			shape: "rsquare"
			size: 1.2d
			subtitle: "<typewriter><grad from=#9DB8D4 to=#9DB8D4>它的狩猎方式与坚守者如出一辙。</grad></typewriter>"
			tasks: [{
				entity: "deeperdarker:shattered"
				id: "738FBE4F6C447E0B"
				title: "击杀破碎者（Shattered）"
				type: "kill"
				value: 3L
			}]
			title: "<shadow a=0.4><grad from=#5D7791 to=#C6D8EA f=0.6>破碎的</grad></shadow>"
			x: -2.5d
			y: 11.0d
		}
		{
			dependencies: ["796F1BDA482D5C08"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>额外两个附魔</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Deeper and Darker 添加了两种附魔，在包含数百种附魔的整合包中，它们很容易被忽略。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>潜行者之怒</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>用于剑。最高等级 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>5</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每级对斯库尔生物造成的伤害增加 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>2.5</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。也就是说，在五级时，伤害为 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>12.5</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它会影响破碎者、追踪者、捕食者、蜈蚣、吸血者、尖叫蠕虫、彼岸幻影和</grad></shadow><grad from=#9DB8D4 to=#5D7791 f=0.8>坚守者</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>本身。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#FF7A7A to=#FF3C3C f=0.8>它对任何其他东西都完全没有任何作用</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。完全没有，一点不减。这是一把专用剑，不是通用剑。</grad></shadow>"
				""
				"[!tip] 此物品与Smite和Bane of Arthropods共用一个插槽。在本整合包中，使用专门的Sculk Smite之刃来对付Deep Dark生物是一种很有效的策略。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>催化作用</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>适用于剑和斧头，</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>最高等级为3，</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>是一种宝藏附魔，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>因此永远不会出现在附魔台上。"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>用它击杀的任何生物都会从尸体中蔓延出潜声，利用死去的生物的经验值作为燃料。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>3</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 每级扩散的游标和 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>8</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 每级扩散的步骤数，所以三级会有大量 sculk 生成。"
				"[间隔=3]"
				"- <grad from=#FF7A7A to=#FF3C3C f=0.8>该生物不掉落经验值</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。经验值是用来支付传播成本的。</grad></shadow>"
				""
				"[!warn] Catalysis会消耗你的经验值收入。用它来刻意建造sculk farm效果极佳，但对主武器来说却是负面效果。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>宝藏只能通过宝箱、钓鱼或与村民交易获得。驯服的潜声鲈能为你提供其中任何一种，因为它能携带游戏中所有非诅咒附魔的书籍。</grad></shadow>"
			]
			icon: "minecraft:enchanted_book"
			id: "561D446514E162A3"
			min_width: 340
			optional: true
			rewards: [
				{
					id: "080949BD70C3E32A"
					item: "minecraft:enchanted_book"
					type: "item"
				}
				{
					id: "5FB8903C739D6412"
					type: "xp"
					xp: 100
				}
			]
			shape: "hexagon"
			size: 1.0d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>大多数人从未见过的两种附魔。</grad>"
			tasks: [{
				id: "5445D22852FA98F6"
				title: "阅读附魔说明笔记"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#35FCF9 to=#BFFFFD f=0.6>Sculk Smite 与催化作用</grad></shadow>"
			x: -2.5d
			y: 12.0d
		}
		{
			dependencies: ["0D48B050E0ABDB4C"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>尖叫蠕虫</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>踩上地板后从地底冒出的生物，</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>被感染的潜声菌块</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。它绝不会在其他任何地方自然生成。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>数字们</shadow></grad>"
				""
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>100</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 生命值和 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>7</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 每次攻击的伤害。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#FF7A7A to=#FF3C3C f=0.8>移动速度 0</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。它会固定在出现的位置，无法跟随你移动一格。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#FF7A7A to=#FF3C3C f=0.8>免疫击退</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>也无法将其推出范围。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它的攻击距离约为</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>5</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>格，比模组中任何其他生物都长得多。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>需要 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>4 秒</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>才能出现，并且在上升期间无法攻击到你。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>应对方法</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>走开。认真的。它无法跟随，而且经过 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>10秒</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 内没有玩家在五格范围内，它就会睡觉并缩小。"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>想打的话，远程作战吧。它有100点生命值，而且完全防不住弓箭。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它算作潜声生物，所以 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>潜声重击</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>能迅速削减其生命条。</grad></shadow>"
				""
				"[!warn] 五格的攻击范围意味着安全距离比看起来更远。站在看似手臂加一格的距离内，仍然在其攻击范围内。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>它的掉落表没有必出物品。你杀死它是因为它挡路，而不是为了奖励。</grad></shadow>"
			]
			icon: "deeperdarker:shriek_worm_spawn_egg"
			id: "4A69CE12C67B1387"
			min_width: 330
			rewards: [
				{
					exclude_from_claim_all: true
					id: "5E584735F1E747B0"
					table_id: 4067690183644308744L
					type: "random"
				}
				{
					id: "361610C172BF4FFC"
					type: "xp"
					xp: 150
				}
			]
			shape: "rsquare"
			size: 1.2d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>它追不上你。它也不需要追你。</grad></typewriter>"
			tasks: [{
				entity: "deeperdarker:shriek_worm"
				id: "3622BC4DB169D2D0"
				title: "杀死一只尖叫蠕虫"
				type: "kill"
				value: 1L
			}]
			title: "<shadow a=0.4><grad from=#FF3C3C to=#FFAFAF f=0.6>尖叫蠕虫</grad></shadow>"
			x: -1.0d
			y: 11.0d
		}
		{
			dependencies: ["0D48B050E0ABDB4C"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>潜行者蜈蚣</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>成群结队地出现在 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Deeplands</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 的 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>1 到 4 只</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>20</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 生命值， </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>3</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 伤害。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>保持中立</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>蜈蚣不会主动攻击你。它使用与蜜蜂和僵尸猪灵相同的愤怒机制，这意味着它会怀恨在心，而且这种怨恨会传染。</grad></shadow>"
				""
				"[!warn] 打中一个，附近的所有同类都会立刻转而攻击你。在一条有四只的走廊里，意味着两头同时向你发起十二点伤害的挥击。"
				""
				"[!success] 怒气会随时间消退。只要脱离视线，等待片刻，它们就会恢复游荡状态。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>掉落物</shadow></grad>"
				""
				"<grad from=#FFC46B to=#FF9E1F f=0.8>0 to 1</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>String</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>, 外加抢夺。就是这样。没必要特意去打它。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>它们速度快，会攀爬，颜色和地板一样。它们存在的意义主要是让你受惊跳起。</grad></shadow>"
			]
			icon: "deeperdarker:sculk_centipede_spawn_egg"
			id: "679242449CA4BE07"
			min_width: 330
			rewards: [
				{
					count: 8
					id: "3E57A1866F47EAE8"
					item: "minecraft:string"
					type: "item"
				}
				{
					id: "0C731C626DCCCB42"
					type: "xp"
					xp: 75
				}
			]
			shape: "rsquare"
			size: 1.2d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>别惹它，它就不会惹你！</grad></typewriter>"
			tasks: [{
				entity: "deeperdarker:sculk_centipede"
				id: "1D84A0F5E7A7BC2E"
				title: "击杀潜行者蜈蚣"
				type: "kill"
				value: 2L
			}]
			title: "<shadow a=0.4><grad from=#35FCF9 to=#BFFFFD f=0.6>潜行者蜈蚣</grad></shadow>"
			x: 1.0d
			y: 11.0d
		}
		{
			dependencies: ["0D48B050E0ABDB4C"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>污泥</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>来自 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Blooming Caverns</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>的爬行生物，成群结队，数量为 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>1 至 2</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。它们有 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>16</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 点生命值和 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>4</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 点伤害，听起来很不起眼。"
				""
				"[!danger] 它的移动速度是 `0.6`。僵尸是 `0.23`，卫道士是 `0.35`，所以史莱姆比你遇到的任何东西都快。在开阔地带你跑不过它。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>你为什么要养殖它们</shadow></grad>"
				""
				"游戏中的唯一来源。共振器可通往：</grad></shadow><grad from=#7CF5C0 to=#2FD98A f=0.8>Resonarium</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>"
				""
				"- <grad from=#7CF5C0 to=#2FD98A f=0.8>共鸣板</grad><shadow a=0.3><grad from=#FFFFFF to=##C7C7C7>，四个共鸣物加四个贝壳。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#7CF5C0 to=#2FD98A f=0.8>共鸣器工具</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，钻石级，由铁制工具制成，无需模板。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#7CF5C0 to=#2FD98A f=0.8>共鸣盔甲</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，每件可减少非穿刺伤害的四分之一。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>用铁砧修复以上所有物品，每件原始共振器消耗最大耐久度的四分之一。</grad></shadow>"
				""
				"[!tip] 每次掉落 `0 到 1` 个，所以掉落率很低，这里的抢夺效果比其他任何地方都重要。带上抢夺 III。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>在一格宽的走廊里与它们战斗。在Blooming Caverns的开阔水池中，它们只会围着你转圈。</grad></shadow>"
			]
			icon: "deeperdarker:sludge_spawn_egg"
			id: "2C42BAF04EEB5FFC"
			min_width: 330
			rewards: [
				{
					count: 4
					id: "77F44E2349984D45"
					item: "deeperdarker:resonarium"
					type: "item"
				}
				{
					id: "6619F15632B20E11"
					type: "xp"
					xp: 100
				}
			]
			shape: "rsquare"
			size: 1.2d
			subtitle: "<typewriter><grad from=#2FD98A to=#2FD98A>比你快……大概吧。</grad></typewriter>"
			tasks: [{
				entity: "deeperdarker:sludge"
				id: "73C5214A3C2E82C0"
				title: "击杀史莱姆生物（Sludges）"
				type: "kill"
				value: 5L
			}]
			title: "<shadow a=0.4><grad from=#2FD98A to=#C8FFE4 f=0.6>污泥</grad></shadow>"
			x: 2.5d
			y: 11.0d
		}
		{
			dependencies: ["2C42BAF04EEB5FFC"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>共鸣板</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>整个Resonarium系列的升级物品，配方会让人感到意外。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>无定形，八个槽位：</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>4</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> </grad></shadow><grad from=#7CF5C0 to=#2FD98A f=0.8>共鸣器</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 加上 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>4</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>鳞甲</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。取出一块板。"
				""
				"[!warn] Scute 是海龟的甲片。在沙滩上搭建海龟繁殖设施前，你无法制作任何 Resonarium 装备，而每个护甲片需要四块甲片。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>一块牛排能买什么</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一个铁制工具，在锻造台与无模板的另一个铁制工具合成，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>就会得到该工具的共振器版本。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>盔甲也是如此。铁头盔加一块铁板就能变成共鸣头盔。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一套完整的五件工具和四件盔甲需要 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>9</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 个 Resonarium 和 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>36</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 个 Scute。"
				""
				"[!success] 模板槽必须保持`空`。如果你一直寻找共鸣器锻造模板，你永远也找不到，因为它根本不存在。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>小海龟长大后才会掉落龟壳，每只龟掉落一个。三十六只龟就算一个真正的龟农场了，所以要早点开始建造哦。</grad></shadow>"
			]
			icon: "deeperdarker:resonarium_plate"
			id: "45FB2B89D2DF1138"
			min_width: 330
			rewards: [
				{
					count: 2
					id: "4E76F8C8DA98D66B"
					item: "deeperdarker:resonarium_plate"
					type: "item"
				}
				{
					id: "2D4BC05F4319D8B3"
					type: "xp"
					xp: 150
				}
			]
			shape: "hexagon"
			size: 1.0d
			subtitle: "<typewriter><grad from=#2FD98A to=#2FD98A>四个史莱姆和四只海龟。</grad>"
			tasks: [{
				count: 2L
				id: "169BBC9F96BC0A8C"
				item: { Count: 2, id: "deeperdarker:resonarium_plate" }
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#2FD98A to=#C8FFE4 f=0.6>共鸣板</grad></shadow>"
			x: 2.5d
			y: 12.0d
		}
		{
			dependencies: ["0D48B050E0ABDB4C"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>钓鱼佬鱼</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>生成于 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Blooming Caverns</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>的水中，以 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>3 至 5 条</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>的群体出现。 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>6</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>点生命值， </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>3</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>点伤害，游速为 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>1.5</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[!warn] 六点血意味着一击必杀。问题从来不是鱼的数量，而是它们会一次性来五条，而你又在水下行动缓慢。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>说明</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它会像玩家一样捕食鳕鱼和鲑鱼，所以它不只是冲着玩家来的。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它会发光，这也是你在没有天空的维度里唯一能发现它的方法。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它不会掉落任何你需要的东西。这是一个危险，而不是资源。</grad></shadow>"
				""
				"[!tip] 不要游过Blooming Caverns的池子。用桥过去。底部没有任何值得冒险的东西。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>作为潜声生物，它和该模组中的其他一切一样，对潜声网络不可见。</grad></shadow>"
			]
			icon: "deeperdarker:angler_fish_spawn_egg"
			id: "7C53079DD6588E29"
			min_width: 330
			optional: true
			rewards: [{
				id: "0FC5B92CEB77249B"
				type: "xp"
				xp: 75
			}]
			shape: "rsquare"
			size: 1.2d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>水池并非空的。</grad></typewriter>"
			tasks: [{
				entity: "deeperdarker:angler_fish"
				id: "6A38CFC7D5777B4A"
				title: "击杀钓鱼佬鱼"
				type: "kill"
				value: 3L
			}]
			title: "<shadow a=0.4><grad from=#35FCF9 to=#BFFFFD f=0.6>钓鱼佬鱼</grad></shadow>"
			x: 3.5d
			y: 11.0d
		}
		{
			dependencies: [
				"44937B2D2EB38094"
				"055A7F2EA6A0CEB7"
			]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>不要停下，直面守卫者</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>卫道士装备优于下界合金，在Linggango中它也是一种材料。四个不同的模组将你的卫道士装备打造成更强大的物品。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>回声盔甲</shadow></grad>"
				""
				"复合材料的回声岩套装需要围绕一个卫道士盔甲部件制作。每个配方都需要将对应的卫道士部件放在中心，再加上回声岩锭和方块、腐化灵魂碎片、加固深板岩以及对应的阿莱钢部件。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>Sculkium</shadow></grad>"
				""
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>2</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Reinforced Echo Shard</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 加上一个下界合金锭和几个卫道士骨碎片可以制作出 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>2</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Sculkium Ingots</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每件 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Sculkium</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>盔甲部件都会用 Sculkium 锭包裹一件 Warden 盔甲部件。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>另外两种用途</shadow></grad>"
				""
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>4</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>潜袭者甲壳</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>、潜袭者之手、潜袭者之魂和一本铁质魔典可合成一本</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>残破魔典</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，用于铁质魔典系列。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Thermal </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Pulveriser</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将Warden Carapace转化为</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Echo Shards和骨粉，这是本整合包中获取Echo Shards最便宜的批量来源。</grad></shadow>"
				""
				"[!warn] 这些都会消耗掉一个 Warden 部件。请对你的 Warden 装备进行附魔，而升级用的部件则保持原样。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>守卫工具和守卫盔甲都属于下界合金层级，因此在下界合金守护者会将其封锁，在此之前这些都无关紧要。</grad></shadow>"
			]
