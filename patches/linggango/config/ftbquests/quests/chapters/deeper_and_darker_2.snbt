					tag: {
						Damage: 0
					}
				}
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#5D7791 to=#C6D8EA f=0.6>灵魂鞘翅</grad></shadow>"
			x: 2.0d
			y: 5.0d
		}
		{
			dependencies: ["7BA06C91408097F3"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>共鸣法杖</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一个工作台，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>2</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>灵魂水晶，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>2</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>潜声骨和</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>1</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>深海之心。是的，第二个之心。是的，这意味着第二个卫道士。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>按住右键蓄力，松开可发射声波束。它能穿透直线上的所有生物，并在遇到第一个实心方块时停止。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>蓄力曲线</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>伤害先急剧上升，随后趋于平缓。在目标正前方，满充能状态下的测量值：</grad></shadow>"
				""
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>1秒</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 造成约 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>9</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 点伤害，穿透 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>9</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 个方块。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>2秒</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 造成约 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>20</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 点伤害。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>3秒</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 造成约 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>35</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 点伤害，持续 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>12</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 格方块。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>4秒</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 造成约 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>44</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 点伤害。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>6.15秒</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 内造成的伤害上限为 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>50</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 点。也就是 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>25颗心</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 的伤害。"
				""
				"[!tip] 法杖充满后会发光，所以你无需计数。那闪光就是释放的信号。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>没人告诉你的两件事</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>伤害上限为六秒，但</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>射程没有上限</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。持续更久，光束会延伸得更远，最远可达</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>40</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>个方块。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>伤害随光束衰减。光束尽头的目标所受伤害约为</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>三分之二</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>脚边目标的伤害。</grad></shadow>"
				""
				"[!warn] 每次射击后都有 `1 秒` 的冷却时间，且每次射击都会消耗耐久度。请用灵魂水晶修复。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>光束还会将击中的所有物体推离你，但会根据它们的击退抗性进行减弱。</grad></shadow>"
			]
			id: "7C18745F2E5B8E64"
			min_width: 340
			rewards: [{
				id: "778F8C63379B8C6D"
				type: "xp"
				xp: 100
			}]
			shape: "octagon"
			size: 1.0d
			subtitle: "<typewriter><grad from=#9DB8D4 to=#9DB8D4>借用卫道士的绝招！</grad>"
			tasks: [{
				id: "3A5F7B7473A2021B"
				item: {
					Count: 1
					id: "deeperdarker:sonorous_staff"
					tag: {
						Damage: 0
						charged: 0b
					}
				}
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#5D7791 to=#C6D8EA f=0.6>共鸣法杖</grad></shadow>"
			x: 2.0d
			y: 6.0d
		}
		{
			dependencies: ["3B1E28D454DCF8D4"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>守卫者升级模板</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>这个锻造模板能将下界合金装备变为潜声守卫装备。没有配方能制作出第一个，所以你必须找到它。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>它来自两个地方</shadow></grad>"
				""
				"- 在主世界深暗之处的古代城市宝箱中，有 <grad from=#35FCF9 to=#12B7C4 f=0.8><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 45% 的概率 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 掉落。这是最简单的获取方式，完全不需要传送门。"
				"[间隔=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>远古神庙的隐藏宝箱</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>位于异世界，作为主池中的一个条目。</grad></shadow>"
				""
				"[!success] 拥有一个后，复制它。将模板放在中间，下面放 `1 Sculk`，其余用 `7 Diamonds` 填满，你就能得到 `2` 个回来。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>使用它</shadow></grad>"
				""
				"- 在锻造台处，将模板、<grad from=#FFFFFF to=#C7C7C7>下界合金装备，以及一个 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>强化回响碎片</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 组合起来。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它对所有下界合金工具、武器和盔甲都有效。</grad></shadow>"
				"[间隔=3]"
				"- 每次升级需要1个碎片。一套完整的工具和盔甲需要 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>九个</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>碎片，即 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>九个</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> Warden Carapace 和 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>九个</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> Echo Shards。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>建造传送门前，先好好搜刮远古城市。它会一次性给你模板和甲壳。</grad></shadow>"
			]
			icon_scale: 1.15d
			id: "1C89B122F8DF31FA"
			min_width: 340
			rewards: [{
				id: "216FB166083D9BE2"
				type: "xp"
				xp: 100
			}]
			shape: "circle"
			size: 1.3d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>通往顶级装备的钥匙。</grad></typewriter>"
			tasks: [{
				id: "09B87EE74D15AB2C"
				item: "deeperdarker:warden_upgrade_smithing_template"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#35FCF9 to=#BFFFFD f=0.6>守卫者升级模板</grad></shadow>"
			x: 0.0d
			y: 6.5d
		}
		{
			dependencies: ["3B1E28D454DCF8D4"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>潜行者</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一个合格的迷你Boss，也是唯一能稳定获得 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Soul Crystal</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>的方法。通过在Ancient Temple内打破一个被改装过的 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Ancient Vase</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>即可召唤它。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它会从地板升起，持续 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>3.5秒</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，在升起期间无法锁定任何目标。这就是你的免费攻击窗口期。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>数字们</shadow></grad>"
				""
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>200</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 生命值， </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>22</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 近战伤害， </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>4</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 护甲。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#FF7A7A to=#FF3C3C f=0.8>完全免疫击退效果</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。无法被推开、眩晕或用弓击退。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它通过振动来捕猎，就像坚守者一样，而且走得比看起来要快得多。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它被视为一种 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>潜声生物</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，因此 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>潜声重击</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>会对其生效，卫道士也永远不会帮助或猎捕它。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>定时戒指攻击</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一旦有玩家靠近，它就会以固定时钟运行，并造成致命伤害。距离为：</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>10</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>格以内。"
				""
				"1. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>大约 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>22 秒</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 它会像平常一样攻击你。没什么特别的。</grad></shadow>"
				"[gap=3]"
				"2. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>然后它会尖叫长达 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>10秒整</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。在此期间，在半径 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>10</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 格内的所有玩家都会受到 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>2</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 点伤害，且 </grad></shadow><grad from=#FF7A7A to=#FF3C3C f=0.8>每一刻都持续生效</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。"
				"[间隔=3]"
				"3. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在尖叫声中，它会生成5次，每次生成</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>1到3个</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Sculk Leeches</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>环绕自身。</grad></shadow>"
				"[间隔=3]"
				"4. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>然后时钟重置，循环重新开始。</grad></shadow>"
				""
				"[!danger] 每秒造成 2 点伤害，即 `40 点每秒`。在圈内待满十秒，会受到 400 点伤害。你拥有的任何东西都无法承受。"
				""
				"[!tip] 计数器只有在玩家附近时才会减少。走开十格以上，尖啸就不会再伤害你，你可以从容地取下吸血虫。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"[!success] 戒指是普通护甲，会受到伤害。一套完整的 `Resonarium` 套装可将伤害降至零，使这场战斗变成与无法击退你的生物进行的近战对决。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>掉落一个灵魂水晶，抢夺可增加掉落数量。制作法杖和鞘翅共需要四个。</grad></shadow>"
			]
			id: "7BA06C91408097F3"
			min_width: 340
			rewards: [{
				id: "26F992C4CA7BAEDF"
				type: "xp"
				xp: 100
			}]
			shape: "hexagon"
			size: 1.0d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>咕咚一声吞下</grad></typewriter>"
			tasks: [{
				entity: "deeperdarker:stalker"
				icon: {
					Count: 1
					id: "ftbquests:custom_icon"
					tag: {
						Icon: "armageddon_mod:item/wither_skull"
					}
				}
				id: "63C00D89D1700637"
				title: "击杀 &bThe Stalker&r"
				type: "kill"
				value: 1L
			}]
			title: "<shadow a=0.4><grad from=#FF3C3C to=#FFAFAF f=0.6>潜行者</grad></shadow>"
			x: 1.0d
			y: 5.5d
		}
		{
			dependencies: ["19D7DDEA580BBD3A"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>先搜刮，再战斗</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>大多数玩家走进远古城市，唤醒坚守者，然后就再也没回来。只要顺序正确，这座城市会免费送你本章的大部分内容。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>箱子里有什么</shadow></grad>"
				""
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>守卫者升级模板</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>45%</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每个箱子里。这就是整个顶级齿轮的关键所在。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>潜袭者甲壳</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 每个箱子掉落 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>20%</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。甲壳通常只从死去的潜袭者身上掉落。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>原版游戏里已有的东西都放进去了。附魔书、钻石装备、唱片。</grad></shadow>"
				""
				"[!success] 这两个都是通过 Deeper and Darker 的战利品修饰器添加的，因此会覆盖原版城市的战利品，而不是替换任何东西。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>活着出去</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Sculk Shrieker 在发出 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>四声</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>警告声后才会召唤 Warden，且计数器为每个 Shrieker 独立计算。"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>羊毛和苔藓能完全隔绝振动。扔一叠下去，然后踩上去走。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>蹲下时完全不会产生脚步声振动。慢走免费，冲刺不免费。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>投掷的雪球或箭的振动比你还大。利用这一点吧。</grad></shadow>"
				""
				"[!info] 城市中心还有一个加固深板岩框架。它与异世界传送门由同一种方块制成，你可以开采它。"
			]
			icon: "minecraft:sculk_catalyst"
			id: "7950A42E4F0D50D2"
			min_width: 330
			rewards: [
				{
					count: 4
					id: "1F8BD672565C13F0"
					item: "minecraft:echo_shard"
					type: "item"
				}
				{
					id: "194160287948EFDF"
					type: "xp"
					xp: 100
				}
			]
			shape: "pentagon"
			size: 1.15d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>在战斗前，先把它搜刮了。</grad></typewriter>"
			tasks: [{
				id: "1F2067E718B6EB8D"
				structure: "minecraft:ancient_city"
				title: "找到一个远古城市"
				type: "structure"
			}]
			title: "<shadow a=0.4><grad from=#35FCF9 to=#BFFFFD f=0.6>寻找一座远古城市</grad></shadow>"
			x: -1.6d
			y: 1.0d
		}
		{
			dependencies: ["19D7DDEA580BBD3A"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>框架方块</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>“The Otherside”传送门由</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>“Reinforced Deepslate”建造而成，而在原版中，该方块仅生成于远古城市，且完全没有合成配方。</grad></shadow>"
				""
				"[!success] Linggango 增加了一个。你不再局限于远古城市里可能包含的内容。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>配方</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在合成桌上合成，可制作一个方块：</grad></shadow>"
				""
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>4</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Warden 之手</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，位于角落处。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>2</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Deepslate Bricks</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>, 顶部和底部中间。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>2</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Warden Soul</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>, 左右中间。</grad></shadow>"
				"[间隔=3]"
				"- 中心位置放置一个<grad from=#FFC46B to=#FF9E1F f=0.8>1</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>深层岩柱</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[!warn] Warden Hand和Warden Soul都来自Warden。从头制作框架也需要杀死一个，所以挖掘城市框架仍然是更便宜的初始传送门。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>你需要多少</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>最小的合法传送门开口是 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>2x2</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。模组只检查侧面、地板和天花板，所以四个角可以完全忽略不计。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>框架内部最大可达21x21。虽然没必要，但模组允许你这样做。</grad></shadow>"
			]
			icon: "minecraft:reinforced_deepslate"
			id: "558862DBC8663EB4"
			min_width: 330
			rewards: [
				{
					count: 4
					id: "7C424FF344C10937"
					item: "minecraft:reinforced_deepslate"
					type: "item"
				}
				{
					id: "3E0B8FF62BBA8073"
					type: "xp"
					xp: 100
				}
			]
			shape: "pentagon"
			size: 1.15d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>可以制作！</grad></typewriter>"
			tasks: [{
				count: 4L
				id: "7F8577C08B143504"
				item: { Count: 4, id: "minecraft:reinforced_deepslate" }
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#35FCF9 to=#BFFFFD f=0.6>加固深板岩</grad></shadow>"
			x: 1.6d
			y: 1.0d
		}
		{
			dependencies: ["51EEA50609DFF126"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>守卫者甲壳</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>卫道士的甲壳，也是每件卫道士装备的瓶颈所在。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>所有源头</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>击杀一个坚守者。 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>每次击杀掉落1至3个，通过战利品修饰器保证掉落。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>远古城市宝箱，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>20 个物品中，</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每个宝箱有 1 个。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>异界的远古神殿宝箱。顶峰和地窖的宝箱都有，远古花瓶也可能掉落一个。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>它会变成什么</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>四块甲壳，四块 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>幻影膜，</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>和一块 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>回响碎片，</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>可制作一个 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>强化回响碎片，</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>热能玩家可以将它粉碎成</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>回响碎片</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>和骨粉。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>玩家需要4本铁质魔法书，才能换取一本</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>破损的书籍</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8></grad>"
				""
				"[!tip] 膜的成本是每个碎片四个，一个守卫最多能给你三个甲壳。在刷守卫前先刷幻影，否则你会卡住。"
			]
			icon: "deeperdarker:warden_carapace"
			id: "68D0DAE05569BBF5"
			min_width: 330
			rewards: [
				{
					count: 4
					id: "72AB8E875C96F24A"
					item: "minecraft:phantom_membrane"
					type: "item"
				}
				{
					id: "2830D3223873BFA7"
					type: "xp"
					xp: 150
				}
			]
			shape: "pentagon"
			size: 1.2d
			subtitle: "<typewriter><grad from=#9DB8D4 to=#9DB8D4>远古守卫者的外壳</grad>"
			tasks: [{
				count: 3L
				id: "78C76A657F49353D"
				item: { Count: 3, id: "deeperdarker:warden_carapace" }
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#5D7791 to=#C6D8EA f=0.6>卫道士甲壳</grad></shadow>"
			x: -2.6d
			y: 2.0d
		}
		{
			dependencies: ["51EEA50609DFF126"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>深海之心</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每杀死一个卫道士，必定掉落一个，无需随机判定或抢夺。它是进入该维度的钥匙，且只有卫道士会掉落。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>功能说明</shadow></grad>"
				""
				"- 右键点击一个完整的<strong>加固深板岩框架</strong>以打开<strong>另一面</strong>传送门。心脏将被消耗。"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它仅在 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>主世界</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>和 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>反面世界</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>中有效。在其他任何地方都完全无效。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它可以堆叠至 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>1</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 并且防火，所以熔岩死亡不会让你前功尽弃。"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它也是</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>共鸣法杖</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>的核心部件，因此大多数人最终会杀死两只卫道士。</grad></shadow>"
				""
				"[!info] 放在背包里会随机播放心跳声。配置里的 `wardenHeartPulses` 可以关掉这个声音，如果你觉得不安。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>传送门是双向的，但返程的传送门并未为你建造。请携带第二个心脏，或携带框架方块。</grad></shadow>"
			]
			icon: "deeperdarker:heart_of_the_deep"
			id: "1AE89B135F6107B0"
			min_width: 330
			rewards: [
				{
					exclude_from_claim_all: true
					id: "480BE30433E65BE2"
					table_id: 523655846730814564L
					type: "random"
				}
				{
					id: "6A4EA7B5294DD367"
					type: "xp"
					xp: 200
				}
			]
			shape: "star"
			size: 1.35d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>它还跳动着？！！</grad>"
			tasks: [{
				id: "5734383217D4AF05"
				item: "deeperdarker:heart_of_the_deep"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#35FCF9 to=#BFFFFD f=0.6>深海之心</grad></shadow>"
			x: 2.6d
			y: 2.0d
		}
		{
			dependencies: ["19D7DDEA580BBD3A"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>潜声如何听见你</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Sculk Sensors、Sculk Shriekers、Wardens、</grad></shadow><grad from=#9DB8D4 to=#5D7791 f=0.8>Shattered</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 和 </grad></shadow><grad from=#FF7A7A to=#FF3C3C f=0.8>Stalker</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 都使用相同的侦测系统。学会一次即可涵盖所有生物。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>变沉默的五种方法</shadow></grad>"
				""
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>蹲下</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>. 潜行时完全不会产生脚步振动。免费、常驻、随处可用。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>羊毛和苔藓</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。两者都能隔绝振动。穿过深暗的羊毛小径完全无声。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>潜行者靴子</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。它们带有“减弱振动”标签，会完全取消你的脚步声、落地声、游泳声和溅起声事件。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>Potion of Sculk Affinity</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>. 生效期间，你完全不会产生任何振动，无论何种类型。这是游戏中最强的选项。</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>no vibrations at all</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>, of any kind. It is the strongest option in the game.</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>隔音玻璃</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。一种能隔绝振动的方块，适合想在深暗生物群系中建造基地的玩家。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>无人知晓的规则</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>所有潜声生物都</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>对潜声网络不可见</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。它们的振动在发出声响前就被消除了。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>包括破碎者、潜行者、潜声嗅探者、蜈蚣、吸血蝙蝠、尖叫蠕虫、卫道士本身，以及</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>在异次元中四处飞舞的任何幻影生物，</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>都涵盖在内了。"
				""
				"[!success] 潜行者永远不会攻击潜行生物，潜行生物也永远不会触发尖叫者。如果你在潜行生物附近引发战斗，那么制造噪音的只有你。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>Sculk Smite 是对整个家族都有效的附魔，Sculk Smite V 能对其中的每一个造成 12.5 点额外伤害。</grad></shadow>"
			]
			hide_dependency_lines: true
			icon: "deeperdarker:sculk_gleam"
			id: "4DF93BC094C8F0C4"
			min_width: 340
			optional: true
			rewards: [{
				id: "36B9AD8F251D5286"
				type: "xp"
				xp: 75
			}]
			shape: "circle"
			size: 1.0d
			subtitle: "<typewriter><grad from=#C8AE86 to=#C8AE86>下面的一切都听从命令……</grad></typewriter>"
			tasks: [{
				id: "6C5CDABF354CB230"
				title: "学习如何保持安静的方法"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>振动</grad></shadow>"
			x: -3.3d
			y: 3.6d
		}
		{
			dependencies: ["1CCCCA7E20B877A7"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>异世界矿石台</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每个异世界群系都包含一整套矿石。三种群系中的潜声石矿石，</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>灰泥岩</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>矿石位于阴沉柱中，熔炼后会变成普通的原版材料。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每个区块的测量计数，包含矿脉大小和峰值高度：</grad></shadow>"
				""
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>Emerald</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>, </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>3</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 脉，大小 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>3</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，峰值接近 Y </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>7</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>钻石</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>3</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 个脉，大小 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>7</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，峰值在 Y 坐标 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>9</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 附近。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>金</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>6</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 条脉，大小 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>13</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，最底部最重。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>铁</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>6</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 个矿脉，大小 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>13</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，分布在 Y 坐标 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>76</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 左右。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>红石</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>4</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 个矿脉，大小 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>8</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，均匀分布在 Y 坐标 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>0</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 到 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>64</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 之间。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>青金石</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>4</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 个脉，大小 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>10</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，紧密环绕 Y 坐标 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>17</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 处。</grad></shadow>"
				"[gap=3]"
				"- <grad from=#FFC46B to=#FF9E1F f=0.8>煤炭</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>和</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>铜矿</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，都在高处，靠近天花板的位置。</grad></shadow>"
				""
				"[!success] 绿宝石是重点。主世界只在山脉中生成，每个矿脉一个方块。这里是`每个区块都有三个大小为三的矿脉`，遍布所有生物群系。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>实用建议</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在Y坐标8层开采钻石和绿宝石矿脉，同时享受双倍的乐趣！</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7></grad>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>下方 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>Y 17</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>的开阔洞穴空间填充着 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Sculk Grime</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，而非空气。向下挖掘缓慢，但绝对安全。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>阴沉的柱子上完全不会刷新怪物，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>在那里挖矿，永远不会被打扰。</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7></grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>财富在这些矿物上都能正常使用，冶炼后也会得到你熟悉的金属锭和宝石。</grad></shadow>"
			]
			icon: "deeperdarker:sculk_stone_emerald_ore"
			id: "5327C2EF322BA2B2"
			min_width: 340
			optional: true
			rewards: [
				{
