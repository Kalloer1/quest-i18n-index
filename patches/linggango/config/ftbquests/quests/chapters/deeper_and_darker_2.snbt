				id: "29A910D7FD1C8445"
				title: "击杀 &bThe Warden"
				type: "kill"
				value: 1L
			}]
			title: "<shadow a=0.4><grad from=#5D7791 to=#C6D8EA f=0.6>击杀坚守者</grad></shadow>"
			x: 0.0d
			y: 2.0d
		}
		{
			dependencies: ["51EEA50609DFF126"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>建造入口</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>“异面”传送门是一个由 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>“加固深板岩”</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>制成的框架，内部只有空气，用 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>“深海之心”</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>右键点击框架即可激活。"
				""
				"1. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>建造一个由 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>强化深板岩</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>组成的矩形。尺寸从 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>2x2</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 到 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>21x21</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 的内部测量值均可。"
				"[间隔=3]"
				"2. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将内部完全清空。 </grad></shadow><grad from=#FF7A7A to=#FF3C3C f=0.8>仅限空气</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>框架内的任何内容，如潜声脉、水、单个火把，都会导致无法点燃。</grad></shadow>"
				"[间隔=3]"
				"3. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>右键点击装有心脏的框架。心脏将被</grad></shadow><grad from=#FF7A7A to=#FF3C3C f=0.8>消耗掉</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[!warn] 心脏只有在 `Overworld` 或 `Otherside` 中有效。在 Nether、The End 或其他维度中尝试，将毫无反应。"
				""
				"[!info] 远古城市中心已经有一个加固深板岩框架。它不一定是合法的传送门形状，但它是免费的石头。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>那里的规则</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>世界是 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>128</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 格高，从 Y </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>0</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 到 Y </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>128</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，有实心天花板，没有天空。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>坐标是</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>1 到 1</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>与主世界一致。你在这里的立足点，就是你在主世界的立足点。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>时间定格在午夜，环境光强度为 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>0.05</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。携带光源或空手前往。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>A </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>床可以睡觉和设置重生点。A </grad></shadow><grad from=#FF7A7A to=#FF3C3C f=0.8>重生锚则不行。"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Y 坐标以下 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>17</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>洞穴里充满了 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Sculk Grime，而不是水。这就是一个没有海洋的维度的海平面。"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>火焰在潜声石和幽暗板岩上永远不会熄灭。反之亦然。</grad></shadow>"
				""
				"[!success] 传送门双向通行，系统不会自动生成返程传送门。请在两侧都建造框架，或携带第二个心脏。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>四个生物群系，一个结构，还有一个让主世界相形见绌的矿石分布表。此任务前后三个任务为引导任务。</grad></shadow>"
			]
			icon: "deeperdarker:smooth_sculk_stone"
			icon_scale: 1.3d
			id: "449CBD47F373F9E2"
			min_width: 340
			rewards: [{
				id: "53B316FFED1BF803"
				type: "xp"
				xp: 100
			}]
			shape: "hexagon"
			size: 1.5d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>向下是一个方向，而非极限。</grad>"
			tasks: [{
				dimension: "deeperdarker:otherside"
				icon: "deeperdarker:blooming_sculk_stone"
