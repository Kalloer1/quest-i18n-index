					xp: 100
				}
			]
			shape: "hexagon"
			size: 1.5d
			subtitle: "<typewriter><grad from=#9DB8D4 to=#9DB8D4>大个子男孩</grad>"
			tasks: [{
				entity: "minecraft:warden"
				icon: {
					Count: 1
					id: "hostilenetworks:data_model"
					tag: {
						data_model: {
							id: "hostilenetworks:warden"
						}
