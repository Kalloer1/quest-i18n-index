				type: "dimension"
			}]
			title: "<shadow a=0.4><grad from=#35FCF9 to=#BFFFFD f=0.6>进入异次元世界</grad></shadow>"
			x: 0.0d
			y: 3.5d
		}
		{
			dependencies: ["449CBD47F373F9E2"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>繁花洞穴</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>发光的植被、积水和苔藓取代了无尽的灰色。这是该维度中最友好的生物群系，也是唯一有食物生长的生物群系。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>这里住着什么</shadow></grad>"
				""
				"- <grad from=#7CF5C0 to=#2FD98A f=0.8>污泥</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，每包含有 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>1 至 2 个，</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>16 点生命，</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，4 点伤害，以及 </grad></shadow><grad from=#FF7A7A to=#FF3C3C f=0.8>0.6 的移动速度，</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，而僵尸是 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>0.23，</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。它们会掉落 </grad></shadow><grad from=#7CF5C0 to=#2FD98A f=0.8>共鸣器，</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。"
				"[间隔=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>Angler Fish</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 成群结队地出现在 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>3 到 5 个</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 水池里。 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>6</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 点生命值，游泳时才会遇到它们。"
				"[间隔=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>Sculk Snapper</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>, </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>1 to 2</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>. 见面即敌，详情见生物图鉴。驯服后可产出附魔书。</grad></shadow>"
				""
				"[!tip] `Bloom Berries` 长在发光藤蔓上。消耗两点饥饿，有百分之八十的几率获得五秒的 Glowing 效果，在没有天空的维度里，这相当于自带一个免费的追踪器。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>值得拾取</shadow></grad>"
				""
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>冰百合</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>. 不用丝绸之触破坏会保留底座但失去花朵。小心破坏带花的植株。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>Blooming Moss</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 和 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Bloom</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 木材，是一套完整的建筑套装，包含门、告示牌、船等所有物品。"
				"[间隔=3]"
				"- 从 Sludges 中获取 <grad from=#7CF5C0 to=#2FD98A f=0.8>Resonarium</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。四个 Resonarium 加四个 Scute 可以合成一个 Resonarium Plate，这便是一套完整的盔甲套装。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>史莱姆会接触伤害并比你跑得快。在走廊里战斗，切勿在开阔水域中作战。</grad></shadow>"
			]
			id: "0ED2EF4E6824B54A"
			min_width: 330
			rewards: [
				{
					count: 3
					id: "2715B632398EBAF1"
					item: "deeperdarker:resonarium_plate"
					type: "item"
				}
				{
					id: "15B6271A60ED0FDC"
					type: "xp"
					xp: 100
				}
			]
			shape: "diamond"
			size: 1.15d
			subtitle: "<typewriter><grad from=#5CF2A8 to=#5CF2A8>下面唯一看起来有生命力的地方。</grad></typewriter>"
			tasks: [{
				biome: "deeperdarker:blooming_caverns"
				icon: "deeperdarker:blooming_sculk_stone"
				id: "3DC19F5C997A0BDC"
				title: "探索 &b繁花洞穴"
				type: "biome"
			}]
			title: "<shadow a=0.4><grad from=#5CF2A8 to=#D6FFEC f=0.6>繁花洞穴</grad></shadow>"
			x: -1.5d
			y: 3.5d
		}
		{
			dependencies: ["449CBD47F373F9E2"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>深海地界</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>异界的默认生物群系，也是你最常降落的地方。潜声石地板、潜声石墙壁、潜声石天花板。</grad></shadow>"
				""
				"[!info] `Ancient Temple` 只会生成在这个生物群系中，别无他处。如果你在寻找神殿，那你就是在寻找深岩。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>这里住着什么</shadow></grad>"
				""
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>Sculk Snapper</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>, </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>每次3到6只，是这里最常见的生物，遥遥领先。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>Sculk 蜈蚣</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>, </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>1 至 4 个</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>. </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>20 点生命值。未被挑衅前中立，否则整个巢穴都会记住你。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#9DB8D4 to=#5D7791 f=0.8>破碎的</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>2 至 4 点</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>50 点</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 生命值，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>6 点</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 伤害，并通过振动进行捕猎。"
				"[间隔=3]"
				"- <grad from=#9DB8D4 to=#5D7791 f=0.8>幻影生物</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>1 至 2 个</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。在这里它们被算作潜声生物，这会改变能对它们造成伤害的东西。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>会咬人的两个方块</shadow></grad>"
				""
				"- <grad from=#FF7A7A to=#FF3C3C f=0.8>Sculk 颌骨</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，每区块有 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>8</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 个簇。踩上会扣除 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>3</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 点伤害和四点饥饿度。"
				"[间隔=3]"
				"- <grad from=#FF7A7A to=#FF3C3C f=0.8>被感染的潜声菌块</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，每区块有 8 个簇。踩上其中一个，就会有一只 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>尖叫蠕虫</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 从地板里钻出来。"
				""
				"[!warn] 两者看起来几乎和地板一模一样。潜行穿过深岩地带，两者都不会被触发。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>化石也生成于此，这是此维度中唯一能找到骨块的地方。</grad></shadow>"
			]
			icon: "deeperdarker:sculk_stone"
			id: "405AA569B7ACE9AB"
			min_width: 330
			rewards: [{
				id: "182AE7EC0D579C92"
				type: "xp"
				xp: 100
			}]
			shape: "diamond"
			size: 1.15d
			subtitle: "<typewriter><grad from=#BFC7C4 to=#BFC7C4>向每个方向潜行。</grad></typewriter>"
			tasks: [{
				biome: "deeperdarker:deeplands"
				icon: "deeperdarker:sculk_gleam"
				id: "58759106B2A3D11D"
				title: "探索 &fDeeplands"
				type: "biome"
			}]
			title: "<shadow a=0.4><grad from=#BFC7C4 to=#F2F7F5 f=0.6>深层地界</grad></shadow>"
			x: -2.0d
			y: 4.0d
		}
		{
			dependencies: ["449CBD47F373F9E2"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>回响森林</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>回响树生长在回响土上，紫色的叶子，是这个维度里最漂亮的生物群系。同时也是最危险的，这并非巧合。</grad></shadow>"
				""
				"[!danger] 在深地以 `17` 的权重生成，对抗 `5` 个敌人。这里不是安静的森林，而是一片恰好有树的破碎农场。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>这里住着什么</shadow></grad>"
				""
				"- <grad from=#9DB8D4 to=#5D7791 f=0.8>破碎的</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>2 至 5</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 生命值，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>6</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 伤害，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>3.5</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 护甲。它们会掉落 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Sculk Bone</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。"
				"[间隔=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>Sculk Snapper</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>, </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>1 至 2</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>.</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>这里没有其他生物生成，所以在这个生物群系里遇到的所有生物都是这两种之一。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>值得收获</shadow></grad>"
				""
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>Echo Log</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 和 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Echo Planks</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，一套完整的木材套装，包括船、告示牌和悬挂告示牌。"
				"[间隔=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>回声树苗</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。回声树会再生，所以上界只需一次采集即可永久获取。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>Echo Soil</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>, </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>25</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> patches per chunk, generated nowhere else.</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>Sculk Bone 是 Sonorous Staff 和 Soul Elytra 的三分之一。来这里刷，别去别的地方。</grad></shadow>"
			]
			icon: "deeperdarker:echo_log"
			id: "0286461494ADF352"
			min_width: 330
			rewards: [{
				id: "1615A9C591792F6F"
				type: "xp"
				xp: 100
			}]
			shape: "diamond"
			size: 1.15d
			subtitle: "<typewriter><grad from=#D77BFF to=#D77BFF>从未见过阳光的树木。</grad>"
			tasks: [{
				biome: "deeperdarker:echoing_forest"
				icon: "deeperdarker:echo_soil"
				id: "3897F84E22991976"
				title: "探索 &d&l回响森林"
				type: "biome"
			}]
			title: "<shadow a=0.4><grad from=#D77BFF to=#F3D6FF f=0.6>回响森林</grad></shadow>"
			x: 2.0d
			y: 4.0d
		}
		{
			dependencies: ["449CBD47F373F9E2"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>阴沉的柱廊</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>琥珀色的柱子、灵魂土、岩浆和暗岩，而不是潜声石。它看起来像是一个敌对生物群系，但实际上完全相反。</grad></shadow>"
				""
				"[!success] 阴沉柱群系列表包含 `zero` 个生物刷新点。不是缩减后的列表，而是空列表。这里没有任何生物会自然刷新。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>你为何而来</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它有专属的矿石群系。 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Gloomslate</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 而非 sculk stone 矿石，产量相同，且每个区块有 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>12</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 个矿石特征，而 Deeplands 中仅有 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>10</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 个。"
				"[间隔=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>Crystallized Amber</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 会大量生成于此。每一块内部都冻结着什么东西。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>Magma</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 每区块 128 个方块，以及 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>128</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 和 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Soul Sand</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 以及 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Soul Soil</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，无需前往下界。"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>这是该维度中唯一适合建造基地的地方。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>间歇泉</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>A </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Gloomy Geyser</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 会将触碰它的任何东西向上发射，速度为 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>2.5</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。它造成的伤害为 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>完全为零</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[!warn] 起飞是免费的，降落却不是。间歇泉不会抵消坠落伤害，所以要么瞄准水面，要么落在另一个间歇泉上。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>经验球是喷泉会忽略的唯一物品，这意味着放在喷泉上的经验球会留在那里，而不是飞走。</grad></shadow>"
			]
			icon: "deeperdarker:gloomy_sculk"
			id: "1CCCCA7E20B877A7"
			min_width: 330
			rewards: [{
				id: "7A48A9ED5C961065"
				type: "xp"
				xp: 100
			}]
			shape: "diamond"
			size: 1.15d
			subtitle: "<typewriter><grad from=#FFB347 to=#FFB347>这里什么生物都不会生成。什么都没有。</grad>"
			tasks: [{
				biome: "deeperdarker:overcast_columns"
				icon: "deeperdarker:gloomy_sculk"
				id: "60452EE3EADE1395"
				title: "探索 &6&lOvercast Columns&r"
				type: "biome"
			}]
			title: "<shadow a=0.4><grad from=#FFB347 to=#FFE3B0 f=0.6>阴沉的柱廊</grad></shadow>"
			x: 1.5d
			y: 3.5d
		}
		{
			dependencies: ["449CBD47F373F9E2"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>远古神殿</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Deeper and Darker 生成的唯一结构，其中存放着本章后半段所需的两件物品。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>寻找唯一者</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它只生成于 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Deeplands</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。不是森林，不是洞穴，也不是石柱区。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每次放置间隔 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>28</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 个区块，且间隔 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>8</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 个区块，这样既分散又不会过于稀有。"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>从Y坐标 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>18</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>和Y坐标 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>28</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>之间开始，并向上建造。请挖掘该深度，而非基岩层。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>五种类型的箱子</shadow></grad>"
				""
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>Apex</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，最富有的。 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>5 至 6 次</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 滚动，回声碎片，附魔钻石装备和获得 Warden Carapace 的机会。"
				"[间隔=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>地下室</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>4 到 6 次</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 投掷，外加必定获得的第二组附魔装备。内含 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>“另一面”音乐唱片</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>秘密的</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，重要的那个。每个秘密宝箱都恰好包含一个 </grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>Sculk 发射器</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，保证如此，外加一次获得 Warden 升级模板的机会。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#35FCF9 to=#12B7C4 f=0.8>喷泉</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>和</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>储物箱</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，可存放矿石和建筑材料。喷泉宝箱可存放</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>灵魂水晶</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[!tip] 发射器在游戏里没有任何合成配方。秘密宝箱是唯一来源，每个秘密宝箱里都有一个。找到秘密房间吧。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"[!danger] 神庙里到处都是 `Ancient Vases`。大约每二十个中有一个会触发 Stalker 的生成。下面有个完整的任务链是关于这个的。"
			]
			icon: "deeperdarker:gloomslate_bricks"
			icon_scale: 1.15d
			id: "3B1E28D454DCF8D4"
			min_width: 340
			rewards: [{
				id: "69CE28032D704CAD"
				type: "xp"
				xp: 100
			}]
			shape: "hexagon"
			size: 1.4d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>一个结构... 但里面应有尽有。</grad></typewriter>"
			tasks: [{
				id: "06C97CF6CF87C3AF"
				structure: "deeperdarker:ancient_temple"
				title: "找到&b远古神殿&r"
				type: "structure"
			}]
			title: "<shadow a=0.4><grad from=#35FCF9 to=#BFFFFD f=0.6>远古神殿</grad></shadow>"
			x: 0.0d
			y: 5.0d
		}
		{
			dependencies: ["3B1E28D454DCF8D4"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>远程存储</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>发射器会绑定到一个方块上，无论你站在哪里，都可以打开该方块的界面。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>使用它</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7></grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>潜行加右键点击</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一个有效的方块来链接它。物品纹理在链接后会改变。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7></grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>右键点击其他物品，或右键点击空气，以打开链接方块。</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7></grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7></grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>潜行加右键点击，"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它可以通过你的 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>快捷栏或物品栏操作，屏幕会保持打开状态，不必手持该物品。</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7></grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>可链接对象</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>工作台、铁砧、破损铁砧、附魔台、酿造台、信标、织布机、磨石、切石机、制图台、锻造台、熔炉、烟熏炉、高炉、箱子、陷阱箱、木桶、所有潜影盒、发射器、投掷器和漏斗。</grad></shadow>"
				""
				"[!info] 不在列表中的物品将返回 `无法链接到方块`。该列表是一个标签，因此只有当模组作者添加了它时，模组化箱子才会被支持。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>两个真正的极限</shadow></grad>"
				""
				"- <grad from=#FF7A7A to=#FF3C3C f=0.8>链接的区块必须加载</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。发射器在打开任何东西之前都会实时读取方块。走远一点，让区块卸载，你就会得到错误提示：</grad></shadow><grad from=#FF7A7A to=#FF3C3C f=0.8>链接的方块缺失或未加载</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <grad from=#FF7A7A to=#FF3C3C f=0.8>它从不穿越维度</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。它会查询你所在维度的坐标，找到错误的方块，并当场解除自身链接。</grad></shadow>"
				""
				"[!tip] 把它连接到chunkloaded箱子，范围问题就完全消失了。连接到Crafting Table，范围问题就不存在了，因为你可以把它放在任何地方。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>一旦屏幕打开，无论走多远它都会保持打开状态，这是它与容器交互方式的一个非常实用的特性。</grad></shadow>"
			]
			icon: "deeperdarker:sculk_transmitter"
			id: "59FD763E876997B1"
			min_width: 340
			rewards: [{
				id: "25D69511ADBCED7D"
				type: "xp"
				xp: 100
			}]
			shape: "gear"
			size: 1.0d
			subtitle: "<typewriter><grad from=#5FD8D6 to=#5FD8D6>你的基地，装进口袋里。</grad></typewriter>"
			tasks: [{
				id: "279D453B4F9AEC27"
				item: "deeperdarker:sculk_transmitter"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#35FCF9 to=#BFFFFD f=0.6>Sculk 发射器</grad></shadow>"
			x: -1.0d
			y: 6.0d
		}
		{
			dependencies: ["1C89B122F8DF31FA"]
			description: [
				"# <grad from=#35FCF9 to=#BFFFFD f=0.6><shadow a=0.3>守卫工具</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>锻造台、</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>潜卫升级模板，</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>外加一个</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>下界合金工具，</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>外加一个</grad></shadow><grad from=#35FCF9 to=#12B7C4 f=0.8>加固回响碎片，</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每件需要一个碎片。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#2FD9D6 to=#A8F4F2 f=0.6><shadow a=0.3>等级，已测定</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>挖矿等级 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>5</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，下界合金需要的是 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>4</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。原版游戏里没这个需求，但本整合包里有很多需要。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>耐久度 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>2519</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 对比下界合金的 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>2031</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>挖掘速度 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>10.0</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 对比 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>9.0</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>基础伤害加成 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>5.0</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 和 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>4.0</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，附魔等级 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>18</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 和 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>15</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>剑的攻击伤害为 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>9</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，斧头为 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>11</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，比下界合金武器高一，附魔效果也更好。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"[!info] 修复材料是 `Reinforced Echo Shard`，不是下界合金。将碎片磨回原状很昂贵，所以在使用前给它们附上修补或耐久三。"
				""
				"[!tip] 该整合包将整套工具放在 `forge:netherite_tools` 中，因此需要下界合金守护者来开启。如果提示你还不能持有，就去寻找被遗忘者 Zoranth。"
			]
