			x: 0.0d
			y: -8.0d
		}
		{
			dependencies: ["7A3C5D7814AD5D9C"]
			description: [
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>弹药袋</grad><grad from=#C8AE86 to=#EBD9B8 f=0.8>是廉价入门款，需要线、兔皮和一枚铜币。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>弹药箱</grad><grad from=#C8AE86 to=#EBD9B8 f=0.8>使每次装填时有 </grad><grad from=#C8AE86 to=#EBD9B8 f=0.8>25% 的几率</grad><grad from=#FFFFFF to=#C7C7C7>不消耗弹药。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>无底弹药箱的 </grad><grad from=#C8AE86 to=#EBD9B8 f=0.8>容量提升至 </grad><grad from=#FFFFFF to=#C7C7C7>40%。 </grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>两个箱子不能叠加，所以穿戴两个没有效果。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它们会堆叠在物品上，每级增加 </grad><grad from=#C8AE86 to=#EBD9B8 f=0.8>10%</grad><grad from=#FFFFFF to=#C7C7C7>的额外效果。</grad></shadow>"
			]
