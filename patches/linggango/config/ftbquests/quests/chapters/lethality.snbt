	quest_links: [ ]
	quests: [
		{
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Lethality 是一款剑类模组，而且对此毫不掩饰。共有七十七个物品，其中大约五十个是用来挥舞的。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>两半。BAFS 梯子是由二十种材料重制的剑，可攀登右侧的阶梯。命名剑会从与其等级匹配的阶梯分叉而出。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>其余物品，金属、女仆盔甲、奇物和阿根廷零食，都挂在下面的柱子上。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#A31419 to=#EBA0A0 f=0.6><shadow a=0.3>它自身的效果</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#A31419 to=#EBA0A0 f=0.8>酸毒</grad><grad from=#FFFFFF to=#C7C7C7>: 停止再生并造成持续伤害。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#A31419 to=#EBA0A0 f=0.8>地狱之火</grad><grad from=#FFFFFF to=#C7C7C7>: 快速造成持续伤害。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#A31419 to=#EBA0A0 f=0.8>火焰六边形</grad><grad from=#FFFFFF to=#C7C7C7>: 持续增加的持续性伤害。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#A31419 to=#EBA0A0 f=0.8>被污染的灾厄</grad><grad from=#FFFFFF to=#C7C7C7>: 你的精神正在逐渐衰弱。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#A31419 to=#EBA0A0 f=0.8>硫磺火焰</grad><grad from=#FFFFFF to=##C7C7C7>: 快速造成持续伤害，而强化版会伤害你，同时大幅提升你的伤害并赋予生命偷取效果。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#A31419 to=#EBA0A0 f=0.8>风化</grad><grad from=#FFFFFF to=#C7C7C7>: 将伤害减免乘以 </grad><grad from=#A31419 to=#EBA0A0 f=0.8>0.7倍</grad><grad from=#FFFFFF to=#C7C7C7>，防御力下降 </grad><grad from=#A31419 to=#EBA0A0 f=0.8>10</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#A31419 to=#EBA0A0 f=0.8>钢铁意志</grad><grad from=#FFFFFF to=#C7C7C7>: 你造成的伤害有一半会很快再次命中目标。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#A31419 to=#EBA0A0 f=0.8>宁静</grad><grad from=#FFFFFF to=#C7C7C7>: 附近的生物无法锁定你。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#A31419 to=#EBA0A0 f=0.8>Megalomaniac</grad><grad from=#FFFFFF to=#C7C7C7>: 所有攻击造成的伤害更高，并忽略无敌帧。</grad></shadow>"
				""
				"{ \"text\": \"Back to Terramity\", \"underlined\": \"true\", \"color\": \"#8FCB3F\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"2F1A384416C57A23\" } }"
				"{ \"text\": \"Brutality, the other half of this pair\", \"underlined\": \"true\", \"color\": \"#C0392B\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"3AE3B2BE4A65CEF6\" } }"
			]
