	order_index: 1
	quest_links: [ ]
	quests: [
		{
			description: [
				"# <grad from=#C77DFF to=#F0DAFF f=0.6><shadow a=0.3>这是什么模组？</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Enigmatic Legacy 在您的物品栏中添加了四个全新的配件栏位，然后用余生来填满它们。 </grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>戒指、护身符、秘法卷轴和魔石。每一件都作用显著，几乎没有一件是悄无声息的。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>有两个附加包随附其中。 </grad><grad from=#D9A5FF to=#B06BE8 f=0.8>Enigmatic Addons</grad><grad from=#FFFFFF to=#C7C7C7> 增加了更多内容，而 </grad><grad from=#FFE9A8 to=#F5C542 f=0.8>Covenant of the Seven</grad><grad from=#FFFFFF to=#C7C7C7> 则增加了该模组最著名决定的镜像版本。"
				""
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>整个任务系列</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>本章下共有八个章节。点击任意一个，或使用本页底部的图标即可访问。</grad></shadow>"
				""
				"{ \"text\": \"Foundations\", \"underlined\": \"true\", \"color\": \"#D9A5FF\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"74B48BCBAAAB8006\" } }"
				"{ \"text\": \"Arcane Scrolls\", \"underlined\": \"true\", \"color\": \"#D9A5FF\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"7EE5D96E5925CA07\" } }"
				"{ \"text\": \"Spellstones\", \"underlined\": \"true\", \"color\": \"#D9A5FF\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6895F81092608B77\" } }"
				"{ \"text\": \"Charms\", \"underlined\": \"true\", \"color\": \"#D9A5FF\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"1758E7C06345B6C3\" } }"
				"{ \"text\": \"Etherium and Arms\", \"underlined\": \"true\", \"color\": \"#D9A5FF\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6D10D65B617CD7E8\" } }"
				"{ \"text\": \"Oddities\", \"underlined\": \"true\", \"color\": \"#D9A5FF\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6AC08CFA49DD17A6\" } }"
				"{ \"text\": \"The Seven Curses\", \"underlined\": \"true\", \"color\": \"#D9A5FF\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"3430F8495290E34C\" } }"
				"{ \"text\": \"The Seven Virtues\", \"underlined\": \"true\", \"color\": \"#D9A5FF\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"2482696E9E09D728\" } }"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>从这里开始</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>拿起指南书，了解四个槽位，然后去找到一个 </grad><grad from=#D9A5FF to=#B06BE8 f=0.8>地球之心</grad><grad from=#FFFFFF to=#C7C7C7>。本模组中几乎所有东西都依赖于这一件物品。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>之后你将面临一个无法撤销的选择。请慎重考虑！！</grad></shadow>"
			]
			icon: "enigmaticlegacy:enigmatic_amulet"
			id: "1DF34C60DDABA0B6"
			min_width: 380
			shape: "star"
			size: 2.0d
			subtitle: "<typewriter><grad from=#B06BE8 to=#B06BE8>四个额外的栏位和一个非常糟糕的主意。</grad>"
			tasks: [{
				id: "7AC435FF09A6E1C2"
				title: "woa"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#C77DFF to=#F0DAFF f=0.6>神秘遗产</grad></shadow>"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["1DF34C60DDABA0B6"]
			description: [
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>游戏内手册</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>合成网格中放一本《书》和一个灯笼。这就是全部配方了。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它会随着你的游戏进程而填满。你接触的每个物品都会添加其页面，所以早期看起来几乎为空，而到了最后会变得非常庞大。</grad></shadow>"
				""
				"[!tip] 此任务链和书籍应一同阅读。书籍记载了所有配方，任务链则说明了你需要它们的理由。"
				""
				"<shadow a=0.3><shadow a=0.3><grad from=#A0A0A0 to=#606060>它后来也会作为配方材料出现在几种非常粗鲁的武器中。</grad></shadow></shadow>"
			]
			id: "1668D3FDB91C6F37"
			min_width: 330
			shape: "gear"
			size: 1.25d
			subtitle: "<typewriter><grad from=#C8AE86 to=#C8AE86>一本书和一个灯笼！</grad></typewriter>"
			tasks: [{
				id: "2C423E6DA7107BC4"
				item: "enigmaticlegacy:the_acknowledgment"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>致谢声明</grad></shadow>"
			x: -1.875d
			y: 1.875d
		}
		{
			dependencies: ["1DF34C60DDABA0B6"]
			description: [
				"# <grad from=#C77DFF to=#F0DAFF f=0.6><shadow a=0.3>打开你的物品栏</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>饰品栏位因本模组新增了四种类型。它们与其他物品不共享空间，所以你已穿戴的物品不会有任何风险。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>戒指</grad><grad from=#FFFFFF to=#C7C7C7> 需要 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>2</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 个空位。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>魅力</grad><grad from=#FFFFFF to=#C7C7C7>始于</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>1</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>号位。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>秘法卷轴</grad><grad from=#FFFFFF to=#C7C7C7> 始于 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>0</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>.</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>Spellstone</grad><grad from=#FFFFFF to=#C7C7C7> 初始值为 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>0</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[!warn] 零不是错误。卷轴和魔石栏位在你捡起第一个卷轴或魔石前会保持隐藏。拿起一个后，该栏位就会永久显示。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>获得更多空间</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>Celestial Fruit</grad><grad from=#FFFFFF to=#C7C7C7>永久添加一个戒指槽位。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>瓶装的伊彻尔</grad><grad from=#FFFFFF to=#C7C7C7>永久添加一个魅力槽位。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>Tome of Void</grad><grad from=#FFFFFF to=#C7C7C7> 永久添加一个神秘卷轴栏位。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>Enchanter's Pearl</grad><grad from=#FFFFFF to=#C7C7C7> 和 </grad></shadow><grad from=#FFE9A8 to=#F5C542 f=0.8>Potioneer's Pearl</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 佩戴时每颗可增加一个附魔槽位。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>两个你暂时还看不到的插槽</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>还有两个，它们只会为这一页底部的两个戒指中的一个而开启。佩戴那个戒指是关键，别无他法可以开启它们。</grad></shadow>"
			]
			icon: "enigmaticlegacy:enigmatic_eye"
			id: "6F514839FCB05B75"
			min_width: 340
			shape: "gear"
			size: 1.25d
			subtitle: "<typewriter><grad from=#B06BE8 to=#B06BE8>所有这些东西究竟都去哪儿了。</grad>"
			tasks: [{
				id: "103ACC5E4C9CEB7C"
				title: "我读了物品栏列表"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#C77DFF to=#F0DAFF f=0.6>四格空间</grad></shadow>"
			x: 1.875d
			y: 1.875d
		}
		{
			dependencies: ["1DF34C60DDABA0B6"]
			description: [
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>红色护身符</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你出生时就已经手持其中一个，颜色是随机的。它位于项链槽位，并提供 </grad><grad from=#FF8A8A to=#FFFFFF f=0.8>额外1.5点攻击力</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>共有七种颜色。与其他玩家交易是收集其余颜色的唯一理智方法，而且，人们确实会这样做。</grad></shadow>"
				""
				"<shadow a=0.3><shadow a=0.3><grad from=#A0A0A0 to=#606060>护身符没有配方。永远都没有。</grad></shadow></shadow>"
			]
			hide_dependency_lines: true
			id: "63886E154F541FF0"
			min_width: 300
			optional: true
			shape: "circle"
			subtitle: "<typewriter><grad from=#FF8A8A to=#FF8A8A>把七个都收集起来，显而易见。</grad>"
			tasks: [{
