				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>铁和维伦特姆。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>廉价、轻便，以至于你忘了自己还穿着它。</grad></shadow>"
