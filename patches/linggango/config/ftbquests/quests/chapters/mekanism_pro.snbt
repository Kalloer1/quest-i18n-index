					}
				}
				title: "Sodium"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#FF8A4C to=#FFD4B4 f=0.6>钠冷却剂</grad></shadow>"
			x: 8.2d
			y: 7.5d
		}
		{
			dependencies: ["35EF76F0B951BFA8"]
			description: [
				"# <grad from=#FF8A4C to=#FFD4B4 f=0.6><shadow a=0.3>中间人</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>又一个空心箱，这次是用</grad><grad from=#FF8A4C to=#FFD4B4 f=0.8>Boiler Casing</grad><grad from=#FFFFFF to=#C7C7C7>做的，中间夹着一层</grad><grad from=#FF8A4C to=#FFD4B4 f=0.8>Pressure Dispersers</grad><grad from=#FFFFFF to=#C7C7C7>，将其分为底部的水区和顶部的蒸汽区。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>超热的钠进入，释放热量，然后变成普通的钠。下半部分的水变成上半部分的蒸汽。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#FF8A4C to=#FFD4B4 f=0.6><shadow a=0.3>数字们</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>水区的每个方块都含有 </grad><grad from=#FF8A4C to=#FFD4B4 f=0.8>16,000</grad><grad from=#FFFFFF to=#C7C7C7> 的水。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>蒸汽部分的每个方块都储存着 </grad><grad from=#FF8A4C to=#FFD4B4 f=0.8>160,000</grad><grad from=#FFFFFF to=#C7C7C7> 蒸汽。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每个冷却剂区块方块可容纳 </grad><grad from=#FF8A4C to=#FFD4B4 f=0.8>256,000</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FF8A4C to=#FFD4B4 f=0.8>70</grad><grad from=#FFFFFF to=#C7C7C7> 锅炉热量中可立即用于煮沸的百分比。</grad></shadow>"
				""
				"[!info] 用冷水冷却反应堆，它自己就能产生蒸汽。而锅炉能让你用钠冷却也能获得蒸汽，上限要高得多。"
			]
