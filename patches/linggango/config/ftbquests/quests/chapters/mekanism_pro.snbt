					type: "item"
				}
				{
					id: "68B050A8CDCDCD10"
					item: "mekanism:hazmat_boots"
					type: "item"
				}
			]
			title: "<shadow a=0.4><grad from=#8FE33F to=#DCFFA8 f=0.6>防护服</grad></shadow>"
			x: 5.5d
			y: -4.5d
		}
		{
			dependencies: ["1BF3A5C3BDE6371E"]
			description: [
				"## <grad from=#8FE33F to=#DCFFA8 f=0.6><shadow a=0.3>钢制外壳，加固版</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>外壳是让箱子算作反应堆的关键。反应堆玻璃可以替代外壳使用，能看到燃料水平，这点额外玻璃是值得的。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你需要很多这些。一个中等规模的反应堆就需要超过一百个方块高的墙壁了。</grad></shadow>"
			]
			hide_until_deps_visible: false
			id: "1482F2D45E8F761D"
			rewards: [{
				id: "0792BEFF2D7C604C"
				type: "xp"
				xp: 100
			}]
			subtitle: "<typewriter><grad from=#8FE33F to=#8FE33F>好多好多墙壁</grad>"
			tasks: [
				{
					count: 44L
					id: "19447D5D621A8D89"
					item: "mekanismgenerators:fission_reactor_casing"
					type: "item"
				}
				{
					count: 50L
					id: "0765AB709CC3C6E2"
					item: "mekanismgenerators:reactor_glass"
					type: "item"
				}
			]
			title: "<shadow a=0.4><grad from=#8FE33F to=#DCFFA8 f=0.6>反应堆外壳</grad></shadow>"
			x: 4.0d
			y: 5.0d
		}
		{
			dependencies: ["1BF3A5C3BDE6371E"]
			description: [
				"## <grad from=#8FE33F to=#DCFFA8 f=0.6><shadow a=0.3>物品的存取</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>端口取代外壳方块并移动物品。使用配置器设置要移动的物品。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#8FE33F to=#DCFFA8 f=0.8>燃料</grad><grad from=#FFFFFF to=#C7C7C7> 已加入。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#8FE33F to=#DCFFA8 f=0.8>冷却剂</grad><grad from=#FFFFFF to=#C7C7C7> 注入。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#8FE33F to=#DCFFA8 f=0.8>加热冷却液</grad><grad from=#FFFFFF to=#C7C7C7>已排出。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#8FE33F to=#DCFFA8 f=0.8>废料</grad><grad from=#FFFFFF to=#C7C7C7> 出。</grad></shadow>"
				""
				"[!warn] 如果废料端口无处可送废料，反应堆会充满并开始自损。在给它燃料前，先给它一个桶。"
			]
			id: "0696B725E840B996"
			rewards: [{
				id: "11FABC06766669F5"
				type: "xp"
				xp: 50
			}]
			subtitle: "<typewriter><grad from=#8FE33F to=#8FE33F>四个洞，四个任务</grad>"
			tasks: [{
				count: 4L
				id: "057CDA5BC0C5F774"
				item: "mekanismgenerators:fission_reactor_port"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#8FE33F to=#DCFFA8 f=0.6>反应堆端口</grad></shadow>"
			x: 7.0d
			y: 5.0d
		}
		{
			dependencies: [
				"1482F2D45E8F761D"
				"0696B725E840B996"
			]
			description: [
				"## <grad from=#8FE33F to=#DCFFA8 f=0.6><shadow a=0.3>柱子和柱头</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>燃料组件在反应堆地板上按列堆叠。每列顶部放一个 </grad><grad from=#8FE33F to=#DCFFA8 f=0.8>控制棒组件</grad><grad from=#FFFFFF to=#C7C7C7>，没有控制棒的列则无效。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每个组件可容纳 </grad><grad from=#8FE33F to=#DCFFA8 f=0.8>8,000</grad><grad from=#FFFFFF to=#C7C7C7>燃料。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每个组件将最大燃烧速率提高 </grad><grad from=#8FE33F to=#DCFFA8 f=0.8>1</grad><grad from=#FFFFFF to=#C7C7C7>/刻。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>所以，组件数量就是反应堆的尺寸调节器。组件越多，可能产生的热量就越多，也就意味着你需要更多的冷却来与之匹配。</grad></shadow>"
				""
				"[!tip] 将列之间留出间隙。沸腾效率取决于表面积，而紧密排列的区块表面积远小于间隔开的网格。"
			]
			id: "3F5010269469EBE0"
			rewards: [{
				id: "6819DA9F73BA383C"
				type: "xp"
				xp: 50
			}]
			size: 1.25d
			subtitle: "<typewriter><grad from=#8FE33F to=#8FE33F>会发光的那部分</grad></typewriter>"
			tasks: [
				{
					count: 2L
					id: "032045BB026F44B3"
					item: "mekanismgenerators:fission_fuel_assembly"
					type: "item"
				}
				{
					id: "0875D821930A348A"
					item: "mekanismgenerators:control_rod_assembly"
					type: "item"
				}
			]
			title: "<shadow a=0.4><grad from=#8FE33F to=#DCFFA8 f=0.6>燃料组件</grad></shadow>"
			x: 5.5d
			y: 6.0d
		}
		{
			dependencies: ["36B1995B495AA674"]
			description: [
				"## <grad from=#8FE33F to=#DCFFA8 f=0.6><shadow a=0.3>浓缩铀</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>浓缩室中的1个铀锭可产出 </grad><grad from=#8FE33F to=#DCFFA8 f=0.8>2</grad><grad from=#FFFFFF to=#C7C7C7>个黄饼。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一旦开始寻找，铀矿石就相当常见了，而整个反应堆燃料链都始于这种粉末。</grad></shadow>"
			]
			id: "7E17AB5A4492929E"
			rewards: [{
				id: "48CC9D36035B2625"
				type: "xp"
				xp: 25
			}]
			shape: "pentagon"
			size: 1.2d
			subtitle: "<typewriter><grad from=#8FE33F to=#8FE33F>不是那种蛋糕</grad>"
			tasks: [
				{
					count: 2L
					id: "1C72C0C59D65B1D0"
					item: "mekanism:yellow_cake_uranium"
					type: "item"
				}
				{
					id: "0EE67E042C84F00B"
					item: "immersiveengineering:ingot_uranium"
					type: "item"
				}
			]
			title: "<shadow a=0.4><grad from=#8FE33F to=#DCFFA8 f=0.6>黄色蛋糕铀</grad></shadow>"
			x: 5.5d
			y: -3.0d
		}
		{
			dependencies: ["7E17AB5A4492929E"]
			description: [
				"## <grad from=#8FE33F to=#DCFFA8 f=0.6><shadow a=0.3>蛋糕变气体</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>化学氧化剂将每块黄饼转化为</grad><grad from=#8FE33F to=#DCFFA8 f=0.8>250</grad><grad from=#FFFFFF to=#C7C7C7>氧化铀。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>从这里开始，整条链都是气体，所以准备好几个化学储罐吧。</grad></shadow>"
			]
			id: "3AF4E5D4839CEF8B"
			rewards: [{
				id: "147637FB74512198"
				type: "xp"
				xp: 25
			}]
			subtitle: "<typewriter><grad from=#8FE33F to=#8FE33F>蛋糕变气体</grad>"
			tasks: [{
				id: "772EA844FE7C1B74"
				item: "mekanism:chemical_oxidizer"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#8FE33F to=#DCFFA8 f=0.6>氧化铀</grad></shadow>"
			x: 7.0d
			y: -2.0d
		}
		{
			description: [
				"# <grad from=#8FE33F to=#DCFFA8 f=0.6><shadow a=0.3>超越矿石链</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>第一章的一切都是为了这一刻。裂变、聚变、反物质，以及以万亿为单位的电池。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>这些都没有什么建造难度。但它们都很容易建错，而且失败时的动静比一台停止工作的机器大多了。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#8FE33F to=#DCFFA8 f=0.6><shadow a=0.3>三条线由此延伸</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#8FE33F to=#DCFFA8 f=0.8>向左走，</grad><grad from=#FFFFFF to=#C7C7C7>依次是铀、裂变反应堆、废料，最后是反物质。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#8FE33F to=#DCFFA8 f=0.8>中间部分</grad><grad from=#FFFFFF to=#C7C7C7>将反应堆的热量转化为蒸汽，再将蒸汽转化为海量的电力。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#8FE33F to=#DCFFA8 f=0.8>右侧的</grad><grad from=#FFFFFF to=#C7C7C7>是锂，可为感应矩阵和聚变反应堆提供燃料。</grad></shadow>"
				""
				"[!warn] 接触任何放射性物质前，请准备好全套防护服和一桶牛奶。这两样东西都很便宜，也能省得你跑回床上。"
				"{ \"text\": \"Back to Mekanism\", \"underlined\": \"true\", \"color\": \"#3FA9C8\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"23983F4DC524B14B\" } }"
			]
			icon: "mekanism:digital_miner"
			id: "24174700F7FB771C"
			min_width: 360
			rewards: [{
				id: "73F5CE911AC4474C"
				type: "xp"
				xp: 10
			}]
			size: 1.5d
			subtitle: "<typewriter><grad from=#8FE33F to=#8FE33F>现在是吵闹的一半了</grad>"
			tasks: [{
				id: "3153288DCE1C4FEF"
				title: "太棒了"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#8FE33F to=#DCFFA8 f=0.6>Mekanism: 高级版</grad></shadow>"
			x: 8.0d
			y: -4.5d
		}
		{
			dependencies: ["16A6C47E35F3B9D0"]
			description: [
				"# <grad from=#8FE33F to=#DCFFA8 f=0.6><shadow a=0.3>你刚刚注册的内容</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>裂变燃料需要，依次需要：</grad><grad from=#8FE33F to=#DCFFA8 f=0.8>浓缩室、</grad><grad from=#FFFFFF to=#C7C7C7>、</grad><grad from=#8FE33F to=#DCFFA8 f=0.8>化学氧化器、</grad><grad from=#FFFFFF to=#C7C7C7>、</grad><grad from=#8FE33F to=#DCFFA8 f=0.8>溶解室、</grad><grad from=#FFFFFF to=#C7C7C7>、</grad><grad from=#8FE33F to=#DCFFA8 f=0.8>化学注入器、</grad><grad from=#FFFFFF to=#C7C7C7>和</grad><grad from=#8FE33F to=#DCFFA8 f=0.8>同位素离心机。所有机器均需供电和进料。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>反应堆会回报你数倍之多，但这得在它真正运行之后。在建造反应堆之前，先自动化这条链条，而不是之后。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#8FE33F to=#DCFFA8 f=0.6><shadow a=0.3>购物清单</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>用于反应堆、锅炉和涡轮机的数百个 </grad><grad from=#8FE33F to=#DCFFA8 f=0.8>钢制外壳</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#8FE33F to=#DCFFA8 f=0.8>终极增压管</grad><grad from=#FFFFFF to=#C7C7C7>用于冷却循环，因为没比这更慢的了。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>大量</grad><grad from=#8FE33F to=#DCFFA8 f=0.8>铅</grad><grad from=#FFFFFF to=#C7C7C7>，用于废料桶和危险品装备。</grad></shadow>"
				""
				"[!tip] 先建造完整的燃料管线并装满一个储罐。用满罐燃料启动反应堆，比少量启动要轻松得多。"
			]
			id: "3B81800EE6E77EF2"
			min_width: 340
			rewards: [{
				id: "21A507B60A7721B0"
				type: "xp"
				xp: 100
			}]
			shape: "hexagon"
			size: 1.2d
			subtitle: "<typewriter><grad from=#8FE33F to=#8FE33F>反应堆可不便宜</grad>"
			tasks: [{
				id: "382818E289EC83A6"
				title: "行吧，伙计"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#8FE33F to=#DCFFA8 f=0.6>反应堆并非免费</grad></shadow>"
			x: 5.5d
			y: 2.0d
		}
		{
			dependencies: ["7E17AB5A4492929E"]
			description: [
				"## <grad from=#8FE33F to=#DCFFA8 f=0.6><shadow a=0.3>萤石</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>萤石生成于深层，直到此刻为止都毫无用处。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>1个萤石加</grad><grad from=#8FE33F to=#DCFFA8 f=0.8>1个硫酸，</grad><grad from=#FFFFFF to=#C7C7C7>在化学溶解室中可得到</grad><grad from=#8FE33F to=#DCFFA8 f=0.8>1000个</grad><grad from=#FFFFFF to=#C7C7C7>氢氟酸。一整块萤石可一次性产出九倍的数量。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>硫酸就是你之前用来5倍矿物加工的硫酸，所以生产线可能已经在运行了。</grad></shadow>"
			]
			id: "187A3F5B41D1C923"
			rewards: [{
				id: "5AEF7913046DC6FB"
				type: "xp"
				xp: 25
			}]
			subtitle: "<typewriter><grad from=#8FE33F to=#8FE33F>终于派上用场了</grad></typewriter>"
			tasks: [
				{
					id: "3A5FB51FB9B65990"
					item: "mekanism:fluorite_gem"
					type: "item"
				}
				{
					id: "2091F0A297A1A3C9"
					item: "mekanism:chemical_dissolution_chamber"
					type: "item"
				}
			]
			title: "<shadow a=0.4><grad from=#8FE33F to=#DCFFA8 f=0.6>氢氟酸</grad></shadow>"
			x: 4.0d
			y: -2.0d
		}
		{
			dependencies: [
				"3AF4E5D4839CEF8B"
				"187A3F5B41D1C923"
			]
			description: [
				"## <grad from=#8FE33F to=#DCFFA8 f=0.6><shadow a=0.3>将它们组合起来</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#8FE33F to=#DCFFA8 f=0.8>1</grad><grad from=#FFFFFF to=#C7C7C7> 氢氟酸和 </grad><grad from=#8FE33F to=#DCFFA8 f=0.8>1</grad><grad from=#FFFFFF to=#C7C7C7> 氧化铀在化学合成器中会生成 </grad><grad from=#8FE33F to=#DCFFA8 f=0.8>2</grad><grad from=#FFFFFF to=#C7C7C7> 六氟化铀。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>二进二出，这使得这一步成为整条链中最便宜的步骤。</grad></shadow>"
			]
			id: "3663E93E169EF8E3"
			rewards: [{
				id: "1AA24CF536807D83"
				type: "xp"
				xp: 50
			}]
			size: 1.2d
			subtitle: "<typewriter><grad from=#8FE33F to=#8FE33F>廉价的一步</grad>"
			tasks: [{
				id: "73C5F4AC41EE5123"
				item: "mekanism:chemical_infuser"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#8FE33F to=#DCFFA8 f=0.6>六氟化铀</grad></shadow>"
			x: 5.5d
			y: -1.0d
		}
		{
			dependencies: ["3663E93E169EF8E3"]
			description: [
				"## <grad from=#8FE33F to=#DCFFA8 f=0.6><shadow a=0.3>旋转起来</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>同位素离心机将六氟化铀转化为</grad><grad from=#8FE33F to=#DCFFA8 f=0.8>裂变燃料</grad><grad from=#FFFFFF to=#C7C7C7>，一比一转化。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>这就是反应堆消耗的东西。多存点，因为全功率运行的反应堆消耗速度比你想象的快得多。</grad></shadow>"
				""
				"[!info] 离心机之后还能把核废料变成钚，所以永远都有用。"
			]
			id: "16A6C47E35F3B9D0"
			rewards: [{
				id: "04AA88C4D9B33E34"
				type: "xp"
				xp: 100
			}]
			shape: "gear"
			size: 1.2d
			subtitle: "<typewriter><grad from=#8FE33F to=#8FE33F>旋转周期</grad>"
			tasks: [{
				id: "3F2371FD486D4F0E"
				item: "mekanism:isotopic_centrifuge"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#8FE33F to=#DCFFA8 f=0.6>裂变燃料</grad></shadow>"
			x: 5.5d
			y: 0.5d
		}
		{
			dependencies: ["71DB87166603A239"]
			description: [
				"## <grad from=#8FE33F to=#DCFFA8 f=0.6><shadow a=0.3>存储问题</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每个桶都装有 </grad><grad from=#8FE33F to=#DCFFA8 f=0.8>512,000</grad><grad from=#FFFFFF to=#C7C7C7> 核废料，每秒会缓慢衰变掉其中的 </grad><grad from=#8FE33F to=#DCFFA8 f=0.8>1</grad><grad from=#FFFFFF to=#C7C7C7> 单位。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>和运转的反应堆相比，衰变率简直是个笑话，所以桶只是缓冲，不是解决方案。真正的答案是把废料变成有用的东西。</grad></shadow>"
				""
				"[!danger] 打破满桶会将其全部内容物作为辐射泄漏到世界中。请先将其清空。"
			]
			id: "3FFF9018DA2A2763"
			rewards: [{
				id: "1EEAAB174D95E4B6"
				type: "xp"
				xp: 25
			}]
			subtitle: "<typewriter><grad from=#8FE33F to=#8FE33F>虽远犹存，近在咫尺</grad>"
			tasks: [{
				count: 3L
