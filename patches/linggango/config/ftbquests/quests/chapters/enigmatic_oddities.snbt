				id: "37F338D0B550D6E5"
				item: "enigmaticaddons:artificial_flower"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E0A34A to=#FFE3B8 f=0.6>魔法石英花</grad></shadow>"
