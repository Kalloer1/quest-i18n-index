	quest_links: [ ]
	quests: [
		{
			description: [
				"# <grad from=#E0A34A to=#FFE3B8 f=0.6><shadow a=0.3>实用杂物抽屉</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>这些都不属于配饰栏位。它们是工具、典籍、药水，以及那些默默解决你一直忽略的问题的少数物品。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>可移动、剥离和升级附魔的附魔工具。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>垃圾桶、战利品箱，以及在任何物品上编写自定义描述的方法。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>宠物书籍、零食，还有一些纯粹作为玩笑存在的物品。</grad></shadow>"
				""
				"[!tip] 修补混合物和两本转换魔典是本章最实用的三样东西。其他都是可选的。"
			]
			icon: "enigmaticlegacy:mending_mixture"
			id: "142264209DE37EC3"
			min_width: 350
			shape: "hexagon"
			size: 1.5d
			subtitle: "<typewriter><grad from=#E0A34A to=#E0A34A>所有无法放入物品栏的东西。</grad>"
			tasks: [{
				id: "1393278720A58DBA"
				title: "正在翻找杂物抽屉里的东西"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#E0A34A to=#FFE3B8 f=0.6>奇物集</grad></shadow>"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["142264209DE37EC3"]
			description: [
				"## <grad from=#E0A34A to=#FFE3B8 f=0.6><shadow a=0.3>附魔恢复</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将其与任意附魔物品一同放入合成台。所有附魔都会从物品上转移到附魔书上，使其变成一本附魔书。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>物品完好无损地回来了，这就是如何从坏工具中拯救好附魔的方法。</grad></shadow>"
				""
				"<shadow a=0.3><shadow a=0.3><grad from=#A0A0A0 to=#606060>一本书、青金石、黄金、红石、烈焰粉和棱镜晶。价格便宜，可以多备几本。</grad></shadow></shadow>"
			]
			id: "065873A02ECE96B9"
			min_width: 340
			shape: "pentagon"
			size: 1.0d
			subtitle: "<typewriter><grad from=#E0A34A to=#E0A34A>从任何物品上移除附魔。</grad></typewriter>"
			tasks: [{
				id: "3F35AA702175572C"
				item: "enigmaticlegacy:enchantment_transposer"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E0A34A to=#FFE3B8 f=0.6>渴求知识的典籍</grad></shadow>"
			x: 0.0d
			y: -1.5d
		}
		{
			dependencies: ["065873A02ECE96B9"]
			description: [
				"## <grad from=#E0A34A to=#FFE3B8 f=0.6><shadow a=0.3>解除诅咒</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>与其他魔典相同，但它只接受诅咒附魔。你的物品会保留所有好东西，但会失去束缚和消失效果。</grad></shadow>"
				""
				"[!tip] 被诅咒的玩家三思而后行。诅咒对你来说就是属性，而《千咒卷轴》会计算每一个诅咒。"
				""
				"<shadow a=0.3><shadow a=0.3><grad from=#A0A0A0 to=#606060>一本求知欲的典籍，外加邪恶性质、一个恶魂之泪、一张幻翼膜和红石。</grad></shadow></shadow>"
			]
			hide_dependency_lines: false
			id: "4C956F782320F662"
			min_width: 340
			subtitle: "<typewriter><grad from=#E0A34A to=#E0A34A>同样的把戏，只有诅咒。</grad>"
			tasks: [{
				id: "5E8F93172DC4782A"
				item: "enigmaticlegacy:curse_transposer"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E0A34A to=#FFE3B8 f=0.6>吞噬邪恶性质的魔典</grad></shadow>"
			x: 1.0d
			y: -2.5d
		}
		{
			dependencies: ["065873A02ECE96B9"]
			description: [
				"## <grad from=#E0A34A to=#FFE3B8 f=0.6><shadow a=0.3>一次性升级所有物品</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将其与任意附魔物品结合，该物品上的所有附魔都会提升一级。可以突破正常的最大限制。</grad></shadow>"
				""
				"[!warn] 这个只能使用一次，需要 Ichor Droplet 和 Purified Heart，所以不能乱用。"
			]
			hide_dependency_lines: false
			id: "19315EDD1D4773D5"
			min_width: 340
			shape: "diamond"
			subtitle: "<typewriter><grad from=#E0A34A to=#E0A34A>突破附魔等级上限。</grad></typewriter>"
			tasks: [{
				id: "49717AE7378B355B"
				item: "enigmaticaddons:bless_amplifier"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E0A34A to=#FFE3B8 f=0.6>占卜之书</grad></shadow>"
			x: 0.0d
			y: -2.5d
		}
		{
			dependencies: ["065873A02ECE96B9"]
			description: [
				"## <grad from=#C8AE86 to=#EBD9B8 f=0.6><shadow a=0.3>非本模组内容</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>这本属于 Enigmatic Delicacy，有自己的章节。它放在典籍旁边，因为那里是任何人都会找它的地方。</grad></shadow>"
			]
			hide_dependency_lines: false
			id: "5D5CB2E7BFF3D929"
			min_width: 320
			optional: true
			subtitle: "<typewriter><grad from=#C8AE86 to=#C8AE86>来自 Enigmatic Delicacy 的问候。</grad></typewriter>"
			tasks: [{
				id: "2C27F9FE469FBB01"
				item: "enigmaticdelicacy:enchantment_duplicator"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>附魔复制器</grad></shadow>"
			x: -1.0d
			y: -2.5d
		}
		{
			dependencies: ["142264209DE37EC3"]
			description: [
				"## <grad from=#E0A34A to=#FFE3B8 f=0.6><shadow a=0.3>无人制作的最佳物品</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>用任意工具、武器或盔甲部件放入合成台，该物品将以满耐久度产出。无需经验、无需铁砧、无需递增成本。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>烈焰粉、龙之息、一个恶魂之泪、一个闪亮甜瓜片、一个幻翼膜和棱镜晶块。</grad></shadow>"
				""
				"[!tip] 末地城市的宝箱里全是这些。多搜刮点塔，修理装备就不再是问题了。"
			]
			id: "544B33FE3196E35B"
			min_width: 330
			size: 1.0d
			subtitle: "<typewriter><grad from=#E0A34A to=#E0A34A>完全修复，无需铁砧，不花成本。</grad>"
			tasks: [{
				id: "521FA85EC7C2F271"
				item: "enigmaticlegacy:mending_mixture"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E0A34A to=#FFE3B8 f=0.6>修补混合物</grad></shadow>"
			x: -3.0d
			y: 1.5d
		}
		{
			dependencies: ["142264209DE37EC3"]
			description: [
				"## <grad from=#E0A34A to=#FFE3B8 f=0.6><shadow a=0.3>自动删除</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将其与任意物品一同合成，该物品便会加入清单。此后，它会自动从你的背包中删除这些物品。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#8FD6FF to=#4FA8E8 f=0.8>完全吸收</grad><grad from=#FFFFFF to=#C7C7C7> 会删除所有列出的物品，且总是如此。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#8FD6FF to=#4FA8E8 f=0.8>最后一堆</grad><grad from=#FFFFFF to=#C7C7C7>会始终留下一堆每种物品，其余全部删除。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#8FD6FF to=#4FA8E8 f=0.8>过量吸收</grad><grad from=#FFFFFF to=#C7C7C7>仅在背包满时才会删除物品。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>手持物品右键切换模式，Shift+右键可关闭。用空物品合成可清空列表。</grad></shadow>"
				""
				"[!warn] 在物品栏中拖动一叠物品并右键点击会立即摧毁该物品。请注意点击位置。"
			]
			id: "78F852F9952817A0"
			min_width: 350
			subtitle: "<typewriter><grad from=#E0A34A to=#E0A34A>一个会跟你一起走的垃圾桶。</grad>"
			tasks: [{
				id: "2826664017142E55"
				item: "enigmaticlegacy:void_stone"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E0A34A to=#FFE3B8 f=0.6>遗忘之基石</grad></shadow>"
			x: -1.5d
			y: 1.5d
		}
		{
			dependencies: ["142264209DE37EC3"]
			description: [
				"## <grad from=#E0A34A to=#FFE3B8 f=0.6><shadow a=0.3>随机掉落任何战利品表</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>右键可循环浏览游戏中的所有战利品表，Shift+右键可循环返回。当前表会显示在工具提示中。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Shift 加右键点击箱子的</grad><grad from=#FFC46B to=#FF9E1F f=0.8>顶部</grad><grad from=#FFFFFF to=#C7C7C7>，即可用选定的表格填充战利品。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>点击任意</grad><grad from=#FF8A8A to=#E03131 f=0.8>其他面</grad><grad from=#FFFFFF to=#C7C7C7>会摧毁该箱子内的所有物品。</grad></shadow>"
				""
				"[!danger] 再读一遍第二行。没有确认，也无法撤销。"
			]
			id: "393A1814F9362C83"
			min_width: 340
			subtitle: "<typewriter><grad from=#E0A34A to=#E0A34A>一个箱子填充器和一个箱子删除器。</grad>"
			tasks: [{
				id: "5152956EC23FCA68"
				item: "enigmaticlegacy:loot_generator"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E0A34A to=#FFE3B8 f=0.6>唯一之箱</grad></shadow>"
			x: 0.0d
			y: 1.5d
		}
		{
			dependencies: ["142264209DE37EC3"]
			description: [
				"## <grad from=#E0A34A to=#FFE3B8 f=0.6><shadow a=0.3>编写你自己的物品文本</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>右键打开界面，放入一个 Lore Fragment，然后输入文字。名称栏支持颜色和格式代码。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>以感叹号开头，将其作为描述行添加。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在后面加数字以替换特定行。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>前面的减号会删除一行而不是添加。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>末地城市的宝箱里会携带这些，用星尘、墨囊、羽毛、水瓶和烈焰粉可以制作一个。</grad></shadow>"
			]
			id: "1BD146576CE0FDEF"
			min_width: 340
			subtitle: "<typewriter><grad from=#E0A34A to=#E0A34A>任何物品均可自定义名称和描述。</grad></typewriter>"
			tasks: [{
				id: "11E3F9552B50FE3B"
				item: "enigmaticlegacy:lore_inscriber"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E0A34A to=#FFE3B8 f=0.6>建筑师墨水盒</grad></shadow>"
			x: 1.5d
			y: 1.5d
		}
		{
			dependencies: ["1BD146576CE0FDEF"]
			description: [
				"## <grad from=#E0A34A to=#FFE3B8 f=0.6><shadow a=0.3>空白页面</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>用墨水盒在上面写字，然后用铁砧将其与任何物品结合，文字就会永久地附着在该物品上。</grad></shadow>"
				""
				"<shadow a=0.3><shadow a=0.3><grad from=#A0A0A0 to=#606060>把你的下界合金镐改个蠢名字。这才是正确的用法。</grad></shadow></shadow>"
			]
			hide_dependency_lines: false
			id: "35408CBDA02F0A05"
			min_width: 320
			subtitle: "<typewriter><grad from=#E0A34A to=#E0A34A>又是纸和木棍。</grad></typewriter>"
			tasks: [{
				id: "550B30AD7042137F"
				item: {
					Count: 1
					id: "enigmaticlegacy:lore_fragment"
					tag: {
						display: { }
					}
				}
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E0A34A to=#FFE3B8 f=0.6>传说碎片</grad></shadow>"
			x: 1.5d
			y: 3.0d
		}
		{
			dependencies: ["142264209DE37EC3"]
			description: [
				"## <grad from=#E0A34A to=#FFE3B8 f=0.6><shadow a=0.3>将某物送往某处</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>站在目的地位置，按住 Shift 并右键。坐标会显示在工具提示中。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>然后左键点击任何生物，只要它在同一维度，就会被传送过去。之后眼睛会消失。</grad></shadow>"
				""
				"[!tip] 移动村民、马匹或固执的蝾螈穿越你的基地，这正是它的用途。"
			]
			id: "203873B984D7F566"
			min_width: 330
			subtitle: "<typewriter><grad from=#E0A34A to=#E0A34A>一次性生物派送。</grad>"
			tasks: [{
				id: "7644BE3D888A159B"
				item: "enigmaticlegacy:extradimensional_eye"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E0A34A to=#FFE3B8 f=0.6>异次元之眼</grad></shadow>"
			x: 3.0d
			y: 1.5d
		}
		{
			dependencies: ["142264209DE37EC3"]
			description: [
				"## <grad from=#E0A34A to=#FFE3B8 f=0.6><shadow a=0.3>紧急出口</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>喝下它，你就能回到床或重生锚处。如果没有，你将会落在主世界的中心，而这通常不是你想要的结果。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它可以被酿造，也会出现在末地城市的宝箱中。</grad></shadow>"
			]
			hide_dependency_lines: true
			id: "03424A7A15507EBD"
			min_width: 330
			subtitle: "<typewriter><grad from=#E0A34A to=#E0A34A>快回家去。现在就回。</grad>"
			tasks: [{
				id: "63383E6F26C59B09"
				item: "enigmaticlegacy:recall_potion"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E0A34A to=#FFE3B8 f=0.6>回想的药水</grad></shadow>"
			x: 4.5d
			y: 1.5d
		}
		{
			dependencies: ["03424A7A15507EBD"]
			description: [
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>无限回溯</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>凝视它即可回家。与药水相同的目的地规则，但它永远不会耗尽。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一瓶回城药水、一颗扭曲之心、一块玻璃板和铁锭。</grad></shadow>"
				""
				"[!danger] 只有在佩戴七咒戒指，并且处于原版三大维度中时才能生效。"
			]
			hide_dependency_lines: false
			id: "2C29284C443852C2"
			min_width: 330
			subtitle: "<typewriter><grad from=#FF8A8A to=#FF8A8A>回城药水，可重复使用。</grad></typewriter>"
			tasks: [{
				id: "49B2126FAC599186"
				item: "enigmaticlegacy:twisted_mirror"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>扭曲的镜子</grad></shadow>"
			x: 4.5d
			y: 3.0d
		}
		{
			dependencies: ["142264209DE37EC3"]
			description: [
				"## <grad from=#E0A34A to=#FFE3B8 f=0.6><shadow a=0.3>会计数的物品存放箱</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>像一个共享末影箱，但仅限书籍。存放在里面的物品会像在你的物品栏中一样被对待。</grad></shadow>"
				""
				"[!tip] 最后那部分才是重点。从物品栏中使用的指南、手册和典籍，放在背包里也能继续发挥作用。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>袋子本身放在末影箱里时它还能用，这简直荒谬至极。</grad></shadow>"
			]
			hide_dependency_lines: true
