			dependencies: ["62A49E5F3D0C4452"]
			description: [
				"## <grad from=#9AA6B0 to=#DCE4EA f=0.6><shadow a=0.3>批量存储</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一个箱子只存放一种物品，别无他物。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#9AA6B0 to=#DCE4EA f=0.8>基础</grad><grad from=#FFFFFF to=#C7C7C7>可容纳 4,096 个物品。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#9AA6B0 to=#DCE4EA f=0.8>高级</grad><grad from=#FFFFFF to=#C7C7C7> 可容纳 8,192 个物品。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#9AA6B0 to=#DCE4EA f=0.8>精英</grad><grad from=#FFFFFF to=#C7C7C7> 持有 32,768 个。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#9AA6B0 to=#DCE4EA f=0.8>终极</grad><grad from=#FFFFFF to=#C7C7C7> 可容纳 262,144 个物品。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>右键堆叠物品可放入，空手右键可取出，破坏时内容物会保留。</grad></shadow>"
				""
				"<c1>Evolved 将这座梯子升至十亿高，仅用一格方块。</c2>"
			]
