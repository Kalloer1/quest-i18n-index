			shape: "hexagon"
			size: 1.35d
			subtitle: "<typewriter><grad from=#E0A64A to=#E0A64A>山羊</grad></typewriter>"
			tasks: [{
				id: "67ECBFF5DF5A11B6"
				item: "mekanism:cardboard_box"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E0A64A to=#FFE0AC f=0.6>纸板箱</grad></shadow>"
			x: -3.5d
			y: -3.5d
		}
		{
			dependencies: ["4A72A59547A24D2F"]
			description: [
				"## <grad from=#3FA9C8 to=#B4EAF7 f=0.6><shadow a=0.3>分类整理</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>可连接到箱子或机器，并根据你设置的过滤器将物品推出。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>过滤器可接受物品名称、标签、模组名称和材质类型，并为每个过滤器指定一种颜色，物流运输机将据此进行分拣运输。</grad></shadow>"
				""
				"[!tip] 将默认颜色设为 none，这样它只会移动过滤器匹配的内容，这几乎总是你想要的。"
			]
			icon: "mekanism:logistical_sorter"
			id: "5CF0DDD0B96D906B"
			rewards: [{
				id: "2C699BE12CF4E924"
				type: "xp"
				xp: 20
			}]
			subtitle: "<typewriter><grad from=#3FA9C8 to=#3FA9C8>脸上的过滤器</grad>"
			tasks: [{
				id: "1E4C09C1CDF5604F"
				item: "mekanism:logistical_sorter"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#3FA9C8 to=#B4EAF7 f=0.6>物流分拣机</grad></shadow>"
			x: -3.5d
			y: -2.0d
		}
		{
			dependencies: ["5CF0DDD0B96D906B"]
			description: [
				"## <grad from=#3FA9C8 to=#B4EAF7 f=0.6><shadow a=0.3>路线技巧</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#3FA9C8 to=#B4EAF7 f=0.8>Diversion Transporter</grad><grad from=#FFFFFF to=#C7C7C7> 只有在您设置的红石条件满足时才会传输物品，因此它像一个阀门一样工作。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#3FA9C8 to=#B4EAF7 f=0.8>限制性运输器</grad><grad from=#FFFFFF to=#C7C7C7> 仍然会运输物品，但会被视为最长路线，因此网络只有在所有其他路径都被阻塞时才会使用它。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它们共同构成了一个溢出线，只有在主容器已满时才会填充次级容器。</grad></shadow>"
			]
			icon: "mekanism:diversion_transporter"
			id: "73271DE75069BEA6"
			optional: true
			rewards: [{
				id: "2DFBB68ABCF52D48"
				type: "xp"
				xp: 15
			}]
			shape: "circle"
			subtitle: "<typewriter><grad from=#3FA9C8 to=#3FA9C8>一个阀门，一个最后的办法</grad>"
			tasks: [{
				id: "49E1475081F175CC"
				item: {
					Count: 1
