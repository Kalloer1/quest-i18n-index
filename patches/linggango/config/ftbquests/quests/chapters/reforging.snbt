	order_index: 0
	quest_links: [ ]
	quests: [
		{
			description: [
				"# <grad from=#FF8C46 to=#FFECBE f=0.6><shadow a=0.3>重铸是什么？</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>重铸能为装备附加额外的</grad><grad from=#5AB9FF to=#5096FF f=0.8>加成</grad><grad from=#FFFFFF to=#C7C7C7>。更高的伤害、更高的护甲、更高的暴击、更快的挖掘速度。游戏中几乎所有属性都能添加到你的装备上。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>这是本整合包最便宜的战力提升之一，但奇怪的是大多数玩家一次都没打开过。请不要成为其中之一。</grad></shadow>"
				""
				"[!success] 重铸永远不会损坏你的物品，也永远不会永久移除任何属性。不满意的结果只需替换为下一次的结果即可。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#FF9E1F to=#FFC46B f=0.6><shadow a=0.3>运作方式</shadow></grad>"
				""
				"1. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>为自己建造一张 </grad><grad from=#5AB9FF to=#5096FF f=0.8>重铸台</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"2. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>给它装备、修复材料和重铸材料，</grad><grad from=#5AB9FF to=#5096FF f=0.8>重铸材料</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"3. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>按下按钮，即可获得随机奖励。</grad></shadow>"
				"[间隔=3]"
				"4. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>如果不喜欢得到的结果，就再试一次吧。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#FF9E1F to=#FFC46B f=0.6><shadow a=0.3>前方未知</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>更好的材料带来更好的加成。 </grad><grad from=#C3FAFF to=#8AD8FF f=0.8>完美</grad><grad from=#FFFFFF to=#C7C7C7> 卷轴完全消除了负面效果，而 </grad><grad from=#FF78B4 to=#FF3C3C f=0.8>星辰</grad><grad from=#FFFFFF to=#C7C7C7> 与 </grad><grad from=#FFECBE to=#FF8C46 f=0.8>巅峰</grad><grad from=#FFFFFF to=#C7C7C7> 卷轴结合，能让神话卷轴的效果远超你在宝箱中能找到的一切。"
				""
				"[!tip] 只需向下阅读即可。每个任务都解释系统的一个小部分，而且阅读起来不会花很长时间。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>感谢我们的 Discord 服务器成员 </grad></shadow><wave a=0.3 f=0.4 w=0.4><grad from=#FCE938 to=#FFF6A6 f=0.8>@d0ugdimad0me</grad></wave><shadow a=0.3><grad from=#A0A0A0 to=#606060> 为 Linggango 建造了整个系统。</grad></shadow>"
			]
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "tiered:textures/gui/reforge_tab_icon.png"
				}
			}
			id: "5EF0A001C1D2E3F4"
			rewards: [
				{
					count: 4
					id: "5EF0C001C1D2E3F4"
					item: "tiered:limestone_chunk"
					type: "item"
				}
				{
					id: "5EF0D001C1D2E3F4"
					type: "xp"
					xp: 25
				}
			]
			size: 1.5d
			subtitle: "免费属性？！！"
			tasks: [{
				id: "5EF0B001C1D2E3F4"
				title: "好的，请教导我如何使用这些物品吧"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#FF8C46 to=#FFECBE f=0.6>重铸"
			x: -3.0d
			y: 0.75d
		}
		{
			dependencies: ["5EF0A001C1D2E3F4"]
			description: [
				"## <grad from=#FF9E1F to=#FFC46B f=0.6><shadow a=0.3>你的工作站</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>本系列任务中的所有事件都发生在</grad><grad from=#5AB9FF to=#5096FF f=0.8>重铸台</grad><grad from=#FFFFFF to=#C7C7C7>上。你需要在中间放置一个</grad><grad from=#5AB9FF to=#5096FF f=0.8>铁砧</grad><grad from=#FFFFFF to=#C7C7C7>，并在周围放置四个</grad><grad from=#A0A0A0 to=#8C8C8C f=0.8>石灰岩块</grad><grad from=#FFFFFF to=#C7C7C7>来制作它。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>放置它，右键点击，你就已经进来了。</grad></shadow>"
				""
				"[!warn] 原版铁砧不再显示这些标签页。如果你在铁砧上找不到重铸标签页，原因就在这里。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#FF9E1F to=#FFC46B f=0.6><shadow a=0.3>两个标签页</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>看屏幕的左上角，你会发现那里有两个小标签页。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#5AB9FF to=#5096FF f=0.8>重铸装备</grad><grad from=#FFFFFF to=#C7C7C7>为物品生成新的加成效果。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#5AB9FF to=#5096FF f=0.8>回收</grad><grad from=#FFFFFF to=#C7C7C7>将重铸的装备熔炼回材料。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>点击任一标签页即可切换。Salvaging 中隐藏着一个名为 Upgrades 的第三个屏幕，但那要晚得多才会出现。</grad></shadow>"
			]
			icon: "tiered:reforging_table"
			icon_scale: 1.1d
			id: "5EF0A002C1D2E3F4"
			rewards: [{
				id: "5EF0D002C1D2E3F4"
				type: "xp"
				xp: 10
			}]
			shape: "hexagon"
			size: 1.25d
			subtitle: "<typewriter><grad from=#9BB7D4 to=#9BB7D4>外观更酷的砧板。</grad>"
			tasks: [{
				id: "5EF0B002C1D2E3F4"
				item: "tiered:reforging_table"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>重铸台</grad></shadow>"
			x: -3.0d
			y: 2.5d
		}
		{
			dependencies: ["5EF0A002C1D2E3F4"]
			description: [
				"## <grad from=#FF9E1F to=#FFC46B f=0.6><shadow a=0.3>填满桌子</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>重铸齿轮标签有三个槽位，按钮生效前，这三个槽位都必须有物品。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"<shadow a=0.3>&l左侧栏位，用于修复的材料。&r</shadow>"
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>该装备通常需要哪种材料来修理。钻石剑需要</grad><grad from=#5AB9FF to=#5096FF f=0.8>钻石</grad><grad from=#FFFFFF to=#C7C7C7>，下界合金装备需要</grad><grad from=#5AB9FF to=#5096FF f=0.8>下界合金锭</grad><grad from=#FFFFFF to=#C7C7C7>，以此类推。</grad></shadow>"
				""
				"[!tip] 不确定物品用什么修复？`Iron Ingot` 可以作为通用替代品，适用于任何没有自身修复材料的情况。"
				""
				"<shadow a=0.3>&l中间栏位，你的装备。&r</shadow>"
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你真正想加强的东西。</grad></shadow>"
				""
				"<shadow a=0.3>&l右侧栏位，重铸材料。&r</shadow>"
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>这是决定你翻滚强度上限的插槽。共有六种材料，每种对应一种稀有度，下一个任务会带你了解所有材料。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#FF9E1F to=#FFC46B f=0.6><shadow a=0.3>然后按下按钮</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>按钮位于屏幕正中央。你的修理材料和重铸材料都会被消耗，而齿轮本身则原封不动地保留下来，并附带全新的加成效果。</grad></shadow>"
				""
				"[!info] 损坏的装备在这里完全没问题。在重铸前无需修理任何东西。"
			]
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "ftblibrary:icons/info_gray"
				}
			}
			id: "5EF0A003C1D2E3F4"
			optional: true
			rewards: [{
				id: "5EF0D003C1D2E3F4"
				type: "xp"
				xp: 10
			}]
			shape: "circle"
			size: 1.0d
			subtitle: "<typewriter><grad from=#9BB7D4 to=#9BB7D4>只需要三个格子！</grad></typewriter>"
			tasks: [{
				id: "5EF0B003C1D2E3F4"
				title: "明白了，收到指令。"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>这些插槽有什么用……</grad></shadow>"
			x: -4.5d
			y: 2.5d
		}
		{
			dependencies: ["5EF0A002C1D2E3F4"]
			description: [
				"## <grad from=#FF9E1F to=#FFC46B f=0.6><shadow a=0.3>支持的设备</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你战斗或使用的几乎所有东西都可以重铸：</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每一件盔甲</grad></shadow>"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>近战武器</grad></shadow>"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>弓和弩箭</grad></shadow>"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>枪械</grad></shadow>"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>法杖与魔杖</grad></shadow>"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>盾牌</grad></shadow>"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>工具</grad></shadow>"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>鞘翅和钓鱼竿</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>模组装备和普通装备一样有效。规则很简单，如果中间槽位能使用该物品，那么它就可以被重铸。</grad></shadow>"
				""
				"[!info] 从箱子里拿出的部分装备可能已经重铸过。这其实是同一个系统，只是提前为你生成好了。你仍然可以将其重铸成更好的装备。"
			]
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "ftblibrary:icons/info_gray"
				}
			}
			id: "5EF0A004C1D2E3F4"
			optional: true
			rewards: [{
				id: "5EF0D004C1D2E3F4"
