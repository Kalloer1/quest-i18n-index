				xp: 10
			}]
			shape: "circle"
			size: 1.0d
			subtitle: "<typewriter><grad from=#9BB7D4 to=#9BB7D4>你拥有的几乎所有东西。</grad></typewriter>"
			tasks: [{
				id: "5EF0B004C1D2E3F4"
				title: "听起来有道理"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>可重铸之物</grad></shadow>"
			x: -1.5d
			y: 2.5d
		}
		{
			dependencies: ["5EF0A002C1D2E3F4"]
			description: [
				"# <grad from=#FF8C46 to=#FFECBE f=0.6><shadow a=0.3>稀有度系统</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>放置在右侧栏位的材料决定了你的随机抽取稀有度，而更高的稀有度则意味着更强的数值结果。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"- <grad from=#A0A0A0 to=#8C8C8C f=0.8><shadow a=0.3>1级，普通，石灰岩块</shadow></grad>"
				"- <grad from=#8CFF8C to=#5AC85A f=0.8><shadow a=0.3>第2级，不常见，黄铁矿块</shadow></grad>"
				"- <grad from=#5AB9FF to=#5096FF f=0.8><shadow a=0.3>三阶，稀有，方铅矿区块</shadow></grad>"
				"- <grad from=#E696FF to=#B446FF f=0.8><shadow a=0.3>第4阶，史诗，查罗石</shadow></grad>"
				"- <grad from=#FFDC50 to=#FFB400 f=0.8><shadow a=0.3>第5阶，传说级，皇冠托帕石</shadow></grad>"
				"- <grad from=#FF78B4 to=#FF3C3C f=0.8><shadow a=0.3>第6阶，神话，痛苦石</shadow></grad>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#FF9E1F to=#FFC46B f=0.6><shadow a=0.3>幸运的升级</shadow></grad>"
				""
				"每种材料都有 <grad from=#5AB9FF to=#5096FF f=0.8>5% 的几率</grad> 获得比自身高一级的稀有度。你的查罗石可能会悄悄给你一个传说级结果，这发生时会是个很棒的惊喜。"
				""
				"[!danger] Mythic 是这条规则的例外。没有任何东西可以靠运气进入 Mythic，因此它总是需要消耗 Painite。Mythic 是解锁 Stars 和 Apex 的稀有度，而这个门槛将永远保持不变。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#FF9E1F to=#FFC46B f=0.6><shadow a=0.3>寻找它们</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它们六个都有配方，并且都会从本整合包中所有维度的</grad><grad from=#5AB9FF to=#5096FF f=0.8>宝箱战利品中掉落</grad><grad from=#FFFFFF to=#C7C7C7>。你能找到哪个取决于该维度的进度程度，Undergarden会给你便宜的，而Armageddon竞技场则会给你好的。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>左侧分支显示了每种材料的精确配方。</grad></shadow>"
			]
			icon: "tiered:painite"
			icon_scale: 1.15d
			id: "5EF0A005C1D2E3F4"
			rewards: [{
				id: "5EF0D005C1D2E3F4"
