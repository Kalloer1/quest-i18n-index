				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#C3FAFF to=#8AD8FF f=0.6>完美的系统</grad></shadow>"
			x: 0.5d
			y: 6.0d
		}
		{
			dependencies: ["5EF0A015C1D2E3F4"]
			description: [
				"## <grad from=#FF9E1F to=#FFC46B f=0.6><shadow a=0.3>这里不允许有坏运气</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你开始时拥有 </grad><grad from=#5AB9FF to=#5096FF f=0.8>3%</grad><grad from=#FFFFFF to=#C7C7C7> 完美几率。每次重铸若未成功，将永久增加额外的 </grad><grad from=#5AB9FF to=#5096FF f=0.8>0.8%</grad><grad from=#FFFFFF to=#C7C7C7> 几率。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>连续失败四十次，下一次就必定会</grad><grad from=#C3FAFF to=#8AD8FF f=0.8>成功</grad><grad from=#FFFFFF to=#C7C7C7>。不过，这只是绝对上限，而非预期情况，因为半数玩家在第十一轮就能抽中完美。 </grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"[!tip] 随时将鼠标悬停在重铸按钮上。它会显示你花费任何材料前的实时完美几率。"
				""
				"[!warn] 每种材料等级的计数器是分开计算的。整天研磨石灰石并不会提高获得痛苦石的几率，因为它们是互不相关的两个独立堆栈。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"[spoiler]投掷1次为3%，10次为10.2%，25次为22.2%，40次则为整整100%。获得完美会重置该等级的计数器回零。"
			]
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "ftblibrary:icons/accept"
				}
			}
			id: "5EF0A016C1D2E3F4"
			rewards: [{
				id: "5EF0D016C1D2E3F4"
				type: "xp"
				xp: 10
			}]
			size: 1.0d
			subtitle: "<typewriter><grad from=#9BB7D4 to=#9BB7D4>你并非命运的奴隶。</grad></typewriter>"
			tasks: [{
				id: "5EF0B016C1D2E3F4"
				title: "所以我只是不停地继续前进下去"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>怜悯系统</grad></shadow>"
			x: 0.5d
			y: 8.0d
		}
		{
			dependencies: ["5EF0A016C1D2E3F4"]
			description: [
				"# <grad from=#FF8C46 to=#FFECBE f=0.6><shadow a=0.3>回收系统</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>“</grad><grad from=#5AB9FF to=#5096FF f=0.8>回收</grad><grad from=#FFFFFF to=#C7C7C7>”选项可将重铸物品熔炼回原始材料。将装备放入左侧栏，按下按钮，即可从右侧栏收集材料。</grad></shadow>"
				""
				"[!danger] 物品在此过程中会被销毁。这是整个系统中唯一不是免费的部分，所以请将你的好装备远离此标签页。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#FF9E1F to=#FFC46B f=0.6><shadow a=0.3>你需要先升到 Tier 1 等级</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>所有人都从 </grad><grad from=#5AB9FF to=#5096FF f=0.8>Salvage Tier 0</grad><grad from=#FFFFFF to=#C7C7C7>开始，而这个等级无法回收任何东西。在升级界面购买 Tier 1 后，此选项才能生效。下一个任务将说明方法。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你只能回收稀有度低于或等于你当前回收等级的装备。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#FF9E1F to=#FFC46B f=0.6><shadow a=0.3>胜算渺茫</shadow></grad>"
				""
				"在 Salvage Tier 1 中，回收有 4% 的几率失败，9% 的几率掉落低一级物品，以及 10.5% 的几率获得高一级物品。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>购买的每个 Salvage Tier 都会降低 1% 的失败率，同时提高升级率。从 </grad><grad from=#5AB9FF to=#5096FF f=0.8>Tier 5</grad><grad from=#FFFFFF to=#C7C7C7> 开始， Salvaging </grad><grad from=#5AB9FF to=#5096FF f=0.8>将完全不可能失败</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[!tip] 将鼠标悬停在拆解界面内的四个数字上，即可随时查看你当前的确切概率。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>这就是用熔炉重铸的垃圾的真正用途。把它们放进去，取出材料，然后用它们来锻造真正的装备。</grad></shadow>"
			]
			icon: "minecraft:grindstone"
			icon_scale: 1.1d
			id: "5EF0A017C1D2E3F4"
			rewards: [{
				id: "5EF0D017C1D2E3F4"
				type: "xp"
				xp: 25
			}]
			shape: "hexagon"
			size: 1.0d
			subtitle: "<typewriter><grad from=#CCAC74 to=#CCAC74>回收你不需要的那些齿轮吧。</grad>"
			tasks: [{
				id: "5EF0B017C1D2E3F4"
				title: "回收时间到了"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>回收系统</grad></shadow>"
			x: 0.0d
			y: 9.5d
		}
		{
			dependencies: ["5EF0A017C1D2E3F4"]
			description: [
				"## <grad from=#FF9E1F to=#FFC46B f=0.6><shadow a=0.3>升级界面</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>打开 Salvaging 标签页，然后点击 </grad><grad from=#5AB9FF to=#5096FF f=0.8>Upgrades</grad><grad from=#FFFFFF to=#C7C7C7> 按钮。放入所需材料，点击按钮，你的 Salvage Tier 就会提升一级。</grad></shadow>"
				""
				"[!success] 部分付款会被记住。先付32中的10，下线一周，回来再付剩下的。你交的任何东西都不会丢失。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#FF9E1F to=#FFC46B f=0.6><shadow a=0.3>价格表</shadow></grad>"
				""
				"- <grad from=#A0A0A0 to=#8C8C8C f=0.8><shadow a=0.3>Tier 1, 32 Limestone Chunk</shadow></grad>"
				"- <grad from=#8CFF8C to=#5AC85A f=0.8><shadow a=0.3>第2级，16个燧石块</shadow></grad>"
				"- <grad from=#5AB9FF to=#5096FF f=0.8><shadow a=0.3>三阶，8个辉铅区块</shadow></grad>"
				"- <grad from=#E696FF to=#B446FF f=0.8><shadow a=0.3>4级，4个查罗石</shadow></grad>"
				"- <grad from=#FFDC50 to=#FFB400 f=0.8><shadow a=0.3>5阶，2个皇冠托帕石</shadow></grad>"
				"- <grad from=#FF78B4 to=#FF3C3C f=0.8><shadow a=0.3>六阶，1 个痛苦石</shadow></grad>"
				"- <grad from=#FFECBE to=#FF8C46 f=0.8><shadow a=0.3>七阶，2 个痛苦石</shadow></grad>"
				"- <grad from=#FFECBE to=#FF8C46 f=0.8><shadow a=0.3>8级，4个Painite</shadow></grad>"
				"- <grad from=#FFECBE to=#FF8C46 f=0.8><shadow a=0.3>九阶，8 个痛苦石</shadow></grad>"
				"- <grad from=#FFECBE to=#FF8C46 f=0.8><shadow a=0.3>Tier 10, 16 痛苦石</shadow></grad>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#FF9E1F to=#FFC46B f=0.6><shadow a=0.3>第7至第10层级很特别</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一旦你爬升至神话层以上，拾荒就不再返还普通岩石，而是开始返还游戏末期的部件：</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Tier 7 回归 </grad><grad from=#C3FAFF to=#8AD8FF f=0.8>星尘</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Tier 8 返还 </grad><grad from=#C3FAFF to=#8AD8FF f=0.8>2 星尘</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>九阶返还一个 </grad><grad from=#C3FAFF to=#8AD8FF f=0.8>恒星核心</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Tier 10 返还一个 </grad><grad from=#FFECBE to=#FF8C46 f=0.8>Apex Crux</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>物品的回收等级表示其实际深度。神话级为6，每颗星星加1，最高9，而巅峰级装备则计为完整的10级。</grad></shadow>"
				""
				"[!info] 你淘汰的东西永远不会被浪费。上周替换的那把五星级神话武器，现在还能返还给你一个恒星核心。"
			]
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "tiered:textures/gui/salvage_upgrade_icon.png"
				}
			}
			id: "5EF0A018C1D2E3F4"
			rewards: [
				{
					count: 8
					id: "5EF0C018C1D2E3F4"
					item: "tiered:limestone_chunk"
					type: "item"
				}
				{
					id: "5EF0D018C1D2E3F4"
					type: "xp"
					xp: 10
				}
			]
			size: 1.0d
			subtitle: "<typewriter><grad from=#9BB7D4 to=#9BB7D4>回报更高，风险更低。</grad></typewriter>"
			tasks: [{
				id: "5EF0B018C1D2E3F4"
				title: "是时候攒钱了"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>废料等级</grad></shadow>"
			x: -2.0d
			y: 9.5d
		}
		{
			dependencies: [
				"5EF0A018C1D2E3F4"
				"5EF0A011C1D2E3F4"
			]
			description: [
				"# <grad from=#C3FAFF to=#8AD8FF f=0.6><shadow a=0.3>星尘</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>使用“稀有或更好”进行重铸，会副产品掉落星尘。无需特殊操作，在重铸时物品就会自然掉落。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"- <grad from=#5AB9FF to=#5096FF f=0.8><shadow a=0.3>Galena, 稀有，每次重铸提升10%</shadow></grad>"
				"- <grad from=#E696FF to=#B446FF f=0.8><shadow a=0.3>Charoite, 史诗级，每次重铸提升20%</shadow></grad>"
				"- <grad from=#FFDC50 to=#FFB400 f=0.8><shadow a=0.3>传奇皇冠托帕石，每次重铸提升30%</shadow></grad>"
				"- <grad from=#FF78B4 to=#FF3C3C f=0.8><shadow a=0.3>Painite, Mythic, 每重铸40%</shadow></grad>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"[!success] 重掷神话装备至少会获得1个星尘，重掷巅峰装备则会获得2个。任何重掷都不会完全失败。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>第7、第8级废料回收也会返还星尘，所以你丢弃的毕业装备会不断补充到同一个堆里。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>每一次未能寻得完美神话修饰器的狩猎，都在悄无声息中锻造着你的巅峰组件。这正是设计初衷所在。</grad></shadow>"
			]
			icon: "tiered:stardust"
			icon_scale: 1.1d
			id: "5EF0A019C1D2E3F4"
			rewards: [{
				id: "5EF0D019C1D2E3F4"
				type: "xp"
				xp: 25
			}]
			shape: "diamond"
			size: 1.2d
			subtitle: "<neon p=6 r=1 a=0.08><grad from=#C3FAFF to=#8AD8FF f=0.6>Stars and Apex 背后的试剂。</grad></neon>"
			tasks: [{
				id: "5EF0B019C1D2E3F4"
				item: "tiered:stardust"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#C3FAFF to=#8AD8FF f=0.6>星尘</grad></shadow>"
			x: -4.0d
			y: 9.5d
		}
		{
			dependencies: ["5EF0A019C1D2E3F4"]
			description: [
				"## <grad from=#FF9E1F to=#FFC46B f=0.6><shadow a=0.3>恒星系统</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将4个星尘</grad><grad from=#C3FAFF to=#8AD8FF f=0.8>围绕1个派纳石</grad><grad from=#FFFFFF to=#C7C7C7>呈十字形排列，即可合成星核。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将装备放入中间槽位，星核放入右侧槽位，物品将获得一颗</grad><grad from=#5AB9FF to=#5096FF f=0.8>星</grad><grad from=#FFFFFF to=#C7C7C7>星。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"[!info] 每颗星星都会使该修饰符上的每个数字增强5%。最多五颗星星，相当于在原有数值基础上增加25%。"
				""
				"[!warn] 星辰仅能用于神话装备。若物品非神话，星辰核心将不会进入该槽位，因此请先用痛苦石对该物品进行重铸。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>星星会显示在工具提示中，用Painite重铸物品会保留所有星星。你已付费的星星永远不会丢失。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>第9级回收可将你早已弃之不顾的装备转化为恒星核心。</grad></shadow>"
			]
			icon: "tiered:stellar_core"
			id: "5EF0A020C1D2E3F4"
			rewards: [{
				id: "5EF0D020C1D2E3F4"
				type: "xp"
				xp: 25
			}]
			shape: "diamond"
			size: 1.25d
			subtitle: "<typewriter><grad from=#9BB7D4 to=#9BB7D4>将神话般的卷轴推向更高的高度。</grad></typewriter>"
			tasks: [{
				id: "5EF0B020C1D2E3F4"
				item: "tiered:stellar_core"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#C3FAFF to=#8AD8FF f=0.6>恒星核心</grad></shadow>"
			x: -4.0d
			y: 11.5d
		}
		{
			dependencies: ["5EF0A020C1D2E3F4"]
			description: [
				"## <grad from=#FFECBE to=#FF8C46 f=0.6><shadow a=0.3>最终升级</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将8个星尘</grad><grad from=#C3FAFF to=#8AD8FF f=0.8>与</grad><grad from=#FFFFFF to=#C7C7C7>星核</grad><grad from=#C3FAFF to=#8AD8FF f=0.8>一同放置，填满整个合成网格。</grad></shadow>"
				""
				"[!danger] Apex Crux 只接受非 Apex 的五星神话物品。任何其他物品都无法放入该槽位，这意味着你不可能不小心浪费一个。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>包括重掷在内，一个完整的 Apex 部件从头到尾大约需要消耗 </grad><grad from=#FF78B4 to=#FF3C3C f=0.8>29 个 Painite</grad><grad from=#FFFFFF to=#C7C7C7>。这是包里最长的追逐，不过一旦替换物品，大部分材料会通过回收返还。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>第10级回收可将巅峰装备返还为巅峰核心。</grad></shadow>"
			]
			icon: "tiered:apex_crux"
			id: "5EF0A021C1D2E3F4"
			rewards: [{
				id: "5EF0D021C1D2E3F4"
				type: "xp"
				xp: 50
			}]
			shape: "diamond"
			size: 1.25d
			subtitle: "<neon p=6 r=1 a=0.08><grad from=#FFECBE to=#FF8C46 f=0.6>八块尘埃和单个核心。</grad></neon>"
			tasks: [{
				id: "5EF0B021C1D2E3F4"
				item: "tiered:apex_crux"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#FFECBE to=#FF8C46 f=0.6>Apex Crux</grad></shadow>"
			x: -6.0d
			y: 11.5d
		}
		{
			dependencies: ["5EF0A021C1D2E3F4"]
			description: [
				"# <grad from=#FFECBE to=#FF8C46 f=0.6><shadow a=0.3>顶峰系统</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Apex 是整个整合包的天花板。在你已经付费的五星基础上，它还额外增加了 </grad><grad from=#FFECBE to=#FF8C46 f=0.8>25%</grad><grad from=#FFFFFF to=#C7C7C7>，所以一件五星 Apex 物品的最终效果是修饰器上数字的 </grad><grad from=#FFECBE to=#FF8C46 f=0.8>1.5 倍</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#FF9E1F to=#FFC46B f=0.6><shadow a=0.3>真正的奖品，能力</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Apex 装备会获得一个由其所携带的修饰符决定的</grad><grad from=#FFECBE to=#FF8C46 f=0.8>独特能力</grad><grad from=#FFFFFF to=#C7C7C7>。在提示框上按住 SHIFT 即可阅读。以下是一些示例：</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>能在16格半径内减缓时间的护甲，持续8秒</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>永不损坏的盔甲，或使所有法术消耗减半的盔甲</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>重击会爆炸的剑，或连续暴击会提升雪球伤害的剑</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>3秒内无视所有伤害的盾牌，或永远不会损坏的盾牌</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>能挖掘基岩，或用经验换取财富之力的工具</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它们分布在盔甲、近战武器、盾牌和工具中，总数超过三十种。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#FF9E1F to=#FFC46B f=0.6><shadow a=0.3>使用主动能力</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>三个按键绑定，均可在 Echelon 分类下的 Controls 中重新绑定：</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>`J` for whatever sits in your main hand</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>`K` for your armor</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>`L` for your off hand</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#FF9E1F to=#FFC46B f=0.6><shadow a=0.3>狩猎你所需的能力</shadow></grad>"
				""
				"[!success] Apex 装备可与普通 Painite 重铸。它会保留星级和 Apex 状态，甚至不消耗左侧栏的修复材料。每次尝试消耗一个 Painite，直到你获得真正想要的能力为止。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每次重掷还能获得2点星尘，这意味着在寻找能力的同时，你也在悄悄为下一件巅峰装备买单。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"<shadow a=0.4><wave a=0.3 f=0.4 w=0.4><grad from=#FFECBE to=#FF8C46 f=0.6>这就是整个系统。现在去打破游戏吧。</grad></wave></shadow>"
			]
