			tasks: [{
				id: "5EF0B006C1D2E3F4"
				item: "tiered:limestone_chunk"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#A0A0A0 to=#8C8C8C f=0.8>石灰岩块</grad></shadow>"
			x: -6.5d
			y: 4.0d
		}
		{
			dependencies: ["5EF0A006C1D2E3F4"]
			description: [
				"## <grad from=#8CFF8C to=#5AC85A f=0.8><shadow a=0.3>第2阶，不常见</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>A </grad><grad from=#5AB9FF to=#5096FF f=0.8>金锭</grad><grad from=#FFFFFF to=#C7C7C7> 放在中间，两个 </grad><grad from=#5AB9FF to=#5096FF f=0.8>钻石</grad><grad from=#FFFFFF to=#C7C7C7> 放左右，两个 </grad><grad from=#5AB9FF to=#5096FF f=0.8>绿宝石</grad><grad from=#FFFFFF to=#C7C7C7> 放上下。这样你就能得到两个区块了。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>价格依然很实惠，而且生成的数值明显优于普通物品。</grad></shadow>"
			]
			icon: "tiered:pyrite_chunk"
			id: "5EF0A007C1D2E3F4"
			rewards: [{
				id: "5EF0D007C1D2E3F4"
