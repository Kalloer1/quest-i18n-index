			x: -1.5d
			y: -16.5d
		}
		{
			dependencies: ["781ADC1BA1C81715"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>村庄中央有一座</grad><grad from=#B98A5E to=#EBD1B0 f=0.8>黄金侏儒雕像</grad><grad from=#FFFFFF to=#C7C7C7>的侏儒村庄。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>用</grad><grad from=#B98A5E to=#EBD1B0 f=0.8>红侏儒帽</grad><grad from=#FFFFFF to=#C7C7C7>右键雕像，戈布就会醒来。这就是首个首领的完整触发条件。</grad></shadow>"
				""
				"{image:customtextures:textures/courtgnome.png width:250 height:100 align:center}"
			]
			icon: "terramity:gnome_statue"
			id: "5A5C930FB49EFC24"
