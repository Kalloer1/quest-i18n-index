			title: "<shadow a=0.4><grad from=#E24B4B to=#FFB4B4 f=0.6>美德</grad></shadow>"
			x: 2.5d
			y: 11.5d
		}
		{
			dependencies: ["19CBC92610B35600"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>源自美德。游戏中唯一能将 profanum 和 antiprism 转化为 </grad><grad from=#F2D98A to=#FFF7DC f=0.8>Reverium</grad><grad from=#FFFFFF to=#C7C7C7> 的原料。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>多带几件。Reverium 齿轮可不便宜。</grad></shadow>"
			]
			icon: "terramity:angel_feather"
