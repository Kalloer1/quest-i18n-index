		}
		{
			dependencies: ["5D9252B669B888FE"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将长矛笔直投向主世界的天空。它会刺穿天际，而天际会派来使者与你商议。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>那件东西就是 </grad><grad from=#F2D98A to=#FFF7DC f=0.8>Virtue</grad><grad from=#FFFFFF to=#C7C7C7>，而它的羽毛是 Reverium 的唯一来源。</grad></shadow>"
			]
