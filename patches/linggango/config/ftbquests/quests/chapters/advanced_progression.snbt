					tag: {
						"patchouli:book": "terramity:terramity_guidebook"
					}
				}
				type: "item"
			}]
			size: 1.6d
			subtitle: "<typewriter><grad from=#8FCB3F to=#8FCB3F>下界合金之上的所有东西都始于此处</grad>"
			tasks: [{
				id: "5D3C1ADD7DE70815"
				title: "好的，我收到了。请继续提供需要翻译的文本。"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#8FCB3F to=#DDF5A8 f=0.6>Terramity</grad></shadow>"
			x: 0.0d
			y: -11.5d
		}
		{
			dependencies: ["43ACAF3A3EA50806"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Terramity 依靠配饰运行。戒指、护身符、饰品、围巾、腰带、手套，所有这些都放入 Curios 插槽，并与你穿着的任何盔甲叠加。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>如果战斗感觉不可能，答案通常是更好的装备，而不是更好的剑。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>第一个任务的纸板项链是你的入门装备。它是纸板做的，不要太在意它。</grad></shadow>"
				""
				"{ \"text\": \"The full accessory catalogue\", \"underlined\": \"true\", \"color\": \"#E29AD2\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"44F86CB070F12FF2\" } }"
			]
			icon: "terramity:ring_of_rejuvenation"
			id: "335A39A6D119AC50"
			optional: true
			rewards: [{
				id: "176DBB7E50F8BE10"
				type: "xp"
				xp: 5
			}]
			shape: "circle"
			size: 1.0d
			subtitle: "<typewriter><grad from=#C8AE86 to=#C8AE86>配饰比盔甲更常派上用场，超乎你的想象</grad>"
			tasks: [{
				id: "10790F00C0B5C7F7"
				item: "terramity:cardboard_necklace"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>穿戴物品</grad></shadow>"
			x: 0.0d
			y: -13.0d
		}
		{
			dependencies: ["43ACAF3A3EA50806"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>小矮人会在世界各地游荡，如果你手持正确的物品右键他们，他们会和你交易。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>给它一个 </grad><grad from=#C8AE86 to=#EBD9B8 f=0.8>钻石</grad><grad from=#FFFFFF to=#C7C7C7>，它就会把帽子送给你。</grad></shadow>"
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>拿任意一个 </grad><grad from=#C8AE86 to=#EBD9B8 f=0.8>Terramity 首领掉落物</grad><grad from=#FFFFFF to=#C7C7C7>，它就会给你一个随机的贵重物品作为回报。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>它们的帽子也是召唤首个首领的物品，所以这不仅仅是个新奇玩意儿。</grad></shadow>"
			]
			icon: {
				Count: 1
