	quests: [
		{
			description: [
				"# <grad from=#E86BB4 to=#FFD1EC f=0.6><shadow a=0.3>模组中最紧的插槽</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>饰品是这里种类最多的，你开始时只有一个通用槽位。获得更多空间将是一项大工程。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>一瓶Ichor药水</grad><grad from=#FFFFFF to=#C7C7C7>可永久添加一个。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>Enchanter's Pearl</grad><grad from=#FFFFFF to=#C7C7C7> 穿戴时若被诅咒，会添加一个。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFE9A8 to=#F5C542 f=0.8>Potioneer's Pearl</grad><grad from=#FFFFFF to=#C7C7C7> 佩戴时会增加一个，前提是你品行端正。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFE9A8 to=#F5C542 f=0.8>迷人徽章</grad><grad from=#FFFFFF to=#C7C7C7> 在光对齐版本中添加一个。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFE9A8 to=#F5C542 f=0.8>重生的摇篮</grad><grad from=#FFFFFF to=#C7C7C7> 在此基础上再增加一个。</grad></shadow>"
				""
				"[!tip] 这里没有强制要求。选择能解决你实际问题的护身符，然后继续吧。"
			]
			icon: "enigmaticlegacy:ichor_bottle"
			id: "22176FD50BF22849"
			min_width: 350
			shape: "hexagon"
			size: 1.5d
			subtitle: "<typewriter><grad from=#E86BB4 to=#E86BB4>你开始时只有一个物品栏位。</grad></typewriter>"
			tasks: [{
				id: "579EC01A5E09D3BB"
				title: "一个格子，多种意见"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#E86BB4 to=#FFD1EC f=0.6>护身符</grad></shadow>"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["22176FD50BF22849"]
			description: [
				"## <grad from=#E86BB4 to=#FFD1EC f=0.6><shadow a=0.3>采矿，搞定！</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+30 百分比</grad><grad from=#FFFFFF to=#C7C7C7> 挖掘速度。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+1</grad><grad from=#FFFFFF to=#C7C7C7> 时运。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+2.15</grad><grad from=#FFFFFF to=#C7C7C7> 方块挖掘范围，比听起来要实用得多。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>地下自动开启夜视。右键护身符可关闭该功能。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>需要消耗一个地球之心，所以并非首日物品，但通常是第一个值得制作的物品。</grad></shadow>"
			]
			id: "0E690A6DB91DBCAE"
			min_width: 340
			size: 1.25d
			subtitle: "<typewriter><grad from=#E86BB4 to=#E86BB4>大多数人从不摘下的护身符。</grad></typewriter>"
			tasks: [{
				id: "241FD3CA5F660E75"
				item: "enigmaticlegacy:mining_charm"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E86BB4 to=#FFD1EC f=0.6>宝藏猎人护身符</grad></shadow>"
			x: -6.0d
			y: 1.5d
		}
		{
			dependencies: ["22176FD50BF22849"]
			description: [
				"## <grad from=#E86BB4 to=#FFD1EC f=0.6><shadow a=0.3>战斗护身符</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+25 percent</grad><grad from=#FFFFFF to=#C7C7C7> 对不死生物的伤害。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+10 percent</grad><grad from=#FFFFFF to=#C7C7C7> 对其他敌对生物造成的伤害。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+1</grad><grad from=#FFFFFF to=#C7C7C7> 战利品掠夺。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>怪物会掉落双倍经验值。</grad></shadow>"
				""
				"<shadow a=0.3><shadow a=0.3><grad from=#A0A0A0 to=#606060>骷髅头、灵魂灯笼、烈焰粉、一瓶附魔和一件下界合金锭。</grad></shadow></shadow>"
			]
			id: "28656E06CF9CD32D"
			min_width: 340
			subtitle: "<typewriter><grad from=#E86BB4 to=#E86BB4>适合喜欢战斗的人。</grad></typewriter>"
			tasks: [{
				id: "0C91074AE05431E2"
				item: "enigmaticlegacy:monster_charm"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E86BB4 to=#FFD1EC f=0.6>怪物猎人徽章</grad></shadow>"
			x: -4.5d
			y: 1.5d
		}
		{
			dependencies: ["22176FD50BF22849"]
			description: [
				"## <grad from=#E86BB4 to=#FFD1EC f=0.6><shadow a=0.3>重命名自己</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在砧上重命名徽标，该名称将取代你头顶上的命名牌。你还可以看到自己的命名牌，这是其他物品无法做到的。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Shift+右键可切换显示自身标签。</grad></shadow>"
				""
				"[!info] 沙漠金字塔的宝箱是唯一生成地点，且与光对齐的版本还增加了一个护身符槽位。"
			]
			id: "5E6801D7411BBA66"
			min_width: 330
			subtitle: "<typewriter><grad from=#E86BB4 to=#E86BB4>纯属装饰，而且大家都喜欢。</grad></typewriter>"
			tasks: [{
				id: "1E3385FAFF0EA81D"
				item: "enigmaticlegacy:insignia"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E86BB4 to=#FFD1EC f=0.6>迷人的徽章</grad></shadow>"
			x: 1.5d
			y: 1.5d
		}
		{
			dependencies: ["22176FD50BF22849"]
			description: [
				"## <grad from=#E86BB4 to=#FFD1EC f=0.6><shadow a=0.3>安静的人</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>此护身符在本整合包中无合成配方，也无战利品表条目。如果你有，则是从其他地方获得的。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>列于此处是为了让收藏完整。它的所有功能都写在物品本身上了。</grad></shadow>"
			]
			id: "549B3129B6BEB358"
			min_width: 330
			optional: true
			subtitle: "<typewriter><grad from=#E86BB4 to=#E86BB4>按住物品上的 Shift 键查看详情。</grad>"
			tasks: [{
				id: "1C8ABE53113916BA"
				item: "enigmaticlegacy:ascension_amulet"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E86BB4 to=#FFD1EC f=0.6>飞升护符</grad></shadow>"
			x: 6.0d
			y: 1.5d
		}
		{
			dependencies: ["22176FD50BF22849"]
			description: [
				"## <grad from=#E86BB4 to=#FFD1EC f=0.6><shadow a=0.3>死亡不再消耗你的生命</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>穿戴此物时，死亡后所有物品都会保留。经验和灵魂水晶会消失，但装备会保留。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+3</grad><grad from=#FFFFFF to=#C7C7C7> 攻击伤害。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+15 百分比</grad><grad from=#FFFFFF to=#C7C7C7> 生命窃取。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>被你注视的生物会减速和变弱。</grad></shadow>"
				""
				"在几乎所有情况下都比《不死卷轴》更有价值，因为死亡时它不会消耗任何东西。"
			]
			id: "60AFE6322CC55E93"
			min_width: 340
			subtitle: "<typewriter><grad from=#E86BB4 to=#E86BB4>死亡时保留物品栏中的物品。</grad>"
			tasks: [{
				id: "5C0DC10D856D7A5B"
				item: "enigmaticlegacy:eldritch_amulet"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E86BB4 to=#FFD1EC f=0.6>蔑视的遗嘱</grad></shadow>"
			x: 4.5d
			y: 1.5d
		}
		{
			dependencies: ["22176FD50BF22849"]
			description: [
				"## <grad from=#E86BB4 to=#FFD1EC f=0.6><shadow a=0.3>自由之人</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你在一个世界里开箱开到的第一个原版箱子，会给你一个这个。永远只有一个，仅此一个。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它静静地待在那里，直到你决定唤醒它。物品以最不祥的方式警告你，这样做是个馊主意。</grad></shadow>"
				""
				"[!info] 一旦唤醒，它会揭示佩戴魅力徽章的任何玩家的真实姓名，而且会有东西开始注意到你。后半部分主要是氛围效果。大部分是。"
			]
			id: "2DC1C0FAAB255199"
			min_width: 340
			subtitle: "<typewriter><grad from=#E86BB4 to=#E86BB4>不要唤醒它。或者，唤醒它吧。</grad>"
			tasks: [{
				id: "1A72E8AE53590AC0"
				item: "enigmaticlegacy:enigmatic_eye"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E86BB4 to=#FFD1EC f=0.6>沉睡之眼</grad></shadow>"
			x: 3.0d
			y: 1.5d
		}
		{
			dependencies: ["22176FD50BF22849"]
			description: [
				"## <grad from=#E86BB4 to=#FFD1EC f=0.6><shadow a=0.3>海洋纪念碑解谜者</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你踏入的任何水域都会在你周围半径为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>4</grad><grad from=#FFFFFF to=#C7C7C7> 格的范围内被立即吸收。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一块海绵、一个鹦鹉螺壳、一个海洋之心、一个末影之眼和一个恶魂之泪。</grad></shadow>"
				""
				"[!tip] 在袭击遗迹时穿戴此物，整座建筑会在你游过时自行排水。"
			]
			id: "20987CA8244275BB"
			min_width: 320
			subtitle: "<typewriter><grad from=#E86BB4 to=#E86BB4>水就停住了。</grad></typewriter>"
			tasks: [{
				id: "7954E0CC03D03F35"
				item: "enigmaticlegacy:mega_sponge"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E86BB4 to=#FFD1EC f=0.6>外推巨型海绵</grad></shadow>"
			x: -3.0d
			y: 1.5d
		}
		{
			dependencies: ["22176FD50BF22849"]
			description: [
				"## <grad from=#E86BB4 to=#FFD1EC f=0.6><shadow a=0.3>减半所有锻造台成本</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>锻造消耗的经验值减半。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你的砧板能用的更久。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将两件未经附魔、未受损坏的同种工具锻造，可得到一件</grad><grad from=#D9A5FF to=#B06BE8 f=0.8>不会损坏的</grad><grad from=#FFFFFF to=#C7C7C7>工具。</grad></shadow>"
				""
				"[!tip] 最后一行不是笔误，这才是制作这个的真正原因。一个魔法石英戒指、一颗钻石、铁和一个下界合金废料。"
			]
			id: "09B6409CDDE2D0A9"
			min_width: 340
			subtitle: "<typewriter><grad from=#E86BB4 to=#E86BB4>铁砧不再是一种负担了。</grad></typewriter>"
			tasks: [{
				id: "0AFC17EEA388115C"
				item: "enigmaticaddons:forger_gem"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E86BB4 to=#FFD1EC f=0.6>锻造者宝石</grad></shadow>"
			x: -1.5d
			y: 1.5d
		}
		{
			dependencies: ["22176FD50BF22849"]
			description: [
				"## <grad from=#E86BB4 to=#FFD1EC f=0.6><shadow a=0.3>火焰护身符</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>免疫大部分火焰伤害，并且可以在岩浆上行走。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>站在岩浆中会治愈你。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>20 percent</grad><grad from=#FFFFFF to=#C7C7C7> 击中燃烧目标时恢复生命。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>10% 的几率完全抵消一次攻击。</grad></shadow>"
				""
				"<shadow a=0.3><shadow a=0.3><grad from=#A0A0A0 to=#606060>想要一个净化之心和一个烈焰核心，所以你放弃一个附魔石来建造它。</grad></shadow></shadow>"
			]
			id: "3FC095DD75A58A36"
			min_width: 340
			subtitle: "<typewriter><grad from=#E86BB4 to=#E86BB4>岩浆现在变成了一个游泳池。</grad></typewriter>"
			tasks: [{
				id: "3E711D7F0DF311D1"
				item: "enigmaticaddons:scorched_charm"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E86BB4 to=#FFD1EC f=0.6>灼日护符</grad></shadow>"
			x: 0.0d
			y: 1.5d
		}
		{
			dependencies: ["22176FD50BF22849"]
			description: [
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>缺失的健康值是一种资源</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>此处的所有数值都会乘以你当前缺失的生命值百分比。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+2</grad><grad from=#FFFFFF to=#C7C7C7> 满倍率时的攻击伤害。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+3</grad><grad from=#FFFFFF to=#C7C7C7> 满倍率时的攻击速度。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+0.5</grad><grad from=#FFFFFF to=#C7C7C7> 移动速度在最大乘数下。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+1</grad><grad from=#FFFFFF to=#C7C7C7> 伤害抗性在最大乘数下生效。</grad></shadow>"
				""
				"[!warn] 满血时完全没用。半血时是模组里最强的护身符。"
				""
				"[!danger] 除非你佩戴着七诅咒之戒，否则无法将此物品放入插槽。"
			]
			id: "5EDC5F0D31FEF4F7"
			min_width: 350
			subtitle: "<typewriter><grad from=#FF8A8A to=#FF8A8A>越弱，就越可怕。</grad></typewriter>"
			tasks: [{
				id: "76A5A4D0E671C5BB"
				item: "enigmaticlegacy:berserk_charm"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>血染勇武的徽章</grad></shadow>"
			x: -6.0d
			y: 3.0d
		}
		{
			dependencies: ["22176FD50BF22849"]
			description: [
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>附魔台作弊码</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+1</grad><grad from=#FFFFFF to=#C7C7C7>佩戴时占一个饰品栏位。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>更多附魔，等级更高。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>诅咒和宝藏附魔现在都可以通过表格生成。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你再也不需要青金石来进行附魔了。完全不需要。</grad></shadow>"
				""
				"[!tip] 如果你同时佩戴了《千咒卷轴》，从桌上滚落的诅咒会生效。免费属性。"
				""
				"[!danger] 除非你佩戴着七诅咒之戒，否则无法将此物品放入插槽。"
			]
			id: "35B03131AB84BE21"
			min_width: 350
			subtitle: "<typewriter><grad from=#FF8A8A to=#FF8A8A>免费附魔，外加一个附魔台。</grad></typewriter>"
			tasks: [{
				id: "086ADAA9104B4632"
				item: "enigmaticlegacy:enchanter_pearl"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>附魔者珍珠</grad></shadow>"
			x: -4.5d
			y: 3.0d
		}
		{
			dependencies: ["22176FD50BF22849"]
			description: [
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>贸易</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你的所有护甲都停止工作了。全部失效。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你造成的每一点伤害都会翻倍。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一旦击中目标的血量低于其生命值的</grad><grad from=#FFC46B to=#FF9E1F f=0.8>75%</grad><grad from=#FFFFFF to=#C7C7C7>，或被诅咒目标的</grad><grad from=#FFC46B to=#FF9E1F f=0.8>50%</grad><grad from=#FFFFFF to=#C7C7C7>，就会造成额外伤害并为你恢复生命。</grad></shadow>"
				""
				"[!danger] 装备后有60秒的冷却时间，因此不能在战斗中切换。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>此整合包重写了配方。大约需要两个下界合金剑来合成地狱合金锭。</grad></shadow>"
				""
				"[!danger] 除非你佩戴着七诅咒之戒，否则无法将此物品放入插槽。"
			]
			id: "55C3757651948AA9"
			min_width: 350
			subtitle: "<typewriter><grad from=#FF8A8A to=#FF8A8A>双倍伤害。零护甲。</grad>"
			tasks: [{
				id: "6B859FE33372E1B2"
				item: "enigmaticaddons:hell_blade_charm"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>地狱之刃护符</grad></shadow>"
			x: -3.0d
			y: 3.0d
		}
		{
			dependencies: ["22176FD50BF22849"]
			description: [
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>侵略性徽章</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+4</grad><grad from=#FFFFFF to=#C7C7C7> 攻击伤害。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+16 百分比</grad><grad from=#FFFFFF to=#C7C7C7> 攻击速度。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+5 百分比</grad><grad from=#FFFFFF to=#C7C7C7>移动速度。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>该物品的提示框拒绝解释自己，只留下一句讽刺的话，这非常符合该附加组件的风格。</grad></shadow>"
				""
				"[!warn] 无法与冒险者徽章共享物品栏，装备后会锁定位置，戴上后会进入30秒的冷却时间。被诅咒的玩家冷却时间为一分钟。"
			]
			id: "2ECAD815BA02DFED"
			min_width: 330
			optional: true
			subtitle: "<typewriter><grad from=#FF8A8A to=#FF8A8A>可能和平时有点不一样。</grad>"
			tasks: [{
				id: "3D564ED21FE7B295"
				item: "enigmaticaddons:despair_insignia"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>绝望的徽章</grad></shadow>"
			x: -1.5d
			y: 3.0d
		}
		{
			dependencies: ["22176FD50BF22849"]
			description: [
				"## <grad from=#E86BB4 to=#FFD1EC f=0.6><shadow a=0.3>自我施加的挑战</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>装备此物时无法破坏方块。作为回报，你将获得 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>+2</grad><grad from=#FFFFFF to=#C7C7C7> 攻击伤害和 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>+10 百分比</grad><grad from=#FFFFFF to=#C7C7C7> 攻击速度。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>按住 Shift 可关闭限制，所以没听起来那么残酷。</grad></shadow>"
				""
				"<shadow a=0.3><shadow a=0.3><grad from=#A0A0A0 to=#606060>钻石剑、绿宝石、黄金和黑曜石。</grad></shadow></shadow>"
			]
			id: "53FB9A5028747487"
			min_width: 330
			optional: true
			subtitle: "<typewriter><grad from=#E86BB4 to=#E86BB4>阻止你挖矿。故意的。</grad></typewriter>"
			tasks: [{
				id: "1478A76EB5590A4E"
				item: "enigmaticaddons:adventure_charm"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E86BB4 to=#FFD1EC f=0.6>冒险者徽章</grad></shadow>"
			x: 1.5d
			y: 3.0d
		}
		{
			dependencies: ["22176FD50BF22849"]
			description: [
				"## <grad from=#E86BB4 to=#FFD1EC f=0.6><shadow a=0.3>突袭保险</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+150 percent</grad><grad from=#FFFFFF to=#C7C7C7> 对掠夺者的伤害。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>50 percent</grad><grad from=#FFFFFF to=#C7C7C7> 受到掠夺者造成的伤害减少。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>发射时能救你一命，并摧毁周围的一切。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>不死图腾、邪恶精华和下界合金。它可以在物品栏或饰品栏中使用，无需手持。</grad></shadow>"
				""
				"[!danger] 除非你戴着七诅咒之戒，否则上面每一行都会被关闭。它会安静地待在物品栏里，什么也不做。"
			]
			id: "4BB2F03BDCD9473D"
			min_width: 340
			subtitle: "<typewriter><grad from=#E86BB4 to=#E86BB4>一个可以穿戴的不死图腾。</grad>"
			tasks: [{
				id: "4F7EDFF21F7A6ACC"
				item: "enigmaticaddons:totem_of_malice"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E86BB4 to=#FFD1EC f=0.6>恶意图腾</grad></shadow>"
			x: 0.0d
			y: 3.0d
		}
		{
			dependencies: ["22176FD50BF22849"]
			description: [
				"## <grad from=#E86BB4 to=#FFD1EC f=0.6><shadow a=0.3>绑定于首次接触</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你的神秘护身符，外加一块大地碎片和金块。它会与第一个拾取者绑定，从此，用物品自己的话说，命运便已注定。</grad></shadow>"
				""
				"<shadow a=0.3><shadow a=0.3><grad from=#A0A0A0 to=#606060>也就是说，它会永远留给你，听起来很戏剧性，对吧？</grad></shadow></shadow>"
			]
			id: "4AA80B5D36C6E15B"
			min_width: 330
			optional: true
			subtitle: "<typewriter><grad from=#E86BB4 to=#E86BB4>它会选中自己的主人，并且永远不会放手。</grad>"
			tasks: [{
				id: "46EA47B8333E2504"
				item: "enigmaticlegacy:unwitnessed_amulet"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E86BB4 to=#FFD1EC f=0.6>无人见证的护身符</grad></shadow>"
			x: 3.0d
			y: 3.0d
		}
		{
			dependencies: ["22176FD50BF22849"]
			description: [
				"## <grad from=#E86BB4 to=#FFD1EC f=0.6><shadow a=0.3>伪造自己的死亡</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你并未死亡，而是恢复了 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>15% 的</grad><grad from=#FFFFFF to=#C7C7C7>生命值，并在接下来的 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>5 分钟内处于不可感知状态。其他人会看到死亡信息。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>持续期间，没有任何东西能看见或锁定你，包括玩家在内。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>攻击或触碰任何东西都会提前结束。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>10分钟</grad><grad from=#FFFFFF to=#C7C7C7>冷却，使用后消耗，共可消耗</grad><grad from=#FFC46B to=#FF9E1F f=0.8>2</grad><grad from=#FFFFFF to=#C7C7C7>次。</grad></shadow>"
				""
				"[!warn] 该模组被标记为未完成。虽然能用，但请勿据此制定计划。"
			]
