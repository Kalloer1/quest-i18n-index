					}
				}
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#8CFF8C to=#19F220 f=0.8>转化焦点</grad></shadow>"
			x: 13.5d
			y: 1.5d
		}
		{
			dependencies: ["50CD9ED26DBA55C6"]
			description: [
				"## <grad from=#7CF5A0 to=#C8FFD8 f=0.6><shadow a=0.3>发光零食</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Metamorpher 配方。一个 </grad><grad from=#8CFF8C to=#19F220 f=0.8>糖</grad><grad from=#FFFFFF to=#C7C7C7> 和任意 </grad><grad from=#8CFF8C to=#19F220 f=0.8>水果</grad><grad from=#FFFFFF to=#C7C7C7> 可换取 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>16 积分</grad><grad from=#FFFFFF to=#C7C7C7>。苹果、浆果、紫颂果、甜瓜，只要是水果标签的物品均可。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>无需咀嚼动画即可直接食用，恢复一格饥饿度，除此之外并无害处。这种即时食用的特性在战斗中非常方便，但它存在的真正原因是本章底部的 </grad><grad from=#8CFF8C to=#19F220 f=0.8>荧光琼脂</grad><grad from=#FFFFFF to=#C7C7C7>，每个方块需要五个这种物品。</grad></shadow>"
			]
			id: "5041B0BFA02E6253"
			rewards: [
				{
					count: 8
					id: "43A0ABEDC4432084"
					item: "experienceobelisk:experience_jelly"
					type: "item"
				}
				{
					id: "46A4EA49674B992D"
					type: "xp"
					xp: 15
				}
			]
			size: 1.0d
			subtitle: "<typewriter><grad from=#7ED47E to=#7ED47E>即食食物，和一种食材。</grad>"
			tasks: [{
				count: 4L
				id: "19EB82EF034D49E2"
				item: { Count: 4, id: "experienceobelisk:experience_jelly" }
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#8CFF8C to=#19F220 f=0.8>荧光果冻</grad></shadow>"
			x: 14.5d
			y: -2.0d
		}
		{
			dependencies: ["50CD9ED26DBA55C6"]
			description: [
				"# <grad from=#19F220 to=#B4FFB0 f=0.6><shadow a=0.3>议会，成长了</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Metamorpher 配方。一个 </grad><grad from=#8CFF8C to=#19F220 f=0.8>Astute Assembly</grad><grad from=#FFFFFF to=#C7C7C7>、一个 </grad><grad from=#8CFF8C to=#19F220 f=0.8>金锭</grad><grad from=#FFFFFF to=#C7C7C7> 和任意 </grad><grad from=#8CFF8C to=#19F220 f=0.8>树苗</grad><grad from=#FFFFFF to=#C7C7C7>，可获得 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>315 积分</grad><grad from=#FFFFFF to=#C7C7C7>，大约从零开始升到 22 级。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>如果说精明的议会是一块电路板，那么原初议会就是内部蕴含着生命力的电路板。它是 </grad><grad from=#8CFF8C to=#19F220 f=0.8>Bibliophage</grad><grad from=#FFFFFF to=#C7C7C7> 的心脏，也是所有三种 </grad><grad from=#8CFF8C to=#19F220 f=0.8>Flasks</grad><grad from=#FFFFFF to=#C7C7C7> 的核心。 </grad></shadow>"
				""
				"[!info] 这是通往模组经验值获取部分的入口。此任务下方的所有内容都基于此建造。"
			]
			id: "6C8BC462702B425F"
			rewards: [{
				id: "650543F3D0E69963"
				type: "xp"
				xp: 40
			}]
			shape: "pentagon"
			size: 1.0d
			subtitle: "<typewriter><grad from=#7ED47E to=#7ED47E>一个有生命力的电路。</grad></typewriter>"
			tasks: [{
				id: "08A652DB53F7107F"
				item: "experienceobelisk:primordial_assembly"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#19F220 to=#B4FFB0 f=0.6>原始议会</grad></shadow>"
			x: 14.5d
			y: 2.0d
		}
		{
			dependencies: ["6C8BC462702B425F"]
			description: [
				"## <grad from=#7CF5A0 to=#C8FFD8 f=0.6><shadow a=0.3>Infinite Buckets</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>三者形状相同。顶部角落各有一个风味物品，中间是一个</grad><grad from=#8CFF8C to=#19F220 f=0.8>Primordial Assembly</grad><grad from=#FFFFFF to=#C7C7C7>，两侧各有一个</grad><grad from=#8CFF8C to=#19F220 f=0.8>Whisperglass</grad><grad from=#FFFFFF to=#C7C7C7>，底部还有一个Whisperglass。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#8CFF8C to=#19F220 f=0.8>波塞冬之瓶</grad><grad from=#FFFFFF to=#C7C7C7>。需要两个海带和一个水桶。每次倒水可放置水，消耗 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>7点</grad><grad from=#FFFFFF to=#C7C7C7> 能量。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#8CFF8C to=#19F220 f=0.8>哈迪斯之瓶</grad><grad from=#FFFFFF to=#C7C7C7>。需要两块下界砖和一个岩浆桶。放置岩浆可获得 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>160 积分</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#8CFF8C to=#19F220 f=0.8>混沌瓶</grad><grad from=#FFFFFF to=#C7C7C7>。两个黑曜石和一个空桶。删除任意液体的源方块，可获得 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>1 积分</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>点数来自你的经验条而非方尖碑，每个瓶子的冷却时间很短。它们还能填充和清空炼药锅、水浸方块，并倒入你点击的任何流体储罐中。</grad></shadow>"
				""
				"[!tip] 混沌才是你真正要携带的。一点就能擦除一个岩浆湖的方块，或者在没有海绵的情况下排干被淹没的地牢。"
			]
