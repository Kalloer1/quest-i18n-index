			y: 5.0d
		}
		{
			dependencies: ["172C9DD0B3E1DDF6"]
			description: [
				"## <grad from=#7CF5A0 to=#C8FFD8 f=0.6><shadow a=0.3>永不消亡的殖民地</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>营养琼脂是一种永不腐坏、永不耗尽的受感染方块。每秒钟，它有 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>0.5%</grad><grad from=#FFFFFF to=#C7C7C7> 的几率感染与其相邻的一个方块，平均而言，每三分钟多一点，它就能永久地将一个相邻的新鲜架子转化过来。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>这就是自动化农场的引擎。用普通书架围住它，等书架碎了就替换掉，这样菌毯就能自己感染新的书架，你再也不用碰Bibliophage了。</grad></shadow>"
				""
				"[!tip] 琼脂会发光，效果不错，但如果光影性能不佳，可以在配置文件中关闭。它和书架一样，能阻止遗忘的尘埃穿过。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>营养琼脂是下两个任务中升级琼脂的原材料，所以要多做一些。</grad></shadow>"
			]
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "experienceobelisk:block/nutrient_agar_outer"
				}
			}
			id: "7FDCD56A3ABB5128"
			rewards: [{
				id: "05D21E6D56C7E429"
				type: "xp"
				xp: 60
			}]
			size: 1.0d
			subtitle: "<typewriter><grad from=#C48CFF to=#C48CFF>永久感染。</grad>"
			tasks: [{
				id: "1C9A17C39D0F3318"
				observe_type: 0
				timer: 0L
				title: "看向一个营养琼脂方块"
				to_observe: "experienceobelisk:nutrient_agar"
				type: "observation"
			}]
			title: "<shadow a=0.4><grad from=#C48CFF to=#7169A2 f=0.8>营养琼脂</grad></shadow>"
			x: 20.0d
			y: 5.0d
		}
		{
			dependencies: ["7FDCD56A3ABB5128"]
			description: [
				"## <grad from=#7CF5A0 to=#C8FFD8 f=0.6><shadow a=0.3>更快的书架</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Metamorpher 配方。一个 </grad><grad from=#C48CFF to=#7169A2 f=0.8>Nutrient Agar</grad><grad from=#FFFFFF to=#C7C7C7>、四个 </grad><grad from=#8CFF8C to=#19F220 f=0.8>Honeycomb</grad><grad from=#FFFFFF to=#C7C7C7> 和四个 </grad><grad from=#8CFF8C to=#19F220 f=0.8>Glowstone Dust</grad><grad from=#FFFFFF to=#C7C7C7> 可获得 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>550 积分</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"每秒将永久感染降低两倍，即1%，并缩短附近所有受感染书架的生成延迟。书架越早吐出球体，就越早吐出全部五十个球体，这就是纯粹的速度提升。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#7CF5A0 to=#C8FFD8 f=0.6><shadow a=0.3>放置至关重要</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>奖励取决于琼脂与架子的接触方式，并且会乘算叠加。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>紧挨着共享一个 </grad><grad from=#8CFF8C to=#19F220 f=0.8>面</grad><grad from=#FFFFFF to=#C7C7C7>，会乘以 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>1.35</grad><grad from=#FFFFFF to=#C7C7C7>倍。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>沿一个轴共享对角线</grad><grad from=#8CFF8C to=#19F220 f=0.8>边缘，乘以</grad><grad from=#FFFFFF to=#C7C7C7>1.15倍。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>仅共享一个 </grad><grad from=#8CFF8C to=#19F220 f=0.8>角</grad><grad from=#FFFFFF to=#C7C7C7> 会乘以 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>1.10</grad><grad from=#FFFFFF to=#C7C7C7> 倍。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每种类别最多可计算六个琼脂块，且它们可以相互堆叠。四面封闭的架子速度已快了近三倍半。</grad></shadow>"
			]
			id: "4BA5534A7C39FC92"
			rewards: [
				{
					count: 4
					id: "396A8053C847BA51"
					item: "minecraft:honeycomb"
					type: "item"
				}
				{
					id: "2C1F925C57CBE366"
					type: "xp"
					xp: 50
				}
			]
			size: 1.0d
			subtitle: "<typewriter><grad from=#C48CFF to=#C48CFF>缩短延迟时间。</grad></typewriter>"
			tasks: [{
				id: "000733B576F8F9FD"
				item: "experienceobelisk:insightful_agar"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#C48CFF to=#7169A2 f=0.8>洞悉凝胶</grad></shadow>"
			x: 20.0d
			y: 3.5d
		}
		{
			dependencies: ["7FDCD56A3ABB5128"]
			description: [
				"## <grad from=#7CF5A0 to=#C8FFD8 f=0.6><shadow a=0.3>更丰富的球体</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Metamorpher 配方。一个 </grad><grad from=#C48CFF to=#7169A2 f=0.8>Nutrient Agar</grad><grad from=#FFFFFF to=#C7C7C7>、四个 </grad><grad from=#8CFF8C to=#19F220 f=0.8>Phantom Membranes</grad><grad from=#FFFFFF to=#C7C7C7> 和四个 </grad><grad from=#C48CFF to=#7169A2 f=0.8>Calcarine Matrix</grad><grad from=#FFFFFF to=#C7C7C7>，可获得 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>1,395 积分</grad><grad from=#FFFFFF to=#C7C7C7>，从零开始是 30 级。</grad></shadow>"
				""
				"与 Insightful Agar 几何相同，乘数分别为 1.35、1.15 和 1.10，但作用于每个球体的数值而非延迟。其感染几率为每秒 2%，是三者中最快的。"
				""
				"[!success] 一个书架最多只会生成五十个球。Insightful 能加快生成速度，Extravagant 能让每个球的价值更高，而只有 Extravagant 能提高书架在坍塌前支付的总数。两者结合使用。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>幻影膜是噩梦瓶存在的原因。喝一瓶，等一夜，然后收集即可。</grad></shadow>"
			]
			id: "5C542B43FDE93EFD"
			rewards: [
				{
					count: 4
					id: "22E98A5BABED10D8"
					item: "minecraft:phantom_membrane"
					type: "item"
				}
				{
					id: "06E8C40AB28D6955"
					type: "xp"
					xp: 75
				}
			]
			size: 1.0d
			subtitle: "<typewriter><grad from=#C48CFF to=#C48CFF>更大的球体。</grad></typewriter>"
			tasks: [{
				id: "7E77B8B079858F30"
				item: "experienceobelisk:extravagant_agar"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#C48CFF to=#7169A2 f=0.8>奢华琼脂</grad></shadow>"
			x: 21.5d
			y: 5.0d
		}
		{
			dependencies: [
				"4BA5534A7C39FC92"
				"5C542B43FDE93EFD"
			]
			description: [
				"# <grad from=#19F220 to=#B4FFB0 f=0.6><shadow a=0.3>将所有整合起来</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>以上都是零件。这就是它们组成的形状。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#7CF5A0 to=#C8FFD8 f=0.6><shadow a=0.3>简单的布局</shadow></grad>"
				""
				"1. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将一座</grad><grad from=#8CFF8C to=#19F220 f=0.8>方尖碑</grad><grad from=#FFFFFF to=#C7C7C7>放在房间中央，并在设置中将半径设为</grad><grad from=#FFC46B to=#FF9E1F f=0.8>5</grad><grad from=#FFFFFF to=#C7C7C7>。它会清理自身周围一个11格大小的立方体区域。</grad></shadow>"
				"[间隔=3]"
				"2. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在立方体内部建造一个由</grad><grad from=#8CFF8C to=#19F220 f=0.8>书架</grad><grad from=#FFFFFF to=#C7C7C7>组成的空心外壳。如果负担得起书，就用附魔书架，否则就用普通书架。</grad></shadow>"
				"[间隔=3]"
				"3. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将 </grad><grad from=#C48CFF to=#7169A2 f=0.8>agar</grad><grad from=#FFFFFF to=#C7C7C7>方块埋在壳内，使尽可能多的架子与它们的一个面接触。一排 Insightful 和一排 Extravagant 效果很好。</grad></shadow>"
				"[间隔=3]"
				"4. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在地板下放置漏斗或创造传动带以收集 </grad><grad from=#C48CFF to=#7169A2 f=0.8>遗忘的尘埃</grad><grad from=#FFFFFF to=#C7C7C7>，用于喂养变形器，从而生产更多琼脂。</grad></shadow>"
				"[间隔=3]"
				"5. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>时不时地补充一下破损的架子。琼脂会再次感染它们。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#7CF5A0 to=#C8FFD8 f=0.6><shadow a=0.3>目标数字</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>普通书架在15分钟内可获600分，</grad><grad from=#FFC46B to=#FF9E1F f=0.8>被奢华琼脂包围的书架可获2000分以上，</grad><grad from=#FFFFFF to=#C7C7C7>而同一位置的附魔书架可获8000分以上，</grad><grad from=#FFC46B to=#FF9E1F f=0.8>这比从一个方块开始，从1级升到60级的总得分还要高。</grad></shadow>"
				""
				"[!tip] 方尖碑可以储存经验，记忆石板能让你在48格内任意位置绘制，而超频喷泉能让你从零秒升到30级。这就是循环。一旦开启，经验就不再是你需要考虑的事情了。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>站在农场里取下Fortuitous Amulet。这样它会把书架上的球吸到你身上，而不是吸到Obelisk上。</grad></shadow>"
			]
			icon: "experienceobelisk:infected_enchanted_bookshelf"
			id: "67A3BC2A105A39B0"
			min_width: 340
			rewards: [
				{
					id: "4AA58E69153D5BF1"
					type: "xp"
					xp: 100
				}
				{
					exclude_from_claim_all: true
					id: "705A5F0615F2BB21"
					table_id: 4067690183644308744L
					type: "random"
				}
			]
			shape: "gear"
			size: 1.0d
			subtitle: "<typewriter><grad from=#EBD9B8 to=#EBD9B8>循环闭合了。</grad></typewriter>"
			tasks: [{
				id: "308C4EF8F8FD9C22"
				title: "建造了一个"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>建造图书馆</grad></shadow>"
			x: 22.0d
			y: 3.0d
		}
	]
	title: "<shadow a=0.4><grad from=#19F220 to=#B4FFB0 f=0.6>认知</grad></shadow>"
