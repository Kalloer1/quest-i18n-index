				xp: 5
			}]
			shape: "circle"
			size: 1.0d
			subtitle: "<typewriter><grad from=#9B7BD4 to=#9B7BD4>这是泰拉瑞亚吗？</grad>"
			tasks: [{
				id: "26BA99A448DD0DBB"
				item: "biomancy:porous_primal_flesh"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#9B7BD4 to=#D8C6F2 f=0.6>多孔原始血肉</grad></shadow>"
			x: -2.0d
			y: 12.5d
		}
		{
			dependencies: ["497A4305BDABC7C2"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>以棋盘格模式放置Bloomberries和vein blocks可获得四个。将其中一个挂在Tendon Chain上，它就会变成一盏</grad><grad from=#9B7BD4 to=#D8C6F2 f=0.8>Bloom-Lantern</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>想要一个不刺眼的淡紫色光源，生物发光凝胶会在生物锻造炉中制作蓝色和黄色的生物灯笼。</grad></shadow>"
			]
			id: "045D68B1D8DFEB84"
			optional: true
			rewards: [{
				id: "23B15E271A562890"
