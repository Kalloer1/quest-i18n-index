			}]
			title: "<shadow a=0.4><grad from=#C24BC7 to=#EFA9F2 f=0.6>阅读摇篮曲</grad></shadow>"
			x: 0.0d
			y: 10.0d
		}
		{
			dependencies: ["13FF211A43B0A862"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>摇篮明确拒绝以下物品：龙蛋、刷怪器、海洋之心、命名牌、包裹、音乐唱片、鞘翅、盔甲、工具、任何形式的下界合金和潜影盒。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>其他东西它至少会试着吃掉，如果不认识物品，它会认为这是一种侮辱。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>药水数量，模组会按效果读取：</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>再生、瞬间治愈、生命提升和吸收</grad><grad from=#FFFFFF to=#C7C7C7>补充生命能量。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>运气、饱和度与肥沃度</grad><grad from=#FFFFFF to=#C7C7C7>提升成功几率。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>饥饿、恶心、失明、伤害、凋零、中毒和流血</grad><grad from=#FFFFFF to=#C7C7C7>会提高敌意。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>虚弱、凋零、中毒和流血</grad><grad from=#FFFFFF to=#C7C7C7>会提升疾病效果。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>不祥之兆、黑暗、腐蚀性酸液和原始侵扰</grad><grad from=#FFFFFF to=#C7C7C7>会提升异常度。</grad></shadow>"
			]
			icon: "minecraft:potion"
			id: "6522C3C1F3CD8C7E"
			min_width: 340
			optional: true
			rewards: [{
