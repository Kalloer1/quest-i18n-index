				xp: 5
			}]
			shape: "circle"
			size: 1.0d
			subtitle: "<typewriter><grad from=#9B7BD4 to=#9B7BD4>品红色，显而易见</grad>"
			tasks: [{
				id: "435BA40E147D8D7E"
				item: "biomancy:bloomlight"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#9B7BD4 to=#D8C6F2 f=0.6>Bloomlight</grad></shadow>"
			x: -6.5d
			y: 8.0d
		}
		{
			dependencies: ["318DE22ED16F859E"]
			description: [
				"# <grad from=#FF8A4C to=#FFCFA8 f=0.6><shadow a=0.3>分解者</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>獠牙、生肉、一个胆囊和活肉放在合成台上。这个需要手动合成，因为你还没有制作它的材料。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>给它燃料，它就会把物品分解成</grad><grad from=#FF8A4C to=#FFCFA8 f=0.8>基础组件</grad><grad from=#FFFFFF to=#C7C7C7>。肉块、骨片、纤维、矿物碎片、石粉，还有那些你真正想要的稀有物品。</grad></shadow>"
				""
				"[!info] 腐肉是游戏中最便宜的输入物，能产出1到3个肉块，还有几率产出弹性纤维。你的僵尸农场突然有了用武之地。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>一颗钻石能换4到8个宝石碎片。用钻石砸砧台前先想想清楚。</grad></shadow>"
			]
			id: "2ECE65F4EECE9300"
			rewards: [{
				id: "4F9FE8C8F8FBF43B"
				type: "xp"
				xp: 15
			}]
			shape: "square"
			size: 1.5d
			subtitle: "<typewriter><grad from=#FF8A4C to=#FF8A4C>将任何物品分解为零件</grad>"
			tasks: [{
				id: "3A52BD55A8D1F7D2"
				item: "biomancy:decomposer"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#FF8A4C to=#FFCFA8 f=0.6>分解者</grad></shadow>"
			x: 0.0d
			y: 15.0d
		}
		{
			dependencies: ["2ECE65F4EECE9300"]
			description: [
				"# <grad from=#C8AE86 to=#EBD9B8 f=0.6><shadow a=0.3>各部分的来源</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>生物锻造炉建造的一切都由九种材料构成。学会这张表，你将再也不用为这个模组打开JEI了。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>肉块</grad><grad from=#FFFFFF to=#C7C7C7> 由腐肉、生肉和肉块生成。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>骨骼碎片</grad><grad from=#FFFFFF to=#C7C7C7> 来自骨头、骨粉、头骨和整鱼。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>弹性纤维</grad><grad from=#FFFFFF to=#C7C7C7> 由腐肉、线、鸡肉和幻翼膜合成。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>Tough Fibres</grad><grad from=#FFFFFF to=#C7C7C7> 由皮革、羽毛、鳞甲、爪和鹦鹉螺壳制成。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>矿物碎片</grad><grad from=#FFFFFF to=#C7C7C7> 来自黏土、铜、紫颂果和贝壳。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>石粉</grad><grad from=#FFFFFF to=#C7C7C7> 由黏土、泥土、沙子和原矿石制成。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>宝石碎片</grad><grad from=#FFFFFF to=#C7C7C7> 由钻石、绿宝石、青金石、紫水晶和石英制成。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>异域尘埃</grad><grad from=#FFFFFF to=#C7C7C7> 由烈焰棒、紫颂果、凋零玫瑰和图腾合成。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>荧光凝胶</grad><grad from=#FFFFFF to=#C7C7C7>由发光浆果、发光墨水、蘑菇灯和蛙灯制成。</grad></shadow>"
				""
				"[!tip] 此整合包独有两条额外路线。Goety Ectoplasm会分解成1至3个Bioluminescent Goo，Industrial Foregoing的Pink Slime Ingots会产出2至4个Elastic Fibres。"
			]
