	order_index: 19
	quest_links: [ ]
	quests: [
		{
			description: [
				"# <grad from=#FC3272 to=#FCAEC7 f=0.6><shadow a=0.3>欢迎来到生物魔法世界</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Biomancy 是一款不含金属的科技模组。没有电线，没有齿轮，也没有熔炉。每台机器都由 </grad><grad from=#FC3272 to=#FCAEC7 f=0.8>肉、骨头和纤维</grad><grad from=#FFFFFF to=#C7C7C7>生长而成，而这些材料则来自一分钟前还在四处走动的事物。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>整个模组就是一个循环。杀死生物，收集零件，喂养碗，获得更好的零件。升级速度比你想象的快得多。</grad></shadow>"
				""
				"[!warn] 本章不需要铁、钻石或锻造台。需要数量惊人的猪。"
			]
			icon: "biomancy:primordial_core"
			icon_scale: 1.3d
			id: "2B9E792779EE6575"
			rewards: [{
				id: "6BBCCCCF0016642C"
				type: "xp"
				xp: 10
			}]
			shape: "hexagon"
			size: 1.6d
			subtitle: "<typewriter><grad from=#FC3272 to=#FC3272>这里的一切曾经都鲜活过</grad>"
			tasks: [{
				id: "528AD3555219C06B"
				title: "哇... 这个模组真有意思"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#FC3272 to=#FCAEC7 f=0.6>欢迎来到生物魔法世界</grad></shadow>"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["2B9E792779EE6575"]
			description: [
				"# <grad from=#FF6B6B to=#FFC2C2 f=0.6><shadow a=0.3>精选切片</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>生物魔法想要</grad><grad from=#FF6B6B to=#FFC2C2 f=0.8>生的</grad><grad from=#FFFFFF to=#C7C7C7>肉。牛肉、猪肉、鸡肉和羊肉是模组认为的四种优质肉，而且它永远都想要更多。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>鱼和兔子也算生肉，本整合包将 Alex's Mobs 和 Alex's Caves 的肉都归为一类。</grad></shadow>"
				""
				"[!danger] 熟肉比没用还糟。给Primordial Cradle熟牛排会降低999%的成功率，并毁掉整批物品。"
			]
			id: "555E12B1686D2FAD"
			rewards: [{
				id: "6A1998C0A85F90CF"
				type: "xp"
				xp: 10
			}]
			shape: "pentagon"
			size: 1.25d
			subtitle: "<typewriter><grad from=#FF6B6B to=#FF6B6B>四种类型，且都不要烹饪</grad>"
			tasks: [
				{
					id: "1BB86BB1E0B22F41"
					item: "minecraft:beef"
					type: "item"
				}
				{
					id: "5712B453C05FE1A5"
					item: "minecraft:porkchop"
					type: "item"
				}
				{
					id: "28B4298216C4C109"
					item: "minecraft:chicken"
					type: "item"
				}
				{
					id: "4A41931ADA4BF0AA"
					item: "minecraft:mutton"
					type: "item"
				}
			]
			title: "<shadow a=0.4><grad from=#FF6B6B to=#FFC2C2 f=0.6>肉是一种资源</grad></shadow>"
			x: 0.0d
			y: 2.5d
		}
		{
			dependencies: ["555E12B1686D2FAD"]
			description: [
				"# <grad from=#C24BC7 to=#EFA9F2 f=0.6><shadow a=0.3>原始核心</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>合成台上放四块生肉、两块腐肉、一个蜘蛛眼和两颗末影珍珠。这就是该模组的完整配方。</grad></shadow>"
				""
				"[!info] 上排：猪肉、腐肉、牛肉。中排：末影珍珠、蜘蛛眼、末影珍珠。下排：鸡肉、腐肉、羊肉。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>血肉掠夺者</grad><grad from=#C24BC7 to=#EFA9F2 f=0.8>和原始摇篮</grad><grad from=#FFFFFF to=#C7C7C7>各吃一个，所以继续前进前请先制作两个。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>这也是你之后能给摇篮喂的最疯狂的东西。先记住这一点。</grad></shadow>"
			]
			id: "361F788B12AE4B03"
			rewards: [
				{
					id: "1679729EF41F0404"
					type: "xp"
					xp: 15
				}
				{
					exclude_from_claim_all: true
					id: "45900E3B1ABA5892"
					table_id: 4067690183644308744L
					type: "random"
				}
			]
			shape: "star"
			size: 1.25d
			subtitle: "<typewriter><grad from=#C24BC7 to=#C24BC7>第一件不祥的遗物</grad>"
			tasks: [{
				id: "345590BF3E1BBD0A"
				item: "biomancy:primordial_core"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#C24BC7 to=#EFA9F2 f=0.6>Primordial Core</grad></shadow>"
			x: 0.0d
			y: 5.0d
		}
		{
			dependencies: ["361F788B12AE4B03"]
			description: [
				"# <grad from=#E8434F to=#FF9EA5 f=0.6><shadow a=0.3>血肉掠夺者</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>骨头、生肉和一个原始核心。它能造成 </grad><grad from=#E8434F to=#FF9EA5 f=0.8>8点伤害</grad><grad from=#FFFFFF to=#C7C7C7>，并且有500点耐久度，听起来很慷慨，直到你知道它消耗耐久度的方式为止。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>手持该物品，击杀任何生物后，除了正常掉落外，还会额外掉落</grad><grad from=#E8434F to=#FF9EA5 f=0.8>掠夺战利品</grad><grad from=#FFFFFF to=#C7C7C7>：獠牙、爪子、肌腱、腺体、骨髓。此保证会消耗额外的耐久度，每次击杀消耗一点。</grad></shadow>"
				""
				"[!tip] 用原始血肉块可以修复它，之后你会在那些方块里畅游。可别小看这玩意儿。"
			]
			id: "45A04E76B160E5FD"
			rewards: [{
				id: "67CE6CDC0385387D"
				type: "xp"
				xp: 15
			}]
			shape: "diamond"
			size: 1.3d
			subtitle: "<typewriter><grad from=#E8434F to=#E8434F>易碎、丑陋、强制的</grad>"
			tasks: [{
				id: "56D1AF040B284796"
				item: {
					Count: 1
					id: "biomancy:despoil_sickle"
					tag: {
						Damage: 0
					}
				}
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E8434F to=#FF9EA5 f=0.6>血肉掠夺者</grad></shadow>"
			x: 3.5d
			y: 5.0d
		}
		{
			dependencies: ["45A04E76B160E5FD"]
			description: [
				"# <grad from=#C8AE86 to=#EBD9B8 f=0.6><shadow a=0.3>谁会掉落什么物品</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>战利品掉落与生物相关，而非运气。学会列表后，再也不会误杀生物了。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>尖牙和利爪</grad><grad from=#FFFFFF to=#C7C7C7>来自掠食者。狼、狐狸、猫、豹猫、熊猫、北极熊和蝙蝠。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>筋和胆囊</grad><grad from=#FFFFFF to=#C7C7C7>几乎来自所有会心跳的生物。牛、猪、村民、蜘蛛、末影人。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>骨髓</grad><grad from=#FFFFFF to=#C7C7C7> 来自骷髅和流浪者。凋零骷髅会掉落凋零版本的骨髓。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>不稳定腺体</grad><grad from=#FFFFFF to=#C7C7C7> 来自苦力怕、烈焰人和恶魂。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>毒腺</grad><grad from=#FFFFFF to=#C7C7C7> 来自蜜蜂、洞穴蜘蛛和河豚。</grad></shadow>"
				""
				"[!info] 掠夺也会在掠夺掉落物上生效。幼崽从不掉落物品，且击杀必须由你完成。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>Hoglins和zoglins会掉落獠牙，但没有爪子。鹦鹉会掉落爪子，但没有獠牙。Wardens会掉落骨髓和回声碎片。</grad></shadow>"
			]
			icon: "biomancy:mob_claw"
			icon_scale: 1.2d
			id: "2352027864446855"
			min_width: 360
			rewards: [{
				id: "67030CA8AC68FEA3"
				type: "xp"
				xp: 10
			}]
			shape: "hexagon"
			size: 1.4d
			subtitle: "<typewriter><grad from=#C8AE86 to=#C8AE86>谁会掉落什么物品</grad>"
			tasks: [{
				id: "5DEAFBBE8676AE7E"
				title: "已收到"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>屠夫的目录</grad></shadow>"
			x: 3.5d
			y: 7.5d
		}
		{
			dependencies: ["2352027864446855"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>富含矿物质的磨牙。狼、狐狸、猫、熊猫、北极熊、蝙蝠、猪灵和猪灵堡垒都会携带它们。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>摇篮喜欢獠牙。每根獠牙都会带来 </grad><grad from=#FF6B6B to=#FFC2C2 f=0.8>+8 成功率</grad><grad from=#FFFFFF to=#C7C7C7> 和 </grad><grad from=#FF6B6B to=#FFC2C2 f=0.8>+5 敌意</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>到达后，生物锻造的备用材料：6个矿物碎片、8个骨头碎片和1个石粉。</grad></shadow>"
			]
			id: "47FCFF662453A5FE"
			optional: true
			rewards: [{
				id: "5B5B8AC1F1BB82E7"
				type: "xp"
				xp: 5
			}]
			shape: "diamond"
			size: 1.0d
			subtitle: "<typewriter><grad from=#FF6B6B to=#FF6B6B>掠食者牙齿</grad></typewriter>"
			tasks: [{
				id: "5BA34504D589FE2D"
				item: "biomancy:mob_fang"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#FF6B6B to=#FFC2C2 f=0.6>利齿</grad></shadow>"
			x: 2.5d
			y: 9.0d
		}
		{
			dependencies: ["2352027864446855"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>由坚韧纤维制成的硬化爪。与獠牙的掠食者列表相同，但去掉了猪灵，并增加了鹦鹉。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>其中三个要晚些放入</grad><grad from=#FF6B6B to=#FFC2C2 f=0.8>Ravenous Claws</grad><grad from=#FFFFFF to=#C7C7C7>，所以不要烧掉摇篮祭品里找到的每一个。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>生物锻造备用配方：7个矿物碎片、8个坚韧纤维和1个石粉。</grad></shadow>"
			]
			id: "5E5878E7C89FE265"
			optional: true
			rewards: [{
				id: "41E633C169D35364"
				type: "xp"
				xp: 5
			}]
			shape: "diamond"
			size: 1.0d
			subtitle: "<typewriter><grad from=#FF6B6B to=#FF6B6B>相同的动物，不同的结局</grad>"
			tasks: [{
				id: "7E1A44E8BF7DB9B8"
				item: "biomancy:mob_claw"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#FF6B6B to=#FFC2C2 f=0.6>锋利之爪</grad></shadow>"
			x: 4.5d
			y: 9.0d
		}
		{
			dependencies: ["2352027864446855"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>弹性纤维组织。几乎所有带脊椎的生物都会掉落，导致你最终会囤积太多这种东西。</grad></shadow>"
				""
				"喂养摇篮，消耗 </grad><grad from=#FF6B6B to=#FFC2C2 f=0.8>5 生物质</grad><grad from=#FFFFFF to=#C7C7C7>，使其略微平静。学徒屠夫用一颗绿宝石购买四个。"
			]
			id: "25E0E6C4074CD9E8"
			optional: true
			rewards: [{
				id: "62D3D9476DE3C305"
				type: "xp"
				xp: 5
			}]
			shape: "diamond"
			size: 1.0d
			subtitle: "<typewriter><grad from=#FF6B6B to=#FF6B6B>你会被这些淹死的</grad></typewriter>"
			tasks: [{
				count: 8L
