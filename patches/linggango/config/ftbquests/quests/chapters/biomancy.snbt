					table_id: 4067690183644308744L
					type: "random"
				}
			]
			shape: "pentagon"
			size: 1.3d
			subtitle: "<typewriter><grad from=#C24BC7 to=#C24BC7>生命的背叛</grad>"
			tasks: [{
				id: "7B13E3657AC4AEBB"
				item: "biomancy:living_flesh"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#C24BC7 to=#EFA9F2 f=0.6>活体血肉</grad></shadow>"
			x: 0.0d
			y: 12.5d
		}
		{
			dependencies: ["318DE22ED16F859E"]
			description: [
				"当异常骰子掷出时，摇篮会跳过普通球体，生成一个</grad><grad from=#C24BC7 to=#EFA9F2 f=0.8>原始体</grad><grad from=#FFFFFF to=#C7C7C7>。掉落物相同，威胁更大，向地面注入的原始能量也翻倍。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Living Flesh 在 +55 异常度和 Primordial Core 在 +100 异常度是两大关键。Ender pearls 加 50，Exotic Compound 加 20。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>里面还有一个</grad><grad from=#C24BC7 to=#EFA9F2 f=0.8>Legacy Flesh Blob</grad><grad from=#FFFFFF to=#C7C7C7>。只有在敌意低于-420时才会出现，这大约需要一次性吃掉三个附魔金苹果。根本不可能有人偶然发现这个。"
			]
			icon: "biomancy:primordial_flesh_blob_spawn_egg"
			id: "67B2DF4598D0E440"
			optional: true
			rewards: [{
				id: "64DB98F14A883892"
				type: "xp"
				xp: 15
			}]
			shape: "circle"
			size: 1.0d
			subtitle: "<typewriter><grad from=#C24BC7 to=#C24BC7>异常骰子掷出结果了</grad>"
			tasks: [{
				id: "2B3C9D2F1C3D4BA5"
				title: "天哪，不好了"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#C24BC7 to=#EFA9F2 f=0.6>原始粘液块</grad></shadow>"
			x: 1.5d
			y: 12.5d
		}
		{
			dependencies: ["13FF211A43B0A862"]
			description: [
				"# <grad from=#B23A6B to=#E88BAE f=0.6><shadow a=0.3>恶性静脉</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每一次失败的献祭都会铺平摇篮下的方块，并在周围区域蔓延出血管。它们会爬行、攀爬墙壁，并将接触到的东西转化为自己的一部分。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>剪下它们以获得物品。它们是恶性肉块和荧光花的基础材料。</grad></shadow>"
				""
				"[!warn] 矿脉最多可携带15个电荷，并且会自行扩散。如果你不想在基地里建一个肉农场，就把摇篮放在你愿意放弃的地方。"
			]
			id: "7F30882A1FAC6E53"
			rewards: [{
				id: "22736B387B316194"
				type: "xp"
				xp: 10
			}]
			shape: "square"
			size: 1.0d
			subtitle: "<typewriter><grad from=#B23A6B to=#B23A6B>摇篮心情不好</grad></typewriter>"
			tasks: [{
				id: "455C4ED6D342ABDE"
				item: "biomancy:malignant_flesh_veins"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#B23A6B to=#E88BAE f=0.6>恶性肉脉</grad></shadow>"
			x: -2.0d
			y: 8.0d
		}
		{
			dependencies: ["7F30882A1FAC6E53"]
			description: [
				"# <grad from=#B23A6B to=#E88BAE f=0.6><shadow a=0.3>土丘</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每次献祭、成功或失败，都会将</grad><grad from=#B23A6B to=#E88BAE f=0.8>原始能量</grad><grad from=#FFFFFF to=#C7C7C7>注入摇篮下方的地面。每批2048至4096点，具体取决于发射时生命能量条的满度。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>血管消耗能量，建造起一座土丘。尖塔、空洞的密室、原始肉体的墙壁。它按照自己的节奏生长，从不索取。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在密室中，你会发现 </grad><grad from=#B23A6B to=#E88BAE f=0.8>原始孔洞</grad><grad from=#FFFFFF to=#C7C7C7>，这也是人们忍受这座土丘的唯一理由。</grad></shadow>"
				""
				"[!tip] 想快速堆起土堆，就故意喂坏摇篮吧。失败也能储存能量。"
			]
			icon: "biomancy:primal_flesh"
			id: "3C1DE048EE37A310"
			rewards: [{
				id: "2D555B4FCC94AC9C"
				type: "xp"
				xp: 15
			}]
			shape: "square"
			size: 1.0d
			subtitle: "<typewriter><grad from=#B23A6B to=#B23A6B>它会自己建造自己</grad>"
			tasks: [{
				id: "43A38FA854B1332D"
				title: "让它生长起来"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#B23A6B to=#E88BAE f=0.6>肉山</grad></shadow>"
			x: -3.5d
			y: 8.0d
		}
		{
			dependencies: ["3C1DE048EE37A310"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一团布满孔洞、渗出胃液的肉块。它们只生长在土丘的密室中，别无他处。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>该方块本身是</grad><grad from=#B23A6B to=#E88BAE f=0.8>腐蚀枪刃</grad><grad from=#FFFFFF to=#C7C7C7>的弹药补给，需要四个才能使用。</grad></shadow>"
				""
				"[!info] 这个没有配方。建造土堆是唯一获取方式，而这正是建造土堆的意义所在。"
			]
			id: "44D8121BA7F27262"
			rewards: [{
				id: "6504752EE2ACC8DB"
				type: "xp"
				xp: 15
			}]
			shape: "square"
			size: 1.0d
			subtitle: "<typewriter><grad from=#B23A6B to=#B23A6B>密集恐惧症？</grad>"
			tasks: [{
				id: "5AAD46BEAC1BE68E"
				item: "biomancy:primal_orifice"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#B23A6B to=#E88BAE f=0.6>原始孔洞</grad></shadow>"
			x: -3.5d
			y: 9.5d
		}
		{
			dependencies: ["44D8121BA7F27262"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>用桶装一个孔洞，你就能得到胃酸。它具有高度易燃性，并且会</grad><grad from=#B23A6B to=#E88BAE f=0.8>使岩浆块液化</grad><grad from=#FFFFFF to=#C7C7C7>，这大致说明了它在各种物质中的位置。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>装瓶后就成了胃液，一种可以喝的药水。是的，你可以。不，你不应该这么做。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将其倒入炼药锅中，你就能得到一口会消化所有投入物品的</grad><grad from=#B23A6B to=#E88BAE f=0.8>胃酸炼药锅</grad><grad from=#FFFFFF to=#C7C7C7>。营养糊、营养块和活肉是仅有的三种免疫物品。</grad></shadow>"
			]
			id: "50B7398EAFFDC7F1"
			rewards: [{
				id: "4A410EEEE6291953"
				type: "xp"
				xp: 15
			}]
			shape: "square"
			size: 1.0d
			subtitle: "<typewriter><grad from=#B23A6B to=#B23A6B>把洞填上</grad></typewriter>"
			tasks: [{
				id: "467FA4797BBFB091"
				item: "biomancy:acid_bucket"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#B23A6B to=#E88BAE f=0.6>胃酸</grad></shadow>"
			x: -3.5d
			y: 11.0d
		}
		{
			dependencies: ["3C1DE048EE37A310"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>原始花朵生长在土丘中，呈品红色，与周围环境格格不入。它们通过将成熟的浆果抛向空中来传播。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>吃一朵花莓会获得一个</grad><grad from=#B23A6B to=#E88BAE f=0.8>随机的药水效果</grad><grad from=#FFFFFF to=#C7C7C7>。可能是好东西，也可能是毒药。这就是风险所在。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它会分解成奇异粉尘和生物发光黏液，使土堆成为这两种物质的可再生来源。</grad></shadow>"
			]
			id: "497A4305BDABC7C2"
			rewards: [{
				id: "34A61BCFAE93439C"
				type: "xp"
				xp: 10
			}]
			shape: "square"
			size: 1.0d
			subtitle: "<typewriter><grad from=#B23A6B to=#B23A6B>总算有点好看的了</grad>"
			tasks: [{
				id: "2C8718A038C25B13"
				item: "biomancy:bloomberry"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#B23A6B to=#E88BAE f=0.6>Bloomberry</grad></shadow>"
			x: -5.0d
			y: 8.0d
		}
		{
			dependencies: ["7F30882A1FAC6E53"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>石板、楼梯和墙壁都源自该方块。它自己的提示框告诉你不要碰它。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>这也是制作原始肉体的中间步骤，所以多做一些，别嫌多。</grad></shadow>"
			]
