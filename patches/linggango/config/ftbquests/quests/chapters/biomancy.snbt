				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#FF6B6B to=#FFC2C2 f=0.6>肌腱</grad></shadow>"
			x: 2.0d
			y: 9.5d
		}
		{
			dependencies: ["2352027864446855"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一个装满胆汁的袋子。牛、羊、蜘蛛、村民和大多数中立生物都携带一个。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>这是模组里前期消耗仇恨值的最佳方式，每块能消耗-20仇恨值，而且只需要一头牛作为代价。</grad></shadow>"
			]
			id: "3C6A89FFC67DD912"
