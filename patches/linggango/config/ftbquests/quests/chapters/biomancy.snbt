				xp: 10
			}]
			shape: "circle"
			size: 1.0d
			subtitle: "<typewriter><grad from=#C8AE86 to=#C8AE86>村民们交易这种东西</grad>"
			tasks: [{
				id: "702F3B54BF90507E"
				title: "商业活动"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>器官商人</grad></shadow>"
			x: 2.0d
			y: 7.5d
		}
		{
			dependencies: ["361F788B12AE4B03"]
			description: [
				"# <grad from=#C24BC7 to=#EFA9F2 f=0.6><shadow a=0.3>碗</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>獠牙、生肉和一块原始核心。把它放下来，然后开始往里扔东西吧。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>摇篮的容量为两米，</grad><grad from=#C24BC7 to=#EFA9F2 f=0.8>生物质</grad><grad from=#FFFFFF to=#C7C7C7>和</grad><grad from=#C24BC7 to=#EFA9F2 f=0.8>生命能量</grad><grad from=#FFFFFF to=#C7C7C7>，两者均从0到100。当两者都充满时，它会等待四秒，然后执行某个操作。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它能做什么取决于你喂养它期间一直在悄悄编辑的三个隐藏百分比。</grad></shadow>"
				""
				"[!warn] 喂养不当的批次会使摇篮在最多8点伤害内，对1.5格内的所有东西进行猛刺。结算期间请勿站在上面。"
			]
			id: "13FF211A43B0A862"
			rewards: [{
				id: "326DC698549F6BCC"
				type: "xp"
				xp: 15
			}]
			shape: "hexagon"
			size: 1.6d
			subtitle: "<typewriter><grad from=#C24BC7 to=#C24BC7>想要东西的碗</grad>"
			tasks: [{
				id: "2FC75C6BC5FE1345"
				item: "biomancy:primordial_cradle"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#C24BC7 to=#EFA9F2 f=0.6>Primordial Cradle</grad></shadow>"
			x: 0.0d
			y: 7.5d
		}
		{
			dependencies: ["13FF211A43B0A862"]
			description: [
				"# <grad from=#C24BC7 to=#EFA9F2 f=0.6><shadow a=0.3>五个数字</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你丢弃的物品每移动一格，数值会变化五。其中两个是你可以观察的计量值，另外三个是你无法观察的概率值。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#C24BC7 to=#EFA9F2 f=0.8>生物质</grad><grad from=#FFFFFF to=#C7C7C7>填充至100。生肉每个20个。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#C24BC7 to=#EFA9F2 f=0.8>生命能量</grad><grad from=#FFFFFF to=#C7C7C7>填充至100。每次治疗附加值为55。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#C24BC7 to=#EFA9F2 f=0.8>成功</grad><grad from=#FFFFFF to=#C7C7C7> 决定了你是否能获得肉块。初始值为 0。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#C24BC7 to=#EFA9F2 f=0.8>敌意</grad><grad from=#FFFFFF to=#C7C7C7>决定了那个生物体是否想吃掉你。初始值为85。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#C24BC7 to=#EFA9F2 f=0.8>Anomaly</grad><grad from=#FFFFFF to=#C7C7C7> 决定其是否呈现原始形态。初始值为 7。</grad></shadow>"
				"[间隔=5]"
				"---"
				"[间隔=5]"
				"## <grad from=#C24BC7 to=#EFA9F2 f=0.6><shadow a=0.3>快速填充</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>五份生肉填满生物质，并将成功率提升至80。两份生命添加剂填满生命能量。这是一批完全可靠、令人乏味的批次，可以永远使用。</grad></shadow>"
				""
				"## <grad from=#C24BC7 to=#EFA9F2 f=0.6><shadow a=0.3>力挽狂澜</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#C24BC7 to=#EFA9F2 f=0.8>兔爪</grad><grad from=#FFFFFF to=#C7C7C7> 可+1000成功度。其中一个能永久结束猜谜游戏。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C24BC7 to=#EFA9F2 f=0.8>附魔金苹果</grad><grad from=#FFFFFF to=#C7C7C7> 会减少200点敌意，增加40点成功率。普通苹果会减少100点敌意。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#C24BC7 to=#EFA9F2 f=0.8>蛋糕</grad><grad from=#FFFFFF to=#C7C7C7> 的仇恨值为 -80，</grad><grad from=#C24BC7 to=#EFA9F2 f=0.8>胆囊</grad><grad from=#FFFFFF to=#C7C7C7> 为 -20，</grad><grad from=#C24BC7 to=#EFA9F2 f=0.8>蜂蜜瓶</grad><grad from=#FFFFFF to=#C7C7C7> 为 -10。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C24BC7 to=#EFA9F2 f=0.8>Living Flesh</grad><grad from=#FFFFFF to=#C7C7C7> 是 +40 成功和 +55 异常，所以它将批次推向原始生物。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C24BC7 to=#EFA9F2 f=0.8>下界之星</grad><grad from=#FFFFFF to=#C7C7C7> 蕴含着15000生命能量，附带+100仇恨和+100疾病。瓶中的混沌。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#C24BC7 to=#EFA9F2 f=0.8>净化血清</grad><grad from=#FFFFFF to=#C7C7C7>可清除一批生物身上的120种疾病，消耗20生命能量。</grad></shadow>"
				""
				"穿戴者附近有 <grad from=#C24BC7 to=#EFA9F2 f=0.8>辅祭盔甲</grad> 时，每件可 +1 成功度、-5 敌意，效果在批次结算时生效。"
				""
				"[!danger] 熟肉成功度-999。狂热血清敌意+1000。摇篮不识别的任何物品，成功度-99，敌意+20，所以它不是垃圾桶。"
				""
				"[!tip] 失败的批次仍有产出。成功率低于75%会铺平地板并储存原始能量。高于该值则会蔓延恶性静脉。"
			]
			icon: "minecraft:golden_apple"
			id: "13EED6BCD8BCB1E9"
			min_width: 420
			rewards: [
				{
					id: "4E830BF7F74A544F"
