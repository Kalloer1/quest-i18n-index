		}
		{
			dependencies: ["49B28B2C48A5DF5A"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>八个恶性肉块围绕着一个肉块碎片。这就是用来修复肉块掠夺者的材料，也是其下一级材料。</grad></shadow>"
				""
				"每次献祭成功，摇篮下方还会自动铺路，所以一个能用的摇篮能慢慢帮你付维修费。"
			]
			id: "302580A79A5E2EC4"
			optional: true
			rewards: [{
				id: "4117998387D9E411"
				type: "xp"
				xp: 5
			}]
			shape: "circle"
			size: 1.0d
			subtitle: "<typewriter><grad from=#9B7BD4 to=#9B7BD4>修复材料</grad></typewriter>"
			tasks: [{
				id: "17B814CBDAF86A61"
