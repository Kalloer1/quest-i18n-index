				xp: 10
			}]
			shape: "diamond"
			size: 1.0d
			subtitle: "<typewriter><grad from=#FF6B6B to=#FF6B6B>仅限凋零骷髅</grad>"
			tasks: [{
				id: "270F0DE505C6C998"
				item: "biomancy:withered_mob_marrow"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#FF6B6B to=#FFC2C2 f=0.6>凋零的骨髓</grad></shadow>"
			x: 3.5d
			y: 10.5d
		}
		{
			dependencies: ["2352027864446855"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Despoil 是个真正的附魔，不只是镰刀的花招。把它装在你想挥舞的武器上，那把武器就会开始掉落器官了。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>本整合包解锁的装备远超生物魔法本身。 </grad><grad from=#C8AE86 to=#EBD9B8 f=0.8>Infinity Saw</grad><grad from=#FFFFFF to=#C7C7C7>、 </grad><grad from=#C8AE86 to=#EBD9B8 f=0.8>Infinity Hammer</grad><grad from=#FFFFFF to=#C7C7C7>、 </grad><grad from=#C8AE86 to=#EBD9B8 f=0.8>The Infinitum</grad><grad from=#FFFFFF to=#C7C7C7>、 </grad><grad from=#C8AE86 to=#EBD9B8 f=0.8>Eldritch Pan</grad><grad from=#FFFFFF to=#C7C7C7>、 </grad><grad from=#C8AE86 to=#EBD9B8 f=0.8>Astral Spear</grad><grad from=#FFFFFF to=#C7C7C7>、 </grad><grad from=#C8AE86 to=#EBD9B8 f=0.8>The Bless</grad><grad from=#FFFFFF to=#C7C7C7> 和 </grad><grad from=#C8AE86 to=#EBD9B8 f=0.8>Disaster Sword</grad><grad from=#FFFFFF to=#C7C7C7> 均支持此物品。 </grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>它拒绝和丝绸之触坐在一起，所以选一个吧。</grad></shadow>"
			]
			icon: {
				Count: 1
				id: "biomancy:despoil_sickle"
				tag: {
					Damage: 0
				}
			}
