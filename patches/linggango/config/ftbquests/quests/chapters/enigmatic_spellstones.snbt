	quest_links: [ ]
	quests: [
		{
			description: [
				"# <grad from=#3FC5D8 to=#C6F6FD f=0.6><shadow a=0.3>插槽的工作原理</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>附魔石槽位从</grad><grad from=#FFC46B to=#FF9E1F f=0.8>0</grad><grad from=#FFFFFF to=#C7C7C7>开始，拾取附魔石后首次出现。你只能拥有一个槽位，此整合包不允许拥有第二个。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每种石头都会提供一个被动技能堆，通常是一个绑定在按键上的主动能力，以及一个致命的弱点。而这个弱点，才是重点所在。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#3FC5D8 to=#C6F6FD f=0.6><shadow a=0.3>它们的来源</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>村庄神庙会给予你 </grad><grad from=#8FD6FF to=#4FA8E8 f=0.8>天使的祝福</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>地牢、矿井和盔甲匠的箱子里会掉落 </grad><grad from=#8FD6FF to=#4FA8E8 f=0.8>哥利亚之心</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>海洋遗迹、沉船宝藏和埋藏宝藏会赋予你 </grad><grad from=#8FD6FF to=#4FA8E8 f=0.8>海洋意志</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>下界堡垒、堡垒遗迹和废弃传送门会掉落 </grad><grad from=#8FD6FF to=#4FA8E8 f=0.8>烈焰核心</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>末地城市的宝藏几乎总能给出 </grad><grad from=#8FD6FF to=#4FA8E8 f=0.8>星云之眼</grad><grad from=#FFFFFF to=#C7C7C7>，偶尔会给出 </grad><grad from=#8FD6FF to=#4FA8E8 f=0.8>虚空珍珠</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[!tip] 六种基础石头都没有配方。每一种都是宝箱战利品，所以这一章其实就是一个地点列表。"
			]
			icon: "enigmaticlegacy:enigmatic_item"
			id: "2385CE29294FCC4D"
			min_width: 350
			shape: "octagon"
			size: 1.5d
			subtitle: "<typewriter><grad from=#3FC5D8 to=#3FC5D8>选择一个超能力。接受它的弱点。</grad></typewriter>"
			tasks: [{
				id: "50EEBE3454136602"
				title: "一次一块石头，慢慢来"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#3FC5D8 to=#C6F6FD f=0.6>魔法石</grad></shadow>"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["2385CE29294FCC4D"]
			description: [
				"## <grad from=#3FC5D8 to=#C6F6FD f=0.6><shadow a=0.3>移动性</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在空中按下跳跃键，即可朝你注视的方向发射，冷却时间为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>2 秒</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>永远没有坠落伤害和碰撞伤害。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>50 百分比</grad><grad from=#FFFFFF to=#C7C7C7>几率偏转来袭的投射物。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你自己的箭飞行速度更快了。</grad></shadow>"
				""
				"[!danger] 你将变得易受凋零和虚空伤害。从世界边缘坠落现在会直接导致死亡。"
			]
			id: "08B70E3FF0EDDA27"
			min_width: 340
			subtitle: "<typewriter><grad from=#3FC5D8 to=#3FC5D8>无限二段跳，永不停息。</grad>"
			tasks: [{
				id: "03DB08F7A0B8FDBF"
				item: "enigmaticlegacy:angel_blessing"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#3FC5D8 to=#C6F6FD f=0.6>天使的祝福</grad></shadow>"
			x: -3.0d
			y: 0.0d
		}
		{
			dependencies: ["2385CE29294FCC4D"]
			description: [
				"## <grad from=#3FC5D8 to=#C6F6FD f=0.6><shadow a=0.3>盔甲之石</shadow></grad>"
				""
				"穿戴它可获得+4护甲。若穿戴它且所有护甲栏位为空，则可获得+16护甲、+4韧性以及40%的爆炸抗性。"
				""
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>25 百分比</grad><grad from=#FFFFFF to=#C7C7C7>近战伤害减免。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>100 percent</grad><grad from=#FFFFFF to=#C7C7C7> 击退抗性。没有任何东西能动你。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>免疫窒息和仙人掌风格的伤害。</grad></shadow>"
				""
				"[!danger] 魔法伤害对你造成双倍伤害，而这个整合包里可有不少巫师。"
			]
			id: "12839E03F37B480A"
			min_width: 340
			subtitle: "<typewriter><grad from=#3FC5D8 to=#3FC5D8>最好完全裸体穿着。</grad>"
			tasks: [{
				id: "7D50169F625EDC2A"
				item: "enigmaticlegacy:golem_heart"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#3FC5D8 to=#C6F6FD f=0.6>哥利亚之心</grad></shadow>"
			x: -3.0d
			y: 1.5d
		}
		{
			dependencies: ["2385CE29294FCC4D"]
			description: [
				"## <grad from=#3FC5D8 to=#C6F6FD f=0.6><shadow a=0.3>水下世界大改造</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你从来不需要空气。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+200 percent</grad><grad from=#FFFFFF to=#C7C7C7>游泳速度提升，且在水下时不受重力影响。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>水中夜视和完全的水亲和性。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>40 percent</grad><grad from=#FFFFFF to=#C7C7C7> 水下生物抗性。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>主动能力会引发雷暴，消耗大量经验值，并有 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>30秒</grad><grad from=#FFFFFF to=#C7C7C7>的冷却时间。</grad></shadow>"
				""
				"[!danger] 火焰伤害现在高了很多。不要带这个去下界。"
			]
			id: "26061FA07E309955"
			min_width: 340
			subtitle: "<typewriter><grad from=#3FC5D8 to=#3FC5D8>基本上就是一艘潜水艇。</grad></typewriter>"
			tasks: [{
				id: "37BC4DB61D708662"
				item: "enigmaticlegacy:ocean_stone"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#3FC5D8 to=#C6F6FD f=0.6>海洋的意志</grad></shadow>"
			x: -1.0d
			y: 1.5d
		}
		{
			dependencies: ["2385CE29294FCC4D"]
			description: [
				"## <grad from=#3FC5D8 to=#C6F6FD f=0.6><shadow a=0.3>在岩浆中游泳</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在通过岩浆充能的温度计上完成防火和防岩浆效果。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>近战攻击者会着火并受到 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>4</grad><grad from=#FFFFFF to=#C7C7C7> 点伤害。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在岩浆里其实能看得见的哦。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你身上的所有状态效果，无论好坏，持续时间减半。 </grad><grad from=#D9A5FF to=#B06BE8 f=0.8>Molten Heart</grad><grad from=#FFFFFF to=#C7C7C7> 是例外，持续时间加倍。 </grad></shadow>"
				""
				"[!danger] 水下生物的攻击力会高得多。守卫们会记住这一点。"
			]
			id: "4C11F417CF8B98B3"
			min_width: 340
			subtitle: "<typewriter><grad from=#3FC5D8 to=#3FC5D8>下界不再重要。</grad></typewriter>"
			tasks: [{
				id: "474D4725D62CA799"
				item: "enigmaticlegacy:blazing_core"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#3FC5D8 to=#C6F6FD f=0.6>烈焰核心</grad></shadow>"
			x: 1.0d
			y: 1.5d
		}
		{
			dependencies: ["2385CE29294FCC4D"]
			description: [
				"## <grad from=#3FC5D8 to=#C6F6FD f=0.6><shadow a=0.3>法师之石</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>看向32格内的物体，并瞬移到其后方，冷却时间为3秒。之后你的下一次攻击将造成+150%的伤害。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+40 percent</grad><grad from=#FFFFFF to=#C7C7C7> 造成的魔法伤害。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>65 百分比</grad><grad from=#FFFFFF to=#C7C7C7> 魔法伤害减免。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>10 percent</grad><grad from=#FFFFFF to=#C7C7C7> chance to simply teleport out of any attack.</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>末影珍珠不再对你造成伤害。</grad></shadow>"
				""
				"[!danger] 在水中时，你将完全暴露在一切伤害之下。不只是额外的伤害，而是所有伤害。"
			]
			id: "54453A8DEDCD886B"
			min_width: 340
			subtitle: "<typewriter><grad from=#3FC5D8 to=#3FC5D8>瞬移到任何让你烦恼的东西后面去。</grad>"
			tasks: [{
				id: "0DD91BB0319C5E60"
				item: "enigmaticlegacy:eye_of_nebula"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#3FC5D8 to=#C6F6FD f=0.6>星云之眼</grad></shadow>"
			x: 3.0d
			y: 1.5d
		}
		{
			dependencies: ["54453A8DEDCD886B"]
			description: [
				"# <grad from=#3FC5D8 to=#C6F6FD f=0.6><shadow a=0.3>黑暗会为你带来死亡</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>任何处于黑暗中的生物，在距离你16格内都会受到高额伤害和一系列负面效果。你无需采取任何行动。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>完全不会饥饿，但自然恢复速度会慢很多。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>不需要空气。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>免疫所有状态效果，包括有益的效果。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你的攻击会附加凋零效果。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>7 percent</grad><grad from=#FFFFFF to=#C7C7C7> 致命伤害无法直接杀死你的几率。</grad></shadow>"
				""
				"[!info] 仅限末地城宝箱。与星云之眼相比，每十次探索才出现一次，所以要做好面对大量塔楼的准备。"
			]
			id: "6278C62EC4E816EE"
			min_width: 350
			subtitle: "<typewriter><grad from=#3FC5D8 to=#3FC5D8>六者之中，最稀有的那一个，毫无悬念。</grad></typewriter>"
			tasks: [{
				id: "7D8CF581C8EE8696"
				item: "enigmaticlegacy:void_pearl"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#3FC5D8 to=#C6F6FD f=0.6>虚空珍珠</grad></shadow>"
			x: 3.0d
			y: 3.0d
		}
		{
			dependencies: ["2385CE29294FCC4D"]
			description: [
				"## <grad from=#3FC5D8 to=#C6F6FD f=0.6><shadow a=0.3>人群控制</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>主动技能会冻结周围的一切并对敌人造成严重伤害，冷却时间为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>12秒</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>免疫冰冻并获得永久霜行者效果。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>触碰你的任何东西都会开始结冰。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>被冰冻的目标会受到更多伤害，并且几乎无法移动。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>30 百分比</grad><grad from=#FFFFFF to=#C7C7C7> 投射物和声波伤害抗性。</grad></shadow>"
				""
				"[!danger] 火焰伤害和坠落伤害都变得更高了。"
			]
			id: "086DC18C20496440"
			min_width: 340
			subtitle: "<typewriter><grad from=#3FC5D8 to=#3FC5D8>将房间冻结起来。</grad>"
			tasks: [{
				id: "0EE72CA2E9420D3A"
				item: "enigmaticaddons:forgotten_ice"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#3FC5D8 to=#C6F6FD f=0.6>被遗忘的冰晶</grad></shadow>"
			x: 3.0d
			y: 0.0d
		}
		{
			dependencies: ["12839E03F37B480A"]
			description: [
				"## <grad from=#3FC5D8 to=#C6F6FD f=0.6><shadow a=0.3>速度之石</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>移动更流畅，重力更低，并且</grad><grad from=#FFC46B to=#FF9E1F f=0.8>+4</grad><grad from=#FFFFFF to=#C7C7C7>韧性更高。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你的所有物品冷却时间都降低 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>25 个百分点</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>免疫坠落和爆炸伤害。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+35 percent</grad><grad from=#FFFFFF to=#C7C7C7> 暴击伤害。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>铁傀儡不再关心你了。</grad></shadow>"
				""
				"[!danger] 魔法伤害乘以2.5，任何击中你的闪电都会立即致命。非常致命。"
