					}
				}
				type: "item"
			}]
			shape: "octagon"
			size: 1.5d
			subtitle: "从这里开始"
			tasks: [{
				id: "6C12462EDF0C73ED"
				title: "把书给我，我需要这本书"
				type: "checkmark"
			}]
			title: "血色科学 (Sanguine Scientiem)"
			x: 2.0d
			y: -4.5d
		}
		{
			dependencies: ["7E0093211509C03D"]
			description: [
				"## <grad from=#E03131 to=#FF8787 f=0.6><shadow a=0.3>祭品之刀</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>按住并</grad><grad from=#FF7B7B to=#FF3B3B f=0.8>朝空中右键点击</grad><grad from=#FFFFFF to=#C7C7C7>。你会失去一个心，以及</grad><grad from=#FFD98A to=#FFB347 f=0.8>200 LP，</grad><grad from=#FFFFFF to=#C7C7C7>一个血祭坛会出现在你附近。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你不能用它点击祭坛。你只需要站在距离祭坛</grad><grad from=#FFD98A to=#FFB347 f=0.8>2格方块内</grad><grad from=#FFFFFF to=#C7C7C7>即可。</grad></shadow>"
				""
				"[!warn] 附近没有祭坛的话，你还是会受到伤害，但什么也得不到。请先放置祭坛，然后再开始刺击。"
				""
				"[!tip] 保持饱食度满格。现阶段食物恢复才是真正的生命恢复来源，所以请吃东西，冲刺攻击，然后让自己回血。"
			]
			id: "45C16A2944338E77"
			rewards: [{
				id: "3F19AB4E3AC74612"
				type: "xp"
				xp: 5
			}]
			shape: "circle"
			subtitle: "你的第一次献血记录"
			tasks: [{
				id: "02B70A0BBA16E418"
				item: "bloodmagic:sacrificialdagger"
				type: "item"
			}]
			title: "祭品匕首"
			x: 2.0d
			y: -3.0d
		}
		{
			dependencies: ["45C16A2944338E77"]
			description: [
				"## <grad from=#E03131 to=#FF8787 f=0.6><shadow a=0.3>血祭坛</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FF7B7B to=#FF3B3B f=0.8>石头</grad><grad from=#FFFFFF to=#C7C7C7>、一个</grad><grad from=#FF7B7B to=#FF3B3B f=0.8>熔炉</grad><grad from=#FFFFFF to=#C7C7C7>和三个</grad><grad from=#FF7B7B to=#FF3B3B f=0.8>金锭</grad><grad from=#FFFFFF to=#C7C7C7>。放置后，手持物品右键可将物品投入其中，或空手右键将其取出。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一级祭坛拥有 </grad><grad from=#FFD98A to=#FFB347 f=0.8>10,000 LP</grad><grad from=#FFFFFF to=#C7C7C7>。其中约十分之一被用作你看不到的内部缓冲，所以可视为约有 </grad><grad from=#FFD98A to=#FFB347 f=0.8>9,000</grad><grad from=#FFFFFF to=#C7C7C7>可用。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#E03131 to=#FF8787 f=0.6><shadow a=0.3>血液不会蒸发</shadow></grad>"
				""
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>真正消耗的是 </grad><grad from=#FF7B7B to=#FF3B3B f=0.8>合成进度</grad><grad from=#FFFFFF to=#C7C7C7>。祭坛在转化物品时会消耗LP并抛出红色粒子。如果中途耗尽，则会显示灰色烟雾，进度条会回退至零附近。</grad></shadow>"
				""
				"[!tip] 规则不是快，而是不要开始你付不起的锻造。先填满祭坛，再把物品放进去。"
			]
			id: "7C071644EC35919E"
			min_width: 340
			rewards: [{
				id: "0F12BE9E8BD3D092"
				type: "xp"
				xp: 5
			}]
			shape: "circle"
			size: 1.2d
			subtitle: "血液所至之处，即为目的地"
			tasks: [{
				id: "3FFC2845704053E0"
				item: "bloodmagic:altar"
				type: "item"
			}]
			title: "Tier 1 血祭坛"
			x: -1.2724912373284383d
			y: -2.5121230949367686d
		}
		{
			dependencies: ["7C071644EC35919E"]
			description: [
				"## <grad from=#E03131 to=#FF8787 f=0.6><shadow a=0.3>你的灵魂网络</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将一颗</grad><grad from=#FF7B7B to=#FF3B3B f=0.8>钻石</grad><grad from=#FFFFFF to=#C7C7C7>投入一个持有</grad><grad from=#FFD98A to=#FFB347 f=0.8>2000 LP</grad><grad from=#FFFFFF to=#C7C7C7>的Tier 1祭坛中，即可获得一个</grad><grad from=#FF7B7B to=#FF3B3B f=0.8>弱血球</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>右键点击球体一次，即可将其与自身绑定。从此以后，它将成为一个名为“灵魂网络”的个人跨维度LP电池，你制作的每一个符文、仪式和绑定物品都将消耗其中的能量。</grad></shadow>"
				""
				"[!info] 容量为 5,000 LP，而非 1,000。后续每个球体都会升级同一个网络，而不是创建第二个网络。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#E03131 to=#FF8787 f=0.6><shadow a=0.3>填充中</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将球体投入含有LP的祭坛，它会以你的 </grad><grad from=#FF7B7B to=#FF3B3B f=0.8>速度符文</grad><grad from=#FFFFFF to=#C7C7C7>允许的最快速度饮用。</grad></shadow>"
				"[间隔=3]"
				"- 右键点击手中的球体，可直接用1颗心换取 </grad><grad from=#FFD98A to=#FFB347 f=0.8>200 LP</grad><grad from=#FFFFFF to=#C7C7C7> 。</grad></shadow>"
				""
				"[!warn] 如果绑定的物品需要LP而你的网络为空，成本会从你的生命值中扣除。请保持缓冲。"
				""
				"[!tip] 血球不会被任何合成配方消耗。空白符文和香炉配方都会直接返还血球。"
			]
			icon_scale: 1.3d
			id: "316E5F040CB7F4C8"
			min_width: 340
			rewards: [{
				id: "360C6D5A99E99AC3"
				type: "xp"
				xp: 5
			}]
			shape: "circle"
			subtitle: "可容纳 5,000 经验值"
			tasks: [{
				id: "776EB52F2F5971D0"
				item: "bloodmagic:weakbloodorb"
				type: "item"
			}]
			title: "虚弱血液球体"
			x: 0.7654693361164178d
			y: -0.06053144314299175d
		}
		{
			dependencies: ["316E5F040CB7F4C8"]
			description: [
				"## <grad from=#E03131 to=#FF8787 f=0.6><shadow a=0.3>空白石板</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将 </grad><grad from=#FF7B7B to=#FF3B3B f=0.8>石头</grad><grad from=#FFFFFF to=#C7C7C7>投入含有 </grad><grad from=#FFD98A to=#FFB347 f=0.8>1,000 LP</grad><grad from=#FFFFFF to=#C7C7C7>的祭坛中。这就是完整的配方。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>石板是整个模组的核心。每个图腾、符文和试剂都始于石板，而每个等级的石板都需要比前一个更大的祭坛。</grad></shadow>"
				""
				"[!tip] 完成的任务量远超要求。仅 Tier 3 就需要消耗价值二十个空白石板数量的符文。"
			]
			id: "6AAB831CB3FB536A"
			rewards: [{
				id: "590F75E07C74D7B0"
				type: "xp"
				xp: 5
			}]
			subtitle: "石头加 1,000 经验值"
			tasks: [{
				count: 2L
				id: "7CBFE84B4FE3DC01"
				item: "bloodmagic:blankslate"
				type: "item"
			}]
			title: "空白石板"
			x: 2.0d
			y: 2.5d
		}
		{
			dependencies: ["7C071644EC35919E"]
			description: [
				"## <grad from=#E03131 to=#FF8787 f=0.6><shadow a=0.3>二阶血祭坛</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在祭坛底部环绕放置 </grad><grad from=#FFD98A to=#FFB347 f=0.8>8个</grad><grad from=#FFFFFF to=#C7C7C7> </grad><grad from=#FF7B7B to=#FF3B3B f=0.8>空白符文</grad><grad from=#FFFFFF to=#C7C7C7>。不要柱子，不要萤石，只要这个环状结构。"
				""
				"在合成台里，将7个石头、一块空白石板和一个虚弱血球组合在一起。血球会返还，所以一个血球就能制作出你所需的所有符文。"
				""
				"[!info] 四个正方向符文可后期更换为升级符文。四个角符文在3级前完全无效。"
				""
				"[!tip] 打开 `Sanguine Scientiem`，找到 Blood Altar 条目。里面有一个每个等级的可旋转 3D 模型。照着抄就行。"
			]
			icon: "bloodmagic:altar"
			id: "4B51189C36B8D291"
			min_width: 340
			rewards: [{
				id: "7D5123ADA18DB783"
				type: "xp"
				xp: 5
			}]
			size: 1.2d
			subtitle: "8 空白符文"
			tasks: [{
				count: 8L
				id: "4CDFCAAED8ABB615"
				item: "bloodmagic:blankrune"
				type: "item"
			}]
			title: "Tier 2 血祭坛"
			x: -2.394414549580638d
			y: -0.5440838834100177d
		}
		{
			dependencies: ["45C16A2944338E77"]
			description: [
				"## <grad from=#E03131 to=#FF8787 f=0.6><shadow a=0.3>献祭匕首</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一把 </grad><grad from=#FF7B7B to=#FF3B3B f=0.8>铁剑</grad><grad from=#FFFFFF to=#C7C7C7> 加上 </grad><grad from=#FFD98A to=#FFB347 f=0.8>3,000 LP</grad><grad from=#FFFFFF to=#C7C7C7>，放入 Tier 2 祭坛中。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>击中站在祭坛附近任意生物，它将立即死亡，血液直接流入祭坛。完全不会消耗你的生命值。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#E03131 to=#FF8787 f=0.6><shadow a=0.3>这东西值多少钱</shadow></grad>"
				""
				"奖励是该生物<strong>当前生命值</strong>乘以每个生物特定的比率："
				""
				"- <shadow a=0.3><grad from=#FF7B7B to=#FF3B3B f=0.8>牛、猪、羊、鸡、马、狼、豹猫、兔子和村民</grad><grad from=#FFFFFF to=#C7C7C7> 每点 </grad><grad from=#FFD98A to=#FFB347 f=0.8>100</grad><grad from=#FFFFFF to=#C7C7C7> 积分。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FF7B7B to=#FF3B3B f=0.8>史莱姆</grad><grad from=#FFFFFF to=#C7C7C7>支付</grad><grad from=#FFD98A to=#FFB347 f=0.8>15</grad><grad from=#FFFFFF to=#C7C7C7>，</grad><grad from=#FF7B7B to=#FF3B3B f=0.8>末影人</grad><grad from=#FFFFFF to=#C7C7C7>支付</grad><grad from=#FFD98A to=#FFB347 f=0.8>10</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>其余部分每点支付 </grad><grad from=#FFD98A to=#FFB347 f=0.8>25</grad><grad from=#FFFFFF to=#C7C7C7> 的报酬。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>健康的牛有10点生命，所以一头牛是 </grad><grad from=#FFD98A to=#FFB347 f=0.8>1,000 LP</grad><grad from=#FFFFFF to=#C7C7C7>。村民有20点，所以是 </grad><grad from=#FFD98A to=#FFB347 f=0.8>2,000 LP</grad><grad from=#FFFFFF to=#C7C7C7>。婴儿半价。</grad></shadow>"
				""
				"[!warn] 受伤的怪物给的钱更少，因为是根据当前血量而非最大血量计算的。不要先把它打残。"
				""
				"[!danger] 首领免疫秒杀。试试看，你不过是拿着烂剑站在首领旁边的普通人。"
				""
				"[!tip] 祭坛旁边的小型围栏繁殖场，收益远高于自残。"
			]
