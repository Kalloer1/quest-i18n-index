		}
		{
			dependencies: ["1F3B9803AFAEED5F"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>右键放置熔岩源，消耗 </grad><grad from=#FFD98A to=#FFB347 f=0.8>1,000 LP</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
