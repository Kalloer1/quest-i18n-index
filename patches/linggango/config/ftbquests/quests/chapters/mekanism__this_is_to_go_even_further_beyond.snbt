	quests: [
		{
			dependencies: ["4CAB5A327810DF8A"]
			description: [
				"## <grad from=#B47CFF to=#E3D0FF f=0.6><shadow a=0.3>再四种合金</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Mekanism的阶梯终点是</grad><grad from=#B47CFF to=#E3D0FF f=0.8>原子合金</grad><grad from=#FFFFFF to=#C7C7C7>。Evolved则继续延伸了四个，每一个都是一个完整层级的大门。</grad></shadow>"
				""
				"1. <shadow a=0.3><grad from=#B47CFF to=#E3D0FF f=0.8>超充能</grad><grad from=#FFFFFF to=#C7C7C7>需要铀。</grad></shadow>"
				"[间隔=3]"
				"2. <shadow a=0.3><grad from=#B47CFF to=#E3D0FF f=0.8>亚原子</grad><grad from=#FFFFFF to=#C7C7C7>需要反物质。</grad></shadow>"
				"[gap=3]"
				"3. <shadow a=0.3><grad from=#B47CFF to=#E3D0FF f=0.8>Singular</grad><grad from=#FFFFFF to=#C7C7C7>需要更好的黄金。</grad></shadow>"
				"[间隔=3]"
				"4. <shadow a=0.3><grad from=#B47CFF to=#E3D0FF f=0.8>Exoversal</grad><grad from=#FFFFFF to=#C7C7C7>需要plaslitherite。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>这两种材料尚不存在，所以机器在完成之前，梯子在机器和转换机之间循环往复。</grad></shadow>"
			]
			id: "670CB1B9FDC66BA7"
			min_width: 340
			shape: "hexagon"
			size: 1.25d
			subtitle: "<typewriter><grad from=#B47CFF to=#B47CFF>再要四种合金</grad>"
			tasks: [{
				id: "1499FDBB8768750A"
				title: "太棒了"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#B47CFF to=#E3D0FF f=0.6>极端机械模组</grad></shadow>"
			x: 2.5d
			y: -6.0d
		}
		{
			dependencies: ["670CB1B9FDC66BA7"]
			description: [
				"## <grad from=#B47CFF to=#E3D0FF f=0.6><shadow a=0.3>核融合器中的铀</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#B47CFF to=#E3D0FF f=0.8>原子合金</grad><grad from=#FFFFFF to=#C7C7C7> 加上 </grad><grad from=#B47CFF to=#E3D0FF f=0.8>20</grad><grad from=#FFFFFF to=#C7C7C7> 铀注入。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>铀的注入来自铀粉，这意味着裂变章节必须在本阶梯开始前运行。</grad></shadow>"
			]
			id: "0F9CE70152047F88"
			rewards: [{
				id: "18B23BB6BCEB87D3"
				item: "evolvedmekanism:alloy_hypercharged"
				random_bonus: 3
				type: "item"
			}]
			shape: "pentagon"
			size: 1.25d
			subtitle: "<typewriter><grad from=#B47CFF to=#B47CFF>4 GHz</grad>"
			tasks: [{
				id: "510145C1854F3FAB"
				item: "evolvedmekanism:alloy_hypercharged"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#B47CFF to=#E3D0FF f=0.6>超充能合金</grad></shadow>"
			x: 5.5d
			y: -6.0d
		}
		{
			dependencies: ["0F9CE70152047F88"]
			description: [
				"## <grad from=#FF6ECF to=#FFCBEF f=0.6><shadow a=0.3>反物质</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>使用超充合金和50单位反物质，在超过1,000个游戏刻的时间里，于反质子核合成器中制造而成。 </grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>五十反物质等于五万钋和五十亿能量。在开始计数前，先正确建造SPS吧。</grad></shadow>"
			]
			id: "28422F62814F8BA4"
			rewards: [{
				id: "30A0E6AAE66C0809"
				item: "evolvedmekanism:alloy_subatomic"
				random_bonus: 3
				type: "item"
			}]
			shape: "pentagon"
			size: 1.3d
			subtitle: "<typewriter><grad from=#FF6ECF to=#FF6ECF>5 个合金锭</grad></typewriter>"
			tasks: [{
				id: "0E1227EE69B5A06B"
				item: "evolvedmekanism:alloy_subatomic"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#FF6ECF to=#FFCBEF f=0.6>亚原子合金</grad></shadow>"
			x: 8.5d
			y: -6.0d
		}
		{
			dependencies: ["28422F62814F8BA4"]
			description: [
				"## <grad from=#FFD65C to=#FFF2C0 f=0.6><shadow a=0.3>更好的黄金</shadow></grad>"
				""
				"在冶金注入器中，使用亚原子合金和更好的黄金注入，可获得 20% 的额外黄金注入量。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>更好的黄金来自转换器，而转换器运行所需的核废料正是你的反应堆正在生产的。</grad></shadow>"
			]
			id: "4716EC91D45AF20A"
			rewards: [{
				id: "15AB59FDB64538DF"
				item: "evolvedmekanism:alloy_singular"
				random_bonus: 3
				type: "item"
			}]
			shape: "pentagon"
			size: 1.3d
			subtitle: "<typewriter><grad from=#FFD65C to=#FFD65C>avaritia ahh alloy</grad>"
			tasks: [{
				id: "04D0AC246A5CD433"
				item: "evolvedmekanism:alloy_singular"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#FFD65C to=#FFF2C0 f=0.6>单一合金</grad></shadow>"
			x: 11.5d
			y: -6.0d
		}
		{
			dependencies: ["4716EC91D45AF20A"]
			description: [
				"## <grad from=#B47CFF to=#E3D0FF f=0.6><shadow a=0.3>Plaslitherite</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#B47CFF to=#E3D0FF f=0.8>Singular Alloy</grad><grad from=#FFFFFF to=#C7C7C7> 加上 </grad><grad from=#B47CFF to=#E3D0FF f=0.8>20</grad><grad from=#FFFFFF to=#C7C7C7> 的 plaslitherite 注入。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Plaslitherite 是在 Chemixer 中混合下界合金、锂和塑料制成的，而 Chemixer 本身需要单质合金。因此，这个阶梯的最后两级是相互构建的。</grad></shadow>"
				""
				"[!success] 这是顶部。包里的所有多元宇宙物品都藏在这锭金属后面。"
			]
			id: "2AFF30CDF0CFACBB"
			rewards: [{
				id: "70AA55CB3F35476D"
				item: "evolvedmekanism:alloy_exoversal"
				random_bonus: 3
				type: "item"
			}]
			shape: "pentagon"
			size: 1.4d
			subtitle: "<typewriter><grad from=#B47CFF to=#B47CFF>exo bosses ahh alloy</grad>"
			tasks: [{
