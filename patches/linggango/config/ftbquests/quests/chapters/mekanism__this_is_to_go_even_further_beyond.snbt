				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#B47CFF to=#E3D0FF f=0.6>Exoversal Alloy</grad></shadow>"
			x: 14.5d
			y: -6.0d
		}
		{
			dependencies: ["1444FB0A63C61CF7"]
			description: [
				"## <grad from=#B47CFF to=#E3D0FF f=0.6><shadow a=0.3>锇压缩机</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>用 </grad><grad from=#B47CFF to=#E3D0FF f=0.8>锇气压缩的红石粉，一次一个锭。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将锭子压碎，你又得到了普通的红石粉，所以这也是一种略显奇怪的存储格式。</grad></shadow>"
