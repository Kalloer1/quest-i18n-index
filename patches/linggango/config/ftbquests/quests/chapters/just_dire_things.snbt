				xp: 10
			}]
			shape: "circle"
			size: 1.0d
			subtitle: "<typewriter><grad from=#C8AE86 to=#C8AE86>每个等级都挑食得很厉害</grad>"
			tasks: [{
				id: "43A126179786F481"
				title: "已收到"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>零食时间</grad></shadow>"
			x: -2.5d
			y: 3.0d
		}
		{
			dependencies: ["0EA1353D79064115"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在Primogel旁边放置煤炭块，然后挖掘产物以获得3至4个原始煤炭。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>普通煤炭燃烧时间为 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>1600 ticks</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，而这种煤炭燃烧时间为 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>4800</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#5FD8C4 to=#C4F7EE f=0.6><shadow a=0.3>整条煤炭阶梯</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#B7F06A to=#6FBF2E f=0.8>原始煤炭</grad></shadow><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>4800</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 刻。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFC07A to=#D96A3C f=0.8>烈焰余烬</grad></shadow><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>, </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>14400</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>.</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#7CF2E4 to=#1E9C97 f=0.8>虚空火焰煤炭</grad></shadow><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>, </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>43200</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>.</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#B7CBD4 to=#4E626F f=0.8>日食余烬</grad></shadow><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>, </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>129600</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>, 或 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>81</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 普通煤炭，一次性获取。</grad></shadow>"
				""
				"[!info] 每个台阶都是下方的煤炭，制成方块，喂给上方的凝胶。九个旧的换三个到四个新的。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>这些燃烧时间在普通熔炉里也适用。</grad></shadow>"
			]
