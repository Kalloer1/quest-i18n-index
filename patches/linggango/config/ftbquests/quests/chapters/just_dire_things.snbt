				id: "52878BF732E31A3E"
				item: "justdirethings:gooblock_tier2"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#FFC07A to=#FFE7CC f=0.6>烈焰花凝胶</grad></shadow>"
			x: 0.0d
			y: 10.5d
		}
		{
			dependencies: ["3F1BC6949197DE23"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>金块，黏液，一分钟。开采出 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>3 到 4 个</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 原始烈焰金。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>黄金是四种输入中最便宜的，而且烈焰金出现的配方比除铁核外的任何东西都多。</grad></shadow>"
				""
				"[!tip] 下界金矿，高炉，九合为一，块变凝胶。比去钻石矿快多了。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>丝绸之触会保留原始方块。</grad></shadow>"
			]
			icon: "justdirethings:raw_blazegold_ore"
			id: "4569F4A1C111C8F5"
			min_width: 300
			rewards: [{
				id: "4A436E804BFA7637"
				type: "xp"
				xp: 50
			}]
			shape: "square"
			size: 1.0d
			subtitle: "<typewriter><grad from=#FFB070 to=#FFB070>需要证明自己的黄金</grad>"
			tasks: [{
				icon: "justdirethings:raw_blazegold_ore"
