	order_index: 8
	quest_links: [ ]
	quests: [
		{
			description: [
				"# <grad from=#8CF5DE to=#DCFFF8 f=0.6><shadow a=0.3>喂养黏液，获得更好的岩石。</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>大多数科技模组都从机器开始。而这个模组则从一个放在地板上、用来投喂零食的 </grad></shadow><grad from=#B7F06A to=#6FBF2E f=0.8>水坑</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 开始。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在它旁边放一个普通方块，然后走开，回来拿更好的东西。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#5FD8C4 to=#C4F7EE f=0.6><shadow a=0.3>你将面临的一切</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#B7F06A to=#6FBF2E f=0.8>四个黏液块等级</grad><grad from=#FFFFFF to=#C7C7C7>，每个都比前一个消耗更强大的方块。铁、金、钻石、下界合金。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>四个齿轮等级，共有 </grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>45 种升级部件，</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>可在锻造台进行装配。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>机器有</grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>简单</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>和</grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>高级</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>两种类型。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>始于水，终于燃料的流体，传送门之液和时间本身。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#ECFF8C to=#17E517 f=0.8>时间晶体</grad><grad from=#FFFFFF to=#C7C7C7>，涉及一个无法拾取且必须访问三个维度的方块。</grad></shadow>"
				""
				"[!tip] 手持 Dire 工具时 Shift 点击。在该界面停留过一次后，此模组的几乎所有内容才能使用。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>该模组自带一本专属书籍。本章包含了整合包中的数字信息。</grad></shadow>"
			]
			icon: "justdirethings:gooblock_tier3"
			icon_scale: 1.2d
			id: "4291392EA42254CB"
			min_width: 340
			shape: "hexagon"
			size: 2.0d
			subtitle: "<typewriter><grad from=#5FD8C4 to=#5FD8C4>Goo 吃掉一个方块，方块变得更棒了</grad>"
			tasks: [
				{
					id: "0DFF9C016E889D00"
					item: {
						Count: 1
						id: "patchouli:guide_book"
						tag: {
							"patchouli:book": "justdirethings:justdirethingsbook"
						}
					}
					type: "item"
				}
				{
					id: "6285895B303497B9"
					title: "好的，我明白了。我会在翻译中保留所有占位符和特殊标记，确保格式与原文件完全一致。"
					type: "checkmark"
				}
			]
			title: "<shadow a=0.4><grad from=#8CF5DE to=#2FA894 f=0.6>尽是些糟糕的事</grad></shadow>"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["4291392EA42254CB"]
			description: [
				"## <grad from=#5FD8C4 to=#C4F7EE f=0.6><shadow a=0.3>三步之遥</shadow></grad>"
				""
				"1. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将凝胶块放置在某处。</grad></shadow>"
				"[gap=3]"
				"2. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>右键点击它，使用一个 </grad></shadow><grad from=#B7F06A to=#6FBF2E f=0.8>零食</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[gap=3]"
				"3. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将方块 </grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>放置在其某个面上</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>没有电力，没有管道，也没有GUI。计时器在那个方块上运行，当它归零时，方块会变成别的东西。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#5FD8C4 to=#C4F7EE f=0.6><shadow a=0.3>细则说明</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>所有 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>六个面 </grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>同时工作，每个都有自己的计时器。 </grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每放置完一个方块，就有 </grad></shadow><grad from=#FF7A7A to=#FF3C3C f=0.8>10%的几率</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 凝胶会进入睡眠。任何正在烹饪的东西都会继续完成。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>高级凝胶能更快地完成低级凝胶的所有操作。2级是 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>2倍</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，3级是 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>5倍</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，4级是 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>10倍</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>打破它，你就能拿回这个方块。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>2400 ticks 在一级 goo 中是两分钟。同样的工作在四级只需十二秒。</grad></shadow>"
			]
			icon: "justdirethings:gooblock_tier1"
			id: "4B9616ECBF32D941"
			min_width: 330
			optional: true
			rewards: [{
				id: "610899089DE37EC3"
				type: "xp"
				xp: 10
			}]
			shape: "circle"
			size: 1.0d
			subtitle: "<typewriter><grad from=#C8AE86 to=#C8AE86>读一遍，就再也不要想了</grad>"
			tasks: [{
				id: "4A4DFA25BD09029B"
				title: "明白了，收到指令。"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>Goo 的工作原理</grad></shadow>"
			x: -3.0d
			y: 1.5d
		}
		{
			dependencies: ["4291392EA42254CB"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>本模组中的护甲拥有</grad></shadow><grad from=#FF7A7A to=#FF3C3C f=0.8>原版属性</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。Ferricore 是铁，Blazegold 是金，Celestigem 是钻石，Eclipse Alloy 是下界合金。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你购买的是</grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>能力槽位，</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>而非护甲点数。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#5FD8C4 to=#C4F7EE f=0.6><shadow a=0.3>安装第一个螺栓</shadow></grad>"
				""
				"1. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>用 4 个 Ferricore 锭制作一个 </grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>升级：空白</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，然后将其制成你想要的物品。</grad></shadow>"
				"[间隔=3]"
				"2. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>锻造台，工具在左，升级材料在右。</grad></shadow>"
				"[gap=3]"
				"3. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>手持工具并按住 </grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>shift 键点击</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 以打开设置界面。</grad></shadow>"
				"[gap=3]"
				"4. <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>点击能力以激活，右键可调整滑块和按键绑定。</grad></shadow>"
				""
				"[!warn] 主动能力在未绑定按键前无效。如果无敌似乎失灵，那是因为你从未为其分配按键。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#5FD8C4 to=#C4F7EE f=0.6><shadow a=0.3>两件须知之事</shadow></grad>"
				""
				"- <grad from=#8CF5DE to=#2FA894 f=0.8>v</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 一次性摧毁整个工具的所有能力。当矿石矿工开始破坏你喜欢的墙壁时，这招很管用。"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>能力消耗 </grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>耐久度</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，或者 </grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>能量</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>（如果物品已充能）。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Shift+悬停工具可查看其可容纳的物品。低阶工具可容纳更少物品。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>无论制作多少，铁核镐都不会接受锤子。</grad></shadow>"
			]
			icon: "justdirethings:upgrade_flight"
			id: "0B44DCEA89D75E6E"
			min_width: 330
			optional: true
			rewards: [{
				id: "6ECF8A1937AE28B0"
				type: "xp"
				xp: 10
			}]
			shape: "circle"
			size: 1.0d
			subtitle: "<typewriter><grad from=#C8AE86 to=#C8AE86>齿轮很无聊。插槽可不是这样</grad>"
			tasks: [{
				id: "39966A0B8763259C"
				title: "明白了"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>升级与能力</grad></shadow>"
			x: 3.0d
			y: 1.5d
		}
		{
			dependencies: ["4291392EA42254CB"]
			description: [
				"# <grad from=#8CF5DE to=#DCFFF8 f=0.6><shadow a=0.3>你真正需要的唯一东西</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>角落是黏土，两侧是腐肉，上下是糖，中间是泥土。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>用糖或腐肉唤醒它，然后改用方块喂养它。 </grad></shadow><grad from=#B7F06A to=#6FBF2E f=0.8>糖</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 或 </grad></shadow><grad from=#B7F06A to=#6FBF2E f=0.8>腐肉</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 来唤醒它，然后改用方块喂养它。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#5FD8C4 to=#C4F7EE f=0.6><shadow a=0.3>原初凝胶吃什么</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>铁块</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>将在2分钟内</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>变为原矿铁核块</grad></shadow><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>A </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>煤炭块</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 变为 原始煤炭原矿。</grad></shadow>"
				""
				"[!tip] 投入1个铁块，产出3至4个原始铁核。先建造这个。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>所有更高级的凝胶都同时具备这两种特性，只是速度更快。</grad></shadow>"
			]
			icon: "justdirethings:gooblock_tier1"
			id: "0EA1353D79064115"
			min_width: 330
			rewards: [
				{
					id: "3DBFA1DFE4147FB2"
