			}]
			title: "<shadow a=0.4><grad from=#FFC07A to=#FFE7CC f=0.6>简易燃料发电机</grad></shadow>"
			x: 3.5d
			y: 19.0d
		}
		{
			dependencies: ["2E6AE00249CD47DB"]
			description: [
				"# <grad from=#8CF5DE to=#DCFFF8 f=0.6><shadow a=0.3>水洼中的龙之息</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>中间是烈焰花，角落是末影珍珠，上下是末地石，</grad></shadow><grad from=#FF7A7A to=#FF3C3C f=0.8>侧面是龙息，</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它会吃掉 </grad></shadow><grad from=#7CF2E4 to=#1E9C97 f=0.8>紫颂果</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 或者 </grad></shadow><grad from=#7CF2E4 to=#1E9C97 f=0.8>末影珍珠</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#5FD8C4 to=#C4F7EE f=0.6><shadow a=0.3>新工作</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>A </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>钻石块</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将在大约十六秒后变为原始天蓝晶块。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>A </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>烈焰余烬块</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 变为 原始虚空焰煤炭。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它能稳定传送门流体，而低于三级的物品都无法做到这一点。</grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>提炼虚空火焰燃料。</grad></shadow>"
				""
				"[!info] 龙息是这里唯一有限的材料。每个凝胶块需要两个，而且龙会回来的。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>在5倍速下，你在1级建造的所有一切都会运行得更快五倍。</grad></shadow>"
			]
			icon: "justdirethings:gooblock_tier3"
			id: "7DBA91EE333E2504"
			min_width: 330
			rewards: [
				{
					id: "4F9C386247A478B1"
					type: "xp"
					xp: 200
				}
				{
					exclude_from_claim_all: true
					id: "451AB9EF86462FC2"
					table_id: 523655846730814564L
					type: "random"
				}
			]
			shape: "pentagon"
			size: 1.4d
			subtitle: "<typewriter><grad from=#5FD8C4 to=#5FD8C4>末地税。带一个瓶子来</grad>"
			tasks: [{
				id: "3331907838E4948E"
				item: "justdirethings:gooblock_tier3"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#7CF2E4 to=#D2FFF9 f=0.6>虚空闪烁凝胶</grad></shadow>"
			x: 0.0d
			y: 18.2d
		}
		{
			dependencies: ["7DBA91EE333E2504"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>钻石块对着虚空闪烁，大约十六秒，然后挖掘获取</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>3到4个</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 天穹宝石。</grad></shadow>"
				""
				"[!tip] 投入9个钻石，产出3到4个宝石。这样做是因为Celestigem是更好的材料，而不是因为它能产生更多。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>宝石掉落完成，这个不需要冶炼。</grad></shadow>"
			]
			icon: "justdirethings:raw_celestigem_ore"
			id: "180FA5311DE1FE5B"
			min_width: 300
			rewards: [{
				id: "6E62CE2D449ADEA3"
				type: "xp"
				xp: 100
			}]
			shape: "square"
			size: 1.0d
			subtitle: "<typewriter><grad from=#5FD8C4 to=#5FD8C4>钻石放进去，更好的钻石就出来了</grad>"
			tasks: [{
				icon: "justdirethings:raw_celestigem_ore"
				id: "45F120F05188D9F5"
				observe_type: 0
				timer: 0L
				title: "找到一个未加工的Celestigem矿石"
				to_observe: "justdirethings:raw_celestigem_ore"
				type: "observation"
			}]
			title: "<shadow a=0.4><grad from=#7CF2E4 to=#D2FFF9 f=0.6>原始Celestigem方块</grad></shadow>"
			x: 0.0d
			y: 21.0d
		}
		{
			dependencies: ["180FA5311DE1FE5B"]
			description: [
				"# <grad from=#8CF5DE to=#DCFFF8 f=0.6><shadow a=0.3>舒适层级</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>护甲与钻石相同，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>3/6/8/3</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 并具有 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>2.0</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 的韧性。工具耐久度为 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>1561</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，速度为 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>10.0</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，伤害为 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>4.0</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Blazegold 挖掘速度为 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>12.0</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，而此挖掘速度为 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>10.0</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，所以你是在用速度换取生存能力。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#5FD8C4 to=#C4F7EE f=0.6><shadow a=0.3>为什么这个等级很重要</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>该整合包将其视为</grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>下界合金阶梯上的</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一个方块。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它只出现在这里，下方没有踪影。</grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>Paxel</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>只出现在这里，下方没有踪影。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Celestigem 用于所有高级机器，包括能量传输器、虚空位移杖和高级传送门枪。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>打破天花板向上攀爬至 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>192</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 格高。</grad></shadow>"
				""
				"[!tip] 你可以停在这里。一套 Celestigem 装备足以应对任何情况，而下一级则需要用到下界合金块。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>比你想象的要多。每个高级配方都需要一些。</grad></shadow>"
			]
