			x: 2.0d
			y: 14.0d
		}
		{
			dependencies: ["2E6AE00249CD47DB"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>无需特定顺序，一个烈焰金锭和一个下界疣可合成 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>4</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 个。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将其中一个投入水中，就会变成 </grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>多态流体</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，它会变成任何你想要的东西。</grad></shadow>"
				""
				"[!info] 它也是原版传送门枪的原料，所以多做一些，别嫌多。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>故意弄得很便宜。贵的部分永远是你在第二秒扔下的东西。</grad></shadow>"
			]
			icon: "justdirethings:polymorphic_catalyst"
			id: "0F8EF5C2870A88A6"
			min_width: 320
			rewards: [{
				id: "016AD06E1241927B"
				type: "xp"
				xp: 50
			}]
			shape: "square"
			size: 1.0d
			subtitle: "<typewriter><grad from=#FFB070 to=#FFB070>一个锭，一个疣，四个出</grad>"
			tasks: [{
				id: "52BAA450AA0D49E9"
				item: "justdirethings:polymorphic_catalyst"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#FFC07A to=#FFE7CC f=0.6>多态催化剂</grad></shadow>"
			x: 2.0d
			y: 16.0d
		}
		{
			dependencies: ["0F8EF5C2870A88A6"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将多态催化剂投入一个 </grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>水源方块中</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#5FD8C4 to=#C4F7EE f=0.6><shadow a=0.3>下游的一切</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将 </grad></shadow><grad from=#FFC07A to=#D96A3C f=0.8>烈焰余烬</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>投入燃料槽中。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将 </grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>Portal Fluid Catalyst</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 投入传送门轨道，但有个陷阱。"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>投掷一个 </grad></shadow><grad from=#ECFF8C to=#17E517 f=0.8>时间水晶</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>，你正在玩弄时间。</grad></shadow>"
				""
				"[!tip] 流体放置器、对准水洼的投掷器和后面的流体收集器可以全自动完成整个转换。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>这些都是带有正确标签的流体，所以其他模组的管道可以处理它们。</grad></shadow>"
			]
