			x: 0.0d
			y: 6.500000000000001d
		}
		{
			dependencies: ["3C09296DEE9D1D7F"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>普通的工具形状。重要的是后面附加的东西。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#5FD8C4 to=#C4F7EE f=0.6><shadow a=0.3>费里科尔的要求</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>镐：</grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>矿石矿工</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>和</grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>矿石扫描仪</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>斧头：</grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>伐木机</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>和</grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>碎叶机</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>铲子：</grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>割草机</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>和</grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>天空清扫器</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>剑：</grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>生物扫描仪</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>锄头：没什么用，但它能把泥土变成 </grad></shadow><grad from=#B7F06A to=#6FBF2E f=0.8>Primogel 土壤</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[!info] 矿石矿工会追踪矿脉，直到矿脉耗尽或达到 `64` 格。在更高处，这个上限会升至 128、192 和 256。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>伐木机共享天花板，所以一棵大丛林树比一个Ferricore摆锤更耐用。</grad></shadow>"
			]
