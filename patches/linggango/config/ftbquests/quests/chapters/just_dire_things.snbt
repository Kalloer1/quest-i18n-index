				}
			]
			shape: "pentagon"
			size: 1.4d
			subtitle: "<typewriter><grad from=#9DB4BF to=#9DB4BF>深暗税。带上一个计划来</grad>"
			tasks: [{
				id: "4A05DC2BF0C4A75D"
				item: "justdirethings:gooblock_tier4"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#B7CBD4 to=#6A8290 f=0.6>暗影脉冲凝胶</grad></shadow>"
			x: 0.0d
			y: 26.599999999999998d
		}
		{
			dependencies: ["5A869BCC9CDD03B9"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>暗影脉冲抗性下界合金块，约八秒，然后</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>3 到 4 个</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>原始日食合金。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一个下界合金块需要九个锭，也就是三十六个废料和三十六个金。这是模组里最贵的转换了。</grad></shadow>"
				""
				"[!warn] 你正在把游戏中最贵的方块变成防御力完全一样的东西。为了能力，干吧。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>原矿日蚀合金可一比一熔炼。</grad></shadow>"
			]
			icon: "justdirethings:raw_eclipsealloy_ore"
			id: "3EBF8B885F91B612"
			min_width: 300
			rewards: [{
				id: "175196B71D88E30C"
				type: "xp"
				xp: 200
			}]
			shape: "square"
			size: 1.0d
			subtitle: "<typewriter><grad from=#9DB4BF to=#9DB4BF>下界合金输入，更多下界合金输出</grad></typewriter>"
			tasks: [{
				icon: "justdirethings:raw_eclipsealloy_ore"
				id: "420D21003CE83924"
				observe_type: 0
				timer: 0L
				title: "找到一个生月蚀合金矿石"
				to_observe: "justdirethings:raw_eclipsealloy_ore"
				type: "observation"
			}]
			title: "<shadow a=0.4><grad from=#B7CBD4 to=#6A8290 f=0.6>原始日食合金块</grad></shadow>"
			x: 0.0d
			y: 29.5d
		}
		{
			dependencies: ["3EBF8B885F91B612"]
			description: [
				"# <grad from=#8CF5DE to=#DCFFF8 f=0.6><shadow a=0.3>登上顶峰</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>工具：</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>2561</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>耐久度，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>16.0</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>挖掘速度，</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>5.0</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>伤害。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>护甲正是下界合金，包括其</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>3.0</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>韧性和击退抗性。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#5FD8C4 to=#C4F7EE f=0.6><shadow a=0.3>真正的原因</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>日蚀合金包含了</grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>模组里的所有能力</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>锤子范围 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>7x7</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>.</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>天花板高度为 </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>256</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 格。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>该整合包将其视为完整的一级台阶 </grad></shadow><grad from=#8CF5DE to=#2FA894 f=0.8>高于下界合金之上</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[!tip] 制作模板，升级你钟爱的 Celestigem 套件。每种能力仅需一个锭即可。"
				""
				"[间隔=5]"
