			x: -4.0d
			y: 25.5d
		}
		{
			dependencies: ["0631904FB4C3B18E"]
			description: [
				"# <grad from=#8CF5DE to=#DCFFF8 f=0.6><shadow a=0.3>最后一个</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>中间是虚空闪烁，角落是潜声，</grad></shadow><grad from=#FF7A7A to=#FF3C3C f=0.8>潜声尖叫者，</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>顶部和底部，两侧是回声碎片。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它会吃掉 </grad></shadow><grad from=#B7CBD4 to=#4E626F f=0.8>Sculk</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 或者一个 </grad></shadow><grad from=#B7CBD4 to=#4E626F f=0.8>Sculk Catalyst</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#5FD8C4 to=#C4F7EE f=0.6><shadow a=0.3>只有它能做到的事</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>A </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>下界合金块</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将变为原始日食合金。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>A </grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>虚空火焰煤炭块</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 变为 原始日食余烬。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>精炼顶级燃料。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将 </grad></shadow><grad from=#FF7A7A to=#FF3C3C f=0.8>晶洞紫水晶</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 转变为 </grad></shadow><grad from=#ECFF8C to=#17E517 f=0.8>晶洞时光水晶</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>并且运行速度是原来的</grad></shadow><grad from=#FFC46B to=#FF9E1F f=0.8>10倍</grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[!tip] 你需要一个真正的生长型紫水晶，那种能长出簇晶、用丝绸从晶洞中取出的。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>时间水晶块也能转化为萌芽方块，所以一个晶洞就足够了。</grad></shadow>"
			]
			icon: "justdirethings:gooblock_tier4"
			id: "5A869BCC9CDD03B9"
			min_width: 330
			rewards: [
				{
