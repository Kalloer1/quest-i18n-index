	parent: "31575DEBB2A21CCD"
	quest_links: [ ]
	quests: [
		{
			description: [
				"# <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>路径的工作原理</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你戴上戒指。没有仪式就无法取下。从那一刻起，世界变得更艰难，战利品也更丰厚了。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>配得上资格</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>许多最佳物品都取决于一个隐藏数值：你佩戴戒指所花费的时间占你在世界总时间的比例。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>原版模组将阈值设为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>99.5%</grad><grad from=#FFFFFF to=#C7C7C7>。本整合包将其降至 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>80%</grad><grad from=#FFFFFF to=#C7C7C7>，意味着你可以稍晚戴上戒指，最终仍能达标。</grad></shadow>"
				""
				"[!warn] 长时间不戴戒指会导致该百分比下降。这是一个移动平均值，而非一次性检查。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>生命之力代替法力</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Covenant of the Seven 将替换你的法力条为 </grad><grad from=#FF8A8A to=#E03131 f=0.8>生命之力</grad><grad from=#FFFFFF to=#C7C7C7>。每个法术消耗约 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>30</grad><grad from=#FFFFFF to=#C7C7C7> 点，乘以稀有度系数。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>常用法术：</grad><grad from=#FFC46B to=#FF9E1F f=0.8>2 次</grad><grad from=#FFFFFF to=#C7C7C7> 那样。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>不常见：</grad><grad from=#FFC46B to=#FF9E1F f=0.8>3 次</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>稀有度：</grad><grad from=#FFC46B to=#FF9E1F f=0.8>7次</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>史诗级：</grad><grad from=#FFC46B to=#FF9E1F f=0.8>12次</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>传说： </grad><grad from=#FFC46B to=#FF9E1F f=0.8>25 次</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[!danger] 清空酒吧会直接杀死你。唯一能阻止这个的是本页下方的禁果。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>作为交换，所有法术的冷却时间和施放时间将大幅下降，并且 </grad><grad from=#FF8A8A to=#E03131 f=0.8>Blasphemy</grad><grad from=#FFFFFF to=#C7C7C7> 插槽将开放。</grad></shadow>"
			]
			icon: "enigmaticlegacy:cursed_ring"
			id: "3D3F383DA42F5CDB"
			min_width: 380
			shape: "hexagon"
			size: 1.75d
			subtitle: "<typewriter><grad from=#E03131 to=#E03131>这里的一切都需要付出代价。</grad>"
			tasks: [{
				id: "3F16A9EF20A4CA5F"
				title: "我接受条款与条件"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>七项诅咒</grad></shadow>"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["3D3F383DA42F5CDB"]
			description: [
				"# <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>只有自己的击杀才算数</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>这些掉落物只有在您亲自给予致命一击时才会出现。宠物、铁傀儡和坠落伤害均不计入在内。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它们会叠加在普通掉落物之上，并且你的抢夺效果仍然对这些掉落物有效。</grad></shadow>"
				""
				"{@pagebreak}"
				""
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>常见生物</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>潜行兽</grad><grad from=#FFFFFF to=#C7C7C7>: 1 星尘，概率为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>20 %</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>骷髅和流浪者</grad><grad from=#FFFFFF to=#C7C7C7>：</grad><grad from=#FFC46B to=#FF9E1F f=0.8>3 到 15 支箭。</grad><grad from=#FFFFFF to=#C7C7C7></grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>僵尸和骷髅马</grad><grad from=#FFFFFF to=#C7C7C7>: </grad><grad from=#FFC46B to=#FF9E1F f=0.8>1 到 3 个</grad><grad from=#FFFFFF to=#C7C7C7> 史莱姆球，概率为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>25 %</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>蜘蛛和洞穴蜘蛛</grad><grad from=#FFFFFF to=#C7C7C7>: </grad><grad from=#FFC46B to=#FF9E1F f=0.8>2 到 12 个</grad><grad from=#FFFFFF to=#C7C7C7> 线。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>苦力怕</grad><grad from=#FFFFFF to=#C7C7C7>: </grad><grad from=#FFC46B to=#FF9E1F f=0.8>4 至 12 个</grad><grad from=#FFFFFF to=#C7C7C7> 火药。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>小鸡</grad><grad from=#FFFFFF to=#C7C7C7>: 1 个鸡蛋，概率为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>50 %</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>末影人</grad><grad from=#FFFFFF to=#C7C7C7>: </grad><grad from=#FFC46B to=#FF9E1F f=0.8>1 至 2 个</grad><grad from=#FFFFFF to=#C7C7C7> 末影之眼，概率为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>40 %</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>Drowned</grad><grad from=#FFFFFF to=#C7C7C7>: </grad><grad from=#FFC46B to=#FF9E1F f=0.8>1 至 3 个</grad><grad from=#FFFFFF to=#C7C7C7> 青金石在 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>30 百分比处</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"{@pagebreak}"
				""
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>下界生物</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>烈焰人</grad><grad from=#FFFFFF to=#C7C7C7>: </grad><grad from=#FFC46B to=#FF9E1F f=0.8>0 至 5 个</grad><grad from=#FFFFFF to=#C7C7C7> 烈焰粉。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>岩浆立方体</grad><grad from=#FFFFFF to=#C7C7C7>: 1 个烈焰粉，概率为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>50 %</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>恶魂</grad><grad from=#FFFFFF to=#C7C7C7>：</grad><grad from=#FFC46B to=#FF9E1F f=0.8>1 至 4 个</grad><grad from=#FFFFFF to=#C7C7C7>幻影膜。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>Piglins</grad><grad from=#FFFFFF to=#C7C7C7>: </grad><grad from=#FFC46B to=#FF9E1F f=0.8>2 至 4 个</grad><grad from=#FFFFFF to=#C7C7C7> 金锭，概率为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>50%</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>僵尸猪人</grad><grad from=#FFFFFF to=#C7C7C7>：</grad><grad from=#FFC46B to=#FF9E1F f=0.8>1 至 3 个</grad><grad from=#FFFFFF to=#C7C7C7>，概率为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>40%</grad><grad from=#FFFFFF to=#C7C7C7>，外加 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>1 至 7 个</grad><grad from=#FFFFFF to=#C7C7C7> 萤石粉，概率为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>30%</grad><grad from=#FFFFFF to=#C7C7C7>。"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>猪灵恶霸</grad><grad from=#FFFFFF to=#C7C7C7>：在 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>20 百分比</grad><grad from=#FFFFFF to=#C7C7C7> 处掉落 1 个下界合金碎片。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>凋零骷髅</grad><grad from=#FFFFFF to=#C7C7C7>：</grad><grad from=#FFC46B to=#FF9E1F f=0.8>0 至 3 个</grad><grad from=#FFFFFF to=#C7C7C7>烈焰粉，一个在 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>20 百分比</grad><grad from=#FFFFFF to=#C7C7C7>处的恶魂之泪，和一个在 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>7 百分比</grad><grad from=#FFFFFF to=#C7C7C7>处的下界合金碎片。</grad></shadow>"
				""
				"{@pagebreak}"
				""
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>村庄与掠夺</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>村民</grad><grad from=#FFFFFF to=#C7C7C7>: </grad><grad from=#FFC46B to=#FF9E1F f=0.8>2 至 6 个</grad><grad from=#FFFFFF to=#C7C7C7> 绿宝石。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>掠夺者和卫道士</grad><grad from=#FFFFFF to=#C7C7C7>: </grad><grad from=#FFC46B to=#FF9E1F f=0.8>0 到 4 个</grad><grad from=#FFFFFF to=#C7C7C7> 绿宝石。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>女巫</grad><grad from=#FFFFFF to=#C7C7C7>：30% 概率掉落一个 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>幻影膜碎片</grad><grad from=#FFFFFF to=#C7C7C7> 和 1 至 3 个幻影膜，概率为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>50%</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>Vexes</grad><grad from=#FFFFFF to=#C7C7C7>: </grad><grad from=#FFC46B to=#FF9E1F f=0.8>0 至 2</grad><grad from=#FFFFFF to=#C7C7C7> 在 30% 概率下用发光石粉尘和幻影膜合成。 </grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>劫掠者</grad><grad from=#FFFFFF to=#C7C7C7>：</grad><grad from=#FFC46B to=#FF9E1F f=0.8>3 至 10 个</grad><grad from=#FFFFFF to=#C7C7C7> 绿宝石，</grad><grad from=#FFC46B to=#FF9E1F f=0.8>2 至 7 个</grad><grad from=#FFFFFF to=#C7C7C7> 皮革和 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>0 至 4 个</grad><grad from=#FFFFFF to=#C7C7C7> 钻石，概率为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>50 %</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>Evokers</grad><grad from=#FFFFFF to=#C7C7C7>：必定掉落一个不死图腾，</grad><grad from=#FFC46B to=#FF9E1F f=0.8>5至20个</grad><grad from=#FFFFFF to=#C7C7C7>绿宝石，有</grad><grad from=#FFC46B to=#FF9E1F f=0.8>10%</grad><grad from=#FFFFFF to=#C7C7C7>概率掉落附魔金苹果，有</grad><grad from=#FFC46B to=#FF9E1F f=0.8>30%</grad><grad from=#FFFFFF to=#C7C7C7>概率掉落末影珍珠和烈焰棒，以及有</grad><grad from=#FFC46B to=#FF9E1F f=0.8>4至10个</grad><grad from=#FFFFFF to=#C7C7C7>附魔水瓶的概率为</grad><grad from=#FFC46B to=#FF9E1F f=0.8>50%</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"{@pagebreak}"
				""
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>水与首领</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>守护者</grad><grad from=#FFFFFF to=#C7C7C7>：一个鹦鹉螺壳，占 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>15 百分比</grad><grad from=#FFFFFF to=#C7C7C7> 和 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>2 至 5 个</grad><grad from=#FFFFFF to=#C7C7C7> 棱镜晶。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>远古守卫者</grad><grad from=#FFFFFF to=#C7C7C7>： </grad><grad from=#FFC46B to=#FF9E1F f=0.8>4至16个</grad><grad from=#FFFFFF to=#C7C7C7>海晶灯晶体， </grad><grad from=#FFC46B to=#FF9E1F f=0.8>7至28个</grad><grad from=#FFFFFF to=#C7C7C7>海晶灯碎片，以及一个必得的物品，可能为守护者之心、海洋之心、附魔金苹果、末影之眼或附魔等级为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>25至40级</grad><grad from=#FFFFFF to=#C7C7C7>的三叉戟。"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>凋零者</grad><grad from=#FFFFFF to=#C7C7C7>: </grad><grad from=#FFC46B to=#FF9E1F f=0.8>1 至 4 个</grad><grad from=#FFFFFF to=#C7C7C7> 邪恶精华。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#D9A5FF to=#B06BE8 f=0.8>末影龙</grad><grad from=#FFFFFF to=#C7C7C7>: 一颗深渊之心，前提是你足够强大且拥有的少于 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>5</grad><grad from=#FFFFFF to=#C7C7C7> 个。</grad></shadow>"
				""
				"[!info] Evoker 是诅咒玩家刷林地府邸的原因。每个 Evoker 都能稳定掉落一个图腾，这完全改变了游戏玩法。"
			]
			icon: "enigmaticlegacy:monster_charm"
			id: "2A8F3121804FEC4F"
			min_width: 500
			optional: true
			shape: "circle"
			subtitle: "<typewriter><grad from=#E03131 to=#E03131>戴上戒指的真正原因。</grad></typewriter>"
			tasks: [{
				id: "386DE0FA0361C49A"
				title: "我读了掉落物品列表"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>自定义掉落表</grad></shadow>"
			x: -0.5d
			y: -2.5d
		}
		{
			dependencies: ["3D3F383DA42F5CDB"]
			description: [
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>在血祭坛上锻造</shadow></grad>"
				""
				"将一颗 </grad><grad from=#D9A5FF to=#B06BE8 f=0.8>大地之心</grad><grad from=#FFFFFF to=#C7C7C7> 投入等级为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>2</grad><grad from=#FFFFFF to=#C7C7C7> 或更高的 </grad><grad from=#FF8A8A to=#E03131 f=0.8>血祭坛</grad><grad from=#FFFFFF to=#C7C7C7> 中，并为其提供 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>25,000</grad><grad from=#FFFFFF to=#C7C7C7> 生命点。这样就能获得一颗扭曲之心。"
				""
				"[!info] 如果你从未建造过祭坛，血魔法有专属章节。你需要一个2级祭坛和一堆耐心。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它是多种物品的合成材料，包括不祥之石、血染勇武徽章、扭曲之镜和暗夜契约。</grad></shadow>"
			]
			id: "38D6971551A08950"
			min_width: 350
			rewards: [{
				id: "23C690A75C08DFFC"
				item: "enigmaticlegacy:twisted_heart"
				type: "item"
			}]
			shape: "pentagon"
			size: 1.0d
			subtitle: "<typewriter><grad from=#E03131 to=#E03131>一颗地球之心，被刻意摧毁。</grad>"
			tasks: [{
				id: "5519F75C71F4D908"
				item: "enigmaticlegacy:twisted_heart"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>扭曲之心</grad></shadow>"
			x: -2.0d
			y: 0.5d
		}
		{
			dependencies: ["3D3F383DA42F5CDB"]
			description: [
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>凋零农场</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>佩戴戒指击杀凋灵，它会掉落这些物品，数量为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>1 至 4 个</grad><grad from=#FFFFFF to=#C7C7C7>。没有其他获取途径。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>几乎所有后期诅咒配方都需要它，所以找个安全的地方建个凋零竞技场，舒舒服服地干吧。</grad></shadow>"
			]
			hide_dependency_lines: true
			id: "7AE2E0E5BF08A56D"
			min_width: 340
			shape: "pentagon"
			subtitle: "<typewriter><grad from=#E03131 to=#E03131>从凋灵身上撕下来的。</grad></typewriter>"
			tasks: [{
				id: "783F483BF289A72C"
				item: "enigmaticlegacy:evil_essence"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>邪恶精华</grad></shadow>"
			x: 4.5d
			y: 0.0d
		}
		{
			dependencies: ["7AE2E0E5BF08A56D"]
			description: [
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>精炼的凋零</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Covenant of the Seven 将其改为绑定试剂、邪恶精华和一件下界合金锭。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>喂养了不洁之石、诅咒雕刻者、荒芜之重、贪婪之盘和混沌傲慢。</grad></shadow>"
			]
			hide_dependency_lines: false
			id: "50D0EB44E5B05247"
			min_width: 330
			subtitle: "<typewriter><grad from=#E03131 to=#E03131>下界合金，变得更差了。或者更好了？</grad></typewriter>"
			tasks: [{
				id: "209D5DAA46D70937"
				item: "enigmaticlegacy:evil_ingot"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>邪恶锭</grad></shadow>"
			x: 4.5d
			y: 1.5d
		}
		{
			dependencies: ["3D3F383DA42F5CDB"]
			description: [
				"# <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>每一次死亡都会撕裂你的灵魂</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>佩戴戒指期间，死亡会消耗一个灵魂水晶。每失去一个，你的最大生命值将永久减少 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>10%</grad><grad from=#FFFFFF to=#C7C7C7>，直到你将其替换为止。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你最多可以损失 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>9</grad><grad from=#FFFFFF to=#C7C7C7>。这将使你的生命值降至十分之一，后果正如听起来那么严重。</grad></shadow>"
				""
				"[gap=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>把它们带回来</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>右键灵魂水晶可恢复一个丢失的水晶。此整合包新增配方：八个钻石粉围绕一个 </grad><grad from=#D9A5FF to=#B06BE8 f=0.8>腐化灵魂碎片</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[!tip] 腐化灵魂碎片需要用以太铳刀切割腐化灵魂才能获得，所以精致工具还是值得一看的。"
			]
			hide_dependency_lines: true
			id: "2BD71458967A0D47"
			min_width: 360
			shape: "pentagon"
			subtitle: "<typewriter><grad from=#E03131 to=#E03131>第六诅咒，现已解释。</grad></typewriter>"
			tasks: [{
				id: "353EC0D64159DD74"
				item: "enigmaticlegacy:soul_crystal"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>灵魂水晶</grad></shadow>"
			x: -4.5d
			y: 0.0d
		}
		{
			dependencies: ["58D953EAFE77BB1A"]
			description: [
				"## <grad from=#C8AE86 to=#EBD9B8 f=0.6><shadow a=0.3>另一个模组的回答</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Enigmatic Delicacy 加入了其独特的灵魂水晶。它有自己的章节，并且物品在 Shift 键下会自我说明。</grad></shadow>"
			]
			hide_dependency_lines: false
			id: "6B930A43A2D42DEF"
			min_width: 320
			optional: true
			subtitle: "<typewriter><grad from=#C8AE86 to=#C8AE86>来自 Enigmatic Delicacy 的问候。</grad></typewriter>"
			tasks: [{
				id: "070052177F7BB485"
				item: "enigmaticdelicacy:cursed_soul_crystal"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>被诅咒的灵魂水晶</grad></shadow>"
			x: -4.5d
			y: 3.0d
		}
		{
			dependencies: ["2BD71458967A0D47"]
			description: [
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>只有一个任务的指南针</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它会转向离世界最近的灵魂水晶。考虑到丢失水晶的代价，能找回它是很合理的。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>指南针、扭曲之心、灵魂灯笼、烈焰粉、黄金和下界合金。</grad></shadow>"
				""
				"[!warn] 只对被诅咒者有效。其他人拿的只是一只昂贵的指南针。"
			]
			hide_dependency_lines: false
			id: "58D953EAFE77BB1A"
			min_width: 330
			subtitle: "<typewriter><grad from=#E03131 to=#E03131>指向最近的灵魂水晶。</grad></typewriter>"
			tasks: [{
				id: "2C55FD4711BE36F0"
				item: "enigmaticlegacy:soul_compass"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>被诅咒者的引路人</grad></shadow>"
			x: -4.5d
			y: 1.5d
		}
		{
			dependencies: ["2A8F3121804FEC4F"]
			description: [
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>两种模式，都怪怪的</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在背包中，守卫在距离你 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>24</grad><grad from=#FFFFFF to=#C7C7C7> 格内会转为中立并开始为你狩猎怪物。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在快捷栏中，看向距离你 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>24</grad><grad from=#FFFFFF to=#C7C7C7> 格内的怪物会使其暴怒。它会变强并转而攻击距离它最近的另一个怪物（在 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>12</grad><grad from=#FFFFFF to=#C7C7C7> 格内），附近的所有生物都会一拥而上攻击它。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>激怒有 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>10秒的</grad><grad from=#FFFFFF to=#C7C7C7>冷却时间，部分怪物对其免疫。</grad></shadow>"
				""
				"由远古守卫者掉落，是受诅咒掉落表中的必出物品之一。"
			]
			hide_dependency_lines: false
			id: "28E10C14767C50CB"
			min_width: 340
			optional: true
			subtitle: "<typewriter><grad from=#E03131 to=#E03131>让怪物们互相战斗。</grad>"
			tasks: [{
				id: "199342185B15CE75"
				item: "enigmaticlegacy:guardian_heart"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>守护者的核心</grad></shadow>"
			x: -2.0d
			y: -2.5d
		}
		{
			dependencies: ["38D6971551A08950"]
			description: [
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>完全寂静</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>基础模组会阻止铁傀儡、末影人、猪灵和僵尸猪灵在你周围生成。七约模组更进一步，会阻止</grad><grad from=#FF8A8A to=#E03131 f=0.8>一切生物</grad><grad from=#FFFFFF to=#C7C7C7>永久地在你附近生成。</grad></shadow>"
				""
				"[!warn] 这包括你正在刷的怪物。戴上这枚戒指就代表承诺，而非一时兴起。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>深渊之心、邪恶锭、扭曲之心和铁环。</grad></shadow>"
				""
				"[!info] 想要获得反转诫命，就必须同时佩戴诅咒戒指，所以如果你想走完整路线，这个就不是可选的。"
			]
			hide_dependency_lines: false
			id: "24D9E56712D86874"
			min_width: 350
			shape: "diamond"
			subtitle: "<typewriter><grad from=#E03131 to=#E03131>你身边没有任何生物生成。什么都没有。</grad>"
			tasks: [{
				id: "4441DB6D82E7E2CA"
				item: "enigmaticlegacy:desolation_ring"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>荒芜的负担</grad></shadow>"
			x: -2.0d
			y: 1.5d
		}
		{
			dependencies: ["3D3F383DA42F5CDB"]
			description: [
				"# <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>模组中最难获得的掉落物</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在配得上它时击败末影龙，它会留下一颗深渊之心。整个世界中最多可收集 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>5</grad><grad from=#FFFFFF to=#C7C7C7> 个。</grad></shadow>"
				""
				"[!danger] 它不会和其他战利品一起掉在地上。它会精确地出现在龙死亡的位置，静静地漂浮在空中。人们总是错过它。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>此整合包新增了一个生物锻造配方，可将一个深渊之心、一个邪恶精华和两个末日之心合成两个物品，因此上限没有看起来那么严苛。</grad></shadow>"
			]
			id: "4F2A8781B8A6E7BC"
			min_width: 360
			shape: "diamond"
			size: 1.0d
			subtitle: "<typewriter><grad from=#E03131 to=#E03131>杀死巨龙。然后抬头看。</grad>"
			tasks: [{
				id: "4F90D521CA6FDEAA"
				item: "enigmaticlegacy:abyssal_heart"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>深渊之心</grad></shadow>"
			x: -2.0d
			y: -0.5d
		}
		{
			dependencies: ["4F2A8781B8A6E7BC"]
			description: [
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>继续努力</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>沉睡的亵渎消耗一个。荒芜的负担消耗一个。傲慢的混沌消耗一个。暴力的诅咒消耗一个。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在卫道士给你任何东西之前，你需要集齐五样，所以重生巨龙，再来一次吧。</grad></shadow>"
			]
			hide_dependency_lines: false
			id: "7C7ECBDF10FBAD90"
			min_width: 330
			shape: "diamond"
			subtitle: "<typewriter><grad from=#E03131 to=#E03131>已有三头龙加入，数量仍在增加中。</grad></typewriter>"
			tasks: [{
				id: "05EF5CA3839FB37C"
				item: "enigmaticlegacy:abyssal_heart"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>深渊之心，再现</grad></shadow>"
			x: -3.0d
			y: 0.0d
		}
		{
			dependencies: ["7C7ECBDF10FBAD90"]
			description: [
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>五步完成</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>游戏统计的是你获得的总数，而非当前持有的数量。一旦计数器达到</grad><grad from=#FFC46B to=#FF9E1F f=0.8>5</grad><grad from=#FFFFFF to=#C7C7C7>，龙就会停止给予，而坚守者也开始注意你了。</grad></shadow>"
				""
				"[!tip] 花费它们不会减少计数器。集齐五种后便可自由合成。"
			]
			hide_dependency_lines: false
			id: "2B49E79ABB521180"
			min_width: 340
			shape: "diamond"
			subtitle: "<typewriter><grad from=#E03131 to=#E03131>计数器现已充满。</grad></typewriter>"
			tasks: [{
				id: "122CAF773B05DFA1"
				item: "enigmaticlegacy:abyssal_heart"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>第五颗心</grad></shadow>"
			x: -3.5d
			y: 1.0d
		}
		{
			dependencies: ["3D3F383DA42F5CDB"]
			description: [
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>吃了就再也不想吃</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你将再也不会感到饥饿。作为回报，你收到的所有治疗效果都会减弱 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>80 个百分点</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>对于被诅咒的玩家，有一个比两者都重要的第三种效果：将你的 </grad><grad from=#FF8A8A to=#E03131 f=0.8>生命之力</grad><grad from=#FFFFFF to=#C7C7C7>消耗至零将不再导致死亡。</grad></shadow>"
				""
				"<shadow a=0.3><shadow a=0.3><grad from=#A0A0A0 to=#606060>如果你更愿意冒险而不是建造生物锻造炉，它偶尔也会出现在堡垒的箱子里。</grad></shadow></shadow>"
				""
				"[!info] 此整合包添加了使用黑质、暗影碎片和暗黑苹果的生化锻造配方，这样你就不用等待稀有掉落了。"
			]
			id: "240C6600ADD40176"
			min_width: 350
			shape: "diamond"
			subtitle: "<typewriter><grad from=#E03131 to=#E03131>知识是最伟大的馈赠。</grad></typewriter>"
			tasks: [{
				id: "42E0614D0A79C105"
				item: "enigmaticlegacy:forbidden_fruit"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>禁果</grad></shadow>"
			x: 1.5d
			y: 0.0d
		}
		{
			dependencies: ["240C6600ADD40176"]
			description: [
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>再思前想后</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>喝下它，禁果的效力就会消失。饥饿感会回归，治疗会恢复正常，生命力的安全网也随之解除。</grad></shadow>"
				""
				"[!warn] 请三思。安全网是你与糟糕的施法顺序和即死之间唯一的屏障。"
			]
			hide_dependency_lines: false
			id: "0179C55C8A291154"
			min_width: 330
			subtitle: "<typewriter><grad from=#E03131 to=#E03131>撤销水果的效果。</grad></typewriter>"
			tasks: [{
				id: "31D4F2AEAB6EA16D"
				item: "enigmaticlegacy:redemption_potion"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>救赎药水</grad></shadow>"
			x: 2.5d
			y: 0.5d
		}
		{
			dependencies: ["240C6600ADD40176"]
			description: [
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>有两个答案的测试</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>戴上戒指并吃过禁果后再饮用，它会对你非常好。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>像其他人一样喝下它，你只会得到凋零和中毒作为回报。</grad></shadow>"
				""
				"[!tip] 物品本身的提示框会劝阻你使用它。这就是提示。"
				""
				"<shadow a=0.3><shadow a=0.3><grad from=#A0A0A0 to=#606060>没有配方。它出现在主世界地牢的箱子里，并且是这些箱子里最稀有的物品，没有之一。</grad></shadow></shadow>"
			]
			hide_dependency_lines: false
			id: "76F550C3F4DA2886"
			min_width: 340
			subtitle: "<typewriter><grad from=#E03131 to=#E03131>你最好别用这个喝东西。</grad></typewriter>"
			tasks: [{
				id: "2EDA2B0489BEC109"
				item: "enigmaticlegacy:unholy_grail"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>不洁圣杯</grad></shadow>"
			x: 2.5d
			y: -0.5d
		}
		{
			dependencies: ["3D3F383DA42F5CDB"]
			description: [
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>尸体竞速，已解决</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将你直接传送到上次死亡的位置，到达时仍处于濒死状态。</grad></shadow>"
				""
				"[!warn] 如果你在岩浆中死亡，你将出现在岩浆中，只剩半颗心。做好准备。"
				""
				"<shadow a=0.3><shadow a=0.3><grad from=#A0A0A0 to=#606060>只对被诅咒者有效，前提是游戏还记得你死在哪里。</grad></shadow></shadow>"
