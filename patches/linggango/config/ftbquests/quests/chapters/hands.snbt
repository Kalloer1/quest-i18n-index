				id: "295A197848F721CD"
				item: "terramity:exodium_twin_bracelets"
				type: "item"
			}]
			x: -6.5d
			y: 5.5d
		}
		{
			description: [
				"<shadow a=0.3><grad from=#E2683B to=#FFC0A8 f=0.8>大幅提升攻击速度。</grad><grad from=#FFFFFF to=#C7C7C7> 提示框没有给出具体数值，也不需要给出。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>光谱之魂、天使羽毛、瑞文石和能量核心，这真是一个真正的终局配方。</grad></shadow>"
				""
				"[!info] 对于命中施加效果的物品，这是模组里最佳搭配，因为挥砍越多，叠加层数就越多。"
			]
			id: "7C00055BF9FC7762"
			tasks: [{
				id: "04DFAF55927EFE4F"
				item: "terramity:sacred_speed_bracelets"
				type: "item"
			}]
			x: -5.5d
			y: 5.5d
		}
		{
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>由闪电击中普通嗅探者生成的、拥有 </grad><grad from=#E2683B to=#FFC0A8 f=0.8>1500点生命值</grad><grad from=#FFFFFF to=#C7C7C7>的 boss，即 </grad><grad from=#E2683B to=#FFC0A8 f=0.8>超级嗅探者，会掉落物品。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它也是 Summonity 中 </grad><grad from=#E2683B to=#FFC0A8 f=0.8>大力神甲虫</grad><grad from=#FFFFFF to=#C7C7C7>的一半，能提升 </grad><grad from=#E2683B to=#FFC0A8 f=0.8>+20%的仆从伤害，所以不要随意使用。</grad></shadow>"
			]
			id: "6D7369CB8BE696A6"
			tasks: [{
				id: "79B61DFECE663BF2"
				item: "terramity:giant_sniffers_hoof"
				type: "item"
			}]
			x: -4.5d
			y: 5.5d
		}
		{
			description: [
				"免疫于你所有投射物的 boss，即试炼守卫掉落。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它也是 Summonity 中 </grad><grad from=#E2683B to=#FFC0A8 f=0.8>鞭子手套</grad><grad from=#FFFFFF to=#C7C7C7>的核心，能让鞭子自动挥舞。这是召唤师职业最大的生活便利道具。</grad></shadow>"
			]
			id: "6E3CC2321DC7CB55"
			tasks: [{
				id: "6ADBDF416E031335"
				item: "terramity:guardians_hand"
				type: "item"
			}]
			x: -3.5d
			y: 5.5d
		}
		{
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>被诅咒的灵魂、导电体和铜。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>打破任何模组的生物生成器都会引来被诅咒的灵魂，所以探索而非挖矿才是回报所在。</grad></shadow>"
