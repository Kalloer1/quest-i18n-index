			dependencies: ["71BBFA395E76C1F2"]
			description: [
				"- <shadow a=0.3><grad from=#C0392B to=#F2A9A0 f=0.8>血之球体</grad><grad from=#FFFFFF to=#C7C7C7>：</grad><grad from=#C0392B to=#F2A9A0 f=0.8>每受到一点伤害，恢复15点法力值。</grad><grad from=#FFFFFF to=#C7C7C7></grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#C0392B to=#F2A9A0 f=0.8>大魔导师的诡计</grad><grad from=#FFFFFF to=#C7C7C7>: 将一半的生命值转化为法力，比例为 </grad><grad from=#C0392B to=#F2A9A0 f=0.8>1 颗心 = 15 点法力</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C0392B to=#F2A9A0 f=0.8>法力注射器</grad><grad from=#FFFFFF to=#C7C7C7>：将真实近战伤害的 </grad><grad from=#C0392B to=#F2A9A0 f=0.8>25%</grad><grad from=#FFFFFF to=#C7C7C7> 转化为法力值。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#C0392B to=#F2A9A0 f=0.8>灵魂石</grad><grad from=#FFFFFF to=#C7C7C7>: </grad><grad from=#C0392B to=#F2A9A0 f=0.8>5 百分比</grad><grad from=#FFFFFF to=#C7C7C7> 几率全额返还法术，否则返还 </grad><grad from=#C0392B to=#F2A9A0 f=0.8>15 百分比</grad><grad from=#FFFFFF to=#C7C7C7> 的费用。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C0392B to=#F2A9A0 f=0.8>回响室</grad><grad from=#FFFFFF to=#C7C7C7>: 根据消耗的法力缩短法术冷却时间，每消耗 </grad><grad from=#C0392B to=#F2A9A0 f=0.8>10点法力缩短1%</grad><grad from=#FFFFFF to=#C7C7C7>，最高不超过 </grad><grad from=#C0392B to=#F2A9A0 f=0.8>25%</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C0392B to=#F2A9A0 f=0.8>黑曜石偶像</grad><grad from=#FFFFFF to=#C7C7C7>：每消耗 </grad><grad from=#C0392B to=#F2A9A0 f=0.8>200 法力值</grad><grad from=#FFFFFF to=#C7C7C7>，会重置你所有的法术冷却时间。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#C0392B to=#F2A9A0 f=0.8>抄写者索引</grad><grad from=#FFFFFF to=#C7C7C7>: </grad><grad from=#C0392B to=#F2A9A0 f=0.8>+25%</grad><grad from=#FFFFFF to=#C7C7C7>满法力时法术伤害，</grad><grad from=#C0392B to=#F2A9A0 f=0.8>-10%</grad><grad from=#FFFFFF to=#C7C7C7>否则。"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C0392B to=#F2A9A0 f=0.8>德尔塔符文</grad><grad from=#FFFFFF to=#C7C7C7>：</grad><grad from=#C0392B to=#F2A9A0 f=0.8>+1 法力再生，</grad><grad from=#FFFFFF to=#C7C7C7>每低于你站立处7级的光照强度提供一点。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C0392B to=#F2A9A0 f=0.8>保守调配物</grad><grad from=#FFFFFF to=#C7C7C7>：最多可提升 </grad><grad from=#C0392B to=#F2A9A0 f=0.8>+100%</grad><grad from=#FFFFFF to=#C7C7C7> 法力再生，随法力值接近满值而增强。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C0392B to=#F2A9A0 f=0.8>应急瓶</grad><grad from=#FFFFFF to=#C7C7C7>: </grad><grad from=#C0392B to=#F2A9A0 f=0.8>+33%</grad><grad from=#FFFFFF to=#C7C7C7>生命低于</grad><grad from=#C0392B to=#F2A9A0 f=0.8>50%时，</grad><grad from=#FFFFFF to=#C7C7C7>施法速度提升。</grad></shadow>"
