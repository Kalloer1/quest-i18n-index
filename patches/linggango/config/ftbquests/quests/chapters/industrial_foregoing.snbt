				"# <grad from=#AFC3D8 to=#E6EFF8 f=0.6><shadow a=0.3>将它们夹在两侧</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#AFC3D8 to=#E6EFF8 f=0.8>提取器</grad><grad from=#FFFFFF to=#C7C7C7>将物品从接触到的方块中拉入传送带。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#AFC3D8 to=#E6EFF8 f=0.8>插入器</grad><grad from=#FFFFFF to=#C7C7C7>将物品从传送带上推入所接触方块中。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#AFC3D8 to=#E6EFF8 f=0.8>分流器</grad><grad from=#FFFFFF to=#C7C7C7>将物品交替送入两条路径。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#AFC3D8 to=#E6EFF8 f=0.8>Detection</grad><grad from=#FFFFFF to=#C7C7C7>有东西经过时会发出红石信号。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#AFC3D8 to=#E6EFF8 f=0.8>将物品从腰带中掉落至地面。</grad><grad from=#FFFFFF to=#C7C7C7></grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#AFC3D8 to=#E6EFF8 f=0.8>弹跳器</grad><grad from=#FFFFFF to=#C7C7C7>会将传送带上的一切物品弹向空中。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#AFC3D8 to=#E6EFF8 f=0.8>闪烁</grad><grad from=#FFFFFF to=#C7C7C7>将物品传送过皮带线上的间隙。</grad></shadow>"
