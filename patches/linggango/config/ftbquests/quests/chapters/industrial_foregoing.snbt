				xp: 15
			}]
			shape: "hexagon"
			size: 1.0d
			subtitle: "<typewriter><grad from=#FF5A3C to=#FF5A3C>用激光对准箱子，直到矿石出现为止</grad>"
			tasks: [{
				id: "5D3314491EED0E91"
				title: "激光。显而易见。"
