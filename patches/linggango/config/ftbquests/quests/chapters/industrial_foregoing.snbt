				xp: 10
			}]
			shape: "square"
			size: 1.0d
			subtitle: "<typewriter><grad from=#8FE33F to=#8FE33F>左边附魔，右边普通</grad>"
			tasks: [{
				id: "52395ECB460E0EA7"
				item: "industrialforegoing:enchantment_sorter"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#8FE33F to=#D8FFA8 f=0.6>附魔分类器</grad></shadow>"
			x: 0.0d
			y: 51.0d
		}
		{
			dependencies: ["5150902A2FB229B8"]
			description: [
				"# <grad from=#8FE33F to=#D8FFA8 f=0.6><shadow a=0.3>附魔物品</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>塑料、两个铁砧、两个金齿轮和一个 </grad><grad from=#8FE33F to=#D8FFA8 f=0.8>高级框架</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它能像铁砧一样组合两种物品，但消耗的是</grad><grad from=#8FE33F to=#D8FFA8 f=0.8>精华</grad><grad from=#FFFFFF to=#C7C7C7>而非你的等级，而且绝不会提示太昂贵。</grad></shadow>"
				""
				"[!danger] 此整合包已禁用最大附魔等级检查。在这里，你可以突破附魔的正常上限，没有任何东西能阻止你。这是有意为之的。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它还能从正上方的</grad><grad from=#8FE33F to=#D8FFA8 f=0.8>储罐中抽取精华</grad><grad from=#FFFFFF to=#C7C7C7>，所以常规搭建方式是将精华黑洞储罐平衡地放置在施用器上。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>它自身的储罐可容纳64,000，是本模组中任何机器最大的精华缓冲器。</grad></shadow>"
			]
			id: "42698B4B92D2698E"
			min_width: 340
			rewards: [
				{
					id: "3E5BC4F175CD2A82"
					type: "xp"
					xp: 25
				}
				{
					exclude_from_claim_all: true
					id: "34E12C4DC025DA42"
					table_id: 3488080005486828330L
					type: "random"
				}
			]
			shape: "square"
			size: 1.0d
			subtitle: "<typewriter><grad from=#8FE33F to=#8FE33F>这里没有等级上限的铁砧</grad>"
			tasks: [{
				id: "4BE85160F40B311C"
				item: "industrialforegoing:enchantment_applicator"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#8FE33F to=#D8FFA8 f=0.6>附魔应用器</grad></shadow>"
			x: 2.0d
			y: 48.0d
		}
		{
			dependencies: ["42698B4B92D2698E"]
			description: [
				"# <grad from=#8FE33F to=#D8FFA8 f=0.6><shadow a=0.3>掷骰子</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>塑料、一本书、两颗钻石、三块黑曜石和一个 </grad><grad from=#8FE33F to=#D8FFA8 f=0.8>高级框架</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>喂饱它，需要 </grad><grad from=#8FE33F to=#D8FFA8 f=0.8>28,200 精华</grad><grad from=#FFFFFF to=#C7C7C7> 和一件物品，然后它会为其附魔一个 </grad><grad from=#8FE33F to=#D8FFA8 f=0.8>50级</grad><grad from=#FFFFFF to=#C7C7C7> 的附魔。不是附魔台的极限30级。而是50级。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>28,200 essence 相当于 1,410 经验值，所以并不便宜，但安装在机械泥土上的 Mob Crusher 几分钟就能回本。</grad></shadow>"
				""
				"[!tip] 滚动附魔书，把好书喂给施用器，再把坏书提取回精华。这个循环就是本模组附魔的整个后期玩法。"
			]
			id: "307D946C9740ACAA"
			rewards: [
				{
					id: "56946F843A22F03F"
					type: "xp"
					xp: 30
				}
				{
					exclude_from_claim_all: true
					id: "3EE599ED07E487A6"
					table_id: 3488080005486828330L
					type: "random"
				}
			]
			shape: "diamond"
			size: 1.0d
			subtitle: "<typewriter><grad from=#8FE33F to=#8FE33F>50级卷轴，随取随用</grad></typewriter>"
			tasks: [{
				id: "4A5F4D46965973E7"
				item: "industrialforegoing:enchantment_factory"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#8FE33F to=#D8FFA8 f=0.6>附魔工厂</grad></shadow>"
			x: 2.0d
			y: 49.5d
		}
		{
			dependencies: ["42698B4B92D2698E"]
			description: [
				"# <grad from=#FF5A3C to=#FFB9A8 f=0.6><shadow a=0.3>Two Halves</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>激光系统总是由一个</grad><grad from=#FF5A3C to=#FFB9A8 f=0.8>底座</grad><grad from=#FFFFFF to=#C7C7C7>和一个或多个</grad><grad from=#FF5A3C to=#FFB9A8 f=0.8>钻头</grad><grad from=#FFFFFF to=#C7C7C7>组成。底座是制造物品的方块，钻头是向其射击的方块。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>放置一个底座，然后在周围放置钻头，朝向底座。每个钻头每刻都会推动底座的进度条，所以 </grad><grad from=#FF5A3C to=#FFB9A8 f=0.8>更多的钻头意味着更快的产出</grad><grad from=#FFFFFF to=#C7C7C7>。这是唯一的加速方法。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>矿物激光基地</grad><grad from=#FF5A3C to=#FFB9A8 f=0.8>可以制造矿物和原材料。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>流体激光基座</grad><grad from=#FF5A3C to=#FFB9A8 f=0.8>可以制造流体。</grad></shadow>"
				""
				"[!info] 钻头可能距离基地几格远，并能从六个方向中的任意一个方向击中基地。"
			]
			icon: "industrialforegoing:laser_drill"
			icon_scale: 1.2d
			id: "4232D49AF4A069B3"
			min_width: 340
			rewards: [{
				id: "68C13A3FA1CBF277"
