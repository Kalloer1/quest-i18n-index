	order_index: 6
	quest_links: [ ]
	quests: [
		{
			description: [
				"# <grad from=#E8A33D to=#FFDCA8 f=0.6><shadow a=0.3>一箱一任务</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>大多数科技模组都会给你一个现成的系统。而这个模组则给了你 </grad><grad from=#E8A33D to=#FFDCA8 f=0.8>六十多个箱子，</grad><grad from=#FFFFFF to=#C7C7C7>让你自己琢磨它们怎么拼接起来。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>没有多方块结构，没有研究树，也没有线路谜题。每台机器只有一个方块，可以从任意一侧输入能量，并且只做上面写明的事情。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>整个模组都靠</grad><grad from=#E8A33D to=#FFDCA8 f=0.8>树上的橡胶</grad><grad from=#FFFFFF to=#C7C7C7>运行，所以最初一小时，你、一片森林和一台很有耐心的泵就够了。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#E8A33D to=#FFDCA8 f=0.6><shadow a=0.3>你将面临的一切</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#E8A33D to=#FFDCA8 f=0.8>四台机器框架，分别对应初级、中级、高级和终极阶段。真可惜。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>无人看管，自动播种、施肥、收割和重播的农场。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>能将动物转化为</grad><grad from=#E8A33D to=#FFDCA8 f=0.8>流体，又能将流体还原为动物的机器。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>一种能将一种原矿转化为 </grad><grad from=#E8A33D to=#FFDCA8 f=0.8>五种粉尘的矿石链</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>可存储单个方块中 </grad><grad from=#E8A33D to=#FFDCA8 f=0.8>二十亿个</grad><grad from=#FFFFFF to=#C7C7C7>同一种物品的容器。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>十六个愚蠢的发电机和一个需要全部十六个都运行的反应堆。</grad></shadow>"
				""
				"[!tip] 几乎所有机器都有一个工作区域。放置前将其握在手中，该区域会在世界中高亮显示。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
			]
			icon: "industrialforegoing:machine_frame_supreme"
			icon_scale: 1.2d
			id: "63525063B5258B4D"
			min_width: 350
			rewards: [{
				id: "617F17AB632D9FAD"
				type: "xp"
				xp: 10
			}]
			shape: "hexagon"
			size: 1.5d
			subtitle: "<typewriter><grad from=#E8A33D to=#E8A33D>万物皆为一事而设的盒子</grad>"
			tasks: [{
				id: "1A122D6E7E29BC97"
				title: "好了，把箱子都给我看看"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#E8A33D to=#FFDCA8 f=0.6>Industrial Foregoing</grad></shadow>"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["63525063B5258B4D"]
			description: [
				"# <grad from=#C8AE86 to=#EBD9B8 f=0.6><shadow a=0.3>永远不变的五个真理</shadow></grad>"
				""
				"1. <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>能量可从任意一面输入。</grad><grad from=#FFFFFF to=#C7C7C7> 无需专用线缆，也无特定朝向。使用你喜欢的任何能源模组即可。</grad></shadow>"
				"[gap=3]"
				"2. <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>每个面都可配置。</grad><grad from=#FFFFFF to=#C7C7C7>打开机器，点击侧面按钮，将每个面设置为推动、拉动或不操作。</grad></shadow>"
				"[gap=3]"
				"3. <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>有区域的机器会显示出来。</grad><grad from=#FFFFFF to=#C7C7C7> 手持一个，它可工作的位置会出现一个彩色方框。</grad></shadow>"
				"[gap=3]"
				"4. <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>附加组件槽位可升级。</grad><grad from=#FFFFFF to=#C7C7C7>速度、效率、处理能力和范围均可升级，且可叠加。</grad></shadow>"
				"[间隔=3]"
				"5. <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>内置红石控制。</grad><grad from=#FFFFFF to=#C7C7C7>每个机器屏幕角落都有一个小按钮。</grad></shadow>"
				""
				"[!info] 机器在空闲时几乎不消耗成本。它们只在真正执行操作的tick上消耗大量资源。"
			]
			icon: "industrialforegoing:range_addon5"
			id: "261E81308E559C77"
			min_width: 340
			optional: true
			rewards: [{
				id: "4E5D71E71CCDC84E"
				type: "xp"
				xp: 5
			}]
			shape: "circle"
			size: 1.0d
			subtitle: "<typewriter><grad from=#C8AE86 to=#C8AE86>读一遍，就再也不要想了</grad>"
			tasks: [{
				id: "7B122C448F2A2479"
				title: "明白了"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>每台机器的工作原理</grad></shadow>"
			x: 1.5d
			y: 0.5d
		}
		{
			dependencies: ["63525063B5258B4D"]
			description: [
				"# <grad from=#E8A33D to=#FFDCA8 f=0.6><shadow a=0.3>Tier Zero</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>角是</grad><grad from=#E8A33D to=#FFDCA8 f=0.8>原木</grad><grad from=#FFFFFF to=#C7C7C7>，边是</grad><grad from=#E8A33D to=#FFDCA8 f=0.8>铁锭</grad><grad from=#FFFFFF to=#C7C7C7>，中间是</grad><grad from=#E8A33D to=#FFDCA8 f=0.8>红石块</grad><grad from=#FFFFFF to=#C7C7C7>。任何原木都行。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>大约三分之二的机器配方都需要一个这个放在中间，所以先堆一堆再说吧。</grad></shadow>"
				""
				"[!info] 有四种框架：怜悯、简易、高级和至尊。怜悯是唯一可以在合成台制作的框架。"
			]
			id: "05DAF3E7599CAC29"
			rewards: [{
				id: "3EB81E1477BA7BEA"
				type: "xp"
				xp: 10
			}]
			shape: "pentagon"
			size: 1.2d
			subtitle: "<typewriter><grad from=#E8A33D to=#E8A33D>四根原木，四块铁，一个红石块</grad>"
			tasks: [{
				id: "2EB5278402D8E21A"
				item: "industrialforegoing:machine_frame_pity"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E8A33D to=#FFDCA8 f=0.6>怜悯机器框架</grad></shadow>"
			x: 0.0d
			y: 2.0d
		}
		{
			dependencies: ["63525063B5258B4D"]
			description: [
				"# <grad from=#E8A33D to=#FFDCA8 f=0.6><shadow a=0.3>齿轮</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>金子和钻石齿轮是合成桌上一个戒指的四种材料之一。没什么特别的。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#E8A33D to=#FFDCA8 f=0.8>本整合包中的铁齿轮有所不同。</grad><grad from=#FFFFFF to=#C7C7C7> 唯一保留的配方属于 Thermal，因此需要用 </grad><grad from=#E8A33D to=#FFDCA8 f=0.8>Multiservo Press</grad><grad from=#FFFFFF to=#C7C7C7> 和 </grad><grad from=#E8A33D to=#FFDCA8 f=0.8>Gear Die</grad><grad from=#FFFFFF to=#C7C7C7> 来制作，每个需要四个铁锭。</grad></shadow>"
				""
				"[!warn] 大约十几个早期机器需要铁齿轮。如果你还没碰过 Thermal，那么那个压机就是你的第一个项目。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>金和钻石齿轮仍然是普通的戒指配方，所以只有铁被移除了。</grad></shadow>"
			]
			icon: "industrialforegoing:diamond_gear"
			id: "62C81705C6F1AEBC"
			min_width: 340
			rewards: [{
				id: "04CA5819169F09D5"
				type: "xp"
				xp: 10
			}]
			shape: "circle"
			size: 1.0d
			subtitle: "<typewriter><grad from=#E8A33D to=#E8A33D>铁制的物品来自这里的其他地方</grad>"
			tasks: [
				{
					id: "6F676B5FBBA21BA0"
					item: "industrialforegoing:iron_gear"
					type: "item"
				}
				{
					id: "6423924250190FE5"
