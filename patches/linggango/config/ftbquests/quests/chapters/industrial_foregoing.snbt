				}
				{
					id: "74AE46B9D81411ED"
					item: "industrialforegoing:diamond_gear"
					type: "item"
				}
			]
			title: "<shadow a=0.4><grad from=#E8A33D to=#FFDCA8 f=0.6>齿轮，三种口味</grad></shadow>"
			x: -1.5d
			y: 0.5d
		}
		{
			dependencies: ["05DAF3E7599CAC29"]
			description: [
				"# <grad from=#D8C9A8 to=#F3EBD8 f=0.6><shadow a=0.3>乳胶源自原木</shadow></grad>"
				""
				"将其中一个指向一个 </grad><grad from=#D8C9A8 to=#F3EBD8 f=0.8>原木</grad><grad from=#FFFFFF to=#C7C7C7>，它就会滴出乳胶。这就是整个模组的瓶颈所在，所以多建几个吧。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>给它能量，每次就能产出三倍于消耗的能量，即500点。没电也能用，只是又慢又抠。 </grad><grad from=#D8C9A8 to=#F3EBD8 f=0.8>three times</grad><grad from=#FFFFFF to=#C7C7C7> as much per pull, at 500 energy a go. Without power it still works, just slowly and stingily."
				""
				"[!warn] 每次抽取都有1%的几率直接损坏原木。请用树木农场来供应，而不是从你的房子里拿。"
			]
			id: "4DE1F78BAE60E59D"
			rewards: [{
				id: "7639764ED9F1B1C8"
				type: "xp"
				xp: 10
			}]
			shape: "square"
			size: 1.2d
			subtitle: "<typewriter><grad from=#D8C9A8 to=#D8C9A8>轻点一下，树木生长</grad>"
			tasks: [{
				id: "20DB6CC9DF0EB666"
				item: "industrialforegoing:fluid_extractor"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#D8C9A8 to=#F3EBD8 f=0.6>流体提取器</grad></shadow>"
			x: 0.0d
			y: 4.0d
		}
		{
			dependencies: ["4DE1F78BAE60E59D"]
			description: [
				"# <grad from=#C8AE86 to=#EBD9B8 f=0.6><shadow a=0.3>每次抽取的乳胶</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>下方的数字为无能量时的单次抽取量。提取器有能量后，乘以三即可。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>金合欢木</grad><grad from=#FFFFFF to=#C7C7C7> 提供 4 点。游戏中最好的，没有之一。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>深色橡木</grad><grad from=#FFFFFF to=#C7C7C7> 给予 3 个。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>橡木、桦木、云杉和丛林</grad><grad from=#FFFFFF to=#C7C7C7> 给予 2 个。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#C8AE86 to=#EBD9B8 f=0.8>Anything else</grad><grad from=#FFFFFF to=#C7C7C7> 会给予 1 个物品，并且原木会被吃掉而不是被剥皮。</grad></shadow>"
				""
				"[!tip] 命名木材会被剥皮后保留，所以同一根原木会持续产出。其他原木在拉取一次后会消失。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>需要750份乳胶才能制作一个干橡胶。也就是63次动力金合欢木的拉力，或者250次动力拉力（使用任意模组木材）。</grad></shadow>"
			]
			icon: "minecraft:acacia_log"
			id: "405C94202D639C55"
			min_width: 340
			optional: true
			rewards: [{
				id: "46365462CBD21761"
				type: "xp"
				xp: 5
			}]
			shape: "circle"
			size: 1.0d
			subtitle: "<typewriter><grad from=#C8AE86 to=#C8AE86>种上金合欢，回头谢我</grad>"
			tasks: [{
				id: "52D2A6663E769465"
				title: "已收到"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#C8AE86 to=#EBD9B8 f=0.6>并非所有树木都平等</grad></shadow>"
			x: 1.5d
			y: 4.0d
		}
		{
			dependencies: ["4DE1F78BAE60E59D"]
			description: [
				"# <grad from=#D8C9A8 to=#F3EBD8 f=0.6><shadow a=0.3>治愈树苗</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>单独的乳胶毫无用处。将 </grad><grad from=#D8C9A8 to=#F3EBD8 f=0.8>750 乳胶</grad><grad from=#FFFFFF to=#C7C7C7> 和 </grad><grad from=#D8C9A8 to=#F3EBD8 f=0.8>500 水</grad><grad from=#FFFFFF to=#C7C7C7> 倒入其中，五秒后你就能得到一块干橡胶。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>本整合包将其能耗降至每刻20能量（模组默认400），使其能低成本永久运行。两个储罐的容量也翻倍至各16,000。</grad></shadow>"
				""
				"[!tip] 用冷凝器或无限水源给它供水。它喝的水比你想的多得多。"
			]
			id: "1BE814A96141A97F"
			rewards: [{
				id: "7E2D0806F04487E4"
				type: "xp"
				xp: 10
			}]
			shape: "square"
			size: 1.2d
			subtitle: "<typewriter><grad from=#D8C9A8 to=#D8C9A8>750 个乳胶和 500 个水，五秒内完成</grad>"
			tasks: [{
				id: "70BF74E7271E2336"
				item: "industrialforegoing:latex_processing_unit"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#D8C9A8 to=#F3EBD8 f=0.6>乳胶处理单元</grad></shadow>"
			x: 0.0d
			y: 6.0d
		}
		{
			dependencies: ["1BE814A96141A97F"]
			description: [
				"# <grad from=#D8C9A8 to=#F3EBD8 f=0.6><shadow a=0.3>干橡胶</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>每个周期，乳胶处理单元会产出八个。在继续之前先收集八个，因为后面的东西会消耗塑料，而这些又会消耗塑料。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>模组文件里有个叫 Tiny Dry Rubber 的物品，九个可以合成一个这个。它被标记为已弃用，现在也无法合成，所以请忽略它。</grad></shadow>"
			]
			id: "19EBF00EEB9FE763"
			rewards: [{
				id: "23690BB6BEBB674D"
				type: "xp"
				xp: 10
			}]
			shape: "circle"
			size: 1.0d
			subtitle: "<typewriter><grad from=#D8C9A8 to=#D8C9A8>无人记得的中间步骤</grad></typewriter>"
			tasks: [{
				count: 8L
				id: "74EFBD14E0156DD3"
				item: { Count: 8, id: "industrialforegoing:dryrubber" }
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#D8C9A8 to=#F3EBD8 f=0.6>干橡胶</grad></shadow>"
			x: 1.5d
			y: 6.0d
		}
		{
			dependencies: ["1BE814A96141A97F"]
			description: [
				"# <grad from=#AFC3D8 to=#E6EFF8 f=0.6><shadow a=0.3>直接冶炼吧</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>干橡胶放入熔炉，十秒后，塑料就出炉了。这是最后一步简单的操作了。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>看看任意一个Industrial Foregoing的配方，数数塑料。大多数机器需要</grad><grad from=#AFC3D8 to=#E6EFF8 f=0.8>四到六个</grad><grad from=#FFFFFF to=#C7C7C7>。框架每个需要两个。好工具则需要更多。</grad></shadow>"
				""
				"[!tip] 在建造其他任何东西之前，先搭建好树木、提取器、处理器和熔炉，组成一条固定生产线。你永远都离不开它。"
				""
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>十六个塑料大约等于12000个乳胶。是的，真的。</grad></shadow>"
			]
			id: "24BBE0A76CE85398"
