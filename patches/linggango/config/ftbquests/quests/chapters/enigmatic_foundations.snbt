	order_index: 3
	parent: "31575DEBB2A21CCD"
	quest_links: [ ]
	quests: [
		{
			description: [
				"# <grad from=#C77DFF to=#F0DAFF f=0.6><shadow a=0.3>三堆杂物</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>本章是基础建设。内容并不花哨，跳过它会导致后续章节有一半内容看起来毫无意义。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>左边是戒指家族。它们都从普通的铁环中生长出来。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>中间是原材料。星尘和以太在大多数优质配方中都会出现。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>右侧是能让你永久获得额外一个栏位的三种物品。</grad></shadow>"
				""
				"[!tip] 戒指是唯一能免费获得两个的装备栏。要谨慎选择放入其中的物品，因为战斗中无法更换。"
			]
			icon: "enigmaticlegacy:iron_ring"
			id: "4AFE2E225F91B612"
			min_width: 340
			shape: "hexagon"
			size: 1.5d
			subtitle: "<typewriter><grad from=#B06BE8 to=#B06BE8>故意无聊。其他一切皆建立于此之上。</grad>"
			tasks: [{
				id: "50B2D79BB68FA88E"
				title: "从这里开始"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#C77DFF to=#F0DAFF f=0.6>基础建设</grad></shadow>"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["4AFE2E225F91B612"]
			description: [
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>模组里最便宜的东西</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>铁锭和铁粒。仅此而已。它能提供 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>+1 护甲值</grad><grad from=#FFFFFF to=#C7C7C7>，更重要的是，它是几乎所有后续戒指的中间材料。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它们也出现在主世界地牢的箱子里，所以你可能已经有一个在乱晃了。</grad></shadow>"
				""
				"<shadow a=0.3><shadow a=0.3><grad from=#A0A0A0 to=#606060>如果后悔了，在熔炉里冶炼铁环可以返还铁锭。</grad></shadow></shadow>"
			]
			id: "609C4C39B3D25D8C"
			min_width: 320
			shape: "pentagon"
			size: 1.25d
			subtitle: "<typewriter><grad from=#B06BE8 to=#B06BE8>所有其他戒指的种子。</grad>"
			tasks: [{
				id: "5F22421CF73253E9"
				item: "enigmaticlegacy:iron_ring"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#C77DFF to=#F0DAFF f=0.6>铁环</grad></shadow>"
			x: -4.5d
			y: 1.0d
		}
		{
			dependencies: ["609C4C39B3D25D8C"]
			description: [
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>镀金</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>用黄金包裹的铁环。佩戴后，猪灵会将你视为中立，即使不戴头盔也是如此。</grad></shadow>"
				""
				"[!warn] 七诅咒戒指会直接取消这个效果。它的第二个诅咒会让你拥有的任何饰品都无法阻止中立生物变得敌对，工具提示里甚至直接划掉了相关描述。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它也是本分支更下方两个更优质戒指的基础。</grad></shadow>"
			]
			id: "31D8D91AF9F289D0"
			min_width: 320
			size: 1.0d
			subtitle: "<typewriter><grad from=#B06BE8 to=#B06BE8>猪灵们觉得你其实还不错，实际上。</grad>"
			tasks: [{
				id: "37D6A4F01E503160"
				item: "enigmaticlegacy:golden_ring"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#C77DFF to=#F0DAFF f=0.6>精致戒指</grad></shadow>"
			x: -6.0d
			y: 3.0d
		}
		{
			dependencies: ["609C4C39B3D25D8C"]
			description: [
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>物品吸尘器</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将掉落物从距离你 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>8</grad><grad from=#FFFFFF to=#C7C7C7> 格远的地方拉向你。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>按住 Shift 可以关闭，这比听起来更重要。开着这个功能整理箱子房间真的很难受。</grad></shadow>"
			]
			id: "1483A802D8EFAEF7"
			min_width: 320
			size: 1.0d
			subtitle: "<typewriter><grad from=#B06BE8 to=#B06BE8>别再踩着自己的掉落物了。</grad></typewriter>"
			tasks: [{
				id: "55468ED0903C3792"
				item: "enigmaticlegacy:magnet_ring"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#C77DFF to=#F0DAFF f=0.6>磁环</grad></shadow>"
			x: -4.5d
			y: 3.0d
		}
		{
			dependencies: ["1483A802D8EFAEF7"]
			description: [
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>磁环的升级</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>与其拖动物品，这个会在物品生成瞬间，将其直接放入你背包中，只要它在 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>16</grad><grad from=#FFFFFF to=#C7C7C7> 格内即可。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>由磁环、末影之眼、金子和青金石制成。</grad></shadow>"
				""
				"[!tip] Shift 键仍然会禁用它。保持习惯，因为这个范围覆盖了大部分挖掘分支。"
			]
			id: "781B6272347D309E"
			min_width: 320
			subtitle: "<typewriter><grad from=#B06BE8 to=#B06BE8>不是真空。是传送器。</grad>"
			tasks: [{
				id: "5388679080F4FC76"
				item: "enigmaticlegacy:super_magnet_ring"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#C77DFF to=#F0DAFF f=0.6>Dislocation Ring</grad></shadow>"
			x: -4.5d
			y: 4.5d
		}
		{
			dependencies: ["609C4C39B3D25D8C"]
			description: [
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>便携式存储</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>随时随地通过配饰界面或按键绑定打开末影箱。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>铁环、一个末地箱、一颗末地珍珠和一些黄金。</grad></shadow>"
				""
				"[!info] 如果你佩戴了七咒戒指，它能免费做到这一点，这样你就可以更好地利用戒指的装备栏了。"
			]
			id: "5AA763A72417F48A"
			min_width: 320
			size: 1.0d
			subtitle: "<typewriter><grad from=#B06BE8 to=#B06BE8>末影箱，装进口袋。</grad></typewriter>"
			tasks: [{
				id: "6FBE617E0CDEDB15"
				item: "enigmaticlegacy:ender_ring"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#C77DFF to=#F0DAFF f=0.6>末影戒指</grad></shadow>"
			x: -3.0d
			y: 3.0d
		}
		{
			dependencies: ["31D8D91AF9F289D0"]
			description: [
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>护甲与魔法抗性</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>精致戒指，需要恶魂之泪、青金石和石英。它能提供 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>+2 护甲值</grad><grad from=#FFFFFF to=#C7C7C7> 和 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>30 百分比的</grad><grad from=#FFFFFF to=#C7C7C7> 魔法抗性。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>魔法抗性很稀有，而本整合包会向你施放大量法术，所以它的实用性远超价格所示。</grad></shadow>"
				""
				"<shadow a=0.3><shadow a=0.3><grad from=#A0A0A0 to=#606060>它还为魅力章节中的锻造者宝石提供燃料。</grad></shadow></shadow>"
			]
			id: "2D5FF6F8E26B6743"
			min_width: 320
			subtitle: "<typewriter><grad from=#B06BE8 to=#B06BE8>安静，便宜，而且真好用。</grad>"
			tasks: [{
				id: "381058C0DB4F2053"
				item: "enigmaticaddons:quartz_ring"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#C77DFF to=#F0DAFF f=0.6>魔法石英戒指</grad></shadow>"
			x: -6.0d
			y: 4.5d
		}
		{
			dependencies: ["31D8D91AF9F289D0"]
			description: [
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>贸易之环</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>此整合包重写了配方。需要Tau Oil、一个Totem of Undying、Fortune书籍、一个Exquisite Ring、Nefarious Essence和一个Greed charm。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>村民从不涨价，也从不缺货。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>商人们将不再攻击你，猪灵除外。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你携带的宝石越多，造成的伤害就越高。</grad></shadow>"
				""
				"[!danger] 掠夺者会优先攻击你，死亡会删除你携带的所有与绿宝石相关的物品。在掠夺发生前存入绿宝石。"
			]
			id: "1E44EF435BBA4EE0"
			min_width: 340
			subtitle: "<typewriter><grad from=#FFD97A to=#FFD97A>村民们喜欢你。掠夺者注意到了你。</grad>"
			tasks: [{
				id: "6E2D55613391DCA0"
				item: "enigmaticaddons:avarice_ring"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#FFD97A to=#FFF3CF f=0.6>终极奢华戒指</grad></shadow>"
			x: -7.5d
			y: 3.0d
		}
		{
			dependencies: ["5AA763A72417F48A"]
			description: [
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>随身携带的恐慌按钮</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>单次受到的伤害若超过你生命值的 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>80%</grad><grad from=#FFFFFF to=#C7C7C7> 或以上，则完全被格挡。之后会进入 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>50秒</grad><grad from=#FFFFFF to=#C7C7C7> 的冷却时间。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+5</grad><grad from=#FFFFFF to=#C7C7C7> 盔甲</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+2</grad><grad from=#FFFFFF to=#C7C7C7> 护甲韧性</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+20 percent</grad><grad from=#FFFFFF to=#C7C7C7> 挖掘速度</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>25 百分比</grad><grad from=#FFFFFF to=#C7C7C7> 全面的伤害减免</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>还能减轻</grad><grad from=#FF8A8A to=#E03131 f=0.8>第一诅咒</grad><grad from=#FFFFFF to=#C7C7C7>的</grad><grad from=#FFC46B to=#FF9E1F f=0.8>25%</grad><grad from=#FFFFFF to=#C7C7C7>，这对被诅咒的玩家来说，早期戴在戒指栏里最棒的选择了。</grad></shadow>"
				""
				"<shadow a=0.3><shadow a=0.3><grad from=#A0A0A0 to=#606060>配方需要净化之心、宇宙之心、扭曲之心和两种金苹果，所以这并非前期戒指。</grad></shadow></shadow>"
			]
			id: "6BEEE075C859F8A9"
			min_width: 340
			subtitle: "<typewriter><grad from=#B6EE86 to=#B6EE86>挨了一记重击，然后闷闷不乐50秒。</grad>"
			tasks: [{
				id: "0B4613ABBC761A0B"
				item: "enigmaticaddons:earth_promise"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#B6EE86 to=#EAFFD6 f=0.6>大地的承诺</grad></shadow>"
			x: -3.0d
			y: 4.5d
		}
		{
			dependencies: ["4AFE2E225F91B612"]
			description: [
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>原始催化剂</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>星尘只会出现在</grad><grad from=#8FD6FF to=#4FA8E8 f=0.8>末地城市的宝箱里，</grad><grad from=#FFFFFF to=#C7C7C7>就是那些由潜行者在塔顶守护的宝箱。里面通常含有</grad><grad from=#FFC46B to=#FF9E1F f=0.8>1到4个，</grad><grad from=#FFFFFF to=#C7C7C7>非常常见。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>九个压缩成一个星尘袋，又可以分解，所以存储不是问题。</grad></shadow>"
				""
				"[!tip] 佩戴七诅咒戒指后，你击杀的每个潜行者的星尘掉落量都会增加20%。这是游戏中唯一可刷取的来源。"
			]
			id: "7D7AA8A5C409FDB4"
			min_width: 330
			shape: "pentagon"
			size: 1.25d
			subtitle: "<typewriter><grad from=#B06BE8 to=#B06BE8>末地城市的宝藏，别无他处。</grad>"
			tasks: [{
				id: "73EF9B85778AE4B1"
				item: "enigmaticlegacy:astral_dust"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#B9E4FF to=#FFFFFF f=0.6>星尘</grad></shadow>"
			x: 0.0d
			y: 1.875d
		}
		{
			dependencies: ["7D7AA8A5C409FDB4"]
			description: [
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>没有以太矿脉</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你绝对不可能挖到它。它只存在于一个地方，</grad><grad from=#8FD6FF to=#4FA8E8 f=0.8>末地城市的宝箱中，</grad><grad from=#FFFFFF to=#C7C7C7>每个宝箱有</grad><grad from=#FFC46B to=#FF9E1F f=0.8>1到2个，</grad><grad from=#FFFFFF to=#C7C7C7>仅此而已。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>将其熔炼或锻造为以太锭。这就是整个循环，也因此全套以太装备需要大量的末地城探索才能获得。</grad></shadow>"
			]
			id: "40F62B6A9002A2EF"
			min_width: 320
			subtitle: "<typewriter><grad from=#B06BE8 to=#B06BE8>不会生成。在任何地方都不会生成。</grad>"
			tasks: [{
				id: "5EB70ED13BC53F38"
				item: "enigmaticlegacy:etherium_ore"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#B9E4FF to=#FFFFFF f=0.6>以太矿石</grad></shadow>"
			x: -1.5d
			y: 3.0d
		}
		{
			dependencies: ["40F62B6A9002A2EF"]
			description: [
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>建造内容</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>以太是隐形盔甲套装、区域采矿工具和维度锚定背后的材料。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>九个金粒合成一个金锭，九个金锭合成一个金块，两者都可以分解，所以永远不会浪费任何东西。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>整个齿轮树都存在于自己的章节中，</grad></shadow>"
				"{ \"text\": \"Etherium and Arms\", \"underlined\": \"true\", \"color\": \"#D9A5FF\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6D10D65B617CD7E8\" } }"
			]
			id: "4DEAFFF39B392F5F"
			min_width: 330
			shape: "pentagon"
			subtitle: "<typewriter><grad from=#B06BE8 to=#B06BE8>模组里最好的金属。</grad></typewriter>"
			tasks: [{
				id: "2BF77091033484D9"
				item: "enigmaticlegacy:etherium_ingot"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#B9E4FF to=#FFFFFF f=0.6>以太锭</grad></shadow>"
			x: 0.0d
			y: 3.0d
		}
		{
			dependencies: ["7D7AA8A5C409FDB4"]
			description: [
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>手柄</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>烈焰棒、末影珍珠和星尘。它既不是武器也不是工具，而是所有以太工具的基础材料。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它还会出现在星界长矛、龙息弓、诅咒雕刻刀和以太核心中，所以多做一些吧。</grad></shadow>"
			]
			id: "4F23142E43645680"
			min_width: 320
			subtitle: "<typewriter><grad from=#B06BE8 to=#B06BE8>每件以太工具都需要两个。</grad></typewriter>"
			tasks: [{
				id: "7288C89B954DF357"
				item: "enigmaticlegacy:ender_rod"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#B9E4FF to=#FFFFFF f=0.6>末影之棒</grad></shadow>"
			x: 1.5d
			y: 3.0d
		}
		{
			dependencies: ["4DEAFFF39B392F5F"]
			description: [
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>在你喜欢的位置重生</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>重生锚、末地石、末影之眼、一块以太锭和一颗星云之眼。它在任何维度都能使用，而不仅仅是下界。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它用末影珍珠代替萤石运行，并且有 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>35 的百分比</grad><grad from=#FFFFFF to=#C7C7C7> 概率在重生时不消耗一次充能。</grad></shadow>"
				""
				"[!tip] 在漫长的以太之旅前，先在这个末地设置好，能省去很多走路的时间。"
			]
			id: "6B8B602A57DBEFE0"
			min_width: 330
			subtitle: "<typewriter><grad from=#B06BE8 to=#B06BE8>一个随处可用的重生锚。</grad>"
			tasks: [{
				id: "59569304002F22C5"
				item: "enigmaticlegacy:end_anchor"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#B9E4FF to=#FFFFFF f=0.6>次元锚点</grad></shadow>"
			x: 0.0d
			y: 4.5d
		}
		{
			dependencies: ["4AFE2E225F91B612"]
			description: [
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>吃掉它，保留物品栏位置</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>永久消耗此物品可解锁第三个戒指槽位。它不会占用配饰槽位，而是直接改变你自身。</grad></shadow>"
				""
				"[!warn] 原版游戏只会发放一次，即在你打开的第一个末地城市宝箱中，前提是你当时佩戴着七诅咒之环。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>此整合包添加了生物锻造台的配方，可将星尘、宇宙之心和禁果合成一片</grad><grad from=#D9A5FF to=#B06BE8 f=0.8>天界水果切片</grad><grad from=#FFFFFF to=#C7C7C7>，这样正义之士也不会被完全排除在外。</grad></shadow>"
			]
			id: "627BD1C191884874"
			min_width: 340
			shape: "diamond"
			subtitle: "<typewriter><grad from=#B06BE8 to=#B06BE8>永久增加一个戒指栏位。</grad>"
			tasks: [{
				id: "22A3E55184C3283C"
				item: "enigmaticlegacy:astral_fruit"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#FFC4E8 to=#FFFFFF f=0.6>天界果实</grad></shadow>"
			x: 3.0d
			y: 2.0d
		}
		{
			dependencies: ["4AFE2E225F91B612"]
			description: [
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>饮神者</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>和水果一样，不过是护身符。喝下后，该槽位将永久归你所有。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它会从村庄神殿、沙漠金字塔和丛林神殿的箱子里掉落。没有合成配方。</grad></shadow>"
				""
				"[!warn] 游戏会记录你是否曾掠夺过。一旦掠夺过，它就不会再出现在你的宝箱中，所以每个玩家只能有一个。"
			]
			id: "35BDB4F583629CCF"
			min_width: 340
			shape: "diamond"
			subtitle: "<typewriter><grad from=#B06BE8 to=#B06BE8>永久增加一个附魔槽位。</grad>"
			tasks: [{
				id: "67C864774F5581B8"
				item: "enigmaticlegacy:ichor_bottle"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#FFC4E8 to=#FFFFFF f=0.6>一瓶的腐化之血</grad></shadow>"
			x: 4.5d
			y: 1.5d
		}
		{
			dependencies: ["4AFE2E225F91B612"]
			description: [
				"## <grad from=#B06BE8 to=#E3C4FF f=0.6><shadow a=0.3>容纳第二卷轴的空间</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>使用它，你就能多一个神秘卷轴的槽位。考虑到卷轴在本模组中的强大，这可是个了不得的事。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>此整合包将配方替换为八个 </grad><grad from=#D9A5FF to=#B06BE8 f=0.8>空白虚空</grad><grad from=#FFFFFF to=#C7C7C7>，环绕着《致谢》的副本。</grad></shadow>"
				""
				"<shadow a=0.3><shadow a=0.3><grad from=#A0A0A0 to=#606060>后面还有两个卷轴槽，藏在两条路径的最末端。</grad></shadow></shadow>"
			]
			id: "4661EAA8FBF0B944"
			min_width: 340
			shape: "diamond"
			subtitle: "<typewriter><grad from=#B06BE8 to=#B06BE8>额外一个神秘卷轴栏位。</grad>"
			tasks: [{
				id: "5CE095BDD9BC4897"
				item: "enigmaticaddons:void_tome"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#FFC4E8 to=#FFFFFF f=0.6>虚空之书</grad></shadow>"
			x: 6.0d
			y: 1.0d
		}
	]
	title: "<shadow a=0.4><grad from=#C77DFF to=#F0DAFF f=0.6>基础建设</grad></shadow>"
}
