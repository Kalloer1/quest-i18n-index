			x: 0.5d
			y: -7.0d
		}
		{
			dependencies: ["19237C5BA8DDB6AF"]
			description: [
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>以下是帮助你在整合包中导航的最重要默认按键绑定列表：</grad></shadow>"
				""
				"<grad from=#00960B to=#38BA43 f=0.8><shadow a=0.3>N</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> - FTB Ultimine（长按可一次性挖掘多个方块）。</grad></shadow>"
				"<grad from=#00960B to=#38BA43 f=0.8><shadow a=0.3>Z</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> - 缩放相机。</grad></shadow>"
				"<grad from=#00960B to=#38BA43 f=0.8><shadow a=0.3>R (悬停在物品上)</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> - 显示该物品的合成配方。</grad></shadow>"
				"<grad from=#00960B to=#38BA43 f=0.8><shadow a=0.3>U (悬停在物品上)</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> - 显示该物品被用于哪些配方中。</grad></shadow>"
				"<grad from=#00960B to=#38BA43 f=0.8><shadow a=0.3>R</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> - 翻滚 / 闪避。</grad></shadow>"
				"<grad from=#00960B to=#38BA43 f=0.8><shadow a=0.3>F</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> - 格挡来袭的攻击。</grad></shadow>"
				"<grad from=#00960B to=#38BA43 f=0.8><shadow a=0.3>M</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> - 打开世界地图。</grad></shadow>"
				"<grad from=#00960B to=#38BA43 f=0.8><shadow a=0.3>Shift + B</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> - 打开你装备的背包。</grad></shadow>"
				"<grad from=#00960B to=#38BA43 f=0.8><shadow a=0.3>C</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> - 施放你选择的法术。</grad></shadow>"
				"<grad from=#00960B to=#38BA43 f=0.8><shadow a=0.3>G</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> - 激活你的职业技能。</grad></shadow>"
				"<grad from=#00960B to=#38BA43 f=0.8><shadow a=0.3>T</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> - 切换单手或双手模式。 &e- 新增"
				"<grad from=#00960B to=#38BA43 f=0.8><shadow a=0.3>C</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> (在背包中) 锁定一个槽位。 &e- 新增"
				"<grad from=#00960B to=#38BA43 f=0.8><shadow a=0.3>V</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> (在背包中) 收藏一个物品。 &e- 新增"
			]
