		{
			dependencies: ["7A545E5DF48EDB9B"]
			description: [
				"### <grad from=#FCE938 to=#FFF6A6 f=0.8><shadow a=0.3>联盟系统</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>联盟让玩家组成团体，共同合作、分享资源，并避免意外的PVP。加入联盟后，你可以邀请他人、管理友军伤害，并向盟友直接请求物品或</grad></shadow><grad from=#00D411 to=#36CF43 f=0.8><shadow a=0.3>经验值</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"### <grad from=#FCE938 to=#FFF6A6 f=0.8><shadow a=0.3>结成联盟</shadow></grad>"
				""
				"<grad from=#006EDB to=#3F91E0 f=0.8><shadow a=0.3>/ally invite</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> - 发送邀请。收件人将在聊天中看到可点击的 </grad></shadow><grad from=#00D411 to=#36CF43 f=0.8><shadow a=0.3>[接受]</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 按钮。</grad></shadow>"
				"<grad from=#006EDB to=#3F91E0 f=0.8><shadow a=0.3>/ally accept</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> - 接受待处理的邀请并加入联盟。</grad></shadow>"
				"<grad from=#006EDB to=#3F91E0 f=0.8><shadow a=0.3>/ally disband</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> - 解散联盟，移除所有成员，并通知所有人。</grad></shadow>"
				""
				"### <grad from=#FCE938 to=#FFF6A6 f=0.8><shadow a=0.3>友军伤害</shadow></grad>"
				""
				"<grad from=#006EDB to=#3F91E0 f=0.8><shadow a=0.3>/ally rules friendlyfire <true/false></shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> - 切换友军是否可以互相造成伤害。</grad></shadow>"
				"<grad from=#00D411 to=#36CF43 f=0.8><shadow a=0.3>- true:</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 盟友可以互相造成伤害。</grad></shadow>"
				"<grad from=#CC0000 to=#D64242 f=0.8><shadow a=0.3>- false:</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 盟友之间完全无法互相造成伤害或使用伤害性药水效果。</grad></shadow>"
				""
				"### <grad from=#FCE938 to=#FFF6A6 f=0.8><shadow a=0.3>资源请求</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>盟友可以使用这些命令直接相互请求资源：</grad></shadow>"
				"<grad from=#006EDB to=#3F91E0 f=0.8><shadow a=0.3>/ally request item</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> - 请求盟友主手持有的物品。</grad></shadow>"
				"<grad from=#006EDB to=#3F91E0 f=0.8><shadow a=0.3>/ally request xp</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> - 请求特定数量的 </grad></shadow><grad from=#00D411 to=#36CF43 f=0.8><shadow a=0.3>经验值（XP）</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 等级。</grad></shadow>"
				"<grad from=#006EDB to=#3F91E0 f=0.8><shadow a=0.3>/ally request accept</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> - 接受待处理的物品或 </grad></shadow><grad from=#00D411 to=#36CF43 f=0.8><shadow a=0.3>经验值</shadow></grad><shadow a=0.3><grad from=#FFFFFF to=#C7C7C7> 请求。"
				""
				"### <grad from=#FCE938 to=#FFF6A6 f=0.8><shadow a=0.3>附加信息</shadow></grad>"
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>- 加入后所有成员共享统一联盟组。</grad></shadow>"
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>- 友军伤害规则适用于直接物理攻击和有害药水效果。</grad></shadow>"
				"<shadow a=0.3><grad from=#A0A0A0 to=#606060>- 请求在被接受前会一直保留。如果请求者下线，待处理的请求将自动移除。</grad></shadow>"
			]
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "ftblibrary:icons/shield"
				}
			}
