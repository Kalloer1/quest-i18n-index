	quests: [
		{
			description: [
				"<shadow><grad from=#FFA333 to=#FCDFB8 f=0.8>Linggango</grad><grad from=#FFFFFF to=#C7C7C7 f=0.3> 有许多容易被忽略的 </grad><grad from=#FFD700 to=#FFFF99 f=0.5>隐藏机制</grad><grad from=#FFFFFF to=#C7C7C7 f=0.3> 和 </grad><grad from=#FFD700 to=#FFFF99 f=0.5>机制</grad><grad from=#FFFFFF to=#C7C7C7 f=0.3>，在正常 </grad><grad from=#42FF42 to=#BAFFBA f=0.8>游戏过程</grad><grad from=#FFFFFF to=#C7C7C7 f=0.3>中你可能很容易错过它们。</grad></shadow>"
				""
				"<shadow><grad from=#FFFFFF to=#C7C7C7 f=0.3>本 </grad><grad from=#FFD700 to=#FFFF99 f=0.5>系列任务</grad><grad from=#FFFFFF to=#C7C7C7 f=0.3>旨在教你实用的 </grad><grad from=#FFA333 to=#FCDFB8 f=0.8>生活便利技巧</grad><grad from=#FFFFFF to=#C7C7C7 f=0.3> (</grad><grad from=#FFA333 to=#FCDFB8 f=0.8>QoL</grad><grad from=#FFFFFF to=#C7C7C7 f=0.3>)，让你的游戏体验更 </grad><wave a=0.3 f=0.5 w=0.5><grad from=#FFFFFF to=#C7C7C7 f=0.3>流畅</grad></wave><grad from=#FFFFFF to=#C7C7C7 f=0.3>。</grad></shadow>"
			]
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "ftblibrary:icons/info_gray"
				}
			}
