	order_index: 4
	parent: "31575DEBB2A21CCD"
	quest_links: [ ]
	quests: [
		{
			description: [
				"# <grad from=#7FA6E8 to=#D6E4FF f=0.6><shadow a=0.3>隐藏栏位</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你目前没有附魔卷轴栏位。在第一次持有卷轴之前，它会保持在</grad><grad from=#FFC46B to=#FF9E1F f=0.8>0</grad><grad from=#FFFFFF to=#C7C7C7>，之后该栏位就会出现并永久保留。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你一开始会获得一本。一本 </grad><grad from=#D9A5FF to=#B06BE8 f=0.8>Tome of Void</grad><grad from=#FFFFFF to=#C7C7C7>会添加第二本，而两条路径的末端会添加第三本。</grad></shadow>"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#7FA6E8 to=#D6E4FF f=0.6><shadow a=0.3>它们的重要性</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>卷轴里存着飞行、无限经验值和伤害乘数。大多数卷轴的价值都比你身上的盔甲高得多。</grad></shadow>"
				""
				"[!tip] 有些卷轴只对其中一条路径有效。它们在下方用红色标出，这样你在消耗材料前就知道了。"
			]
			icon: "enigmaticlegacy:thicc_scroll"
			id: "3EEEB769A9ED43C7"
			min_width: 350
			shape: "hexagon"
			size: 1.0d
			subtitle: "<typewriter><grad from=#7FA6E8 to=#7FA6E8>模组里最强的插槽，而且是从零开始的。</grad></typewriter>"
			tasks: [{
				id: "538544539428BF27"
				title: "阅读物品栏规则"
				type: "checkmark"
			}]
			title: "<shadow a=0.4><grad from=#7FA6E8 to=#D6E4FF f=0.6>秘法卷轴</grad></shadow>"
			x: 0.0d
			y: -1.0d
		}
		{
			dependencies: ["3EEEB769A9ED43C7"]
			description: [
				"## <grad from=#7FA6E8 to=#D6E4FF f=0.6><shadow a=0.3>卷轴的一半由此开始</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>棍子周围的纸。制作一叠，因为六种不同的卷轴都以它为基底。</grad></shadow>"
				""
				"<shadow a=0.3><shadow a=0.3><grad from=#A0A0A0 to=#606060>手持一个还能解锁你的秘法卷轴栏位，所以这是早期解锁栏位最便宜的方法。</grad></shadow></shadow>"
			]
			id: "6D90E585D2406F72"
			min_width: 320
			shape: "pentagon"
			size: 1.0d
			subtitle: "<typewriter><grad from=#7FA6E8 to=#7FA6E8>纸和一根木棍。真的吗？</grad></typewriter>"
			tasks: [{
				id: "6079CB0880B7608F"
				item: "enigmaticlegacy:thicc_scroll"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#7FA6E8 to=#D6E4FF f=0.6>空白卷轴</grad></shadow>"
			x: -2.5d
			y: -1.0d
		}
		{
			dependencies: ["3EEEB769A9ED43C7"]
			description: [
				"## <grad from=#7FA6E8 to=#D6E4FF f=0.6><shadow a=0.3>另一半</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>这个没有初始配方。它只会生成在 </grad><grad from=#8FD6FF to=#4FA8E8 f=0.8>堡垒的宝箱里，</grad><grad from=#FFFFFF to=#C7C7C7>就是那些锁在金块后面的宝箱，而且每个宝箱里都恰好有一个。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>拥有一个后，它会自我复制。一个 Darkest Scroll 加一个 Blank Scroll、黑色染料和一个 Wither Rose 就能得到两个回来。</grad></shadow>"
				""
				"[!tip] 开始前先复制几个。所有重型卷轴都需要一个，失去唯一副本会很伤。"
			]
			id: "453718D66065CA4A"
			min_width: 330
			shape: "pentagon"
			size: 1.5d
			subtitle: "<typewriter><grad from=#7FA6E8 to=#7FA6E8>先获取一个，再打印其余的。</grad></typewriter>"
			tasks: [{
				id: "1C00411329331083"
				item: "enigmaticlegacy:darkest_scroll"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#7FA6E8 to=#D6E4FF f=0.6>最暗卷轴</grad></shadow>"
			x: 0.0d
			y: 0.625d
		}
		{
			dependencies: ["3EEEB769A9ED43C7"]
			description: [
				"## <grad from=#F5C542 to=#FFF4CF f=0.6><shadow a=0.3>在所有地方中，偏偏在水下</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>大小不一的海洋遗迹，每箱有 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>40 个百分比</grad><grad from=#FFFFFF to=#C7C7C7> 的概率，每次出现 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>1 到 3 个</grad><grad from=#FFFFFF to=#C7C7C7> 遗迹。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它本身没有任何作用。它是《千德卷轴》、《姆涅斯蒂亚的衣袍》和光明系《天恩》的基础。</grad></shadow>"
				""
				"[!info] 与 Darkest Scroll 不同，它不会自我复制，所以海洋是唯一补给来源。"
			]
			id: "594DE634D568F698"
			min_width: 330
			subtitle: "<typewriter><grad from=#F5C542 to=#F5C542>经过治疗后，最黑暗的卷轴。</grad></typewriter>"
			tasks: [{
				id: "524C8D72217C8856"
				item: "covenant_of_the_seven:brightest_scroll"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#F5C542 to=#FFF4CF f=0.6>最亮的卷轴</grad></shadow>"
			x: 2.5d
			y: -1.0d
		}
		{
			dependencies: ["6D90E585D2406F72"]
			description: [
				"## <grad from=#7FA6E8 to=#D6E4FF f=0.6><shadow a=0.3>保存你拥有的所有等级</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它能储存无限的经验值，并在工具提示中显示总数。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>Shift 加右键可开启/关闭。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>右键在</grad><grad from=#8FD6FF to=#4FA8E8 f=0.8>吸收</grad><grad from=#FFFFFF to=#C7C7C7>和</grad><grad from=#8FD6FF to=#4FA8E8 f=0.8>提取</grad><grad from=#FFFFFF to=#C7C7C7>之间切换。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>激活时，它会吸起距离为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>16</grad><grad from=#FFFFFF to=#C7C7C7> 格内的球体。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>吸收会将你的能量条吸入卷轴。提取则将其倒回。装备它时死亡，卷轴内的物品会保留下来。</grad></shadow>"
			]
			id: "1CB5C629D6E2424A"
			min_width: 340
			subtitle: "<typewriter><grad from=#7FA6E8 to=#7FA6E8>一个没有上限的经验银行。</grad></typewriter>"
			tasks: [{
				id: "71FC854EA40D4E32"
				item: "enigmaticlegacy:xp_scroll"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#7FA6E8 to=#D6E4FF f=0.6>永恒智慧的卷轴</grad></shadow>"
			x: -4.0d
			y: -1.0d
		}
		{
			dependencies: ["6D90E585D2406F72"]
			description: [
				"## <grad from=#7FA6E8 to=#D6E4FF f=0.6><shadow a=0.3>死亡保险</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>死亡时，你的所有物品都会被传送到床或重生锚。如果没有床，则传送到主世界的中心。</grad></shadow>"
				""
				"[!warn] 卷轴本身会留在你死亡的位置。如果那里是岩浆，那你就得再买一个了。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>空白卷轴、一瓶回忆药水、一颗星云之眼和一张幻影膜。</grad></shadow>"
			]
			id: "18362E8AD6EE9A8C"
			min_width: 340
			subtitle: "<typewriter><grad from=#7FA6E8 to=#7FA6E8>你的物品会回家，卷轴却不会。</grad></typewriter>"
			tasks: [{
				id: "5E705F45FEECA425"
				item: "enigmaticlegacy:escape_scroll"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#7FA6E8 to=#D6E4FF f=0.6>Scroll of Postmortal Recall</grad></shadow>"
			x: -2.5d
			y: -2.5d
		}
		{
			dependencies: ["6D90E585D2406F72"]
			description: [
				"## <grad from=#7FA6E8 to=#D6E4FF f=0.6><shadow a=0.3>飞行，圈内飞行</shadow></grad>"
				""
				"在激活的 </grad><grad from=#8FD6FF to=#4FA8E8 f=0.8>信标</grad><grad from=#FFFFFF to=#C7C7C7> 范围内，你可以飞往任何地方，但飞行会缓慢消耗你的经验值。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>它还能取消飞行时通常会受到的挖掘速度惩罚，这正是人们建造信标平台的原因所在。</grad></shadow>"
				""
				"<shadow a=0.3><shadow a=0.3><grad from=#A0A0A0 to=#606060>Covenant of the Seven 添加了使用 Brightest Scroll 和 Sanctified Essence 的良性配方，这样正义之士也能获得一个了。</grad></shadow></shadow>"
			]
			id: "4EF80EAF25964BE6"
			min_width: 340
			shape: "diamond"
			subtitle: "<typewriter><grad from=#7FA6E8 to=#7FA6E8>使用牵引绳进行创造模式飞行。</grad>"
			tasks: [{
				id: "4AEB539432E655DF"
				item: "enigmaticlegacy:heaven_scroll"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#7FA6E8 to=#D6E4FF f=0.6>天降的礼物</grad></shadow>"
			x: -2.5d
			y: 0.5d
		}
		{
			dependencies: ["4EF80EAF25964BE6"]
			description: [
				"# <grad from=#7FA6E8 to=#D6E4FF f=0.6><shadow a=0.3>真正的自由飞行</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>飞到任何你喜欢的地方。它会快速消耗经验值，除非你恰好处于信标范围内，那样就完全免费了。</grad></shadow>"
				""
				"由天降之礼、星尘、以太锭、鞘翅和龙之息制成。"
				""
				"[间隔=5]"
				"---"
				"[间隔=5]"
				""
				"## <grad from=#F5C542 to=#FFF4CF f=0.6><shadow a=0.3>若与美德同行</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>额外的移动速度和游泳速度。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>宝箱掉落率 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>四倍化</grad><grad from=#FFFFFF to=#C7C7C7>，而非两倍。这是本整合包中最大的掉落乘数。</grad></shadow>"
			]
			id: "071B31311EAC896B"
			min_width: 350
			shape: "diamond"
			size: 1.25d
			subtitle: "<typewriter><grad from=#7FA6E8 to=#7FA6E8>牵引绳被解开了。</grad></typewriter>"
			tasks: [{
				id: "7748817D95D587F7"
				item: "enigmaticlegacy:fabulous_scroll"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#7FA6E8 to=#D6E4FF f=0.6>创造者的恩赐</grad></shadow>"
			x: -2.5d
			y: 2.5d
		}
		{
			dependencies: ["6D90E585D2406F72"]
			description: [
				"## <grad from=#7FA6E8 to=#D6E4FF f=0.6><shadow a=0.3>明亮的地方会治愈你</shadow></grad>"
				""
				"当周围光照等级较高时，会缓慢恢复生命值。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>低于 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>40% 的</grad><grad from=#FFFFFF to=#C7C7C7>生命值时，还能获得挖掘速度加成，并让你进食速度大幅提升，这倒是一个意外实用的应急按钮。</grad></shadow>"
				""
				"<shadow a=0.3><shadow a=0.3><grad from=#A0A0A0 to=#606060>空白卷轴、篝火、皮革、金子和小麦。</grad></shadow></shadow>"
			]
			id: "5121864C6D2774C5"
			min_width: 320
			optional: true
			subtitle: "<typewriter><grad from=#7FA6E8 to=#7FA6E8>奖励那些站在光明中的人。</grad></typewriter>"
			tasks: [{
				id: "4494CBF4655F667A"
				item: "enigmaticaddons:survivor_scroll"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#7FA6E8 to=#D6E4FF f=0.6>幸存者的卷轴</grad></shadow>"
			x: -1.5d
			y: -2.0d
		}
		{
			dependencies: ["5121864C6D2774C5"]
			description: [
				"## <grad from=#7FA6E8 to=#D6E4FF f=0.6><shadow a=0.3>战利品雷达</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>使用后，附近的箱子会短暂发光。范围为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>5</grad><grad from=#FFFFFF to=#C7C7C7> 格，冷却时间为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>16 秒</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>还能提升潜行速度，缩短坠落距离，非常适合悄悄探索遗迹。</grad></shadow>"
			]
			id: "6F209D8BFD97F332"
			min_width: 320
			optional: true
			shape: "diamond"
			subtitle: "<typewriter><grad from=#7FA6E8 to=#7FA6E8>透过墙壁突出显示宝藏。</grad>"
			tasks: [{
				id: "68D8A5753BC339DE"
				item: "enigmaticaddons:explorer_scroll"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#7FA6E8 to=#D6E4FF f=0.6>探险家卷轴</grad></shadow>"
			x: -1.0d
			y: -3.0d
		}
		{
			dependencies: ["5121864C6D2774C5"]
			description: [
				"## <grad from=#7FA6E8 to=#D6E4FF f=0.6><shadow a=0.3>能赚钱的击杀计数器</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>穿戴时，抗性会随着你击杀的怪物数量和种类的增加而提升。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>几乎从零开始，所以这是一份需要早早投入、晚些时候才能兑现的卷轴。</grad></shadow>"
			]
			id: "6D2066450170FF50"
			min_width: 320
			optional: true
			shape: "diamond"
			subtitle: "<typewriter><grad from=#7FA6E8 to=#7FA6E8>杀的越多，越变强。</grad></typewriter>"
			tasks: [{
				id: "70430AA6025EEF55"
				item: "enigmaticaddons:hunter_scroll"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#7FA6E8 to=#D6E4FF f=0.6>猎人卷轴</grad></shadow>"
			x: -0.5d
			y: -2.5d
		}
		{
			dependencies: ["453718D66065CA4A"]
			description: [
				"## <grad from=#7FA6E8 to=#D6E4FF f=0.6><shadow a=0.3>失眠保险</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>幻影生物在你附近生成的频率会大大降低，这就是大多数被诅咒的玩家都携带它的原因。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+20 percent</grad><grad from=#FFFFFF to=#C7C7C7> 攻击伤害</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+16 percent</grad><grad from=#FFFFFF to=#C7C7C7> 伤害减免</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+8 percent</grad><grad from=#FFFFFF to=#C7C7C7> 生命窃取</grad></shadow>"
				""
				"<shadow a=0.3><shadow a=0.3><grad from=#A0A0A0 to=#606060>最暗卷轴、扭曲之心、末影之眼、幻影膜和凋零玫瑰。</grad></shadow></shadow>"
			]
			id: "0AA1567557149D5C"
			min_width: 330
			subtitle: "<typewriter><grad from=#7FA6E8 to=#7FA6E8>幻影失去了兴趣。</grad>"
			tasks: [{
				id: "73AF42474FA9063C"
				item: "enigmaticaddons:night_scroll"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#7FA6E8 to=#D6E4FF f=0.6>暗夜契约</grad></shadow>"
			x: 1.5d
			y: 1.0d
		}
		{
			dependencies: ["0AA1567557149D5C"]
			description: [
				"## <grad from=#7FA6E8 to=#D6E4FF f=0.6><shadow a=0.3>全伤害横扫</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你的横扫攻击造成的伤害不再是平时那可怜兮兮的一小部分，而是变成了</grad><grad from=#FFC46B to=#FF9E1F f=0.8>100%</grad><grad from=#FFFFFF to=#C7C7C7>，这下宽剑终于派上用场了。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>对护甲目标造成额外伤害。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>击中同一目标足够多次，闪电就会劈落。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>闪电对你造成的伤害减半，并且几乎无视其他一切效果。</grad></shadow>"
				""
				"<shadow a=0.3><shadow a=0.3><grad from=#A0A0A0 to=#606060>想要一个Ichor Droplet、一个Purified Heart、一个Darkest Scroll和一个Will of the Ocean，所以属于中后期建造内容。</grad></shadow></shadow>"
			]
			id: "1D5A7FA7C73BA7AB"
			min_width: 340
			subtitle: "<typewriter><grad from=#7FA6E8 to=#7FA6E8>横扫攻击不再是笑话了。</grad></typewriter>"
			tasks: [{
				id: "062DDD7A61E9D782"
				item: "enigmaticaddons:thunder_scroll"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#7FA6E8 to=#D6E4FF f=0.6>雷鸣拥抱卷轴</grad></shadow>"
			x: 1.5d
			y: 2.5d
		}
		{
			dependencies: ["453718D66065CA4A"]
			description: [
				"## <grad from=#7FA6E8 to=#D6E4FF f=0.6><shadow a=0.3>吸收你遇到的所有诅咒</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>右键点击背包中的其他物品，它会吸收其附魔的诅咒。吸收的诅咒越多，它就越强，最多可吸收 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>200</grad><grad from=#FFFFFF to=#C7C7C7>次诅咒。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>重复击中同一目标会叠加前次伤害的</grad><grad from=#FFC46B to=#FF9E1F f=0.8>300%</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>在无敌帧内攻击会额外造成 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>100%</grad><grad from=#FFFFFF to=#C7C7C7>的伤害，并恢复你 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>20%</grad><grad from=#FFFFFF to=#C7C7C7>的生命值。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>你的打击会在目标上施加弱化版的前四种诅咒。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>该整合包重写了配方。宇宙之心、深渊之心、邪恶精华、一卷至暗卷轴、一颗扭曲之心和一本吞噬邪恶的魔典。</grad></shadow>"
			]
			id: "684D08CDB9CD24B2"
			min_width: 350
			shape: "diamond"
			subtitle: "<typewriter><grad from=#7FA6E8 to=#7FA6E8>它能清除你装备上的诅咒。</grad></typewriter>"
			tasks: [{
				id: "765EBB8F36745B1A"
				item: "enigmaticaddons:violence_scroll"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#7FA6E8 to=#D6E4FF f=0.6>暴力的诅咒</grad></shadow>"
			x: 0.5d
			y: 2.0d
		}
		{
			dependencies: ["453718D66065CA4A"]
			description: [
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>金钱</shadow></grad>"
				""
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+2</grad><grad from=#FFFFFF to=#C7C7C7> 时运。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>猪灵再次中立，即使在第二次诅咒下，以物易物也比以前好上约 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>100 个百分点</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>15 percent</grad><grad from=#FFFFFF to=#C7C7C7> chance of an emerald from any mob you kill.</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>村民的交易成本降低 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>35 个百分点</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[!danger] 除非你戴着七诅咒之戒，否则这东西绝不会进入插槽。"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>该整合包将其改写为Tau Oil、不死图腾、附魔金苹果、Darkest Scroll、Nefarious Essence和Greed charm。</grad></shadow>"
			]
			id: "3CC6763FA003F3C9"
			min_width: 350
			subtitle: "<typewriter><grad from=#FF8A8A to=#FF8A8A>商人的卷轴。</grad></typewriter>"
			tasks: [{
				id: "30EA6E2D6D4430DF"
				item: "enigmaticlegacy:avarice_scroll"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>无尽贪婪的契约</grad></shadow>"
			x: -1.5d
			y: 1.0d
		}
		{
			dependencies: ["453718D66065CA4A"]
			description: [
				"# <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>诅咒转化为属性</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>计算你穿戴的所有物品上的诅咒附魔数量。该数值会乘以这三个数值。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+1</grad><grad from=#FFFFFF to=#C7C7C7> 每个诅咒造成的攻击伤害。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+2</grad><grad from=#FFFFFF to=#C7C7C7> 每受一个诅咒，挖掘速度提升。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+1</grad><grad from=#FFFFFF to=#C7C7C7> 每个诅咒的生命恢复速度。</grad></shadow>"
				""
				"[!tip] 绑定诅咒和消失诅咒都算数，七诅咒之戒也很乐意在附魔台里给你更多。"
				""
				"[!danger] 除非你戴着七诅咒之戒，否则这东西绝不会进入插槽。"
			]
			id: "74D03B0A580FBCEA"
			min_width: 350
			shape: "diamond"
			subtitle: "<typewriter><grad from=#FF8A8A to=#FF8A8A>故意穿戴不好的附魔。</grad>"
			tasks: [{
				id: "4DFC7C820D14CBD4"
				item: "enigmaticlegacy:cursed_scroll"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>千咒卷轴</grad></shadow>"
			x: -0.5d
			y: 2.0d
		}
		{
			dependencies: ["1CB5C629D6E2424A"]
			description: [
				"## <grad from=#E03131 to=#FFAFAF f=0.6><shadow a=0.3>经验值作为状态栏显示</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>效果和Scroll of Ageless Wisdom一样，但你的经验等级会直接影响你的属性，最高可达等级</grad><grad from=#FFC46B to=#FF9E1F f=0.8>1000</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>伤害加成上限为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>100</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>治疗加成上限为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>50</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>击退抗性上限为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>160</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"[!danger] 球体给你的经验值低于正常值，死亡会清空你所有的等级。全部清空。"
				""
				"[!danger] 除非你戴着七诅咒之戒，否则这东西绝不会进入插槽。"
			]
			id: "172C4ECEC40C15C7"
			min_width: 340
			subtitle: "<typewriter><grad from=#FF8A8A to=#FF8A8A>等级代表力量。死亡则不然。</grad>"
			tasks: [{
				id: "464E4B54D0D2A67B"
				item: "enigmaticaddons:cursed_xp_scroll"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#E03131 to=#FFAFAF f=0.6>无知诅咒卷轴</grad></shadow>"
			x: -4.0d
			y: 0.5d
		}
		{
			dependencies: ["594DE634D568F698"]
			description: [
				"# <grad from=#F5C542 to=#FFF4CF f=0.6><shadow a=0.3>被诅咒卷轴的镜子</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>第三重负担会让盔甲消耗你的伤害。这张卷轴能直接返还给你。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+1</grad><grad from=#FFFFFF to=#C7C7C7> 每点护甲造成的伤害。</grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+1</grad><grad from=#FFFFFF to=#C7C7C7> 每点护甲韧性造成的伤害增加。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>伤害减免惩罚的上限降低 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>20 个百分点</grad><grad from=#FFFFFF to=#C7C7C7>。</grad></shadow>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>由最亮卷轴、自然光环代币、时钟指针、诞生之灵和防破坏护身符环绕构成。</grad></shadow>"
				""
				"[!danger] 除非你佩戴着七美德之环，否则这个物品拒绝进入插槽。"
			]
			id: "73B63202E26F1DD6"
			min_width: 350
			shape: "diamond"
			subtitle: "<typewriter><grad from=#F5C542 to=#F5C542>护甲变为伤害。</grad></typewriter>"
			tasks: [{
				id: "2B1F6FF80D80F990"
				item: "covenant_of_the_seven:divine_scroll"
				type: "item"
			}]
			title: "<shadow a=0.4><grad from=#F5C542 to=#FFF4CF f=0.6>千德卷轴</grad></shadow>"
			x: 2.5d
			y: 0.5d
		}
		{
			dependencies: ["071B31311EAC896B"]
			description: [
				"# <grad from=#FFD97A to=#FFFFFF f=0.6><shadow a=0.3>开发者的印记</shadow></grad>"
				""
				"<shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>没有配方，也没有战利品表。它由模组作者亲自赐予那些朝圣者，这就是唯一的获取方式。</grad></shadow>"
				""
				"- <shadow a=0.3><grad from=#FFC46B to=#FF9E1F f=0.8>+1</grad><grad from=#FFFFFF to=#C7C7C7> 幸运与 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>+1</grad><grad from=#FFFFFF to=#C7C7C7> 神秘卷轴栏位。 </grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>以太盔甲在生命值达到 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>80%</grad><grad from=#FFFFFF to=#C7C7C7> 时会举起盾牌，而不是 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>40%</grad><grad from=#FFFFFF to=#C7C7C7> 时举起盾牌。 </grad></shadow>"
				"[gap=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>大多数魔石冷却时间大幅下降，以太工具挖掘范围更广。</grad></shadow>"
				"[间隔=3]"
				"- <shadow a=0.3><grad from=#FFFFFF to=#C7C7C7>致命伤害会恢复你 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>50%</grad><grad from=#FFFFFF to=#C7C7C7> 带有增益效果的生命值，冷却时间为 </grad><grad from=#FFC46B to=#FF9E1F f=0.8>60秒</grad><grad from=#FFFFFF to=#C7C7C7> 。</grad></shadow>"
				""
				"[!info] 此任务线仅为完整性考虑。无需强制完成，该任务为可选内容。"
			]
			id: "442352EF0D22EB59"
