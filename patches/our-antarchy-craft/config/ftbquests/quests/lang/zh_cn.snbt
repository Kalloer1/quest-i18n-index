	quest.0002325750D8C7CA.quest_desc: ["基于磁盘的数字存储，后续还将支持自动合成。", "先铺设电缆。完整网络的章节会放在后面。"]
	quest.0002325750D8C7CA.title: "Refined Storage"
	quest.0055C7B329D3F955.quest_desc: ["四倍的1k。继续攀登吧。", "在合成网格中升级细胞。"]
	quest.0055C7B329D3F955.title: "4k 存储单元"
	quest.00DAC838C785004F.quest_desc: ["由 Molevore 掉落。"]
	quest.00DAC838C785004F.title: "鼹鼠兽的鼻子"
	quest.0285038935065C2E.quest_desc: ["有了更多空间可以进行各种活动。"]
	quest.0285038935065C2E.title: "钻石宝箱"
	quest.02C09C3B97D80D17.quest_desc: ["可携带气体、灌注类型、浆料和颜料，是另外三种无法携带的一切。", "如果物品从Mekanism机器中出来但没有桶，它可能应该放在这里。"]
	quest.02C09C3B97D80D17.title: "Pressurized Tubes"
	quest.034859012442BDB1.quest_desc: ["收集这个任务周围的所有实用宠物。"]
	quest.034859012442BDB1.title: "实用宠物模组"
	quest.03C5C48510630644.quest_desc: ["将匹配的物品从朝向的容器中拉入路由器。", "在源端连接一个拉杆，在目标端连接一个发射器，路线就会自动运行。"]
	quest.03C5C48510630644.title: "牵引模块"
	quest.041794122D484661.quest_desc: ["由 Springbug 掉落。"]
	quest.041794122D484661.title: "弹簧虫腿"
	quest.0438E6DA6F4D3F5A.quest_desc: ["适用于超大型网络的基于信道的数字存储。", "控制器是心脏；给予它能量和成长的空间。"]
	quest.0438E6DA6F4D3F5A.title: "Applied Energistics 2"
	quest.0462A21DD17BB720.quest_desc: ["1k 细胞的十六倍大小。", "在合成网格中升级细胞。"]
	quest.0462A21DD17BB720.title: "16k 存储单元"
	quest.04708B02C5690266.quest_desc: ["抽屉里各放着一大堆物品：完整方块占1、2或4格，半块用于紧凑的墙壁。", "Trim 将所有内容连接成一个网络，供下方的控制器使用。"]
	quest.04708B02C5690266.title: "储物抽屉"
	quest.04DA3A8507BEDB99.quest_desc: ["用金属升级的箱子和桶，而不是在房间里复制。", "每个等级都会增加格子和一个升级槽。从一个普通箱子开始。"]
	quest.04DA3A8507BEDB99.title: "Sophisticated Storage"
	quest.0592D3DABACD0CE6.quest_desc: ["由清醒者掉落。", "你之后还需要一个来做重力枪！"]
	quest.0592D3DABACD0CE6.title: "梦境之眼"
	quest.05FBD6E845323EA0.quest_desc: ["收集 5 种不同的宠物。"]
	quest.05FBD6E845323EA0.title: "宠物新手教程"
	quest.0604BD805637B627.quest_desc: ["滑道可将物品直接向下掉落，每过一个方块速度加快。", "智能滑槽可从物品栏中取物并在途中进行过滤。"]
	quest.0604BD805637B627.title: "滑道"
	quest.08891A0092241756.quest_desc: ["口袋真深。"]
	quest.08891A0092241756.title: "钻石背包"
	quest.099B848E75ABBBCE.quest_desc: ["蓝石火把、石英和石头。", "Antarchy 对红石的答案，功能相同。"]
	quest.099B848E75ABBBCE.title: "蓝石比较器"
	quest.099EEF71849D646F.quest_desc: ["它在托拉西斯的澄澈水池上漂移，投掷着能颠倒重力的箭矢。", "你需要两个梦境之眼：一个用于刀刃，一个用于重力枪。"]
	quest.099EEF71849D646F.title: "杀死清醒者 (Kill the Lucid)"
	quest.09B79B6479AE9F31.quest_desc: ["将磁盘中的方块放置到世界中。", "建筑师们更喜欢它。"]
	quest.09B79B6479AE9F31.title: "建造者"
	quest.09D0FEC1B1CFEF03.quest_desc: ["熔炼快捷栏中第一个可熔炼的物品。"]
	quest.09D0FEC1B1CFEF03.title: "熔炉宠物"
	quest.0A0F0008E0D1CC79.quest_desc: ["你造成的伤害会治愈你，并且会发射凋零骷髅头。"]
	quest.0A0F0008E0D1CC79.title: "凋零宠物"
	quest.0B926C1EBC72C321.quest_desc: ["骨粉可以种植作物，并将空碗填满蘑菇浓汤。"]
	quest.0B926C1EBC72C321.title: "蘑菇宠物 Mooshroom Pet"
	quest.0BA163F30788EA2E.quest_desc: ["将Forge的电力输送到ME网络中。", "每个网络一个通常就足够了。"]
	quest.0BA163F30788EA2E.title: "能量接收器"
	quest.0BE25B9BEA5F1E7E.quest_desc: ["它守护着埃利西亚草原和特鲁法洛森林的废弃竞技场。", "也有一些会出现在主世界的螳螂中。", "它的爪子为Big Bertha武器系列提供燃料。"]
	quest.0BE25B9BEA5F1E7E.title: "击杀阿尔法螳螂"
	quest.0C1AFCCD54FA31AA.quest_desc: ["漏斗会从上方物品栏中吸取物品，并推入传送带和滑槽中。", "黄铜漏斗也能过滤。将出料口指向物品应去的地方。"]
	quest.0C1AFCCD54FA31AA.title: "漏斗"
	quest.0CF6EE642D83E1E8.quest_desc: ["它从埃利西亚的巨大茧中孵化而出。", "它的翅膀能制作 Brutalfly Elytra，还能为大口径武器线提供材料，所以别弄丢了。"]
	quest.0CF6EE642D83E1E8.title: "杀死 Brutalfly"
	quest.0D0EC09FB5E55A96.quest_desc: ["将路由器中匹配的物品推送到朝向的容器中。", "在模块GUI中调节数量和红石行为。"]
	quest.0D0EC09FB5E55A96.title: "发送者模块"
	quest.0E9821755DE5F440.quest_desc: ["无线电力：插头为网络供电，节点从中取电。", "使用配置器将两者配置为相同的网络名称。"]
	quest.0E9821755DE5F440.title: "Flux Networks"
	quest.0ED597DDAB4D1972.quest_desc: ["一个货站将传送带、漏斗和玩家的交汇点整合为一个堆栈。", "盆在配方处理方面发挥着同样的作用。"]
	quest.0ED597DDAB4D1972.title: "Depot"
	quest.0F18276ABF2DDB0E.quest_desc: ["狩猎从家中开始。"]
	quest.0F18276ABF2DDB0E.title: "主世界"
	quest.1001AABBCCDDEEFF.quest_desc: ["暮色森林的第一个首领生物。", "在森林里找到纳迦庭院。纳迦会环绕竞技场并冲撞方块。带上盾牌，保持移动。"]
	quest.1001AABBCCDDEEFF.title: "那迦（Naga）"
	quest.1002AABBCCDDEEFF.quest_desc: ["在巫妖塔的最顶端。", "三个阶段。反射他的末影珍珠来打破护盾，在他召唤僵尸时近战，最后在他换用剑时终结他。"]
	quest.1002AABBCCDDEEFF.title: "暮色中的巫妖"
	quest.1003AABBCCDDEEFF.quest_desc: ["沼泽之下的迷宫。", "使用迷宫地图或沿着墙壁找到 Minoshroom。吃掉它掉落的 Meef Stroganoff 以解锁 Fire Swamp。"]
	quest.1003AABBCCDDEEFF.title: "Minoshroom"
	quest.1004AABBCCDDEEFF.quest_desc: ["在火焰沼泽中。", "九头蛇有很多头。远程攻击无效，请近战并保持移动以躲避火焰。击败它会开启黑暗森林。"]
	quest.1004AABBCCDDEEFF.title: "九头蛇"
	quest.1005AABBCCDDEEFF.quest_desc: ["在黑暗森林堡垒的里面。", "将任意首领奖杯置于底座上即可进入。第三层有六个骑士幻影共同作战。"]
	quest.1005AABBCCDDEEFF.title: "骑士幻影 (Knight Phantoms)"
	quest.1006AABBCCDDEEFF.quest_desc: ["在黑暗高塔的顶部。", "在底部找到会复现的方块以攀爬迷宫。由 Ghastling 驱动的 Ghast 陷阱会很有帮助，弓箭也行。"]
	quest.1006AABBCCDDEEFF.title: "远古幻象"
	quest.1007AABBCCDDEEFF.quest_desc: ["在雪原森林中。", "找到大型雪怪洞穴。阿尔法雪怪会投掷冰块，弓箭很有用。"]
	quest.1007AABBCCDDEEFF.title: "阿尔法雪怪"
	quest.1008AABBCCDDEEFF.quest_desc: ["冰川中的极光宫殿顶部。", "她会召唤冰晶并砸下能破坏地板的冰。躲避的同时攻击她的上半身。击败她即可解锁高地。"]
	quest.1008AABBCCDDEEFF.title: "冰雪女王"
	quest.1077E6D8B10D7B23.quest_desc: ["Mekanism 动力电缆，精通每种能源方言。", "注意等级：高功耗线路上的基本电缆会限制其速度。"]
	quest.1077E6D8B10D7B23.title: "通用电缆模组 (Universal Cables)"
	quest.10845E332C012581.quest_desc: ["它构成了大贝莎之刃的核心部分。"]
	quest.10845E332C012581.title: "终极之剑 The Ultimate Sword"
	quest.11147A9A0BF6BC26.quest_desc: ["把它放在箱子、桶或抽屉上，网络就会读取里面的东西。", "你的旧储物空间无需移动任何东西即可加入网络。"]
	quest.11147A9A0BF6BC26.title: "外部存储设备"
	quest.11A8FAFA9EAA3CD7.quest_desc: ["会发射火球。"]
	quest.11A8FAFA9EAA3CD7.title: "恶魂宠物"
	quest.11CB8DC2DE20DF89.quest_desc: ["收集本任务周围的所有特殊宠物。"]
	quest.11CB8DC2DE20DF89.title: "特殊宠物"
	quest.13C330FC9C38F2CF.quest_desc: ["在要塞传送门的那一边。"]
	quest.13C330FC9C38F2CF.title: "The End"
	quest.1478123C2F7C4BC4.quest_desc: ["播放你背包里的音乐唱片，可以跳过或停止播放。"]
	quest.1478123C2F7C4BC4.title: "唱片机宠物"
	quest.147DAAAA0ADF3C20.quest_desc: ["将外部物品栏吸入磁盘内。", "将箭头指向你的储物空间。"]
	quest.147DAAAA0ADF3C20.title: "导入器"
	quest.15D0F21CED8A5AD4.quest_desc: ["包里最大的口袋。"]
	quest.15D0F21CED8A5AD4.title: "下界合金背包"
	quest.165007409221A9CC.quest_desc: ["将外部物品栏拉入 QIO 驱动器中。", "将出口商推回。按生产线进行配对。"]
	quest.165007409221A9CC.title: "QIO 导入器"
	quest.17BE13E24CD644E5.quest_desc: ["真正的战斗现在开始，他有两个生命条，都需要降到0才能获得混沌碎片。别靠得太近，否则他会用一连串的火球攻击你！", "（顺便一提，旧版本中混沌守卫甚至能在创造模式下杀死玩家！幸运的是，现在它不行了）"]
	quest.17BE13E24CD644E5.title: "击杀混沌守护者 (Chaos Guardian)"
	quest.17E93A365DAB380D.quest_desc: ["它的巢穴藏在埃利西亚的奥兰伍德森林中——寻找分层的刷怪笼。", "不要与它对视。", "它的獠牙为伯莎巨刃提供能量。"]
	quest.17E93A365DAB380D.title: "杀死九头蛇（Basilisk）"
	quest.1808E04439BE57E1.quest_desc: ["所有科技机器都运行于FE，而这些机器会无差别地移动它。", "部分机器有严格的输入和输出侧，如果电力无法流动，请检查机器GUI。"]
	quest.1808E04439BE57E1.title: "能源管道模组 (Energy Pipez)"
	quest.183A58E73DF7E824.quest_desc: ["这一排里最大的磁盘。六万五千个堆叠。", "如果这个填满了，问题就出在你身上。"]
	quest.183A58E73DF7E824.title: "64k 存储磁盘"
	quest.18CFBA29FFFD9BF3.quest_desc: ["通过颜色路由，按单个物品过滤运输线路。", "把它放在线上，选择物品，选择颜色，完成。"]
	quest.18CFBA29FFFD9BF3.title: "物流分类器 (Logistical Sorter)"
	quest.196602572F217A3D.quest_desc: ["收集 40 种不同的宠物。"]
	quest.196602572F217A3D.title: "宠物专家"
	quest.1AE19A64C250F3FA.quest_desc: ["虚空溢出而非堵塞线路。适合永不休眠的农场。"]
	quest.1AE19A64C250F3FA.title: "虚空升级包"
	quest.1B539940DB8018D6.quest_desc: ["将世界方块直接破碎成磁盘。", "采石场们喜欢这个。"]
	quest.1B539940DB8018D6.title: "毁灭者"
	quest.1CEC818DF0EE4222.quest_desc: ["右键单击以打开便携式箱子。"]
	quest.1CEC818DF0EE4222.title: "Chest Pet"
	quest.1D2BC6C9E7FCD9DD.quest_desc: ["由 Basilisk 掉落。"]
	quest.1D2BC6C9E7FCD9DD.title: "Basilisk Fang"
	quest.1DE3FC52AC8A0FDB.quest_desc: ["两个章节都以数字形式存储，你可以同时运行两者。", "Refined Storage 是适合初学者的起点：无需频道，自动化合成更简单。", "AE2 后期可扩展，但会显著增加复杂性。"]
	quest.1DE3FC52AC8A0FDB.title: "Refined 还是 AE2？"
	quest.1E2CD94571F3157A.quest_desc: ["缓慢修复你背包中损坏的物品。", "可以召唤出一个活着的铁砧。"]
	quest.1E2CD94571F3157A.title: "Anvil Pet"
	quest.1E9CB2FC2EB81A66.quest_desc: ["有更多的空间可以进行活动。"]
	quest.1E9CB2FC2EB81A66.title: "黄金宝箱"
	quest.202AF58F0D836F49.quest_desc: ["快速飞行，缓慢下降，还有闪电袭击。"]
	quest.202AF58F0D836F49.title: "云端宠物"
	quest.20536A6C1E21C77A.quest_desc: ["甘蔗或蜂蜜瓶，随你选择。", "彩虹糖是在普通糖的基础上建造的。"]
	quest.20536A6C1E21C77A.title: "糖块"
	quest.20A4643BD1004B56.quest_desc: ["收集本任务周围的所有传奇宠物。"]
	quest.20A4643BD1004B56.title: "传奇宠物"
	quest.20D62C31A62D10AA.quest_desc: ["末影箱，就在你的口袋里。"]
	quest.20D62C31A62D10AA.title: "末影箱宠物"
	quest.219A23B318F03A5C.quest_desc: ["两格和三格抽屉在放入或取出时会自动在 nugget、ingot 和 block 之间转换。", "一个压缩抽屉就能取代整个锭块杂耍角。"]
	quest.219A23B318F03A5C.title: "抽屉压缩器 (Compacting Drawers)"
	quest.223C933BE42DD7DB.quest_desc: ["将水、熔岩和模组流体从一个储罐转移到另一个储罐。无法拾取世界中的源方块。", "将其中一个连接到水槽以获得无限水源。"]
	quest.223C933BE42DD7DB.title: "流体管道模组"
	quest.22C3E995BED50106.quest_desc: ["阻止怪物在附近生成，并将它们抛入火之轨道。"]
	quest.22C3E995BED50106.title: "太阳宠物"
	quest.22EB680B8211E199.quest_desc: ["你的第一个单元格：大约一千种物品类型。", "较大的单元格建立在较小的单元格之上。"]
	quest.22EB680B8211E199.title: "1k 存储单元"
	quest.231BE396EEC568E4.quest_desc: ["由 Flytraps 掉落。"]
	quest.231BE396EEC568E4.title: "Flytrap Goo"
	quest.24AD30F0436C0F9F.quest_desc: ["使用相同颜色代码的箱子和储罐，内容物可在维度间共享。", "右键染料设置代码。持有你颜色的人能读取你的库存，贵重物品别用彩虹色。"]
	quest.24AD30F0436C0F9F.title: "末地存储系统"
	quest.24AF42E4F51502DD.quest_desc: ["一个箱子，还有多余的空间。原地升级放置的箱子，无需重建。"]
	quest.24AF42E4F51502DD.title: "铁质箱子"
	quest.24CB19ADFE73AE3C.quest_desc: ["速度提升，还能为你产下蛋蛋。"]
	quest.24CB19ADFE73AE3C.title: "小鸡宠物"
	quest.2532BEE407769069.quest_desc: ["从已连接的物品栏中拉取物品到网络中。", "过滤允许通过的物品类型。"]
	quest.2532BEE407769069.title: "导入电缆 Kabel"
	quest.263580EFE40C382D.quest_desc: ["清除负面药水效果，并将空桶装满牛奶。"]
	quest.263580EFE40C382D.title: "奶牛宠物"
	quest.26498281C2337FF9.quest_desc: ["所有复杂升级都构建于空白之上。", "保留一叠；下面所有东西都会吃掉一个。"]
	quest.26498281C2337FF9.title: "升级基地"
	quest.28789AC959274591.quest_desc: ["防止饥饿，让你能吃有毒食物，并给你猪排。"]
	quest.28789AC959274591.title: "宠物猪"
	quest.287C4E1BB1B6DA2D.quest_desc: ["帮你吃掉背包里的食物。再也不用带胡萝卜了。"]
	quest.287C4E1BB1B6DA2D.title: "喂食升级"
	quest.288B83B4EDE8217C.quest_desc: ["放置后会吸收水，让你可以在上面行走。"]
	quest.288B83B4EDE8217C.title: "海绵宠物"
	quest.29645E8A5730448E.quest_desc: ["火焰抗性与岩浆行走能力。"]
	quest.29645E8A5730448E.title: "岩浆块宠物"
	quest.29BA664EB777443C.quest_desc: ["由 Stratoshark 掉落。"]
	quest.29BA664EB777443C.title: "斯特拉托鲨鳍"
	quest.2A18298BCEFDA045.quest_desc: ["右键打开便携式双联箱子。"]
	quest.2A18298BCEFDA045.title: "双箱宠物"
	quest.2B4F57775E452281.quest_desc: ["击退效果，外加一堆雪球补给。"]
	quest.2B4F57775E452281.title: "雪傀儡宠物"
	quest.2C8724D1B5322F15.quest_desc: ["骑着一只红蚂蚁离开下界 - 或者在尼克斯框架内杀死一只。", "一个重力颠倒的噩梦维度：植物、间歇泉和水池会将你抛向天空。", 		"噩梦、帝王蝎、清醒者和床虱都住在这里。女王统治着下方的地下世界。"
		"自然指南针会追踪名为“噩梦荒野”的托拉克斯生物群系。"]
	quest.2C8724D1B5322F15.title: "Thoraxis"
	quest.2D8E992843D88ED6.quest_desc: ["骑上一只生物，并在骑乘时飞行。"]
	quest.2D8E992843D88ED6.title: "飞行鞍宠物"
	quest.2DD4D02B05BFFB76.quest_desc: ["将你传送到末地，再传回来。"]
	quest.2DD4D02B05BFFB76.title: "末地传送门宠物"
	quest.2DE8C1417D853B24.quest_desc: ["选择一个结构，它会指向最近的建筑。", "由一个 Biome Pet 和一个 Pingot Pet 合成而成。"]
	quest.2DE8C1417D853B24.title: "锭形宠物"
	quest.2E01DB27775963D4.quest_desc: ["将细胞库存推送到机器中。", "合成卡可以按需请求配方。"]
	quest.2E01DB27775963D4.title: "出口总线"
	quest.2EF50D487B76083F.quest_desc: ["通过命令进行传送。", "当你的生命值低于半颗心时会自动保存。"]
	quest.2EF50D487B76083F.title: "末影人宠物"
	quest.30A8D4C9CA631D60.quest_desc: ["两个章节都以数字形式存储所有内容，你可以同时运行两者。", "AE2 可扩展性最强，但需要频道、压缩机和电源规划。", "作为首个数字系统，Refined Storage 是更温和的入门选择。"]
	quest.30A8D4C9CA631D60.title: "AE2 还是 Refined？"
	quest.31BF2CE22A7C697E.quest_desc: ["跳跃加速、墙壁攀爬和钓鱼线。"]
	quest.31BF2CE22A7C697E.title: "蜘蛛宠物"
	quest.321275E3D6C51353.quest_desc: ["基于信道的数字存储，适用于超大型网络，始于刻印机。", "完整的网络将在后续章节中详细介绍。"]
	quest.321275E3D6C51353.title: "Applied Energistics 2"
	quest.3315C143CA2C9FC5.quest_desc: ["最便宜的数字存储：一个主方块加连接每个箱子的线缆。", "没有电力，没有驱动器，只有一个可搜索的背包。"]
	quest.3315C143CA2C9FC5.title: "简易存储网络"
	quest.337319A85472B250.quest_desc: ["基于磁盘的数字存储，后续还将支持自动合成。", "控制器为网络供电；所有东西都挂在电缆上。"]
	quest.337319A85472B250.title: "Refined Storage"
	quest.344416259F08E1D9.quest_desc: ["夜视、吓退苦力怕，还能在水边捕鱼。"]
	quest.344416259F08E1D9.title: "宠物猫头鹰（Ocelot Pet）"
	quest.3457FE5FD126C5CD.quest_desc: ["使附近的生物和物品重力反向。"]
	quest.3457FE5FD126C5CD.title: "月亮宠物"
	quest.35507F7C8CD54074.quest_desc: ["Mekanism 的气体如氢气和氧气会拒绝所有其他管道。", "如果Mekanism配方涉及既非物品、流体也非能量的东西，它将通过气体管道传输。"]
	quest.35507F7C8CD54074.title: "Gas Pipez"
	quest.36AF3D06F7C13920.quest_desc: ["收集 60 种不同的宠物。"]
	quest.36AF3D06F7C13920.title: "宠物认知者 (Pet Cognoscente)"
	quest.370881E9F5E0C794.quest_desc: ["将铀矿石进行冶炼。"]
	quest.370881E9F5E0C794.title: "铀锭"
	quest.3712F66B8705F3E4.quest_desc: ["它能直接钻穿埃利西亚的鼹鼠洞穴和卡瓦林巢穴中的方块。", "它的鼻子为Big Bertha手柄提供能量。"]
	quest.3712F66B8705F3E4.title: "杀死地洞食者（Molevore）"
	quest.38F236E6B00C58C8.quest_desc: ["玉米、任意玉米热狗肉和一根木棍。", "将其熔炼或烟熏以制作手柄。"]
	quest.38F236E6B00C58C8.title: "生玉米热狗"
	quest.39FB0BF639BAF694.quest_desc: ["吸收伤害并为你提供罂粟花。"]
	quest.39FB0BF639BAF694.title: "铁傀儡宠物"
	quest.3B68BB08293B5042.quest_desc: ["糖、铀粒和HFCS，无需特定形状。", "也可以在特拉尤鲁斯实验室的箱子里找到。", "喂食彩虹蚂蚁会开启无限的随机维度。复活节兔子在里面蹦来蹦去，并产下克苏鲁之卵。"]
	quest.3B68BB08293B5042.title: "彩虹糖（Rainbow Sugar）"
	quest.3C19873B4E2A90FE.quest_desc: ["墙壁的大脑。用饰条连接抽屉，控制器就能看到所有抽屉。", "右键双击它，将匹配的背包内容倒入网络中。"]
	quest.3C19873B4E2A90FE.title: "抽屉控制器"
	quest.3D2A06434070D2A3.quest_desc: ["停靠矿车装置，并将其物品栏中的物品泵入或泵出。", "两个相对而立的接口，连接着动态与静态存储。"]
	quest.3D2A06434070D2A3.title: "便携式存储接口"
	quest.3D2C5B304E8D62E8.quest_desc: ["将外部物品栏拉入单元格中。", "过滤后的侧面可防止循环出现。"]
	quest.3D2C5B304E8D62E8.title: "导入总线"
	quest.3E34CEDFB7077872.quest_desc: ["钥匙调节每个抽屉：锁住可保留物品，量化显示确切数量，遮蔽隐藏标签，绑定将其与你关联。"]
	quest.3E34CEDFB7077872.title: "抽屉钥匙"
	quest.3EC5E424D3FABDFE.quest_desc: ["一根管道用于物品、流体和能量，适合紧凑的建造。", "气体仍然需要自己的气体管道。"]
	quest.3EC5E424D3FABDFE.title: "通用管道模组 (Universal Pipez)"
	quest.3EF864FC1334CE65.quest_desc: ["将发电机产生的电力推入你的网络。", "每排发电机一个插头，保持整洁。"]
	quest.3EF864FC1334CE65.title: "Flux 插头"
	quest.3F7C17E60A335E1B.quest_desc: ["治疗附近的友军和驯养的宠物。"]
	quest.3F7C17E60A335E1B.title: "爱心宠物"
	quest.400B3C383231B9BE.quest_desc: ["可以找到矿石或地牢，并能拉出最近的矿石。"]
	quest.400B3C383231B9BE.title: "Pingot 宠物"
	quest.401952145436BB91.quest_desc: ["由杰瑞掉落。"]
	quest.401952145436BB91.title: "杰瑞核芯"
	quest.40CAEFC8FFA71617.quest_desc: ["杀穿卡瓦林大军：击杀爬行瘟疫等生物会升级浪潮。", "最后一波会生成赫拉克勒斯甲虫，并伴有警告。如果你愿意，也可以驯服它。", "它的角为伯莎大剑柄提供能量。"]
	quest.40CAEFC8FFA71617.title: "杀死大力神甲虫 Hercules Beetle"
	quest.410105599B92D2A8.quest_desc: ["抗性，还有生命的意义。"]
	quest.410105599B92D2A8.title: "米克森"
	quest.41E2CC6B056CB704.quest_desc: ["石英、石头和红石火把，原版配方。", "重力枪想要真正的红石逻辑电路。"]
	quest.41E2CC6B056CB704.title: "比较器"
	quest.4221D0E01AD435C6.quest_desc: ["减缓时间并将物品拉向你。"]
	quest.4221D0E01AD435C6.title: "黑洞宠物"
	quest.42374C695F91CBC5.quest_desc: ["一个随身携带的合成网格。"]
	quest.42374C695F91CBC5.title: "工作台宠物 (Crafting Table Pet)"
	quest.429ACC512A7C4219.quest_desc: ["模组里的所有宠物。祝你好运。"]
	quest.429ACC512A7C4219.title: "宠物学家 (Petologist)"
	quest.438F1AA8169CF59A.quest_desc: ["向周围一切发出冲击的音波攻击。"]
	quest.438F1AA8169CF59A.title: "Dubstep 宠物"
	quest.43AE1F89A8B0ECFD.quest_desc: ["第一次升级。"]
	quest.43AE1F89A8B0ECFD.title: "铁质背包"
	quest.4401780EB32024FE.quest_desc: ["加载模式，网络按需合成配方。", "向网格请求物品，然后等待它发挥作用。"]
	quest.4401780EB32024FE.title: "自动合成台"
	quest.45A76C5F674624A5.quest_desc: ["收集20种不同的宠物。"]
	quest.45A76C5F674624A5.title: "宠物收集家"
	quest.45E07B5F73AEFB8A.quest_desc: ["Brutalfly 统治着 Elythia 的天空。把它打下来。", "它的翅膀能喂养Big Bertha武器系列，所以别弄丢了。"]
	quest.45E07B5F73AEFB8A.title: "杀死 Brutalfly"
	quest.45E3311A8FC88F72.quest_desc: ["收集 50 种不同的宠物。"]
	quest.45E3311A8FC88F72.title: "宠物专家"
	quest.468AC41BFA2FBD23.quest_desc: ["两个比较器、两个锭、下界合金，以及第二个梦境之眼。", "这把刀刃也借用了眼睛，所以你必须杀死两个Lucid。"]
	quest.468AC41BFA2FBD23.title: "重力枪"
	quest.46DDB9A2E1A8C4E8.quest_desc: ["收集 10 种不同的宠物。"]
	quest.46DDB9A2E1A8C4E8.title: "宠物研究员"
	quest.46FDE1053D1ED4E6.quest_desc: ["托拉西斯梦境沙丘的加冕恐怖。", "它的尾针为伯莎巨刃提供能量。"]
	quest.46FDE1053D1ED4E6.title: "杀死帝王蝎（Emperor Scorpion）"
	quest.474C9FBAB430E164.quest_desc: ["将物品、流体、气体和能量传送至不同维度。", "需要 QIO 驱动频率和大量电力。"]
	quest.474C9FBAB430E164.title: "量子纠缠传送器"
	quest.475DDABE8D57F989.quest_desc: ["按需为网络制作配方图案。", "有了速度卡，行动更快。"]
	quest.475DDABE8D57F989.title: "分子组装器"
	quest.483B6AF583A73905.quest_desc: ["Mekanism 的物品管道，从基础到终极，共四个等级。", "用配置器配置两端。物流分拣器稍后会添加单个物品的路由。"]
	quest.483B6AF583A73905.title: "物流运输机 (Logistical Transporters)"
	quest.48A2A4D44D3E72AB.quest_desc: ["召唤并储存为你战斗的仆从生物。"]
	quest.48A2A4D44D3E72AB.title: "量子晶体怪物宠物"
	quest.48B38A199C0690E6.quest_desc: ["水下呼吸、水下视觉和游泳加速。"]
	quest.48B38A199C0690E6.title: "鱿鱼宠物"
	quest.49AA40492696BCA0.quest_desc: ["附近的真空吸尘器会直接掉落物品到背包里。经过朋友的建造地前请先关闭它。"]
	quest.49AA40492696BCA0.title: "磁石升级"
	quest.4A48C9233678C0E2.quest_desc: ["收集本任务周围的所有和平宠物。"]
	quest.4A48C9233678C0E2.title: "和平宠物模组"
	quest.4A5B316F3F26BB5D.quest_desc: ["右键点击棕色蚂蚁，你将被吸入埃利西亚。"]
	quest.4A5B316F3F26BB5D.title: "进入埃利西亚（Elythia）"
	quest.4A9C9D5C3303E80E.quest_desc: ["包含十个存储单元，用于网络存储物品。", "细胞分等级，从小处着手。"]
	quest.4A9C9D5C3303E80E.title: "ME 驱动器"
	quest.4B7A9E79D4CAE2E1.quest_desc: ["收集这个任务周围的所有宠物生物。"]
	quest.4B7A9E79D4CAE2E1.title: "生物宠物模组"
	quest.4BC8C8F0B0ADFCA2.quest_desc: ["按命令爆炸，并保持免疫于爆炸。"]
	quest.4BC8C8F0B0ADFCA2.title: "苦力怕宠物"
	quest.4BDE0496932034F8.quest_desc: ["一个可通过模块替换实现推动、拉动和过滤的方块，非常适合紧凑型自动化。", "开箱即用，可作用于相邻的六个方块。范围和堆叠升级会稍后加入。"]
	quest.4BDE0496932034F8.title: "模块化路由器 (Modular Routers)"
	quest.4CB8BC45DA301142.quest_desc: ["将所有设备连接回控制器。", "没有需要统计的频道，直接到处运行即可。"]
	quest.4CB8BC45DA301142.title: "电缆"
	quest.4CCEAB12A6AD72FA.quest_desc: ["将配方写入空白模式模板中。", "配方是自动合成运行的基础。"]
	quest.4CCEAB12A6AD72FA.title: "图案网格"
	quest.4D7B3F935FEBA2AB.quest_desc: ["你的第一个磁盘：大约两千个物品。", "更大的磁盘建立在更小的磁盘之上。"]
	quest.4D7B3F935FEBA2AB.title: "1k 存储磁盘"
	quest.4D84B1D48D2BC8EC.quest_desc: ["将网络中的电力输送到机器中。", "设置每个点的限制，这样一台饥饿的机器就不会让基地停电。"]
	quest.4D84B1D48D2BC8EC.title: "Flux Point"
	quest.4D924EDBBBAA90E2.quest_desc: ["由Brutalfly掉落。"]
	quest.4D924EDBBBAA90E2.title: "Brutalfly 翅膀"
	quest.4DA1CB466F30CB23.quest_desc: ["噩梦鳞片、鼹鼠鼻、杰瑞核、大力士角、弹簧虫腿、原始盾、彩虹糖。", "七次掉落，一次拾取。"]
	quest.4DA1CB466F30CB23.title: "大贝莎手柄"
	quest.4DF4CCA612E87BC1.quest_desc: ["三十秒的瞬射，外加箭矢。"]
	quest.4DF4CCA612E87BC1.title: "箭袋宠物"
	quest.4F15A97C2B78C20C.quest_desc: ["由帝王蝎掉落。"]
	quest.4F15A97C2B78C20C.title: "帝王蝎的毒刺"
	quest.4F5AB6B08B90C26B.quest_desc: ["在一个方块中完成导入和导出。", "机器可以像箱子一样向它推入和拉出物品。"]
	quest.4F5AB6B08B90C26B.title: "界面"
	quest.4F87D484CF50F980.quest_desc: ["恢复生命值，并将空桶装满岩浆。"]
	quest.4F87D484CF50F980.title: "Purplicious 奶牛宠物"
	quest.4FB4D4E4ACC2BC58.quest_desc: ["这一排中最大的箱子，拥有最多的升级槽位。"]
	quest.4FB4D4E4ACC2BC58.title: "下界合金宝箱"
	quest.52135CB13CCC38B7.quest_desc: ["制作一台 AntOS 计算机，并将你找到的软盘插入其中。", "Boss 记录包含每个 Boss 的栖息地和战斗方式；King 和 Queen 记录则列出坐标。", "磁盘会出现在结构宝箱和科学家村民那里。", "末影龙死后，探险家指南针能更快地找到首领巢穴。"]
	quest.52135CB13CCC38B7.title: "Boss 记录"
	quest.531A0D00CEB93836.quest_desc: ["安装了高级升级的管道过滤器：打开管道GUI，添加过滤器，然后设置物品、标签或NBT。", "目标工具将过滤器锁定到特定物品栏。白名单仅允许过滤器通过，黑名单则反之。"]
	quest.531A0D00CEB93836.title: "管道过滤系统"
	quest.53689B826F46C9AF.quest_desc: ["它在埃利西亚海洋中守护着自己的竞技场。", "它的鳞甲喂养了大贝莎剑柄。"]
	quest.53689B826F46C9AF.title: "杀死托雷恐怖怪（Toreterror）"
	quest.53DB7377C211654A.quest_desc: ["右键棕色蚂蚁，即可被吸入Elythia，这里是Brutalfly、Toreterror、Basilisk、Molevore、Stratoshark、Alpha Mantis和King的狩猎场。"]
	quest.53DB7377C211654A.title: "Elythia"
	quest.543BAE83CA014862.quest_desc: ["一个存在于箱子内部的合成网格。", "还有石雕和熔炼的不同版本可供选择。"]
	quest.543BAE83CA014862.title: "合成升级配方：将物品放入合成台，即可升级配方。"
	quest.54F000B24088BB6C.quest_desc: ["克苏鲁会掉落触手和牙齿，你需要各一个。"]
	quest.54F000B24088BB6C.title: "释放克苏鲁神话中的怪物——克拉肯"
	quest.55A4EED273996F9B.quest_desc: ["一格物品里包含着二十五万种物品类型。", "线路的终点。大概吧。"]
	quest.55A4EED273996F9B.title: "256k 存储单元"
	quest.56470DD6A6B6B8AE.quest_desc: ["缓慢下落，外加羊毛方块。"]
	quest.56470DD6A6B6B8AE.title: "宠物绵羊"
	quest.567DF821E2727EF2.quest_desc: ["它在埃利西亚的云海中巡逻。", "它的鳍能喂养大贝莎刀片——还能熬成美味的汤。"]
	quest.567DF821E2727EF2.title: "击杀 Stratoshark"
	quest.570FA365734D9D59.quest_desc: ["为电解分离器等机器输送流体，这些机器会消耗水。", "更高等级每次携带更多物品。"]
	quest.570FA365734D9D59.title: "机械管道 (Mechanical Pipes)"
	quest.571814A9A148A680.quest_desc: ["酿造一瓶随机药水。"]
	quest.571814A9A148A680.title: "酿造台宠物"
	quest.574FF91C2BA5B3EE.quest_desc: ["这里的所有东西都能在没有电源的情况下存储物品：罐子、抽屉、箱子和背包。", "数字存储系统为溢出时的箱子房间画上句号。"]
	quest.574FF91C2BA5B3EE.title: "基础存储系统"
	quest.57DEC97B2439F380.quest_desc: ["打包一台机器，内含物品和设置，方便搬家。", "并非对所有东西都有效，但对大多数重要的东西都有效。"]
	quest.57DEC97B2439F380.title: "纸板箱"
	quest.58E9F2D694C5AACF.quest_desc: ["一个内置了合成功能的终端机。", "直接从细胞中合成出来。"]
	quest.58E9F2D694C5AACF.title: "合成终端"
	quest.59B10BA13662C356.quest_desc: ["清除多余的物品。每种物品、流体和能量各一个。", "虚空升级后的物品能直接完成相同工作，但备一个在工作台旁的罐子总没错。"]
	quest.59B10BA13662C356.title: "垃圾桶"
	quest.5A2BB3FE519904B0.quest_desc: ["把它扔出去，它就会自己飞回来。"]
	quest.5A2BB3FE519904B0.title: "香蕉宠物"
	quest.5C87B4ED20485B96.quest_desc: ["螳螂爪、巨型苍蝇翅膀、捕蝇草黏液、一根烤玉米热狗，还有整套重力枪。", "是的，枪会被消耗掉。值得的。"]
	quest.5C87B4ED20485B96.title: "大贝莎手柄"
	quest.5D5293C66B777AB7.quest_desc: ["保护附近的盟友和驯养的宠物。"]
	quest.5D5293C66B777AB7.title: "盾牌宠物"
	quest.5DA1AD8E6FEBCD1F.quest_desc: ["合成台上放四个下界合金废料和四个金锭。", "刀刃项目需要它的背骨金属。"]
	quest.5DA1AD8E6FEBCD1F.title: "下界合金锭"
	quest.5DFA0469CBFF181C.quest_desc: ["用牵引绳驯服生物。"]
	quest.5DFA0469CBFF181C.title: "牵引宠物"
	quest.5E0943EE854B447E.quest_desc: ["在任何地方睡觉。", "可以召唤出一个活着的床。"]
	quest.5E0943EE854B447E.title: "床宠"
	quest.5E1B1EDC40B2FDAE.quest_desc: ["连接两个物品栏，在两者之间移动物品，例如从农场到箱子，或从箱子到机器。", "用扳手调整管道，将每侧设为拉动、推动或关闭。"]
	quest.5E1B1EDC40B2FDAE.title: "物品：管道（Pipez）"
	quest.5E2317898835EEB5.quest_desc: ["能救你一命，还能获得史莱姆球。"]
	quest.5E2317898835EEB5.title: "史莱姆宠物"
	quest.5EFFD7F90347D84C.quest_desc: ["力量提升，你的攻击还会使敌人着火。"]
	quest.5EFFD7F90347D84C.title: "烈焰人宠物"
	quest.5F5E45EFACDCE9A6.quest_desc: ["将钛矿石进行冶炼。"]
	quest.5F5E45EFACDCE9A6.title: "钛合金锭"
	quest.6091AE070476DB48.quest_desc: ["装置和基地之间的无线红石电路。", "一个链接发送，另一个接收，无论多远都能连通。"]
	quest.6091AE070476DB48.title: "红石链接器"
	quest.61384D5A42B93834.quest_desc: ["由噩梦生物掉落。"]
	quest.61384D5A42B93834.title: "噩梦鳞片"
	quest.616EAC0708E2EF90.quest_desc: ["背包内有一个合成网格。也支持熔炼、切石和爆破等变体。"]
	quest.616EAC0708E2EF90.title: "合成升级配方"
	quest.619D3C9D28CBCD62.quest_desc: ["Mekanism 储罐可以容纳成桶的液体，并且可以向上升级。", "动态储罐会随多方块大小缩放。"]
	quest.619D3C9D28CBCD62.title: "流体储罐"
	quest.61CF2F9D4B616419.quest_desc: ["终极之剑、澄澈之眼、巴适拉斯克之牙、帝王之刺、斯特拉托鲨鳍、克拉肯触须和牙齿。", "七种稀有度，一种尖端。请勿弄丢。"]
	quest.61CF2F9D4B616419.title: "大贝莎之刃"
	quest.61DB15007645A618.quest_desc: ["空间更宽敞了。"]
	quest.61DB15007645A618.title: "黄金背包"
	quest.628115E311C3BE81.quest_desc: ["1k的十六倍。服务器级的囤积狂。", "一个磁盘可以吞下采石场的全部产出。"]
	quest.628115E311C3BE81.title: "16k 存储磁盘"
	quest.62D262AA36968D2D.quest_desc: ["存储升级能将容量从铁到金、钻石、绿宝石和下界合金逐级提升。", "按住 Shift 右键控制器，可将升级一次性注入整个网络。"]
	quest.62D262AA36968D2D.title: "抽屉升级组件"
	quest.641CF9A9B2EFF048.quest_desc: ["用于大型自动化的海量存储解决方案。", "每个材料网络一个单元格。"]
	quest.641CF9A9B2EFF048.title: "64k 存储单元"
	quest.648C33EF5C50D3BF.quest_desc: ["附魔装备、损坏工具和带额外数据的物品无法堆叠。", "把这些东西放在箱子里或袋子里。输入数字系统会让驱动器塞满成千上万个唯一条目。"]
	quest.648C33EF5C50D3BF.title: "NBT 和 你！"
	quest.649A8D3788538C80.quest_desc: ["击中目标会施加中毒效果，并发射毒液冲击波。"]
	quest.649A8D3788538C80.title: "河豚宠物"
	quest.663C8E631F2869C5.quest_desc: ["四倍的1k。继续攀登吧。", "磁盘可就地升级，使用存储部件。"]
	quest.663C8E631F2869C5.title: "4k 存储磁盘"
	quest.66902790EAFD0729.quest_desc: ["搜索一个屏幕范围内的所有方块。", "系统的表面形态。"]
	quest.66902790EAFD0729.title: "ME终端"
	quest.670F1DFE159F3B33.quest_desc: ["它们遍布托拉克斯的每个角落，从巢穴和地表集群中孵化而出。", "将它们压扁以获得进度。"]
	quest.670F1DFE159F3B33.title: "杀死一只臭虫（Bed Bug）"
	quest.6858822C00824705.quest_desc: ["有两种方法：在携带不祥之兆时杀死鱿鱼可以召唤它，且不祥之兆的等级越高，概率越大；或者在彩虹蚂蚁维度找到复活节兔子，等待它产下克苏鲁之卵。", "模组里最难的 boss：它会飞行、召唤闪电，还会发射章鱼炸弹和导弹鱿鱼。", "为大伯莎之刃带来一个触须和一个牙齿。"]
	quest.6858822C00824705.title: "杀死克苏鲁神话中的克鲁克斯（Kraken）"
	quest.6AA39F9193D053E6.quest_desc: ["收集本任务周围的所有宠物。"]
	quest.6AA39F9193D053E6.title: "区域宠物"
	quest.6B10301A0D908130.quest_desc: ["由Toreterror掉落。"]
	quest.6B10301A0D908130.title: "Primordial Scute"
	quest.6B1F8FD97675DF68.quest_desc: ["它在托拉西斯的噩梦荒野和暗影山丘中出没。", "准备好迎接重力翻转吧。", "它的鳞片可以喂养大贝莎剑柄。"]
	quest.6B1F8FD97675DF68.title: "杀死噩梦生物（Nightmare）"
	quest.6B4FE35EC75A476E.quest_desc: ["将每个相连的箱子视为一个大型储物空间，范围可达所有方向14格。", "它同时是管道和数字系统的输入和输出点。"]
	quest.6B4FE35EC75A476E.title: "存储控制器"
	quest.6B6129EE83D022CF.quest_desc: ["随时随地施展附魔。"]
	quest.6B6129EE83D022CF.title: "附魔台宠物"
	quest.6B9F7D9034C88F24.quest_desc: ["无线将远处的箱子加入控制器网络。使用存储工具绑定：先控制器，再箱子。", "同样是14格范围，但没有修剪隧道。"]
	quest.6B9F7D9034C88F24.title: "存储链接"
	quest.6C3CC466DF3D88BE.quest_desc: ["Shift + 使用可循环切换首领模式：", "Basilisk 会麻痹和中毒，Lucid 会反转重力，Nightmare 会传播恐惧，", "克洛托斯会猛击并召唤闪电，赫拉克勒斯会将敌人击向天空，", "Molevore 会钻穿方块，Toreterror 会带着AOE冲击波俯冲而下。"]
	quest.6C3CC466DF3D88BE.title: "大个子伯特哈"
	quest.6C57084B75B0A422.quest_desc: ["搜索一个屏幕范围内的所有磁盘。", "系统的表面形态。"]
	quest.6C57084B75B0A422.title: "网格"
	quest.6D508C05CB7BA59E.quest_desc: ["将网络库存推入机器和箱子中。", "自动处理的核心支柱。"]
	quest.6D508C05CB7BA59E.title: "导出电缆 Export Kabel"
	quest.6D8CD5CBA8CE7BFA.quest_desc: ["在末地，你会找到原版 Minecraft 的最终 boss：末影龙。", "在每个黑曜石柱的顶部，你都会发现一个能治疗末影龙的末地水晶。务必先摧毁它们！它们的伤害也很高，所以一定要保持距离！", "击败后，龙蛋会生成在出口传送门顶部。它不能像普通方块一样被挖掘，但会受到重力的影响。"]
	quest.6D8CD5CBA8CE7BFA.title: "击杀末影龙"
	quest.6DC3B26B2B88FCB1.quest_desc: ["可升级的背包，放置在好奇物品的背部插槽，并使用过滤器来实现巧妙技巧。", "它们也会染色，这样整个服务器都可以用颜色区分了。"]
	quest.6DC3B26B2B88FCB1.title: "Sophisticated Backpacks"
	quest.706ABC3111A615C2.quest_desc: ["怪物和采矿的掉落物有额外奖励。"]
	quest.706ABC3111A615C2.title: "战利品宠物"
	quest.707341E3F0EEAE0C.quest_desc: ["Antarchy 矿石比钻石更稀有，每个会掉落一个金块。", "九个可以制作一个锭。"]
	quest.707341E3F0EEAE0C.title: "铀矿石（Uranium Nugget）"
	quest.71902E9FC13770FE.quest_desc: ["一种只允许特定物品通过的线缆。", "保持已排序的线路处于排序状态。"]
	quest.71902E9FC13770FE.title: "过滤线缆"
	quest.728535329B6CABAE.quest_desc: ["Mekanism 自己的数字存储：超密集驱动器位于一个阵列上。", "进口商和出口商将其接入工厂。"]
	quest.728535329B6CABAE.title: "QIO 驱动阵列"
	quest.73B7502A7CE903EA.quest_desc: ["管理整个网络并缓冲传输数据。", "在网络长出牙齿之前都是可选的。"]
	quest.73B7502A7CE903EA.title: "Flux 控制器"
	quest.74371D87F77252BF.quest_desc: ["用玉米酿造。每份彩虹糖都需要一个，而彩虹糖能喂养大贝尔塔手柄。"]
	quest.74371D87F77252BF.title: "高果糖玉米糖浆"
	quest.7529B626BA315E9A.quest_desc: ["收集 30 种不同的宠物。"]
	quest.7529B626BA315E9A.title: "宠物科学家"
	quest.755A9B6A2486D364.quest_desc: ["传送带、漏斗和滑槽让物品走风景路线，而且不耗电。", "先放传送带连接器，再把漏斗连接到箱子和机器上。", "用更多连接器延长线路，并注意旋转方向。"]
	quest.755A9B6A2486D364.title: "创建"
	quest.757E0BBF7CF30F7D.quest_desc: ["每次升级都提升单次操作量。基础版增加红石控制，改进版增加轮询等路由模式，高级版解锁过滤器，终极版则大幅提升移动量。"]
	quest.757E0BBF7CF30F7D.title: "管道升级 (Pipe Upgrades)"
	quest.75A00F759323E4AF.quest_desc: ["手动在箱子、机器和农场之间搬运成千上万的物品可不是个好主意。", "本章涵盖整合包的管道：Pipez 用于简单线路，Mekanism 用于机器，Modular Routers 用于巧妙设计。拿起扳手开始吧。"]
	quest.75A00F759323E4AF.title: "物流系统"
	quest.75FB1CD196158F95.quest_desc: ["一个内置了工作台的工作台网格。", "直接从磁盘里制作出来吧。"]
	quest.75FB1CD196158F95.title: "合成网格"
	quest.77F2BF66E570A12A.quest_desc: ["存储网络实际存储数据的存储磁盘。", "更多驱动器，更多磁盘，更多一切。"]
	quest.77F2BF66E570A12A.title: "磁盘驱动器"
	quest.7912EAAEAB3E5D3B.quest_desc: ["由所有其他宠物制成，并能变成它们中的任意一种。"]
	quest.7912EAAEAB3E5D3B.title: "Meta 宠物"
	quest.794098D78CD9BD42.quest_desc: ["手动在箱子、机器和农场之间搬运成千上万物品可不是个好主意。", "本章涵盖整合包的管道：Pipez 用于简单线路，Mekanism 用于机器，Modular Routers 用于巧妙设计。拿起扳手开始吧。"]
	quest.794098D78CD9BD42.title: "管道匠模组"
	quest.7983697A655600AE.quest_desc: ["Mekanism机器很挑剔：机器GUI中每个面都必须设置为输入、输出或关闭。", "配置器会在拉和推之间切换。在铺设任何管道之前先获取一个。"]
	quest.7983697A655600AE.title: "Mekanism"
	quest.7B48AA1D703B5B22.quest_desc: ["由螳螂掉落 - Alpha 螳螂也会掉落它们。"]
	quest.7B48AA1D703B5B22.title: "螳螂爪 (Mantis Claw)"
	quest.7BBC706328090A22.quest_desc: ["控制器网络的输入输出点：管道通过它进行推入和拉出。", "每面墙一个I/O通常就足够了。"]
	quest.7BBC706328090A22.title: "控制器输入/输出"
	quest.7C4E406EC577C304.quest_desc: ["附近的箱子会吸入附近的掉落物。", "聚会前请将其关闭。"]
	quest.7C4E406EC577C304.title: "拾取物品升级"
	quest.7D319BB781227B4F.quest_desc: ["宠物需要合成，携带它们时它们会工作。", "将宠物悬停以查看其能力、控制方式和最爱食物。", "宠物会感到饥饿；饱腹状态的宠物则不会。"]
	quest.7D319BB781227B4F.title: "第一步"
	quest.7DA5527429294D17.quest_desc: ["将网络库存推送到机器和箱子中。", "过滤器可以阻止错误物品的进入。"]
	quest.7DA5527429294D17.title: "导出器"
	quest.7DB46DA33E716767.quest_desc: ["从一个屏幕搜索整个电缆网络，并提取所需内容。", "与遥控器配对，即可随时随地浏览你的库存。"]
	quest.7DB46DA33E716767.title: "请求平板电脑"
	quest.7DC64DC3FE15A9D9.quest_desc: ["为处理器和卡件按压电路。", "命名一个压榨机，投入中间，收集下方。"]
	quest.7DC64DC3FE15A9D9.title: "Inscriber"
	quest.7E2BB82AF06BA4A5.quest_desc: ["yum"]
	quest.7E2BB82AF06BA4A5.title: "烤玉米热狗"
	quest.7E7A788DF7806180.quest_desc: ["可通过不同等级升级的单物品批量存储。", "Mekanism 区域的抽屉式存储装置。"]
	quest.7E7A788DF7806180.title: "Mekanism 储物箱"
	quest.7F59786D1353134D.quest_desc: ["追踪一只白蚁，或在 Myrmite 传送门框架内杀死一只。", "一个虫群肆虐、怪物潮愈演愈烈的维度。", "大力士甲虫、鼹鼠和杰瑞蛋在内部等着你。"]
	quest.7F59786D1353134D.title: "Cavaryn"
	quest.7F85B0D935283536.quest_desc: ["为自动合成网络提供编码好的配方。", "与分子组装器搭配使用。"]
	quest.7F85B0D935283536.title: "模式提供者"
	quest.7F8D2F3FBC9C28BE.quest_desc: ["由大力神甲虫掉落。"]
	quest.7F8D2F3FBC9C28BE.title: "大力士之角 (Hercules Horn)"
	quest.843DB879D75A9841.quest_desc: ["将外部物品栏拉入单元格中。", "过滤后的侧面可防止循环出现。"]
	quest.843DB879D75A9841.title: "导入总线"
	quest.8E160E8AA5A249A0.quest_desc: ["1k 细胞的十六倍大小。", "在合成网格中升级细胞。"]
	quest.8E160E8AA5A249A0.title: "16k 存储单元"
	quest.141707DC8770F0B6.quest_desc: ["孵化王子蛋，并用金色物品喂养幼崽，直到它长大。", "成年的王子可以被驯服和鞍具化以用于飞行。"]
	quest.141707DC8770F0B6.title: "王子万岁，永垂不朽"
	quest.19635F3E1FC4BE40.quest_desc: ["克苏鲁不需要传送门，只需要大海。"]
	quest.19635F3E1FC4BE40.title: "主世界"
	quest.21CC719DB7052664.quest_desc: ["她统治着通过重力喉道可达的托拉西斯地下世界。", "她弯曲了重力和时间，她的曼提柯尔会完成她未竟的事业。", "掉落女王鳞片，用于制作皇家突袭者装备，还有一个公主蛋。"]
	quest.21CC719DB7052664.title: "杀死女王 (Kill the Queen)"
	quest.A455AC6851842809.quest_desc: ["滑道可将物品直接向下掉落，每过一个方块速度加快。", "智能滑槽可从物品栏中取物并在途中进行过滤。"]
	quest.A455AC6851842809.title: "滑道"
	quest.A6C0AE770E2678B2.quest_desc: ["用于存储网络实际保存数据的存储磁盘。", "更多驱动器，更多磁盘，更多一切。"]
	quest.A6C0AE770E2678B2.title: "磁盘驱动器"
	quest.B16E5C14B9EE6477.quest_desc: ["一个内置了合成功能的终端机。", "直接从细胞中合成出来。"]
	quest.B16E5C14B9EE6477.title: "合成终端"
	quest.B27B05606C54CE78.quest_desc: ["两个章节都以数字形式存储所有内容，你可以同时运行两者。", "Refined Storage 是适合初学者的起点：无需频道，自动化合成更简单。", "AE2 后期可扩展，但会显著增加复杂性。"]
	quest.B27B05606C54CE78.title: "Refined 还是 AE2？"
	quest.B778DC696ADFA8DF.quest_desc: ["这一排里最大的磁盘。六万五千个堆叠。", "如果这个填满了，问题就出在你身上。"]
	quest.B778DC696ADFA8DF.title: "64k 存储磁盘"
	quest.BAF2F09B27CA00FB.quest_desc: ["将世界方块直接破碎成磁盘。", "采石场们喜欢这个。"]
	quest.BAF2F09B27CA00FB.title: "毁灭者"
	quest.BF079E5D5F70A7CB.quest_desc: ["将磁盘中的方块放置到世界中。", "建筑师们更喜欢它。"]
	quest.BF079E5D5F70A7CB.title: "建造者"
	quest.C65D75DA6984ACA7.quest_desc: ["按需为网络制作配方图案。", "有了速度卡，行动更快。"]
	quest.C65D75DA6984ACA7.title: "分子组装器"
	quest.C9BC7B49CDE922D8.quest_desc: ["适用于超大型网络的基于信道的数字存储。", "控制器是心脏；给予它能量和成长的空间。"]
	quest.C9BC7B49CDE922D8.title: "Applied Energistics 2"
	quest.CD46890AE424E032.quest_desc: ["将Forge的电力输送到ME网络中。", "每个网络一个通常就足够了。"]
	quest.CD46890AE424E032.title: "能量接收器"
	quest.D003E4F1EACCC502.quest_desc: ["装置和基地之间的无线红石电路。", "一个链接发送，另一个接收，无论多远都能连通。"]
	quest.D003E4F1EACCC502.title: "红石链接器"
	quest.52EDD018CBF9952F.quest_desc: ["在战斗中击败它，然后用 Broodfruit 来安抚它。", "它会和喂养它的人建立羁绊。"]
	quest.52EDD018CBF9952F.title: "驯服大力神甲虫"
	quest.575DF7EE5C1FAA9F.quest_desc: ["他独自在埃利西亚的国王树上统治着一切。", "战斗中，他会颁布“跪下”和“不要逃跑”等法令；违反者将在三十秒内失去一半生命值。", "掉落皇家守卫装备所需的国王鳞片，以及一枚王子蛋。"]
	quest.575DF7EE5C1FAA9F.title: "杀死国王"
	quest.DA8766E1ED0AE346.quest_desc: ["将细胞库存推送到机器中。", "合成卡可以按需请求配方。"]
	quest.DA8766E1ED0AE346.title: "出口总线"
	quest.DDD4597C09415D3F.quest_desc: ["Mekanism 储罐可以容纳成桶的液体，并且可以向上升级。", "动态储罐会随多方块大小缩放。"]
	quest.DDD4597C09415D3F.title: "流体储罐"
	quest.6408726B64551FDF.quest_desc: ["孵化公主蛋，并用金色物品喂养幼崽，直到它长大。", "成年公主可以被驯服和套上鞍，并用时间膨胀场减缓敌人。"]
	quest.6408726B64551FDF.title: "公主万岁，永垂不朽"
	quest.E9AB0E1046D1ACA1.quest_desc: ["无线电力：插头为网络供电，节点从中取电。", "使用配置器将两者配置为相同的网络名称。"]
	quest.E9AB0E1046D1ACA1.title: "Flux Networks"
	quest.EB2A4A8379A30FFF.quest_desc: ["用于大型自动化的海量存储解决方案。", "每个材料网络一个单元格。"]
	quest.EB2A4A8379A30FFF.title: "64k 存储单元"
	quest.ECFD3150D2347ED6.quest_desc: ["可通过不同等级升级的单物品批量存储。", "Mekanism 区域的抽屉式存储装置。"]
	quest.ECFD3150D2347ED6.title: "Mekanism 储物箱"
	quest.EDFA7CD0DA33B6AA.quest_desc: ["将外部物品栏吸入磁盘内。", "将箭头指向你的储物空间。"]
	quest.EDFA7CD0DA33B6AA.title: "导入器"
	quest.F5C57A4FA9A9F69C.quest_desc: ["1k的十六倍。服务器级的囤积狂。", "一个磁盘可以吞下采石场的全部产出。"]
	quest.F5C57A4FA9A9F69C.title: "16k 存储磁盘"
	quest.FA383E6C8C809F46.quest_desc: ["搜索一个屏幕范围内的所有方块。", "系统的表面形态。"]
	quest.FA383E6C8C809F46.title: "ME终端"
	quest.FA65D79CD72A0D99.quest_desc: ["传送带、漏斗和滑槽让物品走风景路线，而且不耗电。", "先放一个传送带，然后用漏斗连接到箱子和机器上。"]
	quest.FA65D79CD72A0D99.title: "创建"
	quest.FEB98368A0EFA473.quest_desc: ["你的第一个磁盘：大约两千个物品。", "更大的磁盘建立在更小的磁盘之上。"]
	quest.FEB98368A0EFA473.title: "1k 存储磁盘"
	quest.FF0AC404523E7A26.quest_desc: ["搜索一个屏幕范围内的所有磁盘。", "系统的表面形态。"]
	quest.FF0AC404523E7A26.title: "网格"
	quest.3F6637C9AF032549.title: "迷你首领们"
	quest.3F6637C9AF032549.quest_desc: ["较小的恐怖生物，每种都有自己的进阶——而且大多数都会掉落大贝莎的原料。"]
	quest.520D6F3F261DDD59.title: "主世界首领们"
	quest.520D6F3F261DDD59.quest_desc: ["没有维度传送门。克拉克伦会回应鱿鱼击杀和兔子蛋；阿尔法螳螂则潜伏在主世界的螳螂领地。"]
