	quest.6A05000000000001.quest_desc: ["阅读它：整章内容都在索引里。如果未绑定“打开书本”键：选项，控制，新艺术运动。"]
	quest.6A05000000000001.title: "破旧的典籍"
	quest.6A05000000000002.quest_desc: ["法术在此组装。仅限 Tier 1 的符文。"]
	quest.6A05000000000002.title: "新手魔法书"
	quest.6A05000000000003.quest_desc: ["解锁符文——符文在此刻写，而非合成。桌上有羊皮纸，手握魔典，选择符文并支付所需物品和XP。"]
	quest.6A05000000000003.title: "抄写员工作台"
	quest.6A05000000000005.quest_desc: ["朝你注视的方向冲刺。增幅后能冲得更远。"]
	quest.6A05000000000005.title: "跳跃"
	quest.6A05000000000006.quest_desc: ["将目标向上抛出。对自己施放可垂直上升。"]
	quest.6A05000000000006.title: "启动"
	quest.6A05000000000007.quest_desc: ["将目标和方块推开。敏感模式会阻止其发射方块。"]
	quest.6A05000000000007.title: "击退效果（Knockback）"
	quest.6A05000000000008.quest_desc: ["瞄准的是你脚下方的方块，而不是你注视的方向。"]
	quest.6A05000000000008.title: "脚下深处"
	quest.6A05000000000009.quest_desc: ["应用缓慢下落效果。"]
	quest.6A05000000000009.title: "缓慢下落"
	quest.6A0500000000000A.quest_desc: ["将你瞬移到视线所及之处，无视沿途的任何障碍。"]
	quest.6A0500000000000A.title: "眨眼"
	quest.6A0500000000000B.quest_desc: ["像佩戴了鞘翅一样飞行。", "书写它会消耗一个，所以这个符文要等到末地。"]
	quest.6A0500000000000B.title: "滑翔飞行"
	quest.6A0500000000000C.quest_desc: ["在灌注室中灌注的紫水晶。最原始形态的源。"]
	quest.6A0500000000000C.title: "源宝石 Source Gem"
	quest.6A0500000000000D.quest_desc: ["源输入：青金石，源宝石和源输出。"]
	quest.6A0500000000000D.title: "附魔室 (Imbuement Chamber)"
	quest.6A0500000000000E.quest_desc: ["所有源设备的构建模块。"]
	quest.6A0500000000000E.title: "源石（Sourcestone）"
	quest.6A0500000000000F.quest_desc: ["持有附近机器的源材料。"]
	quest.6A0500000000000F.title: "源 Jar 文件"
	quest.6A05000000000010.quest_desc: ["手持合成所需的物品。它们必须在装置3格范围内。"]
	quest.6A05000000000010.title: "神秘祭坛 (Arcane Pedestals)"
	quest.6A05000000000011.quest_desc: ["加载基座，然后将中间的物品用于该装置上。"]
	quest.6A05000000000011.title: "附魔装置 Enchanting Apparatus"
	quest.6A05000000000012.quest_desc: ["必须紧贴装置底座，否则无法合成任何东西。"]
	quest.6A05000000000012.title: "Arcane Core"
	quest.6A05000000000013.quest_desc: ["按住跳跃键可上升和悬停。漂浮期间会持续消耗法力。"]
	quest.6A05000000000013.title: "漂浮腰带 (Belt of Levitation)"
	quest.6A05000000000014.title: "Jar of Light"
	quest.6A05000000000015.quest_desc: ["法术更便宜，这样每格法力能飞得更远。"]
	quest.6A05000000000015.title: "小折扣戒指 (Ring of Lesser Discount)"
	quest.6A05000000000016.quest_desc: ["提高你的法力上限。"]
	quest.6A05000000000016.title: "法力增幅护身符"
	quest.6A05000000000017.quest_desc: ["仪式在此运行：一个石板加上放置在周围的试剂。"]
	quest.6A05000000000017.title: "仪式祭坛"
	quest.6A05000000000018.quest_desc: ["爆发式创意飞行 - 跳跃开始，靠近时刷新。从附近的罐子中饮用源。"]
	quest.6A05000000000018.title: "飞行仪式"
	quest.6A05000000000019.quest_desc: ["将火盆附近的所有物品移动到卷轴上的位置，卷轴必须先被刻写。"]
	quest.6A05000000000019.title: "扭曲仪式 (Ritual of Warping)"
	quest.4A0E000000000001.quest_desc: ["可找到最远三万格外的结构。", "这是追踪首领巢穴最简单的方法：国王之树、恐怖竞技场、巨蜥巢穴和废墟竞技场。", "在巨龙死亡前无法合成。"]
	quest.4A0E000000000001.title: "探险家指南针"
	quest.6A0500000000001A.quest_desc: ["第二层：更多法力，更快的再生，并开启第二层符文。升级会保留你已学习的符文。"]
	quest.6A0500000000001A.title: "法师的魔法书"
	quest.6A0500000000001B.quest_desc: ["第三层，最大的法力池和最快的再生速度，也是唯一能开启第三层符文的书籍。"]
	quest.6A0500000000001B.title: "大魔导师的魔法书"
	quest.6A0500000000001C.quest_desc: ["在15格范围内由作物和树木生长生成源。骨粉不算在内。"]
	quest.6A0500000000001C.title: "农业学源链接 Agronomic Sourcelink"
	quest.6A0500000000001D.quest_desc: ["将附近的食物转化为源，源浆果食物比普通食物价值高得多。"]
	quest.6A0500000000001D.title: "菌丝体来源链接"
	quest.6A0500000000001E.quest_desc: ["燃烧可燃烧物品以获取源：Archwood原木有额外奖励，Blazing Archwood最多。"]
	quest.6A0500000000001E.title: "火山源链接 Volcanic Sourcelink"
	quest.6A0500000000001F.quest_desc: ["从相邻的药水罐中饮用药水。复杂的药水报酬更高。"]
	quest.6A0500000000001F.title: "炼金术源链接 (Alchemical Sourcelink)"
	quest.6A05000000000020.quest_desc: ["通过附近的生物死亡和动物繁殖来制造源。"]
	quest.6A05000000000020.title: "Vitalic 来源链接"
	quest.6A05000000000021.quest_desc: ["会消耗饥饿值，并且会伤害不死生物，而不是治愈它们。"]
	quest.6A05000000000021.title: "治疗"
	quest.6A05000000000022.quest_desc: ["适用于世界中的方块，而不仅仅是物品。"]
	quest.6A05000000000022.title: "熔炼"
	quest.6A05000000000023.title: "收获"
	quest.6A05000000000024.quest_desc: ["放在方块上会留下永久光源；放在自己身上会获得夜视效果。"]
	quest.6A05000000000024.title: "施展魔法之光照明术"
	quest.6A05000000000025.quest_desc: ["提升大多数效果的强度，以及挖掘工具的挖掘等级。"]
	quest.6A05000000000025.title: "Amplify"
	quest.6A05000000000026.title: "AOE"
	quest.6A05000000000027.quest_desc: ["仅在 Projectile 上有效：投射物击中后仍能继续飞行并再次命中。"]
	quest.6A05000000000027.title: "穿刺伤害提升，使武器造成的伤害增加 20%。"
	quest.6A05000000000028.quest_desc: ["短暂保留右侧的效果。延长时长会拉长等待，缩短时长则会缩短等待。"]
	quest.6A05000000000028.title: "延迟"
	quest.6A05000000000029.title: "延长游戏时间"
	quest.6A0500000000002A.quest_desc: ["被伤害击杀的实体和用破坏工具破坏的方块会掉落更多。不可与提取叠加。"]
	quest.6A0500000000002A.title: "幸运值"
	quest.6A0500000000002B.quest_desc: ["女巫在生命值减半时会消失，留下一个Wixie碎片，而你的召唤物会返回它们的护身符。"]
	quest.6A0500000000002B.title: "驱散魔法效果"
	quest.6A0500000000002C.quest_desc: ["树叶目标会受惊，使下一次闪电更猛烈，可叠加至 III 级。"]
	quest.6A0500000000002C.title: "闪电"
	quest.6A0500000000002D.quest_desc: ["法力充足时，箭矢会对其命中的任何目标施放铭刻的魔法。"]
	quest.6A0500000000002D.title: "附魔师的弓"
	quest.6A0500000000002E.title: "法力再生护身符"
	quest.6A0500000000002F.quest_desc: ["比小戒指更有效地降低法术消耗，并保留少量法力值和再生加成。"]
	quest.6A0500000000002F.title: "更高级折扣戒指"
	quest.6A05000000000030.quest_desc: ["配置源中继器并绑定信使：先对源使用，再对目标使用。潜行使用可清除连接。"]
	quest.6A05000000000030.title: "Dominion Wand"
	quest.6A05000000000031.quest_desc: ["用魔杖指着箱子让它递送，用魔杖指着箱子让它收集。"]
	quest.6A05000000000031.title: "星团魅力 (Starbuncle Charm)"
	quest.6A05000000000032.quest_desc: ["在不伤害周围怪物和动物的情况下，通过它们的掉落物和经验宝石进行农场化。"]
	quest.6A05000000000032.title: "干地格米护身符"
	quest.6A05000000000033.quest_desc: ["定时繁殖附近的动物，当范围内有二十只时停止。"]
	quest.6A05000000000033.title: "丰饶仪式"
	quest.6A05000000000034.quest_desc: ["骨粉撒在火盆周围；骨块增效器会生长出小动物。"]
	quest.6A05000000000034.title: "过度生长的仪式"
	quest.6A05000000000035.title: "日出仪式"

	quest.1677FB65E0EE4DF9.title: "磁石升级"
	quest.1677FB65E0EE4DF9.quest_desc: ["将掉落物从远处吸向箱子。", "与漏斗堆叠以实现全自动操作。"]
	quest.3FDCEC14022469F5.title: "喂食升级"
	quest.3FDCEC14022469F5.quest_desc: ["会替你吃掉箱子里的食物。", "床旁边的一个厨房箱子。"]
	quest.46F3E981F6E5F083.title: "压缩升级组件"
	quest.46F3E981F6E5F083.quest_desc: ["在箱子内自动将锭合成方块，或将方块合成锭。", "保存了整个墙壁的制作配方。"]
	quest.35AF776078BDEE51.title: "物品堆叠升级器"
	quest.35AF776078BDEE51.quest_desc: ["将每格的堆叠上限大幅提高，远超64。", "四个等级，每个等级都乘以上一个等级。"]
	quest.7883FA1F55A9A03E.title: "远程合成台 Crafting Remote"
	quest.7883FA1F55A9A03E.quest_desc: ["随时随地浏览和请求网络内容。", "首先需要请求平板电脑。"]
}