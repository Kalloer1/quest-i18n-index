	quest.17F4F29724C50E2F.quest_desc: [
		"{image:minecraft:item/emerald width:25 height:25 align:1}"
		""
		"&l商人&r"
		""
		"&eTrader&r方块让你能轻松地在单个方块内与村民交易并更改其职业。制作一个并放置在地面上。获取一个&eVillager&r（物品），&5Shift + 右键&r点击&eCrafter&r将其放入，并添加一个职业方块（如讲台、制图台等），同样通过&5Shift + 右键&r完成。然后右键点击交易者，与村民进行交易！"
	]
	quest.1942667FACF91CBB.quest_desc: [
		"{image:ftbchunks:textures/faces/minecraft/blaze.png width:25 height:25 align:1}"
		""
		"&l烈焰人燃烧器&r"
		""
		"烈焰熔炉用于在&e盆&r中熔炼金属和其他材料以便混合。用&e空烈焰熔炉&r右键点击烈焰人或烈焰人刷怪器即可制作。将其放置在&e盆&r底部，并用易燃物品右键激活。"
	]
	quest.1A16340E1EEB4103.quest_desc: ["此物品将允许你引爆流体运输技术。"]
	quest.1B53A298A5E57511.quest_subtitle: "请思考这些物品，以了解它们的使用方法。"
	quest.1B62D0629C00B92B.title: "构造函数和析构函数"
	quest.1BD2EBE6ED729953.title: "是时候看电影了！"
	quest.1C050306B94BE199.quest_subtitle: "请思考这些物品，以了解它们的使用方法。"
	quest.1C24D3AFD0CDB49A.title: "解锁简易村民模组（Easy Villagers Mod）"
	quest.1C3E729E83B7BC49.quest_desc: [
		"{image:create:block/sail/canvas_white width:25 height:25 align:1}"
		"                    "
		"&l风车&r"
		""
		"将风车轴承放置，在其上方放一个方块，两侧（北、东、南、西）放上风车叶片，然后用空手右键点击轴承即可创建风车。速度"
		"风车的容量及其 SU 容量有关。"
		""
		""
		"{image:create:item/clipboard_and_quill width:25 height:25 align:1}"
		""
		"&l什么是SU？&r"
		"SU 是衡量旋转动力输出块负载的单位。给真实电机过载，它会停止。Create 也是如此。所有机器都使用旋转动力，如果连接太多机器或需要太多 SU 的机器，你的发电机及所有连接机器都会停止。"
	]
	quest.1C3E729E83B7BC49.title: "风车"
	quest.1C4475B21749D3C1.quest_subtitle: "右键扳手可配置。显示火车状态，就像真实车站一样。有更多变种。请在JEI中查看。"
	quest.1C6A64B5E57AEF12.quest_desc: [
		"{image:minecraft:block/emerald_block width:25 height:25 align:1}"
		""
		"&l自动交易机&r"
		""
		"&e自动交易机&r就像&e交易员&r一样，但它会自动交易（废话）。"
		"将&eVillager&r和职业方块放入其中，就像普通的&eTrader&r一样。之后，&5右键&r&eAuto Trader&r，并用箭头选择一个配方进行自动交易。然后将用于交易的物品放入输入物品栏中，一段时间后，物品就会出现在输出物品栏中。"
	]
	quest.1C9007DCAB705954.quest_subtitle: "加载最多5个区块。查看说明以了解用法。"
	quest.1CC25E341194684B.quest_desc: ["你也可以使用TFMG或Create泵，但这个泵支持升级。"]
	quest.1D8517F429D71136.quest_desc: [
		"放置一个 &eMachine Input&r，并在其上方放置一个 &eSurface Scanner&r。 &eSurface Scanner&r 应该会照亮含有石油的区域。"
		""
		"&lNote: Some machines, most notably the &eSurface Scanner&r &land&r &ePumpjack&r &lrequire machine inputs. If a machine does not have an input, but logically it should, most likely it requires a&r &eMachine Input&r&r"
	]
	quest.1D8517F429D71136.title: "正在寻找石油"
	quest.1EAC175295655B37.quest_subtitle: "Mekanism 的核心矿石。"
	quest.1FC8886A7A2FC0F4.title: "色彩缤纷的飞轮"
	quest.1FC9F622BCBBBABE.quest_subtitle: "研究物品以了解其运作方式。"
	quest.1FD9F2A194EAFAE8.title: "启用模组"
	quest.1FF3D6F20F78D73E.quest_desc: ["大多数机制机器都有自带的描述，按 SHIFT + N 查看，或由本整合包添加的 Ponder 或其他功能提供。请经常查看这些信息。另一个重要功能是查看机器支持的配方。可以通过点击机器 GUI 中的进度条来实现。Mekanism 的进度条有多种形状和大小，请务必在界面中查找“显示配方”的提示。"]
	quest.1FF9BDA023FBC7B5.quest_subtitle: "注意：其他树叶类型的树篱也可以使用。请查看 JEI。"
	quest.2057050A6F520018.quest_desc: ["用9个&eArtifact Shards&r制作一个&eUnidentified Artifact&r。将Artifact和刷子放入&eArcheology Table&r中。这样就能将&eUnidentified Artifact&r变成&eIdentified Artifact&r，也就是一个真正的物品。"]
	quest.2057050A6F520018.title: "鉴定古代遗迹物品"
	quest.20C9F458A67760C5.quest_desc: [
		"Mekanism 的 Configurator 用于编辑不同物品的属性。"
		"要更改配置器的模式，请手持配置器并按 Shift + 右键。它有许多不同模式，例如：能量、流体、物品。"
		""
		"要使用配置器，只需右键单击即可。"
		"一个简单的方法，也是通用电缆基础版所需的方法，是将它们的供电模式从默认改为推或拉，这样就能向电缆未指向的方块供电，或者从该方块取电。"
	]
	quest.20DBD3D74B2932CE.quest_subtitle: "注意：其他木材类型的大门也可以使用。请在JEI中查看。"
	quest.20DBD3D74B2932CE.title: "橡木大门"
	quest.20F2B4910BD3258B.quest_desc: [
		"{image:create:item/iron_sheet width:25 height:25 align:1}"
		"&l机械压榨机&r"
		""
		"机械压机可将金属锭制成用于制作的金属片。试试用本次任务的铁来完成。将机械压机放在离地板3格高的位置，将货箱放在地板上。手持铁锭，右键点击货箱，等待它们变成金属片，再右键点击货箱即可取回。"
	]
	quest.214F7ABAAD431F1F.quest_desc: ["阻止附近的所有装置运行"]
	quest.2225BE8E21E39F83.title: "模组解锁"
	quest.2285E94729E84786.quest_desc: [
		"&c&l警告&r&r"
		"此模组需要电力！"
	]
	quest.2285E94729E84786.title: "解锁模组。"
	quest.23AF89C44BC68429.quest_desc: [
		"扬声器使用以下命令："
		""
		"playNote(instrument [, volume [, pitch]])"
		"playSound(name [, volume [, pitch]])"
		"播放音频(audio [, 音量])"
		"stop()"
	]
	quest.23F7C2B41BBC6305.title: "铜制锭块"
	quest.240C475DD90E0B32.quest_desc: [
		"FTB Ultimine 用于同时挖掘多个方块，速度更快，但会消耗比平时更多的耐久度。"
		"要启用 FTB Ultimine，按住 ，然后挖掘。要选择 FTB Ultimine 的模式，按住 ，再按住 Shift，然后滚动。"
	]
	quest.2554BA98B24A05D7.quest_subtitle: "使烈焰附魔台过热，使其能超级附魔物品"
	quest.25F4A037D7CE81E2.quest_subtitle: "遵循思考。生产焦炭，用于制造钢铁。"
	quest.2614637DBD24E578.title: "不同类型的灯光"
	quest.26203B951C25EAF7.quest_desc: ["&e化学注入器&r的工作很简单也很重要，就是混合化学品。例如，矿物倍增器所需的氢氯酸。这个在热蒸发装置页面已经写过，但以防你没读过，需要把其中的卤水通过电解分离器来得到氯气！钠是副产品，这里用不到。你还需要把之前电解分离器产生的氢气通过管道输送过来。名字里就有氢氯酸，所以需要氢气和氧气。"]
	quest.264FF8E455C117E2.quest_desc: ["用于煎炸食物。"]
	quest.269090D50F2844D1.quest_desc: ["用于将金属与其他材料融合。点击进度条可查看配方。"]
	quest.26B3524A47611C16.quest_desc: ["比普通海龟更高级的版本。"]
	quest.26FA8C8CDF88BE80.quest_subtitle: "火车站的火车，分针是秒针，时针是分针。"
	quest.277B8E9305092FD7.quest_subtitle: "在 JEI 中查看坚固金属板的配方。"
	quest.27C44BA3FF9AB73F.quest_subtitle: "注意：本章所有装置均可进行思考。请参考其思考提示和 JEI 以获取帮助。"
	quest.27C44BA3FF9AB73F.title: "解锁模组"
	quest.284123D1D35FE83E.quest_desc: ["你已完成 WorkLoad 整合包！暂时先到这里 >:). 等待更新以获取更多内容、续篇等！你的最终挑战是自动化游戏中的每一件物品，并制作所有盔甲修饰的变体！"]
	quest.2845D5D205CFC943.quest_desc: ["比其他解决方案更先进的区块加载器，允许你选择要加载的特定区块和加载时间。"]
	quest.2845D5D205CFC943.quest_subtitle: "正在更高效地加载区块！"
	quest.28FEFB505B83C075.quest_desc: [
		"要使用此物品，您需要启用语音服务器。为此，加入您的世界或服务器（专用服务器需要OP权限），点击创建模组护目镜，点击配置，访问其他模组的配置，Mekanism: Additions, Voice, Enable Voice Server, Enabled -> Yes。"
		""
		"手持物品时，Shift+右键即可开启。"
		"按住物品并按 Shift + M 以更改频率。"
		"按住 (默认 U) 键交谈。"
	]
	quest.290B12B9BA8FBF92.quest_desc: [
		"电位计是一种可变电阻器，带有一个用于选择输入功率百分比的调节器。"
		"二极管只允许从特定方向推动和拉动电力。"
	]
	quest.290B12B9BA8FBF92.title: "电位器 \& 二极管"
	quest.2996DDC55085C313.quest_subtitle: "注意：其他木材类型的桌子也可以使用。请在JEI中查看。"
	quest.2AAB51FEEAEE977F.quest_desc: ["高级计算机是一台支持彩色输入和更多外围设备的计算机"]
	quest.2B22D5D19A78816C.quest_desc: [
		"{image:minecraft:item/leather width:25 height:25 align:1}"
		""
		"&l背包&r"
		""
		"背包是一个非常实用的物品，尤其是在游戏后期。你可以像用箱子一样把物品放进去，也可以把它背在身上，放在背包的奇物槽里（点击物品栏中皮肤旁边的小白圈即可打开），并为它装上实用的升级！制作一个背包，看看它怎么用吧！"
	]
	quest.2B682248A97B8C47.quest_subtitle: "研究物品以了解如何使用它。"
	quest.2BCAD1E79115DFFB.quest_desc: [
		"{image:betterarcheology:block/archeology_table/archeology_table_side width:25 height:25 align:1}"
		""
		"&l木材农场&r"
		""
		"这将是你最早制作的装置之一！它能自动为你采集木材！设置一个旋转动力源，并按照 Create WIKI (https://create.fandom.com/wiki/Tutorials/Tree_Automation) 的教程、在网上搜索教程或自己摸索完成。祝你好运！"
	]
	quest.2BCAD1E79115DFFB.title: "木材农场"
	quest.2C14FFCC9FFC111F.quest_subtitle: "化学溶解室（见下一个任务）产生的矿石浆液是脏的且无法使用，需要用此方块进行净化。"
	quest.2CC424EE1CDD63C8.quest_subtitle: "将物品存入物品栏。放置于升级槽中。"
	quest.2DC5BC196368304D.quest_desc: [""]
	quest.2E03938A20B1F8C0.title: "启用模组"
	quest.2E18A7F7587B029D.quest_desc: ["字面意义上重构物品的原子。输入气体形式的反物质和物品，重新排列其原子并输出。最显著的配方是将煤炭变成钻石。将鼠标悬停在物品上，点击 U 查看其其他配方。"]
	quest.2E5580052B3D9D3D.quest_desc: [
		"&l水车&r"
		""
		"水车是一种快速廉价的动力装置，适用于不需要大量SU单位的机械。建造一个5x5的方块，中心放水车，在角落放水，最后放置一个方块，使水流单向流动，从而驱动水车旋转。"
		""
		"&n有趣的事实&r"
		"你可以用木板右键点击水车来改变它的木材类型！"
		""
		"&l什么是SU？&r"
		"SU 是衡量旋转动力输出块负载的单位。给真实电机过载，它会停止。Create 也是如此。所有机器都使用旋转动力，如果连接太多机器或需要太多 SU 的机器，你的发电机及所有连接机器都会停止。"
	]
	quest.2E5F0D3AF0CCD94E.title: "启用模组"
	quest.2E8AD20BBCC879D9.quest_subtitle: "注意：不同金属的走道可供选择。请在JEI中查看。"
	quest.2FA49437D633F9DF.title: "已启用 Create Mod Base Game Mods"
	quest.2FBA8E6F3182ADE3.quest_desc: [
		"{image:create:item/andesite_alloy width:30 height:30 align:1}"
		"&l安山合金&r"
		""
		"安山合金是创造模组及其扩展包的主要合成材料之一。如你所知，它由锌和安山岩合成。合成一些，然后继续完成任务吧。"
	]
	quest.2FD536ECD3A77C53.title: "高效采矿"
	quest.304400E759589E4C.quest_desc: ["无线调制解调器的进阶版，射程更远，还支持GPS功能"]
	quest.308EB3AFCD3EEB61.quest_subtitle: "查看沉思以了解此物品的运作方式。"
	quest.30ECA26BB21CF5A6.quest_desc: ["将原始矿石加倍转化为粉尘，但会消耗能量。"]
	quest.31E80B9733E6F8FB.quest_desc: [
		"Mekanism 的 Configurator 用于编辑不同物品的属性。"
		"要更改配置器的模式，请手持配置器并按 Shift + 右键。它有许多不同模式，例如：能量、流体、物品。"
		""
		"要使用配置器，只需右键单击即可。"
		"一个简单的方法，也是通用电缆基础用法所需，就是将它们的供电模式从默认改为推或拉，这样就能向电缆未指向的方块供电，或者从该方块取电。"
	]
	quest.32EDFEC8320957D9.quest_desc: ["更快、更高效的冶金注入器。还有其他工厂，建议查看 JEI。"]
	quest.331B122C30E7638A.quest_desc: [
		"要将摄像头连接到显示器，请打开摄像头，用远程磁盘右键点击它，然后打开显示器并右键点击它。"
		""
		"相机控制："
		"X - 退出相机"
		"滚动 - 缩放（在支持的相机上）"
	]
	quest.339C2719AC08D16F.quest_subtitle: "右键点击火车司机以绑定。右键点击可从司机的视角观察。"
	quest.33A8CB20406B319A.title: "支持性元素"
	quest.33AF256F1100FC5B.quest_desc: [
		"{image:create:block/fan_blades width:25 height:25 align:1}"
		""
		"&lEncased Fan&r"
		""
		"&eEncased Fan&r 可用于空气或流体（如水或岩浆）来加工物品。试着在 &eEncased Fan&r 前放置岩浆，并将 &eRaw Iron&r 投入气流中，将 &eRaw Iron&r 熔炼成 &eIron Ingot&r，或者在风扇前放置水，从砾石中获得 &eFlint&r 和 &eIron Nuggets&r。"
		""
		"&l喷嘴&r"
		""
		"&e喷嘴&r将空气向所有方向输送。"
	]
	quest.34003FE4EE454A1F.quest_desc: [
		"&l如何防止玩家偷窃你的背包物品&r"
		""
		"默认情况下，当佩戴Sophisticated Backpacks时，其他玩家可以右键打开你的背包。要禁用此功能，请打开背包，点击齿轮图标，然后点击“其他玩家可以打开”按钮，将其改为“其他玩家不可以打开”。"
	]
	quest.353C861E3ED15AD2.quest_desc: ["观察者电压，当然啦"]
	quest.355269B3A55EC8D6.quest_desc: ["Seismic Virbator 可以振动一个区块，而 Seismic Reader 可以在区块振动时显示其中的方块和矿石。"]
	quest.35C3B4E0ECF85E49.quest_desc: [
		"{image:minecraft:item/bread width:25 height:25 align:1}"
		""
		"&lBreeder&r"
		""
		""
		"&eBreeder&r 能让你轻松繁殖 &eVillager&r。将2个村民和食物放入输入物品栏，一段时间后，&eBaby Villager&r 就会出现在另一个栏位中。"
	]
	quest.374F30C8D34CB54D.quest_desc: ["高级存储网络。在QIO驱动阵列中，设置隐私模式并命名频率，然后点击勾号再点击设置。将你的QIO驱动放入QIO驱动阵列。放置QIO仪表盘并选择频率，这将把所有东西连接起来。里面还有一个合成台！"]
	quest.3827747FD5B12EF9.quest_desc: ["此结构的地图可从&e矿井&r的&e地图&r处获取，或由&e制图师&r提供。"]
	quest.382AE5E81302C706.quest_subtitle: "注意：可用其他羊毛类型制作椅子。请在JEI中查看。"
	quest.385CD646607BF22E.quest_desc: [
		""
		"{image:everycomp:block/abnww/ecologics/azalea_bookshelf width:100 height:100 align:center}"
		""
		"要自动化烹饪，右键点击&eCooking guide&r，并放置所需食谱的材料。放置一个&eBlaze burner&r，然后用&eCooking guide&r按住Shift+右键点击它。将&eCooking Pot&r放在&eBlaze Burner&r和装有食谱所需物品的&eDepots&r上。将Depots设为输入，烹饪锅设为&eMechanical Arm&r的输出，然后放置它。"
	]
	quest.385CD646607BF22E.title: "自动化烹饪系统"
	quest.389266D72873CEE8.quest_subtitle: "注意：其他木材类型的屋顶也可以使用。请在JEI中查看。"
	quest.38A48BF870D6503C.quest_subtitle: "便携式传送石 (Portable Waystone)"
	quest.38D161E20618DDBE.quest_desc: ["允许多人通过在存款箱或售货机中放置共同所有者的ID卡来经营一家商店。"]
	quest.3980F1CFCE607750.quest_desc: [""]
	quest.3980F1CFCE607750.title: "远古残骸"
	quest.3989C3C82EB9120B.title: "泛光灯"
	quest.39A6ECF3F609303B.quest_desc: ["原始洞穴提供史前体验"]
	quest.3A900FBE64625A65.quest_desc: ["几乎所有机器都可以应用升级。在JEI中搜索升级以查看其他选项，有很多有用的升级！"]
	quest.3A900FBE64625A65.title: "升级内容"
	quest.3A96B25BB468CB09.quest_desc: [
		"&l查看此物品的沉思以了解其运作方式。&r"
		"全新高物流更新的基础方块。它允许你将物品放入纸板包装中。"
	]
	quest.3AEFC1A054FE0A99.quest_desc: [
		"{image:numismatics:item/coin/cog width:25 height:25 align:1}"
		"&l速度表&r"
		""
		"应力计用于检查装置的负载（SU）。将其连接到旋转动力源，佩戴&6&e工程师护目镜&r&r，即可查看装置的负载（SU）！"
	]
	quest.3CFF02FCC550C89B.quest_subtitle: "请思考这些物品，以了解它们的使用方法。"
	quest.3D25AF9E81F9CBBB.quest_desc: [
		"接下来的任务将引导你建造裂变核反应堆。第一步是建造同位素离心机，用于制造裂变燃料。"
		"查看 JEI 或 https://wiki.aidancbrady.com/wiki/File:Production_fissile_fuel.png 获取裂变燃料的生产线（相信我，我试过把图片放这里，但 FTB Quests 有限制）。"
	]
	quest.3D319AA922F54728.quest_subtitle: "无法超热的烈焰燃烧器的替代方案。"
	quest.3D561F316A656E6F.quest_subtitle: "注意：有不同材料制成的压轮和磨坊可供选择。请在 JEI 中查找。"
	quest.3D561F316A656E6F.title: "装饰的冲绳车轮和风车"
	quest.3E2CDDBFA7F511F2.quest_subtitle: "来自有毒洞穴的辐射方块"
	quest.3E2CDDBFA7F511F2.title: "Hazmat Suit"
	quest.3EEDC2100F54ADB0.quest_subtitle: "查看此多区块的沉思。将其输出接入电解分离器，将电解分离器中的钠存入存储，并将同一区块中的氯接入任务链的下一个区块。"
	quest.3EEDC2100F54ADB0.title: "热蒸发植物工厂"
	quest.3FBE56714F820EC2.quest_desc: ["Robit 是 Mekanism 的机械伙伴。它可以充当合成台、熔炉、铁砧、箱子，或者只是一个可爱的小伙伴。它免疫火焰，包括火焰喷射器。要放置 Robit，请手持物品并将其放在 Chargepad 上。这将设置 Robit 的家，它可以传送回那里。要查看所有功能，只需右键点击它。在那里，你还可以设置名称和跟随模式！"]
	quest.40385EFF1D5DCD41.quest_desc: ["与安山岩矿床相同，但可以接受卡片。"]
	quest.40C1B3DD04573420.title: "钚燃料棒"
	quest.4199735E51E9BD1A.quest_subtitle: "请思考这些物品，以了解它们的使用方法。"
	quest.42BBAECEF32CD491.title: "解锁模组。"
	quest.42F3EFF22D5A862B.quest_subtitle: "请思考这些物品，以了解它们的使用方法。"
	quest.431816D327169897.quest_desc: ["袖珍计算机是普通计算机的一种更小、更便携的变体。"]
	quest.432DF61E42EBE188.title: "启用模组"
	quest.449687E965571B40.quest_desc: [
		"磁盘驱动器是一种外设，可以让你读写软盘和其他“可挂载介质”（如计算机或海龟）。它们还可以让你播放唱片。"
		""
		"当磁盘驱动器连接某个介质（如软盘或计算机）时，它会将名为 disk、disk2 等的文件夹连接到计算机的根目录。该文件夹可用于与该磁盘上的文件进行交互。"
		""
		"(信息复制自 https://tweaked.cc/peripheral/drive.html)"
	]
	quest.44C2DAA1FED759C9.quest_desc: [
		"{image:numismatics:item/coin/cog width:25 height:25 align:1}"
		"&l速度表&r"
		""
		"速度计用于检查装置的转速。将其连接到旋转动力源，戴上&6&e工程师护目镜&r&r，就能看到装置的转速了！"
	]
	quest.44D8780CE68E5FA0.quest_desc: ["将钚丸放入化学注射室，再将产物放入化学氧化器以制造裂变燃料，这样就能仅用水和萤石粉制造裂变燃料，便宜多了！"]
	quest.44D8780CE68E5FA0.title: "回收钚元素 Recycling Plutonium"
	quest.4695E09AABBBA3F9.quest_subtitle: "请思考这些物品，以了解它们的使用方法。"
	quest.46C42FF70EC6B1AE.quest_subtitle: "允许你将背包放入背包中。放置在升级槽中。"
	quest.470501DA67B46751.quest_desc: ["当你访问古代遗迹时，可能会发现可疑方块（如&e可疑沙砾&r）或古代花瓶。如果你铲掉沙砾或打破花瓶，可能会找到&e文物碎片&r。"]
	quest.470E5E7F5B56CA48.quest_desc: ["将不同物品堆叠，例如将铅碎片堆叠成铅块，使其变大。这是一个二级矿石堆叠器（遵循流程图）"]
	quest.475739596C9F8EDF.quest_desc: ["将重水放入电解分离器中即可制作"]
	quest.478ABE8394F310DD.title: "铁器时代"
	quest.48115D8C0F23EEBE.quest_desc: ["Create: Copycats+ 模组添加了多种复制方块，让你能将现有方块变成完全不同的东西！在 JEI 中查找吧！"]
	quest.483BF78BBB91E99C.quest_desc: ["工作原理与打包机相同。注意：物品仓库无法存储流体。您需要为每种流体准备一个流体储罐，并使用智能管道进行分类。"]
	quest.48574CB2DCE492E9.title: "启用模组"
	quest.486B34565ECECE35.quest_desc: ["将物品粉碎成碎片。"]
	quest.4887464E545B08E0.quest_subtitle: "用法教程请参见 ponder 的说明"
	quest.4887464E545B08E0.title: "在锻造台里制作一个烈焰人附魔师"
	quest.48CCB82C0D7784F6.quest_desc: [
		"{image:create:item/package/cardboard_particle width:45 height:45 align:center}"
		""
		"&l请查看此物品的沉思，了解更多信息以了解如何使用它！&r"
		""
		"来自 Create 0.6.0 更新的物流系统！"
		"你发现的第一个物品，链式传送带，可以移动包裹中的物品（随着物流任务的推进，你会明白的），还能移动你自己！右键链式传送带即可了解其工作原理。"
	]
	quest.48D4CA8B848C4489.quest_subtitle: "删除过滤器中的物品。放置在升级槽中。"
	quest.48EB6E4F27D15899.quest_desc: [""]
	quest.48EB6E4F27D15899.quest_subtitle: "制作一个 Pickarang"
	quest.48EB6E4F27D15899.title: "远程采矿！Mining from a Distance!"
	quest.49AECEB99E110CD7.quest_desc: ["数字矿工可在地表自动挖掘物品。为其提供能量，然后右键点击以打开配置界面。点击配置按钮，即可设置要挖掘的物品。可以通过设置物品堆叠、模组ID或标签来完成。在同一配置菜单中，你还可以设置最小Y坐标、最大Y坐标以及挖掘半径。请根据所挖掘的物品设置这些值。"]
	quest.4A8A19F6C09CD31E.title: "启用模组"
	quest.4A9650277B16EE9E.quest_desc: [
		"{image:create:item/minecart_contraption width:25 height:25 align:1}"
		""
		"&l矿车装置&r"
		""
		"矿车装置用于移动安装在矿车上的创造装置和方块。要制作矿车装置，先在地面上放置一个&e控制器轨道&r，然后在轨道上放置&e矿车组装器&r和&e矿车&r。之后，在矿车组装器上放置方块，用&e强力胶水&r将它们粘合，最后用红石信号（如杠杆或按钮）激活&e矿车组装器&r，并为矿车铺设轨道。"
	]
	quest.4A9650277B16EE9E.title: "Minecart Contraptions"
	quest.4B9B91F66654D273.quest_desc: [
		"{image:minecraft:item/wheat width:25 height:25 align:1}"
		""
		"&l磨石&r"
		""
		"&e磨石&r用于加工食物，例如将小麦磨成面粉，用于制作面团和面包。要加工物品，可用漏斗或滑道将物品放入顶部，或使用漏斗或滑道从底部取出。"
	]
	quest.4BA5E726C16A4F5B.quest_subtitle: "请思考这些物品，以了解它们的使用方法。"
	quest.4BF753D49387CA02.quest_desc: [
		"{image:create:item/whisk width:25 height:25 align:1}"
		"&l机械搅拌机&r"
		"机械搅拌机用于将金属和液体混合成新物品，运行时需要30 RPM的速度。"
	]
	quest.4C1EBAEDF264B733.quest_desc: ["要让硬币有实际价值，你需要抛光它们。抛光和清洗一样，用风扇和水即可完成。"]
	quest.4C1EBAEDF264B733.title: "抛光货币抛光中"
	quest.4C20CB764530B345.quest_subtitle: "可容纳更多物品。"
	quest.4D09FCD7B6AF84F8.quest_desc: [
		"{image:create:item/crushed_raw_gold width:25 height:25 align:1}"
		""
		"&lCrushing Wheel&r"
		""
		"&eCrushing Wheel&r用于处理物品，可将金属制成的物品回收。将一对轮子并排放置，在下方方块上放置&eConveyor Belt&r，并使轮子向内旋转。为&eConveyor Belt&r供电，使其将物品送入&eCrushing Wheels&r。"
	]
	quest.4D2A91B49B1496FF.title: "卡牌"
	quest.4E5BF9176D2A5A00.quest_subtitle: "研究火车站，了解如何制作火车。组装前别忘了把火车的每个方块都粘好！"
	quest.4E5BF9176D2A5A00.title: "正在制作一辆火车！"
	quest.4E846CC09161CF44.quest_desc: [
		"&l齿轮箱&r"
		"齿轮箱可从任意一根轴接收旋转动力，并将其传输至另外3根轴，从而改变旋转动力的方向。它也有垂直版本，适用于上下弯曲。"
	]
	quest.4EDA5020075C65CE.title: "工业涡轮机"
	quest.4F3EE462761EB4C5.quest_desc: ["如果你在多人游戏服务器中，并且管理员已启用该功能，你将可以使用语音聊天。按 V 键进行配置。在那里，你可以选择使用按键说话、全开麦克风或其他选项。"]
	quest.4FB60BD3172E66E2.title: "数字管显示和交通信号灯"
	quest.504CC6EB4E6EB8D5.title: "我们的事业才刚刚开始！"
	quest.50A63668D321CE8C.quest_desc: [
		"只是一个使用电力的熔炉而已。"
		"注意：接下来的几个任务将教你如何制作 MONSTOROUS 矿石倍增器，请遵循 https://wiki.aidancbrady.com/w/images/aidancbrady/a/a2/Mekanism-flowchart-v7-simplified.png 上的流程图"
	]
	quest.50EF7BE79EF7AD99.quest_subtitle: "将泥浆液体类型转换回固体物体，例如将干净的铅泥浆转换为铅晶体"
	quest.50F71BAF58D7B1A3.quest_desc: [
		"要制作潜艇，请在3x3的方格里放置1层铜块。"
		"然后，在第二层的中心放置一个 Enigmatic Engine。"
		"在 Enigmatic Engine 周围放置铜，但不要放在最前面一层，那里需要用 Depth Glass 制作窗户。在第三层重复同样的操作，但不要放置 Enigmatic Engine。这样潜艇就建造完成了。"
	]
	quest.50F71BAF58D7B1A3.title: "潜水艇"
	quest.51E4C62218C11181.quest_desc: ["你需要生产硫酸。更多信息请查看 JEI 或矿石倍增器图表。"]
	quest.51E4C62218C11181.title: "硫酸 (Sulfuric Acid)"
	quest.526990DDCB66DBFE.quest_desc: [""]
	quest.526990DDCB66DBFE.title: "制作装饰螺丝 (Create Deco Screws)"
	quest.52C857EFF5B0B038.quest_subtitle: "特定配方所需的形状在 JEI 中。请研究此物品以更好地了解其用法。"
	quest.5302FEDC4AE9E422.quest_subtitle: "将固体转化为气体。"
	quest.53D56FE5BEE5A5AE.quest_subtitle: "功能极其强大的多功能工具。按 shift 并使用滚轮切换模式。快速模式可在4秒内破坏黑曜石。需要充电器进行充电。"
	quest.5408E2717699F58E.quest_subtitle: "注意：其他材料制作的大型链条也可以使用。请在JEI中查看。"
	quest.543D8BCBEB25E495.quest_subtitle: "将你的食物转化为营养糊状物。"
	quest.54481CD5F48D9281.quest_subtitle: "将物品压缩（如将铁锭压缩成铁块），放置在升级槽中。"
	quest.545C005F9CA752AC.quest_subtitle: "其他变种，例如带有灵魂火的变种，也可以使用。"
	quest.546E0F2B0197CCDD.quest_subtitle: "用背包中的物品填充选定的物品栏。放置在升级槽中。"
	quest.547691F065586676.title: "钻石盔甲！"
	quest.54BC84D458D42837.quest_subtitle: "请仔细思考一下。"
	quest.54BC84D458D42837.title: "高炉 Blast Furnace"
	quest.553A37D807DC417C.quest_subtitle: "将2列火车连接成1列。研究此物品以了解其工作原理。"
	quest.5641AC4BF9E29505.quest_subtitle: "让你能够找到一个特定的结构"
	quest.564D595130838A0F.quest_subtitle: "允许用户从一个传送石传送到另一个传送石。"
	quest.56F4B0FA8A345E0A.title: "铁矿开采"
	quest.5768D9AE8E81445B.quest_desc: ["就像 &e物品宝库&r 一样，不过是彩色的！"]
	quest.5768D9AE8E81445B.title: "容器"
	quest.580D39BFC0ACB1DC.title: "启用模组"
	quest.585DDA54AA63AED8.quest_desc: ["将铀棒放入炉内以提供动力，并在顶部放置矿石进行冶炼。一根铀棒可冶炼60个矿石。冶炼过程中会产生核废料。如果核废料计量表已满，熔炉会开始过热并最终爆炸。"]
	quest.585DDA54AA63AED8.quest_subtitle: "将4个核反应堆组件放置成2x2的立方体以创建。"
	quest.585DDA54AA63AED8.title: "核反应堆炉膛"
	quest.585E100C274CC71A.quest_subtitle: "可容纳更多物品。"
	quest.597B92CB0D92E32F.quest_subtitle: "基础低功耗发电机。参见 ponder。"
	quest.5ACB349BD399E564.quest_desc: [
		"{image:minecraft:item/bone_meal width:25 height:25 align:1}"
		""
		"&eRich Soil&r is made by just placing &eOrganic Compost&r and waiting. The process can be sped up by placing &eOrganic Compost&r around &eRich Soil&r blocks."
	]
	quest.5C9BB3B8174A6083.quest_subtitle: "可容纳更多物品。"
	quest.5E59F7DD5A6B6935.quest_desc: ["安山岩外壳是用安山岩合金右键去皮原木制成的，也是Create中另一种重要的合成材料。"]
	quest.60D46B8FDEAB0AB6.quest_desc: ["Galena 是一种富含铁的岩石，存在于 Magnetic caves 中。用 9 个 Galena 块制作 Packed Galena，即可将其熔炼成铁锭。"]
	quest.60EA24710A361A00.quest_subtitle: "在轨道末端停止火车，防止脱轨。"
	quest.6110532CDFF61207.quest_desc: [
		"将洞穴石碑放入洞穴学工作台。点击一个单词，揭示其从古代语言到英语的含义。"
		""
		"策略："
		"1. 猜一个随机单词。"
		"2. 看看这个随机单词里是否有你要找单词的某个字母。"
		"3. 看看古代语言的符号与哪个字母相对应。"
		"4. 猜另一个包含你找到的符号的单词。"
		"5. 看看你猜的词中是否有另一个字母存在于你要找的词中，并查看古代语言中对应的符号。"
		"6. 再猜一个包含这两个符号的词（最好是你找到的这两个符号在你要找的词里是相邻的。）"
		"7. 重复。"
	]
	quest.6110532CDFF61207.title: "将洞穴石碑翻译成洞穴法典"
	quest.6175E7E56A6CA81F.quest_subtitle: "复制附魔书。查看沉思以了解更多详情。"
	quest.61D896E45681E6C6.quest_desc: [
		"{image:create:item/brass_hand width:25 height:25 align:1}"
		""
		"&l部署器&r"
		""
		"&eDeployer&r会放置手持的方块，与方块互动，或从容器中取放物品。它还有过滤器，可只使用特定物品。可通过右键点击正面放置物品，或在顶部放置漏斗/滑槽来向Deployer中添加物品。如果使用过滤器，而拾取的物品不匹配，则需要在底部使用漏斗/滑槽处理溢出。"
	]
	quest.6211C3CE134D7871.quest_desc: [
		"齿轮减速器是前期让装置转得更快的一种方法。"
		"放置一个大齿轮，连接一个旋转动力源，再斜向放置一个小齿轮。这将使你的装置速度翻倍，但会消耗SU。齿轮减速也可以叠加，只需将一个大齿轮放在第一个减速齿轮的小齿轮上，再斜向放置另一个小齿轮即可。"
	]
	quest.6211C3CE134D7871.title: "齿轮减速器"
	quest.62177D46704CBAD7.quest_subtitle: "当火车位于标记物上时，会输出红石信号。"
	quest.6227E8380B88B050.quest_subtitle: "注意：本章中，若任务没有描述，则说明该任务过于简单，或其中某个方块/物品有“沉思”。浏览任务时请注意寻找“沉思”！"
	quest.6227E8380B88B050.title: "解锁模组"
	quest.625331A843474DC3.quest_subtitle: "请思考这些物品，以了解它们的使用方法。"
	quest.625D1EEAF41CFBC3.title: "铁质盔甲"
	quest.6277A2FAF5DFBFE0.quest_desc: [
		"{image:minecraft:item/iron_ingot width:25 height:25 align:1}"
		""
		"&l铁匠铺&r"
		""
		"&e铁匠铺&r是一个非常容易使用的方块。只需将&e村民&r放进去，等待&e铁&r出现在物品栏中即可。"
	]
	quest.627A30EEDFE5D7C3.quest_subtitle: "在火车上放置一个箱子，并装满可以燃烧的物品，让你的火车跑得更快！"
	quest.627A30EEDFE5D7C3.title: "提高火车速度"
	quest.63302D8B7AE5B29C.quest_subtitle: "查看沉思以了解此物品的运作方式。"
	quest.65ACA5395622D471.quest_subtitle: "所有引擎的必备部件。"
	quest.65BE7CF8F2852139.quest_desc: ["该引擎需要空气（来自进气口，也需要旋转动力）、柴油和一根排气管。这是唯一一个运行不需要红石信号的引擎。"]
	quest.663C80C0C0DDA5E8.quest_desc: ["用木箱压缩9个食物可以节省背包空间。"]
	quest.663C80C0C0DDA5E8.title: "压缩食物以节省空间"
	quest.66F224FB0D564922.quest_desc: [
		"{image:create:item/precision_mechanism width:25 height:25 align:1}"
		""
		"&l精密机械&r"
		""
		"&ePrecission Mechanism&r 是一种复杂的合成材料，用于更高级的物品。它需要 3 个放置器，第一个放置 &eCog&r，第二个放置 &eCogwheel&r，第三个放置 &eIron Nugget&r，此外放置器下方还需有一条传送带，上面放有 &eGold Sheet&r（合成此物品需要，请在 JEI 中查看机器模型）。"
	]
	quest.67C896EFBEF20BCD.quest_desc: ["使用不同匝数的铜线卷轴（用绕线机制作）将电压转为电流，从而降低电压和电流。若想获得更多电流，将匝数少的卷轴（如300）放在输入端，匝数多的卷轴（如1000，最大值）放在另一端。若想获得更多电压，则反之。"]
	quest.680B997C68517F1B.quest_subtitle: "每种食物都有一个参数，说明可以放在哪个盘子上。只需将鼠标悬停在物品上即可。"
	quest.68301123FE9FDE20.quest_subtitle: "加载 1 个区块。查看说明以了解用法。"
	quest.687EE05C03A04D53.quest_desc: ["允许向你的 MekSuit 添加酷炫模块！所有模块请查看 JEI。部分模块需要将化学物质储存在套装中。方法是右键点击装有所需物质的化学或流体储罐，然后将相关的 MekSuit 部件放入 I（输入栏），建造完成后，部件会从 O（输出栏）中取出。要配置单个模块，请按 \\"]
	quest.6928149025E73373.quest_desc: ["使用2个电极进行电解，就像现实世界一样。对于矿石倍增器，我们将把水（H2O）分解成氢气（H）和氧气（O）。目前我们只用氧气。注意：哪种气体流出取决于你把加压管道放在哪一侧！如果流出的气体不正确，可以考虑将方块旋转180度。"]
	quest.6969C6A2A10703FA.quest_desc: ["放置正确数量的货币时会输出红石信号。"]
	quest.6A03D7553BE75FC9.title: "基础能量传输与存储 \\n 基础能量传输与存储"
	quest.6A3EAC6B1ADF1923.title: "Clutch 变体"
	quest.6B86471661CE5EF7.quest_subtitle: "请思考这些物品，以了解它们的使用方法。"
	quest.6B904A12666D0A9D.title: "钋-210 颗粒"
	quest.6C4D190C7914B716.quest_desc: ["将涡轮引擎方块排成一行。然后根据提示收集组装引擎所需的物品。到达螺旋桨步骤时，在每个涡轮引擎方块上放置4个螺旋桨，直到组装完成。"]
	quest.6C5DC6B0188F1984.quest_subtitle: "查看 Ponder。重要补充：泵机锤、泵机连接器和泵机零件需要用强力胶水粘合，泵机才能正常工作。"
	quest.6C5DC6B0188F1984.title: "石油钻探！"
	quest.6CA1ADC30261DB71.quest_subtitle: "让你能够找到特定的生物群系。"
	quest.6D4D86F2B5D05174.quest_desc: ["地质扫描仪是高级外设的一部分，可以扫描其周围的区域。在JEI中搜索@advancedperipherals可以找到更多外设。"]
	quest.6DD6B2AA2C2AD66C.quest_subtitle: "用于制作火车和作为合成配方。"
	quest.6F0DEF49BEB29268.quest_desc: [
		"&lExtend-O-Grip&r"
		""
		"将 Extend-O-Grip 放在副手，可以延长主手物品的抓取范围，让你能够以更远的距离使用它们。"
	]
	quest.6FAD34B8D9E40471.quest_desc: ["Mekanism 中，浸渍合金是升级和高级机器的基石。最简单的做法是，先将红石在化学氧化器中氧化成气体，再与铜锭一起送入冶金浸渍器，以制造基础的浸渍合金。"]
	quest.6FB589E5D0A44240.quest_desc: [
		"{image:minecraft:item/wheat width:25 height:25 align:1}"
		""
		"&l农夫&r"
		""
		"农夫可以让你把村民和种子放进去，实现自动种植"
	]
	quest.7003187B89549B6F.quest_desc: [
		"{image:create:item/schematic width:25 height:25 align:1}"
		""
		"&lSchematicannon&r"
		""
		"Schematicannon 用于用蓝图建造结构。在 Schematicannon 旁边放置一个箱子，以便它收取物品。"
		"你可以在GUI的灰色槽位中放置一本“书与羽毛笔”或“清单”，来制作所需物品的清单。"
		""
		"&l如何创建蓝图&r"
		""
		"要创建蓝图，请获取蓝图和羽毛笔。右键点击你建筑的其中一个底角，然后点击建筑的相对顶角。之后，通过按住 Ctrl 并滚动来调整选择范围。满意后，在空中右键点击蓝图和羽毛笔。会弹出窗口。给你的蓝图命名并点击对勾按钮。这将把你的蓝图保存为一个 .nbt 文件。"
		""
		"&l如何在另一个世界或服务器导入你的 schematics&r"
		""
		"要将你的 schematics 转移到另一个世界或服务器，你需要一个 Schematic Table 和一个 Empty Schematic。放置 Schematic Table，在文本框中滚动选择所需的 .nbt 文件，将空的 schematics 放入左侧的槽位，然后点击对勾按钮。等待进度条填满，一个 Schematic 就会出现在右侧的槽位中。"
		""
		"&l如何使用 Schematicannon 建造蓝图中的内容&r"
		""
		"首先，你需要放置你的蓝图。右键地面以放置蓝图。然后调整位置，先按住左Alt并滚动来选择模式，再滚动以修改位置。满意位置后，将蓝图放入蓝色区域的左侧槽位，灰色区域放置火药，紧挨进度条，然后将蓝图所需的材料放入与蓝图炮接触的箱子里。要最终将蓝图建造到世界中，请点击播放按钮。如果缺少材料，蓝图炮会停止并在GUI中显示所需物品。"
	]
	quest.709D093EA5270A79.quest_subtitle: "检查 Ponder 模块"
	quest.709D093EA5270A79.title: "聚变反应堆"
	quest.70AD9C0C998785A6.title: "找到一个要塞 (Stronghold)"
	quest.70DD18691D9254AB.quest_desc: ["用于运输物品。提示：物流运输机有个奇怪的特性。即使你用配置器点击它，并将其设为物品模式，也无法更改其至关重要的推/拉配置。要修改配置，你必须右键点击其最末端，因为放置一个物流运输机实际上会放置两个方块（用方块轮廓可以看见），一个大的和一个小的（长度约为另一个的0.5倍），而你需要右键点击的是小的那个。"]
	quest.714BBE4EDB7A823C.quest_desc: ["将用锂粉放入化学氧化器制成的锂放入太阳能中子活化器中"]
	quest.7151C9116EBFE5C8.quest_subtitle: "注意：其他木材类型的栅栏也可以使用。请在JEI中查看。"
	quest.719FB6063A611CBE.title: "手动使用转子和定子组装一台发电机"
	quest.726BBE9916715C4E.quest_desc: ["银行终端让你无需卡片也能取出卡里的钱。卡片可放在售货机或存款机中，顾客的钱会自动存入你的银行账户。"]
	quest.73573AE8EAF79032.title: "启用模组"
	quest.74B8C7373148C435.quest_subtitle: "运作方式与铁砧相同。更多信息请参阅 ponder"
	quest.75C67BE2AC282AE0.quest_subtitle: "用于查看列车时刻表和目的地，会显示一个GUI，告诉你需要乘坐哪些列车才能到达目的地。"
	quest.761305A24CC26503.quest_subtitle: "使背包自动拾取物品。放置在升级槽中。"
	quest.7630B43A8626040B.quest_subtitle: "将锇注入黑曜石或萤石粉中进行精炼。"
	quest.7654C89F5F8764BE.quest_desc: [
		"&eMagnetic Quary Smasher&r 会在一个方形区域内自动挖矿。"
		"放置 4 个 &eMagnetic Lights&r（它们之间最多可相距 20 格。）"
		"中心放置&eMagnetic Quary Smasher&r，在由&eMagnetic Lights&r组成的方块外一圈放置&eMagnetic Quary&r，挖掘的物品将从这里弹出。"
	]
	quest.768A8D4488435A2C.quest_subtitle: "请务必设置 QIO 频率"
	quest.773DA70538E0F088.quest_desc: ["在化学注入器中结合 Thritium 和 Deutirium 即可制作。有关如何制作足够的 D-T 燃料及其使用细节，请访问官方 Mekanism Wiki：https://wiki.aidancbrady.com/wiki/Fusion_Reactor。"]
	quest.773DA70538E0F088.title: "D-T 燃料"
	quest.78BFE2E1E1E15E36.quest_subtitle: "将物品放入烈焰附魔师的过滤槽中，即可用该物品支持的附魔来附魔附魔模板。"
	quest.78C297E773D2A59D.quest_desc: ["私人箱子用于保护你的物品免受其他玩家的侵害。手持物品时，按住 Shift 并右键单击即可设置箱子的所有权。设置完成后，将其放置在地面上并放入你的物品即可。"]
	quest.792F4DC476B34743.quest_subtitle: "查看 JEI 的合成配方，并思考如何使用这些物品。"
	quest.79357ECE3D1CFD9E.title: "建造门扉"
	quest.79DC1812167E3290.quest_subtitle: "将气体转化为液体，或者切换模式（左上角的按钮）后，将液体转化为气体。"
	quest.7A1EB8F16373D795.quest_desc: ["终局机制。MekSuit 是一套模块化套装，能让你大幅加快所有工作流程，还能抵御辐射、物理伤害等。需要用充电器为其充电"]
	quest.7A1EB8F16373D795.title: "MekaSuit"
	quest.7A53AF6D9555EE64.title: "原始钕磁铁"
	quest.7A6B169097F95916.quest_desc: ["Tiered Factories 是各自物品中运行速度更快的版本。"]
	quest.7A72B66CE96B422D.quest_desc: [
		"{image:create:item/crushed_raw_iron width:25 height:25 align:1}"
		""
		"&lCrushed Ore&r"
		""
		"Crushed Ore 是通过 Crushing Wheels 加工 Ore 制成的，副产品是 Experience Nuggets，一种以物品形式存储 XP 的方式，右键即可获取 XP。"
	]
	quest.7A72B66CE96B422D.title: "被压碎的矿石"
	quest.7AB9A434557C8C04.quest_desc: [
		"{image:farmersdelight:item/tomato width:25 height:25 align:1}"
		""
		"这些是新水果和蔬菜，可用于烹饪！除了&e稻米&r外，所有作物都正常种植，但&e稻米&r需要种在水里。可在村庄或野外找到。"
	]
	quest.7AB9A434557C8C04.title: "新增水果和蔬菜 (New Fruits and Vegitables)"
