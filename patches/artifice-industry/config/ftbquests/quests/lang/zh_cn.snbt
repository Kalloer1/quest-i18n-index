	quest.5759293CA095926E.quest_subtitle: "把我扔进蜜蜂窝里去！"
	quest.57E6C2EC91944CAC.quest_desc: ["Applied Energistics 2 的 ME 无线连接器可为你的 ME 网络提供无线访问，让你能无缝地与范围内的终端和设备互动。只需右键点击两个连接器并使用无线设置套件，即可轻松完成设置。"]
	quest.58A6C2D052AB1D8C.quest_desc: [
		"&l&4你好！我是 Rogue_Light！&r&r"
		""
		"&6&o我从1.5.2版本就开始玩模组Minecraft了，最初是在1.7.10版本左右开始托管的。说到模组，我对科技和魔法类模组的喜爱差不多各占一半！&r &r"
		""
		"&6&o不过大多数时候你都会看到我在Discord里刷屏！或者在后台处理更新，构思新点子来优化我们的游戏体验！&r&r"
	]
	quest.58A6C2D052AB1D8C.quest_subtitle: "所有者"
	quest.58A6C2D052AB1D8C.title: "Rogue_Light"
	quest.59072BDE9DC3F5B0.quest_subtitle: "一款解决“不够酷”这一老问题的Minecraft模组。Transmog能让你在不改变物品行为的前提下，随意改变它们的外观！无论是盔甲、武器、工具，还是你能想到的任何东西，它都能搞定！"
	quest.59A638FBEF036924.quest_desc: ["它将在你的合成 CPU 多区块内执行第二个任务。"]
	quest.59DC97C2D65DF71C.quest_desc: ["密集电缆最多可处理 32 个频道！"]
