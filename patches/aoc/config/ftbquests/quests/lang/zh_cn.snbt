	quest.5A013800B7F1E4C1.title: "&e拐杖糖锄头"
	quest.5A352C042058324D.quest_subtitle: "将其全部研磨成粉"
	quest.5A576D629B37BEAF.quest_subtitle: "这会将烈焰人变成超级烈焰人。只需放置 2 根烈焰棒和 2 个经验块，这样它就不会爆炸。"
	quest.5A576D629B37BEAF.title: "&2制作附魔蛋糕"
	quest.5A5A789CF38BA336.quest_subtitle: "一个&6蓄能器&r是一种多方块结构，可以让你储存大量的&6能量 (E)&r"
	quest.5A6D7441955378A0.title: "制作绝缘体"
	quest.5A82E1993C9467B3.quest_subtitle: "&2列车控制装置&r可以让你控制列车"
	quest.5A82E1993C9467B3.title: "&2列车控制装置"
	quest.5ADB1A5D4CDF8518.title: "制作继电器"
	quest.5B1153E41E67209F.quest_desc: ["最后一步，我们将使用一个&6装满岩浆的出料口&r，将其注入掉落在出料口下方货箱上的&c烈焰核心&r。"]
	quest.5B1153E41E67209F.quest_subtitle: "用于制作五分熟牛排的燃料"
