	quest.3C9819BB10CE8979.quest_desc: [""]
	quest.3C9819BB10CE8979.quest_subtitle: "可以在任何地方捕捉到，位于 &5末地&r 中。"
	quest.3CB2B7116AA3D780.quest_desc: [
		"Traveler's Backpacks 是一款独特的模组，添加了多种背包变体和类型，其中一些还拥有独特的能力！"
		""
		"背包本身有许多功能，包括："
		""
		"&b使用背包即可在任何地方睡觉的能力。&r"
		""
		"&b使用内部储罐和软管来储存和移动流体的能力。&r"
		""
		"&b可以开启或关闭能力（在你不想让它们生效时）。&r"
		""
		"按下'&bB&r'会打开背包。要将背包背在身上，可以手持背包时按住Shift右键将其放置在地面上，然后空手按住Shift右键，或者打开背包并点击左下角的按钮来穿戴。再次点击即可脱下。"
	]
	quest.3CB2B7116AA3D780.quest_subtitle: "点击了解更多详情！"
	quest.3CB2B7116AA3D780.title: "&b背包类物品"
	quest.3D47D2D38F5C4ECD.quest_desc: [
		"几乎和主世界的甜浆果不相上下。"
		"收割灌木丛以收集浆果。"
		""
		"打破灌木丛以移动，然后重新种植它们。"
	]
	quest.3D47D2D38F5C4ECD.title: "我很难过，哒吧嘀嘀哒吧嘀嘀嘀…"
