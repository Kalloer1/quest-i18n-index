	quest.09408C6DCAC90318.quest_subtitle: "{atm9.quest.mekanism.subt.storingPower}"
	quest.094A45BA33FDA34F.quest_desc: [
		"&6下界合金潜水装备&r可以在&b锻造台&r中使用以下材料合成："
		""
		"1x &b铜制潜水装备&r"
		"1x &b下界合金锭&r"
	]
	quest.094A45BA33FDA34F.quest_subtitle: "和铜类似，但更坚固，能抵抗岩浆！"
	quest.094A45BA33FDA34F.title: "制作一套下界合金潜水套装"
	quest.095069D8FBB05C18.title: "坚定不移的尖刺"
	quest.0972BAF239E98718.quest_subtitle: "穿越大海和海洋的更快捷方式"
	quest.09966BA346283D39.quest_desc: ["好黏糊糊的！"]
	quest.09966BA346283D39.title: "木棍！"
	quest.099A91A1E8AF562E.quest_desc: [
		"当它朝向红石线时，可以间接供电。"
		"可靠地传输模拟能量而不会衰减，非常实用。"
		"信号通过中继器需要1游戏刻才能传输。"
	]
	quest.099A91A1E8AF562E.quest_subtitle: "观察者方块，其作用是将前方的信号复制到后方。"
	quest.099A91A1E8AF562E.title: "中继器"
	quest.09B72093F7345C0E.quest_desc: ["打包后，只有你和收件人才能打开它并访问其中的内容。"]
	quest.09B72093F7345C0E.quest_subtitle: "一个可以存放1个物品堆叠的容器方块。"
	quest.09B72093F7345C0E.title: "礼物"
	quest.09E610F37D2534EF.quest_subtitle: "穿戴后，在水中可获得水肺和夜视 I 效果。"
	quest.0A0C5915DDEDC5ED.quest_subtitle: "“Candlelight”是“Let's Do”系列的扩展包，新增了烹饪台和装饰方块。"
	quest.0A0C5915DDEDC5ED.title: "&6烛光照明"
	quest.0A6178D82A037278.quest_subtitle: "根据接收到的信号强度显示数字或符号。"
	quest.0A6178D82A037278.title: "水晶展示台"
	quest.0A757AFDA57C0E2B.title: "获得 64x 鲑鱼"
	quest.0A76353F36292E6E.title: "获取 512x 云杉原木"
	quest.0AF6615A80843315.quest_desc: [
		"爆炸只会对生物造成伤害，而不会破坏任何方块，水可以移除的方块（如高草）除外。"
		"爆炸时，它们可以点燃附近的&e苦力怕&r。"
		""
		"&a蓝色炸弹&r是&a炸弹&r的更强力版本，会施加虚弱效果。"
	]
	quest.0AF6615A80843315.quest_subtitle: "一种消耗型投射物，落地后会爆炸。"
	quest.0AF6615A80843315.title: "炸弹"
	quest.0B009391E3F76D6E.quest_desc: [
		"渔夫是早期为村民提供食物的绝佳来源。希望你有足够的线资源。运气好的话，渔夫还能获得一些额外的战利品。"
		""
		"如果你的殖民地没有海洋或河流等天然水源，可以用一个 6x6x1 的水域代替。"
	]
	quest.0B30387B4FEEF5B6.quest_subtitle: "这和我家的蘑菇&b房&r简直绝配。"
	quest.0B8D2F8B47486384.quest_subtitle: "这些物品可以提升你飞行器的各项属性。"
	quest.0B98389CC3250574.title: "&2动物繁殖 V"
	quest.0B9A4040AFD8A3EF.quest_subtitle: "电动工具！"
	quest.0BB92CBE08A783C6.quest_subtitle: "使浆果树的行为如同处于丛林或沼泽生物群系中，且持续时间无限。"
	quest.0C0A7B9BEED869BC.title: "找到一个蜗牛"
	quest.0C16AD35A6E01EE7.quest_desc: [
		"&4下界&r是一个危险的地方，充满了邪恶生物、地牢、首领等等！在探索之前，请务必查看&4下界提示&r部分，做好充分准备。"
		""
		"探索所有&4下界&r结构和生物群系，将奖励你永久提升的&e移动速度&r！"
	]
	quest.0C16AD35A6E01EE7.quest_subtitle: "点击了解更多详情！"
	quest.0C16AD35A6E01EE7.title: "&4下界探索"
	quest.0C5A75DD4C276B70.quest_desc: [
		"&6Create&r 是一款强大的模组，初看可能令人不知所措，但在指导下，它将彻底改变你处理日常任务的方式。"
		""
		"就像&b红石&r一样，&6创造&r引入了从简单到复杂的各种机制，唯一的限制就是你的想象力。"
		""
		"这个任务链会引导你，但别忘了使用&aPonder&r——&6Create&r中展示物品运作方式的必备工具。"
		""
		"有疑问尽管问！模组文档齐全，你想知道的任何内容，只需搜索即可找到。"
	]
	quest.0C5A75DD4C276B70.quest_subtitle: "点击此处了解更多详情！"
	quest.0C5A75DD4C276B70.title: "&6创造指南：新手入门篇"
	quest.0C97E69B69DD6884.quest_subtitle: "作为乘客，目睹一场火车相撞事故。"
	quest.0C9D507B041FDC83.quest_subtitle: "由一位大师牧师出售。"
	quest.0CD745288D5C4ACC.quest_subtitle: "升级后的酿造台，制作威士忌必不可少。"
	quest.0D4FE97640F2CA60.quest_desc: ["{atm9.quest.rs.desc.ultraD}"]
	quest.0D4FE97640F2CA60.title: "{atm9.quest.rs.ultraD}"
	quest.0D6E099A1A242153.quest_desc: [
		"&b建造工具&r是模组里最重要的工具之一。从现在开始，你将用它来放置所有建筑。右键点击任何实体方块即可打开建造预览界面。右侧是用于移动、旋转、升高和降低建筑的控件。"
		""
		"放置你的&b市政厅&r方块并注册殖民地。然而，首个要建造的建筑是建造小屋。在没有完成建造小屋之前，你的市政厅无法建造。"
		""
		""
	]
	quest.0D8A4B7DF2877A56.quest_subtitle: "穿戴此物品时，会获得多种药水效果。"
	quest.0DD6C3E83513D0F1.quest_desc: [
		"旅途中，你可能会发现大量&2绿宝石&r！和原版 Minecraft 一样，&2绿宝石&r是这个世界的货币。"
		""
		"获取&2绿宝石&r很简单——你可以在宝箱里找到它们，或者像往常一样挖掘。另一个方法是通过&b出售箱&r，这是一种简单的方块，可以让你出售成堆的物品，比如鱼、农作物等。如果物品可以出售，其工具提示中会显示出来。"
		""
		"要出售物品，只需将一叠物品放入&b出售箱&r中。一天过去后，回来看看，你会发现所有货物都已售出！"
		""
		"攒够一笔钱后，就去 &bDaily Shop&r 吧——这是一个可以建造的方块，里面有许多实用或不实用的物品可供购买。"
	]
	quest.0DD6C3E83513D0F1.quest_subtitle: "点击了解更多详情！"
	quest.0DD6C3E83513D0F1.title: "&6经济系统"
	quest.0DE477B195CB758E.quest_desc: [
		"&6Mechanical Crafters&r 是合成后期物品如 &dCreative Motor&r 和 &dCreative Fluid Tank&r 所必需的方块。"
		""
		"&6Mechanical Crafters&r 的合成配方如下："
		""
		"1x &b电子管&r"
		"1x &b黄铜外壳&r"
		"1x &b工作台&r"
		""
		"&aPondering is recommended.&r"
	]
	quest.0DE477B195CB758E.quest_subtitle: "更大的配方需要更大的合成台！"
	quest.0E5F195E0423EE12.quest_desc: [
		"&6序列组装&r从一个基础物品开始，依次经过各个制作阶段。"
		""
		"物品通过像&bDeployers&r和&bMechanical Saws&r这样的机器，使用&bDepots&r或&bMechanical Belts&r，形成不完整的物品。"
		""
		"该物品会持续经过后续阶段，根据复杂程度，必要时重复此过程。"
	]
	quest.0E5F195E0423EE12.quest_subtitle: "工厂必须不断发展壮大。"
	quest.0E5F195E0423EE12.title: "序列组装"
	quest.0E762E192836E31D.quest_subtitle: "然后寄生蘑菇就占据了主导地位……"
	quest.0EBB4E5195610A82.quest_desc: [
		"锯木厂是木匠制作至少含75%木材物品的地方。此时，殖民地才真正开始自行运转。请务必设置好建造者常用物品的重要配方。锯木厂初始仅有10个配方，但可教授的配方数量会随建筑等级翻倍。"
		""
		"提示：请务必给你的木匠一个&e建造工具&r，因为某些配方需要它。"
	]
	quest.0EBB4E5195610A82.quest_subtitle: "建造一个锯木厂"
	quest.0ED14D2226AFBB8F.quest_desc: [""]
	quest.0ED14D2226AFBB8F.quest_subtitle: "用于砍伐物品，将物品放置其上，然后用刀右键。它还可以剥去原木的树皮。"
	quest.0ED8D054CDC8D20E.quest_desc: [
		"不要把它误认为是食物来源。"
		""
		"白色苹果可以通过破坏水晶果树叶获得，这些叶子是蓝色的，上面有白色的斑点。"
		""
		"白苹果可以治愈 blabla 效果。"
	]
	quest.0ED8D054CDC8D20E.title: "无色物品（无颜色）"
	quest.0EEA6A244D9CD21A.quest_subtitle: "非EA赞助！"
	quest.0EEC3E0DED1ACB42.quest_desc: ["使用油漆套件来粉刷带框电缆。只需将油漆套件对准目标方块，按 Shift+右键，再右键点击带框电缆或连接器即可粉刷。"]
	quest.0EEC3E0DED1ACB42.quest_subtitle: "点击了解更多详情！"
