	quest.6DF3244785EF073A.title: "击杀太阳精灵首领"
	quest.6E004A400EAE0771.title: "找到一头驴子"
	quest.6E0CE66D834FD69D.title: "&2野生动物收集里程碑 II"
	quest.6E17D0E2C2C20A44.title: "捕捉一只水属性的宝可梦！"
	quest.6E34EA35B2345540.quest_subtitle: "将所应用的浆果树的生长速率提高，最多可收获3次。"
	quest.6E3C1037571CB92E.quest_desc: [
		"&6机械压机&r可以用以下材料制作："
		""
		"1x &bShaft&r"
		"1x &b安山岩外壳&r"
		"1x &b铁块&r"
		""
		"&6Depots&r 可以用以下材料合成："
		""
		"1x &b安山岩合金&r"
		"1x &b安山岩外壳&r"
		""
		"&aPondering is recommended.&r"
	]
	quest.6E3C1037571CB92E.quest_subtitle: "利用旋转力将物品压入板材中。"
	quest.6E3C1037571CB92E.title: "制作一个机械压机和仓库"
	quest.6E3ECB7213E993F6.quest_desc: [
		"&6铁轨&r可以通过&b序列组装&r，按照以下顺序制作："
		""
		"1x &b石头&r 或 &b安山岩板&r"
		"2x &b铁&r 或 &b锌粒&r"
	]
	quest.6E3ECB7213E993F6.quest_subtitle: "尽量不要脱轨！"
	quest.6E7522BC50BD0FFA.quest_subtitle: "你不会再喝醉了！"
	quest.6E856702D9B7C2EE.quest_desc: [
		"使用引力斧作用于琥珀天根原木即可获得。"
		""
		"用于制作黄金飞镖发射器、黄金飞镖和矿物探测器。"
		""
	]
	quest.6E856702D9B7C2EE.title: "霸王龙？"
	quest.6EA3E4035199FD70.quest_subtitle: "通过杀死巨龙获得。"
	quest.6EB8C8FC5D69EC2C.quest_subtitle: "在掠夺者前哨基地中可找到。"
	quest.6EBC47FE03319249.quest_subtitle: "把水瓶放进去，就能为你的鸡尾酒制作冰块！"
	quest.6EC41D0CE1C238E3.title: "末影箱附加组件"
	quest.6EF117BCAD9C6558.quest_desc: [
		"&4下界&r是一个危险的地方。如果你想活下去，请确保你拥有以下物品："
		""
		"某种飞行方式：最容易获得的是&bGyrodyne&r。"
		""
		"体面的盔甲：敌人很容易将你包围，没有适当的保护，即使是技艺最精湛的战士也可能被"
		"被各种事情搞得焦头烂额。"
		""
		"&6收集里程碑&r进度：盔甲上的额外属性将有助于确保你的安全。"
		""
		"直觉：如果某物看起来能召唤首领，它多半会这么做。相信你的直觉。"
	]
	quest.6EF117BCAD9C6558.quest_subtitle: "点击了解更多详情！"
	quest.6EF117BCAD9C6558.title: "&4下界提示"
	quest.6F2AA1A76FA133F3.quest_subtitle: "携带过多此类背包会导致多种负面效果，包括减速和挖掘疲劳！"
	quest.6F3390D6034B6C05.quest_desc: [
		"&6机械收割机&r的合成配方如下："
		""
		"4x &b安山岩合金&r"
		"2x &b铁板&r"
		"1x &b安山岩外壳&r"
		""
		"&6机械锯&r可以用以下材料制作："
		""
		"3x &b铁板&r"
		"1x &b铁锭&r"
		"1x &b安山岩外壳&r"
		""
		"&6机械犁&r可以用以下材料制作："
		""
		"3x &b铁板&r"
		"3x &b安山岩合金&r"
		"1x &b安山岩外壳&r"
		""
		"&aPondering is recommended.&r"
	]
	quest.6F3390D6034B6C05.quest_subtitle: "自动化那些农场吧！"
	quest.6F3390D6034B6C05.title: "制作机械设备 (Craft Mechanical Equipment)"
	quest.6F40D1A39E7939DC.quest_desc: [
		"&6齿轮&r可以用以下材料合成："
		""
		"1x &bShaft&r"
		"1x &b任意木板&r"
		""
		"&aPondering is recommended.&r"
	]
	quest.6F40D1A39E7939DC.quest_subtitle: "调整旋转速度或延长装置的结构。"
	quest.6F40FC8343477EAE.title: "樱花木原木"
	quest.6F5285D8BCB0A64E.title: "获取 512x 猴面包树原木"
	quest.6F62B5510FA881CD.quest_subtitle: "{atm9.quest.mekanism.baseCraftingIngot}"
	quest.6F62B5510FA881CD.title: "{atm9.quest.mekanism.osmium}"
	quest.6F9B040235C88E10.quest_desc: [
		"&6黄铜隧道&r 可以用以下材料制作："
		""
		"1x &b电子管&r"
		"2x &b黄铜锭&r"
		"2x &b干海带&r"
	]
	quest.6F9B040235C88E10.quest_subtitle: "与安山岩类似，但具有物品分组和过滤功能！"
	quest.6FD7D6BED48B308C.quest_subtitle: "&b高峰、温带、天空"
	quest.70138ABA04A85C31.quest_subtitle: "由远古守卫者掉落。"
	quest.703B1FDFDDED0036.quest_subtitle: "&b干旱的"
	quest.7044EAB5EDF32BBC.quest_desc: ["{atm9.quest.rs.desc.crafting_monitor}"]
	quest.7044EAB5EDF32BBC.title: "{atm9.quest.rs.crafting_monitor}"
	quest.705B545642183CFC.quest_desc: [
		"&6经验石英&r可以通过&b批量纠缠&r来制作："
		""
		"1x &b玫瑰石英&r"
	]
	quest.705B545642183CFC.quest_subtitle: "太难吃了！根本没法下咽！"
	quest.705C84A4E994C643.title: "建立一个博物馆！"
	quest.7085E7D574481206.title: "&2作物收集任务书"
	quest.70A627EADC8BFAC6.quest_desc: [
		"用彩色胶片拍完想要的照片后，将其与&bMundane Potion&r、&bAwkward Potion&r和&bThick Potion&r结合，开始冲洗以获得冲洗后的胶卷。"
		""
		"拿到开发卷轴后，就前往光照室吧！"
	]
	quest.70A627EADC8BFAC6.quest_subtitle: "点击了解更多详情！"
	quest.717A0F8A80A048AC.quest_desc: [
		"无线终端基本上算是高级无线终端的弟弟。"
		""
		"尽管名字里有“无线”的意思，但它并非真正无线。此级别的无线终端仅能让你在约17格外访问存储终端或合成终端。不过，你需要与终端保持视线畅通，并且必须手持终端右键才能打开界面。"
		""
		"强烈建议尽快升级到高级版以获得增强功能。"
	]
	quest.717A0F8A80A048AC.quest_subtitle: "点击了解更多详情！"
	quest.718A2040D868E09F.quest_desc: ["{atm9.quest.rs.desc.1048mstorage}"]
	quest.718A2040D868E09F.title: "{atm9.quest.rs.1048mstorage}"
	quest.71C8792B19119B91.quest_subtitle: "用矿物制作的背包！"
	quest.71FCF06A98CC66D7.quest_desc: [
		"这么多殖民者为大局努力工作，很难知道谁需要什么。剪贴板能让你轻松查看所有工人的请求。"
		""
		"&e潜行 + 右键&r城镇大厅方块以注册剪贴板。"
	]
	quest.72C008AA321DD359.quest_desc: [
		"就像脚手架一样，它们只能从最近的支撑点水平伸出那么远，超出支撑范围就无法再延伸了。"
		"垂直绳索没有碰撞箱，并且可以攀爬。"
		"横向绳索确实有碰撞箱，可以踩在上面行走，不过速度较慢。"
		""
		"将绳索放置在与现有垂直绳索相邻的位置，绳索将向下延伸。"
		"绳索可以放置，并能动态地缠绕在许多围栏状的方块上，例如墙壁、横梁和柱子。"
		""
		"从绳索上坠落不会减速，但仍能防止坠落伤害。"
		"可以被投射物破坏。"
	]
	quest.72C008AA321DD359.quest_subtitle: "一种让移动更轻松的方块，尤其是在矿井中。"
	quest.72C008AA321DD359.title: "绳索"
	quest.72C749AD9F1C634E.quest_desc: [
		"居民会在夜间前往指定的住所睡觉。住所也是为殖民地获取更多居民的方式。每个住所等级都会增加一张床。更多的床意味着更高的居民容量。"
		""
		"值得考虑居民的住所和他们工作的地点。工人长途跋涉去上班时会变得很暴躁。尽量把居民搬到离工作地点近的房子去。"
	]
	quest.72C749AD9F1C634E.quest_subtitle: "建造一座住宅 Residence"
	quest.72C9825C4040E66C.quest_desc: ["物品栏线缆连接器与物品栏连接器方块类似，但它只会读取直接连接的物品栏。这对于读取抽屉或桶等独立存储方块（远离主存储区）的输出很有用。此外，它还可以作为放置终端的平台。"]
	quest.72C9825C4040E66C.quest_subtitle: "点击了解更多详情！"
	quest.730E9C4314C75452.quest_desc: [
		"&b木制木箱&r可以在任何生物群系的&2主世界&r中通过钓鱼获得，里面包含以下物品："
		""
		"&2常见掉落物&r:"
		"- 海藻"
		"- 海带"
		"- 蜘蛛网"
		"- 字符串"
		"- 小麦"
		"- 胡萝卜"
		"- 甜菜根"
		"- 鲑鱼"
		"- 鳕鱼"
		"- 木棍"
		"- 铁和金块碎片"
		"- 燧石"
		"- 煤炭"
		""
		"&6稀有掉落&r："
		"- 铁锭和金锭"
		"- 铁矿石"
		"- 附魔之瓶 (Bottles o' Enchanting)"
		"- 绿宝石"
		"- 水桶"
		"- 一桶桶的鱼"
		"- 河豚"
		"- 弓类武器"
		"- 十字弩"
		"- 附魔书籍"
	]
	quest.730E9C4314C75452.quest_subtitle: "Click to learn more!"
	quest.732E63D8FE0AF497.quest_subtitle: "速度慢，耗油多，但可以携带整个储物空间。"
	quest.733D249EF34F497B.quest_desc: [
		"水管是一种具有三种功能的工具："
		""
		"&b吸力模式：&r"
		"允许你拾取世界中的流体，或点击储罐将其转移到背包的内部储罐缓冲区。"
		""
		"&b泼洒模式：&r"
		"可将流体倾倒入世界，或点击储罐将其储存其中（类似桶）。"
		""
		"&b饮用模式：&r"
		"允许玩家饮用背包中储罐内的液体。并非所有液体都可饮用，部分可能产生特殊效果。"
		""
		"要切换这些模式，按住 '&bZ&r' 并向上或向下滚动即可更改模式。"
		""
		"手持水管并背着背包时，按下 '&bN&r' 即可将其切换到背包内的副水箱！"
	]
