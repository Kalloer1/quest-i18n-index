	quest.575C3CA17F9AE70E.quest_subtitle: "与传送带类似，但为垂直方向。"
	quest.5789D1B8B9FF41C8.quest_subtitle: "穿戴此物品时，可获得火焰抗性 I。"
	quest.57937C0BAEF00C5C.title: "找到一头猪"
	quest.57C889EC980D33D9.quest_desc: ["我终于可以不再（那么）沉迷泥土，把农活交给别人了。我应该让农夫先种胡萝卜，因为它们也不用烹饪……"]
	quest.57FC56C587D63B40.quest_subtitle: "&a+3% 稳定&r，&a-100% 风力影响"
	quest.580D8262323E37CD.title: "任意汽车车轮"
	quest.58275DB6DF066451.quest_desc: [
		"用起来很直观，你只要给一个供电，它就能给相邻的齿轮供电，最远可达14格，就像&a红石粉&r一样。"
		""
		"这东西的真正用途是制作紧凑的垂直红石信号系统。"
	]
	quest.58275DB6DF066451.quest_subtitle: "以实体方块的形式，起到升级版红石的作用。"
	quest.58275DB6DF066451.title: "齿轮方块"
	quest.5834E48CD20D920D.title: "找到一只毛毛虫（Caterpillar）"
	quest.583A7AA84FEC027F.quest_desc: [
		"在建造任何东西之前，你需要一个建造者。建造者必须先建造自己的建造小屋，才能建造其他小屋，并且不能建造或升级小屋至高于自己小屋等级的水平。"
		""
		"建造者可以说是你殖民地最勤劳的居民（仅次于你）。你并不局限于只有一个建造者。随着殖民地的发展，你可能需要添加更多建造者才能跟得上进度。"
	]
	quest.583A7AA84FEC027F.quest_subtitle: "快把这句话念十遍试试！"
	quest.583A7AA84FEC027F.title: "建造建筑师建筑 (Build the Builder Building)"
	quest.586483D57C8A463E.quest_desc: ["把它看成是黄色的煤炭就行了。"]
	quest.586483D57C8A463E.title: "黄金煤炭"
	quest.587A19FC348387C5.quest_desc: [
		"{atm9.quest.mekanism.desc.endGameMaterials.1}"
		""
		"{atm9.quest.mekanism.desc.endGameMaterials.2}"
	]
	quest.58A736969145DD88.title: "&6动物繁殖 VI"
	quest.58A89F92669A29B6.quest_desc: [
		"&6Copycats&r 是一款简单的模组，能让你把方块伪装成别的方块！"
		""
		"例如，你可以将&bShafts&r的纹理改为&bOak Logs&r，或者让&bCogwheels&r看起来像&bObsidian&r！"
	]
	quest.58A89F92669A29B6.quest_subtitle: "线缆管理！"
