	quest.35EC08D610382860.title: "{atm9.quest.rs.filter}"
	quest.35ED99F39CEB1A51.quest_subtitle: "可在森林、平原、沼泽、桦木林、草地、向日葵平原和河流生物群系中找到。"
	quest.35ED99F39CEB1A51.title: "葡萄"
	quest.35EE5A9C6E88F632.quest_desc: ["可放置在与风箱接触的湿海绵旁边，使装置发出气泡粒子。"]
	quest.35EE5A9C6E88F632.quest_subtitle: "使在该方块上行走的生物会“打滑”。"
