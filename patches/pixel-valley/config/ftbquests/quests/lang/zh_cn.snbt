	]
	quest.33056A7DC8116FA9.quest_subtitle: "将物品附魔至超越其极限的关键材料。"
	quest.33058894ACD9CB06.quest_desc: ["墓园是守墓人埋葬已故市民的地方。当市民死亡时，死亡地点会生成一座坟墓。守墓人会在坟墓消失前尝试回收。成功的话，守墓人会回到墓园并尝试复活该市民。若无法复活，守墓人会将市民埋葬在墓园中，并在另一座坟墓上刻上该市民的名字。"]
	quest.33058894ACD9CB06.quest_subtitle: "建造一个墓地 Graveyard"
	quest.335523405D95D4AF.quest_desc: [""]
	quest.335523405D95D4AF.quest_subtitle: "只有在 &2主世界&r的冰系生物群系中钓鱼才能钓到。"
	quest.335E7C3E45C4B2F5.quest_desc: [
		"可以填充任何类型的沙子、灰尘、粉末，甚至是史莱姆和蜂蜜。"
		"下降时间取决于所用材料的不同。"
		"可以给出一个取决于剩余时间的比较器输出。"
		"可以通过转盘旋转两次或按住 Shift 点击来重置。"
	]
	quest.335E7C3E45C4B2F5.quest_subtitle: "填满后，它将开始缓慢地向下坠落。"
	quest.335E7C3E45C4B2F5.title: "沙漏"
	quest.3371F9248D403664.quest_subtitle: "{atm9.quest.bounty.subt.wither_skeleton}"
	quest.3371F9248D403664.title: "{atm9.quest.bounty.wither_skeleton}"
	quest.340B003A83ADB44C.quest_desc: [
		"&6蓄电器&r是多方块结构，可以储存大量电能。"
		""
		"使用&b扳手&r设置用于充能的输入接口和用于能量分配的输出接口。"
		""
		"&6蓄电器&r可以用以下材料制作："
		""
		"1x &b铜棒&r"
		"2x &b电容器&r"
		"1x &bBrass Casing&r  "
		"1x &b金&r 或 &b电金线&r"
	]
	quest.340B003A83ADB44C.quest_subtitle: "储存电力！"
	quest.341F79AA8F170D8C.title: "获取 512x 金合欢原木"
	quest.34481B0189DB421D.title: "找到一只鹦鹉"
	quest.345F3E083F288BC4.quest_desc: [
		"&6机械臂&r可以在放置点周围5格半径内拾取或放置物品。"
		""
		"运算顺序由其行为和放置时所选方块序列决定。"
		""
		"&6机械臂&r可以用以下材料制作："
		""
		"3x &b黄铜板&r"
		"1x &bAndesite Alloy&r"
		"1x &b精密机械&r"
		"1x &b黄铜外壳&r"
		""
		"&aPondering is recommended.&r"
	]
	quest.345F3E083F288BC4.quest_subtitle: "轻松传输物品！"
	quest.3471547B56F467EA.quest_desc: [
		"制作甜点，首先要从蛋糕面团开始。"
		""
		"Add icing for cake."
		"用刀切开后就能做纸杯蛋糕了。"
		"用擀面杖擀开面团，制作饼干。"
	]
	quest.352CF58BB9AEEF6B.quest_subtitle: "&b平原生物群系"
	quest.353DA1B21AB1201A.quest_subtitle: "光明之翼的开端"
	quest.353DA1B21AB1201A.title: "轻盈的翅膀"
