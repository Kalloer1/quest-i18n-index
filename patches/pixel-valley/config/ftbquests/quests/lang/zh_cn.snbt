	quest.6973A5923AF7BF05.quest_desc: ["{atm9.quest.rs.desc.eliteE}"]
	quest.6973A5923AF7BF05.title: "{atm9.quest.rs.eliteE}"
	quest.699182EA223BDA47.quest_desc: [
		"比原版&aPiston-Slime Block装置&r强大两倍。"
		"如果你从一定高度落在已经伸出的它上面，它还能把你推上去。"
		"无法像普通&a活塞&r一样推动方块，只能推动&e实体&r。"
		"允许站在加长方块上的&e实体&r跳得更高一点。"
	]
	quest.699182EA223BDA47.quest_subtitle: "它会像活塞一样伸出，并将任何位于其上的实体推向移动方向。"
	quest.699182EA223BDA47.title: "Spring 启动器"
	quest.69B21D947864A043.quest_subtitle: "帽子可以和剪刀一起制作成帽子残片！"
	quest.69B21D947864A043.title: "帽子回收系统"
	quest.69EAF1072D492F1A.quest_desc: [
		"远古卷轴是一本发光书籍，由掠夺者在袭击期间掉落。如果你的背包里有远古卷轴，当晚即将发生袭击时，它会发出光芒。"
		""
		"在游戏后期，附魔师可以将远古卷轴转换为附魔书。"
	]
	quest.69EAF1072D492F1A.quest_subtitle: "在快捷栏里留一个备用"
	quest.69F024EACB1534C0.quest_subtitle: "这和我家的蘑菇&b房&r简直绝配。"
	quest.6A111AA679FD828A.quest_desc: [
		"时针显示当前游戏内的小时，而分针则每秒跳动一次。"
		""
		"可以用比较器读取其输出，它会发出从0到15的信号，与游戏内时间（0到24）成正比。"
		"每过一小时游戏时间，就会发出一个能被观察者检测到的方块更新。"
		""
		"点击它即可显示当前时间。"
		"和所有时钟一样，在下界无法使用。"
	]
	quest.6A111AA679FD828A.quest_subtitle: "显示当前的游戏内时间。"
	quest.6A20941BB78F6581.quest_desc: [
		"&6黄铜漏斗&r 可以用以下材料制作："
		""
		"1x &b电子管&r"
		"1x &b黄铜锭&r"
		"1x &b干海带&r"
	]
	quest.6A20941BB78F6581.quest_subtitle: "与安山岩类似，但可以过滤和移动64x的堆叠物品。"
	quest.6A60B76053393288.quest_desc: ["熔炉室是熔炉将矿石熔炼成锭的地方。熔炉室的等级越高，熔炉能使用的熔炉就越多。更高的等级也意味着每块矿石产出的锭有更高的概率翻倍甚至翻三倍。"]
	quest.6A60B76053393288.quest_subtitle: "建造一个熔炉匠台"
	quest.6A884E8ED6D17A42.quest_desc: [""]
	quest.6A884E8ED6D17A42.quest_subtitle: "Only caught when fishing in a &2Swamp&r in the &2Overworld&r."
	quest.6A9D6677D4E914A8.quest_subtitle: "飞行缓慢但火力强大的空中堡垒。"
	quest.6AA2AA88EB43A610.quest_subtitle: "Amongus 中的真菌！"
	quest.6AED092BA3944BFB.title: "Any Automobile Frame"
	quest.6AF4110FFAD2C349.quest_subtitle: "穿戴期间，当你攻击生物或玩家时，会使其中毒4秒。"
	quest.6B04FC81351CD1AB.quest_desc: ["{atm9.quest.rs.desc.wireless}"]
	quest.6B04FC81351CD1AB.quest_subtitle: "{atm9.quest.rs.subt.wireless}"
	quest.6B04FC81351CD1AB.title: "{atm9.quest.rs.wireless}"
	quest.6B0CE8AD86991E28.quest_desc: [
		"堆肥小屋是堆肥机将有机物转化为堆肥的地方，农夫或花匠可以用它来为作物或花卉施肥。"
		""
		"注意：在堆肥器开始工作前，你必须先为小屋配置好要堆肥的物品。 &7&o这听起来就像土拨鼠绕口令一样。&r"
	]
	quest.6B0CE8AD86991E28.quest_subtitle: "建造一个堆肥小屋"
	quest.6B717ED1A349B99B.quest_subtitle: "没有特殊能力。"
	quest.6BB0C51EE8CA5966.quest_desc: [
		"在矿井中，矿工会挖掘矿石和材料。一旦雇佣，矿工会先向下挖掘一条竖井，深度取决于矿井的层级。主竖井完成后，矿工会开始分岔挖掘。挖掘过程中，矿工有时会运气好，挖到矿石块而不是普通的石块。&7&o(魔法！)&r&r"
		""
		"提示：矿工会用填充方块填补孔洞和缝隙，默认是鹅卵石。不过，你可以在矿工小屋的设置中更改填充方块。如果你有林业匠和大量木材，可以考虑使用木板。或者，现在你终于有地方用掉那些深板岩了。"
	]
	quest.6BB0C51EE8CA5966.quest_subtitle: "建造一座矿井"
	quest.6BF78F6CC60AA8C6.title: "生物控制器附加组件"
	quest.6C1B5E8D5F82D470.quest_desc: [
		"&6风车帆&r可以用以下材料制作："
		""
		"1x &b任意羊毛&r"
		"2x &b木棍&r"
		"1x &b安山岩合金&r"
	]
	quest.6C1B5E8D5F82D470.quest_subtitle: "风车建造所必需的组件之一。"
	quest.6C25D42C36175BF4.quest_desc: [
		"{atm9.quest.mekanism.desc.purification.1}"
		""
		"{atm9.quest.mekanism.desc.purification.2}"
		""
		"{atm9.quest.mekanism.desc.purification.3}"
	]
	quest.6C25D42C36175BF4.quest_subtitle: "{atm9.quest.mekanism.subt.clumps}"
	quest.6C455A162CE65350.quest_subtitle: "需要输入能量"
	quest.6CBA3FBF6E9ADB42.quest_subtitle: "使用 Undead Soul 制作而成。"
	quest.6CD0CD5CC6341CF1.quest_subtitle: "拿住我的画布，别让它跑了"
	quest.6CD1720B76F47806.quest_desc: ["{atm9.quest.mekanism.desc.bioFuelEnergy}"]
	quest.6D4E73FD4E5BE2D3.quest_subtitle: "在泥地里跋涉吧，这对你有好处！"
	quest.6D4E73FD4E5BE2D3.title: "&b青蛙村庄"
	quest.6D56AD1BEC644A10.quest_desc: [
		"弓箭训练场是训练弓箭手学徒成为弓箭手的地方。这样他们也能在没有被怪物杀死的风险下升级。"
		""
		"训练中的弓箭手需要一把弓来练习。他们会向靶子射击，靶子是一个靶子方块"
		""
		"提示：建议将招募模式设为自动，这样新招募的村民或长大的孩子，若未在学校就读，将自动开始训练。"
	]
	quest.6D56AD1BEC644A10.quest_subtitle: "建造一个射箭场 Archery"
	quest.6D81DF90E9C2C049.quest_desc: ["{atm9.quest.rs.desc.eliteD}"]
	quest.6D81DF90E9C2C049.title: "{atm9.quest.rs.eliteD}"
	quest.6D8B35C77B1A1A85.quest_subtitle: "为了这个任务，你可能得先放下手里的啤酒了。"
	quest.6DA8B5C48A8CA237.quest_subtitle: "轨道可以通过传送门放置！"
	quest.6DB06E3984D0CF97.quest_desc: ["{atm9.quest.rs.desc.eliteC}"]
	quest.6DB06E3984D0CF97.title: "{atm9.quest.rs.eliteC}"
