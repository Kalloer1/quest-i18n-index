	quest.3E0E51B3216D9365.quest_subtitle: "穿戴此物品可移除施加的凋零效果。"
	quest.3E1E44DB7CA1A86F.title: "将宝可梦升到80级"
	quest.3E484C4FC69E11CD.quest_desc: [
		"&bAstral Crates&r 会在满月期间的任意生物群系中的 &2Overworld&r 被钓上来。它们包含以下内容："
		""
		"&2常见掉落物&r:"
		"- 玻璃"
		"- 月之鱼"
		"- 星夜鲑鱼"
		"- 铁粒和铁锭"
		""
		"&6稀有掉落&r："
		"- 星系海星"
		"- 星云剑鱼"
		"- 钻石"
		"- 天体之杖"
		"- 附魔书籍"
	]
	quest.3E484C4FC69E11CD.quest_subtitle: "点击了解更多详情！"
	quest.3E49D8F42D577D5E.quest_desc: [
		"&b简易鱼饵&r是三种鱼饵类型之一。"
		""
		"它可以被制作并在玩家的物品栏中生效，为所有鱼竿提供+1的诱饵加成。它能与其他两种诱饵协同工作。"
	]
	quest.3E49D8F42D577D5E.quest_subtitle: "点击了解更多详情！"
	quest.3E4BA5B190455DE0.title: "获得 16x 鲑鱼"
	quest.3E54C8B654270D1B.quest_subtitle: "将6个葡萄倒入桶中，然后跳进去等待过程完成。最后，用葡萄酒瓶收集葡萄酒。"
	quest.3E560258E06D47DE.quest_desc: [
		"此诱饵无法钓起，只能在&b黄金&r和&b镀金黑石&r箱中偶尔找到。"
		""
		"另外，它不是鱼，而是一种鱼饵。"
	]
	quest.3E560258E06D47DE.quest_subtitle: "点击了解更多详情！"
	quest.3E6FD833DE230073.quest_subtitle: "穿戴后为玩家提供+4护甲值。"
	quest.3E7BA0A99DFFD97B.quest_subtitle: "给吉米古尔喂食999枚遗迹硬币！"
	quest.3E7BA0A99DFFD97B.title: "获得一只 Gholdengo！"
	quest.3E890BABC4C41370.quest_desc: ["{atm9.quest.rs.desc.grid}"]
