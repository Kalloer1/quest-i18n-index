	quest.3B908E6E3FB427F1.title: "&2动物繁殖 IV"
	quest.3B91163DE3DA885C.quest_desc: [
		"这可能是最危险的工作之一，尤其是在早期。下界矿工会前往下界采矿。矿工通过传送门时，有死亡的风险。因此，请谨慎选择你的工人。"
		""
		"下界矿井中的传送门会将玩家传送到下界。然而，下界矿工并不会真正进入下界，也并不会在下界挖掘任何方块。"
	]
	quest.3B91163DE3DA885C.quest_subtitle: "建造一个下界矿井"
	quest.3BADA9E324F873D7.quest_desc: ["来自&b以太&r的鹅卵石……"]
	quest.3BADA9E324F873D7.title: "完全由石头构成的结构"
