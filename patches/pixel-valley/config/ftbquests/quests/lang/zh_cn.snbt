	quest.08DDE018A804BFE7.quest_subtitle: "{atm9.quest.mekanism.subt.breaksOresIntoDusts}"
	quest.090F991B968EC6CA.title: "橡木原木"
	quest.0935F9F0636D0B6F.title: "&2日志收集 III"
