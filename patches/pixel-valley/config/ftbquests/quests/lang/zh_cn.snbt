	quest.07AD45DCF9EE3C2E.quest_subtitle: "{atm9.quest.mekanism.subt.upgradingToFactories}"
	quest.07C8736E3BD0E3C0.quest_desc: [
		"每连接8个&bWindmill Bearing&r类型的帆状方块，就会额外生成512个&bStress Units&r。"
		""
		"一个&6风车&r使用128个风帆类方块，最多可产生8192个&b压力单位&r。"
	]
	quest.07C8736E3BD0E3C0.quest_subtitle: "使用轴承和风帆来开始发电吧！"
	quest.0822CC29289852C1.quest_subtitle: "和&b王者之岩&r交易能让&b波克基斯&r的怒气大幅降低。"
	quest.08447363A8A4C202.quest_subtitle: "&b森林、丛林、沼泽"
	quest.084C820488A6FD68.title: "&6末地探索进度完成"
	quest.085F473094778DCD.quest_desc: [
		"资源卷轴是告诉建筑师需求的好方法。潜行+右键建筑师小屋，即可将卷轴分配给建筑师。"
		""
		"现在，手持资源卷轴右键时，你会看到所选建造者小屋所需的所有材料。"
	]
	quest.085F473094778DCD.quest_subtitle: "最精细的微观管理，莫过于此"
	quest.08935F23101FE389.quest_desc: [
		"除了盔甲、配饰、附魔等，在 &6BigChadGuys Plus&r 中还有另一种提升属性的方法！部分收集里程碑可提供永久属性加成。以下是每个里程碑的具体内容："
		""
		"{ \"text\": \"Mob Collection - Attack Damage\", \"underlined\": \"true\", \"color\": \"dark_red\",  \"clickEvent\": { \"action\": \"change_page\", \"value\": \"3731A9890D5811CC\" } }"
		""
		"{ \"text\": \"Log Collection - Max Health\", \"underlined\": \"true\", \"color\": \"red\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"76AB52FE499A836F\" } }"
		""
		"{ \"text\": \"Exploration - Movement Speed\", \"underlined\": \"true\", \"color\": \"yellow\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"0C16AD35A6E01EE7\" } }"
		""
		"{ \"text\": \"Ore Collection - Armor Toughness\", \"underlined\": \"true\", \"color\": \"gold\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"46EDB9DC0F5AC44C\" } }"
		""
		"{ \"text\": \"Fish Collection - Luck\", \"underlined\": \"true\", \"color\": \"green\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"673ABD4569E4C55E\" } }"
		""
		"{ \"text\": \"Wildlife Collection - Attack Speed\", \"underlined\": \"true\", \"color\": \"aqua\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"55D01CEB1D098B67\" } }"
		""
		"{ \"text\": \"Crop Collection - Armor\", \"underlined\": \"true\", \"color\": \"blue\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"606B8E7912784AC4\" } }"
		""
		"完成一个收藏后，你就可以开始进阶&6精通&r，这是一种可无限重复的永久属性提升方法。"
		""
		"&9数字要变得更大。&r"
	]
	quest.08935F23101FE389.quest_subtitle: "点击了解更多详情！"
	quest.08A6BE57C0BF34AE.quest_desc: ["真便宜，而且还超级好用！"]
	quest.08A6BE57C0BF34AE.title: "超便宜的，简直白菜价"
	quest.08BA07E77D388A30.title: "Chest Attachment"
	quest.08D2F89323988D17.quest_desc: ["物品宝库无疑是最佳选择。它是一个多区块结构，初始为1x1，最大可扩展至3x3x9。完全展开的宝库可提供惊人的2430个物品栏。确保多区块结构位于单个区块内！"]
	quest.08D2F89323988D17.quest_subtitle: "点击了解更多详情！"
	quest.08D2F89323988D17.title: "物品栏提示"
	quest.08DCED043861CB1A.quest_subtitle: "通过击杀凋零来获得。"
