	quest.442EA6340EA704A8.quest_subtitle: "点击了解更多详情！"
	quest.4434D7B66521D69A.quest_subtitle: "{atm9.quest.mekanism.subt.transferringGasses}"
	quest.44397D6BEAF25251.quest_desc: ["欢迎来到&5The End&r！这里有众多生物群系、生物、树木等等你可以探索！用本章来记录你访问过的生物群系。探索完所有生物群系，你将获得永久性的&e移动速度&r提升！"]
	quest.44397D6BEAF25251.quest_subtitle: "点击了解更多详情！"
	quest.44397D6BEAF25251.title: "&5探索结束"
	quest.443FCE7AB67DA023.quest_subtitle: "用于将苹果捣成泥状。"
	quest.4463CEC85F80FD87.title: "找到一只美洲狮（Ocelot）"
	quest.446C56AA20E9ACE1.title: "击杀 50 只僵尸"
	quest.446CAE53FCE9BA74.quest_desc: ["用于烘干谷物：右键将谷物放入内部。如果正面敞开，物品将被弹出。可放置多个单元以增加容量，形成2x2或3x3的方形，最高可达9格高。"]
	quest.44881E39AB1D62AA.quest_desc: ["{atm9.quest.rs.desc.crafter}"]
	quest.44881E39AB1D62AA.quest_subtitle: "{atm9.quest.rs.subt.crafter}"
	quest.44881E39AB1D62AA.title: "{atm9.quest.rs.crafter}"
	quest.44ADE4C7EBC373CE.quest_subtitle: "在废弃矿井中可找到。"
	quest.44C5973CD376C0C4.quest_subtitle: "在末地堡垒中可找到。"
	quest.44E7ADBFDC06294C.quest_desc: [
		"下雨时，它会发出强度为1的信号。"
		"在雷鸣中 - 威力为 2 的情况下。"
		"同时为下方的方块提供强大的电力。"
	]
	quest.44E7ADBFDC06294C.quest_subtitle: "根据当前天气进行摆动并输出红石信号，信号强度取决于当前天气。"
	quest.44E7ADBFDC06294C.title: "风向标"
	quest.450C39AE75127F3A.quest_desc: ["放置在物品栏旁边时，它会模仿该物品栏的功能。例如，将其放置后，在正面放一个箱子，用漏斗向代理输入物品，物品就会进入箱子。当需要为一个方块设置多个输入点时，这会很实用。"]
	quest.450C39AE75127F3A.quest_subtitle: "点击了解更多详情！"
	quest.4521CFC7E05A8BAC.quest_subtitle: "你需要一把刷子。"
	quest.4521CFC7E05A8BAC.title: "获得一个化石！"
	quest.453B35F69CB3EB69.title: "找到一只墨西哥钝口螈"
	quest.455AB40E9A8F4641.quest_desc: [
		"它们可以被活塞或装置推动，并且在伸出时击中物体将造成&4额外伤害&r。"
		"可以用&9滞留药水&r进行充能。方法有：合成、点击或使用水龙头倒入药水。"
		"它们只能接受负面滞留药水，并且充能无限。"
		""
		"竹尖算作&6玩家击杀&r，即生物被竹尖杀死时会像被玩家杀死一样掉落战利品和经验。"
	]
	quest.455AB40E9A8F4641.quest_subtitle: "会减缓并伤害所有踩上它们的生物的尖刺。"
	quest.45D11540ED89B4E7.title: "找到一只跳跃蜘蛛"
	quest.45E6458B285449BD.quest_desc: [
		"被活塞推动时，它能与任何完整的铁质方块摩擦以产生火花。"
		"附近有易燃方块就会点燃！这样就能拥有一个按需使用的、持续时间无限的打火石和钢。"
		"相反方向也同样有效，也就是说你可以将铁块移向燧石块。"
		"这些交互也适用于 Quark 磁铁。"
	]
	quest.45E6458B285449BD.quest_subtitle: "一种装饰和储物方块，可以用来存放多余的燧石。"
	quest.45FF08E4DB6F7F0E.quest_desc: ["{atm9.quest.rs.desc.iron}"]
	quest.45FF08E4DB6F7F0E.title: "{atm9.quest.rs.iron}"
	quest.460D60F796E4940A.quest_subtitle: "附魔时有小概率掉落。"
	quest.461EAAE527DE42A0.title: "找到一头野猪（Boar）"
	quest.464D5B690548E214.title: "通往末地的喜悦 delight"
	quest.46C3E19658D0965B.quest_desc: [
		"&bFrosted Rod&r无法合成，只能通过&bFrosted Crates&r获得。"
		""
		"是否具有特殊能力尚不清楚，耐久度高达 150。"
		""
		"此外，它无法在岩浆中钓鱼。"
	]
	quest.46C3E19658D0965B.quest_subtitle: "点击了解更多详情！"
	quest.46EDB9DC0F5AC44C.quest_desc: [
		"无论怎么玩，你迟早都需要矿石。虽然获取方式有很多，但有时你只需要亲自动手。"
		""
	]
	quest.46EDB9DC0F5AC44C.quest_subtitle: "点击了解更多详情！"
	quest.46EDB9DC0F5AC44C.title: "&6矿石收集任务"
	quest.47106CE1937C4340.quest_desc: ["{atm9.quest.mekanism.desc.hdpeSheet}"]
	quest.47596C0B283D3771.quest_subtitle: "放置后，它会像海绵一样，用收集到的每个源方块填充流体储罐。"
	quest.4776D3162BDA5C6E.quest_desc: [
		"烹饪生维里迪乌姆所需，可用于制作工具。"
		""
		"主要用于制作Veridium方块，用于制作一种&d强力&r的新锭类型。"
	]
	quest.4776D3162BDA5C6E.title: "烹饪台"
	quest.47E665AFF341A50C.quest_desc: [
		"&6Shafts&r 可以用以下材料合成："
		""
		"2x &b安山岩合金&r"
	]
	quest.47E665AFF341A50C.quest_subtitle: "将旋转力垂直或水平地传递出去。"
	quest.482422CCF29CF20E.quest_desc: [
		"&6座位&r可以用以下材料制作："
		""
		"1x &b任意羊毛&r"
		"1x &b任意木材半砖&r"
	]
	quest.482422CCF29CF20E.quest_subtitle: "You’ll need a place to sit!"
	quest.482E5368CA4D543C.quest_subtitle: "穿戴此物品可防止死亡，使你损失1颗心，并赋予各种效果，同时引发爆炸，对周围一切造成伤害。（冷却时间：600-900秒）"
	quest.4844DEF57A2287B4.quest_desc: ["{atm9.quest.rs.desc.disk_manipulator}"]
	quest.4844DEF57A2287B4.title: "{atm9.quest.rs.disk_manipulator}"
	quest.4859B7F2F440CD07.quest_desc: ["这是一款前期对付首领的&n&e必用&r武器。"]
	quest.4859B7F2F440CD07.title: "螃蟹的领地！"
	quest.4877025DE1D89644.quest_desc: ["等的时间足够长，它们甚至会为你弹奏一曲！"]
	quest.4877025DE1D89644.quest_subtitle: "下雨的时候更可爱了！"
	quest.4877025DE1D89644.title: "找到一个Ribbit（青蛙）"
	quest.488A22BD673898ED.quest_subtitle: "温暖的青蛙"
	quest.488DBE69595F38F8.quest_desc: [
		"{atm9.quest.mekanism.desc.smelter.1}"
		""
		"{atm9.quest.mekanism.desc.smelter.2}"
	]
	quest.488DBE69595F38F8.quest_subtitle: "{atm9.quest.mekanism.subt.poweredFurnace}"
	quest.489A9FAFCBD74572.quest_subtitle: "把它们合成出来，我敢打赌！"
	quest.48A75AAB7D5AD71A.quest_desc: [
		"&b镀金黑石箱&r可以在&4下界&r的&4玄武岩三角洲&r中钓到。需要能钓熔岩的鱼竿，内含："
		""
		"&2常见掉落物&r:"
		"- 黑石"
		"- 抛光黑石砖"
		"- 金锭和金块"
		"- 镀金黑石鲤鱼"
		"- 黑石鳟鱼"
		"- 金苹果"
		""
		"&6稀有掉落&r："
		"- 下界金和金矿石"
		"- 雕凿的抛光黑石砖"
		"- 玄武岩鲈鱼"
		"- 金块"
		"- 镀金黑石"
		"- 马鞍"
		"- 猪步音乐唱片"
		"- 烟熏三文鱼"
		"- 黄金马铠"
		"- 岩浆桶"
		"- 金魚（誘餌）"
		"- 棘背鱼"
		"- 附魔金苹果"
	]
	quest.48A75AAB7D5AD71A.quest_subtitle: "点击了解更多详情！"
	quest.48A75BC9A37CA03E.quest_desc: [
		"每台机器都从网络中获取电力。"
		""
		"&6压力单元&r的容量会随着&b水轮&r、&b风车&r或其他发电机而增加。"
		""
		"如果&6压力单位&r低于0x，网络将进入&c过载&r状态并关闭。"
	]
	quest.48A75BC9A37CA03E.quest_subtitle: "机械组件在网络中的影响或容量。"
	quest.48AC8545D66B71B7.quest_desc: ["恭喜！升级建造者是重要的一步。建造者只能将其他小屋升级到自身小屋的水平。因此，要让建造者升级任何建筑，必须先升级建造者小屋。之后，建造者就能升级其他任何建筑了。"]
	quest.48AC8545D66B71B7.quest_subtitle: "升级一个建造者小屋的等级"
	quest.48CF233D7B66AF36.title: "获得 512x 红树原木"
	quest.48F27EDAF78BF9DC.quest_subtitle: "在丛林生物群系中可找到。"
	quest.48F27EDAF78BF9DC.title: "丛林葡萄"
	quest.490628CE108A833A.quest_desc: [
		"信使往返于仓库和殖民地所有工人小屋之间，为工人运送材料并将成品放入仓库。信使小屋的等级决定了信使能携带的物品数量和同时跟踪的请求数量。"
		""
		"信使不能自己工作。你必须建造一个仓库，并将信使分配到仓库工作。"
		""
		"注意：如果你有多个仓库，快递员只会看到他们被分配到的仓库里的物品。这在后期处理请求时会很有帮助。"
	]
	quest.490628CE108A833A.quest_subtitle: "建造信使小屋"
	quest.492CC1C0507FE008.quest_desc: [
		"可以用线和一些皮革来制作。"
		""
		"真方便！"
	]
	quest.492CC1C0507FE008.title: "应该在原版游戏里才有..."
	quest.493B9FC17C3CF3CA.quest_desc: [
		"兔笼是兔牧人用来饲养和屠宰兔子的地方。你必须捕捉两只兔子并带到兔笼里，因为兔牧人自己不会捕捉兔子。"
		""
		"兔群管理者每个小屋等级只会保留两只兔子，所以在5级时，它们将拥有十只兔子在围栏里。"
	]
	quest.494A71C4E6FD1C8D.quest_subtitle: "&b所有生物群系"
	quest.4966162FBA933453.quest_desc: ["{atm9.quest.rs.desc.262mstorage}"]
	quest.4966162FBA933453.title: "{atm9.quest.rs.262mstorage}"
	quest.49675EA8CBCA1388.quest_subtitle: "{atm9.quest.mekanism.allInOneTool}"
	quest.49772923B8AF0F1F.quest_desc: ["{atm9.quest.rs.desc.1048mfluid}"]
	quest.49772923B8AF0F1F.title: "{atm9.quest.rs.1048mfluid}"
	quest.49793060345FB28C.quest_desc: [
		"牛仔小屋是牛仔挤奶、繁殖和屠宰奶牛以获取皮革的地方。每个小屋等级最多只能保留两头活奶牛，因此在5级时，他们将有十头奶牛在围栏中用于繁殖和屠宰。"
		""
		"注意：&e你必须自己带牛来围栏里。&r"
	]
	quest.498C3B31F012D5CD.quest_desc: [
		"可以在&a铁砧&r中重命名，以更改聊天中显示的名称。将其重命名为“”可完全移除名称。"
		"要发送消息，方块前必须有空格。"
	]
	quest.498C3B31F012D5CD.quest_subtitle: "激活后，向一定半径内的所有玩家发送聊天消息。"
	quest.498C3B31F012D5CD.title: "扬声器方块"
	quest.49A9540C4C045C3D.quest_desc: ["Inventory Trim 就像一个“缓冲区”，让你可以连锁连接许多不直接相邻的背包。只要 Inventory Trim 连接到存储系统，任何与之接触的背包或其他 Trim 都会被链接到系统中。"]
	quest.49A9540C4C045C3D.quest_subtitle: "点击了解更多详情！"
	quest.49BA1FDE738506AB.quest_subtitle: "&b山脉、竹林、针叶林"
	quest.49C35F860DD50F8D.title: "找到村庄"
	quest.49CDA0C4827BC2B2.quest_subtitle: "用于种植丛林葡萄。"
	quest.4A172813B039AE6B.quest_subtitle: "没有特殊能力。"
	quest.4A198E875A6B0A64.quest_desc: ["{atm9.quest.rs.desc.gold}"]
	quest.4A198E875A6B0A64.title: "{atm9.quest.rs.gold}"
	quest.4A3F3F9534E48D5E.quest_desc: [
		"可以通过杀死那些四处蹦跳的、不可思议地可爱的小兔子来获得。"
		""
		"传言说，你还可以让那些兔子坐在你的头上……"
		""
		"&o&7真奇怪？！"
	]
