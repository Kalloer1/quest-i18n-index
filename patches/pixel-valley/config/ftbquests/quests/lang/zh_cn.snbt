	quest.4B20AAF81A1DAF1D.quest_subtitle: "用于装瓶、装桶或与液体进行合成。"
	quest.4B36949CD065FCBB.quest_subtitle: "旋转任何可旋转的方块类型。"
	quest.4B384ED77AFFC7D4.quest_desc: [
		"&6扳手&r"
		""
		"右键点击组件并用&6扳手&r可以旋转它。右键点击组件、红石组件或轨道可以将其拆除并放入背包。潜行状态下右键点击可拆除交互式方块。"
		""
		"&6扳手&r 可以用以下材料制作："
		""
		"3x &b金质薄片&r"
		"1x &bCogwheel&r"
		"1x &b木棍&r"
		""
		"工程师护目镜 &6Engineer's Goggles&r"
		""
		"佩戴&6工程师护目镜&r时，可查看运行机器的应力冲击、显示数字并在注视&b应力计&r或&b速度计&r时高亮当前转速，还能显示储罐的液位和总容量。"
		""
		"&6工程师护目镜&r的合成配方如下："
		""
		"1x &bString&r"
		"2x &b任意玻璃&r"
		"1x &b黄金薄片&r"
	]
	quest.4B384ED77AFFC7D4.quest_subtitle: "点击了解更多详情！"
	quest.4B384ED77AFFC7D4.title: "制作工程工具（Craft Engineering Tools）"
	quest.4B51836028C8BDE8.quest_desc: [
		"和主世界的铁制装备一样坚固。"
		""
		"但耐久度消耗得越多，挖掘速度就越快。"
		""
		"这把剑的伤害输出还会随着耐久度的多少而增加。"
		""
		"可以挖掘 &2Skyjade&r 和 &dGravitite&r 矿石"
	]
	quest.4B51836028C8BDE8.title: "Zanite 工具套装"
	quest.4B5B12608410AFDB.title: "深色橡木原木"
	quest.4B77EE0A74D55BEC.quest_subtitle: "由凋灵掉落。"
	quest.4B81E84CAE814BA9.quest_desc: ["{atm9.quest.rs.desc.64kfluid}"]
	quest.4B81E84CAE814BA9.title: "{atm9.quest.rs.64kfluid}"
	quest.4BA827EDA2F6DA23.quest_desc: ["这与 Inventory Cable Connector 的工作原理完全相同，但增加了过滤功能。你可以指定要放入物品栏的具体物品，并设置诸如“保留最后一个物品”等选项。与多态过滤器结合使用时尤其有用。此外，你还可以设置优先级，来决定它是第一个插入/提取物品的物品栏，还是最后一个。"]
	quest.4BA827EDA2F6DA23.quest_subtitle: "点击了解更多详情！"
	quest.4BDE773C3359D584.quest_subtitle: "{atm9.quest.mekanism.subt.miniRobot}"
	quest.4BE1C5F8E8F09016.quest_desc: [
		"&bRod of Souls&r无法合成，只能通过&bSoul Crate&r获得。"
		""
		"捕获任何生物时，经验值产量会额外增加 +5，耐久度高达 250。"
		""
		"此外，它还能在岩浆中钓鱼。"
	]
	quest.4BE1C5F8E8F09016.quest_subtitle: "点击了解更多详情！"
	quest.4BE722FA1D056106.quest_desc: [
		"这就是&b以太&r探索者的梦想，&a必得&r的&n物品！&r"
		""
		"把它看作一个汇集了&2所有&r新&bAether&r物品/方块的维基。"
		""
		"只需打开它，并在书中的槽位中添加物品/方块，即可了解更多信息。"
	]
	quest.4BE722FA1D056106.title: "Da Wiki!"
	quest.4BFC5627EBC60A9A.quest_subtitle: "由茶花绽放而成。"
