	quest.4CD83943865018EA.title: "{atm9.quest.rs.exporter}"
	quest.4CF6B343FE51F81F.quest_desc: [
		"&n&6                                                 &r&6"
		"&2MineColonies&f is an interactive building mod that allows you to create your own thriving town within Minecraft.\\nIt lets your leadership skills soar by providing you with everything you need to build your kingdom. \\nMineColonies gives you the flexibility to create a colony as unique as every player. \\n\\nWith so many options, you’ll create a different colony every time, adapt to any biome, build inside a mountain, on top of one, under the ocean, or in the sky. \\nThe limit is your imagination! \\n\\nMineColonies features &6NPC workers &fsuch as Builders, Farmers, Fishers, Foresters, Guards, Miners, Smelters, Bakers, Cooks, Couriers, five types of animal herders, Composters, and many more, with even more being developed and added as the mod grows.\\n\\nIt also includes specialized buildings such as the Warehouse, House, Town Hall, Barracks, Library, University, and even the School."
		"&n&6                                                 &r&6"
	]
	quest.4D4D004CFD92E40D.quest_desc: [""]
	quest.4D4D004CFD92E40D.quest_subtitle: "只有在&4下界&r的&4灵魂沙峡谷&r钓鱼才能钓到。需要能抵御岩浆的鱼竿。"
	quest.4D52DEC4EEDEEC0D.quest_subtitle: "那些宝可梦根本没有任何胜算！"
	quest.4D52DEC4EEDEEC0D.title: "解锁 &6Cobblemon Industrialized"
	quest.4D5F9E9A9CA701B5.quest_desc: [
		"要分配&6时间表&r，右键点击列车控制器（&b生物&r或位于&b列车控制台&r的&b烈焰燃烧器&r）并选择&6时间表&r。右键点击&6时间表&r以添加命令。"
		""
		"要识别车站，请输入&b车站&r名称或使用“&b*&r”作为通配符。"
		""
		"您可以为&6日程&r设置旅行条件。"
		""
		"&6车站留下的时刻表&r在停靠时将自动替换列车长的时刻表。"
		""
		"&6列车时刻表&r可以用以下材料合成："
		""
		"1x &b坚固的薄片&r"
		"1x &b纸&r"
		""
		"&aPondering is recommended.&r"
	]
	quest.4D5F9E9A9CA701B5.quest_subtitle: "用生物来操控你的火车吧！"
	quest.4D87DE75948AB8F5.quest_subtitle: "在针叶林群系中可找到。"
	quest.4D87DE75948AB8F5.title: "泰加葡萄"
	quest.4D8CAD708E7BCB8B.quest_subtitle: "快刀乱麻！"
	quest.4D98552BA5389769.title: "找到一条响尾蛇"
	quest.4D9DC4973FD340E5.quest_desc: [
		"战斗学院是训练骑士的地方，让他们能安全升级，不用担心被怪物杀死。"
		"见习骑士需要剑和盾来练习。他们会攻击靶子，即干草垛顶部的南瓜。"
		""
		"提示：建议将招募模式设为自动，这样新招募的村民或长大的孩子，若未在学校就读，将自动开始训练"
	]
	quest.4D9DC4973FD340E5.quest_subtitle: "建造一座战斗学院"
	quest.4DD7E2BD8508A117.quest_subtitle: "建造每种牧民小屋各一个。"
	quest.4DF782D7E2E59DAF.quest_desc: [
		"若附魔了&3Stasis&r，它就能在瞄准的任何空中位置放置&aSoap Bubble Blocks&r。"
		""
		"方块会悬浮在空中一段时间，或者直到被踩到为止。"
		"&aSoap Blocks&r 可以被其他方块替换，这在建造时非常有用。"
	]
	quest.4DF782D7E2E59DAF.quest_subtitle: "一个有趣的道具，可以用来向朋友们吹肥皂泡。"
	quest.4DFC015406B24BD2.quest_desc: [
		"可显示和存储3行文本。"
		"猫有时会坐在上面。"
		"可以在其下方隐藏一件物品。为此，请按住 Shift 键并点击除顶部以外的任意一面。"
	]
	quest.4DFC015406B24BD2.quest_subtitle: "欢迎回家。"
	quest.4E1028C40D8026C9.title: "找到一个发光鱿鱼"
	quest.4E609BA887E082A1.quest_desc: [
		"用法"
		""
		"&b覆盖物&r可以逐个施加到&b浆果树&r上。使用铲子与树木互动或摧毁树木即可移除。"
		""
		"覆盖物类型"
		""
		"&bMulch&r 是一种用于制作各种类型 &bMulch&r 的物品。它是为 &bberry trees&r 应用修饰符和突变 &bRevival Herbs&r 所用的 &bMulch&r 的基本组件。"
	]
