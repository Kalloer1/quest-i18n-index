	]
	quest.58B125BD4876054C.quest_subtitle: "{atm9.quest.mekanism.subt.startFactory}"
	quest.58B125BD4876054C.title: "{atm9.quest.mekanism.mekanism}"
	quest.58BD19F69DAFAD11.quest_subtitle: "哎呀，你把孢子弄得到处都是，全沾我身上了！"
	quest.58DE5B0AEE1B91F4.quest_subtitle: "没有特殊能力。"
	quest.592E74E7C40A121B.quest_desc: [
		"一旦物品被取走或移走，基座方块会发出观察者可检测到的更新。（如果用袋子替换物品，可以阻止这种情况）"
		"将末地水晶放置在基座上，该方块会释放出相当于3个书架的附魔之力。这意味着用5个这样的方块，你就能将附魔台升到最高级。"
	]
	quest.592E74E7C40A121B.quest_subtitle: "能精美地展示放置在其上的物品。"
	quest.592E74E7C40A121B.title: "基座"
	quest.593A6F72F8CC705B.quest_desc: [
		"&6机械搅拌机&r可以用以下材料制作："
		""
		"1x &bCogwheel&r"
		"1x &b安山岩外壳&r"
		"1x &bWhisk&r"
		""
		"&6Basins&r 可以用以下材料制作："
		""
		"5x &b安山岩合金&r"
	]
	quest.593A6F72F8CC705B.quest_subtitle: "解锁混合配方！"
	quest.593A6F72F8CC705B.title: "制作一个机械搅拌器和搅拌盆"
	quest.593D8AA322E8AC87.quest_subtitle: "提供幸运度加成！"
	quest.594395364ABEF2D5.quest_desc: [
		"&b钱包&r是存放所有珍贵&2绿宝石&r的绝佳工具！"
		""
		"没有持有上限，一旦你的&2Emeralds&r存入钱包，就会安全地储存在云端。再也不用担心丢失了。"
		""
		"此外，每三十分钟，你的当前余额会自动赚取 &b3.00%&r 的利息。 &9我喜欢复利！&r"
	]
	quest.594395364ABEF2D5.quest_subtitle: "点击了解更多详情！"
	quest.597FDDB36D19A4C1.quest_desc: [
		"&6铜制外壳&r可以通过以下方式制作："
		""
		"用&b铜锭&r右键点击&b去皮的原木&r。"
	]
	quest.597FDDB36D19A4C1.quest_subtitle: "流体处理的主要构建模块。"
	quest.59949627F59998FB.title: "马鞍式桶状附加组件"
	quest.59E6FF98506E2670.quest_desc: [""]
	quest.59E6FF98506E2670.quest_subtitle: "可以在任何地方的&4下界&r捕捉。需要能抵御岩浆的鱼竿。"
	quest.59F5ED931FD70C55.quest_desc: ["{atm9.quest.rs.desc.autocrafting}"]
	quest.59F5ED931FD70C55.title: "{atm9.quest.rs.autocrafting}"
	quest.5A0187C7D97C2BCE.quest_subtitle: "&b山脉"
	quest.5A11A2FC20E5CE2A.quest_desc: [
		"兵营是保护殖民地的终极防御。兵营塔（与普通守卫塔不同）每建造一层就会雇佣并安置一名守卫，每座兵营塔总共可容纳5名守卫！"
		""
		"在游戏后期，你可能需要两个营房，里面塞满了&m可消耗&r的勇士。"
		""
		"提示：3级时，你可以花5金币雇佣间谍，他们会外出探索，发现野蛮人后会精确报告位置。"
	]
	quest.5A11A2FC20E5CE2A.quest_subtitle: "建造一座兵营 Barracks"
	quest.5A143952EAB7643E.quest_desc: [
		"找到并探索一个 &c青铜&r 地牢。"
		""
		"这是最简单的地牢，里面有一些很棒的战利品。"
		""
		"几乎可以在&bAether&r的任何地方找到。"
		""
		"只要留意那些看起来像洞穴的秘密入口就行了。"
	]
	quest.5A143952EAB7643E.title: "滑入行动！"
	quest.5A46B52B5DA5EFAD.title: "织布机附加组件"
	quest.5A5E440BCAB1F234.quest_subtitle: "将绿茶茶叶块放置晾干，然后将其破坏。"
	quest.5A80AA86B628E054.title: "获得 256x 猴面包树原木"
	quest.5A8CED2FA0528644.title: "找到一只短吻鳄"
	quest.5A8DA19AF6406B75.quest_desc: [
		"&bAether&r的钻石稀有度。"
		""
		"这个方块有一个非常独特的特性，当它上方没有方块时，它会一直向上漂浮，直到碰到另一个方块为止。"
		"所以如果你不小心，可能会在天空中丢失这个方块！"
		""
		"&o&7*矿石的名字已经说明了一切……"
	]
	quest.5A8DA19AF6406B75.title: "上升之物，必将..."
