	quest.76A38CCA5816CDAD.quest_desc: ["{atm9.quest.mekanism.desc.hdpePellet}"]
	quest.76A38CCA5816CDAD.title: "{atm9.quest.mekanism.hdpePellets}"
	quest.76AB52FE499A836F.quest_desc: [
		"&2木材&r是重要的合成材料。无论是建造漂亮的木屋还是搭建储物系统，你都需要大量的木材！"
		""
		"砍树的时候，你可能会想尝一尝木屑。吃了之后会让你变得又大又强壮！"
		""
	]
	quest.76AB52FE499A836F.quest_subtitle: "点击了解更多详情！"
	quest.76AB52FE499A836F.title: "&2日志收集任务"
	quest.76ACE39353BD3E1E.title: "丛林树苗"
	quest.76BFA895891ABF82.quest_subtitle: "&b滴水石、山脉、沙质、火山岩"
	quest.76CEB4448678387E.quest_subtitle: "苦力怕们，小心了！"
	quest.76CEB4448678387E.title: "猫咪拖鞋"
	quest.77001E3F7E10D0E0.quest_subtitle: "穿戴期间，恶魂会把你视为盟友，除非你先攻击它们，否则它们不会攻击你。"
	quest.7725934752CF6D2D.quest_desc: [""]
	quest.7725934752CF6D2D.quest_subtitle: "只有在 &2主世界&r的冰系生物群系中钓鱼才能钓到。"
	quest.77409DA4D0918CF8.quest_desc: [
		"你需要找到葡萄藤丛来收集第一批葡萄。如果找不到，偶尔会有流浪酿酒师来访，可能会提供一些种子。你可以通过吃葡萄来获得种子。"
		""
		"收获第一批葡萄后，你可以直接吃掉，或者把它们放进锅里，通过跳跃和走动来踩碎。接着，用空酒瓶就能提取出葡萄汁。装满的葡萄酒瓶可以在酒桶中精炼，加入甜浆果、蜂蜜等额外配料。不同类型的葡萄汁和配料会酿出不同的葡萄酒。"
	]
	quest.77409DA4D0918CF8.quest_subtitle: "点击了解更多详情！"
	quest.77409DA4D0918CF8.title: "&6酿酒坊"
	quest.7746EAEC46FA0391.quest_desc: [""]
	quest.7746EAEC46FA0391.quest_subtitle: "Only caught when fishing in a &2Mesa&r in the &2Overworld&r."
