	quest.77FC692AC94D2EEF.title: "{atm9.quest.bounty.creeper}"
	quest.7810F69B0F6826AE.quest_desc: [
		"用于孵化你在旅途中收集到的莫阿蛋。"
		""
		"孵化鸡蛋，它们就会孵化成小莫阿。"
		"当小Moa出生时，它需要喂食一种名为&eAechor Petal&r的食物。"
		""
		"当幼年Moa吃完&ax3 &eAechor Petals&r后完全长大，就会变成成年的Moa，只要装备了鞍具就可以骑乘。"
	]
	quest.7810F69B0F6826AE.title: "请不要把我烤焦！"
	quest.781390CC2B2CA30D.quest_subtitle: "&4+30% 燃料需求&r，&a+40% 引擎功率"
	quest.781C72CE49A4CB77.quest_subtitle: "刷掉遗迹中找到的任何可疑方块"
	quest.782F0F3C3DC4E181.title: "找到一只猫"
	quest.7870800C28A7E199.quest_desc: [
		"养鸡人的小屋是养鸡人饲养鸡、收集鸡蛋和宰杀鸡获取食物的地方。你必须捕捉并带回两只鸡到养鸡人的小屋，因为养鸡人自己不会捕捉和带回任何鸡。"
		""
		"养鸡人每个小屋等级只会保留两只鸡，所以在5级时他们将有十只鸡。"
	]
	quest.7870B399950FE7D2.title: "旗帜杆附属物"
	quest.787415570026FFAA.quest_desc: ["{atm9.quest.rs.desc.destructor_upgrade}"]
	quest.787415570026FFAA.title: "{atm9.quest.rs.destructor_upgrade}"
	quest.79264DBB440336BB.quest_desc: [
		"当&bEncased Fan&r的气流经过特定方块时，下游气流会对物品施加相应的处理。"
		""
		"对于&9洗涤&r，当空气穿过&b水&r或任何被水浸透的方块时发生。"
		""
		"在&8吸烟&r的情况下，气流会与&b火焰&r、&b篝火&r、点燃的带&b火石和钢&r的空&b烈焰燃烧器&r，或&b正在闷烧&r的&b烈焰燃烧器&r相互作用。"
		""
		"对于&c爆破&r，气流会受到&b岩浆&r或&b烈焰燃烧器&r（已&b点燃&r）的影响。"
		""
		"最后，当气流经过 &bSoul Fire&r、&bSoul Campfire&r，或用 &bFlint and Steel&r 点燃并右键点击了 &bSoul Sand&r 或 &bSoul Soil&r 的空 &bBlaze Burner&r 时，就会发生 &dHaunting&r。"
		""
		"&6Encased Fans&r 可以用以下材料合成："
		"1x &bShaft&r"
		"1x &b安山岩铸造台&r"
		"1x &b螺旋桨&r"
	]
	quest.79264DBB440336BB.quest_subtitle: "根据旋转力的方向推动或拉动空气。"
	quest.793872C2B7823588.quest_desc: [""]
	quest.793872C2B7823588.quest_subtitle: "可以在任何地方捕捉到，位于 &5末地&r 中。"
	quest.7965C616577FBD06.quest_desc: ["与篝火类似，但可以容纳一叠物品。需要放置在篝火、炉子或岩浆块等高温方块上。"]
	quest.7965C616577FBD06.quest_subtitle: "点击了解更多详情！"
	quest.797194AB19CFE439.quest_desc: [
		"在相应动物上对其&6右键单击&r，即可将其绑定到特定的&e宠物&r（或&e马&r）。"
		"绑定的&a笛子&r只会召唤它所绑定的&e宠物&r。"
		"使用时会播放一首随机歌曲。"
		"如果重命名为现有歌曲的名称，它将一直播放该歌曲。"
	]
	quest.797194AB19CFE439.quest_subtitle: "可以播放来召唤附近未坐下的已驯服的宠物。"
	quest.798E0926D64DC265.quest_subtitle: "用于创造能量和加工资源的模组"
	quest.798E0926D64DC265.title: "欢迎来到机械动力模组的世界"
	quest.79934B41A7B454E7.quest_subtitle: "趣闻：它能在短短一分钟内爬上一座2000英尺高的建筑！"
	quest.79B0C137266CD6C3.title: "云杉原木"
	quest.7A23DAFCF1105670.quest_desc: [
		"使用此过滤器，漏斗可以读取连接的物品栏，并且只有在指定物品栏中的物品匹配时，才会从系统中提取物品。"
		""
		"例如："
		"如果一个箱子含有泥土、圆石和橡木原木，而系统中含有泥土、圆石、深板岩和砾石，应用此过滤器后，系统将把所有物品栏中的泥土和圆石取出并放入该箱子中。"
	]
	quest.7A23DAFCF1105670.quest_subtitle: "点击了解更多详情！"
	quest.7A35F1CBF73434F1.title: "获得 512x 原始黄金"
	quest.7A397672AB2B9B91.quest_desc: [""]
	quest.7A397672AB2B9B91.quest_subtitle: "只有在 &4Nether&r 的 &4Basalt Deltas&r 中钓鱼才能钓到。需要能抵御岩浆的鱼竿。"
	quest.7A63548AAD9C5A59.title: "获得 1x 鳕鱼"
	quest.7A6D6E0664DCEFAF.quest_desc: [
		"&6设置轨道&r：放置一个&b轨道&r并用&b车站&r右键点击，或将&b车站&r放置在其附近。"
		""
		"&6进入组装模式&r：右键点击&b车站&r，选择“创建列车”（蓝色旗帜会出现）。"
		""
		"&6添加Bogeys&r：将&bTrain Casings&r放置在蓝色标记区域上，将其变为&bBogeys&r。"
		""
		"&6安装控制器&r：将&b火车控制器&r朝向车站箭头放置。对于双向火车，需添加朝向相反方向的控制器，并为驾驶员添加&b座位&r或&b烈焰燃烧器&r。"
		""
		"&6连接部件&r：使用&b强力胶水&r将所有&b火车&r组件（高亮绿色）连接起来。"
		""
		"&6组装火车&r：使用&b车站&r的界面来组装和命名&b火车&r。如果组装失败，界面会显示错误信息。"
		""
		"&aPondering is recommended.&r"
	]
