	quest.773EFC795A3B8AFF.quest_desc: [
		"你好 {Player}，欢迎来到 Antarchy Craft。"
		"本章将带你度过最初几天：获取木材、石头、食物、铁、钻石，并踏上前往下界之路。"
		"本页边缘是通往书中其他所有章节的入口。每当你完成某个任务，其对应的入口就会亮起。因此，你在这里的进度越深，整个整合包的内容就会解锁得越多。"
	]
	quest.773EFC795A3B8AFF.title: "开始吧"
	quest.7745B8423AF97664.quest_desc: ["一个模组里的导弹发射器，另一个模组里的核弹。没人需要如此强大的火力。但还是把它做出来吧。"]
