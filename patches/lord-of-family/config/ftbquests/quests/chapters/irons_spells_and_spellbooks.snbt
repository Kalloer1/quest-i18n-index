	quest_links: [ ]
	quests: [
		{
			dependencies: ["2B262DE8BCC8434C"]
			description: [
				"模组的最开端。"
				""
				"允许你将法术卷轴绑定到法术书上，这样在法力耗尽前可以无限使用它们。"
				""
				"法术也可以从法术书中取出来。"
				""
				"将咒语书放入奇物栏后，可按 &4R 打开咒语轮盘&f，&bV 施放所选咒语&f，或按住 &6左 Alt 并滚动 &f来更换所选咒语。"
			]
