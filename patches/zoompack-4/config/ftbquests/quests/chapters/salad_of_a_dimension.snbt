				type: "item"
			}]
			title: "Utherium"
			x: 1.0714285714285694d
			y: -3.5071428571428456d
		}
		{
			dependencies: ["01130E9743A8E5A5"]
			description: ["&7在远古遗忘守卫的遗迹中，隐藏着一种名为遗忘钢的稀有材料。这种金属由地下花园的过往精华锻造而成，既坚固又神秘。要获得它，需击败遗忘守卫并夺取其精华。将精华熔炼成遗忘钢锭，这是锻造强大遗物和装备的关键资源。驾驭被遗忘的力量，掌握地下花园失落历史的伟力！"]
			id: "55BA21A39EB22E95"
			rewards: [
				{
					exclude_from_claim_all: true
					id: "421DFEF52BA82921"
					table_id: 9153771261078832289L
