	order_index: 4
	quest_links: [ ]
	quests: [
		{
			dependencies: ["443C276C7BAB15D6"]
			description: ["&7点燃传送门后，是时候踏入笼罩在黑暗与神秘中的Undergarden了。穿过门槛，准备好迎接一个充满独特资源和危险生物的全新世界。保持警惕——在Undergarden生存需要勇气与智慧。探索这片诡异的地形，收集稀有材料，揭开被遗忘已久的秘密。前方的旅程充满艰险，但敢于深入者必将获得丰厚回报。"]
			icon: "theabyss:infected_grass"
			id: "4FF94E7816313E70"
			rewards: [{
				exclude_from_claim_all: true
				id: "202536AA7EA8C29D"
				table_id: 1610080839990707444L
				type: "choice"
			}]
			size: 2.0d
			tasks: [{
				dimension: "undergarden:undergarden"
				id: "500A7E6E286D64F5"
				type: "dimension"
			}]
			title: "隐藏丛林 第2部分"
			x: -1.0714285714285694d
			y: 2.6357142857142932d
		}
		{
			description: ["&7下界在召唤，但要抵达那里，你必须先掌握它的催化剂。在表世界深处，存在着催化剂，一种用于进入名为“下花园”的神秘领域的稀有物品。通过探索或合成来寻找这件珍贵的物品。获得后，用石砖建造传送门框架，并用催化剂激活。诡异的荧光将揭示通往下花园的入口——一个充满奇异植物、不祥生物和未知秘密的地方。准备好迎接未知吧！"]
			id: "443C276C7BAB15D6"
			rewards: [{
				id: "5DC4354913D3DA8D"
				type: "xp_levels"
				xp_levels: 1
			}]
			size: 2.0d
			subtitle: "用它来点燃由石砖制成的传送门"
			tasks: [{
				id: "13C1946AD858B569"
				item: "undergarden:catalyst"
				type: "item"
			}]
			title: "隐藏丛林 第1部分"
			x: 1.0d
			y: 0.0d
		}
		{
			dependencies: ["4FF94E7816313E70"]
			description: ["&7Undergarden 的冰冷深处隐藏着一种宝贵资源：Froststeel。这种融入了世界冰霜本质的稀有金属，因其强度和耐用性而备受追捧。要获得它，你必须深入 Undergarden 的冰霜生物群系，开采 Froststeel Ore。在熔炉中熔炼矿石以制作 Froststeel Ingots——这是锻造能抵御最恶劣环境的强大工具和盔甲的关键材料。勇敢面对严寒，让霜雪指引你走向无尽的强大！"]
			id: "5C0F5BD4A341EE6E"
			rewards: [
				{
					id: "5B75FCD6458F5AB1"
					type: "xp_levels"
					xp_levels: 3
				}
				{
					count: 3
					id: "005BEEECAD58E057"
					item: "undergarden:froststeel_ingot"
					type: "item"
				}
				{
					exclude_from_claim_all: true
					id: "389D73A4010109D9"
					table_id: 9153771261078832289L
					type: "choice"
				}
			]
			size: 2.0d
			subtitle: "Subzero"
			tasks: [{
				count: 5L
				id: "1725BF464C7EA407"
				item: "undergarden:froststeel_ingot"
				type: "item"
			}]
			title: "钢铁之霜"
			x: -2.642857142857139d
			y: 0.5642857142857309d
		}
		{
			dependencies: ["5C0F5BD4A341EE6E"]
			description: ["&7Undergarden的沼泽之下，藏着一份宝藏：泥锭。这种由Cloggrum矿石和王国富饶的泥土锻造而成的特殊金属，蕴含着惊人的强度。要制作这些锭，收集Cloggrum矿石，并与Undergarden黑暗沼泽生物群系中的浓密泥土相结合。熔炼混合物以创造泥锭，这是一种非常适合制作具有独特属性的耐用装备的材料。拥抱泥泞，因为其中蕴含着坚韧工具和盔甲的关键！"]
			id: "59666E245031C7ED"
			rewards: [
				{
					id: "04E6736682CDD64D"
					type: "xp_levels"
					xp_levels: 3
