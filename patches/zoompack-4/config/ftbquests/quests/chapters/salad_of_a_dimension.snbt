			shape: "octagon"
			size: 3.0d
			subtitle: "在地下地牢中找到并杀死一个被遗忘的守卫者"
			tasks: [{
				entity: "undergarden:forgotten_guardian"
				id: "2D31B83F2AF5AD0F"
