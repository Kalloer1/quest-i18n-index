	order_index: 2
	quest_links: [ ]
	quests: [
		{
			description: ["&7传说在云层之上，有一个名为Aether的神秘世界——漂浮的岛屿、古老的遗迹和神圣的生物。要到达这个迷人的维度，你需要用Glowstone制作传送门，并用Water点燃。激活后，传送门将带你前往Aether令人惊叹的天空，迎接新的冒险、挑战和宝藏。准备好迎接这个神圣世界的奇妙与危险吧！"]
			icon: "minecraft:glowstone"
			id: "55494C46BBB4B12E"
			rewards: [{
				exclude_from_claim_all: true
				id: "0E5974265F234D4A"
				table_id: 1610080839990707444L
				type: "choice"
			}]
			shape: "square"
			subtitle: "建造一个传送门以进入Aether维度"
			tasks: [{
				dimension: "aether:the_aether"
				id: "4D67F63180730817"
				type: "dimension"
			}]
			title: "在云端漫步，无比惬意"
			x: -0.5d
			y: 6.0d
		}
		{
			dependencies: ["55494C46BBB4B12E"]
			description: ["&7Deep within the floating islands of the Aether, a rare and powerful gem known as Zanite lies hidden. This vibrant purple crystal is said to grow stronger as it takes damage, making it highly sought after by adventurers. Your mission is to explore the Aether’s treacherous caves and towering cliffs to mine Zanite Ore. Be prepared to face the challenges of the Aether’s unique environment, including hostile creatures and tricky terrain. Gather enough Zanite to craft powerful tools and armor, and harness the true potential of this mystical gem."]
			id: "67238295F602FF1E"
			rewards: [{
				id: "4B9A4511109D4B25"
				type: "xp_levels"
				xp_levels: 2
			}]
			shape: "square"
			subtitle: "开采一些扎奈特矿石"
			tasks: [{
				count: 15L
				id: "124892B4357D392B"
				item: "aether:zanite_gemstone"
				type: "item"
			}]
			title: "廉价紫水晶"
			x: -0.5d
			y: 3.5d
		}
		{
			dependencies: ["67238295F602FF1E"]
			description: ["&7只在Aether的葱郁景观中生长的鲜艳Aechor植物，蕴藏着独特的宝藏：Aechor花瓣。这种精致的花瓣以其强大的特性而闻名，可用于制作和炼金。你的任务是追踪这些难以捉摸的植物，它们通常生长在由敌对生物守护的危险高海拔地区。请谨慎行事，因为Aechor植物在受威胁时会释放有毒孢子。采集到Aechor花瓣后，你将获得一种宝贵的材料，可以提升你在神秘Aether世界中的制作和药水酿造能力。"]
			id: "45A1F8526A688E67"
			rewards: [
				{
					exclude_from_claim_all: true
					id: "611DF0D8242CC10E"
					table_id: 4116256588204561948L
					type: "loot"
				}
				{
					id: "2A5FE1B728E7CEC0"
					type: "xp_levels"
					xp_levels: 2
				}
			]
			shape: "square"
			subtitle: "杀死一朵花"
			tasks: [{
				id: "25E7026E19A115A1"
				item: "aether:aechor_petal"
				type: "item"
			}]
			title: "马里奥植物"
			x: 1.5d
			y: 2.0d
		}
		{
			dependencies: ["67238295F602FF1E"]
			description: ["&7雄伟的蓝莫阿，原产于以太的珍稀鸟类，以其强大的能力和醒目的蓝色羽毛而闻名。这些生物因其忠诚度和能驮着骑手翱翔以太广阔天空的能力而备受珍视。你的任务是找到一只蓝莫阿并获得一枚它的蛋。在它们筑巢的浮空岛上搜寻，但要小心——它们会凶猛守护。找到蛋后，小心地带回你的基地，在那里你可以孵化并养育你自己的蓝莫阿，为未来的冒险解锁天空。"]
			id: "332A0C087A610042"
			rewards: [
				{
					exclude_from_claim_all: true
					id: "74520569170F069E"
					table_id: 7743076479955517786L
					type: "loot"
				}
				{
					exclude_from_claim_all: true
					id: "6D01B658A501FA4B"
					table_id: 4116256588204561948L
					type: "loot"
				}
			]
			shape: "square"
			subtitle: "杀死以太鸡"
			tasks: [{
				id: "6B1F25D077AEB272"
				item: "aether:blue_moa_egg"
				type: "item"
			}]
			title: "渡鸦之卵"
			x: 1.5d
			y: 5.0d
		}
		{
			dependencies: ["332A0C087A610042"]
			description: ["&7孵化器是在以太中培育奇异生物的关键工具，能让你孵化并养育稀有蛋，使其成为忠诚的伙伴。要获得这件珍贵物品，你必须寻找以太浮岛上古老而隐秘的结构。孵化器通常存放在戒备森严的宝箱中，或由技艺精湛的工匠制作。穿越险峻地形，抵御以太凶猛的居民，才能找到孵化器。一旦拥有，你就能孵化并养育以太的独特生物，拓展你在这片天界中的冒险之旅。"]
			id: "0E800C6CDF4A9BC5"
			rewards: [
				{
					exclude_from_claim_all: true
					id: "5623A9887247D72A"
					table_id: 4116256588204561948L
					type: "loot"
				}
				{
					id: "5C9B1DC74A40E6F3"
					type: "xp_levels"
					xp_levels: 2
				}
			]
			shape: "square"
			subtitle: "用于烹饪鸡蛋的道具"
			tasks: [{
				id: "0E444D16D00D5E61"
				item: "aether:incubator"
				type: "item"
			}]
			x: 3.0d
			y: 4.0d
		}
		{
			dependencies: ["67238295F602FF1E"]
			description: ["&7神秘的以太领域蕴藏着凡人无法企及的强大神器。你的任务是深入这片神圣领域，找回以太祭坛——据说它能放大天堂本质的神圣构造物。"]
			id: "2EA1095579D85C17"
			rewards: [
				{
