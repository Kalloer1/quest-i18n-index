				type: "choice"
			}]
			shape: "diamond"
			size: 1.5d
			subtitle: "找到一个传送门，并用狂热打火机点燃它"
			tasks: [{
				dimension: "blue_skies:everdawn"
				id: "327A23A520F89273"
