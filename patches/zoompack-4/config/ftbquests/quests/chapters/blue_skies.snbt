			}]
			title: "更多未知内容等待着你去探索"
			x: 1.0d
			y: -3.0d
		}
		{
			dependencies: ["7163E74A9BC10EB5"]
			description: ["&7探索天际维度之巅的矿石——地平石。这种终极材料凝聚了天空的精髓，拥有无与伦比的强度和魔法特性。开采地平石，锻造最强大的装备，将你的冒险推向新高度！"]
			id: "0F905561BBD0BA6A"
			rewards: [{
				id: "2456B6603A208FF7"
				type: "xp_levels"
				xp_levels: 1
			}]
			shape: "diamond"
			size: 1.5d
			tasks: [{
				id: "0B7D0E0ADA99E46E"
