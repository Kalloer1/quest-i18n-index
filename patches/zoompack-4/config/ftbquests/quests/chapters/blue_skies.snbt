		{
			dependencies: ["562AAFDF220019AD"]
			description: ["&7踏入永昼维度，一个充满永恒暮光与古老谜团的领域。在这里，你将遇到神秘的炼金术士和可怕的蛛王。准备好迎接它们的强大力量，解开这个神秘世界的秘密。"]
			icon: "blue_skies:everdawn_portal"
			id: "7163E74A9BC10EB5"
			rewards: [{
				exclude_from_claim_all: true
				id: "7E57942A329D1D91"
