	quests: [
		{
			title: "{gravitas.quest.caveman.start_somewhere}"
			x: 9.5d
			y: 4.5d
			description: [
				"使用我们新制作的工具，我们现在可以获取一些生存所需的重要资源了。"
				""
				"用&a斧&r，你可以砍倒树木。不过，你得到的不是普通的原木。"
				""
				"用&e刀&r，你可以割&2草&r或&2植物&r来获得&a干草&r。"
				""
				"&3锤子&r用于锻造，而&e标枪&r则是很棒的武器！"
			]
			dependencies: ["6360E6403A8BB4EE"]
			id: "297C2E9EF534A201"
			tasks: [
				{
