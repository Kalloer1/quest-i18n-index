				type: "xp"
				xp: 100
			}]
			subtitle: "Ars Nouveau"
			tasks: [{
				id: "36BE027D4FC47595"
				item: "ars_nouveau:potion_jar"
				type: "item"
			}]
			x: 1.5d
			y: -3.0d
		}
		{
			dependencies: [
				"4694ACF712E45594"
				"2065B0E1929B4965"
				"62E9399527071C13"
				"34926D14331DAA4D"
				"33F9BF5E20D023C7"
			]
			dependency_requirement: "one_completed"
			description: [
				"&e用于配置源中继器和自动化实体的工具。&r"
				""
				"要设置传输路径，先对要取源的对象使用魔杖，然后再对要送源的目标方块使用魔杖。"
				""
				"例如：源罐到源中继器，源中继器到源中继器，或源中继器到源罐。"
