		{
			x: 19.0d
			y: 2.0d
			shape: "gear"
			subtitle: "锂粉堪称真正电池的核心。用这种细腻的粉末制作感应矩阵所需的元件，它本质上是一个巨大的模块化电池。"
			dependencies: [
				"02502B52A16346C0"
