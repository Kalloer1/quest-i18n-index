	quest.54D89CD1278E6F68.quest_subtitle: "驯服一个 Frostling 伙伴生物"
	quest.5502A204AF05E2DA.quest_desc: [
		"&n合成该方块的过程：&r"
		""
		"绿色玛斯特克树脂"
		"→ 压缩 → 绿色玛斯特克糊剂"
