	quest.54480115AF9A1DAD.title: "德鲁伊伙伴生物"
	quest.544A301047565927.quest_subtitle: "用于升级时：&6+5% 末影法术强度"
	quest.5470523184A3D0BA.quest_subtitle: "被动能力（8秒冷却）：&6受攻击时，会释放一股排开空气的冲击波"
	quest.5474CED4870FED3A.quest_desc: ["让你提取由&dCoils&r和&dMagnets&r产生的&belectricity&r，然后通过&6Connectors&r和&6Wires&r为马达或其他机器供电。"]
	quest.549427B0BBA24445.quest_desc: [
		"此方块可将光射线分裂成2条不同的偏振射线。"
