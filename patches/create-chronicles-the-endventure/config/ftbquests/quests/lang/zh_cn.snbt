	quest.5534C553D15CD96B.quest_desc: ["&6物品抽取器&r可以从容器中吸取液体，并暂时储存，直到通过管道输送到另一个容器中。"]
	quest.5590204A473913AC.quest_subtitle: "自动熔炼采集到的矿石"
	quest.561A753B404A8C0A.quest_desc: ["使用粉状雪"]
