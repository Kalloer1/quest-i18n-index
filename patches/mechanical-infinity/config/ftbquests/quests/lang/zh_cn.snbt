	quest.10FCA058EB0498D0.quest_desc: ["蒲公英或向日葵"]
	quest.16C399E4B72D39F7.quest_desc: ["能量呼叫器是一种可以放置在世界中的电池，就是这么简单。"]
	quest.16C399E4B72D39F7.quest_subtitle: "Powah 存储系统！"
	quest.170E581CD2744500.quest_desc: [
