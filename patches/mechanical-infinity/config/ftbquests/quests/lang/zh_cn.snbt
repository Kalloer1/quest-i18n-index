		""
		"&l&5身份识别"
		""
		"用于将方块/物品写入记忆芯片的方块。"
		""
		"&l&4分解与分离"
		""
		"用于摧毁方块/物品，并向你的物质储罐添加物质值的装置。"
		""
		"更多详情，请参见复制任务页面。"
	]
	quest.170E581CD2744500.quest_subtitle: "复制说明 Replication Explanition"
	quest.1725FE520BE6765E.quest_desc: [
		"末影单元与末影门配合使用时，可实现跨维度无线供电。"
		""
		"它们有 12 个可供使用的不同频道。"
		""
		"通道最初没有储能，只需将任何 Powah Battery / Energy Cell 拖拽到背包中即可！"
	]
	quest.1725FE520BE6765E.quest_subtitle: "无线电力！"
	quest.17774B524B631757.quest_desc: ["在加压反应室中结合水、氧气和土之精华，可制作出 Tier 1 生长溶液，让你能培育出地球种子！"]
	quest.18D72812D63A313D.quest_desc: ["干草垛是获取有机物更快的方式。"]
	quest.1B6C7E865E64BD29.quest_desc: ["这是用 Oritech 的粒子加速器，消耗一个地球精华和一个金属精华制成的。"]
	quest.1BEE6A25B4AEE069.quest_desc: [
		"Powah 是一款用于中前期发电的非常强大的模组。"
		""
		"你需要准备大量的介电浆料。"
	]
	quest.1BEE6A25B4AEE069.title: "Powah 任务线的开端！"
	quest.24DE6113062A3493.quest_desc: ["由 Turbofuel、Carbon 和一份 Ender Essence 制成，用于在种植台培育 End Seeds"]
	quest.256C4C8944298576.quest_desc: ["瓦解地球的一种更快捷的方式。"]
	quest.290A4E366BE7FC72.quest_desc: ["下界种子的生长方式与地球种子几乎相同，但需要使用 Tier 3 生长溶液。这需要在增压反应室中消耗生物燃料、精炼黑曜石和 1 个下界精华。"]
	quest.2BEE61D5EA111F5B.quest_desc: [
		"能量电缆的作用正如其名，用于传输电力。"
		""
		"在 nitro 里，他们是最好的之一，而且对于 tps 来说也非常棒。"
	]
	quest.2BEE61D5EA111F5B.quest_subtitle: "有线的力量！"
	quest.2CB4A101005B075E.quest_desc: [
		"接下来是 Niotic Crystals，用 1 个钻石制作。"
		""
		"制作此方块需要消耗 1 钻石块。"
	]
	quest.2CB4A101005B075E.quest_subtitle: "第4阶段"
	quest.3037A7B311DA0740.quest_desc: [
