	filename: "research_bypasses"
	title: "研究绕过机制的漏洞"
	default_quest_shape: ""
	default_hide_dependency_lines: false
	quests: [
		{
			x: 1.75d
			y: -0.75d
			shape: "hexagon"
			subtitle: "知识可是很昂贵的！"
			description: [
				"&7通常获得研究DLC、强盗的方式是获取知识之星并使用它们。这些主要只能通过宝库或黑市获得。"
				""
				"&7然后在Vault Hunters GUI的研究页面使用知识。所有研究DLC都分成了不同的类别。"
				""
				"&7每个分类里你想购买的每个研究DLC都会变得越来越贵。幸运的是，生活质量除外……但不幸的是，这包括我添加的海盗广播部分。"
				""
				"&7幸运的是，由于我的海盗广播环节，我为你找到了另一条研究路线！不过代价很高！不是知识，而是代币、故障和雪貂美元。"
				""
				"&7同一类别里每买一个，成本都会上涨！每次绕过他们的系统，都更难找到新的漏洞了。"
			]
			dependencies: ["29003EE631630364"]
			hide: true
			size: 1.5d
			id: "0197C9353E4EC5B2"
			tasks: [{
				id: "09F52A253A2F80FC"
				type: "checkmark"
				title: "研究绕过信息"
			}]
		}
		{
			title: "海盗广播研究DLC绕过方法#1"
			icon: "tfb2:research_pirate"
			x: -6.75d
			y: 1.0d
			shape: "rsquare"
			subtitle: "这个免费送给你"
			description: [
				"&7行啦，强盗，在向你开放完整的DLC绕过商店之前，我得先好好测试一下系统。"
				""
				"&7这样你就能免费选择一个海盗广播研究DLC。FOP游戏服务器的回应会让我对其他绕过方式的需求有个很好的了解。"
				""
				"&7我建议用Traversal，能开各种载具；或者Animalistic，能骑巨型动物。"
				""
				"&7还有一只巨型雪貂。谁能拒绝一只巨型雪貂呢？"
			]
