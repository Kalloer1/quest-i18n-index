	filename: "stuck_in_the_burb"
	title: "[?] 被困在BURB里了"
	icon: "minestuck:scalemate_applescab"
	subtitle: ["Byte's Daunting Quests of Alchemical Frivolity and Game Breaking Japery"]
	default_quest_shape: ""
