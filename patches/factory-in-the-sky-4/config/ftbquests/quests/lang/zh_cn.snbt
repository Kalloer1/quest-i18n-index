	file.0000000000000001.title: "任务列表"
	quest.0074CD842AE5DF5A.quest_desc: ["存储部件可用于合成存储磁盘或存储方块。等级越高，能存放的东西就越多！"]
	quest.008E478C5C67A731.quest_desc: ["放入泥土、树苗和斧头，树木就能轻松生长，无需你费心照料！"]
	quest.00AD7AB3F3039FCB.quest_desc: [
		"这里没有解答的问题？请在 Discord 上提问！"
		""
		"“在哪里可以找到被动生物？”"
		"- 如果你的岛屿没有生成被动生物（需要一大片草地），可以制作动物种子，在JEI中查看“Haven Animal Seeds”。"
		""
		"有脉矿采集器吗？\""
		"此整合包包含 FTB Ultimine 模组。默认按键为 Grave 键：`"
		""
		"“中键点击可整理物品栏吗？”"
		"- 是的，你可以在控制菜单中设置按键绑定！"
		""
		"“我需要按照顺序完成这些任务页面吗？”"
		"- 不。"
		""
		"“我该如何获得[在此插入物品]呢？”"
		"- 使用 JEI 查找配方。许多原版物品的原版机制仍然适用（例如在堡垒中找到升级模板）。"
	]
	quest.00AD7AB3F3039FCB.quest_subtitle: "加入 Discord 服务器！"
	quest.01A5A30AFDAA215A.quest_desc: [
		"盐代表物体的“身体”或“物理物质”。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.01A5A30AFDAA215A.title: "盐分"
	quest.0238BAECF1A81B70.quest_desc: ["控制电路是制造Mekanism机器/工具的关键组件。它们存在于许多配方中，不同配方可能需要不同等级的控制电路。例如，能量熔炉需要基础控制电路，而化学溶解室则需要终极控制电路。"]
	quest.0299CB83EE5C7AC7.quest_desc: ["无与伦比的速度、可重配置侧面、用于烟熏和爆破的增强组件，大幅提升冶炼效率。"]
	quest.02D5BB168D585BB1.quest_desc: ["存储部件可用于合成存储磁盘或存储方块。等级越高，能存放的东西就越多！"]
	quest.0333265CAEB2672B.quest_desc: ["将液态乳胶转化为干橡胶。"]
	quest.0333D108914243AD.quest_desc: [
		"厌倦了原版工作台？试试这些新花样吧。"
		""
		"Actually Additions 的便携工作台可用于魅力槽位！"
	]
	quest.0333D108914243AD.title: "合成配方"
	quest.049B79DBCFE418BB.quest_desc: ["将铜质存储箱变为铁质存储箱。点击存储箱的升级即可应用。"]
	quest.04A3DFCB86AD6A8F.quest_desc: ["快速旅行！非常适合在不同维度之间传送。"]
	quest.0554A15324BA0FE6.quest_desc: ["游戏内文档请参阅&o《蜜蜂大全书》&r，配方和繁殖信息请查看JEI。嗡嗡嗡！"]
	quest.060DFA3D45DC5A01.quest_desc: [
		"电缆用于连接存储网络中的设备。"
		""
		"不过，并非总是需要电缆——直接相邻的设备会自动建立连接。"
		""
		"如果电缆有颜色，它将只连接到相同颜色或默认颜色的方块和电缆。"
	]
	quest.062262B5C65AF83C.quest_desc: ["用于制作第6级种子。"]
	quest.07854ABDF2525423.quest_desc: [
		"一种将炼金硫磺、盐和汞重新组合成物品的装置。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.07D661E96B16D91A.quest_desc: ["无与伦比的速度、可重配置的面板、用于烟熏和爆破的增强模块，大幅提升冶炼效率。"]
	quest.07EC7458B7467EF4.quest_desc: ["用RF的力量捶打方块！需要能量。插入锤子可加速。"]
	quest.0831FA16886C36B8.quest_desc: ["燃烧煤炭并将其转化为电力。"]
	quest.084A0492C76D4B3F.quest_desc: ["使用原子重构机制作。查看JEI。"]
	quest.0935819E16549AD6.quest_desc: ["合成成多种不同物品，用途请参见JEI。"]
	quest.0935819E16549AD6.title: "通用预测（Generalized Predictions）"
	quest.09760C9938F730D8.quest_desc: [
		"Crafters 是 RFTools 添加的机器，只要有配方、所需组件和 RF 能量，就能自动合成物品。多步骤合成可以在一台机器内完成，唯一限制是配方槽的数量。"
		""
		"Crafter Tier 2 可以记住 4 个配方。"
	]
	quest.097A233A95FFB754.quest_desc: ["对鸡使用可生成金蛋。将金蛋点击在5x5的泥土块上，即可生成欢乐泥土（点燃后会生成被动生物）。"]
	quest.09814BA8EA7DEE5A.quest_desc: ["大家都知道，雪比沙子和泥土更好。试着在雪块上种植甘蔗吧。"]
	quest.09D6A95486012A30.quest_desc: ["无与伦比的速度、可重配置侧面、用于烟熏和爆破的增强组件，大幅提升冶炼效率。"]
	quest.0A5256C62EB1B109.quest_desc: ["更多储物空间！悬停在物品上可查看槽位和堆叠容量。"]
	quest.0A6F0B333D136BC9.quest_desc: ["将熔岩源放在上面，并放入鹅卵石以创造熔岩。"]
	quest.0A7F3AC9D7D4F604.quest_desc: ["催化剂是制作创意物品所需的合成组件。"]
	quest.0C0F94B6DB2E080B.quest_desc: ["觉醒祭坛是觉醒合成结构的核心组件。它与四个觉醒基座和四个精粹容器一起，主要用于合成觉醒超贵金属。使用红石信号激活以开始合成过程。"]
	quest.0C0F94B6DB2E080B.title: "苏醒"
	quest.0C2FF5B4D6DF8DC1.quest_desc: ["每个等级都会增加更多的存储栏位和升级栏位。"]
	quest.0DFAA6039CF52FBC.quest_desc: ["扩展工作台是一套分等级的工作台，可用于制作各种物品。每个等级都有更大的网格，可用于用更多组件制作更高等级的物品。"]
	quest.0E277E20880B2049.quest_desc: [
		"神秘农业的主要用途是资源种子。这些种子可以生长出超过100种不同资源，包括钻石、骨头、铜、红石等。收获时，它们会掉落各自的资源精华，并有10%的几率掉落受精精华。"
		"资源种子有不同的等级。等级取决于所生长材料的稀有度。"
		"这些种子是使用融合祭坛、材料、精华和种子基底制作的。"
		"这些作物无法使用骨粉催熟，也无法通过按 Shift 键加速生长。"
		"它们可以在花园玻璃罩中用正确的土壤种植。"
	]
	quest.0E277E20880B2049.title: "元素种子 Elemental Seeds"
	quest.0E6FF623392EEC67.quest_desc: ["建筑方块的选择更加多样化！另外，查看新的手持 Chipped 物品，详情见 JEI。"]
	quest.0E6FF623392EEC67.title: "Chipped"
	quest.0FACDB9481B865F9.quest_desc: ["使用RF来切割生物头颅，并将其与其他物品拼接。操作时需要斧头和剪刀。"]
	quest.0FED5744C88DDF08.quest_desc: ["经验采集器只能放置在奇点储罐的侧面。当需要时将储罐内的流体经验转换回经验球以补充经验值，即可开启或关闭经验采集器。"]
	quest.100CCB76CC637C5E.quest_desc: [
		"查看 Bumblezone 的进度标签页，了解该做什么！"
		""
		"在这个维度，蜜蜂会极其保护自己的蜂蜜。如果你挖掘原版蜂蜜块、破坏或取走蜂巢幼虫块，或者打蜜蜂，周围的所有蜜蜂都会获得大量增益，并对你产生极大的愤怒，因为你获得了蜂巢之怒的效果！但用蜂蜜食物喂食蜜蜂或蜂巢幼虫块，或许能安抚它们。喂食蜜蜂或蜂巢幼虫块后，你会获得蜂巢庇护，使蜜蜂保护你免受任何攻击！"
	]
	quest.102C5B92DCFEBEB9.quest_desc: ["自动合成器已升级到2级！合成速度更快，模式容量更大。"]
	quest.108601833D0C39F7.quest_desc: ["滑翔翼模组添加了滑翔翼（惊喜！），让你翱翔天际！只需从高处跳下（或用喷气背包上升），剩下的交给滑翔翼。飞行控制非常流畅自然。想更快时，还可以加固你的滑翔翼！"]
	quest.10943C6087CD73A4.quest_desc: ["Inferium Essence 是制作 Mystical Agriculture 方块和物品所需的关键材料之一。可以通过击杀敌对和被动生物，以及种植 Inferium Seeds 来收集。"]
	quest.10943C6087CD73A4.title: "神秘农业 (Mystical Agriculture)"
	quest.1103C0F9C2F1FD57.quest_desc: ["这种终极锭是所有锭中最终极的一种。"]
	quest.1111CBFFB9565287.quest_desc: ["查看 Bumblezone 的进度标签页，了解该做什么！"]
	quest.11AA6D7D6B0DCB70.quest_desc: ["控制电路是制造Mekanism机器/工具的关键组件。它们存在于许多配方中，不同配方可能需要不同等级的控制电路。例如，能量熔炉需要基础控制电路，而化学溶解室则需要终极控制电路。"]
	quest.11AF013477D44838.quest_desc: [
		"灌注祭坛是多方块灌注合成结构的核心组件。它与八个灌注基座一起，主要用于合成资源种子和增强物。"
		"用红石信号激活以开始制作过程。"
	]
	quest.11AF013477D44838.title: "正在注入能量"
	quest.1248F9135FAAB5AF.quest_desc: ["跨维度无限射程的助推器。"]
	quest.1248F9135FAAB5AF.title: "Infinity Booster"
	quest.12535C84226202FC.quest_desc: ["存储部件可用于合成存储磁盘或存储方块。等级越高，能存放的东西就越多！"]
	quest.126BC695008C57CA.quest_desc: ["用两种或以上不同材料制作合金！也可用作动力熔炉。"]
	quest.12715DDDBE88F6B4.quest_desc: ["由常规尺寸的基础电容器制成。"]
	quest.128E41AC14154D18.quest_desc: ["让你能够定位生物群系和结构。"]
	quest.128E41AC14154D18.title: "指南针"
	quest.12A613974CDAD722.quest_desc: [
		"最大方块数：1024"
		""
		"建造棒能让你一次性放置多个方块，朝你面对的方向延伸建筑。你可以升级建造棒以增强其能力，让建造更快更高效。"
		""
		"建造棒共有五个不同等级：木、铜、铁、钻石和下界合金。每个等级都提供更强的耐久度和放置能力，并且可以用模板进一步升级。"
	]
	quest.12E2104DD92875C6.quest_desc: ["存储部件可用于合成存储磁盘或存储方块。等级越高，能存放的东西就越多！"]
	quest.131FDA64C3180DB0.quest_desc: [
		"右键进入末地。用末影之眼重新填充。"
		""
		"主末地岛屿存在，但外围末地岛屿是虚空。要探索末地城市，请务必带上喷气背包或其他飞行方式！"
		""
		"考虑使用探险家罗盘来帮助你找到末地城市！"
	]
	quest.131FDA64C3180DB0.title: "进入末地"
	quest.134D6774DA2D1932.quest_desc: ["存储部件可用于合成存储磁盘或存储方块。等级越高，能存放的东西就越多！"]
	quest.148BA0F51023CE66.quest_desc: ["热能发电机可将热能转化为电能。这通常是第一个制作的发电机，因为它虽然提供的电能很少，却是唯一不需要钢的机械装置发电机。热能发电机可以同时以主动和被动模式发电。"]
	quest.150A43710BAB94B3.quest_desc: ["四个铁矿石块可以合成成一个铁矿石方块。"]
	quest.15388A4EE7D97E9A.quest_desc: ["每个等级都会增加更多的存储栏位和升级栏位。"]
	quest.157C098AEBC660F3.quest_desc: ["自动合成器使用插入到其中的模式或存储网络中可用的模式来执行自动合成任务。"]
	quest.1593E93188BF6609.quest_desc: [
		"神秘农业有六个合成水晶，而不是两个。它们分别是：Inferium、Prudentium、Tertium、Imperium、Supremium 和 Master Infusion Crystal。"
		""
		"晶体的配方是嵌套的，所以你不能跳过前一个等级直接制作更高级的晶体。"
	]
	quest.15C3349D236A7BDC.quest_desc: ["点击带袋子的末地箱以链接。可从你的物品栏访问末地箱！"]
	quest.163D19751578D945.quest_desc: ["通过锤击砾石获得。"]
	quest.16858B5DE24142ED.quest_desc: [
		"燃烧任何燃料（煤炭/木材等）。"
		"1 煤炭 = 20,000 RF（与其他大多数模组的燃料水平类似）。"
		"内部存储容量为 1,000,000 RF"
		"燃烧燃料，能迅速为一个物品充能。"
		"在建立完整的能源系统之前，用来给物品充能的权宜之计。"
	]
	quest.16876F72C06C93BD.quest_desc: ["净化室使用氧气将矿石和碎片提炼成簇。每种矿石可生成3个簇，而每种碎片只能生成1个簇。"]
	quest.177639631205B3EC.quest_desc: ["合成核心是组合合成机制的关键组件之一。它与基座一起，可用于利用能量和物品来合成各种创意物品。"]
	quest.1895A470465F4028.quest_desc: ["使用研钵和研杵非常简单。石板中详细记载了许多不同法术的配方。你需要所有这些材料，以及特定的基础材料。要创造最基本的法术，只需放入该法术的配方，再加上一根旧根。这样就能得到一个没有修饰符的法术。"]
	quest.18A405B8BF7F6E3F.quest_desc: ["导入器会从相连的外部物品栏中提取资源，并将其插入存储网络。"]
	quest.19894F58314AF562.quest_desc: ["击败守卫者，升级你的盔甲，变得比以往任何时候都更强大！"]
	quest.19894F58314AF562.title: "Warden 盔甲"
	quest.19BD8618EF4707CC.quest_desc: ["由鹅卵石制作而成。"]
	quest.1A4F4869908795C2.quest_desc: [
		"该模组为大多数原版资源以及铜、铅、银等所有你喜爱的模组资源都添加了蜜蜂。例如，还有大量蜜蜂用于《神秘农业》和《Powah》等模组专属资源。"
		""
		"建议使用 JEI 查找繁殖配方，并使用该书籍查阅游戏内文档。"
	]
	quest.1AE639EF3AE28B6C.quest_desc: [
		"要开始探索Aether，你必须用发光石建造框架，并在中间用水桶点燃，这样就能激活传送门，让你踏入这个维度。从这里开始，你就能在Aether充满敌意的天堂中开启生存之旅！"
		""
		"以太世界包含三个神秘的新地牢，每个地牢都有一个可怕的Boss需要击败..."
		""
		"青铜地牢是哨兵们的家园，由神秘的滑行者守卫，这是一种由纯粹石头诞生的生物。小心岛屿间的隐藏隧道，并用你能打造的最好装备做好准备！"
		""
		"银色地牢是美丽的瓦尔基里神殿。挑战瓦尔基里骑士团的骑士，若你证明了自己的价值，便与瓦尔基里女王本人一战。运用你所能想到的所有工具和技巧，战胜这位古老的战士。"
		""
		"在稀有的黄金地牢中，存在着太阳之灵，一个由纯粹火焰与能量构成的永恒存在。他是统治太阳本身的神，要让他注意到你这样的存在，恐怕需要一番说服。但传言称，他守护着以太中最为珍贵的宝藏。"
	]
	quest.1AE639EF3AE28B6C.title: "进入以太维度 (Into the Aether)"
	quest.1B3242881C6D1876.quest_desc: ["Tier 2 机械框架。"]
	quest.1B4E82446FBCEA61.quest_desc: ["更先进的发电机，能燃烧熔炉中任何可用的燃料，并将其转化为电力！"]
	quest.1B5C7FE8C6DEAA59.quest_desc: ["龙首可以在末地城市的飞行船正面找到。"]
	quest.1B7562EF795778A9.quest_desc: [
		"另请参阅：储罐（用于流体）"
		""
		"&2特色功能&r"
		"更大的槽位：每个槽位可存储的物品数量超过常规上限。单个槽位最多可存放10亿个物品。"
		"不同大小：从9格的银行1到108格的银行7，格数依次递增。"
		"银行码头：将银行停靠在码头，即可在世界中轻松访问。"
		""
		"&2拾取模式&r"
		"拾取全部：拾取的所有物品将自动存入银行，而非你的物品栏。"
		"过滤拾取：物品只有在银行中已有匹配物品时才会被存入。"
		"虚空溢出：与过滤拾取类似，但如果银行中没有剩余空间，物品将被丢弃。"
		"不拾取：物品会直接放入你的物品栏中。"
		""
		"&2建造模式&r"
		"建造模式：在银行内选择任意方块，直接从银行物品栏放置。"
		"蹲下并滚动以选择方块。"
		"随机建造模式：与建造模式类似，但方块会随机选择。"
		"背包模式：右键打开银行物品栏界面。"
		"右键蹲下以切换建造模式。"
		""
		"&2物品栏过滤&r"
		"按住 alt 键并用物品点击以将该槽位锁定为该物品。"
		"只有匹配的物品才能放入该槽位中。"
		""
		"&2银行码头&r"
		"用6个平滑石放在两侧，顶部和底部各放2个漏斗来合成。"
		"右键点击银行以将其停泊。"
		"蹲下时右键以拾起银行。"
	]
	quest.1B7562EF795778A9.quest_subtitle: "dank/null/ 或 dev/null/"
	quest.1B7562EF795778A9.title: "银行存储系统"
	quest.1BD5123D662FBB72.quest_desc: ["可用于种植各种作物，包括神秘农业的作物！查看JEI以确定正确的土壤。"]
	quest.1BFF97D02D7C5D4B.quest_desc: ["储物升级，等级2。悬停物品查看详情。"]
	quest.1CB1EDD80BC5F2DB.quest_desc: [
		"遵循书中概述的步骤，踏上成为炼金术大师的旅程。"
		""
		"Theurgy旨在为Minecraft引入一种全新的炼金术。它摒弃了“四元素”——风、水、火、土——的传统，而是借鉴古典炼金术，运用硫磺、盐和汞等元素，并通过一系列被称为Spagyrics的过程进行处理。"
		""
		"Theurgy 的首要目标是创造平衡的炼金体验——不像 Equivalent Exchange 那样过于强大，但可能比传奇的 Thaumcraft 更实用。"
	]
	quest.1CBA3B4E2413818F.quest_desc: ["游戏内文档请参阅&oThe Big Book of Bees&r，配方和繁殖信息请查看JEI。嗡嗡嗡！"]
	quest.1CCF5DAA93C9AD84.quest_desc: ["无线供电！你还能奢求什么呢？"]
	quest.1CCF5DAA93C9AD84.title: "Flux Networks"
	quest.1CFE005AD9F9395B.quest_desc: ["Iron Jetpacks 是一款功能丰富且易于使用的现代喷气背包模组。背包的等级越高，性能越好。线圈是背包制作过程中不可或缺的一部分。请参见 JEI。"]
	quest.1CFE005AD9F9395B.title: "喷气背包"
	quest.1D035E910905B2CD.quest_desc: ["每个等级都会增加更多的存储栏位和升级栏位。"]
	quest.1D0DFE2219A02B10.quest_desc: [
		"每种种子都只能长在特定的方块上。请务必种植在正确的位置！"
		""
		"有幼年形态的动物会成长为它们的幼年形态。"
		""
		"还有更多类型可供选择！请查看 JEI。"
	]
	quest.1D0DFE2219A02B10.title: "生物种子 (Mob Seeds)"
	quest.1E64CEE9C82A233F.quest_desc: ["阻止最多8格内实体的传送。可安装在实心块的任意一侧。右键激活/停用。"]
	quest.1E90AB5E49CEED4B.quest_desc: ["用于沉浸式工程学的多方块机器。详情参见手册或JEI。"]
	quest.1ECA229DE8C00248.quest_desc: ["使用原子重构机制作。查看JEI。"]
	quest.1EEED62EE765CA0D.quest_desc: ["沉浸式工程的核心是利用多方块机器来开启你的工业革命！"]
	quest.1F1D357B52EFF584.quest_desc: [
		"祭坛上可以进行不同的仪式，每个仪式都需要不同的组件和条件才能生效。"
		""
		"典型的仪式流程如下：首先，将所需物品放置在祭坛上，并点燃所需的香。确保祭坛上没有多余的原料，空中也没有多余的香，否则仪式会失败。然后，手持空手潜行右键祭坛以开始仪式。"
	]
	quest.1F37B280738A6B66.quest_desc: ["用带网的筛子筛土，可以获得各种类型的鹅卵石！可以制作成不同种类的石头。"]
	quest.1F7047C6351AA042.quest_desc: [
		"液体以固体形式存在，便于运输和炼金处理。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.1F7047C6351AA042.title: "岩浆与水"
	quest.203229D68F81B92F.quest_desc: [
		"神秘农业有六种合成水晶，而不是两种。它们分别是：Inferium、Prudentium、Tertium、Imperium、Supremium 和 Master Infusion Crystal。"
		""
		"晶体的配方是嵌套的，所以你不能跳过前一个等级直接制作更高级的晶体。"
	]
	quest.20BE02827015CC81.quest_desc: ["想要从工具或盔甲上获得附魔？用这张表吧！"]
	quest.2113D616855A2E8D.quest_desc: ["游戏内文档请参阅&o《蜜蜂大全书》&r，配方和繁殖信息请查看JEI。嗡嗡嗡！"]
	quest.211446D218E7E567.quest_desc: ["由充能钢制成。"]
	quest.219E1914902D3479.quest_desc: ["游戏内文档请参阅&oThe Big Book of Bees&r，配方和繁殖信息请查看JEI。嗡嗡嗡！"]
	quest.21BE81F18EF5C6B9.quest_desc: ["Ender IO 版本的太阳能。"]
	quest.22979C118161AA3A.quest_desc: ["自动合成器已升级到3级！合成速度更快，模式容量更大。"]
	quest.229AB36EAC2661CA.quest_desc: ["数据模型可以通过两种方式训练：使用深度学习器或使用模拟室。深度学习器允许你存储几个数据模型，你收到的击杀将开始训练模型。所有模型最初都处于故障状态，必须在深度学习器中训练至基础级别。"]
	quest.231C7D537D5F2334.quest_desc: ["更多储物空间！悬停在物品上可查看槽位和堆叠容量。"]
	quest.23890AEB2EA0F1AB.quest_desc: ["存储部件可用于合成存储磁盘或存储方块。等级越高，能存放的东西就越多！"]
	quest.23B95448721F4E5B.quest_desc: ["用于沉浸式工程学的多方块机器。详情参见手册或JEI。"]
	quest.24036AE756D446CF.quest_desc: [
		"鞘翅可以在末地城市的飞行船上找到。"
		""
		"也可以通过击败末影龙掉落或合成来获得。"
	]
	quest.254643F9AD4978C1.quest_desc: ["由你在“另一面”找到的资源制作而成。"]
	quest.25603E442AE0E737.quest_desc: ["使用 Empowerer 合成。查看 JEI。"]
	quest.256951CF16DDD508.quest_desc: ["扩展工作台是一套分等级的工作台，可用于制作各种物品。每个等级都有更大的网格，可用于用更多组件制作更高等级的物品。"]
	quest.25B01D780EA5A73B.quest_desc: [
		"用加固深板岩建造传送门，就像建造下界传送门一样。要激活它，用之心（击败守卫者获得）点击即可。"
		""
		"记住，加固深板岩可以破坏，只是挖掘需要非常长的时间！小心放置你的方块！"
		""
		"Deeper and Darker 添加了全新的维度——Otherside——其中包含大量可供探索的内容。以下是一些特色功能列表！"
		""
		"群系：探索深地、回响森林、阴沉柱和繁花洞穴。"
		"结构：寻找远古神殿，这是坚守者的家园！打破远古花瓶时要小心，以免唤醒远古潜行者。"
		"方块：超过一百种新方块可供建造，包括幽暗板岩、潜声石和一种新的木材！"
		"物品：一套全新的卫道士盔甲和工具、升级版鞘翅，还有超酷的潜声信标！"
		"生物：8 个新生物，包括一个迷你首领！"
		"要进入异世界，杀死坚守者并使用其心脏。游玩模组以发现更多内容，探索隐藏的秘密！"
	]
	quest.25B01D780EA5A73B.title: "深入海底"
	quest.25C295D927D5496F.quest_desc: [
		"一种使用溶剂从物品中提取炼金硫磺的装置。"
		""
		"将炼药锅放在熔炉上。用烈焰棒填满熔炉来加热炼药锅！"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.2608543E104C6B3A.quest_desc: ["自动合成器已升级到第5级！合成速度更快，模式容量更大。"]
	quest.264DB832753EF79C.quest_desc: ["查看 Bumblezone 的进度标签页，了解该做什么！"]
	quest.266043FC16E645A7.quest_desc: ["模型达到基础或以上后，即可使用模拟舱运行模型模拟。模拟将始终生成通用预测，并可能根据模型准确性生成生物预测。模型等级越高，准确性越高，自我认知模型可达99.5%。运行模拟需要能量（取决于模型类型）和催化剂物品，通常是预测矩阵。"]
	quest.267870FD5D4C0BEA.quest_desc: ["Iron Jetpacks 是一款功能丰富且易于使用的现代喷气背包模组。背包的等级越高，性能越好。线圈是背包制作过程中不可或缺的一部分。请参见 JEI。"]
	quest.26D477BD067C71B2.quest_desc: ["将基础存储变为铜质存储。点击存储的升级即可应用。"]
	quest.2796FB3D93055E92.quest_desc: ["合成网格的运作方式与普通网格相同，但包含一个合成物品栏。"]
	quest.27AB2346C851E196.quest_desc: [
		"储物袋，等级3。最高等级。"
		""
		"注意：存在一个可能导致背包无法打开的 bug。重启游戏通常可以解决。已向模组作者提交 bug 报告。"
	]
	quest.27F77909838C5A36.quest_desc: ["能量存储，第3级。"]
	quest.2825F162E89AF2F9.quest_desc: ["抽屉链接，用于批量控制。"]
	quest.285E4E9F3EC57A42.quest_desc: ["滑翔翼模组添加了滑翔翼（惊喜！），让你翱翔天际！只需从高处跳下（或用喷气背包上升），剩下的交给滑翔翼。飞行控制非常流畅自然。想更快时，还可以加固你的滑翔翼！"]
	quest.292DEF4DD1BAB2DF.quest_desc: ["奇点储罐是一种基础流体储罐，可容纳32桶任何流体。用它来储存你的生物农场产生的经验值！你还可以制作经验值抽取奇点储罐，将玩家的经验值储存为液态经验值。"]
	quest.29747C07922D623A.quest_desc: [
		"使用符文石板来引导你完成 Roots 模组的内容。"
		""
		"模组提供的一些内容如下："
		"- 使用天然材料制作魔法粉末。"
		"- 为魔杖注入魔力以施展法术"
		"- 施展德鲁伊魔法仪式，召唤生物，并制作特殊工具和盔甲。"
	]
	quest.2A56CF9CFDF0C615.quest_desc: ["Iron Jetpacks 是一款功能丰富且易于使用的现代喷气背包模组。背包的等级越高，性能越好。线圈是背包制作过程中不可或缺的一部分。请参见 JEI。"]
	quest.2AB4C39991F55BE0.quest_desc: ["破碎机可以将团块压成脏粉、将锭压成粉、将生物质压成生物燃料。"]
	quest.2ADCBD5A7DFD1343.quest_desc: ["一级方块生成器的高级版本。产量更高！"]
	quest.2ADCBD5A7DFD1343.title: "Cobble Gens"
	quest.2B05E930558022BB.quest_desc: [
		"炼金术上纯度的黄金。可作为催化剂，使各种炼金术过程得以进行。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.2B152316AC21184B.quest_desc: [
		"Crafters 是 RFTools 添加的机器，只要有配方、所需组件和 RF 能量，就能自动合成物品。多步骤合成可以在一台机器内完成，仅受配方槽位数量的限制。"
		""
		"Crafter Tier 1 可以记住 2 个配方。"
	]
	quest.2B2B99AC5FFD4B35.quest_desc: ["用于制作第5级种子。"]
	quest.2BBBC49A831D9CA3.quest_desc: ["放入树叶或树苗以创造水源。"]
	quest.2BDCEF60F36F432C.quest_desc: ["用这个来制作你的第一台 Ender IO 机器。"]
	quest.2C4767FA88BA40F2.quest_desc: [
		"欢迎来到 MuggleOrWizard 制作的《空中工厂4》！请务必阅读所有任务描述，其中包含有用的信息和提示。"
		""
		"如果你在游玩此整合包时有问题或意见，欢迎在项目页面留言、在CurseForge上发消息，或加入Discord服务器。"
		""
		"要创建或加入 FTB 团队（用于任务、区块认领等），请在打开物品栏时点击屏幕左上角的团队图标。任务书也在那里可以找到。"
		""
		"要了解天空方块团队（个人/团队岛屿）的信息，请使用命令 /skyblock gui。"
		""
		"如有疑问，请务必查看常见问题解答标签页！"
		""
		"&2本整合包灵感源自“Sky Factory”系列。若你未玩过，强烈推荐去体验一下——可在Curseforge应用上找到它。&r"
		""
		"注意：许多任务描述均摘自相关模组的维基页面或游戏内指南。所有功劳归于模组作者。"
	]
	quest.2C4767FA88BA40F2.quest_subtitle: "阅读所有任务描述！"
	quest.2CFD4DA376D7A95C.quest_desc: [
		"存储外壳是一个未分配存储部件或流体存储部件的空存储磁盘或流体存储磁盘。"
		""
		"可以与相应的存储部件或流体存储部件结合，用于制作新的存储磁盘。"
	]
	quest.2DBA62C991BAE9BE.quest_desc: ["使用 Empowerer 合成。查看 JEI。"]
	quest.2E0F5CBC2BC6C08E.quest_desc: ["大多数仪式都需要香才能生效。香炉只有在祭坛周围9x9区域内且处于同一高度时才会被计算。物品可以放入香炉中，并用打火石和钢点燃。空手潜行右键可以熄灭香炉。"]
	quest.2E1691349A853A38.quest_desc: ["Tier 1 升级。"]
	quest.2F0158FCC4479FEA.quest_desc: ["由烈焰水晶制成。"]
	quest.2FAE40B79BD639DF.quest_desc: ["Iron Jetpacks 是一款功能丰富且易于使用的现代喷气背包模组。背包等级越高，性能越好。线圈是背包制作的重要组成部分。请参见 JEI。"]
	quest.306E64FC75EFE513.quest_desc: [
		"一种可从物品中提取炼金汞的装置。"
		""
		"将蒸馏器放在熔炉上。用烈焰棒填满熔炉来加热蒸馏器！"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.30740B977370651A.quest_desc: ["游戏内文档请参阅&oThe Big Book of Bees&r，配方和繁殖信息请查看JEI。嗡嗡嗡！"]
	quest.30DF604A86087BD9.quest_desc: ["滑翔翼模组添加了滑翔翼（惊喜！），让你翱翔天际！只需从高处跳下（或用喷气背包上升），剩下的交给滑翔翼。飞行控制非常流畅自然。想更快时，还可以加固你的滑翔翼！"]
	quest.30E7E3CAB4C5D408.quest_desc: ["生成无限岩浆（缓慢）！放入流体抽屉中。"]
	quest.30F1482C50855B41.quest_desc: ["可存储能量，可升级。"]
	quest.30F28A22E27DC72B.quest_desc: ["和机械锤类似，但可以升级！"]
	quest.315952B82873034E.quest_desc: ["无线电力储能，详情请参阅 Powah 手册。"]
	quest.316C68682A9753C8.quest_desc: [
		"将汞从晶体形态转化为流体形态。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.317C6EFB5B68B18A.quest_desc: ["无与伦比的速度、可重配置侧面、用于烟熏和爆破的增强组件，大幅提升冶炼效率。"]
	quest.31BB2CF9E443BA95.quest_desc: [
		"磁盘驱动器用于存储存储磁盘和流体存储磁盘。"
		""
		"插入存储盘后，磁盘驱动器会扩展存储网络的容量。可用总存储量取决于内部磁盘的数量和类型。移除磁盘后，其存储内容将在重新插入前暂时无法访问。"
	]
	quest.31F347F5F9510959.quest_desc: ["导入器的升级版。18个过滤槽位。"]
	quest.320003532E0C82AD.quest_desc: ["能量存储，二级。"]
	quest.320EBC7E55C11D66.quest_desc: ["将金质储物箱变为钻石储物箱。点击储物箱的升级即可应用。"]
	quest.321B7E28899ACCA1.quest_desc: ["存储升级，等级3。悬停物品查看详情。"]
	quest.3258ABB4591DE8AB.quest_desc: ["充能熔炉是一种基础电炉，使用能量而非燃料来熔炼物品。"]
	quest.336A9F5BA48F3C0F.quest_desc: ["生物风扇旨在让玩家能将生物推至四面八方，甚至垂直方向。生物风扇方块有3种升级选项来扩展其能力——宽度、高度和距离修饰器。"]
	quest.3394B9E2F12D4183.quest_desc: [
		"锇压缩机用于将精炼黑曜石粉尘制成精炼黑曜石锭，将萤石粉尘制成萤石锭。"
		"它将液态锇（熔化的锇锭放入机器底部槽位）与原始材料融合，以创造相应的锭。"
	]
	quest.33FB7358D155093C.quest_desc: ["存储升级，等级1。悬停物品查看详情。"]
	quest.342328DA4ECCD303.quest_desc: ["烈焰人刷怪笼可以在下界堡垒中找到。"]
	quest.34D13D96646E6C3E.quest_desc: ["消耗附近的树叶并将其转化为能量。"]
	quest.3510D31502AB77AC.quest_desc: ["点击叶方块上的蚕来感染一棵树。感染整棵树后，用钩爪打破被感染的叶子以获得线。蚕也可以被吃掉。"]
	quest.3510D31502AB77AC.title: "物品生产任务书"
	quest.352E2E7BCBC1E76E.quest_desc: [
		"Powah 是一个科技模组，增加了生成、储存和传输Forge能量的多种方式。阅读本书，了解你需要知道的一切！"
		""
		"模组特性："
		"- 能量存储（能量单元，末地网络）"
		"- 末地网络 (末地单元, 末地, 传送门)"
		"- 发电机（熔炉发电机、岩浆发电机、热电发电机、太阳能电池板、反应堆）"
		"- 其他机器（Discharger、Energy Hopper、Player Transmitter）"
		"- 服务器友好型能量电缆。"
		"- 支持水浸模式。"
		"- 还有更多内容……"
	]
	quest.352E2E7BCBC1E76E.title: "Powah"
	quest.35439E71E2C55399.quest_desc: [
		"Harvester 是一种能自动收割作物并重新种植的机器。Harvester 收集的物品会放入其内部物品栏中。"
		"种子再处理器是一种将多余种子转化为精质的机器。"
		"灵魂提取器是一种将生物灵魂从物品中提取到灵魂瓶中的机器。"
		"所有三种机器都可以通过机器升级进行升级。"
		"Tinkering Table 可以让你在神秘护甲、工具和武器上安装增强组件。"
	]
	quest.35439E71E2C55399.title: "神秘机器模组 (Mystical Machines)"
	quest.35AC01269B4F9615.quest_desc: ["Iron Jetpacks 是一款功能丰富且易于使用的现代喷气背包模组。背包等级越高，性能越好。线圈是背包制作的重要组成部分。请参见 JEI。"]
	quest.36222893BBD14BCD.quest_desc: [
		"神秘农业有六种合成水晶，而不是两种。它们分别是：Inferium、Prudentium、Tertium、Imperium、Supremium 和 Master Infusion Crystal。"
		""
		"晶体的配方是嵌套的，所以你不能跳过前一个等级直接制作更高级的晶体。"
	]
	quest.36F144C0C7F7C92A.quest_desc: [
		"钻石戒指是制作天使戒指的组件之一。"
		""
		"Angel Ring 模组添加了天使戒指，能让你像创造模式一样飞行，方便建造和旅行。灵感来自 Extra Utilities 的 Angel Ring。"
	]
	quest.36F1BE59B76BABFB.quest_desc: ["使用原子重构器和赋能器将矿物转化为强大的晶体，用于制造物品处理和分拣的实用机器、无线传输能量、物品和流体的激光器、用于发电的可再生石油等等。"]
	quest.378335EBADF84878.quest_desc: ["授予创造模式飞行能力，使用 Tinkering Table 应用于 Supremium Chestplate。"]
	quest.37DEF911AA9FFE06.quest_desc: ["合成器允许玩家用8个粉尘制作一个原矿块。将原矿粉尘放在顶部槽位，底部槽位放一些圆石，即可合成原矿块。"]
	quest.38401880D2434D5E.quest_desc: ["催化剂是制作创意物品所需的合成组件。"]
	quest.38606D62CAA33DB9.quest_desc: ["燃烧石油并将其转化为能量。"]
	quest.388B5215D86F32D7.quest_desc: ["Neural Processor 用于制作各种高级存储网络设备。"]
	quest.38B43EC782FE2A6C.quest_desc: [
		"一种通过蒸发来增加水中残留的氯化铵浓度的简易装置。"
		""
		"将蓄水池放在储罐顶部。用装满水，让魔法发生！"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.38D56923F0F332A1.quest_desc: ["每个等级都会增加更多的存储栏位和升级栏位。"]
	quest.39021A1451B84E37.quest_desc: ["连接到你的能源网络以获得无限电力！"]
	quest.3A136BC844853F33.quest_desc: ["有时候，建造大型建筑可能有点乏味，而且需要付出很多努力。毕竟不是每个人都是建筑大师！Dire's Building Gadgets 旨在让建造变得更容易一点。"]
	quest.3AE5706892FD387E.quest_desc: ["催化剂是制作创意物品所需的合成组件。"]
	quest.3BA7E85F45629218.quest_desc: ["Tier 4 机械框架。需要以太气体。"]
	quest.3BF8182FD2D9CE67.quest_desc: ["查看 Bumblezone 的进度标签页，了解该做什么！"]
	quest.3D2A8B9B6B4A3579.quest_desc: ["升级可清除多余物品。防止因溢出导致系统堵塞。"]
	quest.3EB503A7005EB307.quest_desc: ["由充满活力的水晶制成。"]
	quest.3EBBAD557DA84CAD.quest_desc: [
		"神秘农业有六种合成水晶，而不是两种。它们分别是：Inferium、Prudentium、Tertium、Imperium、Supremium 和 Master Infusion Crystal。"
		""
		"晶体的配方是嵌套的，所以你不能跳过前一个等级直接制作更高级的晶体。"
	]
	quest.40FD21F3F69ED1D2.quest_desc: ["催化剂是制作创意物品所需的合成组件。"]
	quest.41001B2CB88B422A.quest_desc: [
		"由你在“另一面”找到的资源制作而成。"
		""
		"找不到海龟蛋？试试制作海龟种子（Haven Animal Seeds）吧！"
	]
	quest.414935E05F19594F.quest_desc: ["存储升级4级。悬停物品查看详情。可升级至最大存储升级。"]
	quest.4155C829F6CEC3B8.quest_desc: ["扩展工作台是一套分等级的工作台，可用于制作各种物品。每个等级都有更大的网格，可用于用更多组件制作更高等级的物品。"]
	quest.41BE21718BDF78C0.quest_desc: ["和机械筛子类似，但可以升级！"]
	quest.422C87E619A5A2A3.quest_desc: ["要获得以太气体，将静滞舱放置于防凋零室中，为其供电，并在其正上方生成凋零。在凋零上方放置液体激光底座，内部放入紫色激光透镜，并在南北东西方向各放置四个激光钻头。为每个钻头供电，然后将以太气体泵入液体储罐！"]
	quest.422C87E619A5A2A3.title: "以太气体"
	quest.424B7B9044A540B2.quest_desc: ["像个大 boss 一样阻止生物生成！"]
	quest.424B7B9044A540B2.title: "马格南火把"
	quest.426C4E86095CD928.quest_desc: ["燃气发电机通过消耗任何可燃气体来发电，例如电解分离器产生的氢气或乙烯。"]
	quest.42CD986B61F11A7D.quest_desc: ["每个等级都会增加更多的存储栏位和升级栏位。"]
	quest.42DB9B98EADB1583.quest_desc: ["无与伦比的速度、可重配置的面板、用于烟熏和爆破的增强模块，大幅提升冶炼效率。"]
	quest.435A7164843D2020.quest_desc: ["生成无限水！放入流体抽屉中。"]
	quest.4380FE8B9ED6C5BB.quest_desc: ["游戏内文档请参阅&o《蜜蜂大全书》&r，配方和繁殖信息请查看JEI。嗡嗡嗡！"]
	quest.4380FE8B9ED6C5BB.title: "Comb Collection"
	quest.4384694EA82E9FAC.quest_desc: ["使用 Empowerer 合成。查看 JEI。"]
	quest.43CA20FEAD4350A8.quest_desc: ["加载区块，这样在你不在的时候，东西也能继续运作。"]
	quest.447D11B0652CD462.quest_desc: ["控制电路是制造Mekanism机器/工具的关键组件。它们存在于许多配方中，不同配方可能需要不同等级的控制电路。例如，能量熔炉需要基础控制电路，而化学溶解室则需要终极控制电路。"]
	quest.44F3C05A8D41F74E.quest_desc: ["由尼奥特水晶制成。"]
	quest.44F8DC14FD50BC67.quest_desc: ["控制电路是制造Mekanism机器/工具的关键组件。它们存在于许多配方中，不同配方可能需要不同等级的控制电路。例如，能量熔炉需要基础控制电路，而化学溶解室则需要终极控制电路。"]
	quest.4524CA86DDA108A0.quest_desc: ["自动打开怪物农场里不断掉落的战利品箱！(提示：用漏斗或管道实现自动化！)"]
	quest.4524CA86DDA108A0.title: "战利品箱自动化"
	quest.456A3461BA56C7A2.quest_desc: ["利用铀矿产生电力，可升级。"]
	quest.4591289F6470AA15.quest_desc: ["游戏内文档请参阅&o《蜜蜂大全书》&r，配方和繁殖信息请查看JEI。嗡嗡嗡！"]
	quest.4591289F6470AA15.title: "BaBee 蜜蜂"
	quest.45D3257582FF2B4E.quest_desc: ["与存储终端类似，但增加了一个合成界面。"]
	quest.460D718C94207286.quest_desc: [
		"前期获取板和粉尘的好方法！"
		""
		"试试用铂锤，另一种方法，能更好地产出某些材料。"
	]
	quest.46221AA1BB942A23.quest_desc: [
		"用于发酵桶中配方的发酵助剂。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.46D79C3651ECA0AA.quest_desc: [
		"你周围世界的植物似乎蕴藏着巨大的未开发能量。将它们捣成浆糊，不就是获取能量的最佳方式吗？"
		""
		"当然，要把上述植物捣成浆糊，你需要一个工具。用光滑的白石制成的研钵，就能很好地完成这项任务。"
	]
	quest.46D79C3651ECA0AA.title: "研钵和研杵"
	quest.475AB61FBF6A58AF.quest_desc: ["连接两个或多个末地箱来运输和存取物品！用染料上色以配对箱子。"]
	quest.47F2101828560520.quest_desc: ["催化剂是制作创意物品所需的合成组件。"]
	quest.48BCA06DC5AAD546.quest_desc: ["催化剂是制作创意物品所需的合成组件。"]
	quest.48EC17BA28863C7D.quest_desc: [
		"神秘农业有六种合成水晶，而不是两种。它们分别是：Inferium、Prudentium、Tertium、Imperium、Supremium 和 Master Infusion Crystal。"
		""
		"晶体的配方是嵌套的，所以你不能跳过前一个等级直接制作更高级的晶体。"
	]
	quest.490558A8D30AA686.quest_desc: ["将钻石存储转换为下界合金存储。点击存储上的升级即可应用。"]
	quest.496E60A1B5AC534F.quest_desc: ["太阳能发电机利用太阳光来产生电力。该发电机特别适合为地面机器提供被动能源，而不是消耗你的主要储能。"]
	quest.4A2FA75BAF4E8D5C.quest_desc: ["筛选砾石，有机会获得铁矿石块。"]
	quest.4AAB77C213A1DDF0.quest_desc: ["在祭坛中熔炼引力矿石，使用安布罗修姆碎片作为燃料。"]
	quest.4AAB77C213A1DDF0.title: "安布罗西乌姆和引力石"
	quest.4AE32EE74D37C1F2.quest_desc: ["Pipez 模组添加了简单且高度可配置的管道，旨在尽可能减少延迟。包含高度可配置的过滤系统和升级等级。现已推出 Pretty x Smart Pipez 资源包！"]
	quest.4AE32EE74D37C1F2.title: "管道匠模组"
	quest.4B27559E6DAA0241.quest_desc: ["本模组的基本单位是数据模型——一种包含实体信息的物品，可用于生成该实体的掉落物。要获得数据模型，你必须先制作数据模型框架，并将其用于目标实体以构建模型。模型创建后，你还需要对其进行训练。"]
	quest.4B468B0B3CA361C3.quest_desc: ["模式存储了自动合成配方中的输入和输出。配方是通过模式网格分配的。"]
	quest.4B90C9FBF21772B7.quest_desc: ["Exporter 会从存储网络中提取资源，并将其放入相连的外部物品栏中。"]
	quest.4BB13273E21BCA26.quest_desc: ["更多储物空间！悬停在物品上可查看槽位和堆叠容量。"]
	quest.4BB6701E9A458BBD.quest_desc: ["放入抽屉即可获得无限物品！"]
	quest.4BC99DFAF1C72844.quest_desc: [
		"用黑曜石块搭个框架，再用打火石点燃传送门。进入下界前，确保你有足够的方块或可靠的飞行方式！"
		""
		"下界是一个虚空世界，但会生成堡垒和 bastion。"
		""
		"考虑使用探险家罗盘来帮助你寻找下界结构！"
	]
	quest.4BC99DFAF1C72844.title: "进入下界"
	quest.4C70A88924BB2E10.quest_desc: [
		"可用于消化、发酵和液化配方中。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯秘学》（The Hermetica）。"
	]
	quest.4CE7399112B2AE1B.quest_desc: ["不是包里所有的锭。但有很多是。"]
	quest.4CE7399112B2AE1B.title: "并非所有金属锭 (Not) All The Ingots"
	quest.4D97B224A5F8DBEF.quest_desc: ["凋零骷髅可以在下界堡垒中找到。抢夺 III 附魔会很有帮助！"]
	quest.4E075F85409EAE4A.quest_desc: ["Hostile Neural Networks 是一款让你训练数据模型和运行模拟的模组，可以生成生物预测，进而生成生物掉落物。"]
	quest.4F10459F3FC2C422.quest_desc: ["沉浸式工程学的多块机器。以2x2方式组装并用工程师之锤右键。可将多种原材料制成合金。"]
	quest.4F10459F3FC2C422.title: "合金熔炉"
	quest.4F306F45E0D19583.quest_desc: [
		"要使用无线工具，必须在网络中安装无线发射器，以实现无线访问存储网络。"
		""
		"默认范围是16格，但可以通过范围升级来扩展。"
	]
	quest.4F306F45E0D19583.title: "无线精炼模组 (Wireless Refined)"
	quest.4F3AB6CE76783768.quest_desc: ["Mekanism 的量子纠缠传送器是一种机器，可通过通道将液体/物品/能量/气体从一个量子纠缠传送器发送到另一个。"]
	quest.4F65AF8D030E6284.quest_desc: ["铁刺是一种可以放置在实体方块任意一侧的基础方块。当生物和玩家接触到铁刺时，会受到伤害。生物会掉落经验和它们正常的掉落物。"]
	quest.5083FE77FC50B2B3.quest_desc: ["沉浸式工程学的多方块机器。以3x3方式组装并用工程师之锤右键。使用煤炭，产出焦炭和焦油油。"]
	quest.5083FE77FC50B2B3.title: "焦炭炉 Coke Oven"
	quest.50860D1B56143535.quest_desc: ["基础处理器用于制作各种存储网络装置。"]
	quest.509158ADD0513BD5.quest_desc: ["你的研钵和研杵能产出用于法术的精细咒粉，但它本身无法直接使用。用这个装置，将咒粉中的自然能量引导到树枝上。只需将其放入木棍，加入咒粉，等待法杖生成即可。"]
	quest.50D092D124213599.quest_desc: ["生物预测需要在掠夺合成器中处理，该设备利用能量将预测转化为生物掉落物。可用的掉落物基于预定义物品列表，每种模型类型都可以选择一个目标。掠夺合成器会记住每种类型的选择，因此你可以将多种预测输入到单个合成器中。"]
	quest.5121E3A99D290288.quest_desc: ["无与伦比的速度、可重配置侧面、用于烟熏和爆破的增强组件，大幅提升冶炼效率。"]
	quest.51A0F730A8BC075C.quest_desc: ["游戏内文档请参阅&o《蜜蜂大全书》&r，配方和繁殖信息请查看JEI。嗡嗡嗡！"]
	quest.51DFACE8622E4E38.quest_desc: ["图案网格的运作方式与普通网格相同，但也支持创建图案。"]
	quest.51FD1757A28A3841.quest_desc: ["Mekanism 喷气背包是一种允许玩家飞行、可装备在胸甲栏位的物品。它使用氢气作为燃料。"]
	quest.51FD1757A28A3841.title: "Mekanism 喷气背包"
	quest.520CAB88B3A4C8F9.quest_desc: ["利用增强器来提升熔炉的速度和其他性能吧！"]
	quest.520CAB88B3A4C8F9.title: "熔炉增强组件"
	quest.529D5E5C6CF1B07F.quest_desc: ["利用太阳能发电，可升级。"]
	quest.52B992879E7B64AC.quest_desc: ["作用于树叶，有小概率获得蚕，并提高树苗的掉落率。"]
	quest.539A30CE4D6252BE.quest_desc: ["魔法杖非常简单易用。它们蕴含着自然的力量，只需按住右键蓄力法术，大约一秒后释放右键即可施放。法杖的使用次数有限，充能次数用尽后将被完全摧毁。使用效率修饰符可以增加充能次数。"]
	quest.539BCC229ED4AD1F.quest_desc: ["将生物的灵魂与物品相结合。这完全没什么黑暗的……"]
	quest.53B292405012E269.quest_desc: ["制作一把铁镐，摆脱石器时代！"]
	quest.53DAE21458E08F56.quest_desc: ["就像物品抽屉一样，但可以存放流体！"]
	quest.53FC75322EC8C32A.quest_desc: ["用扳手将发电机连接到工作台。使用工作台来制作家具！"]
	quest.53FC75322EC8C32A.title: "家具"
	quest.540D9B73F6F008FF.quest_desc: ["掉落物列表请见 JEI。"]
	quest.548637FB72EA8FFE.quest_desc: ["沉浸式工程学的多方块机器。以3x3排列组装，并用工程师之锤右键。可将铁和煤炭焦炭制成钢。"]
	quest.548637FB72EA8FFE.title: "高炉 Blast Furnace"
	quest.54BB486DD1E7C37F.quest_desc: ["更多储物空间！悬停在物品上可查看槽位和堆叠容量。"]
	quest.551E3129CE26B9FC.quest_desc: ["存储部件可用于合成存储磁盘或存储方块。等级越高，能存放的东西就越多！"]
	quest.553356616311C286.quest_desc: ["使用 Empowerer 合成。查看 JEI。"]
	quest.555DD517DDA35D3D.quest_desc: ["催化剂是制作创意物品所需的合成组件。"]
	quest.55C4C5BD713B3D79.quest_desc: ["将方块分解成其他材料。"]
	quest.56179A14BD445AD1.quest_desc: ["要在潜声尖叫器上使用潜声核心，才能使其生成潜声守卫（遵循原版机制）"]
	quest.56179A14BD445AD1.title: "远古守卫者生成中"
	quest.56A9D71DA5C2F8F4.quest_desc: ["每个抽屉可存放大量同一种物品。有其他变种可供选择。可升级。"]
	quest.56D10C40E36A47F4.quest_desc: ["自动将你的矿石区块压缩成矿石！"]
	quest.56F6548EF39B593A.quest_desc: [
		"储物袋，1级。可升级。"
		""
		"注意：存在一个可能导致背包无法打开的 bug。重启游戏通常可以解决。已向模组作者提交 bug 报告。"
	]
	quest.571A4EE7257235E4.quest_desc: ["是时候改造厨房了！"]
	quest.571A4EE7257235E4.title: "顶级厨师"
	quest.57775C40A0323450.quest_desc: ["Tier 2 升级。"]
	quest.58621EB2F53BEB8C.quest_desc: [
		"Sophisticated backpacks 是又一个背包模组，这次你可以将背包放置在世界中，用不同颜色组合染色，升级获得更多物品栏，并通过多种功能性升级来增强背包。"
		"可通过按键访问（默认为 B 键）。"
		"Curios 兼容性模组让背包可以穿戴在“背部”槽位并显示出来。"
		"背包也可以放置在世界中。"
		"每个等级都会增加更多的存储栏位和升级栏位。"
	]
	quest.586B7C66F5E95595.quest_desc: [
		"储物袋，2级。可升级。"
		""
		"注意：存在一个可能导致背包无法打开的 bug。重启游戏通常可以解决。已向模组作者提交 bug 报告。"
	]
	quest.592793FACB4C126F.quest_desc: ["击杀一个恶魂以获得它的泪水。"]
	quest.593865BD54A922BC.quest_desc: ["游戏内文档请参阅&oThe Big Book of Bees&r，配方和繁殖信息请查看JEI。嗡嗡嗡！"]
	quest.5957F43864289ADB.quest_desc: [
		"木桶可用于创造泥土、黏土、灵魂沙、史莱姆等方块！还有石制木桶。请查看JEI。"
		""
		"要获得泥土，就把树苗、树叶、木屑或其他有机物放进桶里！"
		""
		"你也可以用水和女巫水制作泥土生成器——就像用岩浆和水制作鹅卵石生成器一样！"
	]
	quest.5A88EA080503F84F.quest_desc: ["潜贝壳可以从潜贝中获得，潜贝存在于末地城市里。"]
	quest.5A8DB7BC2F8142BF.quest_desc: ["利用RF的力量自动筛选资源！需要能量和筛网。"]
	quest.5AF014F0A6385833.quest_desc: ["风力涡轮机的巨型叶片利用风力发电。每台涡轮机需要1x5x1的小区域（水平方向一个方块）。无论昼夜、晴雨，机器都能发电，但涡轮机必须能清晰看到天空（塔顶的转子罩上方）。发电量与海拔高度成正比。"]
	quest.5B479E75F9EEFAEC.quest_desc: ["获取资源的初始方法。需要一个网格。可接受砾石、沙子、粉尘和碎石块！"]
	quest.5B4D3648D7AC6CE2.quest_desc: ["制作创意物品所需的最后一个魔法材料！"]
	quest.5B647D338175C794.quest_desc: ["使用原子重构机合成。查看JEI。"]
	quest.5B77DC0980506C5E.quest_desc: ["放入一种流体，即可获得该流体的无限数量！"]
	quest.5C421BF33AF6C8E0.quest_desc: [
		"Extended Crafting 增加了更多物品合成方式、更多合成材料以及更多合成工具。完成这一系列任务，你就能合成一些超赞的创造模式物品了！"
		""
		"催化剂是制作创意物品所需的合成组件。"
	]
	quest.5C8AD9BC27B6067D.quest_desc: ["游戏内文档请参阅&o《蜜蜂大全书》&r，配方和繁殖信息请查看JEI。嗡嗡嗡！"]
	quest.5CB687981A0D80FA.quest_desc: ["和原版一样，熔炼铁矿石可以获得铁锭。铁矿石方块也可以被破坏成原铁。"]
	quest.5D0AE110D2D9A741.quest_desc: ["将可压缩的物品进行压缩存储。"]
	quest.5D32FD49E536670A.quest_desc: ["使用 Empowerer 合成。查看 JEI。"]
	quest.5D85F18A1A686CCB.quest_desc: ["利用岩浆发电，可升级。"]
	quest.5DDB97B664715703.quest_desc: ["用于锤击压缩方块的工具。"]
	quest.5E420D5F38BFAC55.quest_desc: ["改进处理器用于制作各种存储网络装置。"]
	quest.5EF1C9DC51DE2231.quest_desc: ["利用煤炭和其他可燃材料来产生电力。"]
	quest.5F156000CB4EA702.quest_desc: [
		"将末地合成台放置于世界中，右键以查看GUI。内部有一个3x3的合成网格，类似于合成台。将配方材料放入网格中，末地合成台就会开始合成。"
		""
		"要提高合成速度，请在末地合成器周围放置末地交替器。在4格半径内放置的任何交替器都能提高合成速度。如果它们发出粒子效果，就说明正在工作。"
	]
	quest.5FAF91E1C7E3416E.quest_desc: ["由氮晶制成。"]
	quest.5FB3D7A5823A2488.quest_desc: ["将铁质储物箱变为金质储物箱。点击储物箱的升级即可应用。"]
	quest.5FF0396BA3953492.quest_desc: [
		"用于传输物品。可与其他 Ender IO 导管放置在同一方块中。"
		""
		"注意：EnderIO 线缆有时会导致卡顿。如果出现这种情况，请考虑更换其他类型的线缆。"
	]
	quest.5FF50DB367B692FB.quest_desc: ["过滤器可用于 Ender IO 导管。更多过滤器请参见 JEI。"]
	quest.5FF50DB367B692FB.title: "过滤器"
	quest.5FF8A5308258D79E.quest_desc: ["用铁锤敲击鹅卵石即可获得。"]
	quest.6087919B30E9072D.quest_desc: ["这台机器利用能量从特定方块和矿石中提取粉尘，是制造各类工具所必需的。它与破碎机不同，是其他模组中研磨机的对应物。"]
	quest.60DD73D82D4272AA.quest_desc: ["与蓝图结合使用，可制作各种用于合成的组件！"]
	quest.61BAD11EB0BD237A.quest_desc: ["穿上史莱姆靴，用你的史莱姆弹弓快速旅行！注意瞄准准确……"]
	quest.61BAD11EB0BD237A.title: "史莱姆装备"
	quest.61EE7D1179D3B0A5.quest_desc: ["Ender IO 版本的太阳能。"]
	quest.6200861F7728A0EE.quest_desc: [
		"Crafters 是 RFTools 添加的机器，只要有配方、所需组件和 RF 能量，就能自动合成物品。多步骤合成可以在一台机器内完成，唯一限制是配方槽的数量。"
		""
		"Crafter Tier 3 可以记住 8 个配方。"
	]
	quest.6285202A8CB4E4B7.quest_desc: ["使用原子重构机制作。查看JEI。"]
	quest.630C712DB750FBD2.quest_desc: ["掉落物列表请参见 JEI。"]
	quest.6318A6EFA9477124.quest_desc: ["这是你的 Industrial Foregoing 入门生成器。"]
	quest.634A10A7851E5400.quest_desc: ["使用原子重构机制作。查看JEI。"]
	quest.63BEE8BC6B4A8F10.quest_desc: ["游戏内文档请参阅&oThe Big Book of Bees&r，配方和繁殖信息请查看JEI。嗡嗡嗡！"]
	quest.63C8B80E80540A4C.quest_desc: ["更多储物空间！悬停在物品上可查看槽位和堆叠容量。"]
	quest.63F2484A9589E343.quest_desc: ["用于沉浸式工程学的多方块机器。详情请参阅手册或JEI。"]
	quest.645E7116AA6DA20B.quest_desc: ["吸收漏斗是一个能吸走范围内所有生物掉落物和经验球的方块。基础吸收漏斗的吸力范围是半径3格，可通过升级扩大。"]
	quest.6487CFE6EBDB387F.quest_desc: ["石英富铜用于制作电缆。"]
	quest.64A049C85861827B.quest_desc: [
		"掉落物列表请参见 JEI。"
		""
		"下界合金升级锻造模板可以在下界的堡垒中找到。建议使用探险家指南针来寻找这些结构。它也可以通过合成获得。"
	]
	quest.64E08CAE267B2280.quest_desc: ["连接两个或多个末影储罐来运输和获取流体！使用染料进行颜色编码以配对储罐。"]
	quest.651C7084DCD9F58E.quest_desc: ["游戏内文档请参阅&o《蜜蜂大全书》&r，配方和繁殖信息请查看JEI。嗡嗡嗡！"]
	quest.654EC09E719A4989.quest_desc: ["用于制作二级种子。"]
	quest.65F53D31B4B971B0.quest_desc: [
		"通过锤击下界岩、深板岩和玄武岩获得。"
		""
		"下界岩可以通过熔岩和女巫水混合桶获得，也可以用熔岩和女巫水制作下界合金发电机——就像用熔岩和水制作圆石发电机一样！"
	]
	quest.65F53D31B4B971B0.title: "其他被压碎的方块"
	quest.662B17346E82C135.quest_desc: [
		"用于炼金发酵的容器，是物质转化的必需品。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.66C89A193D9A024F.quest_desc: ["合成材料。由木板和焦油油混合制成。"]
	quest.66F77941FEC7F2F3.quest_desc: [
		"用作配料和能量来源。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.670F9A7D0711CCED.quest_desc: ["插入气体即可获得无限量的该气体！"]
	quest.6713B1428E72DBD1.quest_desc: ["许多工业向前机器中的一种合成材料。"]
	quest.679CEDEFBD049478.quest_desc: ["Tier 3 机械框架。需要粉色史莱姆（通过生物屠宰厂获取）。"]
	quest.67C3836D9A0AC89B.quest_desc: ["掉落物列表请参见 JEI。"]
	quest.67D365E629CC5BA3.quest_desc: [
		"可传输流体。可与其他 Ender IO 管道放置在同一方块中。"
		""
		"注意：EnderIO 线缆有时会导致卡顿。如果出现这种情况，请考虑更换其他类型的线缆。"
	]
	quest.67FAE3A15AA57C7F.quest_desc: ["Ender IO 的开端。通过筛分粉尘获得。"]
	quest.680E9440A68314F6.quest_desc: ["能量存储，第一级。"]
	quest.687A08FCC2CA7ADE.quest_desc: ["升级版的能量导管！"]
	quest.687A08FCC2CA7ADE.title: "升级后的能量导管"
	quest.697350F554C4BD08.quest_desc: ["用于制作三阶种子。"]
	quest.69ADBF0817B66976.quest_desc: ["一种强大的合成材料！"]
	quest.69B30B7931FFA9C2.quest_desc: ["使用 Empowerer 合成。查看 JEI。"]
	quest.69C0C3BBFDE9F3C4.quest_desc: ["通过锤击沙子获得。"]
	quest.69E913700895176C.quest_desc: [
		"用于炼金消化的容器，升华所必需。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯秘学》（The Hermetica）。"
	]
	quest.6A7D872DC35ADB7D.quest_desc: ["游戏内文档请参阅&oThe Big Book of Bees&r，配方和繁殖信息请查看JEI。嗡嗡嗡！"]
	quest.6AAAD7E763058DF2.quest_desc: ["将你的操作范围延伸至终端。距离为16格。"]
	quest.6AD13F2C74133847.quest_desc: ["Angel Ring 模组添加了天使戒指，能让你像创造模式一样飞行，方便建造和旅行。灵感来自 Extra Utilities 的 Angel Ring。"]
	quest.6BC645CB89B3B4C5.quest_desc: ["清除多余的物品、流体和能量。"]
	quest.6BC645CB89B3B4C5.title: "垃圾桶"
	quest.6C04BB45701F2822.quest_desc: ["冶金注入器是Mekanism科技树的第一步。冶金注入器是一种用于生产钢锭、青铜锭、富化合金和玄武岩锭的机器。"]
	quest.6C17B46F1A1CC3DE.quest_desc: [
		"锤子能将鹅卵石等材料粉碎成对应的碎块。锤子可附魔。也存在更高级的锤子，请查看JEI。"
		""
		"试着用木槌敲击原木来获得木屑——非常适合堆肥！"
	]
	quest.6C58685A51851C37.quest_desc: [
		"一种可从物品中提取炼金盐的装置。"
		""
		"将熔炉放在熔岩炉上。用烈焰棒填满熔岩炉来加热熔炉！"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.6C6E2A02FB248AE9.quest_desc: ["从原木中提取液态乳胶。放在树旁边即可开始提取。查看JEI了解速率。"]
	quest.6CA1FE2FD5E868FB.quest_desc: ["筛网用于筛网（和压缩筛网）中，通过筛选各种方块来获取资源。筛网可以附魔效率和时运。掉落物列表请参见JEI。"]
	quest.6CD669C30C0AA09C.quest_desc: ["在以太的天空中能找到云朵！"]
	quest.6CD669C30C0AA09C.title: "Aether Aerclouds"
	quest.6D6FB6C12C6D5998.quest_desc: ["物品导管（item conduit）的升级版！"]
	quest.6D6FB6C12C6D5998.title: "升级物品导管 (Upgraded Item Conduits)"
	quest.6DCE8E2F8BE302FA.quest_desc: ["合成守卫工具和盔甲所需的材料。"]
	quest.6DDFDEC9A735CC6C.quest_desc: ["流体管道的高级版本！"]
	quest.6DDFDEC9A735CC6C.title: "升级后的流体管道系统"
	quest.6DE98C7BF96D2C00.quest_desc: [
		"最大方块数：9"
		""
		"建造棒能让你一次性放置多个方块，朝你面对的方向扩展建筑。你可以升级建造棒以增强其能力，使建造更快更高效。"
		""
		"建造棒共有五个不同等级：木制、铜制、铁制、钻石制和末地石制。每个等级都提供更强的耐久度和放置能力，并且可以用模板进一步升级。"
	]
	quest.6E00BEC4F2B3C57B.quest_desc: ["一种稀有的宝石，仅存在于天界群岛的天空岛屿中"]
	quest.6E00D8F37E6E5FB5.quest_desc: [
		"控制器为存储网络提供动力。"
		""
		"每个网络至少需要一个控制器来保持活跃。可以使用多个控制器来满足更高的能源需求。"
	]
	quest.6E483CB95EE50A39.quest_desc: ["石英富集铁用于制作各种存储网络装置。"]
	quest.6EA1765FCF1115A7.quest_desc: ["筛分压缩方块，节省空间提高效率！"]
	quest.6F0876FC8A6A3D40.quest_desc: ["无与伦比的速度、可重配置侧面、用于烟熏和爆破的增强组件，大幅提升冶炼效率。"]
	quest.6F15A0072CC62A53.quest_desc: ["使用赞石宝石制作的祭坛，可用于附魔重力矿石。"]
	quest.6F444A1F89D19FF8.quest_desc: ["可以熔炼成塑料。"]
	quest.6F4CC9A97F52FB72.quest_desc: [
		"Mob Masher 是一种模块化方块，可通过多种升级选项来最大化怪物掉落物。"
		"原版附魔可以作为超越普通等级的升级选项使用。"
	]
	quest.70D8ED7A0468756E.quest_desc: [
		"将Flux Crafter放置于世界中，右键以查看GUI。内部有一个3x3的合成网格，类似于合成台。将配方材料放入网格中。"
		""
		"配方正确的话，Flux Crafter 会开始从半径 4 格内的所有 Flux Alternator 吸收能量。如果它们发出粒子效果，就说明正在工作。"
	]
	quest.7150EF5B50D9E2DE.quest_desc: [
		"最大方块数：3"
		""
		"查看 JEI 的信息标签页，了解不同功能，包括如何撤销放置！"
		""
		"建造棒能让你一次性放置多个方块，朝你面对的方向扩展建筑。你可以升级建造棒以增强其能力，使建造更快更高效。"
		""
		"建造棒共有五个不同等级：木制、铜制、铁制、钻石制和末地石制。每个等级都提供更强的耐久度和放置能力，并且可以用模板进一步升级。"
	]
	quest.7150EF5B50D9E2DE.title: "建造木棍 (Construction Sticks)"
	quest.720725F7A69975DC.quest_desc: [
		"查看 Bumblezone 的进度标签页，了解该做什么！"
		""
		"进入维度非常简单！只需向任何蜂巢（包括模组蜂巢！）投掷末影珍珠，即可进入并生成在该维度。你也可以用活塞将玩家或生物推入蜂巢块，使其进入维度（注意围好装置，防止活塞将生物推偏）。要离开维度，可以向下挖掘至 Y = 0 以下（别担心，我不会让你死的），或者向上爬到 Y = 256 以上。当然，你可以骑着生物或载具一同离开，也可以用活塞将它们推出。模组会尝试将生物或玩家送回他们尝试进入 Bumblezone 维度时的原始位置和维度。如果来自 Bumblezone 的生物试图离开，它们会被放置在主世界的 0,0 坐标处，方便你找到它们。"
	]
	quest.720725F7A69975DC.title: "进入大黄蜂区 (Into the Bumblezone)"
	quest.7240C8B55A47F4E2.quest_desc: ["使用量子压缩机来创造奇点。然后你就可以把所有不同的奇点组合成终极奇点！"]
	quest.7274D9FE55036285.quest_desc: ["将你的范围进一步延伸至 64 格。添加信标后，此距离会变得更长（按住物品上的 Shift 键查看详情）。"]
	quest.729B2C9F29E2831E.quest_desc: ["使用液体和物品来合成东西。所有用法请参见JEI。"]
	quest.72AC9F164CB96893.quest_desc: ["对鸡使用可生成臭鸡蛋。将鸡蛋点击在5x5的泥土块上可生成恐怖泥土（天黑时会生成敌对生物）。"]
	quest.72C4BBB26B744471.quest_desc: ["生物发电机利用生物燃料发电。"]
	quest.7337E3E0D860BF06.quest_desc: ["通过燃烧燃料产生能量，可升级。"]
	quest.73A75F0B58AE8A65.quest_desc: [
		"每个量子压缩机的配方通常需要催化剂和一定数量的材料。将催化剂放在最左边的槽位，材料放在其旁边的槽位。悬停在蓝色条上可以查看当前材料以及压缩机中该物品的数量。如果催化剂和材料的组合有产出，会显示生成物品的进度。"
		""
		"量子压缩机需要能量才能运行。它只在生成物品时消耗能量。"
	]
	quest.7547C2E7492465D0.quest_desc: ["Ender IO 版本的太阳能。"]
	quest.7559977A9DF3218A.quest_desc: ["使用原子重构机制作。查看JEI。"]
	quest.75EFA7134FE27200.quest_desc: ["用于制作觉醒的超贵金属盔甲、工具和武器。"]
	quest.761EC1EF5102E187.quest_desc: [
		"简单的原版风格储物模组。"
		""
		"特色功能："
		"存储与合成终端"
		"物品栏连接器"
		"打开木箱"
		"无线终端"
		"过滤连接器"
		"物品栏漏斗"
	]
	quest.761EC1EF5102E187.title: "简易存储系统"
	quest.76250FBFFFE305DC.quest_desc: ["Tier 4 升级。那 Tier 5 呢？"]
	quest.76631B8F2A23315E.quest_desc: ["在压缩筛中使用。"]
	quest.76631B8F2A23315E.title: "压缩方块"
	quest.7677AE597AFF69A8.quest_desc: ["Tier 3 升级。"]
	quest.7689C5F845CA684B.quest_desc: ["高级处理器用于制作各种存储网络装置。"]
	quest.76A6B9C436C4DE48.quest_desc: [
		"传输能量。可与其他 Ender IO 导管放置在同一方块中。"
		""
		"注意：EnderIO 线缆有时会导致卡顿。如果出现这种情况，请考虑更换其他类型的线缆。"
	]
	quest.76E19350A24F5C34.quest_desc: ["催化剂是制作创意物品所需的合成组件。"]
	quest.76EAB7316C42D03D.quest_desc: ["非常适合用于首领战斗！"]
	quest.76EAB7316C42D03D.title: "有人提到苹果了吗？"
	quest.772152C611738C41.quest_desc: [
		"查看 Bumblezone 的进度标签页，了解该做什么！"
		""
		"Bumblezone 是一个充满全新蜜蜂相关方块的蜜蜂维度！里面还有许多可探索的结构和独特的蜜蜂盔甲！如果你运气好，可能会在某些结构中找到特殊的寻王座蜂蜜罗盘，它会指引你找到蜂后！这个维度本身看起来就像蜂巢内部，你会发现一排排巨大的墙壁，中间有水流运河。你甚至可能会找到覆盖着花粉的区域，或是充满巨大蜂蜜晶体的峡谷！"
		" "
	]
	quest.7792DA152775B422.quest_desc: ["升级版的导出器。18个过滤槽位。"]
	quest.781FD27F15C7AC74.quest_desc: ["将普通储物箱变为高级储物箱。点击储物箱上的升级即可应用。"]
	quest.7885E80B57B3648C.quest_desc: ["更多储物空间！悬停在物品上可查看槽位和堆叠容量。"]
	quest.788FA7FED314751F.quest_desc: ["扩展工作台是一套分等级的工作台，可用于制作各种物品。每个等级都有更大的网格，可用于用更多组件制作更高等级的物品。"]
	quest.78A7EDF84C87ACC9.quest_desc: ["高级太阳能发电机是基础太阳能发电机的高度升级版。建造一个高级太阳能发电机需要四个太阳能发电机，但其发电量是小型版本的两倍。它还需要一个3x3x3的方块区域才能放置。"]
	quest.78FBD1FF4D95E5CF.quest_desc: ["顶级的神秘农业装备。可以考虑使用增强器来进一步提升它们（提示：在JEI中查找飞行增强器）。"]
	quest.78FBD1FF4D95E5CF.title: "觉醒齿轮"
	quest.792903A29197CAB5.quest_desc: ["掉落物列表请参见 JEI。"]
	quest.794CFF8CC9FC521D.quest_desc: [
		"Industrial Foregoing 包含各种机器、工具、组件，用于发电、农业、存储等。其功能详见《Industrial Foregoing 手册》。"
		"Tier 1 机械框架。"
	]
	quest.794CFF8CC9FC521D.title: "Industrial Foregoing"
	quest.798CB63BBD46CC3B.quest_desc: [
		"The Grid allows access to the resources stored in the storage network."
		""
		"你可以在网格内的存储网络中存取资源。"
	]
	quest.79AB702C4D942408.quest_desc: ["游戏内文档请参阅&oThe Big Book of Bees&r，配方和繁殖信息请查看JEI。嗡嗡嗡！"]
	quest.7A1C27D0A6B38E87.quest_desc: ["催化剂是制作创意物品所需的合成组件。"]
	quest.7A31F071D0D88B2F.quest_desc: ["自动合成器已升级到4级！合成速度更快，模式容量更大。"]
	quest.7AEBE89315FF74E9.quest_desc: ["可从热源和冷却剂中产生电力，可升级。"]
	quest.7AEC8F8890EA9B3F.quest_desc: [
		"生成无限鹅卵石（及其他方块）！只需放置在熔岩源和水源之间。"
		""
		"要生成非鹅卵石的其他方块，请查看 JEI 了解详情。"
		""
		"存在更高等级，请查看 JEI。"
	]
	quest.7AEC8F8890EA9B3F.title: "Cobble Gen"
	quest.7B1AB6EED15C9606.quest_desc: [
		"可用于蓄电器中快速生成用作溶剂的氯化铵。"
		""
		"有关神学（Theurgy）的更多详情，请参阅《赫尔墨斯主义》（The Hermetica）。"
	]
	quest.7BD9F9832DA623FD.quest_desc: ["沉浸式工程的组合机器。按3x3组装并用工程师之锤右键。就像高炉一样，但更棒！"]
	quest.7BD9F9832DA623FD.title: "加固高炉 Reinforced Blast Furnace"
	quest.7C404187C98D4C14.quest_desc: [
		"神秘农业有六种合成水晶，而不是两种。它们分别是：Inferium、Prudentium、Tertium、Imperium、Supremium 和 Master Infusion Crystal。"
		""
		"晶体的配方是嵌套的，所以你不能跳过前一个等级直接制作更高级的晶体。"
	]
	quest.7C6D7C2E30F0A221.quest_desc: ["使用原子重构器和赋能器将矿物转化为强大的晶体，用于制造物品处理和分类的实用机器、无线传输能量、物品和流体的激光器、用于发电的可再生石油等等。"]
	quest.7CCA20E6409CE3D9.quest_desc: [
		"最大方块数：128"
		""
		"建造棒能让你一次性放置多个方块，朝你面对的方向扩展建筑。你可以升级建造棒以增强其能力，使建造更快更高效。"
		""
		"建造棒共有五个不同等级：木制、铜制、铁制、钻石制和末地石制。每个等级都提供更强的耐久度和放置能力，并且可以用模板进一步升级。"
	]
	quest.7DCE27D2B8070C57.quest_desc: ["下界疣可以在下界堡垒中找到。"]
	quest.7DD76280E32ED759.quest_desc: ["通往另一个虚空世界的传送门。一个内部比外部更大的方块。还有一个通往充满矿石的黑暗敌对土地的传送门。"]
	quest.7DD76280E32ED759.title: "虚空、超立方体、和深邃黑暗"
	quest.7DF088A96AE979ED.quest_desc: ["击败末影龙后可以获得末影人蛋。"]
	quest.7E02FEEC5FDEFDA9.quest_desc: [
		"最大方块数：27"
		""
		"建造棒能让你一次性放置多个方块，朝你面对的方向扩展建筑。你可以升级建造棒以增强其能力，使建造更快更高效。"
		""
		"建造棒共有五个不同等级：木制、铜制、铁制、钻石制和末地石制。每个等级都提供更强的耐久度和放置能力，并且可以用模板进一步升级。"
	]
	quest.7EE9136781910742.quest_desc: ["游戏内文档请参阅&o《蜜蜂大全书》&r，配方和繁殖信息请查看JEI。嗡嗡嗡！"]
	quest.7FAB35EDD3B35E25.quest_desc: ["存储部件可用于合成存储磁盘或存储方块。等级越高，能存放的东西就越多！"]
	quest.7FFD3F8E2774C701.quest_desc: ["用于制作第4级种子。"]
